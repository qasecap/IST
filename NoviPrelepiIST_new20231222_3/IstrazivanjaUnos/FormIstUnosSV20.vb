    Private Function poslednjaKontorolaUKljucu() As Control 'tj. stavi Focus na posljednji kljuc
        For Each k1 As Control In Me.Controls
            If Mid(k1.Name.Trim.ToUpper, 1, 1) = "G" Then
                For Each k As Control In k1.Controls
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                        If k.TabIndex = ZKlj Then
                            Return k
                            Exit Function
                        End If
                    End If
                Next
            End If
        Next
    End Function
    Public Function podTabeleSu(ByVal t As String) As String
        Dim result As String
        If t = "" Then
            Return ""
        Else
            Dim pomTabela As String = ""
            For Each r As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
                If r.DG.Trim.ToUpper = "D" AndAlso (Not r.IsNadTabelaNull) AndAlso r.NadTabela.Trim.ToUpper = t.Trim.ToUpper Then
                    pomTabela = r.Tabela.Trim.ToUpper()
                    Exit For
                End If
            Next
            result = t & ";" & podTabeleSu(pomTabela)
            Return result
        End If
    End Function

    Private Sub fillFromDataGridView(ByVal dgvGRID As DataGridView, ByVal eRowIndex As Integer, ByVal brlinks As Integer)

        ddosaoizISTDGV = True
        'treba da prebaci slog u formu gore i postavi focus na prvi
        'dgvGRID.AccessibleName = pp(i).Replace("CLICKFILL=", "")
        'za sad puni samo ono sto mu je datasource
