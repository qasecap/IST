            'ISTMessageBox.Show("_IST _ISTDatabaseConnStrings (ISTBAZE) !!!! " + nvrd + por + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
