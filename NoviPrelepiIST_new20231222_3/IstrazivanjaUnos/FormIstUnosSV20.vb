                'Dim tabbb As String = dt.TableName.Trim.ToUpper
                'If dt.Prefix.Trim.ToUpper = "DBO" Then
                'Else
                '    tabbb = dt.Prefix.Trim.ToUpper + "." + dt.TableName.Trim.ToUpper
                'End If

                'Dim poljaTabeleKojaNisuKljuc As String = "$"
                'For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                '    If p.TABELA.Trim.ToUpper = tabbb Then
                '        If Not p.IsKLJUCNull AndAlso p.KLJUC.Trim.ToUpper = "P" Then
                '        Else
                '            poljaTabeleKojaNisuKljuc = poljaTabeleKojaNisuKljuc + p.POLJE.Trim.ToUpper + "$"
                '        End If
                '    End If
                'Next


                'Dim imaPromene As Boolean = False
                'For Each dtr As DataRow In dt.Rows
                '    imaPromene = UpdateExists(gkljc, dt, dtP, poljaTabeleKojaNisuKljuc, dtr)
                'Next

                'If imapromene = True Then
                Uspelo = UpdateNOVO(saDateUser, GlavnaTabela, gkljc, review)
                'End If

            Else

                If Not (DGTabele(DGi(GlavnaTabela)).Columns("IST_DURATION") Is Nothing) Then DGTabele(DGi(GlavnaTabela)).Rows(0).Item("IST_DURATION") = (DateTime.Now() - IstStart(DGi(GlavnaTabela))).TotalSeconds
                Uspelo = InsertNOVO(saDateUser, GlavnaTabela, gkljc)

                If glavna = False Then
                    Call UradiLKSVEZAPODTABELU(DTbl(DGi(GlavnaTabela, DTbl)))
                End If

                If glavna = False Then
                    '******************8
                    If sadrziPANE = True Then    'D koje sadrzi panel(e)
                        Dim KljuceviSaEkranaSaVrednostima(,) As String 'kljuc od D koje sadrzi panel
                        ReDim KljuceviSaEkranaSaVrednostima(GlavniKljuc.GetUpperBound(0), 1)
                        For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                            KljuceviSaEkranaSaVrednostima(i, 0) = GlavniKljuc(i).Trim.ToUpper
                            KljuceviSaEkranaSaVrednostima(i, 1) = SEK(GlavniKljuc(i)).Trim.ToUpper
                        Next
                        Dim sql As String = " 2=2 "
                        For i As Integer = 0 To KljuceviSaEkranaSaVrednostima.GetUpperBound(0)
                            sql = sql & " and " & KljuceviSaEkranaSaVrednostima(i, 0).Trim.ToUpper & "='" & KljuceviSaEkranaSaVrednostima(i, 1).Trim & "' "
                        Next

                        'za svaku tabelu koja je panel a sadrzi se u D    npr dpodttt=acAkt1#acAkt2#acAkt3#
                        Dim podtabPanel() As String = Split(dpodttt, "#")
                        For m As Integer = 0 To podtabPanel.GetUpperBound(0) - 1
                            Dim redB As DataRow() = DTbl(DGi(podtabPanel(m), DTbl)).Select(sql.Replace("=N'", "='"))
                            If redB.Length > 0 Then
                                For Each r As DataRow In redB
                                    r.Delete()
                                Next
                                DTbl(DGi(podtabPanel(m), DTbl)).AcceptChanges()
                            End If
                            'dodaj novi
                            For i As Integer = 0 To DGTabele(DGi(podtabPanel(m))).Rows.Count - 1
                                DTbl(DGi(podtabPanel(m), DTbl)).ImportRow(DGTabele(DGi(podtabPanel(m))).Rows(i))
                            Next
                        Next
                    End If
                    '******************8
                End If

            End If
        Catch ex As Exception
            ''msg 68
            Dim msgtxt As String = getMessageText(dtMessages, "68", Me.jezik)
            ISTMessageBox.Show(ex.Message, msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try

        If Uspelo Then
            existChangeSomewhereInQuest = False
            BarJedanExistChangeSomewhereInQuest = False
            Me.sacuvano = True

            If SCati = False AndAlso Not OnSaveNextExec Is Nothing Then
                'OnSaveNextExec=EXEC usp_upd_Kontrola_teren d.god, d.mbr, d.kontrolateren;
                Dim sql As String = OnSaveNextExec
                sql = SrediPMGK(sql)
                sql = ZameniGGGMMMUnos(sql)
                sql = sracunajIzraz(sql, Nothing, Nothing)
                Dim ok As String = izvrsiSQL(sql, Me.DBConnectionString)
                If ok = "ok" Then
                Else
                    ISTMessageBox.Show(sql + nvrd + nvrd + "is not executed! ER2", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
                End If
            End If

        End If

        If saZatvaranjem = True Then
