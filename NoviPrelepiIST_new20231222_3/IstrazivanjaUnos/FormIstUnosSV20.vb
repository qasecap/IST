                        End If

                        pane.Height = pane.Height + 22

                        Call sklopiDataGridViewPanel(tabT2, kojatabela, paneltab, kojitab, tabLocationY, pane, t)

                    End If ' da li je panel
                End If '...da li je ucitana podtabela (D)
            End If 'If t = GlavnaTabela
        Next 'tabela

        poslednjinaFormi = poslednjinaFormi + GlavnaTabela + "$" + CStr(ZadnjiTabIndex) + ";"
        Me.Panel1.Height = Me.Panel1.Height + 2

