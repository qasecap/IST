    Function rro(ByVal ipanel As Integer, ByVal b As Integer, ByVal index As Integer) As Boolean
        'obicno polje u bloku
        rro = True
        For i As Integer = grupeObicneCNTLBlokoviPanel(ipanel)(b).GetUpperBound(0) To index + 1 Step -1
            Dim k As Control = grupeObicneCNTLBlokoviPanel(ipanel)(b)(i)
