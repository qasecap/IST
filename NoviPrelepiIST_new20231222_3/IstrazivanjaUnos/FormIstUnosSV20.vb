                Return "'" & rtr.ToString.Trim & " '"
            Case "YYM"
                Dim pomm As Integer = Me.mvt.M + CInt(param) Mod 12
                Dim rtr As Integer = Me.mvt.G + (CInt(param) \ 12)
                If pomm <= 0 Then rtr -= 1
                If pomm > 12 Then rtr += 1
                Return "'" & rtr.ToString.Trim & " '"
            Case "MMM"
                Dim rtr As Integer = Me.mvt.M + (CInt(param) Mod 12)
                If rtr <= 0 Then rtr += 12
                If rtr > 12 Then rtr -= 12
                Return "'" & rtr.ToString.Trim.PadLeft(2, "0"c) & " '"
                Return "'" & rtr.ToString.Trim & " '"
            Case "MBRP"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 8 AndAlso mod11_8(m) Then ' mod11(m) then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "JMBG"
                param = razCASTi(param)
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 13 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "VOPS"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 5 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "VNAS"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 6 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "MOD11"
                Dim ppp() As String = Split(param, ",")
                If ppp.GetUpperBound(0) = 0 Then
                    ReDim Preserve ppp(2)
                    ppp(1) = ppp(1).Length()
                End If
                Dim m As String = SracunajIzTabele(param)
                If m.Length = Val(ppp(1)) AndAlso mod11(m) Then
                    Return " 2=3 "
                Else : Return " 2=2 "
                End If
            Case "VPIB"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 9 Then
                    Dim c As Integer = CInt(m.Substring(0, 1))
                    For i As Integer = 1 To 7
                        c = c * 2 Mod 11
                        c = (CInt(m.Substring(i, 1)) + c) Mod 10
                        If c = 0 Then c = 10
                    Next
                    c = c * 2 Mod 11
                    If ((11 - c) Mod 10) = CInt(m.Substring(8, 1)) Then
                        Return " 2=3 "
                    Else
                        Return " 2=2 "
                    End If
                Else
                    Return " 2=2 "
                End If
            Case "FP"
                Try
                    Dim rtr As String = ""
                    If SCati = False Then
                        param = param.Replace("#FP{", "").Replace("}", "")
                        Dim ind As Integer = Array.IndexOf(nizFPime, param)
                        If ind > -1 Then rtr = SE(param, True, nizFP(ind).Parent)
                        If rtr.Trim = "" Then
                            rtr = "''"
                        Else
                            If rtr <> Val(rtr).ToString Then rtr = "'" & rtr & "'"
                        End If
                    Else
                        For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                            For Each k As Control In grupePitanjaCATI(i).Controls
                                If Mid(k.Name, 1, 2) = "FP" AndAlso Mid(k.Name, 3).Trim.ToUpper = param.Trim.ToUpper Then
                                    Dim pp As String = ""
                                    pp = SE(param, True, k.Parent).Trim.Replace("'", dap)
                                    If IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                                        rtr = pp
                                    Else
                                        rtr = "'" + pp + "'"
                                    End If
                                    Exit For
                                End If
                            Next
                        Next
                    End If

                    Return rtr
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in FP function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "VODVDO"
                Return " 2=3 "

            Case "ROUND"

                Dim m As String = SracunajIzTabele(param)

                Return " 2=3 "
            Case Else
                ''msg 75
                Dim msgtxt As String = getMessageText(dtMessages, "75", Me.jezik)
                ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                'ISTMessageBox.Show("Nepostojeca funkcija!")
        End Select
    End Function

    Public Function prevedi_1Panel(ByVal tabela As String, ByVal panel As Panel, ByVal ime As String, ByVal param As String) As String
        prevedi_1Panel = ""
        Dim glavnatabela As String = tabela
        Select Case ime
            Case ""
                Return param
            Case "KONSULT"
                Try
                    Dim rB As String = ""
                    Dim rT As String = ""
                    Dim rP As String = ""
                    Dim sql As String = ""
                    Dim rez As Integer = 0
                    Dim dodela As String = ""
                    'param je naziv polja
                    'u param dodato i eventualno dodeljivanje drugih polja
                    If param.IndexOf(":") >= 0 Then
                        dodela = param.Substring(param.IndexOf(":") + 1)
                        param = param.Substring(0, param.IndexOf(":"))
                    End If
                    For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                        If p.TABELA.Trim.ToUpper = glavnatabela.Trim.ToUpper And p.POLJE.Trim.ToUpper = param.Trim.ToUpper Then
                            rB = p.RelBaza.Trim.ToUpper : rT = p.RelTabela.Trim.ToUpper : rP = p.RelPolje.Trim.ToUpper
                            Exit For
                        End If
                    Next
                    If DGi(rT, PTabele) = -1 Then
                        If (Not (DTbl Is Nothing)) AndAlso DGi(rT, DTbl) <> -1 Then 'jer je moguc i konsult od ostalih tabela upitnika
                            If DTbl(DGi(rT, DTbl)).Select(rP & "=" & IzDGTzaSQL(param).Trim.ToUpper & " ").Length > 0 Then
                                Return " 2=3 "
                            End If
                        Else 'pravi upit.....
                            Dim rpt As String = IzrazLKTabele(rB, rT)
                            sql = "select * from " & rpt & " " & rT & " where " & rT & "." & rP & "=" & IzDGTzaSQL(param).Trim.ToUpper & " "
                            sql = Me.DodajVodVdo(sql, rB, rpt, rT)
                            If izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik).Rows.Count > 0 Then Return " 2=3 "
                        End If
                        Return " 2=2 " ' jer treba da vrati TRUE ako JESTE greska
                    Else ' samo po datatable-tu, tj. iz "memorije"
                        If PTabele(DGi(rT, PTabele)).Select(rP & "=" & IzDGTzaSQL(param).Trim.ToUpper & " ").Length > 0 Then
                            Return " 2=3 "
                        Else
                            Return " 2=2 "
                        End If
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in KONSULT function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "UPARK"
                Try
                    Dim partbl As String = Trim(Mid(param, 1, InStr(1, param, ",") - 1)).ToUpper
                    Dim izraz As String = Trim(Mid(param, InStr(1, param, ",") + 1)).ToUpper

                    Dim kv() As String = razkvantaj(izraz) 'upark, dakle MORA biti navedena GlavnaTabela.polje
                    izraz = ""
                    For i As Integer = 0 To kv.GetUpperBound(0)
                        If InStr(kv(i), glavnatabela.Trim.ToUpper & ".") <> 0 OrElse ELPoljeUTabeli(kv(i), glavnatabela.Trim.ToUpper) Then
                            izraz = izraz & " " & IzDGTzaSQL(Mid(kv(i), InStr(kv(i), ".") + 1))
                        ElseIf InStr(kv(i), partbl.Trim.ToUpper & ".") <> 0 OrElse ELPoljeUTabeli(kv(i), partbl) Then
                            izraz = izraz & " " & IzDGTzaSQL(Mid(kv(i), InStr(kv(i), ".") + 1), DGTabelePanel(DGi(partbl)))
                        Else
                            izraz = izraz & " " & kv(i)
                        End If
                    Next

                    izraz = izraz.Trim.ToUpper
                    If InStr(izraz, "CAST") <> 0 OrElse izraz.IndexOf("CHARINDEX") >= 0 OrElse izraz.IndexOf("INSTR") >= 0 OrElse izraz.IndexOf("ISDATE") >= 0 Then
                        izraz = razCASTi(izraz)
                    End If

                    If Otvorena(partbl) Then
                        Dim r() As DataRow
                        If Me.NslKljuc Is Nothing Then
                            r = DGTabelePanel(DGi(partbl)).Select(izraz.Replace("=N'", "='"))
                        Else
                            r = DTbl(DGi(partbl, DTbl)).Select(izraz.Replace("=N'", "='"))
                        End If
                        If r.Length > 0 Then
                            Return " 2=2 "
                        Else
                            Return " 2=3 "
                        End If
                    Else
                        Dim sql As String = "select * from " & Me.IzrazLKTabele(CStr(dIst.IST.Rows(0).Item("BAZA")).Trim, partbl.Trim.ToUpper) & " " & partbl.Trim & " WHERE 2=2 "
                        For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                            sql = sql + " and " & partbl.Trim & "." & GlavniKljuc(i).Trim & "='"
                            sql = sql + SPK(GlavniKljuc(i), panel).Trim & "' "
                        Next
                        sql = sql + " and " & izraz
                        If izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik).Rows.Count > 0 Then
                            Return " 2=2 " 'NASAO, dakle POSTOJI greska, dakle vraca TRUE!!!!
                        Else
                            Return " 2=3 "
                        End If
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in UPARK function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "ADRESAR"
                Try
                    Dim dodela As String = ""
                    If param.IndexOf(":") >= 0 Then
                        dodela = param.Substring(param.IndexOf(":") + 1)
                        param = param.Substring(0, param.IndexOf(":"))
                    End If

                    Dim partbl As String = Mid(param, 1, InStr(1, param, ";") - 1).Trim.ToUpper
                    param = Mid(param, InStr(1, param, ";") + 1)
                    Dim KljPlj() As String = Split(param, ",")
                    Dim rpt As String = Me.IzrazLKTabele(dIst.IST.Rows(0).Item("BAZA"), partbl.Trim) 'BAZA za Adresar!!!!
                    Dim sql As String = "select * from " & rpt & " " & partbl & " where 2=2 "
                    Dim i As Integer = 0
                    For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                        If p.TABELA.Trim.ToUpper = partbl.Trim.ToUpper Then
                            If Not p.IsKLJUCNull AndAlso p.KLJUC.Trim.ToUpper = "P" Then
                                Dim izvuceno As String = ""
                                Try
                                    If KljPlj(i).IndexOf("'") >= 0 Then
                                        izvuceno = KljPlj(i).Replace("'", "")
                                    Else
                                        izvuceno = DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(KljPlj(i))
                                    End If
                                    If izvuceno.GetType() Is GetType(System.DBNull) OrElse CStr(izvuceno).Trim = "" Then
                                        izvuceno = "NULL"
                                    Else
                                        sql = sql + " and " & p.POLJE.Trim.ToUpper & "=N'" & CStr(izvuceno).Trim & "' "
                                    End If
                                    i = i + 1
                                Catch ex As Exception
                                    ''msg 87
                                    Dim msgtxt87 As String = getMessageText(dtMessages, "87", Me.jezik)
                                    ''msg 88
                                    Dim msgtxt88 As String = getMessageText(dtMessages, "88", Me.jezik)
                                    Dim por As String = msgtxt87 + vbCrLf + vbCrLf + msgtxt88
                                    'Dim por As String = "Greška u ISTPOLJA kod ključeva u ADRESAR tabeli" + vbCrLf +
                                    '"Postoji polje u tabeli ISTPolja koje je P, a nema ga u funkciji ADRESAR."
                                    ISTMessageBox.Show(por + vbCrLf + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                    Exit Function
                                End Try
                            End If
                        End If
                    Next

                    If DGi(partbl.Trim, PTabele) = -1 Then
                        sql = Me.DodajVodVdo(sql, CStr(dIst.IST.Rows(0).Item("BAZA")).Trim, rpt, partbl)
                        If izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik).Rows.Count > 0 Then
                            Return " 2=3 "
                        Else
                            Return " 2=2 "
                        End If
                    Else ' u memoriji
                        Dim sql1 As String = sql.Substring(sql.IndexOf("2=2") + 8)

                        If PTabele(DGi(partbl.Trim, PTabele)).Select(sql1.Replace("=N'", "='")).Length > 0 Then
                            Return " 2=3 "
                        Else
                            Return " 2=2 "
                        End If
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in ADRESAR function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "RELACIJA"
                Try
                    param = param.Replace("[", "")
                    param = param.Replace("]", "")
                    Dim dodela As String = ""
                    If param.IndexOf(":") >= 0 Then
                        dodela = param.Substring(param.IndexOf(":") + 1)
                        param = param.Substring(0, param.IndexOf(":"))
                    End If

                    Dim partbl As String = Mid(param, 1, InStr(1, param, ";") - 1).Trim.ToUpper
                    param = Mid(param, InStr(1, param, ";") + 1)
                    Dim KljPlj() As String = Split(param, ",")
                    Dim rpt As String = partbl   'rpt je sve (RPJ.dbo.OPSTINE)
                    partbl = partbl.Substring(partbl.LastIndexOf(".") + 1)   'samo OPSTINE

                    Dim sql As String = ""
                    Dim zamenaGM As Boolean = False
                    Dim izrazSelect As Boolean = False
                    If rpt.Trim.ToUpper.IndexOf("SELECT") > 0 Then
                        izrazSelect = True
                        sql = "select * from " & rpt & " " & "P" & " where 2=2 "
                        'zamena ako treba GGG,MMM,vrtacka,{GGG},{MMM}
                        If rpt.Trim.ToUpper.IndexOf("GGG") >= 0 Then
                            zamenaGM = True
                        ElseIf rpt.Trim.ToUpper.IndexOf("YYY") >= 0 Then
                            zamenaGM = True
                        ElseIf rpt.Trim.ToUpper.IndexOf("MMM") >= 0 Then
                            zamenaGM = True
                        ElseIf rpt.Trim.ToUpper.IndexOf("VRTACKA") >= 0 Then
                            zamenaGM = True
                        ElseIf rpt.Trim.ToUpper.IndexOf("GGM") >= 0 Then
                            zamenaGM = True
                        ElseIf rpt.Trim.ToUpper.IndexOf("YYM") >= 0 Then
                            zamenaGM = True
                        End If
                        sql = ZameniGGGMMMUnos(sql)
                        rpt = ZameniGGGMMMUnos(rpt)
                    Else
                        sql = "select * from " & rpt & " " & partbl & " where 2=2 "
                    End If

                    For i As Integer = 0 To KljPlj.GetUpperBound(0)
                        Dim izvuceno As String = ""
                        Dim kk() As String = KljPlj(i).Split("="c)
                        If kk(0).IndexOf("'") >= 0 Then 'tj. IMA apostrof, dakle "konstanta" je, a ne polje
                            izvuceno = kk(0).Replace("'", "")
                        Else
                            'izvuceno = DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(kk(0).Trim)
                            If DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(kk(0).Trim).GetType() Is GetType(System.DBNull) Then
                                izvuceno = "NULL"
                            Else
                                izvuceno = DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(kk(0).Trim)
                            End If
                        End If
                        If izvuceno.GetType() Is GetType(System.DBNull) OrElse CStr(izvuceno).Trim = "" OrElse CStr(izvuceno).Trim.ToUpper = "NULL" Then
                            izvuceno = "NULL"
                        Else
                            sql = sql + " and " & kk(1).Trim & "=N'" & CStr(izvuceno).Trim & "' "
                        End If
                    Next

                    imaIhViseURelaciji = False

                    '****************'****************'****************'****************
                    'MEM
                    ''SAMO MEM  - AKO JE UZ JA ISTA TABELA KOJA JE U POLJU TABELA ISTPOLJA
                    Dim memtabela As String = ""
                    Dim MEM As Boolean = False
                    Dim bMEM() As String = razkvantaj(rpt)
                    For mm As Integer = 0 To bMEM.GetUpperBound(0)
                        If bMEM(mm).Trim.IndexOf("MEM") = 0 AndAlso bMEM(mm).Trim.IndexOf("MEM.") <> 0 Then
                            MEM = True
                            memtabela = bMEM(mm - 1).Trim.ToUpper
                            Exit For
                        End If
                    Next
                    Dim dtMEM As New DataTable
                    Dim prepis As Boolean = False
                    Dim selekt As String = ""
                    Dim orderby As String = ""

                    If MEM = True Then
                        Dim pp As String = ""
                        Dim odCega As String = ""
                        Dim rezMEM As String = ""
                        Dim uslov As String = "2=2"
                        Dim zzz As String = rpt
                        If zzz.Trim.ToUpper.IndexOf("SELECT") > 0 Then
                            selekt = zzz.Substring(0, zzz.Trim.ToUpper.IndexOf(" FROM"))
                            If selekt.Trim.ToUpper.IndexOf("TOP") < 0 AndAlso selekt.Trim.ToUpper.IndexOf("ORDER") > 0 Then
                                selekt = selekt.Trim.ToUpper.Replace("SELECT", "SELECT TOP 10")
                            End If

                            selekt = selekt.Trim.ToUpper.Replace("(", "").Replace("SELECT", "")
                            Dim imatop As Boolean = False
                            If selekt.Trim.ToUpper.IndexOf("TOP") >= 0 Then
                                selekt = selekt.Trim.ToUpper.Replace("TOP", "")
                                imatop = True
                            End If
                            selekt = selekt.Trim
                            If imatop = True AndAlso selekt.Length > zzz.Trim.ToUpper.IndexOf(" ") Then
                                selekt = selekt.Substring(zzz.Trim.ToUpper.IndexOf(" ") + 1)  ' da ukoka broj posle topa ide od prvog blanka
                            End If
                            If selekt.IndexOf("*") < 0 AndAlso selekt.IndexOf(",") > 0 Then
                                prepis = True
                            End If
                        End If
                        If zzz.Trim.ToUpper.IndexOf("WHERE") > 0 Then
                            uslov = uslov + " And " + zzz.Trim.Substring(zzz.Trim.ToUpper.IndexOf("WHERE") + 6)
                            uslov = uslov + "#$#"
                            uslov = uslov.Replace(")#$#", "")
                            If CStr(uslov).Trim.ToUpper.IndexOf("D.") >= 0 Then uslov = zameniDPanel(uslov, panel)
                            uslov = uslov.Trim.ToUpper.Replace("JA.", "")
                            uslov = uslov.Trim.ToUpper.Replace("MEM.", "")
                        End If
                        If uslov.Trim.ToUpper.IndexOf("ORDER BY") > 0 Then
                            Dim k As Integer = uslov.Trim.ToUpper.IndexOf("ORDER BY")
                            orderby = uslov.Substring(k + 9)
                            uslov = uslov.Substring(0, k)
                            If orderby.IndexOf(",") >= 0 Then
                                Dim am() As String = orderby.Split(",")
                                orderby = ""
                                For i As Integer = 0 To am.GetUpperBound(0)
                                    If am(i).Trim.ToUpper.IndexOf(" ASC") < 0 AndAlso am(i).Trim.ToUpper.IndexOf(" DESC") < 0 Then
                                        am(i) = am(i) + " ASC"
                                    End If
                                    orderby = orderby + am(i) + ","
                                Next
                                orderby = orderby + "#$#"
                                orderby = orderby.Replace(",#$#", "")
                            Else
                                If orderby.Trim.ToUpper.IndexOf(" ASC") < 0 AndAlso orderby.Trim.ToUpper.IndexOf(" DESC") < 0 Then
                                    orderby = orderby + " ASC"
                                End If
                            End If
                        End If

                        If DGi(memtabela, DTbl) > -1 Then
                            For i As Integer = 0 To KljPlj.GetUpperBound(0)
                                Dim izvuceno As String = ""
                                Dim kk() As String = KljPlj(i).Split("="c)
                                If kk(0).IndexOf("'") >= 0 Then 'tj. IMA apostrof, dakle "konstanta" je, a ne polje
                                    izvuceno = kk(0).Replace("'", "")
                                Else
                                    If DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(kk(0).Trim).GetType() Is GetType(System.DBNull) Then
                                        izvuceno = "NULL"
                                    Else
                                        izvuceno = DGTabelePanel(DGi(glavnatabela)).Rows(0).Item(kk(0).Trim)
                                    End If
                                End If
                                If izvuceno.GetType() Is GetType(System.DBNull) OrElse CStr(izvuceno).Trim = "" OrElse CStr(izvuceno).Trim.ToUpper = "NULL" Then
                                    izvuceno = "NULL"
                                Else
                                    uslov = uslov + " and " & kk(1).Trim & "='" & CStr(izvuceno).Trim & "' "
                                End If
                            Next

                            uslov = uslov.Replace("CONVERT ", "CONVERT").Replace("CONVERT", "Convert").Replace("SYSTEM.INT32", "System.Int32")

                            Dim redoviMEM() As DataRow
                            If DTbl Is Nothing Then
                                redoviMEM = DGTabele(DGi(memtabela, DTbl)).Select(uslov.Replace("=N'", "='"))
                                dtMEM = DGTabele(DGi(memtabela, DTbl)).Copy
                            Else
                                redoviMEM = DTbl(DGi(memtabela, DTbl)).Select(uslov.Replace("=N'", "='"))
                                dtMEM = DTbl(DGi(memtabela, DTbl)).Copy
                            End If

                            dtMEM.Clear()
                            For Each redMEM As DataRow In redoviMEM
                                dtMEM.ImportRow(redMEM)
                            Next
                            If orderby <> "" Then dtMEM.DefaultView.Sort = orderby

                            'ElseIf DGi Is Nothing Then
                        Else
                            MsgBox("Table " & memtabela & " used In " & rpt &
                            " are Not In valid time point!", vbInformation, "")
                        End If
                        Dim ddd As New DataTable
                        If prepis = False Then
                            ddd = dtMEM
                        Else
                            Dim view As System.Data.DataView = New System.Data.DataView(dtMEM)
                            Dim oo As String() = selekt.Replace(" ", "").Split(",")
                            Dim selected As System.Data.DataTable = view.ToTable(True, oo)
                            If orderby <> "" Then selected.DefaultView.Sort = orderby
                            ddd = selected
                        End If
                        imaIhViseURelaciji = False
                        If ddd.Rows.Count > 0 Then
                            If ddd.Rows.Count > 1 Then imaIhViseURelaciji = True
                            'ispravan
                            Return " 2=3 "
                        Else
                            'neispravan
                            Return " 2=2 "
                        End If

                    End If  'if MEM=true

                    '****************'****************'****************'****************

                    If MEM = False Then
                        If izrazSelect = True Then 'sigurno nije u memoriji
                            If zamenaGM = False Then sql = Me.DodajVodVdo(sql, CStr(dIst.IST.Rows(0).Item("BAZA")).Trim, rpt, "P")
                            Dim ddtt As New DataTable
                            ddtt = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)
                            imaIhViseURelaciji = False
                            If ddtt.Rows.Count > 0 Then
                                If ddtt.Rows.Count > 1 Then imaIhViseURelaciji = True
                                'ispravan
                                Return " 2=3 "
                            Else
                                'neispravan
                                Return " 2=2 "
                            End If
                        Else
                            'ISTMessageBox.Show("aaaa")


                            If DGi(partbl.Trim, PTabele) = -1 Then 'da se vidi prvo da li je u memoriji
                                NapuniPTabelePanel(partbl.Trim,,, "R")
                            End If
                            Dim sql1 As String = ""
                            If sql.Trim.Substring(sql.Trim.Length - 3, 3) = "2=2" Then
                                sql1 = ""
                            Else
                                sql1 = sql.Substring(sql.IndexOf("2=2") + 8)
                            End If
                            imaIhViseURelaciji = False
                            If sql1 <> "" AndAlso PTabele(DGi(partbl.Trim, PTabele)).Select(sql1.Replace("=N'", "='")).Length > 0 Then
                                If PTabele(DGi(partbl.Trim, PTabele)).Select(sql1.Replace("=N'", "='")).Length > 1 Then
                                    imaIhViseURelaciji = True
                                End If
                                Return " 2=3 "
                            Else
                                Return " 2=2 "
                            End If
                        End If
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in RELACIJA function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "GGG" ''Or "YYY"
                Return "'" & (Me.mvt.G + CInt(param)).ToString.Trim & " '"
            Case "YYY" ''Or "YYY"
                Return "'" & (Me.mvt.G + CInt(param)).ToString.Trim & " '"
            Case "GGM" ''Or "YYM"
                Dim pomm As Integer = Me.mvt.M + CInt(param) Mod 12
                Dim xpom As Integer = Me.mvt.G + (CInt(param) \ 12)
                If pomm <= 0 Then xpom -= 1
                If pomm > 12 Then xpom += 1
                Return "'" & xpom.ToString.Trim & " '"
            Case "YYM" ''Or "YYM"
                Dim pomm As Integer = Me.mvt.M + CInt(param) Mod 12
                Dim xpom As Integer = Me.mvt.G + (CInt(param) \ 12)
                If pomm <= 0 Then xpom -= 1
                If pomm > 12 Then xpom += 1
                Return "'" & xpom.ToString.Trim & " '"
            Case "MMM"
                Dim xpom As Integer = Me.mvt.M + (CInt(param) Mod 12)
                If xpom <= 0 Then xpom += 12
                If xpom > 12 Then xpom -= 12
                Return "'" & xpom.ToString.Trim.PadLeft(2, "0"c) & " '"
            Case "MBRP"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 8 AndAlso mod11_8(m) Then ' mod11(m) then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "JMBG"
                param = razCASTi(param)
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 13 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "VOPS"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 5 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else : Return " 2=2 "
                End If
            Case "VNAS"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 6 AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "MOD11"
                Dim ppp() As String = Split(param, ",")
                If ppp.GetUpperBound(0) = 0 Then
                    ReDim Preserve ppp(2)
                    ppp(1) = ppp(1).Length()
                End If
                Dim m As String = SracunajIzTabele(param)
                If m.Length = Val(ppp(1)) AndAlso mod11(m) Then
                    Return " 2=3 "
                Else
                    Return " 2=2 "
                End If
            Case "VPIB"
                Dim m As String = SracunajIzTabele(param)
                If m.Length = 9 Then
                    Dim c As Integer = CInt(m.Substring(0, 1))
                    For i As Integer = 1 To 7
                        c = c * 2 Mod 11
                        c = (CInt(m.Substring(i, 1)) + c) Mod 10
                        If c = 0 Then c = 10
                    Next
                    c = c * 2 Mod 11
                    If ((11 - c) Mod 10) = CInt(m.Substring(8, 1)) Then
                        Return " 2=3 "
                    Else
                        Return " 2=2 "
                    End If
                Else
                    Return " 2=2 "
                End If
            Case "FP"
                Try
                    Dim xpom As String = ""
                    xpom = SP(param, panel, True)
                    If xpom.Trim = "" Then
                        xpom = "''"
                    Else
                        If xpom <> Val(xpom).ToString Then xpom = "'" & xpom & "'"
                    End If
                    Return xpom
                Catch ex As Exception
                    ISTMessageBox.Show("Possible syntax error in FP function for " + vbCrLf + param + " part " + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

            Case "VODVDO"
                Return " 2=3 "
            Case Else
                ''msg 75
                Dim msgtxt As String = getMessageText(dtMessages, "75", Me.jezik)
                ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                'ISTMessageBox.Show("Nepostojeca funkcija!")
        End Select
    End Function

