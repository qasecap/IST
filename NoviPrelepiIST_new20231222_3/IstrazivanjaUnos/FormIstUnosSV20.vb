    Function zameniD(ByVal izraz As String) As String
        Dim t As String = GlavnaTabela
        izraz = izraz.Trim.ToUpper
        Dim bbb() As String = razkvantaj(izraz)
        For i As Integer = 0 To bbb.GetUpperBound(0)
            If bbb(i).Trim.IndexOf("D.") = 0 Then
                'sa ekrana pokupi D.
                Dim cime As String = bbb(i).Replace("D.", "").ToString.Trim
                Dim tipString As Boolean = False
                Try
                    If DGTabele(DGi(t, DGTabele)).Columns(cime).DataType.Name.Trim.ToUpper = "STRING" Then
                        tipString = True
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show(cime + "  does not exists in table " + t + " !!!!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try

                Dim deokljuca As Boolean = False
                For ii As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                    If cime.Trim.ToUpper = GlavniKljuc(ii).Trim.ToUpper Then
                        deokljuca = True
                        Exit For
                    End If
                Next
                Dim qq As String = ""
                If deokljuca = True Then
                    If Not SEK(cime) Is Nothing Then qq = SEK(cime).Trim
                Else
                    Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cime)
                    If ind > -1 Then qq = SE(cime, True, nizKontrola(ind).Parent).Trim
                End If

                If qq = "" Then
                    bbb(i) = "Null"
                Else
                    If i - 2 >= 0 AndAlso bbb(i - 2).Length >= 5 AndAlso bbb(i - 2).Trim.ToUpper = "ISNULL" Then
                        bbb(i) = "'" + qq + "'"
                    ElseIf i - 2 >= 0 AndAlso bbb(i - 2).Length >= 9 AndAlso bbb(i - 2).Trim.ToUpper = "SUBSTRING" Then
                        bbb(i) = "'" + qq + "'"
                    ElseIf tipString = True Then
                        bbb(i) = "'" + qq + "'"
                    ElseIf tipString = False AndAlso IsNumeric(qq) = True AndAlso qq.Length >= 1 AndAlso Mid(qq, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                        bbb(i) = qq
                    Else
                        bbb(i) = "'" + qq + "'"
                    End If

                End If
            End If
        Next
        Dim zzz1 As String = ustringaj(bbb).ToUpper
        zzz1 = razCASTi(zzz1)
        zameniD = zzz1
    End Function

