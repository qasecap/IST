            ElseIf nizskociNAsss.Trim.ToUpper = "DUGMESACUVAJ" OrElse nizskociNAsss.Trim.ToUpper = "BUTTONSAVE" Then
                sskoci2Grupa = Me.BtnSave1
                Call kontrpp(cntl, pp, ppRBR, skippedEnabledFalse, skippedVisibleFalse, skippedDontSave, skippedSetEmpty, nizskociAKOsss)
            ElseIf nizskociNAsss.IndexOf("PANEL") = 0 AndAlso nizskociNAsss.IndexOf(".") < 0 Then   'skanje na sam panel
