                        ipanel = ipanel + 1
                        ReDim Preserve grupeCNTLPanel(ipanel)
                        grupeCNTLPanel(ipanel) = pane

                        ReDim Preserve nizPanelaMinRbr(ipanel)
                        nizPanelaMinRbr(ipanel) = -1

                        ZadnjiTabIndex = SklopiOstalePanel(tabNadTab, t, Tabelice, tabele, TabeleRbr, T2, opis, ZadnjiTabIndex, pane, izazur)

                        Dim sbar As Boolean = False

                        Dim ind As Integer = -1
                        Dim bb() As String = tabT2.Split(";")
                        For kk As Integer = 0 To bb.GetUpperBound(0)
                            If bb(kk).Trim.ToUpper.IndexOf("SCROLLBAR") >= 0 OrElse bb(kk).Trim.ToUpper.IndexOf("DONTRESIZE") >= 0 Then
                                sbar = True
                                Exit For
                            End If
                        Next

                        If sbar = False Then
                            pane.AutoScroll = False
                            Call dodajdugmeS(ZadnjiTabIndex, t, pane, ip, paneltab, kojatabela, tabT2)
                        End If

                        If sbar = True Then
                            pane.AutoScroll = True
                            pane.AccessibleName = pane.AccessibleName + "SCROLLBAR;"
                            pane.Width = paneWidthOrig
