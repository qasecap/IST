    Function eexxeecc(ByVal pomOD As String, ByVal plj As String, ByVal cntl As Control) As Boolean
        eexxeecc = True
        Dim execsql As String = ""
        Dim execsimpleMsg As Boolean = False
        Dim nizProvera() As String = {}
        Dim execporukaJe As String = ""
        Dim execnizporukaJE() As String = {}
        Dim execporukaAKO As String = ""
        Dim execnizporukaAKO() As String = {}

        Dim execdialogAKO As String = ""
        Dim execnizdialogAKO() As String = {}
        Dim execdialogJE As String = ""
        Dim execnizdialogJE() As String = {}
        Dim saveNext As Boolean = False
        Dim saveOnly As Boolean = False
        Dim close As Boolean = False
        Dim open As String = ""
        Dim openReport As String = ""
        Dim execISTLK As String = ""

        nizProvera = Split(pomOD, ";")
        For i As Integer = 0 To nizProvera.GetUpperBound(0)
            nizProvera(i) = nizProvera(i).Trim.ToUpper
            If nizProvera(i).IndexOf("EXEC RUNDATAVALIDATIONWITHPRIMARYKEY") = 0 Then execISTLK = razCASTi(nizProvera(i)).Trim
            If nizProvera(i).IndexOf("EXEC ") = 0 AndAlso nizProvera(i).IndexOf("RUNDATAVALIDATIONWITHPRIMARYKEY") < 0 Then execsql = razCASTi(nizProvera(i)).Trim
            If nizProvera(i).IndexOf("EXECSIMPLEMSGIS=") = 0 Then
                execporukaJe = nizProvera(i).Replace("EXECSIMPLEMSGIS=", "")
                execnizporukaJE = Split(execporukaJe, "$")
                execsimpleMsg = True
            End If
            If nizProvera(i).IndexOf("EXECPORUKAJE=") = 0 Then
                execporukaJe = nizProvera(i).Replace("EXECPORUKAJE=", "")
                execnizporukaJE = Split(execporukaJe, "$")
            End If
            If nizProvera(i).IndexOf("EXECPORUKAAKO=") = 0 Then
                execporukaAKO = (nizProvera(i).Replace("EXECPORUKAAKO=", ""))
                execnizporukaAKO = Split(execporukaAKO, "$")
            End If
            If nizProvera(i).IndexOf("EXECMSGIS=") = 0 Then
                execporukaJe = nizProvera(i).Replace("EXECMSGIS=", "")
                execnizporukaJE = Split(execporukaJe, "$")
            End If
            If nizProvera(i).IndexOf("EXECMSGIF=") = 0 Then
                execporukaAKO = (nizProvera(i).Replace("EXECMSGIF=", ""))
                execnizporukaAKO = Split(execporukaAKO, "$")
            End If
            If nizProvera(i).IndexOf("EXECDIALOGIS=") = 0 Then
                execdialogJE = nizProvera(i).Replace("EXECDIALOGIS=", "")
                execnizdialogJE = Split(execdialogJE, "$")
            End If
            If nizProvera(i).IndexOf("EXECDIALOGIF=") = 0 Then
                execdialogAKO = (nizProvera(i).Replace("EXECDIALOGIF=", ""))
                execnizdialogAKO = Split(execdialogAKO, "$")
            End If
            If nizProvera(i).IndexOf("SAVENEXT") = 0 Then
                savenext = True
            End If
            If nizProvera(i).IndexOf("SAVEONLY") = 0 Then
                saveOnly = True
            End If
            If nizProvera(i).IndexOf("OPENREPORT") = 0 Then
                openReport = nizProvera(i).Trim.ToUpper.Replace("OPENREPORT", "")
            End If
            If nizProvera(i).IndexOf("CLOSE") = 0 Then
                close = True
            End If
            If nizProvera(i).IndexOf("OPEN=") = 0 Then
                open = nizProvera(i).Trim.ToUpper.Replace("OPEN=TABLE", "")
            End If
        Next

        If openReport = "" Then

            If execnizporukaAKO.Length = 0 Then
                For i As Integer = 0 To execnizporukaJE.GetUpperBound(0)
                    ReDim Preserve execnizporukaAKO(i)
                    execnizporukaAKO(i) = "2=2"
                    execporukaAKO = execporukaAKO + execnizporukaAKO(i) + ";"
                Next
            End If

            Try
                If execdialogJE.Length > 0 Then
                    If execdialogAKO.Length = 0 Then
                        For i As Integer = 0 To execnizdialogJE.GetUpperBound(0)
                            ReDim Preserve execnizdialogAKO(i)
                            execnizdialogAKO(i) = "2=2"
                        Next
                    End If
                    For sss As Integer = 0 To execnizdialogAKO.GetUpperBound(0)
                        If sdialog1(GlavnaTabela, plj, cntl, execnizdialogAKO(sss), execnizdialogJE(sss)) = True Then
                            Call ee(execsql, execISTLK, plj, cntl, execporukaJe, execporukaAKO, execnizporukaJE, execnizporukaAKO)
                        Else
                            eexxeecc = False  'rekao ne ili cancel
                        End If
                    Next
                Else
                    Call ee(execsql, execISTLK, plj, cntl, execporukaJe, execporukaAKO, execnizporukaJE, execnizporukaAKO)
                End If
            Catch ex As Exception
                ''msg 21
                Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                ISTMessageBox.Show(ex.Message, msgtxt21 + ": sdialog1 bb_click", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End If

        Try
            Dim KljuceviSaEkranaSaVrednostima(,) As String = Nothing
            If open.Trim <> "" Then
                'nevenanevena
                ReDim KljuceviSaEkranaSaVrednostima(GlavniKljuc.GetUpperBound(0), 1)
                For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                    KljuceviSaEkranaSaVrednostima(i, 0) = GlavniKljuc(i).Trim.ToUpper
                    KljuceviSaEkranaSaVrednostima(i, 1) = SEK(GlavniKljuc(i)).Trim.ToUpper
                Next
            End If

            If savenext = True Then
                If close = True Then
                    BtnSamoPamtiClick(cntl, Nothing)
                    neididalje = True
                Else
                    Call BtnSaveNext_Click(cntl, Nothing)
                End If
            End If

            If open.Trim <> "" Then
                Dim frm As New FormIstUnosSV20(Me.dIst, mdtLabel, mdtAWL, mdtQE, mdtMessage,
                Me.DBConnectionString, Me.mvt, open, False, Me.txtInst,
                Me.txtpismo, Me.txtmode, Me.jezik, Me.ISTConnectionString, Me.DSBrisanjeDEPO.Trim.ToUpper,
                Me.DSBrisanjeServer.Trim.ToUpper, Me.DSBrisanjeBaza.Trim.ToUpper, , Me.zakljucanOdmahSve, KljuceviSaEkranaSaVrednostima,
                IIf(Me.NslKljuc Is Nothing, Me.DGTabele, Me.DTbl), IIf(Me.PravaDupeGlava(open), False, True), Me.Left, Me.Top, Me.Width,
                Me.PTabele, Me.XL.Checked, Me.AL.Checked, False,,
                ,,,,,
                CAPIServer, CAPIBaza,, IstStart, Me.DGTabele,
                ,,,,,
                previewEditMode)
                frm.Cursor = Cursors.WaitCursor
                Try
                    frm.ShowDialog()
                    frm.Cursor = Cursors.Default
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                    frm.Cursor = Cursors.Default
                    frm.Dispose()
                End Try
            End If

            If saveOnly = True Then
                BtnSamoPamtiClick(cntl, Nothing)
                neididalje = True
            End If

            If openReport <> "" Then
                Dim openWhat As String = ""
                If IsNumeric(openReport.Trim) Then
                    openWhat = openReport.Trim
                Else
                    If IsNumeric(SE(openReport.Trim, True).Trim) Then
                        openWhat = SE(openReport.Trim, True)
                    End If
                End If

                Me.Cursor = Cursors.WaitCursor
                cntl.Enabled = False
                Try
                    Call rreport(openWhat.Trim, execsql)
                Catch ex As Exception
                    Me.Cursor = Cursors.Default
                    cntl.Enabled = True
                    ISTMessageBox.Show(ex.Message)
                    Call End_App("EXCEL", Nothing, Nothing)
                    Call End_App("WINWORD", Nothing, Nothing)
                    ISTMessageBox.Show("Try again!")
                Finally
                    Me.Cursor = Cursors.Default
                    cntl.Enabled = True
                End Try
            End If

            If close = True Then Me.Close()

        Catch ex As Exception
            Me.Cursor = Cursors.Default
        End Try

    End Function

    Sub rreport(ByVal openReport As String, ByVal execsql As String)
        'imam koji report treba da se otvori
        Dim dt As DataTable = Nothing
        'izvrsi upit
        If execsql <> "" Then
            execsql = SrediPMGK(execsql)
            execsql = ZameniGGGMMMUnos(execsql)
            execsql = sracunajIzraz(execsql, Nothing, Nothing)
            execsql = execsql.Replace(" '", " N'").Replace(", '", ", N'")
            dt = izvrsiSQLvratiDT(execsql, DBConnectionString, Nothing)
        End If

        If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
            Dim ttab As DatasetIstrazivanja.ISTTABSDataTable
            ttab = dIst.ISTTABS
            Dim dr() As DataRow = ttab.Select("RbrTabele=" + openReport)
            If dr.Length > 0 Then
                Dim excelzag As String = dr(0).Item("excelzag").ToString
                Dim wordTemplate As String = dr(0).Item("program").ToString
                Call DajIzvestaj(excelzag, wordTemplate, dt)
            End If
        End If

    End Sub
