                gg = nizCHB(kk).Split(":")(0)
                If gg.Trim.ToUpper = grupa.Trim.ToUpper Then
                    bb = nizCHB(kk).Split(":")(1).Split("$")
                    Exit For
                End If
            End If
        Next
        Return bb
    End Function
    Private Function kojeugrupi2(ByVal grupa As String) As CheckBox()
        Dim bb() As CheckBox
        Dim ind As Integer = -1
        For i As Integer = 0 To nizCHBox.GetUpperBound(0)
            If Not nizCHBox(i) Is Nothing AndAlso Not nizCHBox(i).Tag Is Nothing AndAlso nizCHBox(i).Tag.trim.toupper <> "" Then
                Dim pgrupa As String = nizCHBox(i).Tag.trim.toupper
                If pgrupa = grupa.Trim.ToUpper Then
                    ind = ind + 1
                    ReDim Preserve bb(ind)
                    bb(ind) = nizCHBox(i)
                End If
            End If
        Next
        Return bb
    End Function

    Private Sub hhgrupatextbox(ByVal pp As Panel, ByVal grupa As String, ByVal vrPolja As String, ByVal vredHH As Integer, ByVal pppom As Panel)
        Dim vvrreedd As String = ""
        Dim rtb As pomTextBox = NadjiKontrolu(pp, "pomocno" & "_" & grupa)
        If vrPolja = "True" Then
            vvrreedd = vredHH
            If Not rtb Is Nothing Then
                If rtb.Text = "" Then
                    rtb.Text = vvrreedd
                Else
                    rtb.Text = rtb.Text & "-" & vvrreedd
                End If
            End If
        Else
            vvrreedd = ""
            If Not rtb Is Nothing Then
                Dim mm As String = vredHH
                If rtb.Text.Trim = (mm) Then
                    rtb.Text = rtb.Text.Replace(mm, "")
                ElseIf rtb.Text.IndexOf(mm) = 0 Then
                    rtb.Text = rtb.Text.Replace(mm & "-", "")
                Else
                    rtb.Text = rtb.Text.Replace("-" & mm, "")
                End If
            End If
        End If

        Dim chP() As String = kojeugrupi(nizCHB, grupa)
        If vvrreedd <> "" Then
            For i As Integer = 0 To chP.GetUpperBound(0)
                Dim tb As TextBox = NadjiKontrolu(pp, "TP" & chP(i))
                If Not tb Is Nothing AndAlso tb.Text = "" Then
                    tb.Text = vvrreedd
                    Dim pljplj As String = Mid(tb.Name.Trim.ToUpper, 3)
                    Me.UpisiPolje(pljplj, vvrreedd, "TP_VALIDATING", pppom)
                    Exit For
                End If
            Next
        Else
            'ako je vredd="" onda nadji gde je taj i pomeri ostale
            Dim koji As Integer = 0
            For i As Integer = 0 To chP.GetUpperBound(0)
                Dim tb As TextBox = NadjiKontrolu(pp, "TP" & chP(i))
                If Not tb Is Nothing AndAlso tb.Text = vredHH Then
                    tb.Text = ""
                    koji = i
                    Exit For
                End If
            Next
            For i As Integer = koji To chP.GetUpperBound(0)
                Dim tb As TextBox = NadjiKontrolu(pp, "TP" & chP(i))
                If i < chP.GetUpperBound(0) Then
                    Dim tbSl As TextBox = NadjiKontrolu(pp, "TP" & chP(i + 1))
                    If Not tb Is Nothing AndAlso Not tbSl Is Nothing Then
                        tb.Text = tbSl.Text
                    End If
                ElseIf i = chP.GetUpperBound(0) Then
                    tb.Text = ""
                End If
                Dim pljplj As String = Mid(tb.Name.Trim.ToUpper, 3)
                Me.UpisiPolje(pljplj, vvrreedd, "TP_VALIDATING", pppom)
            Next

        End If
    End Sub

