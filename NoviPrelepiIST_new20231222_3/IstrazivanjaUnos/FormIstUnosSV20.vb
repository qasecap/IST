        pom = ZameniGGGMMMUnos(pom)
        k.Tag.izraz = pom

        Dim zzz As String = k.Tag.Izraz.ToString.Trim

        Dim nadtabela As String = nadtabelaJe(Me.GlavnaTabela)
        If nadtabela <> "" AndAlso (CStr(k.Tag.izraz).Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse CStr(k.Tag.izraz).Trim.ToUpper.IndexOf("HEAD.") >= 0) Then 'oblik je GLAVA.polje
            zzz = k.Tag.Izraz.ToString.Trim
            Dim bbb() As String = razkvantaj(zzz)
            For i As Integer = 0 To bbb.Length() - 1
                bbb(i) = GlavaHead(bbb(i), DTbl(DGi(nadtabela)).Rows(0))
            Next
            zzz = ustringaj(bbb).ToUpper
            k.Tag.izraz = zzz
        End If

        If k.Tag.rel(0) = "#" AndAlso CStr(k.Tag.izraz).Trim.ToUpper.IndexOf("SELECT ") >= 0 Then
            ':P vidi se u azuriranju, ne u unosu, :S obratno (ili obratno skroz)

            Try


                zzz = k.Tag.Izraz.ToString.Trim
                zzz = NZ(Replace(zzz, "cast ( '' as decimal", "cast ( '0' as decimal", 1, , CompareMethod.Text)).Trim
                zzz = NZ(Replace(zzz, "cast ( '' as numeric", "cast ( '0' as numeric", 1, , CompareMethod.Text)).Trim

                Dim bbb() As String = razkvantaj(zzz.Trim, True)
                For i As Integer = 0 To bbb.Length - 1
                    If bbb(i).Length() > 1 AndAlso bbb(i).Substring(0, 2).ToUpper = "D." Then
                        Dim datetimeje As Boolean = False
                        Dim stringJe As Boolean = False
                        Dim mpom As String = ""
                        If Not (DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2)) Is Nothing) AndAlso DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).DataType.Name.ToString.Trim.ToUpper = "DATETIME" Then
                            datetimeje = True
                            If DGTabele(DGi(GlavnaTabela)).Rows(0).Item(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).ToString <> "" Then
                                mpom = CDate(DGTabele(DGi(GlavnaTabela)).Rows(0).Item(bbb(i).Substring(2).Replace("[", "").Replace("]", ""))).ToString("yyyy-MM-dd HH:mm:ss")
                            End If
                        ElseIf Not (DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2)) Is Nothing) AndAlso DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).DataType.Name.ToString.Trim.ToUpper = "STRING" Then
                            stringJe = True
                            mpom = DGTabele(DGi(GlavnaTabela)).Rows(0).Item(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).ToString.Trim
                        ElseIf Not (DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2)) Is Nothing) AndAlso DGTabele(DGi(GlavnaTabela)).Columns(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).DataType.Name.ToString.Trim.ToUpper = "CHAR" Then
                            stringJe = True
                            mpom = DGTabele(DGi(GlavnaTabela)).Rows(0).Item(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).ToString.Trim
                        Else
                            mpom = DGTabele(DGi(GlavnaTabela)).Rows(0).Item(bbb(i).Substring(2).Replace("[", "").Replace("]", "")).ToString.Trim
                        End If
                        If mpom = "" Then
                            'bbb(i) = "NULL"
                            bbb(i) = "''"
                        Else
                            If datetimeje = True Then
                                bbb(i) = "'" & izbaciPT(mpom) & "'"
                            ElseIf stringJe = True Then
                                If IsNumeric(mpom) Then
                                    bbb(i) = "'" & mpom & "'"
                                Else
                                    bbb(i) = "N'" & mpom & "'"
                                End If
                            Else
                                bbb(i) = mpom
                                'If IsNumeric(mpom) Then
                                '    bbb(i) = "'" & mpom & "'"
                                'Else
                                '    bbb(i) = "N'" & mpom & "'"
                                'End If
                            End If
                        End If
                        If formatDec = "," Then bbb(i) = bbb(i).Replace(",", ".")
                    End If
                Next

                zzz = ustringaj(bbb)
                zzz = "select (" + zzz + ")"
            Catch ex As Exception
                zzz = "SELECT ''"
            End Try
        End If

        Return zzz
    End Function

    Function sracunaj(ByVal k As Control, ByVal panel As Panel) As String

        Dim bbb() As String = razkvantaj(k.Tag.izraz)
        Dim pp As String = ""
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            bbb(ll) = bbb(ll).Trim.ToUpper.Replace("D.", "")
            If NijeGlavniKljuc(bbb(ll)) = True Then
                If Not NadjiKontroluSkrKojaNijeLABELA(panel, bbb(ll).Replace("#FP{", "").Replace("}", ""), 3) Is Nothing Then
                    If bbb(ll).Trim.IndexOf("#FP{") = 0 Then  'fiktivno polje
                        'saekrana pokupi fiktivno polje
                        pp = SP(bbb(ll).Replace("}", "").Substring(4), panel, True).Trim.Replace("'", dap)
                        If ll - 2 >= 0 AndAlso bbb(ll - 2).Length >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                            If ll + 2 >= 0 AndAlso bbb(ll + 2).Length >= 0 AndAlso bbb(ll + 2).Trim.ToUpper = "0" Then
                                If IsNumeric(pp) = True Then
                                    bbb(ll) = pp
                                ElseIf pp = "''" OrElse pp = "" Then
                                    'pp = "Null"
                                    bbb(ll) = "Null"
                                Else
                                    bbb(ll) = "'" + pp + "'"
                                End If
                            Else
                                bbb(ll) = "'" + pp + "'"
                            End If
                        ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                            bbb(ll) = pp
                        ElseIf pp = "0" Then  'samo nula
                            bbb(ll) = pp
                        Else
                            bbb(ll) = "'" + pp + "'"
                        End If
                    ElseIf bbb(ll) <> "" Then
                        'saekrana
                        If SP(bbb(ll), panel).Trim = "" Then
                            bbb(ll) = "Null"
                        ElseIf SP(bbb(ll), panel).Trim = "?" Then
                            bbb(ll) = "Null"
                        ElseIf SP(bbb(ll), panel).Trim = "!" Then
                            bbb(ll) = "Null"
                        Else
                            pp = SP(bbb(ll), panel).Trim.Replace("'", dap)
                            If ll - 2 >= 0 AndAlso bbb(ll - 2).Length >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                                If ll + 2 >= 0 AndAlso bbb(ll + 2).Length >= 0 AndAlso bbb(ll + 2).Trim.ToUpper = "0" Then
                                    If IsNumeric(pp) = True Then
                                        bbb(ll) = pp
                                    ElseIf pp = "''" OrElse pp = "" Then
                                        'pp = "Null"
                                        bbb(ll) = "Null"
                                    Else
                                        bbb(ll) = "'" + pp + "'"
                                    End If
                                Else
                                    bbb(ll) = "'" + pp + "'"
                                End If
                            ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                                bbb(ll) = pp
                            ElseIf pp = "0" Then  'samo nula
                                bbb(ll) = pp
                            Else
                                bbb(ll) = "'" + pp + "'"
                            End If
                        End If
                    End If
                End If
            Else
                'deo kljuca
                'saekrana kljuc
                If SPK(bbb(ll), panel).Trim = "" Then
                    bbb(ll) = "Null"
                ElseIf SPK(bbb(ll), panel).Trim = "?" Then
                    bbb(ll) = "Null"
                ElseIf SPK(bbb(ll), panel).Trim = "!" Then
                    bbb(ll) = "Null"
                Else
                    pp = SPK(bbb(ll), panel).Trim.Replace("'", dap)
                    If ll - 2 >= 0 AndAlso bbb(ll - 2).Length >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                        If pp = "''" OrElse pp = "" Then
                            'pp = "Null"
                            bbb(ll) = "Null"
                        Else
                            bbb(ll) = "'" + pp + "'"
                        End If
                    ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                        bbb(ll) = pp
                    ElseIf pp = "0" Then  'samo nula
                        bbb(ll) = pp
                    Else
                        bbb(ll) = "'" + pp + "'"
                    End If
                End If
            End If
        Next

        sracunaj = razCASTi(ustringaj(bbb).ToUpper)
    End Function

