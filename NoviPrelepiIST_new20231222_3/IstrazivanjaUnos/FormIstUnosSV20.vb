            If (TypeOf k Is TextBox OrElse TypeOf k Is pomTextBox) AndAlso k.TabIndex > 0 AndAlso k.Visible = True AndAlso DirectCast(k, TextBox).ReadOnly = False AndAlso DirectCast(k, TextBox).Enabled = True AndAlso k.TabIndex > mt Then
                mt = k.TabIndex
                tbox = k
            ElseIf TypeOf k Is ComboBox AndAlso k.Visible = True AndAlso k.TabIndex > 0 AndAlso DirectCast(k, TextBox).Enabled = True AndAlso k.TabIndex > mt Then
                mt = k.TabIndex
                tbox = k
            End If
        Next
        Return tbox
    End Function

