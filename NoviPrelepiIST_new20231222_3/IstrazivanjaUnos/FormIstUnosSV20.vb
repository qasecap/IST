        Dim f3 As Integer = 0

        For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If p.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                If Not p.IsFormaNull AndAlso p.Forma.Trim <> "" AndAlso p.Forma.Trim <> "1" Then
                    Dim x() As String = Split(p.Forma.Trim, ".")
                    If x.Length = 3 AndAlso (x(0) <> "" AndAlso x(1) <> "" AndAlso x(2) <> "") Then
                        'x(0) - tabela  x(1) - red  x(2) - kolona
                        f1 = CInt(x(0))
                        f3 = CInt(x(2))
                        Dim dd As String = ""
                        If TabelicaKolonaDuzinaPanel.Length <= f1 Then ReDim Preserve TabelicaKolonaDuzinaPanel(f1)

                        If TabelicaKolonaDuzinaPanel(f1) Is Nothing Then
                            ReDim Preserve TabelicaKolonaDuzinaPanel(f1)(f3)
                        Else
                            If TabelicaKolonaDuzinaPanel(f1).Length <= f3 Then ReDim Preserve TabelicaKolonaDuzinaPanel(f1)(f3)
                        End If

                        TabelicaKolonaDuzinaPanel(f1)(f3) = 100
                        If Not p.IsVSNull AndAlso p.VS.Trim.Length = 0 Then p.VS = 100
                        If p.IsVSNull Then p.VS = 100

                        If Not p.IsVSNull AndAlso p.VS.Trim.IndexOf(";") >= 0 Then
                            p.VS = Val(Split(p.VS.Trim, ";")(0))
                        End If
                        TabelicaKolonaDuzinaPanel(f1)(f3) = p.VS.Trim.ToUpper
                    End If
                End If
            End If
        Next

        If sbar = False Then
            Dim brojKolona As Integer = 0
            For i As Integer = 0 To TabelicaKolonaDuzinaPanel.GetUpperBound(0)
                If Not TabelicaKolonaDuzinaPanel(i) Is Nothing Then
                    brojKolona = TabelicaKolonaDuzinaPanel(i).GetUpperBound(0)
                    For j As Integer = 1 To TabelicaKolonaDuzinaPanel(i).GetUpperBound(0)
                        If brojKolona > 9 Then TabelicaKolonaDuzinaPanel(i)(j) = 9 / (1 + brojKolona) * TabelicaKolonaDuzinaPanel(i)(j)
                    Next
                End If
            Next
        End If

    End Sub

    Private Function f2T(ByVal formatiran As String) As Integer()
        Dim nizint() As Integer = {}
        If formatiran <> "" Then
            Dim x() As String = Split(formatiran, ".")
            If x.Length = 3 Then
                For i As Integer = 0 To x.GetUpperBound(0)
                    ReDim Preserve nizint(i)
                    If IsNumeric(x(i)) Then nizint(i) = CInt(x(i)) Else nizint(i) = 0
                Next
            End If
        End If
        Return nizint
    End Function
