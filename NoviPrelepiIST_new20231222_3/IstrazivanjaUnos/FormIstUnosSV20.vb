    Function optionMSG(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal oMSGIF As String, ByVal oMSGIS As String,
                       ByVal oMSGARRAYSKIPTO As String(), ByVal oMSGARRAYBTEXT As String(), ByVal broj As Integer,
                       ByVal oMSGskippedEnabledFalse As Boolean, ByVal oMSGskippedSetEmpty As Boolean,
                       ByVal oMSGskippedDontSave As Boolean, ByVal oMSGskippedVisibleFalse As Boolean) As Control

        optionMSG = Nothing
        Dim zzz As String = ""
        If SCati = False Then zzz = sracunajIzraz(oMSGIF, plj, cntl)
        Dim a As Integer = scompute(zzz, plj, "messageif")       '1 TRUE, 0 FALSE
        If a = 1 Then ' ispunjen USLOV
            Dim frm As New IstrazivanjaUnos.FormOptionMSG(GlavnaTabela, plj, cntl, oMSGIF, oMSGIS, oMSGARRAYSKIPTO, oMSGARRAYBTEXT, broj)
