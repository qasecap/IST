    Sub finalySkipGrupaNazad(ByVal cntl As Control, ByVal plj As String, Optional ByVal autb As Boolean = False)
        Try

            Dim cntlskociNAzad As String = ""
            Dim tblok As Integer = 0
            tblok = Array.IndexOf(grupePitanjaCAPI, cntl.Parent)
            IndBlokaNaKomeSmo = tblok
            Dim pblok As Integer = -1
            Dim bbss As Control = Nothing
            If Not cntl.AccessibleName Is Nothing Then
                cntl.AccessibleName = cntl.AccessibleName.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                Dim p As Integer = cntl.AccessibleName.Trim.ToUpper.IndexOf("SKIPFROM")
                If p >= 0 Then
                    Dim pp As String = cntl.AccessibleName.Trim.Substring(p + 8)
                    cntlskociNAzad = pp.Substring(0, pp.IndexOf(";"))
                End If

                Dim m As Integer = cntl.AccessibleName.Trim.ToUpper.IndexOf("FROMGROUP")
                If m >= 0 Then
                    Dim pp As String = cntl.AccessibleName.Trim.Substring(m + 9)
                    pblok = pp.Substring(0, pp.IndexOf(";"))
                End If
                If cntlskociNAzad <> "" AndAlso pblok > -1 Then
                    'nadjikontrolu cntlskociNAzad u nbloku
                    bbss = nadjiKontroluUCAPIBLOKU(cntlskociNAzad, pblok)
                    cntl.AccessibleName = cntl.AccessibleName.Trim.Replace("SKIPFROM" + cntlskociNAzad.Trim.ToUpper + ";", "")
                    cntl.AccessibleName = cntl.AccessibleName.Trim.Replace("FROMGROUP" + Str(pblok).Trim + ";", "")
                    cntl.AccessibleName = cntl.AccessibleName.Trim.Replace("TOGROUP" + Str(tblok).Trim + ";", "")
                End If
            End If

            If cntlskociNAzad <> "" Then   'bilo skakanje
                If Not bbss Is Nothing Then
                    nepotrebnavalidacija = True
                    If tblok = pblok Then
                        bbss.Focus()
                    Else
                        grupePitanjaCAPI(tblok).Visible = False

                        Call SuspendDrawing(grupePitanjaCAPI(pblok))
                        grupePitanjaCAPI(pblok).Visible = True
                        Call ResumeDrawing(grupePitanjaCAPI(pblok))

                        IndBlokaNaKomeSmo = pblok
                        bbss.Focus()
                    End If
                    Exit Sub
                End If
            End If
            If cntlskociNAzad = "" Then   'nije bilo skakanje
                Dim SpT As Boolean = False
                Dim PB As Boolean = False
                If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then
                    ' nema validacije
                    nepotrebnavalidacija = True
                    If dalijeprviCAPIPanel(cntl.Parent) = False AndAlso dalijeprvaCNTLCAPIPanel(cntl) = True Then
                        'Call dugmeCAPIP(cntl)
                        PB = True
                        'e.SuppressKeyPress = True   'zbog multiline inace ne radi
                    ElseIf dalijeprviCAPIPanel(cntl.Parent) = True AndAlso dalijeprvaCNTLCAPIPanel(cntl) = True Then
                        'MORA OVAKO INACE AKO PRITISNU ISTOVREMENO KEUP AND KEYDDOWN PUSTA IH DA ODU, a cntl.focus ne radi nista
                        nepotrebnavalidacija = False
                    ElseIf dalijeprviCAPIPanel(cntl.Parent) = False AndAlso dalijeprvaCNTLCAPIPanel(cntl) = False Then
                        SpT = True
                    ElseIf dalijeprviCAPIPanel(cntl.Parent) = True AndAlso dalijeprvaCNTLCAPIPanel(cntl) = False Then
                        SpT = True
                    End If
                End If

                If SpT = True Then
                    SendKeys.SendWait("+{TAB}")
                    nepotrebnavalidacija = False
                    Exit Sub
                End If
                If PB = True Then
                    Try
                        'vidljiv je sledeci blok po redu
                        'MORA DA SE ODVOJI NA VIDLJIV I NEVIDLJIVI KAO KAD IMA SKOK
                        'INACE GUBI PANEL FOKUS; PA PONOVO URADI PANE_ENTER
                        If tblok > 0 Then
                            grupePitanjaCAPI(tblok).Visible = False

                            Call SuspendDrawing(grupePitanjaCAPI(tblok - 1))
                            grupePitanjaCAPI(tblok - 1).Visible = True
                            Call ResumeDrawing(grupePitanjaCAPI(tblok - 1))

                            IndBlokaNaKomeSmo = tblok - 1
                            If Not grupePitanjaCAPI(tblok - 1) Is Nothing AndAlso Not poslednjaCNTLCAPIPanel(grupePitanjaCAPI(tblok - 1)) Is Nothing Then
                                bbss = poslednjaCNTLCAPIPanel(grupePitanjaCAPI(tblok - 1))
                                If Not bbss Is Nothing Then bbss.Focus()
                            End If

                        End If
                        nepotrebnavalidacija = False
                        Exit Sub
                    Catch ex As Exception
                        ISTMessageBox.Show("nextBlok iz validacije")
                        okvalidacija = False
                    End Try
                End If
            End If

            If autb = True Then DirectCast(cntl, AutoCompleteTextbox).skociNazadGrupa = False
        Catch ex As Exception
            ISTMessageBox.Show("previousBlok")
        End Try
        'prvo polje
    End Sub


