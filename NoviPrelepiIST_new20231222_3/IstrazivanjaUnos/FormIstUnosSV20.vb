    Sub ctrtvuncheckedAllIfTrueSCATI(ByVal pp As Panel, ByVal chp() As String, ByVal plj As String, ByVal TB As TextBox, ByVal uncheckedAllOther As String)

        'vuncheckedSCATI POLJA
        Dim imeP As String = pp.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
        Dim pppom As Panel = NadjiKontrolu(Me, imeP)

        Dim ucao() As String = uncheckedAllOther.Split("$")   'uncheckedAllOther ako je P1 ili P2

        For i As Integer = 0 To ucao.GetUpperBound(0)
            If ucao(i) <> "" Then
                Dim ch As CheckBox = NadjiKontrolu(pppom, "HH" + ucao(i))
                Dim vredHH As Integer = 0 : Dim vredHHs As String = ""
                Dim tt As Integer = 0
                If ch.Text.Trim.IndexOf("  ") > -1 Then
                    tt = ch.Text.Trim.IndexOf("  ")
                    vredHH = ch.Text.Trim.Substring(0, tt).Trim
                    vredHHs = CStr(vredHH).Trim
                End If

                Dim postoji As Boolean = False
                Dim mm() As String = TB.Text.Split("-")
                For k As Integer = 0 To mm.GetUpperBound(0)
                    If mm(k).Trim = vredHHs Then postoji = True
                Next
                'If TB.Text = vredHHs OrElse TB.Text.IndexOf(vredHHs + "-") >= 0 OrElse TB.Text.IndexOf("-" + vredHHs) > 0 Then TB.Text = vredHHs
                If TB.Text = vredHHs OrElse postoji = True Then
                    TB.Text = vredHHs
                    Exit For
                End If
            End If
        Next
    End Sub

