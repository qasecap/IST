                    Dim pom As String = m.Replace("GRIDEDITRCOLUMNS=", "")
                    columnsEditR = pom.Split(",")
                End If
                If m.IndexOf("GRIDLINKSTOPIF=") = 0 Then
                    pomstopifLink = m.Replace("GRIDLINKSTOPIF=", "")
                End If
                If m.IndexOf("GRIDLINKSTOPIFMSG=") = 0 Then
