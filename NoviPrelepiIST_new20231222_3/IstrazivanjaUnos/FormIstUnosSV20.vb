                                    Me.BojiPanel(panel, p, "Y")
                                ElseIf trtez = "G" Then
                                    Me.BojiPanel(panel, p, "LG")
                                ElseIf trtez = "P" Then
                                    Me.BojiPanel(panel, p, "LP")
                                ElseIf trtez = "S" Then
                                    Me.BojiPanel(panel, p, "LS")
                                ElseIf trtez = "Q" Then
                                    Me.BojiPanel(panel, p, "LQ")
                                ElseIf trtez = "N" Then
                                    Me.BojiPanel(panel, p, "LN")
                                Else
                                    Me.ZacrveniPanel(panel, p)
                                End If
                            Next
                        End If
                    End If
                End If
            Next
            paneLKpanel.BringToFront()
            paneLKpanel.Refresh()
            If scrollPanel = False Then paneLKpanel.Location = New Point(0, panel.Location.Y - paneLKpanel.Height - 2)
