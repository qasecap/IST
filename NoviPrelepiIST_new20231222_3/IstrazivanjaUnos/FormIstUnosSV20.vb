                    End If
                Next
            End If
        Next

        Call NapraviDGTabele()

        Call IsprazniSveSemKljuca(p)

        For i As Integer = 0 To nizskip.GetUpperBound(0)
            Dim nn() As String = nizskip(i).Split("$")
            nizskip(i) = nn(0) + "$" + "$FALSE"
        Next

    End Sub

    Sub resetK1(ByVal k As Control)
        'If Not (Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("DODELAPK;") >= 0) Then
        k.Text = ""
        k.BackColor = SystemColors.ControlLightLight ' za slucaj da je zaostala LK
        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("LG;") >= 0 Then k.BackColor = Color.LightGray
        'End If
        Dim pom As String = ""
        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim <> "" Then
            Dim pp() As String = k.AccessibleName.Trim.Split(";")
            For i As Integer = 0 To pp.GetUpperBound(0)
                If pp(i).ToUpper.IndexOf("SKIPFROM") < 0 AndAlso pp(i).ToUpper.IndexOf("FROMGROUP") < 0 AndAlso pp(i).ToUpper.IndexOf("TOGROUP") < 0 Then
                    pom = pom + pp(i) + ";"
                End If
            Next
            k.AccessibleName = pom

            If k.AccessibleName.IndexOf("VF;") >= 0 Then k.Visible = False Else k.Visible = True
            If k.AccessibleName.IndexOf("NE;") >= 0 Then k.Enabled = False Else k.Enabled = True
        End If

