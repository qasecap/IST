    Dim nnadjen As Boolean

    Function izbaciPT(pom As String) As String
        If pom(pom.Length - 1) = "." Then
            pom = pom + "$$$"
            pom = pom.Replace(".$$$", "")
        End If
        izbaciPT = pom
    End Function

    Private Function ELGaIma(ByVal tabela As String, Optional ByVal DaPitam As Boolean = True) As Boolean

        nnadjen = True
        Dim nadjen As Boolean = True
        Dim Kljucevi() As String = {}
        Dim red() As DataRow = Nothing
        If tabela = GlavnaTabela Then
            Kljucevi = GlavniKljuc
        Else
            Kljucevi = DajKljuceve(tabela)
        End If

        Dim sql As String = ""
        Dim sqlNU As String = ""
        sql = "select * from " & prfxt(tabela) & " where 2=2 "
        Dim sqlNK As String = sql
        If Me.NslKljuc Is Nothing Then
            sqlNU = sql
        Else
            sqlNU = " 2=2 "
            For i As Integer = 0 To NslKljuc.GetUpperBound(0)
                sqlNK = sqlNK & " and " & NslKljuc(i, 0).Trim.ToUpper & "=N'" & NslKljuc(i, 1).Trim & "' "
            Next
        End If

        Dim sqlKljuc As String = "2=2"


        'KljuceviNadtabeleSavrednostima
        If Not Me.KljTabeleSavrednostima Is Nothing AndAlso Me.KljTabeleSavrednostima.Length = Kljucevi.Length Then
            For i As Integer = 0 To KljTabeleSavrednostima.GetUpperBound(0)
                sqlNU = sqlNU & " and " & KljTabeleSavrednostima(i, 0).Trim.ToUpper & "=N'" & KljTabeleSavrednostima(i, 1).Trim & "' "
                sqlKljuc = sqlKljuc & " and " & KljTabeleSavrednostima(i, 0).Trim.ToUpper & "=N'" & KljTabeleSavrednostima(i, 1).Trim & "' "
            Next
        End If

        If Me.KljTabeleSavrednostima Is Nothing OrElse Me.KljTabeleSavrednostima.Length <> Kljucevi.Length Then
            For i As Integer = 0 To Kljucevi.GetUpperBound(0)
                Dim dodajconvertDateTime As Boolean = False
                Dim pom As String = ""
                Dim sekpom As String = SEK(Kljucevi(i))
                If Mid(PoljaGlavniKljuc(i).Trim.ToUpper, 1, 2) = "UK" Then
                    dodajconvertDateTime = True
                    pom = izbaciPT(sekpom)
                End If

                If dodajconvertDateTime = False Then
                    If IsNumeric(sekpom) = True Then
                        sql = sql + " and " & Kljucevi(i) & " ='" & sekpom & "'"
                    Else
                        sql = sql + " and " & Kljucevi(i) & " =N'" & sekpom & "'"
                    End If
                    sqlNU = sqlNU + " and " & Kljucevi(i) & " ='" & sekpom & "'"
                    sqlKljuc = sqlKljuc + " and " & Kljucevi(i) & " =N'" & sekpom & "'"
                End If

                If dodajconvertDateTime = True Then
                    If IsNumeric(sekpom) = True Then
                        sql = sql + " and convert(varchar," & Kljucevi(i) & " , 126) ='" & pom & "'"
                    Else
                        sql = sql + " and convert(varchar," & Kljucevi(i) & " , 126) =N'" & pom & "'"
                    End If
                    sqlNU = sqlNU + " and convert(varchar," & Kljucevi(i) & " , 126) ='" & pom & "'"
                    sqlKljuc = sqlKljuc + " and convert(varchar," & Kljucevi(i) & " , 126) =N'" & pom & "'"
                End If
            Next
        End If

        If ImaVODVDO Then
            Dim pbz As String = CStr(dIst.IST.Rows(0).Item("BAZA")).Trim
            sql = Me.DodajVodVdo(sql, pbz, IzrazLKTabele(pbz, tabela.Trim.ToUpper), tabela.Trim.ToUpper)
        End If


        DGTabele(DGi(tabela)).Clear()
        DGTabeleOriginal(DGi(tabela)).Clear()

        If Me.NslKljuc Is Nothing Then
            Try
                Call napuniPonovoDGTabele(sql, DGi(tabela))
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            nadjen = DGTabele(DGi(tabela)).Rows.Count > 0

        Else
            DTbl(DGi(tabela)).Clear()
            Try
                Call napuniPonovoDTBL(sqlNK, DGi(tabela))
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            red = Me.DTbl(DGi(GlavnaTabela, DTbl)).Select(sqlNU.Replace("=N'", "='"))
            nadjen = (red.Length > 0)
            If nadjen Then
                For i As Integer = 0 To red.GetUpperBound(0)
                    If Not nizKontrolaEncrypt Is Nothing AndAlso nizKontrolaEncrypt.Length > 0 Then
                        For j As Integer = 0 To nizKontrolaEncrypt.GetUpperBound(0)
                            If IsBase64String(red(i).Item(nizKontrolaEncrypt(j)).ToString.Trim) = True Then
                                'Nevena 08082022
                                'red(i).Item(nizKontrolaEncrypt(j)) = CryptoReader.AesCrypt.DecryptStringAES(red(i).Item(nizKontrolaEncrypt(j)).ToString.Trim)
                                red(i).Item(nizKontrolaEncrypt(j)) = DeKripto(red(i).Item(nizKontrolaEncrypt(j)).ToString.Trim, DBConnectionString, Me.jezik)
                            End If
                        Next
                    End If
                    DGTabele(DGi(tabela)).ImportRow(red(i))
                    DGTabeleOriginal(DGi(tabela)).ImportRow(red(i))
                Next
            End If
        End If

        Dim zzakljucan As Boolean = False
        If Me.zakljucanOdmahSve = True Then
        Else
            'ONI KOJI SU ZAKLJUCANI BICE DISEJBLOVANI
            If DGTabele(DGi(GlavnaTabela)).Rows.Count = 0 Then
                'novo, mora na osnovu kljuca da se pogleda
                Dim zakljucanUnos As Integer = ProveraUnosLOCK()
                If zakljucanUnos = 1 Then
                    ''msg 64
                    'Dim msgtxt64 As String = getMessageText(dtMessages, "64", Me.jezik)
                    ''msg 65
                    'Dim msgtxt65 As String = getMessageText(dtMessages, "65", Me.jezik)
                    'ISTMessageBox.Show(msgtxt64, msgtxt65, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    'Me.Close()
                    ISTMessageBox.Show("Data entry is locked! (LK=1)")
                    Exit Function
                Else
                    zzakljucan = False
                    Call EnableSve()
                End If
            Else
                If Not (DGTabele(DGi(GlavnaTabela)).Columns("LK") Is Nothing) AndAlso (Not (DGTabele(DGi(GlavnaTabela)).Rows(0).Item("LK").GetType Is GetType(System.DBNull))) AndAlso CBool(DGTabele(DGi(GlavnaTabela)).Rows(0).Item("lk")) = True Then
                    zzakljucan = True
                    Call DisableSve()
                Else
                    Dim zakljucanUnos As Integer = ProveraUnosLOCK()
                    If zakljucanUnos = 1 Then
                        zzakljucan = True
                        Call DisableSve()
                    Else
                        zzakljucan = False
                        Call EnableSve()
                    End If
                End If
            End If
        End If

        If DontDisplayAlreadyExistsChangeMessage = False Then
            If DaPitam AndAlso ddosaoizISTDGV = False Then
                ''msg 66
                Dim msgtxt66 As String = getMessageText(dtMessages, "66", Me.jezik)
                ''msg 67
                Dim msgtxt67 As String = getMessageText(dtMessages, "67", Me.jezik)
                If nadjen AndAlso zzakljucan = False AndAlso ISTMessageBox.Show(msgtxt66, msgtxt67, MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button1) = DialogResult.No Then
                    Me.Cursor = Cursors.Default
                    Return False
                End If
            End If
        End If

        ' If Not (Me.NslKljuc Is Nothing) Then 'DUPE
        'isprazni kontrole koje nisu u kljucu pre punjenja
        Try
            If SCati = True Then
                IsprazniKontrolekojeNisuKljucCATI()
            End If
            If SCati = False Then
                If Not nizPanela Is Nothing AndAlso nizPanela.Length > 0 Then
                    For i As Integer = 0 To nizPanela.GetUpperBound(0)
                        Call IsprazniKontrolePanel(nizPanela(i), 0)
                    Next
                End If
            End If

            If nadjen = False Then PopuniJosZaPoljaSamoDefault()
            ' End If
        Catch ex As Exception
            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try

        If nadjen Then  ' mora, jer je true i kad nije nadjen, tj. ide unos novog
            If Me.NslKljuc Is Nothing Then ' tada je "prvi" unos
                DGPopuni() 'OVDE odradi i dodatne (fals) kolone
                If Not nizKontrolaEncrypt Is Nothing AndAlso nizKontrolaEncrypt.Length > 0 Then
                    For j As Integer = 0 To nizKontrolaEncrypt.GetUpperBound(0)
                        If IsBase64String(DGTabele(DGi(tabela)).Rows(0).Item(nizKontrolaEncrypt(j)).ToString.Trim) = True Then
                            'Nevena 08082022
                            'DGTabele(DGi(tabela)).Rows(0).Item(nizKontrolaEncrypt(j)) = CryptoReader.AesCrypt.DecryptStringAES(DGTabele(DGi(tabela)).Rows(0).Item(nizKontrolaEncrypt(j)).ToString.Trim)
                            DGTabele(DGi(tabela)).Rows(0).Item(nizKontrolaEncrypt(j)) = DeKripto(DGTabele(DGi(tabela)).Rows(0).Item(nizKontrolaEncrypt(j)).ToString.Trim, DBConnectionString, Me.jezik)
                        End If
                    Next
                End If
            End If

            Dim ur As DataRow = DGTabele(DGi(tabela)).Rows(0) 'jer bi trebao biti samo jedan

            'QC
            If Not (DGTabele(DGi(GlavnaTabela)).Columns("QC") Is Nothing) AndAlso QC = True Then
                Call setQC("0", "sakljuca")
            End If

            PreracunajFP()

            If SCati = True Then
                Call dodeliVrednostiCATI(ur, red, sqlNU, nadjen, tabela)
            End If

            If SCati = False Then
                If grupePitanjaCAPI Is Nothing Then
                    Call dodeliVrednosti(ur, red, sqlNU, nadjen, tabela, Me.Panel1, sqlKljuc)
                Else
                    Call dodeliVrednostiCAPI(ur, red, sqlNU, nadjen, tabela, sqlKljuc)
                End If
            End If
            'da ucita vec postojeci LK
            UradiLK(grNiz)
            PrikaziLK()
            PreracunajFP()
            PreracunajFPIzKljucaPrekoRelacije()
            If grupePitanjaCAPI Is Nothing Then
                Call PreracunajFPIzAWL(Me.Panel1)
            Else
                For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                    Call PreracunajFPIzAWL(grupePitanjaCAPI(i))
                Next
            End If

            If ImaVODVDO Then
                OrigVOD = Format(CDate(SE("VOD")), "dd.MM.yyyy")
                NaE("VODF0", OrigVOD, False) : NaE("VODF1", OrigVOD, False) : NaE("VODF2", OrigVOD, False)
                NaE("VOD", OrigVOD, False)
                OrigVDO = Format(CDate(SE("VDO")), "dd.MM.yyyy")
                NaE("VDOF0", OrigVDO, False) : NaE("VDOF1", OrigVDO, False) : NaE("VDOF2", OrigVDO, False)
                NaE("VDO", OrigVDO, False)
                ' jos da obrne tab-ove....
                For Each c As Control In Me.Panel1.Controls
                    If c.Name.Trim.ToUpper = "TPVOD" Then
                        c.TabIndex = ZKlj + 1
                    ElseIf c.Name.Trim.ToUpper = "TPVDO" Then
                        c.TabIndex = ZKlj + 2
                    Else
                    End If
                Next
            End If


            Call OnReturnVFVT()

            Call OnReturnEFET()


        Else 'od if nadjen, dakle sad mora da se otvori "prazan" red u dgtabele(glavnatabela)
            ISTNote.Text = ""
            Me.DGTabele(DGi(GlavnaTabela)).Rows.Add(Me.DGTabele(DGi(GlavnaTabela)).NewRow)
            Me.DGTabeleOriginal(DGi(GlavnaTabela)).Rows.Add(Me.DGTabeleOriginal(DGi(GlavnaTabela)).NewRow)
            'popuni kljuc
            For Each s As String In Me.GlavniKljuc
                UpisiPolje(s, SEK(s))
            Next

            If grupePitanjaCAPI Is Nothing Then
                For Each c As Control In Me.Panel1.Controls
                    If c.Name <> "" AndAlso c.Name.Trim.Length > 2 AndAlso
                (c.Name.Substring(0, 2).ToUpper = "TP" OrElse
                c.Name.Substring(0, 2).ToUpper = "CB" OrElse
                c.Name.Substring(0, 2).ToUpper = "HH" OrElse
                c.Name.Substring(0, 2).ToUpper = "RB" OrElse
                c.Name.Substring(0, 2).ToUpper = "UP") Then
                        Dim cIme As String = c.Name.Trim.ToUpper.Substring(2)
                        UpisiPolje(cIme, SE(cIme), c.Name.Substring(0, 2).ToUpper)
                    End If
                Next
            Else
                For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                    For Each c As Control In grupePitanjaCAPI(i).Controls
                        If c.Name <> "" AndAlso c.Name.Trim.Length > 2 AndAlso
                    (c.Name.Substring(0, 2).ToUpper = "TP" OrElse
                    c.Name.Substring(0, 2).ToUpper = "CB" OrElse
                    c.Name.Substring(0, 2).ToUpper = "HH" OrElse
                    c.Name.Substring(0, 2).ToUpper = "RB" OrElse
                    c.Name.Substring(0, 2).ToUpper = "UP") Then
                            Dim cIme As String = c.Name.Trim.ToUpper.Substring(2)
                            UpisiPolje(cIme, SE(cIme,, c.Parent), c.Name.Substring(0, 2).ToUpper, grupePitanjaCAPI(i))
                        End If
                    Next
                Next
            End If
            PreracunajFP()
        End If

        If tabela = GlavnaTabela And nadjen Then Me.Izmena = True
        nnadjen = nadjen

        Return True   'ELGaIma uvek vraca true

    End Function

    Sub dodeliVrednostiCATI(ur As DataRow, red() As DataRow, sqlNU As String, nadjen As Boolean, tabela As String)
        'grupePitanjaCATI(gg).Name = "CATI" & "_" & kojiP.ToString.Trim
        For Each p As Control In Me.Controls
            If TypeOf p Is Panel AndAlso p.Name.ToString.Trim.Length >= 5 Then
                If Mid(p.Name.ToString.Trim.ToUpper, 1, 5) = "CATI_" Then
                    Call dodeliVrednostiCATI1(ur, red, sqlNU, nadjen, tabela, p)
                End If
            End If
        Next
        For Each p As Control In Me.Controls
            If TypeOf p Is Panel AndAlso p.Name.ToString.Trim.Length >= 8 Then
                If Mid(p.Name.ToString.Trim.ToUpper, 1, 8) = "CATIPOM_" Then
                    Call dodeliVrednostiCATIPOM(ur, red, sqlNU, nadjen, tabela, p)
                End If
            End If
        Next
    End Sub

    Sub dodeliVrednostiCATIPOM(ur As DataRow, red() As DataRow, sqlNU As String, nadjen As Boolean, tabela As String, pane As Panel)
        'vezano za cati
        For Each k As Control In pane.Controls
            If TypeOf k Is CheckBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "H" Then
                Dim chP() As String = kojeugrupi(nizCHB, k.Tag)

                Dim pppom As Panel = k.Parent
                Dim imeP As String = pppom.Name.Trim.ToUpper.Replace("CATIPOM_", "CATI_")
                Dim ppp As Panel = NadjiKontrolu(Me, imeP)
                Dim rtb As pomTextBox = NadjiKontrolu(ppp, "pomocno" & "_" & k.Tag)
                Dim tt As String = 0
                If Not rtb Is Nothing Then
                    rtb.Text = ""
                    'za radiobutton i checkbox
                    Dim F2 As String = "" : Dim F3 As String = ""
                    If Not rtb.AccessibleName Is Nothing AndAlso rtb.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                        Dim addmissingvalue As String = ""
                        Dim pp() As String = rtb.AccessibleName.Split(";")
                        For i As Integer = 0 To pp.GetUpperBound(0)
                            If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                                addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                                Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                                Dim ppom() As String = f2f3.Split("$")
                                F2 = ppom(0) : F3 = ppom(1)
                                Exit For
                            End If
                        Next

                    End If
                    For j As Integer = 0 To chP.GetUpperBound(0)
                        Dim vv As String = ""
                        If ur.Item(chP(j)) Is System.DBNull.Value Then
                        Else
                            vv = ur.Item(chP(j)).ToString.Trim
                            If F2 <> "" AndAlso vv = F2 Then vv = "!" : rtb.Text = "!"
                            If F3 <> "" AndAlso vv = F3 Then vv = "?" : rtb.Text = "?"

                            If vv <> "" AndAlso vv <> "?" AndAlso vv <> "!" Then
                                If vv - 1 > chP.Length Then
                                    rtb.Text = vv.Trim & "-"
                                Else
                                    Dim ch As CheckBox = NadjiKontrolu(k.Parent, "HH" & chP(vv - 1))
                                    If Not ch Is Nothing Then ch.Checked = True
                                    rtb.Text = rtb.Text & vv.Trim & "-"
                                End If
                            End If
                        End If
                    Next
                End If
                If Not rtb Is Nothing AndAlso rtb.Text <> "" AndAlso rtb.Text <> "?" AndAlso rtb.Text <> "!" Then
                    rtb.Text = rtb.Text & "#"
                    rtb.Text = rtb.Text.Replace("-#", "")
                End If
                'pppppp
            ElseIf TypeOf k Is Panel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 2) = "RG" Then
                If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                Else
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim >= "0" Then
                        Call SelectRadio(ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim, k)
                    Else
                    End If
                End If
            Else
            End If 'T ili grid
        Next
    End Sub

    Sub dodeliVrednostiCATI1(ur As DataRow, red() As DataRow, sqlNU As String, nadjen As Boolean, tabela As String, pane As Panel)
        'vezano za cati
        For Each k As Control In pane.Controls
            Dim TBCB As Integer = 0
            'DODELA VREDNOSTI
            If TypeOf k Is TextBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "T" Then
                TBCB = 1
                If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                Else
                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("AUTB") >= 0 Then   'autoCompleteTextBox
                        Call dodelaVrAUTB(CType(k, AutoCompleteTextbox), ur.Item(Mid(k.Name.Trim.ToUpper, 3)))
                    Else
                        k.Text = ur.Item(Mid(k.Name.Trim.ToUpper, 3))
                        'za radiobutton i checkbox
                        Dim F2 As String = ""
                        Dim F3 As String = ""
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                            Dim addmissingvalue As String = ""
                            Dim pp() As String = k.AccessibleName.Split(";")
                            For i As Integer = 0 To pp.GetUpperBound(0)
                                If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                                    addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                                    Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                                    Dim ppom() As String = f2f3.Split("$")
                                    F2 = ppom(0) : F3 = ppom(1)
                                    Exit For
                                End If
                            Next

                            If F2 <> "" AndAlso k.Text = F2 Then k.Text = "!"
                            If F3 <> "" AndAlso k.Text = F3 Then k.Text = "?"

                            k.Text = k.Text.Trim
                        End If
                    End If
                End If
            ElseIf TypeOf k Is LinkLabel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 9) = "LINKLABEL" Then   'LinkLabel
                If ur.Item(Mid(k.Name.Trim.ToUpper, 10)) Is System.DBNull.Value Then
                Else
                    k.Text = ur.Item(Mid(k.Name.Trim.ToUpper, 10))
                    k.Text = k.Text.Trim
                End If
            ElseIf TypeOf k Is ComboBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "C" Then
                TBCB = 1
