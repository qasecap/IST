    Function BarJednaKontrolaVidljiva(ByVal p As Panel) As Boolean
        BarJednaKontrolaVidljiva = False
        For Each k As Control In p.Controls
            If TypeOf k Is TextBox AndAlso k.Visible = True AndAlso k.Enabled = True AndAlso k.Name.Substring(0, 2) <> "FP" Then
                BarJednaKontrolaVidljiva = True
                Exit For
            End If
        Next
    End Function

    Sub dajPPanel(ByVal panel As Panel, ByVal panelPrevious As Panel, ByVal kk As Integer, ByVal trenutni As Integer)
        panel.Visible = False
        panelPrevious.Visible = True
        prviTBNaCATIPanelu(panelPrevious).BackColor = SystemColors.ControlLightLight
        If Not poslednjiTBNaCATIPanelu(panelPrevious) Is Nothing Then
            'For Each k As Control In panelPrevious.Controls
            '    If TypeOf k Is TextBox AndAlso k.Enabled = True AndAlso k.BackColor = Color.Bisque Then
            '        k.BackColor = SystemColors.ControlLightLight
            '    End If
            '    'ffffffffffffffffffffffffff
            'Next
            poslednjiTBNaCATIPanelu(panelPrevious).Select()
            Dim panelPreviousPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + kk.ToString.Trim)
            Dim panelPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + trenutni.ToString.Trim)
            If Not panelPreviousPom Is Nothing Then
                panelPom.Visible = False
                panelPreviousPom.Visible = True
                panelPreviousPom.BringToFront()
            End If
        End If
    End Sub

