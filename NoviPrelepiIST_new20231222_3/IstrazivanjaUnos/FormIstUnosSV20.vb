                    Dim awlNovo() As DataRow = mdtAWL.Select("tabela='" + GlavnaTabela.Trim.ToUpper + "' and polje='" + plj.Trim.ToUpper + "' and IDlang='" + Me.jezik + "'", "sort asc")
