    End Sub

    Sub sklopiQE(ByVal aaii As String)

        Dim fSize As Integer = 0
        Dim fBold As Boolean = False
        Dim fItalic As Boolean = False
        Dim fUnderline As Boolean = False

        Dim bb() As String = aaii.Split("$")
        For kk As Integer = 0 To bb.GetUpperBound(0)
            If bb(kk).Trim.ToUpper.IndexOf("QUESTIONEXPLANATION") >= 0 Then
                bb(kk) = NZ(Replace(bb(kk), "questionexplanation", "", 1, , CompareMethod.Text)).Trim
                If Not bb Is Nothing AndAlso bb.Length > 0 AndAlso Not bb(kk) Is Nothing AndAlso bb(kk).IndexOf(",") > 0 Then
                    Dim cc() As String = bb(kk).Split(",")
                    '(X=60,Y=260)
                    For mm As Integer = 0 To cc.GetUpperBound(0)
                        cc(mm) = cc(mm).Replace("(", "").Replace(")", "")
                        If cc(mm).Trim.ToUpper.IndexOf("X=") = 0 Then
                            xx = cc(mm).Trim.ToUpper.Replace("X=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("Y=") = 0 Then
                            yy = cc(mm).Trim.ToUpper.Replace("Y=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("XG=") = 0 Then
                            xxG = cc(mm).Trim.ToUpper.Replace("XG=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("YG=") = 0 Then
                            yyG = cc(mm).Trim.ToUpper.Replace("YG=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("XGP=") = 0 Then
                            xxGP = cc(mm).Trim.ToUpper.Replace("XGP=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("YGP=") = 0 Then
                            yyGP = cc(mm).Trim.ToUpper.Replace("YGP=", "")
                        End If
                    Next
                End If
                If xx <> -100 AndAlso yy <> -100 Then Me.QuestionExplanation.Location = New Point(xx, yy)
                If xxG <> -100 AndAlso yyG <> -100 Then Me.QuestionExplanation.Location = New Point(xxG, yyG)

            ElseIf bb(kk).Trim.ToUpper.IndexOf("FORECOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "forecolor", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" Then QuestionExplanation.ForeColor = Color.FromName(ppom)
            ElseIf bb(kk).Trim.ToUpper.IndexOf("BACKCOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "backcolor", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" Then QuestionExplanation.BackColor = Color.FromName(ppom)
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTBOLD") >= 0 Then
                fBold = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTUNDERLINE") >= 0 Then
                fUnderline = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTITALIC") >= 0 Then
                fItalic = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTSIZE") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "fontsize", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" AndAlso IsNumeric(ppom) Then fSize = ppom
            ElseIf bb(kk).Trim.ToUpper.IndexOf("BORDER") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "border", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("fixedsingle") = 0 Then Me.QuestionExplanation.BorderStyle = BorderStyle.FixedSingle
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("none") = 0 Then QuestionExplanation.BorderStyle = BorderStyle.None
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("fixed3d") = 0 Then QuestionExplanation.BorderStyle = BorderStyle.Fixed3D
            End If
        Next

        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline

        'B I U
        If fBold = True And fItalic = True And fUnderline = True Then ft = ftB Or ftI Or ftU
        If fBold = True And fItalic = True And fUnderline = False Then ft = ftB Or ftI
        If fBold = True And fItalic = False And fUnderline = False Then ft = ftB
        If fBold = True And fItalic = False And fUnderline = True Then ft = ftB Or ftU
        If fBold = False And fItalic = True And fUnderline = True Then ft = ftI Or ftU
        If fBold = False And fItalic = False And fUnderline = True Then ft = ftU
        If fBold = False And fItalic = True And fUnderline = False Then ft = ftI

        If fSize = 0 Then fSize = 10
        QuestionExplanation.Font = New Font(Me.Font.Name, fSize, ft)

    End Sub

    Sub notePnlMsg(ByVal what As Integer, ByVal niz() As String)

        Dim imaFCPnl As Boolean = False
        Dim imaBCPnl As Boolean = False
        Dim imaLPnl As Boolean = False
        Dim imaSPnl As Boolean = False
        Dim imaPnlMsgT As Boolean = False
        ''NOTE='aaaaaaaaaaaaaaaaaaaaaaa'$LOCATION(XG=40,YG=290,XGP=40,YGP=30)$SIZE(1160,245)
        For ii As Integer = 0 To niz.GetUpperBound(0)
            If niz(ii).Trim.ToUpper.IndexOf("NOTE=") >= 0 Then
                niz(ii) = NZ(Replace(niz(ii), "note=", "", 1, , CompareMethod.Text)).Trim
                If niz(ii).Trim <> "" AndAlso what = 1 Then NOTE.Text = mNotePnl(1, niz(ii).Trim)

            ElseIf niz(ii).Trim.ToUpper.IndexOf("PNLMSG=") >= 0 Then
                niz(ii) = NZ(Replace(niz(ii), "pnlmsg=", "", 1, , CompareMethod.Text)).Trim
                If niz(ii).Trim <> "" AndAlso what = 2 Then
                    PnlMsgT.Text = mNotePnl(2, niz(ii).Trim)
                    imaPnlMsgT = True
                End If

            ElseIf niz(ii).Trim.ToUpper.IndexOf("LOCATION") >= 0 Then
                niz(ii) = NZ(Replace(niz(ii), "location", "", 1, , CompareMethod.Text)).Trim
                Dim cc() As String = niz(ii).Split(",")
                For mm As Integer = 0 To cc.GetUpperBound(0)
                    cc(mm) = cc(mm).Replace("(", "").Replace(")", "")
                    If cc(mm).Trim.ToUpper.IndexOf("X=") = 0 Then
                        mnxx = cc(mm).Trim.ToUpper.Replace("X=", "")
                    End If
                    If cc(mm).Trim.ToUpper.IndexOf("Y=") = 0 Then
                        mnyy = cc(mm).Trim.ToUpper.Replace("Y=", "")
                    End If
                Next
                If mnxx <> -100 AndAlso mnyy <> -100 Then
                    If what = 1 Then NOTE.Location = New Point(mnxx, mnyy)
                    If what = 2 Then
                        PnlMsg.Location = New Point(mnxx, mnyy)
                        imaLPnl = True
                    End If
                End If

            ElseIf niz(ii).Trim.ToUpper.IndexOf("SIZE") >= 0 Then
                niz(ii) = NZ(Replace(niz(ii), "size", "", 1, , CompareMethod.Text)).Trim
                niz(ii) = niz(ii).Replace("(", "").Replace(")", "")
                Dim mmp() As String = niz(ii).Split(",")
                If mmp.Length = 2 Then
                    If what = 1 Then NOTE.AutoSize = False
                    If IsNumeric(mmp(0)) = True Then
                        If what = 1 Then NOTE.Width = mmp(0)
                        If what = 2 Then PnlMsg.Width = mmp(0) : imaSPnl = True
                    Else
                        If what = 1 Then NOTE.AutoSize = True
                    End If
                    If IsNumeric(mmp(1)) = True Then
                        If what = 1 Then NOTE.Height = mmp(1)
                        If what = 2 Then PnlMsg.Height = mmp(1) : imaSPnl = True
                    Else
                        If what = 1 Then NOTE.AutoSize = True
                    End If
                Else
                    If what = 1 Then NOTE.AutoSize = True
                End If

            ElseIf niz(ii).Trim.ToUpper.IndexOf("FORECOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(niz(ii), "forecolor", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" AndAlso what = 1 Then NOTE.ForeColor = Color.FromName(ppom)
                If ppom <> "" AndAlso what = 2 Then
                    PnlMsgT.ForeColor = Color.FromName(ppom)
                    imaFCPnl = True
                End If

            ElseIf niz(ii).Trim.ToUpper.IndexOf("BACKCOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(niz(ii), "backcolor", "", 1, , CompareMethod.Text)).Trim

                If ppom <> "" AndAlso what = 1 Then NOTE.BackColor = Color.FromName(ppom)
                If ppom <> "" AndAlso what = 2 Then
                    PnlMsg.Panel1.BackColor = Color.FromName(ppom)
                    PnlMsg.Panel2.BackColor = Color.FromName(ppom)
                    PnlMsgT.BackColor = Color.FromName(ppom)
                    imaBCPnl = True
                End If

            ElseIf niz(ii).Trim.ToUpper.IndexOf("VISIBLEFALSE") >= 0 Then
                If what = 1 Then NoteVisible = False
            End If
        Next
        If what = 2 Then
            'default
            If imaSPnl = False Then PnlMsg.Width = 500 : PnlMsg.Height = 300
            PnlMsg.SplitterDistance = PnlMsg.Height - 2 * PnlMsgB.Height
            If imaLPnl = False Then Call CenterCntl(PnlMsg, Nothing)
            Call CenterCntl(PnlMsgB, PnlMsg.Panel2)
        End If
    End Sub

    Public Sub CenterCntl(ByVal cntl As Control, parentCntl As Control)
        Dim r As Rectangle : Dim x As Integer : Dim y As Integer
        If parentCntl IsNot Nothing Then
            x = (parentCntl.Width - cntl.Width) \ 2
            y = (parentCntl.Height - cntl.Height) \ 2
        Else
            r = Screen.FromPoint(cntl.Location).WorkingArea
            x = r.Left + (r.Width - cntl.Width) \ 2
            y = r.Top + (r.Height - cntl.Height) \ 2
        End If
        cntl.Location = New Point(x, y)
    End Sub

    Function mNotePnl(ByVal what As Integer, ByVal pp As String) As String
        If pp.Substring(0, 1) = "'" Then pp = pp.Substring(1)
        If pp.Substring(pp.Trim.Length - 1, 1) = "'" Then pp = pp.Substring(0, pp.Trim.Length - 1)

        Dim fSize As Integer = 0
        Dim fBold As Boolean = False
        Dim fItalic As Boolean = False
        Dim fUnderline As Boolean = False

        If pp.Trim.ToUpper.IndexOf("<FONTSIZE") >= 0 Then
            Dim a As Integer = pp.Trim.ToUpper.IndexOf("<FONTSIZE")
            If pp.Substring(a).IndexOf(">") > 0 Then
                Dim b As Integer = pp.Substring(a).IndexOf(">")
                fSize = Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")).Replace(">", "")
                pp = pp.Replace(Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")), "")
                pp = NZ(Replace(pp, "<fontsize", "", 1, , CompareMethod.Text)).Trim
            End If
        End If
        If pp.Trim.ToUpper.IndexOf("<BOLD>") >= 0 Then
            fBold = True
            pp = NZ(Replace(pp, "<bold>", "", 1, , CompareMethod.Text)).Trim
        End If
        If pp.Trim.ToUpper.IndexOf("<ITALIC>") >= 0 Then
            fItalic = True
            pp = NZ(Replace(pp, "<italic>", "", 1, , CompareMethod.Text)).Trim
        End If
        If pp.Trim.ToUpper.IndexOf("<UNDERLINE>") >= 0 Then
            fUnderline = True
            pp = NZ(Replace(pp, "<underline>", "", 1, , CompareMethod.Text)).Trim
        End If

        ''samo Bold
        'If TTfontBold = True AndAlso TTfontSize = 0 Then NOTE.Font = New Font(Me.Font.Name, Me.Font.Size, FontStyle.Bold)
        'If TTfontBold = True AndAlso TTfontSize > 0 Then NOTE.Font = New Font(Me.Font.Name, TTfontSize, FontStyle.Bold)
        'If TTfontBold = False AndAlso TTfontSize > 0 Then NOTE.Font = New Font(Me.Font.Name, TTfontSize, FontStyle.Regular)

        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline

        'B I U
        If fBold = True And fItalic = True And fUnderline = True Then ft = ftB Or ftI Or ftU
        If fBold = True And fItalic = True And fUnderline = False Then ft = ftB Or ftI
        If fBold = True And fItalic = False And fUnderline = False Then ft = ftB
        If fBold = True And fItalic = False And fUnderline = True Then ft = ftB Or ftU
        If fBold = False And fItalic = True And fUnderline = True Then ft = ftI Or ftU
        If fBold = False And fItalic = False And fUnderline = True Then ft = ftU
        If fBold = False And fItalic = True And fUnderline = False Then ft = ftI

        If fSize = 0 Then fSize = 10
        If what = 1 Then NOTE.Font = New Font(Me.Font.Name, fSize, ft)
        If what = 2 Then PnlMsgT.Font = New Font(Me.Font.Name, fSize, ft)

        pp = NZ(Replace(pp, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
        If pp Is Nothing Then pp = ""
        mNotePnl = pp

    End Function

    Private Sub PopuniKljuc(ByVal kklljjuuccii(,) As String)
        If Not kklljjuuccii Is Nothing Then
            For j As Integer = 0 To kklljjuuccii.GetUpperBound(0)
                For Each k1 As Control In Me.Controls
                    If Mid(k1.Name.Trim.ToUpper, 1, 1) = "G" Then
                        For Each k As Control In k1.Controls
                            If Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                                If k.Name.Trim.Length > 2 AndAlso kklljjuuccii(j, 0).Trim.ToUpper = k.Name.Trim.ToUpper.Substring(2) Then
                                    k.Text = kklljjuuccii(j, 1).Trim
                                End If
                            End If
                        Next
                    End If
                Next
            Next
        End If

    End Sub


