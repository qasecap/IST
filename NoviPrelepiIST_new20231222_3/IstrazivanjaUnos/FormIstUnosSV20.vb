                    zzz = sracunajIzraz(dodwliawlakoniz(i), plj, tbox)
                    Dim a As Integer = 0
                    a = scompute(zzz, plj, "dodelaawls")
                    If a = 1 Then
                        Dim awlNovo() As DataRow = mdtAWL.Select("tabela='" + GlavnaTabela.Trim.ToUpper + "' and polje='" + plj.Trim.ToUpper + "' and IDlang='" + Me.jezik + "' and IDawl=" + dodwliawlniz(i) + "", "sort asc")
