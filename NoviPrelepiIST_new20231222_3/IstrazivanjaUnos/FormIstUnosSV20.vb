    Sub osveziMemorijuIzBazePodataka(ByVal GlavnaTabela As String)
        Dim GTabela As String = GtabelaJe(GlavnaTabela)
        Dim nsql As String = "select * from " + GlavnaTabela + " where " + dajKljuceveTabeleSaVrednostimaKaoString(GlavnaTabela) 'bilo Gtabela što ne valja jer je porodica u okviru ‘domacinstva, a ne stana

        Dim dtB As DataTable = izvrsiSQLvratiDT(nsql, Me.DBConnectionString, Nothing,, nizKontrolaEncrypt)
        If Not DTbl Is Nothing AndAlso DTbl(DGi(GlavnaTabela)).Rows.Count > 0 Then
            For i As Integer = 0 To DTbl(DGi(GlavnaTabela)).Rows.Count - 1
                For j As Integer = 0 To dtB.Rows.Count - 1
                    'OVO NIJE ZAVRSENO, MORA OD POSLEDNJEG KLJUCA NE RBRP1
                    If dtB.Rows(j).Item("rbrp1").ToString = DTbl(DGi(GlavnaTabela)).Rows(i).Item("rbrp1").ToString Then
                        DTbl(DGi(GlavnaTabela)).Rows(i).Item("indgr") = dtB.Rows(j).Item("indgr")
                        For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
                            If r.TABELA.Trim.ToUpper = GlavnaTabela.Trim.ToUpper Then
                                DTbl(DGi(GlavnaTabela)).Rows(i).Item(r.RbrGreske.Trim.ToUpper) = dtB.Rows(j).Item(r.RbrGreske.Trim.ToUpper)
                            End If
                        Next
                        Exit For
                    End If
                Next
            Next
            DTbl(DGi(GlavnaTabela)).AcceptChanges()
        End If


        If DGTabele(DGi(GlavnaTabela)).Rows.Count > 0 Then
            For i As Integer = 0 To DGTabele(DGi(GlavnaTabela)).Rows.Count - 1
                For j As Integer = 0 To dtB.Rows.Count - 1
                    'OVO NIJE ZAVRSENO, MORA OD POSLEDNJEG KLJUCA NE RBRP1
                    If dtB.Rows(j).Item("rbrp1").ToString = DGTabele(DGi(GlavnaTabela)).Rows(i).Item("rbrp1").ToString Then
                        DGTabele(DGi(GlavnaTabela)).Rows(i).Item("indgr") = dtB.Rows(j).Item("indgr")
                        For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
                            If r.TABELA.Trim.ToUpper = GlavnaTabela.Trim.ToUpper Then
                                DGTabele(DGi(GlavnaTabela)).Rows(i).Item(r.RbrGreske.Trim.ToUpper) = dtB.Rows(j).Item(r.RbrGreske.Trim.ToUpper)
                            End If
                        Next
                        Exit For
                    End If
                Next
            Next
        End If
        DGTabele(DGi(GlavnaTabela)).AcceptChanges()
    End Sub

    Private Function UradiLKPanel(ByVal tabela As String, ByVal panel As Panel,
                Optional ByVal SamoNekeGreske As String() = Nothing,
                Optional ByVal ODS As String = "",
                Optional ByVal bezFP As Boolean = False) As Boolean
        'prvo falsovi pa onda ostalo JER VRLO CESTO U GRESKAMA UCESTVUJU FALSOVI
        Dim ImaG As Boolean = False
        Dim grgreske As DataRow() = dIst.ISTLK.Select("2=2 And tabela='" + tabela.Trim.ToUpper + "' and isnull(USLOV,'') not like '%ExecuteOnlyOnAddedButtonControl%' and isnull(USLOV,'') not like '%LKVELIKA%' and isnull(USLOV,'') not like '%ExecuteOnlyFromDataValidationModule%'")

        Dim ii As Integer = -1
        Dim greske As DataRow() = Nothing
        If SamoNekeGreske Is Nothing Then
            greske = grgreske
        ElseIf SamoNekeGreske.Length > 0 Then
            For g As Integer = 0 To grgreske.GetUpperBound(0)
                If Array.IndexOf(SamoNekeGreske, grgreske(g).Item("RbrGreske").ToString.Trim.ToUpper) > -1 Then
                    ii = ii + 1
                    ReDim Preserve greske(ii)
                    greske(ii) = grgreske(g)
                End If
            Next
        ElseIf SamoNekeGreske.Length = 0 Then
            Exit Function
        End If

        'ukoliko greske sadrže fiktivna polja, odradi fiktivna polja
        If bezFP = False Then
            For grBroj As Integer = 0 To greske.Length - 1
                Dim greskaIzraz As String = greske(grBroj).Item("GRESKA")
                If greskaIzraz.Trim.IndexOf("#FP") >= 0 Then
                    If ODS = "pp" Or ODS = "cbp" OrElse ODS = "hh" OrElse ODS = "UP" Then   'polje ili kombo koje nije kljuc
                        'moraju da se izracunaju sva fals polja jer svako moze da ucestvuje u gresci
                        PreracunajFPPanel(tabela, panel, "FPnPK")
                        PreracunajFPPanel(tabela, panel, "FPMEM")
                    Else
                        PreracunajFPPanel(tabela, panel)
                    End If
                    ''''''
                    Exit For
                    ''''''
                End If
            Next
        End If

        Dim kojaGreska As String = ""

        For grBroj As Integer = 0 To greske.Length - 1
            'If SamoNekeGreske Is Nothing OrElse
            '    Array.IndexOf(SamoNekeGreske, greske(grBroj).Item("RbrGreske").ToString.Trim.ToUpper) > -1 Then
            Dim red As DataRow()
            Dim GIzraz As String = ""
            kojaGreska = greske(grBroj).Item("RbrGreske").ToString.Trim
            Try
                Dim greskaIzraz As String = greske(grBroj).Item("GRESKA")
                greskaIzraz = ZameniGGGMMMUnos(greskaIzraz)
                If greskaIzraz.Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse greskaIzraz.Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
                    'nadji nadtabela sta je
                    Dim nadtabela As String = ""
                    For Each t As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
                        If (Not t.IsNadTabelaNull) AndAlso t.Tabela.Trim.ToUpper = tabela Then
                            nadtabela = t.NadTabela.Trim.ToUpper '      Me.GlavnaTabela.Trim.ToUpper
                            Exit For
                        End If
                    Next
                    Dim zzz As String = greskaIzraz.ToString.Trim
                    Dim pp() As String = razkvantaj(zzz)
                    For i As Integer = 0 To pp.Length() - 1
                        pp(i) = GlavaHead(pp(i), DGTabele(DGi(nadtabela)).Rows(0))
                    Next
                    zzz = ustringaj(pp).ToUpper
                    greskaIzraz = zzz
                End If
                'zameni ako postoji D.
                If greskaIzraz.Trim.ToUpper.IndexOf("D.") > 0 Then
                    Dim aaa() As String = razkvantaj(greskaIzraz.Trim)
                    For i As Integer = 0 To aaa.Length() - 1
                        If aaa(i).Length() > 1 AndAlso aaa(i).Substring(0, 2).ToUpper = "D." Then
                            Dim pljF As String = aaa(i).Replace("D.", "").Trim.ToUpper
                            Dim qq As String
                            qq = SPK(pljF, panel)
                            If qq = "" Then qq = SP(pljF, panel)
                            aaa(i) = "'" + qq + "'"
                        End If
                    Next
                    greskaIzraz = ustringaj(aaa).ToUpper
                End If

                GIzraz = PrevediFPanel(tabela, panel, greskaIzraz).Trim.ToUpper    'ovde sa ekrana pokupi fp

                If InStr(GIzraz, "SELECT") <> 0 Then ' OrElse InStr(GIzraz, "DBO.F_") <> 0 Then
                    Dim kv() As String = Me.razkvantaj(GIzraz)
                    GIzraz = PrevediSpanel(tabela, panel, kv)
                End If
                'nije ime tabele u selectu u selectu
                If GIzraz.Trim.ToUpper.IndexOf(tabela.Trim.ToUpper + ".") > 0 Then
                    GIzraz = GIzraz.Replace(tabela.Trim.ToUpper + ".", "")
                End If

                If InStr(GIzraz, "CAST") <> 0 Or GIzraz.IndexOf("CHARINDEX") >= 0 Or
                GIzraz.IndexOf("INSTR") >= 0 Or GIzraz.IndexOf("ISDATE") >= 0 Or
                GIzraz.IndexOf("ISNUMERIC") >= 0 Or GIzraz.IndexOf("LTRIM") >= 0 Or
                GIzraz.IndexOf("RTRIM") >= 0 Or GIzraz.IndexOf("LEFT") >= 0 Or
                GIzraz.IndexOf("RIGHT") >= 0 Then
                    GIzraz = razCASTi(GIzraz, tabela)
                End If
                If GIzraz.Trim.ToUpper.IndexOf("CASE ") >= 0 Then GIzraz = CASE2IIF(CStr(GIzraz))

                red = Me.DGTabelePanel(DGi(tabela)).Select(GIzraz.Replace("=N'", "='"))
                If red.Length > 0 Then
                    DGTabelePanel(DGi(tabela)).Rows(0).Item(kojaGreska) = 1
                    ImaG = True
                Else
                    DGTabelePanel(DGi(tabela)).Rows(0).Item(kojaGreska) = 0 'mora i da izbrise eventualo 1 koje je bilo
                End If
            Catch ex As System.Exception
                ISTMessageBox.Show(ex.Message & greske(grBroj).Item("RbrGreske").ToString.Trim & ":" & greske(grBroj).Item("RbrGreske").ToString.Trim, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            'End If
        Next

        If ImaG Then
            DGTabelePanel(DGi(tabela)).Rows(0).Item("INDGR") = 1
        Else
            DGTabelePanel(DGi(tabela)).Rows(0).Item("INDGR") = 0
        End If
        Return ImaG

    End Function

    Private Sub PrikaziLK()

        If DGTabele(DGi(GlavnaTabela)) Is Nothing OrElse DGTabele(DGi(GlavnaTabela)).Rows.Count = 0 Then
            Call zatvoriOLHC()
            Exit Sub
        End If

        Me.PaneLK.Items.Clear()
        Me.PaneLK.Height = 0

        'UVEK ide od GlavnaTabela; podaci (sa sve Gxxx) su u DGTabele(dgi(glavnatabela)), ajd' sad
        Me.OdCrveni()
        'Me.OdZuti()
        Me.OdBoji()

        Dim pdc As DataRow = DGTabele(DGi(GlavnaTabela)).Rows(0) 'jer mora imati samo jedan red
        For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
            If r.TABELA.Trim.ToUpper = GlavnaTabela.Trim.ToUpper Then
                If r.Item("uslov").GetType Is GetType(System.DBNull) OrElse (r.USLOV.Trim.ToUpper.IndexOf("LKVELIKA") < 0 AndAlso r.USLOV.Trim.ToUpper.IndexOf("EXECUTEONLYFROMDATAVALIDATIONMODULE") < 0) Then

                    If pdc.Table.Columns.Contains(r.RbrGreske.Trim.ToUpper) = False Then
                        Call zatvoriOLHC()
                        ISTMessageBox.Show("Table or view " + GlavnaTabela.Trim.ToUpper + " does not cointain field " + r.RbrGreske.Trim.ToUpper + "." + nvrd + nvrd +
                               "Don't forget to refresh all views if you added some fields to table.", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End If

                    If pdc.Table.Columns.Contains(r.RbrGreske.Trim.ToUpper) AndAlso (Not pdc.Item(r.RbrGreske.Trim.ToUpper) Is System.DBNull.Value) AndAlso CInt(pdc.Item(r.RbrGreske.Trim.ToUpper)) <> 0 Then
                        Dim trtez As String
                        If r.IstezinaNull Then
                            trtez = ""
                        Else
                            trtez = r.tezina.Trim.ToUpper
                        End If

                        If r.IsNazivGreskeNull OrElse r.NazivGreske.Trim = "" Then
                            Me.PaneLK.Items.Add(r.RbrGreske.Trim.ToUpper & " - " & trtez & " : " & r.GRESKA.Trim) 'zuto za lake greske
                        Else
                            Dim nazivgreske As String = r.NazivGreske
                            Dim MLopis As String = getMultilanguageMessage(mdtMessage, txtmode, r.NazivGreske, Me.jezik)
                            If MLopis <> "" Then nazivgreske = MLopis
                            Me.PaneLK.Items.Add(r.RbrGreske.Trim.ToUpper & " - " & trtez & " : " & nazivgreske.Trim) 'zuto za lake greske
                        End If

                        If Me.PaneLK.Height < Me.Panel1.Height Then Me.PaneLK.Height = Me.PaneLK.Height + PaneLK.ItemHeight
                        For Each p As String In PoljaUGresci(Me.GlavnaTabela, r.GRESKA.Trim)
                            If trtez = "L" Then
                                ' i to samo L jer neka istrazivanja imaju pored T i L i druga slova
                                'Me.Zazuti(p)  'zuti samo ako vec nije crveno!!!
                                Me.Boji(p, "Y")
                            ElseIf trtez = "G" Then
                                Me.Boji(p, "LG")
                            ElseIf trtez = "P" Then
                                Me.Boji(p, "LP")
                            ElseIf trtez = "S" Then
                                Me.Boji(p, "LS")
                            ElseIf trtez = "N" Then
                                Me.Boji(p, "LN")
                            ElseIf trtez = "Q" Then
                                Me.Boji(p, "LQ")
                            Else
                                Me.Zacrveni(p)
                            End If
                        Next
                    End If
                End If
            End If
        Next
        Me.PaneLK.Height = Me.PaneLK.Height + 5
        Me.PaneLK.Refresh()
    End Sub

    Public Function NadjiYHPrethodneKontrole(ByVal panel As Control, ByVal cntl As Control, ByVal biomultiline As Boolean, ByVal biolblmultiline As Boolean) As String
        Dim yy As Integer = 0
        Dim hh As Integer = 0
        Dim um As Integer = 1
        If biolblmultiline = True Then um = 2
        If biomultiline = True Then um = 4

        Dim plj As String = Mid(cntl.Name.Trim.ToUpper, 3)
        For Each k As Control In panel.Controls
            'da nije ova kontrola i da nije njena labela
            If Not k Is cntl AndAlso (k.Name.Substring(0, 3).ToUpper = "POM" OrElse k.Name.Substring(0, 2).ToUpper = "HH" OrElse k.Name.Substring(0, 2).ToUpper = "TP" OrElse k.Name.Substring(0, 2).ToUpper = "CB" OrElse k.Name.Substring(0, 2).ToUpper = "UP" OrElse k.Name.Substring(0, 2).ToUpper = "FP" OrElse k.Name.Substring(0, 1).ToUpper = "L" AndAlso k.Name.Trim.ToUpper <> "L" & plj.Trim.ToUpper) AndAlso k.TabIndex = maxTabIndex(panel, cntl) Then
                yy = k.Location.Y
                hh = um * k.Height
                Exit For
            End If
        Next
        NadjiYHPrethodneKontrole = Str(yy).Trim & ";" & Str(hh).Trim
    End Function

    Public Function maxTabIndex(ByVal panel As Control, ByVal cntl As Control) As Integer
        Dim mti As Integer = 0
        For Each k As Control In panel.Controls
            If Not k Is cntl AndAlso (k.Name.Substring(0, 3).ToUpper = "POM" OrElse
        k.Name.Substring(0, 2).ToUpper = "HH" OrElse k.Name.Substring(0, 2).ToUpper = "TP" OrElse
        k.Name.Substring(0, 2).ToUpper = "CB" OrElse k.Name.Substring(0, 2).ToUpper = "UP" OrElse
        k.Name.Substring(0, 2).ToUpper = "FP" OrElse k.Name.Substring(0, 1).ToUpper = "L") _
        AndAlso k.TabIndex > mti AndAlso k.TabIndex < cntl.TabIndex Then
                mti = k.TabIndex
            End If
        Next
        Return mti

    End Function

    Public Function NadjiKontroluUKljucu(ByVal ident As String) As Control
        Dim control As Control = Nothing
        For Each k1 As Control In Me.Controls
            If Mid(k1.Name.Trim.ToUpper, 1, 1) = "G" Then
                For Each k As Control In k1.Controls
                    If Mid(k.Name.Trim.ToUpper, 3) = ident Then control = k
                Next
            End If
        Next
        Return control
    End Function

