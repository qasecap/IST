    Private Sub PreracunajFP(Optional ByVal koja As String = "", Optional ByVal backfromregularSubtable As Boolean = False, Optional pp As String = "")
        'ako ima PK=true PreracunajFP ide samo za polja koja u izrazi imaju naznaceno :PK
        If DGTabele(DGi(GlavnaTabela)).Rows.Count() > 0 Then

            If koja = "FPPK" AndAlso Not (nizFPPK Is Nothing) Then      'FP koja se izracunavaju samo na izlasku iz kljuca (samo JEDNOM)
                Call preracunajFPsad(nizFPPK)
            End If
            If koja = "FPnPK" AndAlso Not (nizFPnPK Is Nothing) Then
                Call preracunajFPsad(nizFPnPK)
            End If
            If koja = "FPCalculateOnExit" AndAlso Not (nizPCalculateOnExitime Is Nothing) AndAlso pp <> "" Then
                For i As Integer = 0 To nizPCalculateOnExitime.GetUpperBound(0)
                    Dim pomniz As String() = nizPCalculateOnExitime(i).Split(",")
                    For ii As Integer = 0 To pomniz.GetUpperBound(0)
                        If pomniz(ii).Trim.ToUpper = pp.Trim.ToUpper Then
                            Dim k As TextBox
                            If grupePitanjaCAPI Is Nothing Then
                                k = NadjiKontroluKojaJeFP(Me.Panel1, nizFPCalculateOnExitime(i))
                            Else
                                For g As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                                    k = NadjiKontroluKojaJeFP(grupePitanjaCAPI(g), nizFPCalculateOnExitime(i))
                                    If Not k Is Nothing Then Exit For
                                Next
                            End If
                            If Not k Is Nothing Then
                                Call PreracunajFPPom(k)
                                Exit For
                            End If
                        End If
                    Next
                Next
            End If
            If koja = "FPCalculateOnEnter" AndAlso Not (nizPCalculateOnEnterime Is Nothing) AndAlso pp <> "" Then
                For i As Integer = 0 To nizPCalculateOnEnterime.GetUpperBound(0)
                    Dim pomniz As String() = nizPCalculateOnEnterime(i).Split(",")
                    For ii As Integer = 0 To pomniz.GetUpperBound(0)
                        If pomniz(ii).Trim.ToUpper = pp.Trim.ToUpper Then
                            Dim k As TextBox
                            If grupePitanjaCAPI Is Nothing Then
                                k = NadjiKontroluKojaJeFP(Me.Panel1, nizFPCalculateOnEnterime(i))
                            Else
                                For g As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                                    k = NadjiKontroluKojaJeFP(grupePitanjaCAPI(g), nizFPCalculateOnEnterime(i))
                                    If Not k Is Nothing Then Exit For
                                Next
                            End If
                            If Not k Is Nothing Then
                                Call PreracunajFPPom(k)
                                Exit For
                            End If
                        End If
                    Next
                Next
            End If
            If koja = "FPMEM" AndAlso Not (nizFPMEM Is Nothing) Then      'FP koja se su sa MEM - uvek na dugmeS idu samo ona
                For i As Integer = 0 To nizFPMEM.GetUpperBound(0)
                    PreracunajFPPom(nizFPMEM(i), backfromregularSubtable)
                Next
            End If

            If koja = "" AndAlso Not (nizFP Is Nothing) Then
                Call preracunajFPsad(nizFP)
            End If
        End If
    End Sub

    Private Sub PreracunajFPPanel(ByVal tabela As String, ByVal panel As Panel, Optional ByVal koja As String = "", Optional plj As String = "")
        ' ako ima PK=true PreracunajFP ide samo za polja koja u izrazi imaju naznaceno :PK
        If DGTabelePanel(DGi(tabela)).Rows.Count() > 0 Then
            If koja = "FPPK" AndAlso Not (nizFPPKpanel Is Nothing) Then      'FP koja se izracunavaju samo na izlasku iz kljuca (samo JEDNOM)
                For i As Integer = 0 To nizFPPKpanel.GetUpperBound(0)
                    If panel.Name.ToUpper.Trim = nizFPPKpanel(i).Parent.Name.ToUpper.Trim Then
                        PreracunajFPPomPanel(tabela, panel, nizFPPKpanel(i))
                    End If
                Next
            End If
            If koja = "FPnPK" AndAlso Not (nizFPnPKpanel Is Nothing) Then     'FP koja nisu vezana za kljuc (nisu PK)
                For i As Integer = 0 To nizFPnPKpanel.GetUpperBound(0)
                    If panel.Name.ToUpper.Trim = nizFPnPKpanel(i).Parent.Name.ToUpper.Trim Then
                        If plj = "" OrElse (plj <> "" AndAlso nizFPnPKpanel(i).Tag.izraz.trim.toupper.indexof(plj.Trim.ToUpper) >= 0) Then
                            PreracunajFPPomPanel(tabela, panel, nizFPnPKpanel(i))
                        End If
                    End If
                Next
            End If
            If koja = "" AndAlso Not (nizFPpanel Is Nothing) Then       'sva FP
                For i As Integer = 0 To nizFPpanel.GetUpperBound(0)
                    If panel.Name.ToUpper.Trim = nizFPpanel(i).Parent.Name.ToUpper.Trim Then
                        PreracunajFPPomPanel(tabela, panel, nizFPpanel(i))
                    End If
                Next
            End If
        End If

        'uvek
        If koja = "FPMEM" AndAlso Not (nizFPMEMpanel Is Nothing) Then     ''FP koja se su sa MEM
            For i As Integer = 0 To nizFPMEMpanel.GetUpperBound(0)
                If panel.Name.ToUpper.Trim = nizFPMEMpanel(i).Parent.Name.ToUpper.Trim Then
                    If plj = "" OrElse (plj <> "" AndAlso nizFPMEMpanel(i).Tag.izraz.trim.toupper.indexof(plj.Trim.ToUpper) >= 0) Then
                        PreracunajFPPomPanel(tabela, panel, nizFPMEMpanel(i))
                    End If
                End If
            Next
        End If

    End Sub

