                        Dim seM As String = ""
                        Dim seD As String = ""
                        Dim ffdd As Integer = mojDate.IndexOf(".")
                        Dim lldd As Integer = mojDate.LastIndexOf(".")
                        Dim se As String = ""
                        If ffdd > 0 AndAlso lldd > 0 Then
                            seG = mojDate.Substring(lldd + 1, 4)
                            seM = mojDate.Substring(ffdd + 1, lldd - ffdd - 1)
