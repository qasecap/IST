    Private Sub pp_actbox_LostFocus(ByVal sender As Object, ByVal e As System.EventArgs)
        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        Dim actbox As AutoCompleteTextbox = CType(sender, AutoCompleteTextbox)

        If actbox.izUpa = True Then

            okvalidacija = True
            If actbox.Modified = False AndAlso Me.BtnExit.Focused Then Exit Sub

            If actbox.DB = False AndAlso ppVrednostEnter <> actbox.Text Then
                okvalidacija = False
                'TREBA GA IZBACITI ODAVDE I POSLATI KAO DA JE KLIKNUO ENTER
            ElseIf actbox.DB = True AndAlso ppVrednostEnter <> actbox.sselectedValue Then
                okvalidacija = False
            End If

            If okvalidacija = False Then 'postoji promena
                'Dim txtMsg As String = "Please, confirm change with ENTER!"
                'Dim captionMsg As String = "CONFIRM CHANGE"
                Dim txtMsg As String = getMessageText(dtMessages, "0", Me.jezik)
                Dim captionMsg As String = getMessageText(dtMessages, "0a", Me.jezik)
                Dim ppp As DialogResult = ISTMessageBox.Show(txtMsg, captionMsg, MessageBoxButtons.OKCancel, MessageBoxIcon.Exclamation, MessageBoxDefaultButton.Button1)
                Select Case ppp
                    Case DialogResult.OK
                        SendKeys.SendWait("{Enter}")
                        'e.SuppressKeyPress = True
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry DialogResult ", "OK table " + GlavnaTabela, txtMsg)
                        Exit Sub
                    Case DialogResult.Cancel
                        sender.text = ppVrednostEnter
                        okvalidacija = True
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry DialogResult ", "Cancel table " + GlavnaTabela, txtMsg)
                End Select
            End If
            If okvalidacija = True Then
                If actbox.BackColor = Color.Bisque Then actbox.BackColor = SystemColors.ControlLightLight
                OsvetliO(sender, False, actbox.Top, actbox.Parent)
            End If
        Else
            If actbox.BackColor = Color.Bisque Then actbox.BackColor = SystemColors.ControlLightLight
            OsvetliO(sender, False, actbox.Top, actbox.Parent)
        End If

        Me.QuestionExplanation.Visible = False
