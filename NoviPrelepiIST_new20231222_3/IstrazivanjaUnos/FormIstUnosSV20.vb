    Sub ddodela(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal nizdodeliAkosss As String, ByVal nizdodeliKomesss As String,
                ByVal nizdodeliStasss As String, Optional ByVal x As Integer = 0)
        nizdodeliStasss = NZ(Replace((Replace(nizdodeliStasss, "#fp{", "", 1, , CompareMethod.Text)), "}", "", 1, , CompareMethod.Text)).Trim()
        'nizdodeliStasss = nizdodeliStasss.Replace("#FP{", "").Replace("}", "").Trim
        Dim pp As Panel = Me.Panel1

        If nizdodeliKomesss.Length = 0 Then
            Exit Sub
        End If

        Dim cntlnizKome As String() = Split(nizdodeliKomesss.Trim.ToUpper, ",")

        Dim tabela As String = GlavnaTabela
        Dim konstanta As Boolean = False
        Dim vrednost As String = ""
        nizdodeliStasss = nizdodeliStasss.Trim

        Dim prvi As String = nizdodeliStasss.Trim.Substring(0, 1)
        Dim poslednji As String = nizdodeliStasss.Substring(nizdodeliStasss.Length - 1, 1)
        If prvi = "'" AndAlso poslednji = "'" OrElse IsNumeric(nizdodeliStasss) OrElse nizdodeliStasss.Trim.ToUpper.IndexOf("AWLVALUE") >= 0 OrElse nizdodeliStasss.Trim.ToUpper = "NULL" Then
            konstanta = True
            vrednost = nizdodeliStasss.Replace("'", "")
            If nizdodeliStasss.Trim.ToUpper = "NULL" Then
                vrednost = ""
            End If
            If nizdodeliStasss.Trim.ToUpper.IndexOf("AWLVALUE") >= 0 Then
                vrednost = dajTexZaOdrVredIzAwl(plj, cntl.Text, cntl.AccessibleName, , nizdodeliStasss.Trim.ToUpper).Trim
            End If
        Else
            konstanta = False
            nizdodeliStasss = nizdodeliStasss.Trim.ToUpper
            Dim indPK As Integer = Array.IndexOf(nizPKKontrolaIme, nizdodeliStasss)
            If indPK > -1 Then
                vrednost = SEK(nizdodeliStasss)
            Else
                Dim ind As Integer = Array.IndexOf(nizKontrolaIme, nizdodeliStasss)
                If ind > -1 Then
                    vrednost = SE(nizdodeliStasss, True, nizKontrola(ind).Parent)
                End If
            End If
        End If

        Dim a As Integer = 0
        If x = 1 Then
            a = 1
        Else
            Dim zzz As String = sracunajIzraz(nizdodeliAkosss, plj, cntl)
            a = scompute(zzz, plj, "ddodela1if")
        End If

        If a = 1 AndAlso konstanta Then
            For cc As Integer = 0 To cntlnizKome.GetUpperBound(0)
                For i As Integer = 0 To nizPKKontrola.GetUpperBound(0)
                    If nizPKKontrolaIme(i).Trim.ToUpper = cntlnizKome(cc).Trim.ToUpper Then
                        If nizPKKontrola(i).Text.Trim.ToUpper <> vrednost.Trim.ToUpper Then
                            If actbFilter.IndexOf("=" + nizPKKontrolaIme(i).Trim.ToUpper + ";") >= 0 Then
                                Call IsprazniAUTB(nizPKKontrolaIme(i).Trim.ToUpper)
                            End If
                            nizPKKontrola(i).Text = vrednost
                        End If
                    End If
                Next

                If Not grupePitanjaCAPI Is Nothing Then
                    Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cntlnizKome(cc).Trim.ToUpper)
                    If ind > -1 Then pp = nizKontrola(ind).Parent
                End If

                For Each k As Control In pp.Controls
                    If Not TypeOf k Is Label AndAlso
                        (Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 1) = "C" OrElse   ' OrElse Mid(k.Name, 1, 1) = "F"
                                    Mid(k.Name, 1, 1) = "U" OrElse Mid(k.Name, 1, 2) = "RG") AndAlso Mid(k.Name, 3).Trim.ToUpper = cntlnizKome(cc).Trim.ToUpper Then
                        Dim ur As DataRow = DGTabele(DGi(tabela)).Rows(0) 'jer bi trebao biti samo jedan
                        'ur.Table.Columns("wer")
                        If IsNumericDataColumn(ur.Table.Columns(Mid(k.Name.Trim.ToUpper, 3)).DataType.Name.ToString) = True AndAlso
                                        nizdodeliStasss.Trim.ToUpper <> "NULL" AndAlso IsNumeric(nizdodeliStasss.Replace("'", "")) = False Then
                            ISTMessageBox.Show("Cannot assign alpha to numeric field!" + nvrd + nvrd + "(" + Mid(k.Name.Trim.ToUpper, 3) + "=" + nizdodeliStasss + ")")
                        Else
                            If k.Text.Trim.ToUpper <> vrednost.Trim.ToUpper Then
                                If actbFilter.IndexOf("=" + Mid(k.Name, 3).Trim.ToUpper + ";") >= 0 Then
                                    Call IsprazniAUTB(Mid(k.Name, 3).Trim.ToUpper)
                                End If
                                k.Text = vrednost

                                If vrednost = "NULL" Then 'nizdodeliStasss.Trim.ToUpper = "NULL"
                                    Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                End If

                                If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("AUTB") >= 0 Then
                                    'nema otvaranja
                                    CType(k, AutoCompleteTextbox).HideSuggestionListBox()
                                End If

                                Try
                                    If Mid(k.Name, 1, 2) = "RG" Then
                                        Call SelectRadio(k.Text.Trim, k)
                                        Me.UpisiPolje(Mid(k.Name.Trim.ToUpper, 3), , "RB_CHECKEDCHANGED")
                                    ElseIf Mid(k.Name, 1, 1) <> "F" Then
                                        Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "PP_VALIDATING", k.Parent)

                                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                            k.BackColor = RGBColors.mBackColor
                                        Else
                                            k.BackColor = SystemColors.ControlLightLight
                                        End If
                                    End If
                                    'posle dodele da opet odradi falsove ako je sam sebe menjao pri dodeli
                                    If k.Name.Trim.ToUpper = cntl.Name.Trim.ToUpper Then
                                        PreracunajFP("FPnPK")
                                    End If
                                    Exit For
                                Catch ex As Exception
                                End Try
                            End If
                        End If
                    End If


                    If TypeOf k Is TextBox AndAlso Mid(k.Name, 3).Trim.ToUpper = cntlnizKome(cc).Trim.ToUpper AndAlso Mid(k.Name, 1, 1) = "F" Then
                        If k.Text.Trim.ToUpper <> vrednost.Trim.ToUpper Then
                            If actbFilter.IndexOf("=" + Mid(k.Name, 3).Trim.ToUpper + ";") >= 0 Then
                                Call IsprazniAUTB(Mid(k.Name, 3).Trim.ToUpper)
                            End If
                            k.Text = vrednost
                        End If
                    End If
                Next
            Next
        End If

        If a = 1 AndAlso Not konstanta Then      'dodeljujemo vrednost nekog pravog ili fiktivnog polja
            For cc As Integer = 0 To cntlnizKome.GetUpperBound(0)
                For i As Integer = 0 To nizPKKontrola.GetUpperBound(0)
                    If nizPKKontrolaIme(i).Trim.ToUpper = cntlnizKome(cc).Trim.ToUpper Then
                        If nizPKKontrola(i).Text.Trim.ToUpper <> vrednost.Trim.ToUpper Then
                            If actbFilter.IndexOf("=" + nizPKKontrolaIme(i).Trim.ToUpper + ";") >= 0 Then
                                Call IsprazniAUTB(nizPKKontrolaIme(i).Trim.ToUpper)
                            End If
                            nizPKKontrola(i).Text = vrednost
                        End If
                    End If
                Next

                If Not grupePitanjaCAPI Is Nothing Then
                    Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cntlnizKome(cc).Trim.ToUpper)
                    If ind > -1 Then pp = nizKontrola(ind).Parent
                End If
                For Each k As Control In pp.Controls
                    If Mid(k.Name, 3).Trim.ToUpper = cntlnizKome(cc).Trim.ToUpper AndAlso Mid(k.Name, 1, 1) <> "L" AndAlso Mid(k.Name, 1, 1) <> "F" Then
                        If k.Text.Trim.ToUpper <> vrednost.Trim.ToUpper Then
                            If actbFilter.IndexOf("=" + Mid(k.Name, 3).Trim.ToUpper + ";") >= 0 Then
                                Call IsprazniAUTB(Mid(k.Name, 3).Trim.ToUpper)
                            End If
                            k.Enabled = False
                            k.Text = vrednost
                            k.Enabled = True

                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("AUTB") >= 0 Then
                                'nema otvaranja
                                CType(k, AutoCompleteTextbox).HideSuggestionListBox()
                                'ako ima dalje za filtritanje osvezi

                                If Not CType(k, AutoCompleteTextbox).autoCompleteFilterFor Is Nothing AndAlso
                                CType(k, AutoCompleteTextbox).autoCompleteFilterFor <> "" Then
                                    Dim ddd As String = CType(k, AutoCompleteTextbox).autoCompleteFilterFor
                                    For Each kk As Control In pp.Controls
                                        If Mid(kk.Name, 3).Trim.ToUpper = ddd.Trim.ToUpper AndAlso Mid(kk.Name, 1, 1) <> "L" AndAlso Mid(kk.Name, 1, 1) <> "F" Then
                                            CType(kk, AutoCompleteTextbox).filtervalue = CType(k, AutoCompleteTextbox).Text
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If

                            Try
                                If Mid(k.Name, 1, 2) = "RG" Then
                                    Call SelectRadio(k.Text.Trim, k)
                                    Me.UpisiPolje(Mid(k.Name.Trim.ToUpper, 3), , "RB_CHECKEDCHANGED")
                                ElseIf Mid(k.Name, 1, 1) <> "F" Then
                                    Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "PP_VALIDATING", k.Parent)
                                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                        k.BackColor = RGBColors.mBackColor
                                    Else
                                        k.BackColor = SystemColors.ControlLightLight
                                    End If
                                End If
                                'posle dodele da opet odradi falsove ako je sam sebe menjao pri dodeli
                                If k.Name.Trim.ToUpper = cntl.Name.Trim.ToUpper Then PreracunajFP("FPnPK")
                                Exit For
                            Catch ex As Exception
                            End Try
                        End If
                    End If

                Next
            Next
        End If
    End Sub

    Sub ddodelaPanel(ByVal panel As Panel, ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control,
ByVal nizdodeliAkosss As String, ByVal nizdodeliKomesss As String, ByVal nizdodeliStasss As String, Optional ByVal x As Integer = 0)
        nizdodeliStasss = nizdodeliStasss.Trim.ToUpper.Replace("#FP{", "").Replace("}", "").Trim
        If nizdodeliKomesss.Length = 0 Then
            Exit Sub
        End If

        Dim trtnizKome As String() = Split(nizdodeliKomesss, ",")

        Dim tabela As String = GlavnaTabela
        Dim konstanta As Boolean = False
        Dim vrednost As String = ""

        Dim prvi As String = nizdodeliStasss.Trim.Substring(0, 1)
        Dim poslednji As String = nizdodeliStasss.Substring(nizdodeliStasss.Length - 1, 1)
        If prvi = "'" AndAlso poslednji = "'" OrElse IsNumeric(nizdodeliStasss) Then
            konstanta = True
        Else
            konstanta = False
            vrednost = SP(nizdodeliStasss, panel, True)
        End If

        Dim a As Integer = 0

        If x = 1 Then
            a = 1
        Else
            Dim zzz As String = sracPanel(nizdodeliAkosss, plj, cntl, panel)
            zzz = PrevediFPanel(tabela, panel, zzz).Trim.ToUpper
            a = scompute(zzz, plj, "ddodela1panel")
        End If

        If a = 1 AndAlso konstanta Then
            For cc As Integer = 0 To trtnizKome.GetUpperBound(0)
                For Each k As Control In panel.Controls
