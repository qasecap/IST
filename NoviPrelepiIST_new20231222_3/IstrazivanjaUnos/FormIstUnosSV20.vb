            Catch ex As Exception
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
                frm.Dispose()
            End Try
            If frm.bbop <> "" Then
                optionMSG = optionMSGskok(frm.bbop, plj, cntl, oMSGIF, oMSGskippedEnabledFalse, oMSGskippedSetEmpty, oMSGskippedDontSave, oMSGskippedVisibleFalse)
