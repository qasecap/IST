        If pomAUTB.Length > 0 Then
            Dim bbb() As String = Split(pomAUTB, ";")
            For i As Integer = 0 To bbb.GetUpperBound(0)
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETE=") >= 0 Then
                    ssourcetxt = NZ(Replace(bbb(i), "autocomplete=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETESTART=") >= 0 Then
                    acStart = CInt(NZ(Replace(bbb(i), "autocompletestart=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELENGTH=") >= 0 Then
                    acLength = CInt(NZ(Replace(bbb(i), "autocompletelength=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEMINTYPELENGTH=") >= 0 Then
                    acMTLength = CInt(NZ(Replace(bbb(i), "autocompletemintypelength=", "", 1, , CompareMethod.Text)).Trim)
                    If IsNumeric(acMTLength) = False Then acMTLength = 2 'default
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNTO=") >= 0 Then
                    acAssignTo = NZ(Replace(bbb(i), "autocompleteassignto=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNSTART=") >= 0 Then
                    acAssignStart = NZ(Replace(bbb(i), "autocompleteassignstart=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNLENGTH=") >= 0 Then
                    acAssignLength = NZ(Replace(bbb(i), "autocompleteassignlength=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTER=") >= 0 Then
                    acFilter = NZ(Replace(bbb(i), "autocompletefilter=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTERSTART=") >= 0 Then
                    acFilterStart = NZ(Replace(bbb(i), "autocompletefilterstart=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTERLENGTH=") >= 0 Then
                    acFilterLength = NZ(Replace(bbb(i), "autocompletefilterlength=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELIMITTOLIST=") >= 0 Then
                    acLimitToList = NZ(Replace(bbb(i), "autocompletelimittolist=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELETTER=") >= 0 Then
                    acLetter = NZ(Replace(bbb(i), "autocompleteletter=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEHEIGHT=") >= 0 Then
                    acHeight = NZ(Replace(bbb(i), "autocompleteheight=", "", 1, , CompareMethod.Text)).Trim
                    If IsNumeric(acHeight) = False Then acHeight = 0
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEWIDTH=") >= 0 Then
                    acWidth = NZ(Replace(bbb(i), "autocompletewidth=", "", 1, , CompareMethod.Text)).Trim
