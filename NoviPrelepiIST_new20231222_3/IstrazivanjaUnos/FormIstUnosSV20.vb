    Public Function jisEmail(ByVal tekst As String) As Boolean
        'Try
        '    Dim a As New System.Net.Mail.MailAddress(tekst)
        'Catch
        '    Return False
        'End Try
        'Return True

        If tekst.Trim.Length = 0 Then
            jisEmail = True
        ElseIf tekst.Trim.Length >= 5 AndAlso tekst.Trim.Length <= 100 Then
            Return Regex.IsMatch(tekst, "^([0-9a-zA-Z]([-\.\w]*[0-9a-zA-Z])*@([0-9a-zA-Z][-\w]*[0-9a-zA-Z]\.)+[a-zA-Z]{2,9})$")
        Else
            jisEmail = False
        End If

    End Function

    Public Function jisISTDate(ByVal tekst As String) As Boolean

        If tekst.Length > 10 Then tekst = tekst.Substring(0, 10)
        jisISTDate = False
        Dim mm As String = ""
        Dim dd As String = ""
        Dim yok As Boolean = False
        Dim mok As Boolean = False
        Dim dok As Boolean = False

        If tekst.Trim.Length = 0 Then
            jisISTDate = True
        ElseIf tekst.Trim.Length >= 8 AndAlso tekst.Trim.Length <= 10 Then
            'GG.MM.YYYY
            Dim pp() As String = tekst.Split(".")
            If pp.GetUpperBound(0) = 2 Then
                'YEAR
                If IsNumeric(pp(2)) AndAlso pp(2).Trim.Length = 4 AndAlso CInt(pp(2)) >= 1753 AndAlso CInt(pp(2)) <= 9999 Then yok = True
                'MONTH
                If yok = True AndAlso IsNumeric(pp(1)) AndAlso pp(1).Trim.Length >= 1 AndAlso pp(1).Trim.Length <= 2 AndAlso CInt(pp(1)) <= 12 Then
                    mm = pp(1).Trim
                    mok = True
                End If
                'DAY
                If mok = True AndAlso IsNumeric(pp(0)) AndAlso pp(0).Trim.Length >= 1 AndAlso pp(0).Trim.Length <= 2 Then
                    If (mm = "1" OrElse mm = "01" OrElse mm = "3" OrElse mm = "03" OrElse mm = "5" OrElse mm = "05" OrElse mm = "7" OrElse mm = "07" OrElse mm = "8" OrElse mm = "08" OrElse mm = "10" OrElse mm = "12") AndAlso CInt(pp(0)) <= 31 Then dok = True
                    If (mm = "4" OrElse mm = "04" OrElse mm = "6" OrElse mm = "06" OrElse mm = "9" OrElse mm = "09" OrElse mm = "11") AndAlso CInt(pp(0)) <= 30 Then dok = True
                    Dim bLeapYear As Boolean = Date.IsLeapYear(pp(2))
                    If (mm = "2" OrElse mm = "02") AndAlso bLeapYear = False AndAlso CInt(pp(0)) <= 28 Then dok = True
                    If (mm = "2" OrElse mm = "02") AndAlso bLeapYear = True AndAlso CInt(pp(0)) <= 29 Then dok = True
                End If
                If yok = True AndAlso mok = True AndAlso dok = True Then jisISTDate = True
            End If
        Else
            jisISTDate = False
        End If

    End Function

    Public Function jisTime(ByVal TheTime As String) As Boolean
        ' Format 1 validates the time against the 12 hour format
        Dim Format1 As String = "^ *(1[0-2]|[1-9]):[0-5][0-9] *(a|p|A|P)(m|M) *$"
        Dim TryValidateFormat1 As New System.Text.RegularExpressions.Regex(Format1)
        ' Format 2 validates the 24 hour format
        'Dim Format2 As String = "^[0-2][0-9][:][0-5][0-9]$"

        Dim Format2 As String = "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
        Dim TryValidateFormat2 As New System.Text.RegularExpressions.Regex(Format2)

        Return TryValidateFormat1.IsMatch(TheTime) Or TryValidateFormat2.IsMatch(TheTime)

    End Function

