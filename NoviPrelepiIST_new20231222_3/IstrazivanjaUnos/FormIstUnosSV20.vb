    Private Sub IsprazniKontrolePanel(ByVal panel As Panel, ByVal sta As String)
        'prazni kljuc
        'sve-sve sem kljuca koji se ne vidi
        'svesemkljuca - sve sem celog kljuca
        Dim panelautoscroll As Boolean = False
        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.IndexOf("SCROLLBAR;") >= 0 Then panelautoscroll = True
        Dim sve As Boolean = False
        Dim svesemnevidljivogkljuca As Boolean = False
        Dim svesemcelogkljuca As Boolean = False
        If sta = "0" Then sve = True
        If sta = "1" Then svesemnevidljivogkljuca = True
        If sta = "2" Then svesemcelogkljuca = True
        Dim t As String = panel.Name.Replace("PANE_", "")

        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)

        For Each k As Control In panel.Controls
            'kljuc
            If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel Then
                If k.Name.ToUpper <> "DTKGOD" AndAlso k.Name.ToUpper <> "DTKMES" AndAlso k.Name.ToUpper <> "DTKISTYEAR" AndAlso k.Name.ToUpper <> "DTKISTMONTH" AndAlso (k.Name.Length > 3 AndAlso (k.Name.Substring(0, 3).ToUpper = "DTK" OrElse k.Name.Substring(0, 3).ToUpper = "DCK")) Then
                    If sve = True Then
                        k.Text = ""
                        k.BackColor = SystemColors.ControlLightLight ' za slucaj da je zaostala LK
                    End If
                    If svesemnevidljivogkljuca = True AndAlso k.Enabled = True Then
                        k.Text = ""
                        k.BackColor = SystemColors.ControlLightLight ' za slucaj da je zaostala LK
                    End If
                    If svesemcelogkljuca = True Then
                        'ne praznim
                    End If
                End If
                If k.Name.Length > 3 AndAlso (k.Name.Substring(0, 3).ToUpper = "DTP" OrElse k.Name.Substring(0, 3).ToUpper = "DCB" OrElse k.Name.Substring(0, 3).ToUpper = "DRP") Then
                    k.Text = ""
                    k.BackColor = SystemColors.ControlLightLight ' za slucaj da je zaostala LK
                End If
                'ne treba prazniti dfp prebacene iz glave niti one koje su nonvisible
                If k.Name.Length > 3 AndAlso k.Name.Substring(0, 3).ToUpper = "DFP" AndAlso k.Tag.izraz.ToUpper.indexof("GLAVA.") < 0 AndAlso k.Tag.izraz.toupper.indexof("HEAD.") < 0 Then
                    k.Text = ""
                End If
            End If
        Next

        Dim paneLKpanel As ListBox = Nothing
        If panelautoscroll = True Then
            paneLKpanel = NadjiKontrolu(Panel1, "PANELKPANEL" + t)
        Else
            paneLKpanel = NadjiKontrolu(Panel1, "PANELKPANEL")
        End If
        If Not paneLKpanel Is Nothing Then
            paneLKpanel.Items.Clear()
            paneLKpanel.Height = 0
            'OVO NE VALJA MORA SISTEMSKI DA SE REŠI
            Me.AlwaysVisibleLabel.Text = ""
        End If

        Dim l As Label = NadjiKontrolu(panel, "AlwaysVisibleLabelPANEL" + panel.Name.ToUpper)
        If Not l Is Nothing Then l.Text = ""

        'ovde jos dgpanel refresh
        For Each k As Control In Me.Panel1.Controls
            If k.GetType Is GetType(DataGridView) Then
                CType(k, DataGridView).DataSource = DGTabele(DGi(k.Name.Trim.ToUpper))
                k.Refresh()
            End If
        Next
        For i As Integer = 0 To nizskipPanel.GetUpperBound(0)
            Dim nn() As String = nizskipPanel(i).Split("$")
            If nn(0).Trim.ToUpper = panel.Name.Trim.ToUpper Then
                nizskipPanel(i) = nn(0) + "$" + nn(1) + "$FALSE"
            End If
        Next
    End Sub

    Private plusPK As Boolean = False

    Private Sub PopuniJosZaPolja(Optional ByVal plusOdStarta As Boolean = False, Optional ByVal odakle As String = "", Optional ByVal DaLijeIzPKEnter As Boolean = False)
        'JosZaPolja?

        Dim MenjanKljuc As Boolean = False

        For Each JzP As JosZaPolje1 In JosZaPoljaK
            If (SE(JzP.Polje) Is Nothing) OrElse (SE(JzP.Polje).Trim) = "" Then
                If JzP.DG = "{+FPP}" OrElse (DaLijeIzPKEnter = True AndAlso JzP.DG = "{+}") Then
                    Dim pom As String = ""
                    If plusOdStarta = False Then
                        pom = Str(Val(JzP.vrednost) + 1).Trim
                    Else
                        pom = Str(Val(odakle) + 1).Trim
                    End If
                    ' dodaj vodece nule ako je definisano kao char i ako ima duzinu
                    Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & JzP.Polje.Trim.ToUpper & "'"
                    Dim pommduz As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("duzina")).Trim.ToUpper
                    If pommduz = "" Then pommduz = 0
                    Dim pommtip As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("tip")).Trim.ToUpper
