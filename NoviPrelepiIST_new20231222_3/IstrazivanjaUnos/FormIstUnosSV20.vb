    Sub dugmeSClick(ByVal sender As System.Object, ByVal e As System.EventArgs)

        Dim btn As Button = CType(sender, Button)
        Dim panel As Panel = btn.Parent
        Dim tabela As String = btn.Parent.Name.Replace("PANE_", "")
