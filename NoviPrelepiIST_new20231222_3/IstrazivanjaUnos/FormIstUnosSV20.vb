    Private Sub pane_Enter(ByVal sender As Object, ByVal e As System.EventArgs)
        If nepotrebanPaneEnter = True Then Exit Sub

        Me.PAMTINovo(True, False, True, False)   'pamti nadtabelu

        Dim pane As Panel = CType(sender, Panel)
        Dim tabela As String = pane.Name.Replace("PANE_", "")
        Dim dugmeSScroll As Button = NadjiKontrolu(Panel1, "DBTNSAVESCROLL" + tabela)
        If Not dugmeSScroll Is Nothing Then dugmeSScroll.Visible = True

        For Each k As Control In Panel1.Controls
            If TypeOf k Is Button AndAlso k.Name.Trim.ToUpper.IndexOf("DBTNSAVESCROLL") = 0 Then
                If k.Name.Trim.ToUpper = "DBTNSAVESCROLL" + tabela Then
                    k.Visible = True
                Else
                    k.Visible = False
                End If
            End If
        Next

        uradioskokPriUlaskuUPanel = False
        Me.AlwaysVisibleLabel.Text = ""

        Dim pane11 As Boolean = False
        If Not pane.AccessibleName Is Nothing AndAlso pane.AccessibleName.IndexOf("1-1") >= 0 Then pane11 = True

        iskljucenaLKCelaPanel = False
        iskljucenaLKsemZaAdresarePanel = False
        mozeNeispravanKljucPanel = False
        If Not pane.AccessibleName Is Nothing AndAlso pane.AccessibleName <> "" Then
            Dim p() As String = pane.AccessibleName.Split(";")
            For i As Integer = 0 To p.GetUpperBound(0)
                If p(i) = "X" Then iskljucenaLKCelaPanel = True
                If p(i) = "A" Then iskljucenaLKsemZaAdresarePanel = True
                If p(i) = "K" Then mozeNeispravanKljucPanel = True
            Next
        End If

        DopuniUnosIzLKPanel(pane)
        Dim btn As Button = Nothing

        If pane.Tag.Trim.ToUpper.indexof("TAB") = 0 Then
            For Each k As Control In Panel1.Controls
                If TypeOf k Is Button AndAlso k.Name.IndexOf("DBTNPANE") = 0 Then

                    If k.Name.Trim.ToUpper = "DBTNPANE" + tabela.Trim.ToUpper Then
                        Dim tabBaza As String = ""
                        Dim bb As Button = CType(k, Button)
                        If Not bb.AccessibleDefaultActionDescription Is Nothing AndAlso bb.AccessibleDefaultActionDescription.IndexOf("~") >= 0 Then
                            tabBaza = bb.AccessibleDefaultActionDescription.Split("~")(1)
                        End If
                        srediButtonTAB(bb, tabBaza)
                        btn = k
                    Else
                        srediButtonTABOposit(CType(k, Button))
                    End If
                End If
            Next
        End If

        Dim autoList As Boolean = False
        Dim autoListBy As String = ""
        Dim autoListByTO As String = ""
        If Not pane.AccessibleName Is Nothing AndAlso pane.AccessibleName.Trim.ToUpper.IndexOf("AUTOLISTBY") >= 0 Then
            autoList = True
            Dim pp() As String = pane.AccessibleName.Split(";")
            For i As Integer = 0 To pp.GetUpperBound(0)
                If pp(i).Trim.ToUpper.IndexOf("AUTOLISTBY") >= 0 Then autoListBy = pp(i).Trim.ToUpper.Replace("AUTOLISTBY", "")
                If pp(i).Trim.ToUpper.IndexOf("AUTOLISTTO") >= 0 Then autoListByTO = pp(i).Trim.ToUpper.Replace("AUTOLISTTO", "")
            Next
        End If

        'ne moze istovremeno i autoList i 11 (11 nema nikakvu dodelu dodatnog kljuca)
        If pane11 = True Then autoList = False

        If bioCancelNapaneValidating = True Then
            'ne menjamo menjanoP,sacuvanoP
        Else
            If dugmeSfocus = False Then
                menjanoP = False
                sacuvanoP = False
            End If
        End If

        Dim ime As String = "D"
        Dim vredGlavniKljuc() As String = {}
        For j As Integer = 0 To PoljaGlavniKljuc.GetUpperBound(0)
            ReDim Preserve vredGlavniKljuc(1 + vredGlavniKljuc.GetUpperBound(0))
            vredGlavniKljuc(vredGlavniKljuc.GetUpperBound(0)) = SEK(PoljaGlavniKljuc(j).Trim.ToUpper.Substring(2))
        Next

        For j As Integer = 0 To PoljaGlavniKljuc.GetUpperBound(0)
            For i As Integer = 0 To nizPKPanel.GetUpperBound(0)
                If pane.Name.ToUpper.Trim = nizPKPanel(i).Parent.Name.ToUpper.Trim AndAlso nizPKPanel(i).Name.Trim.Length >= 4 AndAlso PoljaGlavniKljuc(j).Trim.Length >= 3 AndAlso nizPKPanel(i).Name.Trim.ToUpper.Substring(4) = PoljaGlavniKljuc(j).Trim.ToUpper.Substring(3) Then
                    nizPKPanel(i).Text = vredGlavniKljuc(j)
                    If pane11 = True And j = PoljaGlavniKljuc.GetUpperBound(0) Then
                        'Call dpk_Validating(nizPKPanel(i), Nothing)
                        '''''ovo je da ne bi radio lk bezveze
                        Me.DGTabelePanel(DGi(tabela)).Rows.Add(Me.DGTabelePanel(DGi(tabela)).NewRow)
                        For Each c As Control In pane.Controls
                            If c.Name.Trim.Length > 3 AndAlso (c.Name.Substring(0, 3).ToUpper = "DTK" OrElse c.Name.Substring(0, 3).ToUpper = "DCK" OrElse c.Name.Substring(0, 3).ToUpper = "DUK") Then
                                Dim s As String = c.Name.Trim.ToUpper.Substring(3)
                                UpisiPoljePanel(s, tabela, pane, SPK(s, pane))
                            End If
                        Next
                        '''''
                    End If
                    If pane11 = False Then nizPKPanel(i).Enabled = False
                    Exit For
                End If
            Next
        Next

        Dim KljuceviSaEkranaSaVrednostima(,) As String
        ReDim KljuceviSaEkranaSaVrednostima(vredGlavniKljuc.GetUpperBound(0), 1)
        For i As Integer = 0 To vredGlavniKljuc.GetUpperBound(0)
            KljuceviSaEkranaSaVrednostima(i, 0) = PoljaGlavniKljuc(i).Trim.ToUpper.Substring(2)
            KljuceviSaEkranaSaVrednostima(i, 1) = vredGlavniKljuc(i).Trim.ToUpper
        Next
        origNslKljuc = NslKljuc
        Me.NslKljuc = KljuceviSaEkranaSaVrednostima

        PreracunajFPPanelGlava(tabela, pane, , Me.GlavnaTabela)
        Dim Kljucevi() As String = DajKljuceve(tabela)
        Dim ppKLJ As String = Kljucevi(Kljucevi.GetUpperBound(0)).ToString.Trim.ToUpper
        If autoList = True Then
            'poslednji kljuc na 1
            For Each kp As Control In pane.Controls
                If kp.Name.Trim.Length >= 4 AndAlso kp.Name.Substring(0, 1).ToUpper = "D" AndAlso kp.Name.Substring(2, 1).ToUpper = "K" Then
                    If kp.Name.Trim.Length > 3 AndAlso kp.Name.Trim.ToUpper.Substring(3) = ppKLJ AndAlso kp.Text = "" Then
                        kp.Text = vredKljucaPanelAutoList(tabela, autoListBy)
                        pitajPanel = False
                        Exit For
                    End If
                End If
            Next
        End If

        If pane11 = True Then
            Try
                If ELGaImaPanel(tabela, pane, pitajPanel) Then 'ELGaIma vraca true ako ga NEMA i ako hoce IZMENU postojeceg, a false SAMO ako nece izmenu
                    Me.sacuvano = True
                    Me.menjano = False
                Else
                    KljucNFocusPanel(pane, ppKLJ)
                    okvalidacija = False
                    Me.Cursor = Cursors.Default
                    Exit Sub
                End If
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message)
            End Try
        End If

    End Sub

