    Private Function DajSQLZaGrid(ByVal Tabela As String, Optional ByVal polja As String = "", Optional ByVal kljucad As String() = Nothing) As String
        Dim ir As DatasetIstrazivanja.ISTRow = dIst.IST.Rows(0)
        Dim sql As String
        If polja = "" Then
            sql = "select "
            For Each pp As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows 'ne valja, treba select * !!!!!
                If pp.TABELA.Trim.ToUpper = Tabela.Trim.ToUpper Then
                    If pp.IsKLJUCNull OrElse pp.KLJUC.Trim.ToUpper <> "P" OrElse NijeGlavniKljuc(pp.POLJE.Trim.ToUpper) Then
                        If pp.IsIzrazNull OrElse pp.Izraz.Trim = "" Then
                            sql = sql & pp.POLJE.Trim.ToUpper & ","
                        Else
                            If InStr(pp.Izraz.Trim, "#") > 0 Then
                                Dim zzz As String = pp.Izraz.Trim
                                zzz = Replace(zzz, "#", "")
                                zzz = Replace(zzz, "{", "")
                                zzz = Replace(zzz, ";}", "")
                                zzz = Replace(zzz, "; }", "")
                                zzz = Replace(zzz, "}", "")
                                sql = sql & "(" & zzz.Trim.ToUpper & ") as " & pp.POLJE.Trim.ToUpper & ","
                            Else
                                sql = sql & "(" & pp.Izraz.Trim.ToUpper & ") as " & pp.POLJE.Trim.ToUpper & ","
                            End If
                        End If
                    End If
                End If
            Next
            sql = Mid(sql, 1, Len(sql) - 1)
        Else
            sql = "select " & polja
        End If
        sql = sql & " from " & prfxt(Tabela) & " d where 2=2 "

        If kljucad Is Nothing Then
            For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                Dim dodajconvert As Boolean = False
                If Mid(PoljaGlavniKljuc(i).Trim.ToUpper, 1, 2) = "UK" Then dodajconvert = True

                If dodajconvert = False Then
                    If IsNumeric(SEK(GlavniKljuc(i).Trim.ToUpper)) = True Then
                        sql = sql & " and " & GlavniKljuc(i).Trim.ToUpper & "='" & SEK(GlavniKljuc(i).Trim.ToUpper) & "'"
                    Else
                        sql = sql & " and " & GlavniKljuc(i).Trim.ToUpper & "=N'" & SEK(GlavniKljuc(i).Trim.ToUpper) & "'"
                    End If
                End If
                If dodajconvert = True Then
                    Dim pom As String = izbaciPT(SEK(GlavniKljuc(i)))
                    If IsNumeric(SEK(GlavniKljuc(i).Trim.ToUpper)) = True Then
                        sql = sql & " and convert(varchar," & GlavniKljuc(i) & " , 126) ='" & pom & "'"
                    Else
                        sql = sql & " and convert(varchar," & GlavniKljuc(i) & " , 126) =N'" & pom & "'"
                    End If
                End If

            Next
        Else
            For i As Integer = 0 To kljucad.GetUpperBound(0)
                Dim dodajconvert As Boolean = False
                If Mid(PoljaGlavniKljuc(i).Trim.ToUpper, 1, 2) = "UK" Then dodajconvert = True
                If dodajconvert = False Then
                    If IsNumeric(SEK(kljucad(i).Trim.ToUpper)) = True Then
                        sql = sql & " and " & kljucad(i).Trim.ToUpper & "='" & SEK(kljucad(i).Trim.ToUpper) & "'"
                    Else
                        sql = sql & " and " & kljucad(i).Trim.ToUpper & "=N'" & SEK(kljucad(i).Trim.ToUpper) & "'"
                    End If
                End If
                If dodajconvert = True Then
                    Dim pom As String = izbaciPT(SEK(kljucad(i)))
                    If IsNumeric(SEK(kljucad(i).Trim.ToUpper)) = True Then
                        sql = sql & " and convert(varchar," & kljucad(i) & " , 126) ='" & pom & "'"
                    Else
                        sql = sql & " and convert(varchar," & kljucad(i) & " , 126) =N'" & pom & "'"
                    End If
                End If

            Next
        End If
        If ImaVODVDO Then
            Dim pbz As String = CStr(dIst.IST.Rows(0).Item("BAZA")).Trim
            sql = Me.DodajVodVdo(sql, pbz, IzrazLKTabele(pbz, Tabela.Trim.ToUpper), "D") 'nije ni meni lako sa ovim d.
        End If
        Return sql
    End Function

