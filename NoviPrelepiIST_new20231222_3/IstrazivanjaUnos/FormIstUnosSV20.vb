                                If tboxniz(cc).IndexOf("TABLE") = 0 Then
                                    tboxniz(cc) = tboxniz(cc).Replace("TABLE", "BTN")
                                End If
                                Dim pomocnoDaIskocimIzFora As Integer = 0
