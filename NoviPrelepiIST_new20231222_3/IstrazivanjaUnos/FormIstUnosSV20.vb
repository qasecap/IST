                                If pporukaPanel <> "" AndAlso pporukaPanel <> "''" Then
                                    bbilaporuka = True
                                    Exit For   'nesto uradio
                                End If
                            Next
                        Else
                            If pporukaPanel <> "" AndAlso pporukaPanel <> "''" Then bbilaporuka = True
                        End If 'porukaAKO.Length
                    End If 'porukaNA.Length
                    'SKAKANJE
                    biloSkakanje = False
                    Dim maxrbr As Integer = 0
                    For sss As Integer = 0 To nizskociNA.GetUpperBound(0)
                        If nizskociNA(sss).Trim.ToUpper <> "DUGMEDALJE" AndAlso nizskociNA(sss).Trim.ToUpper <> "BUTTONNEXT" AndAlso
    nizskociNA(sss).IndexOf("TABELA") < 0 AndAlso nizskociNA(sss).IndexOf("TABLE") < 0 AndAlso
    nizskociNA(sss).Trim.ToUpper <> "DUGMESACUVAJ" AndAlso nizskociNA(sss).Trim.ToUpper <> "BUTTONSAVE" Then
                            Dim k As Control = NadjiKontroluSkr(panel, nizskociNA(sss), 3)
                            If Not k Is Nothing AndAlso Not k.AccessibleDescription Is Nothing AndAlso
        k.AccessibleDescription.Split(";")(0) > maxrbr Then
                                maxrbr = k.AccessibleDescription.Split(";")(0)
                            End If
                        Else
                            maxrbr = 10000000   'najveci moguci
                            Exit For
                        End If
                    Next

                    For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                        bbss = Nothing

                        Dim pomAction As String = Nothing
                        If Not nizskociAction Is Nothing AndAlso nizskociAction.Length > 0 Then pomAction = nizskociAction(sss)

                        If grupeCNTLBlokoviPanel.Length = 0 OrElse grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
                            bbss = sskoci2panel(panel, GlavnaTabela, plj, trt, nizskociNA(sss), maxrbr, nizskociAKO(sss), pomAction,
                                                skippedEnabledFalse, skippedSetEmpty, skippedVisibleFalse, skippedDontSave,
                                                nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
                        Else
                            If Not grupePitanjaBlokoviPanel(ipanel) Is Nothing Then
                                bbss = sskoci2panelGrupa(panel, GlavnaTabela, plj, trt, nizskociNA(sss), maxrbr,
                                                        nizskociAKO(sss), pomAction, skippedEnabledFalse, skippedSetEmpty,
                                                        skippedVisibleFalse, skippedDontSave,
                                                        nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
                            End If
                        End If
                        If Not bbss Is Nothing Then
                            For i As Integer = 0 To nizskipPanel.GetUpperBound(0)
                                Dim nn() As String = nizskipPanel(i).Split("$")
                                If nn(0).Trim.ToUpper = panel.Name.Trim.ToUpper AndAlso nn(1).Trim.ToUpper = plj.Trim.ToUpper Then
                                    nizskipPanel(i) = nn(0) + "$" + nn(1) + "$TRUE"
                                    Exit For
                                End If
                            Next
                            biloSkakanje = True
                            Exit For
                        End If
                    Next

                    If biloSkakanje = False Then
                        'prethodno je postojalo skakanje sa polja, sada nijedan uslov nije zadovoljen, tj nema skoka - mora reset da se poniste efekti od prethodnog skakanja
                        For i As Integer = 0 To nizskipPanel.GetUpperBound(0)
                            Dim nn() As String = nizskipPanel(i).Split("$")
                            If nn(0).Trim.ToUpper = panel.Name.Trim.ToUpper AndAlso nn(1).Trim.ToUpper = plj.Trim.ToUpper AndAlso nn(2).Trim.ToUpper = "TRUE" Then
                                For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                                    sskoci2panelRESET(panel, trt, nizskociNA(sss))
                                Next
                                Exit For
                            End If
                        Next
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show("Error at dcbp_validacija on skipto part" + nvrd + nvrd + ex.Message)
                End Try
            End If 'skociNA.Length

            bbiloskakanje = False
            If biloSkakanje = True Then bbiloskakanje = True

            '******************************************************************************
            Call skokKraj(panel, trt.Name)
            '******************************************************************************

        End If   'kraj od pitanja da li je zakljucan
    End Sub

