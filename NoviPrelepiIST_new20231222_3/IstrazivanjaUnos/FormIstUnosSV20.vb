            Dim sqlKljuc As String = " 2=2 "
            For i As Integer = 0 To KljuceviPanel.GetUpperBound(0)
                sqlKljuc = sqlKljuc + " and " + KljuceviPanel(i) & " ='" & SPK(KljuceviPanel(i), panel) & "'"
            Next
            'poslednje polje u kljucu
            Dim ppKLJ As String = KljuceviPanel(KljuceviPanel.GetUpperBound(0)).Trim.ToUpper

            Dim iinsertPanel As Boolean = False
            Dim uupdatePanel As Boolean = False

            If DGTabele(DGi(tabela)).Select(sqlKljuc.Replace("=N'", "='")).Length = 0 Then
                iinsertPanel = True

                If Not (DGTabele(DGi(tabela)).Columns("IST_DURATION") Is Nothing) Then
                    DGTabelePanel(DGi(tabela)).Rows(0).Item("IST_DURATION") = (DateTime.Now() - IstStart(DGi(tabela))).TotalSeconds
                End If

                DGTabele(DGi(tabela, DTbl)).ImportRow(DGTabelePanel(DGi(tabela)).Rows(0))
                DGTabeleOriginal(DGi(tabela, DTbl)).ImportRow(DGTabelePanel(DGi(tabela)).Rows(0))

                Dim dg As DataGridView = NadjiKontrolu(Panel1, tabela)
                If Not dg Is Nothing Then Call srediGridView(dg, True, 30)
            Else
                uupdatePanel = True
                For Each r As DataColumn In DGTabelePanel(DGi(tabela)).Columns
                    DGTabele(DGi(tabela)).Select(sqlKljuc.Replace("=N'", "='"))(0).Item(r.ColumnName) = DGTabelePanel(DGi(tabela)).Rows(0).Item(r)
