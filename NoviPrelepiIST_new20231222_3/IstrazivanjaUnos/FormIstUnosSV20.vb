    Function srediButtonTAB(ByVal btn As Button, ByVal tabBaza As String) As Button
        Dim naslovForeColor As String = ""
        Dim naslovBackColor As String = ""
        Dim naslovBorderColor As String = ""
        Dim pp() As String = tabBaza.Split(";")
        For ii As Integer = 0 To pp.GetUpperBound(0)
            If pp(ii).Trim.ToUpper.IndexOf("FC") >= 0 Then
                pp(ii) = pp(ii).Trim.ToUpper.Replace("FC=", "")
                naslovForeColor = pp(ii)
            ElseIf pp(ii).Trim.ToUpper.IndexOf("BC") >= 0 Then
                pp(ii) = pp(ii).Trim.ToUpper.Replace("BC=", "")
                naslovBackColor = pp(ii)
            ElseIf pp(ii).Trim.ToUpper.IndexOf("BOC") >= 0 Then
                pp(ii) = pp(ii).Trim.ToUpper.Replace("BOC=", "")
                naslovBorderColor = pp(ii)
            End If
        Next

        btn.BackColor = ColorUnos
        btn.ForeColor = Color.White
        btn.FlatAppearance.BorderColor = Color.Red
        btn.FlatStyle = FlatStyle.Flat

        If naslovForeColor <> "" Then
            btn.ForeColor = Color.FromName(naslovForeColor)
        End If
        If naslovBackColor <> "" Then
            btn.BackColor = Color.FromName(naslovBackColor)
        End If
        If naslovBorderColor <> "" Then
            btn.FlatAppearance.BorderColor = Color.FromName(naslovBorderColor)
        End If

        srediButtonTAB = btn
    End Function

    Function srediButtonTABOposit(ByVal btn As Button) As Button
        btn.BackColor = SystemColors.Control
        btn.ForeColor = Color.Black
        btn.FlatStyle = FlatStyle.Standard
        btn.FlatAppearance.BorderColor = Color.Empty
        srediButtonTABOposit = btn
    End Function

    Sub dodajTab(ByVal t As String, ByVal pane As Panel, ByVal opisD As String, ByVal kojatabela As String,
ByVal tabLocationY As Integer, ByVal kakovisible As Boolean, ByVal trtt2 As String, ByVal tabBaza As String)
        Dim visinadugmepane As Integer = 40
        Dim duzinadugmepane As Integer = 50

        Dim dugmepanetab As New Button
        dugmepanetab.Name = "DBTNPANE" & t.Trim.ToUpper

        If kojatabela = 1 Then
            srediButtonTAB(dugmepanetab, tabBaza)
        Else
            srediButtonTABOposit(dugmepanetab)
        End If
        dugmepanetab.Location = New Point(0, tabLocationY + (visinadugmepane + 2) * (kojatabela - 1))
        dugmepanetab.Tag = "TAB" + CStr(dugmepanetab.Location.Y)
        dugmepanetab.Size = New Size(duzinadugmepane, visinadugmepane)
        dugmepanetab.FlatStyle = FlatStyle.Flat

        dugmepanetab = addFormatedTitleToControl(Panel1, dugmepanetab, t, opisD, 0)
        Me.Panel1.Controls.Add(dugmepanetab)

        itb = itb + 1 : ReDim Preserve nizdugmeTab(itb)
        nizdugmeTab(itb) = dugmepanetab

        AddHandler dugmepanetab.Click, AddressOf Me.dugmepanetab_Click
        AddHandler dugmepanetab.PreviewKeyDown, AddressOf Me.dugmepanetab_PreviewKeyDown
        AddHandler dugmepanetab.KeyDown, AddressOf Me.dugmepanetab_KeyDown

        pane.SendToBack()
        dugmepanetab.BringToFront()

        pane.Location = New Point(0, tabLocationY)
        pane.Tag = "TAB" & kojatabela
        pane.Width = Me.Panel1.Width - 25 '- 50
        pane.TabStop = True

        If kojatabela = 1 Then
            pane.Visible = True
        Else
            pane.Visible = False
        End If

        dugmepanetab.Visible = kakovisible
        dugmepanetab.AccessibleName = IIf(kakovisible = True, "v", "nv")
        dugmepanetab.AccessibleDescription = kojatabela
        dugmepanetab.AccessibleDefaultActionDescription = trtt2 + "~" + tabBaza
    End Sub

    Function addFormatedTitleToControl(ByVal panel As Panel, ByVal cntl As Control, ByVal t As String, ByVal opisD As String, ByVal duzplk As Integer) As Control

        addFormatedTitleToControl = cntl

        Dim tekst As String = ""
        If opisD.Length > 0 Then
            tekst = t & " - " & opisD
        Else
            opisD = "$"
            tekst = t
        End If

        Dim naslovBold As Boolean = False
        Dim naslovItalic As Boolean = False
        Dim naslovUnderline As Boolean = False
        Dim naslovVisina As Integer = 1
        Dim naslovFontSize As Integer = 0
        Dim naslovDesno As Boolean = False
        Dim naslovCentar As Boolean = False
        Dim naslovForeColor As String = ""
        Dim naslovBackColor As String = ""
        opisD = opisD.TrimEnd(";").TrimEnd("$")
        Dim kakoL() As String = opisD.Split("$")
        If kakoL.Length > 0 Then
            For iii As Integer = 0 To kakoL.Length - 1
                kakoL(iii) = kakoL(iii).Trim.ToUpper
                If kakoL(iii).IndexOf("FONTBOLD") >= 0 Then
                    naslovBold = True
                ElseIf kakoL(iii).IndexOf("FONTSIZE") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FONTSIZE", "")
                    If IsNumeric(kakoL(iii)) = True Then naslovFontSize = CInt(kakoL(iii))
                    naslovVisina = 2
                ElseIf kakoL(iii).IndexOf("FONTITALIC") >= 0 Then
                    naslovItalic = True
                ElseIf kakoL(iii).IndexOf("FONTUNDERLINE") >= 0 Then
                    naslovUnderline = True
                ElseIf kakoL(iii).IndexOf("LDESNOP") >= 0 OrElse kakoL(iii).IndexOf("LRIGHTA") >= 0 Then
                    naslovDesno = True
                ElseIf kakoL(iii).IndexOf("LCENTARP") >= 0 OrElse kakoL(iii).IndexOf("LCENTERA") >= 0 OrElse kakoL(iii).IndexOf("LCENTREA") >= 0 Then
                    naslovCentar = True
                ElseIf kakoL(iii).IndexOf("LHEIGHT") >= 0 OrElse kakoL(iii).IndexOf("LVISINA") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("LHEIGHT", "")
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("LVISINA", "")
                    If IsNumeric(kakoL(iii)) = True Then naslovVisina = CInt(kakoL(iii))
                ElseIf kakoL(iii).IndexOf("FORECOLOR") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FORECOLOR", "")
                    naslovForeColor = kakoL(iii)
                ElseIf kakoL(iii).IndexOf("BACKCOLOR") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("BACKCOLOR", "")
                    naslovBackColor = kakoL(iii)
                End If
            Next
        End If

        opisD = NZ(Replace(opisD, "fontbold", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "fontitalic", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "fontunderline", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "ldesnop", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lcentarp", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lrighta", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lcentera", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lcentrea", "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "forecolor" + naslovForeColor.ToLower, "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "backcolor" + naslovBackColor.ToLower, "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "fontsize" + CStr(naslovFontSize).Trim, "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lheight" + CStr(naslovVisina).Trim, "", 1, , CompareMethod.Text)).Trim
        opisD = NZ(Replace(opisD, "lvisina" + CStr(naslovVisina).Trim, "", 1, , CompareMethod.Text)).Trim
        If opisD Is Nothing Then opisD = ""
        opisD = opisD.Replace("$$", "$")

        If TypeOf cntl Is Button Then
            If naslovDesno = True Then DirectCast(cntl, Button).TextAlign = ContentAlignment.MiddleRight
            If naslovCentar = True Then DirectCast(cntl, Button).TextAlign = ContentAlignment.MiddleCenter
            cntl.Text = opisD.Replace("$", "")
        End If
        If TypeOf cntl Is Label Then
            If opisD.IndexOf("$") >= 0 AndAlso opisD.Trim.Substring(0, 1) = "$" Then
                cntl = sklopiLabel(t, opisD.Replace("$", ""), 0, panel.Height, 200, 16, ,,, True)
            Else
                cntl = sklopiLabel(t, tekst, 0, panel.Height, 200, 16, ,,, True)
            End If
            cntl.BackColor = ColorUnos
            cntl.ForeColor = Color.White
            If naslovDesno = True Then DirectCast(cntl, Label).TextAlign = ContentAlignment.TopRight
            If naslovCentar = True Then DirectCast(cntl, Label).TextAlign = ContentAlignment.TopCenter
            cntl.Height = cntl.Height * naslovVisina
            panel.Height = panel.Height + cntl.Height
            cntl.Width = panel.Width - 2 * duzplk - 20
            If naslovForeColor <> "" Then cntl.ForeColor = Color.FromName(naslovForeColor)
            If naslovBackColor <> "" Then cntl.BackColor = Color.FromName(naslovBackColor)
        End If

        If naslovFontSize = 0 Then naslovFontSize = 10

        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline

        'B I U
        If naslovBold = True And naslovItalic = True And naslovUnderline = True Then ft = ftB Or ftI Or ftU
        If naslovBold = True And naslovItalic = True And naslovUnderline = False Then ft = ftB Or ftI
        If naslovBold = True And naslovItalic = False And naslovUnderline = False Then ft = ftB
        If naslovBold = True And naslovItalic = False And naslovUnderline = True Then ft = ftB Or ftU
        If naslovBold = False And naslovItalic = True And naslovUnderline = True Then ft = ftI Or ftU
        If naslovBold = False And naslovItalic = False And naslovUnderline = True Then ft = ftU
        If naslovBold = False And naslovItalic = True And naslovUnderline = False Then ft = ftI

        cntl.Font = New Font(Me.Font.Name, naslovFontSize, ft)

        addFormatedTitleToControl = cntl
    End Function

