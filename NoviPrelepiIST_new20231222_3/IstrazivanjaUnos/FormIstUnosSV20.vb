    Sub dodajlabelucati(po() As String, cntlVisina As Integer, poltxt() As Label, xx As Integer, yy As Integer,
ppolje As String, prbr As String, Optional checkbox As Boolean = False, Optional tag As String = Nothing)
        Dim lsx As Integer = panelCATIlabel.Width - 50
        If checkbox = True Then
            po(po.GetUpperBound(0)) = po(po.GetUpperBound(0)).Substring(0, po(po.GetUpperBound(0)).LastIndexOf(";"))
        End If

        For ik As Integer = 0 To po.GetUpperBound(0)
            poltxt(ik) = sklopiLabelCATI(ppolje.Trim.ToUpper, po(ik), 0, yy + ik * 20, lsx, cntlVisina)
            If CTTLDESNOP(ik) = True Then
                poltxt(ik) = sklopiLabelCATI(ppolje.Trim.ToUpper, po(ik), xx - 25 - lsx, yy + ik * 20, lsx, cntlVisina)
                poltxt(ik).TextAlign = ContentAlignment.TopRight
            ElseIf CTTLCENTARP(ik) = True Then
