                Next
                Try
                    If Me.PravaDupeGlava(imeTabele) = False Then   '1-1
                        IstStart(DGi(imeTabele.Trim.ToUpper)) = DateTime.Now()
                    End If
                    Dim nadnadtabela As String = nadtabelaJe(nadtabelaJe(imeTabele))
