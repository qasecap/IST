    Private Sub ClickNaDugmeZaStranice(ByVal tboxDugmeTag As TextBox, ByVal IndGrupaNaKojuIdemo As Integer, ByVal IndGrupaNaKojuIdemoSacuvaj As Integer)

        overlayHandlePanel1 = New ISTFormIsLoading(Me, Panel1)
        overlayHandlePanel1.Show()

        nizObjekataInt = nizObjekataInt + 1
        ReDim Preserve nizObjekata(nizObjekataInt)
        nizObjekata(nizObjekataInt) = overlayHandlePanel1


        Dim prvacntl As Control = Nothing
        Try
            trcimsadugmeta = True

            If Not tboxDugmeTag Is Nothing Then
                Dim tbox As TextBox = tboxDugmeTag
                Dim pntbox As String = tbox.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim
                Dim IndGrupeSaKojeKrecemo As Integer = CInt(pntbox) - 2
                Dim ok As Boolean = True
                If IndGrupeSaKojeKrecemo = IndGrupaNaKojuIdemo Then
                    'IST Close the splashscreen
                    Call zatvoriOLHC()
                    'IST Close the splashscreen
                    'Call CAPIButton(True, IndGrupaNaKojuIdemo, IndGrupaNaKojuIdemo, tbox)
                    tbox.Focus()
                    Call trenutnakontrolaBoja(tbox)
                    trcimsadugmeta = False
                    Me.Cursor = Cursors.Default
                    Exit Sub
                End If
                Dim kk As Control = Nothing
                tbox.Focus()
                kk = getpreviouscontrol(tbox)
                Dim indtrenutnipanel As Integer = -1
                Dim trenutnaKontrolaKojaImaFokus As Control = Nothing
                If IndGrupeSaKojeKrecemo < IndGrupaNaKojuIdemo Then
                    For i As Integer = IndGrupeSaKojeKrecemo To IndGrupaNaKojuIdemo
                        indtrenutnipanel = i
                        If i > IndGrupeSaKojeKrecemo AndAlso i < IndGrupaNaKojuIdemo Then
                            kk = grupePitanjaCAPI(i).GetNextControl(Me, True)
                        ElseIf i = IndGrupeSaKojeKrecemo Then
                            kk = grupePitanjaCAPI(IndGrupeSaKojeKrecemo).GetNextControl(kk, True)
                        ElseIf i = IndGrupaNaKojuIdemo Then
                            bbss = prvaCNTLCAPIPanel(grupePitanjaCAPI(IndGrupaNaKojuIdemo))
                            If Not bbss Is Nothing Then
                                nepotrebnavalidacija = True
                                bbss.Focus()
                                Call zatvoriOLHC()
                                Me.Cursor = Cursors.Default
                                nepotrebnavalidacija = False
                                trenutnaKontrolaKojaImaFokus = bbss
                                trcimsadugmeta = False
                            End If
                            Exit For
                        End If
                        Dim eexitFor As Boolean = False
                        Do Until kk Is Nothing OrElse i <> indtrenutnipanel 'MORA PREKO LOOPA
                            bbiloskakanje = False
                            If Not TypeOf kk Is Label AndAlso kk.Name.Trim <> "" AndAlso kk.Name.Trim.Length > 2 AndAlso
                                kk.Name.Substring(0, 2).Trim.ToUpper = "TP" AndAlso kk.TabStop = True AndAlso kk.Enabled = True AndAlso kk.Visible = True Then
                                Dim autb As Boolean = False
                                If Not kk.AccessibleName Is Nothing AndAlso kk.AccessibleName.Trim.ToUpper.IndexOf("AUTB") >= 0 Then
                                    autb = True
                                End If
                                bbiloskakanje = False
                                cntlfocused = False
                                bbss = Nothing
                                If trenutnaKontrolaKojaImaFokus Is Nothing Then
                                    trenutnaKontrolaKojaImaFokus = kk
                                End If

                                Call finalySkipGrupa(trenutnaKontrolaKojaImaFokus, autb) 'ako je sve ok vec skocio

                                'imamo bbiloskakanje i bbss i isfocused
                                If cntlfocused = True Then ' 
                                    Dim pntbox2 As String = kk.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim
                                    indtrenutnipanel = CInt(pntbox2) - 2
                                    trenutnaKontrolaKojaImaFokus = kk
                                    kk = Nothing
                                    ok = False
                                    eexitFor = True
                                    Exit Do
                                ElseIf bbiloskakanje = False Then
                                    trenutnaKontrolaKojaImaFokus = Nothing
                                    kk = grupePitanjaCAPI(indtrenutnipanel).GetNextControl(kk, True)
                                ElseIf bbiloskakanje = True AndAlso bbss Is Nothing Then
                                    trenutnaKontrolaKojaImaFokus = Nothing
                                    kk = grupePitanjaCAPI(indtrenutnipanel).GetNextControl(kk, True)
                                ElseIf bbiloskakanje = True AndAlso Not bbss Is Nothing AndAlso IsNumeric(bbss.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim) Then
                                    trenutnaKontrolaKojaImaFokus = bbss
                                    Dim bbssparent As String = bbss.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim
                                    indtrenutnipanel = CInt(bbssparent) - 2
                                    Dim kkparent As String = kk.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim
                                    If CInt(bbssparent) - 2 < CInt(kkparent) - 2 Then
                                        Call zatvoriOLHC()
                                        ISTMessageBox.Show("Grupa je nedostupna.")
                                        trenutnaKontrolaKojaImaFokus = bbss
                                        indtrenutnipanel = CInt(bbssparent) - 2
                                        ok = False
                                        eexitFor = True
                                        Exit Do
                                    ElseIf CInt(bbssparent) - 2 = CInt(kkparent) - 2 Then
                                        If bbss.TabIndex <= kk.TabIndex Then
                                            trenutnaKontrolaKojaImaFokus = bbss
                                            indtrenutnipanel = CInt(bbssparent) - 2
                                            ok = False
                                            eexitFor = True
                                            Exit Do
                                        End If
                                    End If
                                    '**************
                                    If indtrenutnipanel < IndGrupaNaKojuIdemo Then
                                        kk = trenutnaKontrolaKojaImaFokus
                                    ElseIf indtrenutnipanel = IndGrupaNaKojuIdemo Then
                                        kk = Nothing
                                        eexitFor = True
                                        Exit Do
                                    ElseIf indtrenutnipanel > IndGrupaNaKojuIdemo Then
                                        Call zatvoriOLHC()
                                        ISTMessageBox.Show("Not allowed.")
                                        trenutnaKontrolaKojaImaFokus = kk
                                        indtrenutnipanel = CInt(kkparent) - 2
                                        ok = False
                                        eexitFor = True
                                        Exit Do
                                    End If
                                ElseIf bbiloskakanje = True AndAlso Not bbss Is Nothing AndAlso Not IsNumeric(bbss.Parent.Name.Trim.ToUpper.Replace("CAPI_", "").Trim) Then
                                    Call zatvoriOLHC()
                                    ISTMessageBox.Show("Grupa je nedostupna.")
                                    ok = False
                                    eexitFor = True
                                    Exit Do
                                End If
                            Else
                                trenutnaKontrolaKojaImaFokus = Nothing
                                kk = grupePitanjaCAPI(indtrenutnipanel).GetNextControl(kk, True) 'Get the next control in the tab order.
                            End If
                        Loop
                        If eexitFor = True Then
                            Exit For
                        End If
                    Next
                Else

                    grupePitanjaCAPI(IndGrupeSaKojeKrecemo).Visible = False
                    Call SuspendDrawing(grupePitanjaCAPI(0))
                    grupePitanjaCAPI(0).Visible = True
                    For j As Integer = 1 To IndGrupeSaKojeKrecemo - 1
                        grupePitanjaCAPI(j).Visible = False
                    Next
                    'Call ResumeDrawing(grupePitanjaCAPI(0))
                    prvacntl = prvaCNTLCAPIPanel(grupePitanjaCAPI(0))
                    trenutnaKontrolaKojaImaFokus = prvacntl
                    IndGrupaNaKojuIdemo = 0
                    prvacntl.Focus()
                    Call zatvoriOLHC()
                End If
                If trenutnaKontrolaKojaImaFokus Is Nothing Then 'kliknem na labelu
                    Call SuspendDrawing(grupePitanjaCAPI(0))
                    grupePitanjaCAPI(0).Visible = True
                    Call ResumeDrawing(grupePitanjaCAPI(0))
                    Dim pomkk As Control = prvaCNTLCAPIPanel(grupePitanjaCAPI(0))
                    Call CAPIButton(False, 0, 0, pomkk)
                    Call zatvoriOLHC()
                    Me.Cursor = Cursors.Default
                    trcimsadugmeta = False
                End If
                Call CAPIButton(ok, IndGrupaNaKojuIdemo, indtrenutnipanel, trenutnaKontrolaKojaImaFokus)

                Call zatvoriOLHC()
                Me.Cursor = Cursors.Default
                trcimsadugmeta = False
            Else
                Call SuspendDrawing(grupePitanjaCAPI(0))
                grupePitanjaCAPI(0).Visible = True
                Call ResumeDrawing(grupePitanjaCAPI(0))
                Dim pomkk As Control = prvaCNTLCAPIPanel(grupePitanjaCAPI(0))
                Call CAPIButton(False, 0, 0, pomkk)
                Call zatvoriOLHC()
                Me.Cursor = Cursors.Default
                trcimsadugmeta = False
            End If

            trcimsadugmeta = False

        Catch ex As Exception
            Call SuspendDrawing(grupePitanjaCAPI(0))
            grupePitanjaCAPI(0).Visible = True
            Call ResumeDrawing(grupePitanjaCAPI(0))
            Dim pomkk As Control = prvaCNTLCAPIPanel(grupePitanjaCAPI(0))
            Call CAPIButton(False, 0, 0, pomkk)
            Call zatvoriOLHC()
            Me.Cursor = Cursors.Default
            trcimsadugmeta = False
        Finally
            'IST Close the screen

            Call zatvoriOLHC()
            Me.Cursor = Cursors.Default
            trcimsadugmeta = False
        End Try

        If IndGrupaNaKojuIdemo <> IndGrupaNaKojuIdemoSacuvaj AndAlso Not prvacntl Is Nothing Then
            Call ClickNaDugmeZaStranice(prvacntl, IndGrupaNaKojuIdemoSacuvaj, IndGrupaNaKojuIdemoSacuvaj)
        End If

    End Sub

    Sub CAPIButton(ByVal ok As Boolean, ByVal IndGrupaNaKojuIdemo As Integer, ByVal indtrenutnipanel As Integer, ByVal trenutnaKontrola As Control)
        If ok = True Then
            For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                grupePitanjaCAPI(i).Visible = False
                grupePitanjaCAPIButton(i).BackColor = Color.FromArgb(179, 179, 204)
                grupePitanjaCAPIButton(i).ForeColor = Color.Black
            Next
            Call SuspendDrawing(grupePitanjaCAPI(IndGrupaNaKojuIdemo))
            grupePitanjaCAPI(IndGrupaNaKojuIdemo).Visible = True
            Call ResumeDrawing(grupePitanjaCAPI(IndGrupaNaKojuIdemo))
            grupePitanjaCAPIButton(IndGrupaNaKojuIdemo).BackColor = SystemColors.Highlight
            grupePitanjaCAPIButton(IndGrupaNaKojuIdemo).ForeColor = Color.White
        Else
            For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                grupePitanjaCAPI(i).Visible = False
                grupePitanjaCAPIButton(i).BackColor = Color.FromArgb(179, 179, 204)
                grupePitanjaCAPIButton(i).ForeColor = Color.Black
            Next
            Call SuspendDrawing(grupePitanjaCAPI(indtrenutnipanel))
            grupePitanjaCAPI(indtrenutnipanel).Visible = True
            Call ResumeDrawing(grupePitanjaCAPI(indtrenutnipanel))
            grupePitanjaCAPIButton(indtrenutnipanel).BackColor = SystemColors.Highlight
            grupePitanjaCAPIButton(indtrenutnipanel).ForeColor = Color.White
        End If
        If Not trenutnaKontrola Is Nothing Then
            trenutnaKontrola.Focus()
            Call trenutnakontrolaBoja(trenutnaKontrola)
        End If

    End Sub

    Sub trenutnakontrolaBoja(ByVal trenutnakontrola As Control)

        If Not trenutnakontrola Is Nothing Then
            For Each cc As Control In trenutnakontrola.Parent.Controls
                If cc.Name.Trim.ToUpper <> trenutnakontrola.Name.Trim.ToUpper AndAlso cc.BackColor = Color.Bisque Then
                    cc.BackColor = SystemColors.ControlLightLight
                End If
            Next
            If Not trenutnakontrola.AccessibleName Is Nothing AndAlso trenutnakontrola.AccessibleName.Trim.ToUpper.IndexOf("AUTB") >= 0 Then
                DirectCast(trenutnakontrola, AutoCompleteTextbox).BackColor = Color.Bisque
                DirectCast(trenutnakontrola, AutoCompleteTextbox).SelectAll()
            ElseIf TypeOf trenutnakontrola Is TextBox Then
                DirectCast(trenutnakontrola, TextBox).BackColor = Color.Bisque
                DirectCast(trenutnakontrola, TextBox).SelectAll()
            End If
            If meAlwaysVisibleLabel = True Then
                Me.AlwaysVisibleLabel.Visible = True
            Else
                Me.AlwaysVisibleLabel.Visible = False
            End If
        End If

    End Sub

    Function getpreviouscontrol(ByVal tbox As Control) As Control
        Dim kk As Control = tbox
        Dim pp As Control = Nothing
        Do Until kk Is Nothing  'MORA PREKO LOOPA
            kk = tbox.Parent.GetNextControl(kk, False)
            If Not kk Is Nothing AndAlso kk.Name.Trim.ToUpper <> tbox.Name.Trim.ToUpper AndAlso kk.TabIndex < tbox.TabIndex AndAlso kk.Name.Trim <> "" AndAlso kk.Name.Trim.Length > 2 AndAlso kk.Name.Substring(0, 2).Trim.ToUpper = "TP" AndAlso kk.TabStop = True AndAlso kk.Enabled = True AndAlso kk.Visible = True Then
                pp = kk
                kk = Nothing
            End If
        Loop
        'If pp Is Nothing Then
        '    pp = tbox
        'End If
        Return pp
    End Function
    Function getNextTPcontrol(ByVal tbox As Control) As Control
        Dim kk As Control = tbox
        Dim pp As Control = Nothing
        Do Until kk Is Nothing  'MORA PREKO LOOPA
            kk = tbox.Parent.GetNextControl(kk, True)
            If Not kk Is Nothing AndAlso kk.Name.Trim.ToUpper <> tbox.Name.Trim.ToUpper AndAlso kk.TabIndex > tbox.TabIndex AndAlso kk.Name.Trim <> "" AndAlso kk.Name.Trim.Length > 2 AndAlso kk.Name.Substring(0, 2).Trim.ToUpper = "TP" AndAlso kk.TabStop = True AndAlso kk.Enabled = True AndAlso kk.Visible = True Then
                pp = kk
                kk = Nothing
            End If
        Loop
        Return pp
    End Function
