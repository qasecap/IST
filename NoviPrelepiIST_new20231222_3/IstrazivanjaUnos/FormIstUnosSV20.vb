    Function dodelapanelAVL(ByVal tcntlt As Control, ByVal nizdodeliKome() As String,
                            ByVal nizdodeliSta() As String, ByVal nizdodeliAko() As String,
                            ByVal glavnaTabela As String) As String
        dodelapanelAVL = ""
        Dim panel As Panel = tcntlt.Parent
        Dim plj As String = Mid(tcntlt.Name.Trim.ToUpper, 4)
        Dim bioavl As Boolean = False
        For sss As Integer = 0 To nizdodeliAko.GetUpperBound(0)
            Try
                Dim a As Integer = 1
                Dim tabela As String = glavnaTabela
                If DGTabelePanel(DGi(tabela)).Rows.Count > 0 Then
                    Dim pomKol4 As New DataColumn("pomKol4")
                    Dim bbb() As String = razkvantaj(nizdodeliAko(sss))
                    For ll As Integer = 0 To bbb.GetUpperBound(0)
                        If bbb(ll).Trim = plj Then
                            'saekrana
                            If SP(plj, panel).Trim = "" Then
                                bbb(ll) = "Null"
                            Else
                                bbb(ll) = "'" + SP(plj, panel).Trim + "'"
                            End If
                        End If
                        If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                            'saekrana pokupi fiktivno polje
                            bbb(ll) = "'" + SP(bbb(ll).Substring(4), panel, True).Trim + "'"
                        End If
                    Next
                    Dim zzz As String = ustringaj(bbb).ToUpper
                    zzz = razCASTi(zzz)
                    pomKol4.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                    DGTabelePanel(DGi(tabela)).Columns.Add(pomKol4)
                    Dim xxx As Object = NZ(DGTabelePanel(DGi(tabela)).Compute("MAX(pomKol4)", ""))
                    DGTabelePanel(DGi(tabela)).Columns.Remove(pomKol4)
                    a = CInt(xxx) '1 TRUE, 0 FALSE
                End If

                If a = 1 Then 'samo ako je ispunjen USLOV
                    'dodela
                    If nizdodeliKome(sss).Length > 0 Then
                        Dim tcntltnizKome As String() = Split(nizdodeliKome(sss), ",")

                        For cc As Integer = 0 To tcntltnizKome.GetUpperBound(0)
                            'avl
                            Dim alvHEAD As Boolean = False
                            If tcntltnizKome(cc).Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse tcntltnizKome(cc).Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
                                alvHEAD = True
                            End If

                            tcntltnizKome(cc) = tcntltnizKome(cc).Trim.ToUpper.Replace("GLAVA.", "")
                            tcntltnizKome(cc) = tcntltnizKome(cc).Trim.ToUpper.Replace("HEAD.", "")
                            Dim prvi As String = nizdodeliSta(sss).Trim.Substring(0, 1)
                            Dim poslednji As String = nizdodeliSta(sss).Substring(nizdodeliSta(sss).Length - 1, 1)
                            nizdodeliKome(sss) = nizdodeliKome(sss).Trim.ToUpper.Replace("GLAVA.", "")
                            nizdodeliKome(sss) = nizdodeliKome(sss).Trim.ToUpper.Replace("HEAD.", "")

                            If alvHEAD = True Then
                                Call alwaysVLGLAVA(tcntlt.Name, tcntltnizKome(cc), nizdodeliSta(sss), panel)
                            Else
                                If Not panel.AccessibleDescription Is Nothing AndAlso panel.AccessibleDescription.IndexOf("avl") >= 0 Then
                                    If bioavl = False Then
                                        Dim lbl As Label = NadjiKontrolu(panel, "AlwaysVisibleLabelPANEL" + panel.Name.ToUpper)
                                        Call alwaysVLPANEL(panel, lbl, tcntlt.Name, tcntltnizKome(cc), nizdodeliSta(sss))

                                        If inlineAWLPanel = True Then
                                            Dim xTRT As Integer = tcntlt.Location.X
                                            Dim yTRT As Integer = tcntlt.Location.Y
                                            Dim aLBL As Integer = lbl.Width
                                            Dim bLBL As Integer = lbl.Height
                                            Dim aTRT As Integer = tcntlt.Width
                                            Dim bTRT As Integer = tcntlt.Height

