    Sub sklopiBlokP(ByVal panel As Panel)
        Dim kumraz As Integer = 0
        grupeCNTLPanel(ipanel) = panel
        ReDim Preserve grupeObicneCNTLBlokoviPanel(ipanel)
        ReDim Preserve grupeObicneCNTLBlokoviPanelSve(ipanel)
        ReDim Preserve grupeCNTLBlokoviPanel(ipanel)
        ReDim Preserve grupePitanjaPretposlednjePoljePanel(ipanel)

        If grupePitanjaBlokoviPanel(ipanel).Length > 0 Then
            For ii As Integer = 0 To grupePitanjaBlokoviPanel(ipanel).GetUpperBound(0)
                Dim l As Integer = -1
                Dim ol As Integer = -1
                Dim ool As Integer = -1
                ReDim Preserve grupeObicneCNTLBlokoviPanel(ipanel)(ii)
                ReDim Preserve grupeObicneCNTLBlokoviPanelSve(ipanel)(ii)
                ReDim Preserve grupeCNTLBlokoviPanel(ipanel)(ii)
                ReDim Preserve grupePitanjaPretposlednjePoljePanel(ipanel)(ii)
                Dim pp() As String = grupePitanjaBlokoviPanel(ipanel)(ii).Split(";")
                'vidljiv
