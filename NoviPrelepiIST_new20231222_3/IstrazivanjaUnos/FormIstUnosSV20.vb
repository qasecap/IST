    Private Sub OdCrveni()
        For Each k1 As Control In Me.Controls 'ovde je kljuc
            If Mid(k1.Name.Trim.ToUpper, 1, 2) = "GB" Then
                For Each k As Control In k1.Controls
                    If Not TypeOf k Is Label Then
                        k.BackColor = SystemColors.ControlLightLight
                    End If
                Next
            End If
        Next 'kontrola

        If grupePitanjaCAPI Is Nothing Then
            Call oodCrvenip(Me.Panel1)
        End If
        If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then
            For m As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                oodCrvenip(grupePitanjaCAPI(m))
            Next
        End If

    End Sub

    Sub oodCrvenip(ByVal pane As Panel)
        For Each k As Control In pane.Controls 'ovde polja
            If k.BackColor <> SystemColors.ControlLightLight AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "C" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "H" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "R" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "U" Then
                If k.BackColor.Equals(RGBColors.mBackColor) Or k.BackColor.Equals(Color.Yellow) Or k.BackColor.Equals(Color.Tomato) Or k.BackColor.Equals(Color.LightYellow) Or k.BackColor.Equals(Color.LightSeaGreen) Or k.BackColor.Equals(Color.LightSteelBlue) Or k.BackColor.Equals(Color.LemonChiffon) Then
                Else
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "H" Then
                        k.BackColor = RGBColors.mBackColor
                    Else
                        k.BackColor = SystemColors.ControlLightLight
                    End If
                End If
                If k.Focused Then k.BackColor = Color.Bisque
            End If
        Next 'kontrola <-
    End Sub

    Private Sub Zacrveni(ByVal polje As String)
        For Each k1 As Control In Me.Controls 'ovde je kljuc
            If Mid(k1.Name.Trim.ToUpper, 1, 2) = "GB" Then
                For Each k As Control In k1.Controls
                    If Mid(k.Name.Trim.ToUpper, 3) = polje.Trim.ToUpper Then
                        k.BackColor = Color.Red
                        Exit Sub
                    End If
                Next
            End If
        Next 'kontrola
        If grupePitanjaCAPI Is Nothing Then
            Call zZacrveniP(Me.Panel1, polje)
        End If
        If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then
            For m As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                Dim k As Control = NadjiKontroluSkrKojaNijeLABELA(grupePitanjaCAPI(m), polje, 2)
                If Not k Is Nothing Then
                    zZacrveniP(k.Parent, polje)
                    Exit For
                End If
            Next
        End If
    End Sub

