    Function addmv(ByVal addmissingvalue As String, ByVal mdtLabel As DataTable, ByVal txtmode As String, ByVal GlavnaTabela As String, ByVal jezik As String) As String
        Dim f2 As String = "" : Dim f3 As String = ""
        addmissingvalue = addmissingvalue.Trim.ToUpper.Replace("ADDMISSINGVALUE", "")
        'f2="!8refuse,f3="?9dontknow
        Dim imaf2 As Boolean = False : Dim imaf3 As Boolean = False
        If addmissingvalue.ToUpper.IndexOf("F2") >= 0 Then imaf2 = True
        If addmissingvalue.ToUpper.IndexOf("F3") >= 0 Then imaf3 = True
        If imaf2 = True AndAlso imaf3 = True Then
            'Dim pomF2F3() As String = addmissingvalue.ToUpper.Split("F3")
            Dim pomF2F3() As String = Strings.Split(addmissingvalue.ToUpper, "F3")
            f2 = pomF2F3(0).Replace("F2", "").Replace("=", "")
            f3 = pomF2F3(1).Replace("=", "").Replace("}", "")
        End If
        If imaf2 = True AndAlso imaf3 = False Then
            f2 = addmissingvalue.Trim.ToUpper.Replace("F2", "").Replace("=", "").Replace("}", "")
        End If
        If imaf2 = False AndAlso imaf3 = True Then
            f3 = addmissingvalue.Trim.ToUpper.Replace("F3", "").Replace("=", "").Replace("}", "")
        End If
        If f2.Trim.ToUpper.IndexOf("ISTLBL") >= 0 Then
            f2 = f2.Trim.ToUpper.Replace("ISTLBL", "")
            Dim MLopis As String = getMultilanguageLabel(mdtLabel, txtmode, GlavnaTabela, "", "f2", jezik, f2)
            If MLopis = "" Then
                MsgBox("You don't have F2 in ISTLables table!", vbInformation)
            Else
                f2 = Replace(MLopis, "'", "''")
            End If
        End If
        If f3.Trim.ToUpper.IndexOf("ISTLBL") >= 0 Then
            f3 = f3.Trim.ToUpper.Replace("ISTLBL", "")
            Dim MLopis As String = getMultilanguageLabel(mdtLabel, txtmode, GlavnaTabela, "", "f3", jezik, f3)
            If MLopis = "" Then
                MsgBox("You don't have F3 in ISTLables table!", vbInformation)
            Else
                f3 = Replace(MLopis, "'", "''")
            End If
        End If

        addmv = f2 + "$" + f3
    End Function

    Function zameniFPPanel(ByVal zzz As String, ByVal panel As Panel) As String
        zameniFPPanel = ""
        Dim pp As String = ""
        If CStr(zzz).Trim.ToUpper.IndexOf("#FP{") < 0 Then
            zameniFPPanel = zzz
            Exit Function
        End If
        Dim bbb() As String = razkvantaj(zzz)
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            If bbb(ll).Trim.IndexOf("#FP{") = 0 Then  'fiktivno polje
                'saekrana pokupi fiktivno polje
                pp = SP(bbb(ll).Replace("}", "").Substring(4), panel, True).Trim.Replace("'", dap)
                If ll - 2 >= 0 AndAlso bbb(ll - 2).Length() >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                    If ll + 2 >= 0 AndAlso bbb(ll + 2).Length() >= 0 AndAlso bbb(ll + 2).Trim.ToUpper = "0" Then
                        If IsNumeric(pp) = True Then
                            bbb(ll) = pp
                        ElseIf pp = "''" OrElse pp = "" Then
                            'pp = "Null"
                            bbb(ll) = "Null"
                        Else
                            bbb(ll) = "'" + pp + "'"
                        End If
                    Else
                        bbb(ll) = "'" + pp + "'"
                    End If
                ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                    bbb(ll) = pp
                ElseIf pp = "0" Then  'samo nula
                    bbb(ll) = pp
                Else
                    bbb(ll) = "'" + pp + "'"
                End If
            End If
        Next
        zameniFPPanel = ustringaj(bbb).ToUpper
    End Function

