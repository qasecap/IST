        Else 'od if nadjen, dakle sad da se otvori "prazan" red u dgtabelepanel(glavnatabela)
            ISTNote.Text = ""
            ' IsprazniKontrolePanel(panel, 2)
            Me.DGTabelePanel(DGi(GlavnaTabela)).Rows.Add(Me.DGTabelePanel(DGi(GlavnaTabela)).NewRow)
            'popuni kljuc
            If panel11 = True Then
                For Each s As String In KljuceviPanel 'Me.GlavniKljuc
