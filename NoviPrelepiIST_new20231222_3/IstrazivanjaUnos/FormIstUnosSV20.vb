                panel.HorizontalScroll.Visible = False
                panel.AutoScroll = True

                If grupeCNTLBlokoviPanel(ipanel).Length > 0 Then
                    Call vidljivBlokPanelBasOvaj(ipanel, 0)
                    Call nevidljivBlokPanelSviSem(ipanel, 0)
                End If
            Else
