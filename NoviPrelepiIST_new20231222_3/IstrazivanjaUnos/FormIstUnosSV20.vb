            pp = nizKontrola(ind).Parent
        Else
            'ako skacem van svih panela, npr na dugme
            Dim ind1 As Integer = Array.IndexOf(nizKontrolaIme, plj)
            If ind1 > -1 Then
                pp = nizKontrola(ind1).Parent
            End If
        End If

