    Sub subOnReturnFocusOn()
        If nizOnReturnFocusOn.Length > 0 AndAlso NizOnReturnFocusIf.Length > 0 Then
            For sss As Integer = 0 To nizOnReturnFocusOn.GetUpperBound(0)
                nizOnReturnFocusOn(sss) = nizOnReturnFocusOn(sss).Trim.ToUpper
                Dim a As Integer = 0
                Dim zzz As String = sracunajIzraz(NizOnReturnFocusIf(sss), "", Nothing)
                a = scompute(zzz, "OnReturn", "focusOn")
                If a = 1 Then
                    Dim indPK As Integer = Array.IndexOf(nizPKKontrolaIme, nizOnReturnFocusOn(sss))
                    If indPK > -1 Then
                        Dim cntlk As Control = nizPKKontrola(indPK)
                        'sta ako nije poslednji kljuc??????? (da stavimo da ne može?)
                        If cntlk.TabIndex = ZKlj Then
                            'VAZNO - DODELA NE MORA DA IDE IZ POSLJEDNJE POLJA U KLJUCU ZA TO MORA DA SE PRAZNE SAMO ONI KOJIMA NISTA NIJE DODELJENO IZ KLJUCA
                            If SCati = False Then
                                If grupePitanjaCAPI Is Nothing Then
                                    IsprazniKontrolekojeNisuKljucIKojeNemajuVrednostPrekoDodeleIzKljuca(Me.Panel1, False, 0)
                                Else
                                    For ii As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                                        IsprazniKontrolekojeNisuKljucIKojeNemajuVrednostPrekoDodeleIzKljuca(grupePitanjaCAPI(ii), False, ii)
                                    Next
                                End If
                            End If
                            ELGaIma(GlavnaTabela, False)
                            If Not grupePitanjaCAPI Is Nothing Then
                                Call backToFirstCAPI(True)
                            Else
                                Call Polje1Focus()
                            End If
                            Me.Cursor = Cursors.Default
                            Exit Sub
                        End If
                        Exit For
                    Else
                        Dim ind As Integer = Array.IndexOf(nizKontrolaIme, nizOnReturnFocusOn(sss))
                        If ind > -1 Then
                            Dim ef As Boolean = False
                            If nizKontrola(ind).Enabled = False Then
                                nizKontrola(ind).Enabled = True
                                ef = True
                            End If
                            nizKontrola(ind).Focus()
                            If ef = True Then nizKontrola(ind).Enabled = False
                            Exit For
                        Else
                            Dim skacemNa As String = nizOnReturnFocusOn(sss).Trim.ToUpper

                            If skacemNa = "DUGMEDALJE" OrElse skacemNa = "BUTTONNEXT" Then
                                BtnSaveNext.Focus()
                            ElseIf skacemNa = "DUGMESACUVAJ" AndAlso skacemNa = "BUTTONSAVE" Then
                                BtnSave1.Focus()
                            ElseIf skacemNa = "BUTTONEXIT" Then
                                BtnExit.Focus()
                            ElseIf skacemNa.IndexOf("GRID") = 0 Then
                                skacemNa = skacemNa.Replace("GRID", "")
                                Dim ind8 As Integer = Array.IndexOf(nizDGV2KontrolaIme, skacemNa)
                                If ind8 > -1 Then
                                    nizDGV2Kontrola(ind8).Grid.Focus()
                                End If
                            ElseIf skacemNa.IndexOf("TABELA") = 0 Then
                                'skace na dupe
                                skacemNa = skacemNa.Replace("TABELA", "BTN")
                                For Each k As Control In Me.Panel1.Controls
                                    If k.Name.Trim.ToUpper = skacemNa.Trim.ToUpper Then
                                        k.Focus()
                                        Exit For
                                    End If
                                Next
                            ElseIf skacemNa.IndexOf("TABLE") = 0 Then
                                'skace na dupe
                                skacemNa = skacemNa.Replace("TABLE", "BTN")
                                For Each k As Control In Me.Panel1.Controls
                                    If k.Name.Trim.ToUpper = skacemNa.Trim.ToUpper Then
                                        k.Focus()
                                        Exit For
                                    End If
                                Next
                            ElseIf skacemNa.IndexOf("PANEL") = 0 Then
                                skacemNa = skacemNa.Replace("PANEL", "PANE_")
                                For Each k As Control In Me.Panel1.Controls
                                    If k.Name.Trim.ToUpper = skacemNa.Trim.ToUpper Then
                                        k.Focus()
                                        'SendKeys.Send("{TAB}")
                                        'MORA OVAKO DOKAZ PROBNIPOPIS
                                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    End If
                End If
            Next
        End If
