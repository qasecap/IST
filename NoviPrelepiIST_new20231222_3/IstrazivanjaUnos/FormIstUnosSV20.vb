            End If
        Catch ex As System.Exception
            'Dim por As String = "CHECK databaseType (FIZBAZA) IN THIS TABLE, YOU PROBABLY HAVE databaseType THAT DOES NOT EXISTS IN table _ISTDatabaseConnStrings (ISTBAZE)." + nvrd + nvrd +
