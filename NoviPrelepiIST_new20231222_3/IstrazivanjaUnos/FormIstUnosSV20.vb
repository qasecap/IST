    Private Function ProveraUnosLOCK() As Integer ' vraca 1 ako je zakljucan unos
        ProveraUnosLOCK = 0
        Dim nijenov As Integer = 0
        'nov?
        Dim sqlK As String = " select * from " & Me.prfxt(GlavnaTabela) & " where 2=2 "
        For k As Integer = 0 To Me.GlavniKljuc.GetUpperBound(0)
            Dim dodajconvert As Boolean = False
            If Mid(PoljaGlavniKljuc(k).Trim.ToUpper, 1, 2) = "UK" Then dodajconvert = True
            If dodajconvert = False Then
                sqlK = sqlK + " and " & Me.GlavniKljuc(k) & " ='" & SEK(Me.GlavniKljuc(k)) & "'"
            End If
            If dodajconvert = True Then
                sqlK = sqlK + " and convert(varchar," & Me.GlavniKljuc(k) & " , 126) ='" & SEK(Me.GlavniKljuc(k)) & "'"
            End If
        Next

        If ImaVODVDO Then
            Dim pbz As String = CStr(dIst.IST.Rows(0).Item("BAZA")).Trim
            sqlK = Me.DodajVodVdo(sqlK, pbz, IzrazLKTabele(pbz, GlavnaTabela.Trim.ToUpper), GlavnaTabela.Trim.ToUpper)
        End If

        Dim dtK As DataTable
        dtK = izvrsiSQLvratiDT(sqlK, Me.DBConnectionString, Me.jezik)
        If Not (dtK Is Nothing) AndAlso dtK.Rows.Count = 0 Then
            'nov
            'da li uopste postoji LK polje
            If Not (DGTabele(DGi(GlavnaTabela)).Columns("LK") Is Nothing) Then
                Dim sql As String = " select min(cast (isnull(LK,0) as integer)) as LK from " & Me.prfxt(GlavnaTabela) & " where 2=2 "
                For i As Integer = 0 To Me.GlavniKljuc.GetUpperBound(0)
                    If Me.GlavniKljuc(i) = "GOD" OrElse Me.GlavniKljuc(i) = "MES" OrElse Me.GlavniKljuc(i) = "ISTYEAR" OrElse Me.GlavniKljuc(i) = "ISTMONTH" Then
                        sql = sql + " and " & Me.GlavniKljuc(i) & " ='" & SEK(Me.GlavniKljuc(i)) & "'"
                    End If
                Next
                If ImaVODVDO Then
                    Dim pbz As String = CStr(dIst.IST.Rows(0).Item("BAZA")).Trim
                    sql = Me.DodajVodVdo(sql, pbz, IzrazLKTabele(pbz, GlavnaTabela.Trim.ToUpper), GlavnaTabela.Trim.ToUpper)
                End If
                Dim dt As DataTable
                dt = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)
                'ako je min=1 to znaci da us svi iz vrtacke imaju LK1 onda ne dozvoljavam unos novog,
                'ako ima mesano onda moze unos novog
                If Not (dt.Rows(0).Item("LK") Is Nothing) AndAlso (Not (dt.Rows(0).Item("LK").GetType Is GetType(System.DBNull))) AndAlso dt.Rows(0).Item("LK") = 1 Then
                    ProveraUnosLOCK = 1
                End If
            End If
        Else
            'nije nov
            ProveraUnosLOCK = 0
        End If
        Return ProveraUnosLOCK
    End Function

