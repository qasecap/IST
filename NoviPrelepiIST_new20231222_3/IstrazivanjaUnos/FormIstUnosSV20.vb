        Dim addnewrowif As String = ""
        Dim pp() As String = {}
        Dim toWhat As String = ""
        Dim a As Integer = 1

        Dim brisem As Boolean = False
        Dim upisujem As Boolean = False

        Call fixPanelFinalAfterJumpDONTSAVE(panel)

