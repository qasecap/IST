    Sub openForma(ByVal fforma As Form)
        If Not CType(fforma, Control).IsDisposed Then
            Try
                fforma.AccessibleName = "previewEditMode"
                fforma.AccessibleDescription = mnu02.AccessibleDescription
                fforma.Tag = mnu02.Tag
                fforma.StartPosition = FormStartPosition.CenterScreen
                fforma.ShowDialog()
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
                If Not CType(fforma, Control).IsDisposed Then
                    fforma.Dispose()
                End If
            End Try

            If fforma.AccessibleName <> "cancel" Then
                Dim folder As String = System.Environment.GetFolderPath(System.Environment.SpecialFolder.Personal) + "\Istrazivanja\GUIBACKUP\POLJA"
                Dim backUpMetaFileUndo As String = folder + "\BackUpUndo.txt"
                Dim backUpMetaFileRedo As String = folder + "\BackUpRedo.txt"
                Dim backUpMetaFileLast As String = folder + "\BackUpLast.txt"
                Dim backUpMetaFileFirst As String = folder + "\BackUpFirst.txt"
                btnUndo.Visible = True
                btnUndoVisible = True
                btnRedoVisible = False
                btnRedo.Visible = False
                If File.Exists(backUpMetaFileRedo) Then File.WriteAllText(backUpMetaFileRedo, "")
                If File.Exists(backUpMetaFileLast) Then File.WriteAllText(backUpMetaFileLast, "")

                Call subREFRESH("C")
            End If
        End If
    End Sub
