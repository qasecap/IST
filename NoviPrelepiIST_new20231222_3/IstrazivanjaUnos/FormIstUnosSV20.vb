    Private Sub hh_KeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs)
        Dim hhchb As CheckBox = CType(sender, CheckBox)
        AktivanCekBoks = hhchb
        'ISTMessageBox.Show(Asc(e.KeyChar))
        Select Case e.KeyChar
            Case ChrW(27) 'ESC
                Me.BtnExit.Focus()
            Case ChrW(13) 'Enter
                If SCati = True Then
                    'vrati se u ctrt polje
                    'pa onda enter
                    Dim grupa As String = hhchb.Tag
                    Dim pppom As Panel = hhchb.Parent
                    Dim imeP As String = pppom.Name.Trim.ToUpper.Replace("CATIPOM_", "CATI_")
                    Dim pp As Panel = NadjiKontrolu(Me, imeP)
                    Dim rtb As pomTextBox = NadjiKontrolu(pp, "pomocno" & "_" & grupa)
                    rtb.Focus()
                    rtb.BackColor = SystemColors.ControlLightLight
                End If
                If SCati = False Then
                    'SendKeys.Send("{TAB}")
                    'MORA OVAKO DOKAZ PROBNIPOPIS
                    'dodaj validaciju!!!!!!
                    If Not hhchb.Tag Is Nothing AndAlso hhchb.Tag.ToString.Trim <> "" Then
                        Dim chPp() As CheckBox = kojeugrupi2(hhchb.Tag)
                        Call hhStopSkip(chPp(0))
                        If Not bbss Is Nothing Then bbss.Focus()
                        'prebaci na prvu kontrolu van grupe
                        'Dim tbkk As Control = getNextTPcontrol(hhchb)
                        'tbkk.Focus()
                    Else
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                    End If

                End If

            Case ChrW(33) 'pageDown
                bioPageDown = True
                'SendKeys.Send("{TAB}")
                'MORA OVAKO DOKAZ PROBNIPOPIS
                Me.SelectNextControl(ActiveControl, True, True, True, True)
            Case Else
        End Select
    End Sub

