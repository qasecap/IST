    Private Function Upisi(saDateUser As Boolean) As Boolean

        Dim koSam As String = ""
        Dim txtcloudcati As Boolean = False
        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse
                    txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode.Trim.ToUpper = "MIXMODECAPIDESKTOP" Then   'može i testcapi
            koSam = GetUserNameCAPI(Me.ISTConnectionString, Me.jezik)
        ElseIf txtmode.Trim.ToUpper = "ZCAPI" OrElse txtmode.Trim.ToUpper = "Z" Then
            koSam = GetUserNameZ()
        ElseIf anketarCATIcloud <> "" OrElse txtmode.Trim.ToUpper = "CLOUD" Then
            koSam = anketarCATIcloud
            txtcloudcati = True
        ElseIf anketarCATI <> "" Then
            koSam = anketarCATI
        Else
            'koSam = GetUserName()
            koSam = GetUserNameIzBaze(Me.DBConnectionString)
        End If

        Dim GrskTXT As String = ""
        Dim tabelaNaziv As String = ""

        Dim gkljc As String = " 2=2 "
        For i As Integer = 0 To Me.GlavniKljuc.GetUpperBound(0)
            If IsNumeric(SEK(Me.GlavniKljuc(i))) = True Then
                gkljc = gkljc + " and " & Me.GlavniKljuc(i) & " ='" & SEK(Me.GlavniKljuc(i)) & "'"
            Else
                gkljc = gkljc + " and " & Me.GlavniKljuc(i) & " =N'" & SEK(Me.GlavniKljuc(i)) & "'"
            End If
        Next

        Dim dtP As DataTable

        Try
            For Each dt As DataTable In DGTabele
                Dim tabbb As String = dt.TableName.Trim.ToUpper
                If dt.Prefix.Trim.ToUpper = "DBO" Then
                Else
                    tabbb = dt.Prefix.Trim.ToUpper + "." + dt.TableName.Trim.ToUpper
                End If

                If dt.Rows.Count > 0 AndAlso Not (dt.Columns("LK") Is Nothing) AndAlso (Not (dt.Rows(0).Item("LK").GetType Is GetType(System.DBNull))) AndAlso CBool(dt.Rows(0).Item("LK")) = True Then
                    'zakljucan slog NE RADI NIŠTA
                Else
                    Dim vju As Boolean = False
                    For Each tt As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
                        If (Not tt.IsT2Null) AndAlso tt.Tabela.Trim.ToUpper = tabbb Then
                            If tt.T2.Trim.ToUpper.IndexOf("VIEW") > -1 Then
                                vju = True
                                Exit For
                            End If
                        End If
                    Next
                    If vju = False Then
                        If IstaGlava(tabbb, GlavnaTabela) Then
                            dt = DGTabele(DGi(tabbb))
                            dtP = DGTabeleOriginal(DGi(tabbb))
                            GrskTXT = "Табела: " & tabbb
                            tabelaNaziv = tabbb

                            Dim kljuc() As String = {}
                            Dim poljaTabeleKojaNisuKljuc As String = "$"
                            For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                                If p.TABELA.Trim.ToUpper = tabbb Then
                                    If Not p.IsKLJUCNull AndAlso p.KLJUC.Trim.ToUpper = "P" Then
                                        ReDim Preserve kljuc(kljuc.GetUpperBound(0) + 1)
