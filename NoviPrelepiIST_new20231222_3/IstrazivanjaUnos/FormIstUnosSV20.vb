        '***********
        '''''''''''''''''
        'PROMENA!!!!!
        'ODMAH PAMTI U BAZI!!!!!!!!
        '

        Try

            If DGTabele(DGi(GlavnaTabela)).Rows.Count > 0 AndAlso
