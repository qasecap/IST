    Private Sub dpp_MouseMove(ByVal sender As Object, ByVal e As MouseEventArgs)
        Dim tbox As TextBox = CType(sender, TextBox)
        Dim panel As Panel = tbox.Parent
        Dim GlavnaTabela As String = panel.Name.Replace("PANE_", "")
        Dim grs() As String = Me.GreskeZaPolje(tbox.Name.Substring(3), GlavnaTabela)

        Dim paneLKpanel As ListBox

        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.ToUpper.IndexOf("SCROLLBAR") >= 0 Then
            paneLKpanel = NadjiKontrolu(Panel1, "PANELKPANEL" + GlavnaTabela)
        Else
            paneLKpanel = NadjiKontrolu(Panel1, "paneLKpanel")
        End If

        If Not paneLKpanel Is Nothing Then
            Dim pomLK(paneLKpanel.Items.Count - 1) As String
            For i As Integer = 0 To paneLKpanel.Items.Count - 1
                Dim ppp As String = CType(paneLKpanel.Items(i), String)
                pomLK(i) = ppp.Substring(0, ppp.IndexOf("-") - 1)
            Next
            Dim tt As String = ""
            For i As Integer = 0 To grs.GetUpperBound(0)
                If Array.IndexOf(pomLK, grs(i)) >= 0 Then
                    If tt.Trim.Length > 0 Then tt = tt & Chr(13)
                    tt = tt & CType(paneLKpanel.Items(Array.IndexOf(pomLK, grs(i))), String)
                End If
            Next
            Me.ToolTip1.SetToolTip(sender, tt)
        End If
    End Sub

