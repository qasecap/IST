            tm93.Visible = True 'ACTB
            atm4.Visible = True  'Appereance
            tmSpace.Visible = True 'empty space
            atm67.Visible = False  'merge
            atm68.Visible = False 'unmerge
            atm88.Visible = False 'format and app VF
            If TypeOf cntl Is Panel Then
                'radiobuttongroup
                If cntl.Name.Trim.ToUpper.IndexOf("RG") = 0 Then
                    Dim rgb As Panel = DirectCast(cntl, Panel)
                    mnu02.Tag = rgb.AccessibleDefaultActionDescription
                    mnu02.AccessibleDescription = "rbg"
                End If
            ElseIf TypeOf cntl Is GroupBox AndAlso Not TypeOf cntl Is DataGridView2 Then   'kljuc
                If cntl.Name.Trim.ToUpper.Substring(0, 2) = "GB" Then
                    Dim gbk As GroupBox = DirectCast(cntl, GroupBox)
                    mnu02.Tag = gbk.AccessibleDefaultActionDescription
                    mnu02.AccessibleDescription = "gbk"
                    'SAMO appereance
                    Call samoAPP()
                End If
            ElseIf TypeOf cntl Is LinkLabel Then
                Dim ll As LinkLabel = DirectCast(cntl, LinkLabel)
                mnu02.Tag = ll.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "ll"
            ElseIf TypeOf cntl Is DateTimePicker2 Then
                Dim dtp2 As DateTimePicker2 = DirectCast(cntl, DateTimePicker2)
                mnu02.Tag = dtp2.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "dtp2"
            ElseIf TypeOf cntl Is TextBox Then
                Dim tbox As TextBox = DirectCast(cntl, TextBox)
                mnu02.Tag = tbox.AccessibleDefaultActionDescription
                If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                    tbox.BackColor = SystemColors.ActiveCaption
                    mnu02.Tag = tbox.AccessibleDefaultActionDescription
                    mnu02.AccessibleDescription = "actb"
                    tm93.Visible = False  'ACTB
                    atm4.Visible = False 'Appereance
                Else
                    If cntl.Name.Trim.ToUpper.Substring(0, 2) = "TP" Then
                        tbox.BackColor = SystemColors.ActiveCaption
                        atm6.Visible = True
                        mnu02.AccessibleDescription = "tp"
                        tm9.Visible = False
                        'format+appereance
                    ElseIf cntl.Name.Trim.ToUpper.Substring(0, 2) = "TK" Then
                        tbox.BackColor = SystemColors.ActiveCaption
                        mnu02.Tag = tbox.AccessibleDefaultActionDescription
                        mnu02.AccessibleDescription = "tk"
                        'SAMO appereance
                        Call samoAPP()
                    Else
                        mnu02.AccessibleDescription = "fp"
                        'koja vrsta FP?
                        'Format+appereance za labelu ostalo otvara se insertVF
                        Dim fpname As String = cntl.Name.Trim.ToUpper.Substring(2)
                        'fptbox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.vod.tostring("yyyy/MM/dd").trim + ";" + fptbox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim
                        Dim fppp() As String = cntl.AccessibleDefaultActionDescription.Split(";")
                        Dim sql As String = "select isnull(pp,'') as pp from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + fppp(0) + "' and polje='" + fpname + "' " +
                        " and cast (vod as date)='" + Convert.ToDateTime(fppp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"
                        Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Me.jezik)

                        If dt.Rows.Count = 0 OrElse dt.Rows.Count > 0 AndAlso dt.Rows(0).Item(0).ToString = "lbl" Then
                            tm8.Visible = False
                            tm91.Visible = False
                            atm67.Visible = True
                            atm68.Visible = True
                            atm88.Visible = False
                            atm8.Visible = False 'format
                            atm4.Visible = True 'Appereance
                        Else
                            tm8.Visible = False
                            tm91.Visible = False
                            atm67.Visible = False 'merge
                            atm68.Visible = False 'unmerge

                            atm8.Visible = False 'format
                            atm4.Visible = False 'Appereance

                            atm88.Visible = True  'format and app VF
                            atm88.Tag = dt.Rows(0).Item(0).ToString
