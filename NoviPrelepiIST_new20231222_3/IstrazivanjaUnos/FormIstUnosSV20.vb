    Sub bdodajChB(ByVal pp() As String, ByVal gde As String, Optional lbl As Boolean = False)

        Dim sqlIST As String = ""
        Dim ppolje As String = dajUniqueImeISTDB(pp(0).Trim, "column_", "")
        Dim p2 As String = ""
        Dim rrbr As String = pp(4).Trim
        Dim pomrbr As String = ""

        Dim trk() As String = pp(3).Split(".")
        If trk.Length = 3 Then
            Dim currenttab As Integer = CInt(trk(0).Trim)
            Dim minrbrzatab As String = minRBRTabela(pp(0).Trim, currenttab)
            Dim maxrbrzatab As String = maxRBRTabela(pp(0).Trim, currenttab)
            If gde <> "left" Then
                If gde = "above" Then
                    rrbr = minrbrzatab
                Else
                    rrbr = maxrbrzatab
                End If
            End If
        End If

        If gde <> "left" Then
            If gde = "above" Then
                pomrbr = rrbr + 10
                rrbr = rrbr
            Else
                pomrbr = rrbr
                rrbr = rrbr + 10
            End If
            sqlIST = " update istpolja set rbr=rbr+10 where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim +
                    "' and rbr>=" + rrbr.Trim + ";" + nvrd
            Dim popis As String = "lRightA$Text for CheckBox"
            Dim pizraz As String = "CheckBox"

            sqlIST = sqlIST + "insert into istpolja (sifist,tabela,polje,vod,vdo,rbr,opis,izraz)" + nvrd +
                      " select sifist,tabela,N'" + ppolje + "' as polje,vod,vdo,'" + rrbr.Trim + "' as rbr,N'" + popis + "',N'" + pizraz + "'" +
                      " from istpolja " +
                      " where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and rbr ='" + pomrbr + "'"
            Dim sqlDB As String = "ALTER TABLE " + pp(0).Trim + " ADD  " + ppolje + " tinyint NULL;" + nvrd
            Dim sqlDBDropTip As String = pp(0).Trim + ";" + ppolje
            Dim DropTip As String = "ADD"
            p2 = napraviBackUpizvrsiSQL(sqlIST,, sqlDBDropTip.TrimEnd("#"), DropTip.TrimEnd("#"))

            If p2 = "nok" Then
                ISTMessageBox.Show("Error!")
            Else
                p2 = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
                If p2 = "nok" Then ISTMessageBox.Show("Error!") Else Call subREFRESH("C")
            End If
        End If

    End Sub
