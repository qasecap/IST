        ElseIf TypeOf k Is DateTimePicker2 AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "U" AndAlso Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("NE;") < 0 Then
            CType(k, DateTimePicker2).Enabled = True
        ElseIf TypeOf k Is Panel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 2) = "RG" AndAlso k.AccessibleName Is Nothing Then
