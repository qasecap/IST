    Sub dodeliVrednostiCAPI(ur As DataRow, red() As DataRow, sqlNU As String, nadjen As Boolean, tabela As String, ByVal sqlKljuc As String)
        For Each p As Control In Me.Panel1.Controls
            If TypeOf p Is Panel AndAlso p.Name.ToString.Trim.Length >= 5 Then
                If Mid(p.Name.ToString.Trim.ToUpper, 1, 5) = "CAPI_" Then
                    Call dodeliVrednosti(ur, red, sqlNU, nadjen, tabela, p, sqlKljuc)
                End If
            End If
        Next
    End Sub

    Sub postaviURadu(ByVal sqlKljuc As String)
        Dim llogovan As String = ""
        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse
                    txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode.Trim.ToUpper = "MIXMODECAPIDESKTOP" Then   'može i testcapi
            llogovan = logovanCAPI()
        ElseIf anketarCATIcloud <> "" OrElse txtmode.Trim.ToUpper = "CLOUD" Then
            llogovan = anketarCATI
        ElseIf anketarCATI <> "" Then
            llogovan = anketarCATI
        Else
            llogovan = GetUserName.ToString.Trim
        End If

        Dim strsql As String = "update " + GlavnaTabela +
        " set uradu=1," +
        " datum_uradu =getdate()," +
        " ko_uradu ='" + llogovan + "'" +
        " where " + sqlKljuc
        Dim ok As String = izvrsiSQL(strsql, Me.DBConnectionString)
        If ok = "nok" Then
            ISTMessageBox.Show(strsql + nvrd + nvrd + "is not executed! ER1", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
        End If
    End Sub

    Sub dodeliVrednosti(ur As DataRow, red() As DataRow, sqlNU As String, nadjen As Boolean, tabela As String, pane As Panel, ByVal sqlKljuc As String)

        pocetnadodelavrednosti = True
        ISTNote.Text = ""
        If (ur.Table.Columns.Contains("ISTNOTE")) AndAlso Not ur.Item("ISTNOTE") Is System.DBNull.Value Then
            ISTNote.Text = ur.Item("ISTNOTE").trim
        End If
        For Each k As Control In pane.Controls
            If k.Name.Trim.ToUpper.IndexOf("GRD") > 0 Then
                Dim aa As String = "aa"
            End If
            Dim TBCB As Integer = 0   'da li je TB ili CB  0 ne, 1 da
            If k.AccessibleName Is Nothing OrElse (Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("ALWAYSFROMCODEBOOK;") < 0) Then
                'DODELA VREDNOSTI
                If TypeOf k Is TextBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "T" Then
                    TBCB = 1
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                    Else
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("AUTB") >= 0 Then   'autoCompleteTextBox
                            Call dodelaVrAUTB(CType(k, AutoCompleteTextbox), ur.Item(Mid(k.Name.Trim.ToUpper, 3)))
                        Else
                            Try
                                If ur.Table.Columns(Mid(k.Name.Trim.ToUpper, 3)).DataType.Name.ToString.Trim.ToUpper = "DATETIME" Then
                                    k.Text = CDate(ur.Item(Mid(k.Name.Trim.ToUpper, 3))).ToString("yyyy-MM-dd HH:mm:ss")
                                    k.Text = k.Text.Trim
                                Else
                                    k.Text = ur.Item(Mid(k.Name.Trim.ToUpper, 3))
                                    k.Text = k.Text.Trim
                                End If
                                ' End If
                            Catch ex As Exception
                                'ne može preko Hresult ne prepoznaje broj greške
                                If CType(ex, System.InvalidCastException).ToString.ToUpper.IndexOf("CONVERSION") >= 0 AndAlso
                                    CType(ex, System.InvalidCastException).ToString.ToUpper.IndexOf("TIMESPAN") >= 0 AndAlso
                                    CType(ex, System.InvalidCastException).ToString.ToUpper.IndexOf("IS NOT VALID") >= 0 Then
                                    Dim ts As TimeSpan = DirectCast(ur.Item(Mid(k.Name.Trim.ToUpper, 3)), TimeSpan)
                                    k.Text = ts.ToString().Substring(0, 5).Trim
                                End If
                            End Try
                        End If
                    End If
                ElseIf TypeOf k Is LinkLabel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 9) = "LINKLABEL" Then   'LinkLabel
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 10)) Is System.DBNull.Value Then
                    Else
                        k.Text = ur.Item(Mid(k.Name.Trim.ToUpper, 10))
                        k.Text = k.Text.Trim
                    End If
                ElseIf TypeOf k Is ComboBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "C" Then
                    TBCB = 1
                    'prvo popuni, pa onda dodela!
                    If SCati = False Then
                        cbpp_popuniPreDodele(CType(k, ComboBox))
                    Else
                        cbpp_popuniPreDodele(CType(k, ComboBox), pane)
                    End If

                    'pa dodela
                    CType(k, ComboBox).SelectedText = ""
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                        CType(k, ComboBox).SelectedIndex = 0
                    Else
                        CType(k, ComboBox).SelectedValue = ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim
                    End If
                ElseIf TypeOf k Is CheckBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "H" Then
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                        CType(k, CheckBox).Checked = False
                    Else
                        If ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim >= "1" Then
                            CType(k, CheckBox).Checked = True

                            If Not nizCHBoxIme Is Nothing AndAlso nizCHBoxIme.Length > 0 AndAlso Not nizCHBoxLabelaBroj Is Nothing AndAlso nizCHBoxLabelaBroj.Length > 0 Then
                                Dim ind As Integer = Array.IndexOf(nizCHBoxIme, k.Name)
                                If ind > -1 Then
                                    nizCHBoxLabelaBroj(ind).Text = ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim
                                End If
                            End If

                        Else
                            CType(k, CheckBox).Checked = False
                        End If
                    End If

                    If Mid(k.Name.Trim.ToUpper, 3).Trim.ToUpper = "URADU" Then
                        'radimo Update u bazi
                        Call postaviURadu(sqlKljuc)
                        CType(k, CheckBox).Checked = True
                        ur.BeginEdit()
                        ur.Item(Mid(k.Name.Trim.ToUpper, 3)) = "1"
                        ur.AcceptChanges()
                    End If

                ElseIf TypeOf k Is DateTimePicker2 AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "U" Then
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                    Else
                        CType(k, DateTimePicker2).Format = DateTimePickerFormat.Short
                        CType(k, DateTimePicker2).Value = ur.Item(Mid(k.Name.Trim.ToUpper, 3))
                    End If
                ElseIf TypeOf k Is Panel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 2) = "RG" Then
                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                    Else
                        If ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim >= "0" Then
                            Call SelectRadio(ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim, k)
                        End If
                    End If
                ElseIf TypeOf k Is TextBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 2) = "FP" Then
                    'k.Text = ur.Item(Mid(k.Name.Trim.ToUpper, 3))
                ElseIf TypeOf k Is DataGridView Then  'datagridovi?
                    If GridOdTabele(k.Name.Trim.ToUpper) Then 'PravaDupeGlava(k.Name.Trim.ToUpper) Then
                        Dim tt As String = k.Name.Trim.ToUpper
                        If Me.NslKljuc Is Nothing Then ' prvi unos
                        Else
                            Me.DGTabele(DGi(tt)).Clear()
                            Me.DGTabeleOriginal(DGi(tt)).Clear()

                            red = Me.DTbl(DGi(tt, DTbl)).Select(sqlNU.Replace("=N'", "='"))
                            nadjen = (red.Length > 0)
                            If nadjen Then
                                For i As Integer = 0 To red.GetUpperBound(0)
                                    DGTabele(DGi(tt)).ImportRow(red(i))
                                    DGTabeleOriginal(DGi(tt)).ImportRow(red(i))
                                Next
                            End If
                        End If
                        CType(k, DataGridView).DataSource = Me.DGTabele(DGi(tt))
                        k.Refresh()
                    End If
                ElseIf TypeOf k Is DataGridView2 Then
                ElseIf TypeOf k Is DataGridView Then
                ElseIf TypeOf k Is Button Then
                Else
                End If 'T ili grid
            End If



            If TBCB = 1 Then
                'READONLY POLJA
                Dim samoCita As String = ""
                Dim nizsamoCita() As String = {}
                Dim samoCitaAKO As String = ""
                Dim nizsamoCitaAKO() As String = {}
                Dim visibleFalse As String = ""
                Dim nizvisibleFalse() As String = {}
                Dim visibleFalseAKO As String = ""
                Dim nizvisibleFalseAKO() As String = {}
                Dim skociNA As String = ""
                Dim nizskociNA() As String = {}
                Dim skociAKO As String = ""
                Dim nizskociAKO() As String = {}
                Dim skociAction As String = ""
                Dim nizskociAction() As String = {}
                Dim skippedEnabledFalse As Boolean = False
                Dim skippedSetEmpty As Boolean = False
                Dim skippedDontSave As Boolean = False
                Dim skippedVisibleFalse As Boolean = False
                Dim visibleTrue As String = ""
                Dim nizvisibleTrue() As String = {}
                Dim visibleTrueAKO As String = ""
                Dim nizvisibleTrueAKO() As String = {}

                Dim plj As String = Mid(k.Name.Trim.ToUpper, 3)
                Dim nizProvera() As String = {}
                Dim pomtxt1 As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
                Dim pomOD As String = ""
                Try
                    pomOD = NZ(dIst.ISTPOLJA.Select(pomtxt1.Replace("=N'", "='"))(0).Item("od")).Trim.ToUpper
                    pomOD = pomOD.Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
                Catch ex As Exception
                    ''msg 42
                    Dim msgtxt42 As String = getMessageText(dtMessages, "42", Me.jezik)
                    ''msg 43
                    Dim msgtxt43 As String = getMessageText(dtMessages, "43", Me.jezik)
                    ''msg 44
                    Dim msgtxt44 As String = getMessageText(dtMessages, "44", Me.jezik)
                    ISTMessageBox.Show(msgtxt42 + nvrd + plj + msgtxt43 + nvrd + msgtxt44 + nvrd + pomtxt1 + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Exit Sub
                End Try

                If pomOD.Length > 0 AndAlso pomOD.Trim.IndexOf("#{") = 0 Then
                    pomOD = pomOD.Replace("#{", "")
                    pomOD = pomOD.Replace("}", "")
                    pomOD = pomOD.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim

                    nizProvera = Split(pomOD, ";")
                    For i As Integer = 0 To nizProvera.GetUpperBound(0)
                        nizProvera(i) = nizProvera(i).Trim.ToUpper
                        If nizProvera(i).IndexOf("READONLY=") = 0 Then
                            samoCita = nizProvera(i).Replace("READONLY=", "")
                            nizsamoCita = Split(samoCita, "$")
                        End If
                        If nizProvera(i).IndexOf("READONLYAKO=") = 0 Then
                            samoCitaAKO = (nizProvera(i).Replace("READONLYAKO=", ""))
                            nizsamoCitaAKO = Split(samoCitaAKO, "$")
                        End If
                        If nizProvera(i).IndexOf("READONLYIF=") = 0 Then
                            samoCitaAKO = (nizProvera(i).Replace("READONLYIF=", ""))
                            nizsamoCitaAKO = Split(samoCitaAKO, "$")
                        End If
                        If nizProvera(i).IndexOf("VISIBLEFALSE=") = 0 Then
                            visibleFalse = (nizProvera(i).Replace("VISIBLEFALSE=", ""))
                            nizvisibleFalse = Split(visibleFalse, "$")
                        End If
                        If nizProvera(i).IndexOf("VISIBLEFALSEIF=") = 0 Then
                            visibleFalseAKO = (nizProvera(i).Replace("VISIBLEFALSEIF=", ""))
                            nizvisibleFalseAKO = Split(visibleFalseAKO, "$")
                        End If
                        If nizProvera(i).IndexOf("VISIBLETRUE=") = 0 Then
                            visibleTrue = (nizProvera(i).Replace("VISIBLETRUE=", ""))
                            nizvisibleTrue = Split(visibleTrue, "$")
                        End If
                        If nizProvera(i).IndexOf("VISIBLETRUEIF=") = 0 Then
                            visibleTrueAKO = (nizProvera(i).Replace("VISIBLETRUEIF=", ""))
                            nizvisibleTrueAKO = Split(visibleTrueAKO, "$")
                        End If

                        If nizProvera(i).IndexOf("SKOCINA=") = 0 Then
                            skociNA = nizProvera(i).Replace("SKOCINA=", "")
                            nizskociNA = Split(skociNA, "$")
                        End If
                        If nizProvera(i).IndexOf("SKOCIAKO=") = 0 Then
                            skociAKO = nizProvera(i).Replace("SKOCIAKO=", "")
                            nizskociAKO = Split(skociAKO, "$")
                        End If
                        If nizProvera(i).IndexOf("SKIPTO=") = 0 Then
                            skociNA = nizProvera(i).Replace("SKIPTO=", "")
                            nizskociNA = Split(skociNA, "$")
                        End If
                        If nizProvera(i).IndexOf("SKIPIF=") = 0 Then
                            skociAKO = nizProvera(i).Replace("SKIPIF=", "")
                            nizskociAKO = Split(skociAKO, "$")
                        End If
                        If nizProvera(i).IndexOf("SKIPACTION=") = 0 Then
                            skociAction = nizProvera(i).Replace("SKIPACTION=", "")
                            nizskociAction = Split(skociAction, "$")
                        End If
                        If nizProvera(i).IndexOf("SKIPPEDENABLEDFALSE") = 0 Then skippedEnabledFalse = True
                        If nizProvera(i).IndexOf("SKIPPEDSETEMPTY") = 0 Then skippedSetEmpty = True
                        If nizProvera(i).IndexOf("SKIPPEDDONTSAVE") = 0 Then skippedDontSave = True
                        If nizProvera(i).IndexOf("SKIPPEDVISIBLEFALSE") = 0 Then skippedVisibleFalse = True

                    Next
                End If

                'READONLY
                If samoCita.Length > 0 Then
                    If samoCitaAKO.Length > 0 Then
                        Call dodelaSamoCita(pane, nizsamoCitaAKO, nizsamoCita, plj, k, GlavnaTabela)
                    End If 'samoCitaAko.Length
                End If 'samoCita.Length

                'VISIBLE FALSE
                If visibleFalse.Length > 0 Then
                    If visibleFalseAKO.Length > 0 Then
                        Call dodelaVisibleFalse(pane, nizvisibleFalseAKO, nizvisibleFalse, plj, k, GlavnaTabela)
                    End If 'visibleFalseAKO.Length
                End If 'visibleFalse.Length

                'VISIBLE TRUE
                If visibleTrue.Length > 0 Then
                    If visibleTrueAKO.Length > 0 Then
                        Call dodelaVisibleTrue(pane, nizvisibleTrueAKO, nizvisibleTrue, plj, k, GlavnaTabela)
                    End If
                End If

            End If 'text box ili CB
        Next 'for kontrole

        pocetnadodelavrednosti = False
    End Sub
