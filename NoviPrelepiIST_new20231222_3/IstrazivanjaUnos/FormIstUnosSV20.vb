            For i As Integer = 0 To nizDeleteFrom.GetUpperBound(0)
                If nizDeleteIF(i) Is Nothing OrElse nizDeleteIF(i).Trim = "" Then
                    ReDim Preserve nizDeleteIF(i)
                    nizDeleteIF(i) = "2=2"
                End If
            Next
        End If

        For i As Integer = 0 To nizDeleteFrom.GetUpperBound(0)
            If nizDeleteFrom(i).IndexOf(",") > 0 Then
                pp = nizDeleteFrom(i).Split(",")
                For ii As Integer = 0 To pp.GetUpperBound(0)
                    Call bbrriissiiDT(nizDeleteIF(i), pp(ii).Trim.ToUpper)
                Next
            Else
                Call bbrriissiiDT(nizDeleteIF(i), nizDeleteFrom(i).Trim.ToUpper)
            End If
        Next
    End Sub

    Sub bbrriissiiDT(ByVal sql As String, ByVal name As String)
        Dim dt As DataTable = DGTabele(DGi(name))
        sql = SrediPMGK(sql)
        sql = ZameniGGGMMMUnos(sql)
        Dim zzz As String = sracunajIzraz(sql, Nothing, Nothing)
        zzz = razCASTi(zzz)
        Dim a As Integer = scompute(zzz, name, "DELETEFROM=")
        If a = 1 Then dt.Clear()
    End Sub

