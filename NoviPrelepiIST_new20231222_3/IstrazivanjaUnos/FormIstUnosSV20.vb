        ElseIf TypeOf k Is ComboBox AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "C" AndAlso Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("NE;") < 0 Then
            CType(k, ComboBox).Enabled = True
        ElseIf TypeOf k Is DateTimePicker2 AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "U" AndAlso k.AccessibleName Is Nothing Then
