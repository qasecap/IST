    Sub addSHH(ByVal k As Control, ByVal nizskociAkosss As String)

        If k.AccessibleName Is Nothing OrElse k.AccessibleName.IndexOf("SkipWithDontSaveCondition") < 0 Then
            k.AccessibleName = k.AccessibleName + "SkipWithDontSaveCondition" + nizskociAkosss.Trim + ";"
        End If

    End Sub

    Sub sskoci2panelRESET(ByVal panel As Panel, ByVal cntl As Control, ByVal nizskociNAsss As String)

        Dim dppRBR As Integer
        If Not cntl.AccessibleDescription Is Nothing Then dppRBR = cntl.AccessibleDescription.Split(";")(0)

        Dim nizskociNAsssrbr As Integer

        For Each k As Control In panel.Controls
            If (TypeOf k Is TextBox AndAlso Mid(k.Name, 2, 1) <> "F") OrElse TypeOf k Is ComboBox Then
                If Mid(k.Name, 4).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    nizskociNAsssrbr = krbr
                    Exit For
                End If
            End If
        Next

        If nizskociNAsssrbr = 0 Then  'NIJE ISPUNJEN USLOV  'nije obicno polje, nego button
            For Each k As Control In panel.Controls
                If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox Then
                    Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                    If dppRBR < trenutniRBR Then 'sve od polja sa koga skace pa do kraja ide u ovo dole
                        'enabluj sva polja posle onog na koje skaces
                        If Mid(k.Name, 2, 1) <> "F" Then k.Enabled = True 'da ostanu fp
                        'k.Visible = True
                        If Mid(k.Name, 1, 3) <> "DRP" Then k.Visible = True  'remark da ostanu visiblefalse
                    End If
                End If
            Next
        End If

        If nizskociNAsssrbr > 0 Then  'NIJE ISPUNJEN USLOV
            Dim minrbr As Integer = 1000000000
            'Dim pomk As Control
            For Each k As Control In panel.Controls
                'treba ponistiti sve između plj i nizskociNAsss (ako je nizskociNAsss nije dugme ili panel)
                If (TypeOf k Is TextBox AndAlso Mid(k.Name, 2, 1) <> "F") OrElse TypeOf k Is ComboBox Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    If dppRBR < krbr AndAlso krbr < nizskociNAsssrbr Then
                        'enejbluj sva polja posle onog na koje skaces
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") < 0 Then k.Enabled = True
                        If k.AccessibleName Is Nothing Then k.Enabled = True
                        If Mid(k.Name, 1, 3) <> "DRP" Then k.Visible = True  'remark da ostanu visiblefalse
                        If krbr < minrbr Then minrbr = krbr ': pomk = k
                    End If
                End If

                If (TypeOf k Is TextBox AndAlso Mid(k.Name, 2, 1) = "F") Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    If dppRBR < krbr AndAlso krbr < nizskociNAsssrbr Then
                        If k.Visible = False AndAlso k.Tag.izraz <> "''" Then
                            k.Visible = True
                        End If
                    End If
                End If
            Next            'If skippedSetEmpty = True  NE MOZE DA SE opozove
            'If Not pomk Is Nothing Then pomk.Focus()
        End If

    End Sub

