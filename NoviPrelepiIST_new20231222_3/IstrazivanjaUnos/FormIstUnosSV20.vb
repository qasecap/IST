    Private Sub BtnSendEMail_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles BtnSendEMail.Click

        Dim folder As String = ""
        If txtmode.IndexOf("Z") = 0 OrElse txtmode.IndexOf("ZCAPI") = 0 Then
            folder = GetTXTDir() + CType(dIst.IST.Rows(0), DataRow).Item("sifist").trim
        Else
            folder = CType(dIst.IST.Rows(0), DataRow).Item("txtdir").trim
        End If

        'Dim folder As String = CType(dIst.IST.Rows(0), DataRow).Item("txtdir").trim
        Dim sApp As Microsoft.Office.Interop.Outlook._Application
        sApp = New Microsoft.Office.Interop.Outlook.Application

        Dim sMsg As Microsoft.Office.Interop.Outlook._MailItem
        sMsg = sApp.CreateItem(Microsoft.Office.Interop.Outlook.OlItemType.olMailItem)

        'subject
        If (System.IO.File.Exists(folder + "\SENDEMAIL\" + "subject.txt")) Then
            Dim txtSubject As New System.IO.StreamReader(folder + "\SENDEMAIL\" + "subject.txt")
            Dim strSubject As String = txtSubject.ReadToEnd
            sMsg.Subject = strSubject
            txtSubject.Close()
        Else
            ''msg 333
            Dim msgtxt As String = getMessageText(dtMessages, "333", Me.jezik) + nvrd
            ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End If

        If (System.IO.File.Exists(folder + "\SENDEMAIL\" + "Body.txt")) Then
            Dim txtBody As New System.IO.StreamReader(folder + "\SENDEMAIL\" + "Body.txt")
            Dim strBody As String = txtBody.ReadToEnd
            sMsg.Body = strBody & vbCr & vbCr
            txtBody.Close()
        Else
            ''msg 334
            Dim msgtxt As String = getMessageText(dtMessages, "334", Me.jezik) + nvrd
            ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End If

        Dim c As Control = NadjiKontroluSkr(Panel1, "EMAIL", 2)
        If TypeOf c Is TextBox Then sMsg.To = CType(c, TextBox).Text.Trim

        Dim sBodyLen As String = sMsg.Body.Length
        Dim sAttachs As Microsoft.Office.Interop.Outlook.Attachments = sMsg.Attachments
        Dim sAttach As Microsoft.Office.Interop.Outlook.Attachment
        If (System.IO.Directory.Exists(folder + "\SENDEMAIL")) Then
            For i As Integer = 0 To System.IO.Directory.GetFiles(folder + "\SENDEMAIL").Length - 1
                Dim fn As String = System.IO.Directory.GetFiles(folder + "\SENDEMAIL")(i).Replace(folder + "\SENDEMAIL\", "")
                If System.IO.File.Exists(System.IO.Directory.GetFiles(folder + "\SENDEMAIL")(i)) AndAlso fn.Trim.ToLower <> "subject.txt" AndAlso fn.Trim.ToLower <> "body.txt" Then
                    sAttach = sAttachs.Add(System.IO.Directory.GetFiles(folder + "\SENDEMAIL")(i), , sBodyLen + i, fn)
                End If
            Next
        Else
            ''msg 98
            Dim msgtxt As String = getMessageText(dtMessages, "98", Me.jezik) + nvrd
            ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End If

        sMsg.Display()
        'sMsg.Send()
        'Clean up
        sApp = Nothing
        sMsg = Nothing
        sAttach = Nothing
        sAttachs = Nothing
    End Sub

    Dim cursorX, CursorY As Integer
