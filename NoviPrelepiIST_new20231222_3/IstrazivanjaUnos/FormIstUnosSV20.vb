                        panel.VerticalScroll.Visible = False
                    End If
                    If panel.AccessibleName.Trim.ToUpper.IndexOf("HORIZONTALSCROLLVISIBLEFALSE") >= 0 Then
                        panel.HorizontalScroll.Maximum = 0
                        panel.HorizontalScroll.Visible = False
                    End If
                End If
                If ap = 1 Then panel.AutoScroll = True
            End If
        Catch ex As Exception
            ISTMessageBox.Show(ex.Message)
        End Try

        If fs <> panel.Font.Size Then
            For Each mm As Control In panel.Controls
                mm.Font = New Font(Me.Font.Name, fs)
