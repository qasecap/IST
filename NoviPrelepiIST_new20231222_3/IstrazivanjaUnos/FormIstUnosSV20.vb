    Function rreadOnlyIZKLJUCA(ByVal nizsamoCitasss As String, ByVal nizsamoCitaAKOsss As String, ByVal plj As String) As Boolean
        'readOnyl POLJA
        rreadOnlyIZKLJUCA = False
        Dim tabela As String = GlavnaTabela
        Dim pomKol4 As New DataColumn("pomKol4")
        Dim bbb() As String = razkvantaj(nizsamoCitaAKOsss)
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            If bbb(ll).Trim = plj Then
                If SEK(plj).Trim = "" Then
                    bbb(ll) = "Null"
                Else
                    bbb(ll) = "'" + SEK(plj).Trim + "'"
                End If
            End If
            If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                'sa ekrana pokupi fiktivno polje
                Dim ind As Integer = Array.IndexOf(nizFPime, bbb(ll).Replace("#FP{", "").Replace("}", "").Trim)
                If ind > -1 Then bbb(ll) = "'" + SE(bbb(ll).Substring(4), True, nizFP(ind).Parent).Trim + "'"
            End If
            If bbb(ll).Trim.ToUpper.IndexOf("D.") = 0 Then
                bbb(ll) = bbb(ll).Trim.ToUpper.Replace("D.", "")
                If SEK(bbb(ll)).Trim = "" Then
                    bbb(ll) = "Null"
                Else
                    bbb(ll) = "'" + SEK(bbb(ll)).Trim + "'"
                End If
            End If
        Next
        Dim zzz As String = ustringaj(bbb).ToUpper
        Dim a As Integer = scompute(zzz, plj, "readonlyif")       '1 TRUE, 0 FALSE
        If a = 1 Then rreadOnlyIZKLJUCA = True

        If nizsamoCitasss.Length > 0 Then
            Dim trtniz As String() = Split(nizsamoCitasss, ",")
            For i As Integer = 0 To trtniz.GetUpperBound(0)

                If trtniz(i).IndexOf("TABELA") = 0 OrElse trtniz(i).IndexOf("TABLE") = 0 Then trtniz(i) = trtniz(i).Replace("TABELA", "BTN")

                Dim kp As Control = NadjiKontroluKojaNijeLABELAiNijeFP(Me.Panel1, trtniz(i).Trim.ToUpper)
                If Not kp Is Nothing Then
                    If a = 1 Then kp.Enabled = False : kp.AccessibleName = kp.AccessibleName + "RO;"
                    If a = 0 Then kp.Enabled = True : If Not kp.AccessibleName Is Nothing Then kp.AccessibleName = kp.AccessibleName.Trim.ToUpper.Replace("RO;", "")

                    kp = NadjiKontroluSkrKojaJeBUTTON(Me.Panel1, trtniz(i).Trim.ToUpper)
                    If Not kp Is Nothing Then
                        If a = 1 Then kp.Enabled = False : kp.AccessibleName = kp.AccessibleName + "RO;"
                        If a = 0 Then kp.Enabled = True : If Not kp.AccessibleName Is Nothing Then kp.AccessibleName = kp.AccessibleName.Trim.ToUpper.Replace("RO;", "")
                    End If
                End If

            Next
        End If


    End Function

