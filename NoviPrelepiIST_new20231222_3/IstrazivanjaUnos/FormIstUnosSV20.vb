    Private Sub PopuniJosZaPoljaPanel(ByVal tabela As String, ByVal panel As Panel, Optional ByVal plusOdStarta As Boolean = False,
                Optional ByVal odakle As String = "", Optional ByVal autoList As Boolean = False)
        Dim glavnatabela As String = tabela
        Dim MenjanKljuc As Boolean = False
        Dim JzP As JosZaPolje1
        For i As Integer = 0 To JosZaPoljaP.GetUpperBound(0)
            JzP = JosZaPoljaP(i)
            If JosZaPoljaPkojiPanel(i).Trim.ToUpper = panel.Name.Trim.ToUpper Then
                If (SP(JzP.Polje, panel) Is Nothing) OrElse (SP(JzP.Polje, panel).Trim) = "" Then
                    If Not JzP.DG Is Nothing AndAlso (JzP.DG = "{+}" OrElse JzP.DG = "{+FPP}" OrElse JzP.DG.IndexOf("{+END") = 0) Then
                        Dim pom As String = ""
                        If plusOdStarta = False Then
                            '****
                            Dim pomkol As DataColumn = DGTabele(DGi(tabela)).Columns.Add("pomkol", Type.GetType("System.Int32"))
                            pomkol.Expression = JzP.Polje.Replace("N'", "'")
                            If DGTabele(DGi(glavnatabela)).Rows.Count > 0 Then
                                pom = Str(NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol)", "")) + 1).Trim
                                DGTabele(DGi(tabela)).Columns.Remove(pomkol)
                            Else
                                pom = Str(Val(JzP.vrednost) + 1).Trim
                            End If
                            '****
                        Else

                            If autoList = True Then
                                pom = Str(Val(odakle)).Trim
                            Else
                                pom = Str(Val(odakle) + 1).Trim
                            End If

                        End If
                        'dodaj vodece nule ako je definisano kao char i ako ima duzinu
                        Dim pomtxt As String = "tabela='" & glavnatabela.Trim & "' and polje='" & JzP.Polje.Trim.ToUpper & "'"
                        Dim pommduz As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("duzina")).Trim.ToUpper
                        If pommduz = "" Then pommduz = 0
                        Dim pommtip As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("tip")).Trim.ToUpper
                        If pommduz <> "001" And Val(pommduz) > 0 Then
                            If (pommtip = "CHAR" Or pommtip = "STRING" Or pommtip = "TEXT") Then
                                While pom.Trim.Length < pommduz
                                    pom = "0" + pom
                                End While
                            End If
                        End If
                        '
                        NaP(JzP.Polje, panel, pom, MenjanKljuc)
                        JzP.vrednost = pom
                    Else
                        NaP(JzP.Polje, panel, JzP.vrednost, MenjanKljuc)
                    End If
                    If JzP.DG = "{+FPP}" Then plusPK = True

                End If
            End If
        Next
    End Sub

    Private Function PrazanKljuc() As Boolean
        Dim pom As Boolean = True
        For Each k1 As Control In Me.Controls
            If Mid(k1.Name.Trim.ToUpper, 1, 1) = "G" Then
                For Each k As Control In k1.Controls
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "T" Or Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Or Mid(k.Name.Trim.ToUpper, 1, 1) = "U" Then
                        pom = pom And k.Text.Trim <> Nothing
                    End If
                Next
            End If
        Next
        Return (Not pom)
    End Function

    Private Function InsertNOVO(saDateUser As Boolean, ByVal tabela As String, ByVal sqlKljuc As String, Optional ByVal seVOD1 As String = "", Optional ByVal seVDO1 As String = "", Optional ByVal staVODVDO As Integer = -1) As Boolean

        InsertNOVO = False

        Dim anketarZ As String = ""
        Dim koSam As String = ""
        Dim txtcloudcati As Boolean = False
        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse
                    txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode.Trim.ToUpper = "MIXMODECAPIDESKTOP" Then   'može i testcapi
            koSam = GetUserNameCAPI(Me.ISTConnectionString, Me.jezik)
        ElseIf txtmode.Trim.ToUpper = "ZCAPI" OrElse txtmode.Trim.ToUpper = "Z" Then
            koSam = GetUserNameZ()
            anketarZ = koSam.Trim
        ElseIf anketarCATIcloud <> "" OrElse txtmode.Trim.ToUpper = "CLOUD" Then
            koSam = anketarCATIcloud
            txtcloudcati = True
        ElseIf anketarCATI <> "" Then
            koSam = anketarCATI
            txtcloudcati = True
        Else
            'koSam = GetUserName()
            koSam = GetUserNameIzBaze(Me.DBConnectionString)
        End If

        '/////////////////////////////////////////////  'SKLONI NA SKLOPIUNOS, VIDI DA NE POREMETIS SAVE KOD AZURIRANJA!!!!!!!!!!!!!!!!!!!!
        Dim poljaTabeleKojaNisuKljuc As String = "$"
        Dim poljaTabeleKojaSuKljuc As String = "$"
        Dim poljaTabeleKojaSeKriptuju As String = "$"

        For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If p.TABELA.Trim.ToUpper = tabela Then
                If (p.IsKLJUCNull OrElse p.KLJUC.Trim.ToUpper <> "P") Then
                    poljaTabeleKojaNisuKljuc = poljaTabeleKojaNisuKljuc + p.POLJE.Trim.ToUpper + "$"
                ElseIf (p.IsKLJUCNull = False AndAlso p.KLJUC.Trim.ToUpper = "P") Then
                    poljaTabeleKojaSuKljuc = poljaTabeleKojaSuKljuc + p.POLJE.Trim.ToUpper + "$"
                End If
                If p.IsIzrazNull = False AndAlso p.Izraz.Trim.ToUpper.IndexOf("ENCRYPT") >= 0 Then
                    poljaTabeleKojaSeKriptuju = poljaTabeleKojaSeKriptuju + p.POLJE.Trim.ToUpper + "$"
                End If
            End If
        Next
        If Not DGTabele(DGi(tabela)).Columns("istnote") Is Nothing Then
            poljaTabeleKojaNisuKljuc = poljaTabeleKojaNisuKljuc + "ISTNOTE" + "$"
        End If
        '/////////////////////////////////////////////
        Dim preskociPolja2 As String = "$DATUM_UPDATE$DATE_UPDATE$KO_UPDATE$USER_UPDATE$DATE_REVIEW$USER_REVIEW$LK$LKWEB$DATE_LKZ$DATE_LKO$USER_LKZ$USER_LKO$DATE_LKZWEB$DATE_LKOWEB$USER_LKZWEB$USER_LKOWEB$DATE_REVIEW$USER_REVIEW$"

        Dim dt As DataTable = DGTabele(DGi(tabela))
        Dim dtP As DataTable = DGTabeleOriginal(DGi(tabela))
        Dim dtr As DataRow = DGTabele(DGi(tabela)).Select(sqlKljuc.Replace("=N'", "='"))(0)

        Dim s1 As String = ""
        Dim s2 As String = ""
        For Each dtrc As DataColumn In dt.Columns
            Dim plj As String = dtrc.ColumnName.Trim.ToUpper
            Dim tip As String = dtrc.DataType.Name
            Dim vred As String = ""
            If dtrc.Prefix.Trim.ToUpper <> "GRIDADDEDCOLUMN" AndAlso preskociPolja2.IndexOf("$" + plj + "$") < 0 Then
                If plj = "CAPIEXPORTED" Then
                    vred = "0"
                ElseIf plj = "COMPUTERNAME" Then
                    vred = "'" & System.Environment.MachineName & "'"
                ElseIf plj = "DATUM_INSERT" Then
                    vred = "(Convert([varchar], getdate(), (113)))"
                    If saDateUser = True Then dtr.Item("DATUM_INSERT") = Date.Now.ToString("yyyy-MM-dd HH:mm:ss")
                ElseIf plj = "DATE_INSERT" Then
                    vred = "(Convert([varchar], getdate(), (113)))"
                    If saDateUser = True Then dtr.Item("DATE_INSERT") = Date.Now.ToString("yyyy-MM-dd HH:mm:ss")
                ElseIf plj = "KO_INSERT" Then
                    vred = "suser_sname()"
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then vred = "'" + koSam + "'"
                    If anketarCATI <> "" Then vred = "'" + koSam + "'"
                    If saDateUser = True Then dtr.Item("KO_INSERT") = koSam
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then dtr.Item("KO_INSERT") = koSam
                    If anketarCATI <> "" Then dtr.Item("KO_INSERT") = koSam
                    If anketarZ <> "" Then
                        vred = "'" + koSam + "'"
                        dtr.Item("KO_INSERT") = koSam
                    End If
                ElseIf plj = "USER_INSERT" Then
                    vred = "suser_sname()"
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then vred = "'" + koSam + "'"
                    If anketarCATI <> "" Then vred = "'" + koSam + "'"
                    If saDateUser = True Then dtr.Item("USER_INSERT") = koSam
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then dtr.Item("USER_INSERT") = koSam
                    If anketarCATI <> "" Then dtr.Item("USER_INSERT") = koSam
                    If anketarZ <> "" Then
                        vred = "'" + koSam + "'"
                        dtr.Item("USER_INSERT") = koSam
                    End If
                ElseIf plj = "ODAKLE_INSERT" Then
                    vred = "'I'"
                ElseIf plj = "SOURCEOF_INSERT" Then
                    vred = "'I'"
                ElseIf plj = "USER_START" Then
                    vred = "suser_sname()"
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then vred = "'" + koSam + "'"
                    If anketarCATI <> "" Then vred = "'" + koSam + "'"
                    If saDateUser = True Then dtr.Item("USER_START") = koSam
                    If (anketarCATIcloud <> "" OrElse txtcloudcati = True) Then dtr.Item("USER_START") = koSam
                    If anketarCATI <> "" Then dtr.Item("USER_START") = koSam
                    If anketarZ <> "" Then
                        vred = "'" + koSam + "'"
                        dtr.Item("USER_START") = koSam
                    End If
                ElseIf plj = "DATE_START" Then
                    vred = "(Convert([varchar], '" + IstStart(DGi(tabela)).ToString("yyyy-MM-dd HH:mm:ss") + "', (113)))"
                    If saDateUser = True Then dtr.Item("DATE_START") = IstStart(DGi(tabela)).ToString("yyyy-MM-dd HH:mm:ss")
                ElseIf plj = "IST_DURATION" Then
                    Dim IstDuration As Integer
                    Dim CurrentTime As DateTime = DateTime.Now()
                    IstDuration = IIf(Convert.IsDBNull(dtr.Item(plj)), 0, dtr.Item(plj))
                    vred = "'" & CStr(IstDuration) & "'"
                    If saDateUser = True Then dtr.Item("IST_DURATION") = CStr(IstDuration)
                ElseIf plj = "ISTNOTE" Then
                    vred = "N'" & CStr(IIf(Convert.IsDBNull(dtr.Item(plj)), "", dtr.Item(plj))) & "'"
                ElseIf dtr.Item(plj) Is System.DBNull.Value Then
                    vred = "Null"
                ElseIf poljaTabeleKojaSeKriptuju.IndexOf("$" + plj + "$") >= 0 Then
                    vred = IIf(Convert.IsDBNull(dtr.Item(plj)), "''", dtr.Item(plj))
                    If vred.Trim = "''" Then
                    ElseIf vred.Trim = "" Then
                        vred = "''"
                    Else
                        'Nevena 08082022
                        'vred = "N'" & CryptoReader.AesCrypt.EncryptStringAES(dtr.Item(plj).ToString) & "'"
                        If IsBase64String(dtr.Item(plj).ToString) = False Then
                            vred = "N'" & Kripto(dtr.Item(plj).ToString, DBConnectionString, Me.jezik) & "'"
                        Else
                            vred = "N'" & dtr.Item(plj).ToString & "'"
                        End If

                    End If
                ElseIf tip = "Boolean" Then
                    vred = "1"
                    If dtr.Item(plj) = False Then vred = "0"
                ElseIf tip = "DateTime" Then
                    vred = "'" & CDate(dtr.Item(plj)).ToString("yyyy-MM-dd HH:mm:ss").Trim & "'"
                ElseIf tip = "Date" Then
                    vred = "'" & CDate(dtr.Item(plj)).ToString("yyyy-MM-dd").Trim & "'"
                ElseIf tip = "Time" OrElse tip = "TimeSpan" Then
                    vred = "'" & dtr.Item(plj).ToString.Trim & "'"
                ElseIf tip = "String" OrElse tip = "char" Then
                    vred = "N'" & Replace(dtr.Item(plj).ToString.Trim, "'", "''") & "'"
                ElseIf tip = "Int32" Then
                    vred = " CAST('" & dtr.Item(plj) & "' AS INTEGER) "
                ElseIf tip = "Int64" Then
                    vred = " CAST('" & dtr.Item(plj) & "' AS BIGINT) "
                ElseIf tip = "Int16" Then
                    vred = " CAST('" & dtr.Item(plj) & "' AS INTEGER) "
                Else
                    vred = " CAST('" & dtr.Item(plj).ToString.Trim.Replace(",", ".") & "' AS FLOAT) " 'da bi radili i float-ovi
                    'Else
                    'vred = dtr.Item(plj).ToString.Trim
                End If
                s1 = s1 + plj + ","
                s2 = s2 + vred + ","
            End If
        Next
        s1 = s1.TrimEnd(",")
        s2 = s2.TrimEnd(",")

        If staVODVDO = 3 OrElse staVODVDO = 4 Then
            s2 = s2.Replace(seVOD1, vredVPVODF2)
            s2 = s2.Replace(seVDO1, vredVPVDOF2)
        End If

        Dim sqlInsert As String = "insert into " + tabela + "(" + s1 + ") values(" + s2 + ")"

        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode = "CLOUD" Then   'može i testcapi
            sqlInsert = sqlInsert.Replace("suser_sname()", "'" + koSam + "'")
        End If

        Dim ok As String = izvrsiSQL(sqlInsert, Me.DBConnectionString)
        If ok = "ok" Then
            InsertNOVO = True
            Me.sacuvano = True
            DGTabeleOriginal(DGi(tabela)).Clear()
            DGTabeleOriginal(DGi(tabela)).ImportRow(DGTabele(DGi(tabela)).Select(sqlKljuc.Replace("=N'", "='"))(0))
            If Not DTbl Is Nothing Then DTbl(DGi(tabela)).ImportRow(DGTabele(DGi(tabela)).Select(sqlKljuc.Replace("=N'", "='"))(0))

        Else
            ISTMessageBox.Show(sqlInsert + nvrd + nvrd + "is not executed! ER5", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
        End If

    End Function


