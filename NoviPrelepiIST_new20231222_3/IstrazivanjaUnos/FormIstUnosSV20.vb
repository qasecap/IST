                If SCati = False Then
                    cbpp_popuniPreDodele(CType(k, ComboBox))
                Else
                    cbpp_popuniPreDodele(CType(k, ComboBox), pane)
                End If

                'pa dodela
                CType(k, ComboBox).SelectedText = ""
                If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
