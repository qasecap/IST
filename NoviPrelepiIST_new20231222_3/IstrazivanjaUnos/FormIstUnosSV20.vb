    Sub oslobodiDisablovaneKontrole(ByVal panel As Panel)
        For Each c As Control In panel.Controls
            If c.Name.ToString.Trim.Length >= 2 AndAlso (c.Name.Substring(0, 2).ToUpper = "TP" OrElse c.Name.Substring(0, 2).ToUpper = "CB" OrElse c.Name.Substring(0, 2).ToUpper = "UP") Then
                Call enabledTrue(c)
            End If
            If c.Name.ToString.Trim.Length >= 3 AndAlso c.Name.Substring(0, 3).ToUpper = "BTN" Then
                Call enabledTrue(c)
            End If
            If c.Name.ToString.Trim.Length >= 2 AndAlso (c.Name.Substring(0, 2).ToUpper = "RG" OrElse c.Name.Substring(0, 2).ToUpper = "HH") Then
                Call enabledTrueRG(c)
            End If
        Next
    End Sub

    Sub enabledTrue(ByVal c As Control)
        If Not c.AccessibleName Is Nothing AndAlso c.AccessibleName.Trim.ToUpper.IndexOf("NE;") < 0 Then
            If Not TypeOf c Is Button Then c.BackColor = SystemColors.ControlLightLight
            c.Enabled = True
        ElseIf c.AccessibleName Is Nothing Then
            If Not TypeOf c Is Button Then c.BackColor = SystemColors.ControlLightLight
            c.Enabled = True
        End If
    End Sub

    Sub enabledTrueRG(ByVal c As Control)
        If Not c.AccessibleName Is Nothing AndAlso c.AccessibleName.Trim.ToUpper.IndexOf("NE;") < 0 Then
            c.BackColor = RGBColors.mBackColor
            c.Enabled = True
        ElseIf c.AccessibleName Is Nothing Then
            c.BackColor = RGBColors.mBackColor
            c.Enabled = True
        End If
    End Sub

    Private Sub pk_Validating(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)
        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub

        Dim tbox As Control = sender
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 3)
        Dim autb As Boolean = False : Dim autbDB As Boolean = False
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB;") >= 0 Then autb = True
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTBDB;") >= 0 Then autbDB = True
        If autb = True OrElse autbDB = True Then
            tbox = CType(sender, AutoCompleteTextbox)
        Else
            tbox = CType(sender, TextBox)
        End If

        mouseleavePOLJE = tbox
        mouseleavePanel = Nothing
        Dim nval As Boolean = False

        If SCati = True Then
            nval = nepotrebnavalidacijaCATI
        End If
        If autb = True OrElse autbDB = True Then
            nval = DirectCast(tbox, AutoCompleteTextbox).nepotrebnavalidacija
        Else
            nval = nepotrebnavalidacija
        End If

        If nval = False Then
            Call pk_Validacija(sender, e)
        ElseIf nval = True Then
            tbox.BackColor = bojaPocTextbox
        End If
    End Sub

    Function vratiDTIzKAR(ByVal tbox As TextBox) As DataTable
        Dim trttagrel1 As String = tbox.Tag.rel(1)
        If CStr(trttagrel1).Trim.ToUpper.IndexOf("#FP{") >= 0 Then trttagrel1 = zameniFP(trttagrel1)
        If trttagrel1.Trim.ToUpper.IndexOf("SELECT") < 0 Then 'nema SELECT uz R
            If DGi(trttagrel1, PTabele) = -1 Then
                Try
                    NapuniPTabele(tbox.Tag.Rel(0), trttagrel1, tbox.Tag.Tip, tbox.Tag.Apolja, tbox.Tag.Tpolja)
                Catch ex As Exception
                    vratiDTIzKAR = Nothing
                End Try
            End If
            vratiDTIzKAR = PTabele(DGi(trttagrel1, PTabele))
        Else
            'napuni ddd sa onim sql sto je u  tbox.Tag.Rel(1)
            'prvo zameni ako postoji D.
            trttagrel1 = tbox.Tag.Rel(1).trim
            If CStr(trttagrel1).Trim.ToUpper.IndexOf("#FP{") >= 0 Then trttagrel1 = zameniFP(trttagrel1)
            If trttagrel1.Trim.ToUpper.IndexOf("D.") > 0 Then
                Dim aaa() As String = razkvantaj(trttagrel1.Trim)
                For i As Integer = 0 To aaa.Length() - 1
                    If aaa(i).Length() > 1 AndAlso aaa(i).Substring(0, 2).ToUpper = "D." Then
                        Dim pljF As String = aaa(i).Replace("D.", "").Trim.ToUpper
                        Dim qq As String
                        qq = SEK(pljF)
                        aaa(i) = "N'" + qq + "'"
                    End If
                Next
                trttagrel1 = ustringaj(aaa).Trim

            End If
            vratiDTIzKAR = izvrsiSQLvratiDT(trttagrel1, Me.DBConnectionString, Me.jezik)
        End If
    End Function
    Sub IsprazniPKAUTB(ByVal plj As String)
        Dim pp() As String = actbFilterKljuc.Split(";")
        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim mm() As String = pp(i).Trim.ToUpper.Split("=")
            If mm(1) = plj Then
                Dim ind As Integer = Array.IndexOf(nizPKAUTBKontrolaIme, mm(0).Trim.ToUpper)
                Dim autb As AutoCompleteTextbox
                If ind > -1 Then
                    autb = nizPKAUTBKontrola(ind)
                    autb.Text = ""
                    autb.sselectedText = ""
                    autb.sselectedValue = ""
                    Call IsprazniPKAUTB(mm(0).Trim.ToUpper)
                End If
            End If
        Next
    End Sub

    Sub IsprazniAUTB(ByVal plj As String)
        Dim pomocno As String = actbFilter
        pomocno = pomocno.TrimEnd(";")
        Dim pp() As String = pomocno.Split(";")
        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim mm() As String = pp(i).Trim.ToUpper.Split("=")
            If mm(1) = plj Then
                Dim ind As Integer = Array.IndexOf(nizAUTBKontrolaIme, mm(0).Trim.ToUpper)
                Dim autb As AutoCompleteTextbox
                If ind > -1 Then
                    autb = nizAUTBKontrola(ind)
                    autb.Text = ""
                    autb.sselectedText = ""
                    autb.sselectedValue = ""
                    autb.assignvalue = ""
                    Call ddodelaAutoComplete(autb, Mid(autb.Name, 3), autb.Parent)
