            If vju = True Then Exit Function

            'ByVal gkljc As String
            existChangeSomewhereInQuest = False

            If nnnadjenPoslednjaProveraPredUpis(GlavnaTabela, gkljc) Then
                Dim cc As Long = 0
                If Not (DGTabele(DGi(GlavnaTabela)).Columns("IST_DURATION") Is Nothing) Then
                    If glavna = False Then
                        cc = CLng(IIf(Convert.IsDBNull(DGTabele(DGi(GlavnaTabela)).Select(gkljc.Replace("=N'", "='"))(0).Item("IST_DURATION")), 0, DGTabele(DGi(GlavnaTabela)).Select(gkljc.Replace("=N'", "='"))(0).Item("IST_DURATION")).ToString.Trim)
                    Else
                        cc = CLng(IIf(Convert.IsDBNull(DGTabele(DGi(GlavnaTabela)).Select(gkljc.Replace("=N'", "='"))(0).Item("IST_DURATION")), 0, DGTabele(DGi(GlavnaTabela)).Select(gkljc.Replace("=N'", "='"))(0).Item("IST_DURATION")).ToString.Trim)
