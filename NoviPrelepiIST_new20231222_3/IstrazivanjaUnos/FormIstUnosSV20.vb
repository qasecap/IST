    Sub zapamtiPrenesenaPoljaIZAdresara(Optional pp As Panel = Nothing)

        Dim panel As Panel = Me.Panel1

        If Not pp Is Nothing Then panel = pp
        'ako je dgtabele null, a u tpolju ima nešto upiši u dgtabele
        'slućaj postoji samo ako je imao dodelu iz adresara a nije prošao kroz polja da potvrdi
