    Private Function OdradiGreske(ByVal polja() As String) As Boolean
        Dim GrNiz() As String = {}
        If polja.GetUpperBound(0) = 0 Then
            ReDim GrNiz(0)
            GrNiz = Me.GreskeZaPolje(polja(0), , True)
        Else
            For i As Integer = 0 To polja.GetUpperBound(0)
                Dim gg() As String = Me.GreskeZaPolje(polja(i), , True)
                For j As Integer = 0 To gg.GetUpperBound(0)
                    If Array.IndexOf(GrNiz, gg(j)) = -1 Then
                        ReDim Preserve GrNiz(1 + GrNiz.GetUpperBound(0))
                        GrNiz(GrNiz.GetUpperBound(0)) = gg(j)
                    End If
                Next
            Next
        End If
        'ovo prilicno glupo, ali nekako mi jeftinije da popunim i posle ispraznim "glavnu tabelu" nego da to nekako drugacije radim...
        Me.DGTabele(DGi(GlavnaTabela)).Rows.Add(Me.DGTabele(DGi(GlavnaTabela)).NewRow)

        For Each s As String In Me.GlavniKljuc
            'UpisiPolje(s, SEK(s),, Panel1)
            UpisiPolje(s, SEK(s))
        Next
        '********************Goran

        If grupePitanjaCAPI Is Nothing Then
            For Each c As Control In Me.Panel1.Controls
                If c.Name.Trim.Length > 2 AndAlso
                            (c.Name.Substring(0, 2).ToUpper = "TP" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "CB" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "RB" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "UP" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "HH") Then
                    Dim cIme As String = c.Name.Trim.ToUpper.Substring(2)
                    UpisiPolje(cIme, SE(cIme), c.Name.Substring(0, 2).ToUpper)
                End If
            Next
        Else
            For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                For Each c As Control In grupePitanjaCAPI(i).Controls
                    If c.Name.Trim.Length > 2 AndAlso
                            (c.Name.Substring(0, 2).ToUpper = "TP" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "CB" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "RB" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "UP" _
                            OrElse c.Name.Substring(0, 2).ToUpper = "HH") Then
                        Dim cIme As String = c.Name.Trim.ToUpper.Substring(2)
                        UpisiPolje(cIme, SE(cIme,, c.Parent), c.Name.Substring(0, 2).ToUpper, grupePitanjaCAPI(i))
                    End If
                Next
            Next
        End If

        '********************Goran
        'OdradiGreske UVEK se radi na izlazak iz polja koje pripadaju kljucu
        Dim mrt As Boolean = False
        'If GrNiz.Length > 0 Then 'OVO OVDE NE TREBA NIKAKO DA BUDE, U PANELU TREBA
        mrt = UradiLK(GrNiz)
        PrikaziLK()
        DGTabele(DGi(GlavnaTabela)).Clear() 'jer ce tek ELGaIma da ga napuni
        Return mrt
    End Function

    Private Function OdradiGreskePanel(ByVal polja() As String, ByVal tabela As String, ByVal panel As Panel) As Boolean

        Dim GrNiz() As String = {}
        If polja.GetUpperBound(0) = 0 Then
            ReDim GrNiz(0)
            GrNiz = Me.GreskeZaPolje(polja(0), tabela, True)
        Else
            For i As Integer = 0 To polja.GetUpperBound(0)
                Dim gg() As String = Me.GreskeZaPolje(polja(i), , True)
                For j As Integer = 0 To gg.GetUpperBound(0)
                    If Array.IndexOf(GrNiz, gg(j)) = -1 Then
                        ReDim Preserve GrNiz(1 + GrNiz.GetUpperBound(0))
                        GrNiz(GrNiz.GetUpperBound(0)) = gg(j)
                    End If
                Next
            Next
        End If

        Dim bio As Boolean = True
        Me.DGTabelePanel(DGi(tabela)).Rows.Add(Me.DGTabelePanel(DGi(tabela)).NewRow)

        '********************Goran
        For Each c As Control In panel.Controls
            If c.Name.Length > 3 AndAlso (c.Name.Substring(0, 3).ToUpper = "DTK" OrElse c.Name.Substring(0, 3).ToUpper = "DCK" _
                        OrElse c.Name.Substring(0, 3).ToUpper = "DUK") Then
                Dim s As String = c.Name.Trim.ToUpper.Substring(3)
                UpisiPoljePanel(s, tabela, panel, SPK(s, panel))
            End If
        Next
        For Each c As Control In panel.Controls
            If c.Name.Length > 3 AndAlso (c.Name.Substring(0, 3).ToUpper = "DTP" OrElse c.Name.Substring(0, 3).ToUpper = "DCB" _
                    OrElse c.Name.Substring(0, 3).ToUpper = "DHH" OrElse c.Name.Substring(0, 3).ToUpper = "DRB" _
                    OrElse c.Name.Substring(0, 3).ToUpper = "DUP") Then
                Dim s As String = c.Name.Trim.ToUpper.Substring(3)
                UpisiPoljePanel(s, tabela, panel, SP(s, panel))
            End If
        Next
        '********************Goran
