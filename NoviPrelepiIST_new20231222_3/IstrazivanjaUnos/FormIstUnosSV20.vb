        If Me.btnNext.Visible = True Then   'znaci zakljucan NEMA MENJANJA, pa nema potrebe ni da ide kroz ovo
            'odmah izlazim
            If SCati = False Then
                rbutton.BackColor = RGBColors.mBackColor
            Else
                rbutton.BackColor = Color.Beige
            End If
        Else   'NIJE ZAKLJUCAN
            If DGTabele(DGi(GlavnaTabela)).Rows.Count <= 0 Then
                Me.Kljuc1Focus()
                Exit Sub
            End If
            Dim rbr As String = rbutton.Name.Substring(rbutton.Name.LastIndexOf("_")).Replace("_", "")
            Dim levo As Integer = 2
            Dim desno As Integer = rbutton.Name.Length - rbutton.Name.LastIndexOf("_")
            Dim duz As Integer = rbutton.Name.Length
            'Dim plj As String = Mid(rbutton.Name.Trim.ToUpper, 3)
            Dim plj As String = rbutton.Name.Trim.ToUpper.Substring(levo, duz - levo - desno)
            Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
            Dim pomOD As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("od")).Trim.ToUpper
            pomOD = pomOD.Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
            Dim pommtip As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("tip")).Trim.ToUpper
            Dim grupa As String = rbutton.Tag

            Dim nizProvera() As String = {}
