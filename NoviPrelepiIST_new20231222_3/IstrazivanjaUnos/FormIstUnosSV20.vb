                KljuceviSaEkranaSaVrednostima(ii, 1) = dgvGRID.Rows(eRowIndex).Cells(Kljucevi(ii).Trim.ToUpper).Value
            Next
            KljTabeleSavrednostima = KljuceviSaEkranaSaVrednostima

            For i As Integer = brlinks + 1 To dgvGRID.ColumnCount - 1
                Dim ime As String = dgvGRID.Columns(i).Name.Trim.ToUpper
                Dim cntlk As Control = NadjiKontroluSkrKojaNijeLABELAiKojaJeUKLJUCU(Me, ime, 2)
                If Not cntlk Is Nothing AndAlso (TypeOf cntlk Is TextBox OrElse TypeOf cntlk Is ComboBox) Then
                    If TypeOf cntlk Is TextBox Then
                        If Not cntlk.AccessibleName Is Nothing AndAlso cntlk.AccessibleName.IndexOf("AUTB;") >= 0 AndAlso cntlk.AccessibleName.IndexOf("AUTBDB;") >= 0 Then
                            Call prebaciautbKLJUC(cntlk, Mid(cntlk.Name, 3).Trim.ToUpper)
                        Else
                            cntlk.Text = IIf(dgvGRID.Rows(eRowIndex).Cells(ime).Value Is System.DBNull.Value, "", dgvGRID.Rows(eRowIndex).Cells(ime).Value)
