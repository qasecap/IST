    Private Sub dpk_Validating(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs) ' lostFocus

        Dim tbox As TextBox = CType(sender, TextBox)

        If Me.BtnExit.Focused OrElse Me.AL.Focused OrElse Me.XL.Focused OrElse
            Not focusedDG(Me.Panel1) Is Nothing OrElse dgscroll = True Then
            nepotrebnavalidacijaPanel = False
            dgscroll = False
        End If

        If bioPageDown = True Then Exit Sub
        If nepotrebnavalidacijaPanel = True Then Exit Sub

        okvalidacija = True

        nizbio = Nothing
        nizbiovred = Nothing
        nind = -1

        'IStMessageBox.Show("LEAVE")
        Me.Cursor = Cursors.WaitCursor

        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 4)
        Dim panel As Panel = tbox.Parent

        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)
        Dim GlavnaTabela As String = panel.Name.Replace("PANE_", "")

        Dim klj() As String = Me.DajKljuceve(GlavnaTabela)
        Dim ppKLJ As Boolean = False
        If plj = klj(klj.GetUpperBound(0)).Trim.ToUpper Then ppKLJ = True
        'poslednje polje u kljucu je klj(klj.getupperbound(0))

        If ppKLJ = True Then Call resetPanel(panel)

        Dim fokuspanel As Boolean = False
        For Each k As Control In panel.Controls
            If k.Focused = True Then
                fokuspanel = True
                Exit For
            End If
        Next

        Static Dim VecBio As Boolean
        'ako je fokus na nekom od panelnih polja onda ide provera inace ne

        If fokuspanel = True AndAlso (tbox.Text.Trim = Nothing OrElse tbox.Text.Trim = "") Then
            'ISKLJUCENO NAMERNO
            ''msg 47
            'Dim msgtxt47 As String = getMessageText(dtMessages, "47", Me.jezik)
            ''msg 54
            'Dim msgtxt54 As String = getMessageText(dtMessages, "54", Me.jezik)
            'IStMessageBox.Show(msgtxt47, msgtxt54, MessageBoxButtons.OK, MessageBoxIcon.Error)
            ''IStMessageBox.Show("U KLJUČU NE SME BITI PRAZNO POLJE!", "Prazno polje", MessageBoxButtons.OK, MessageBoxIcon.Error)
            tbox.Focus()
            okvalidacija = False
            Me.Cursor = Cursors.Default
            Exit Sub
        ElseIf (Me.BtnExit.Focused) AndAlso (tbox.Text.Trim = Nothing OrElse tbox.Text.Trim = "") Then
            Me.Cursor = Cursors.Default
            Me.Close()
            Exit Sub
        ElseIf (Me.BtnSaveNext.Focused OrElse Me.btnNext.Focused OrElse Me.BtnSave1.Focused) AndAlso (tbox.Text.Trim = Nothing OrElse tbox.Text.Trim = "") Then
