    Sub bdodajRed(ByVal pp() As String, ByVal gde As String, Optional fp As String = "", Optional fptext As String = ".")
        'mnu02.Tag = GlavnaTabela + ";" + tValidFrom + ";" + tbox.Name.Substring(2) + ";" + cStr(Forma).Trim + ";" + cStr(p.rbr).Trim
        Dim trk() As String = pp(3).Split(".")
        If trk.Length = 3 Then
            Dim currenttab As Integer = CInt(trk(0).Trim)
            Dim currentred As Integer = CInt(trk(1).Trim)
            Dim currentkol As Integer = CInt(trk(2).Trim)

            Dim r As Integer = -5
            Dim rCopy As Integer = -5
            Dim sufiks As String = ""
            Dim sufiksbr As String = ""
            Dim poslednji As Boolean = False
            'Dim fformaK As String = CStr(currenttab).Trim + ".%." + CStr(currentkol).Trim
            Dim fformaR As String = CStr(currenttab).Trim + "." + CStr(currentred).Trim + ".%"

            Dim minrbrzatab As String = minRBRTabela(pp(0).Trim, currenttab)
            Dim maxrbrpretab As String = maxRBRbeforeRBR(pp(0).Trim, minrbrzatab)
            Dim maxrbrzatab As String = maxRBRTabela(pp(0).Trim, currenttab)
            Dim minrbrposletab As String = minRBRafterRBR(pp(0).Trim, maxrbrzatab)

            If gde = "above" Then
                r = currentred
            Else
                r = currentred + 1
                Dim pomSR As String = "select top 1 f2 from vrepISTPolja where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(forma)) like '" +
                    CStr(currenttab).Trim + ".%." + CStr(currentkol).Trim + "' and f2>" + CStr(currentred).Trim + " order by cast(f2 as int)"
                Dim dtPom As DataTable = izvrsiSQLvratiDT(pomSR, Me.ISTConnectionString, Me.jezik)
                If dtPom Is Nothing OrElse dtPom.Rows.Count = 0 Then poslednji = True
            End If

            rCopy = currentred

            Dim brk() As String = dajbr(sifist, pp(0).Trim, currenttab, currentred, currentkol, fformaR, "dodajred")
            'dodavanje u DB
            Dim sqlDB As String = "" : Dim sqlDBDropTip As String = "" : Dim DropTip As String = ""
            Dim sqlIST As String = ""
            '1. update starih celija
            'pomeranje u IST-u
            Dim sqlPI As String = " update a set a.forma=rtrim(ltrim(str(f1))+'.'+ltrim(str((f2+1)))+'.'+ltrim(str(f3))), " + nvrd +
                                  " a.izraz=case when b.izraz Like '''Text_%' then '''Text_'+rtrim(ltrim(str(f1))+'.'+ltrim(str((f2+1)))+'.'+ltrim(str(f3)))+'''' else a.izraz  end" +
                                  " from istpolja a inner Join vrepISTPolja b on a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                                  " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and f1='" + CStr(currenttab).Trim + "' and cast(f2 as integer)>=" + CStr(r).Trim + ";" + nvrd


            '2. dodajemo nove celije
            Dim sql As String = " select polje,rbr,forma,opis,isnull(pp,'') as pp " +
                    " from vrepistpolja " +
                    " Where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(forma)) like '" + fformaR + "' order by rbr;" + nvrd
            Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Me.jezik)
            If dt Is Nothing OrElse dt.Rows.Count = 0 Then poslednji = True
            dodppolje = ""
            If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
                For i As Integer = 0 To brk.Length - 1
                    Dim tt() As String
                    If fp = "" Then
                        tt = stringInsertRow(dt.Rows(i).Item("pp").ToString.Trim, pp(0).Trim, currenttab, r, brk(i), rCopy, poslednji, brk.Length, gde).Split("~")
                        'strIST + "~" + sqlDB + "~" + sqlDBDropTip.TrimEnd("#") + "~" + DropTip.TrimEnd("#")
                        sqlIST = sqlIST + tt(0).ToString.Trim
                        sqlDB = sqlDB + tt(1).ToString.Trim
                        sqlDBDropTip = sqlDBDropTip + tt(2) + "#"
                        DropTip = DropTip + tt(2) + "#"
                    Else
                        tt = stringInsertVirtualRow("fp", pp(0).Trim, currenttab, r, brk(i), rCopy, poslednji, brk.Length, gde, fptext).Split("~")
                        sqlIST = sqlIST + tt(0).ToString.Trim
                    End If

                Next
            End If

            '3. pomeramo rbrove svih posle tabele
            Dim sqlRBRP As String = ""
            If minrbrposletab.Trim <> "0" Then   'znaci nesto ima posle tabele
                sqlRBRP = " update istpolja " +
                          " set rbr=rbr+" + CStr(brk.Length).Trim + "*10 " +
                          " where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and rbr >=" + minrbrposletab.Trim
            End If

            '4. dodeljujemo nove rbr tabeli
            Dim orderby As String = ""
            ''ako je cursor desno pa dole (obicno)  order by 1,2
            orderby = "order by 1,2 ;"
            ''ako je cursor desno pa dole (obicno)  order by 2,1
            'orderby = "order by 2,1 ;"
            Dim sssp As String = " select cast(f2 as integer) as f2,cast(f3 as integer) as f3 from vrepISTPolja " +
                                 " where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and f1='" + CStr(currenttab).Trim + "' and cast(f2 as integer)<=" + CStr(r).Trim +
                                 " union all" +
                                 " select cast(f2 as integer)+1 as f2,cast(f3 as integer) as f3 from vrepISTPolja " +
                                 " where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and f1='" + CStr(currenttab).Trim + "' and cast(f2 as integer)>=" + CStr(r).Trim +
                                  orderby + nvrd
            Dim dts As DataTable = izvrsiSQLvratiDT(sssp, Me.ISTConnectionString, Me.jezik)

            Dim sqlRBR As String = ""
            For ii As Integer = 0 To dts.Rows.Count - 1
                sqlRBR = sqlRBR + "update istpolja set rbr=" + CStr(maxrbrpretab).Trim + "+" + CStr(ii + 1).Trim + "*10 where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "'" +
                    "and ltrim(rtrim(forma)) ='" + CStr(currenttab).Trim + "." + dts.Rows(ii).Item("f2").ToString.Trim + "." + dts.Rows(ii).Item("f3").ToString.Trim + "';" + nvrd
            Next

            Dim p1 As String = napraviBackUpizvrsiSQL(sqlPI + nvrd + sqlIST + nvrd + sqlRBRP + nvrd + sqlRBR,, sqlDBDropTip.TrimEnd("#"), DropTip.TrimEnd("#"))
            If p1 = "ok" Then
                Dim p2 As String = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
                If p2 = "nok" Then ISTMessageBox.Show("Error!") Else Call subREFRESH("C")
            End If
        End If
    End Sub

    Dim dodppolje As String = ""

    Function stringInsertRow(ByVal tp As String, ByVal pp0 As String, ByVal currenttab As Integer, ByVal r As Integer, ByVal brki As Integer, ByVal rCopy As Integer, ByVal poslednji As Boolean, ByVal brk As Integer, ByVal gde As String) As String
        stringInsertRow = ""
        Dim strsql As String = " select sifist,tabela,polje,vod,vdo,'" + CStr(currenttab).Trim + "." + CStr(r).Trim + "." + CStr(brki).Trim + "' as forma,rbr,formatopis,opis,izraz,formatIzraz,vs" +
                               " from vrepistpolja " + nvrd +
                               " where sifist=N'" + sifist + "' and tabela=N'" + pp0.Trim + "'" +
                               " and ltrim(rtrim(forma)) like '" + CStr(currenttab).Trim + "." + CStr(rCopy).Trim + "." + CStr(brki).Trim + "'" + nvrd
        Dim dt As DataTable = izvrsiSQLvratiDT(strsql, Me.ISTConnectionString, Nothing)

        Dim ppolje As String = ""
        Dim sqlDB As String = ""
        Dim strIST As String = ""
        Dim sqlDBDropTip As String = ""
        Dim DropTip As String = ""

        If tp <> "lbl" AndAlso tp <> "fp" Then
            ppolje = dajUniqueImeISTDB(pp0, "p_", dodppolje)
            sqlDB = sqlDB + "ALTER TABLE " + pp0.Trim + " ADD  " + ppolje + " NVARCHAR(255) NULL;" + nvrd
            sqlDBDropTip = sqlDBDropTip + pp0.Trim + ";" + ppolje + "#"
            DropTip = DropTip + "ADD" + "#"
        Else
            ppolje = dajUniqueImeIST(pp0, "fp_", dodppolje)
        End If
        dodppolje = dodppolje + ppolje + ";"

        Dim rbr As Integer = dt.Rows(0).Item("rbr").ToString.Trim
        If poslednji = True Then rbr = CInt(dt.Rows(0).Item("rbr").ToString.Trim) + brk * 10

        Dim pizraz As String = ""
        If dt.Rows(0).Item("formatizraz").ToString.Trim <> "" AndAlso dt.Rows(0).Item("izraz").ToString.Trim <> "" Then
            If dt.Rows(0).Item("izraz").ToString.Trim.IndexOf("'") = 0 Then
                pizraz = dt.Rows(0).Item("formatizraz").ToString.Trim + "$''N" + dt.Rows(0).Item("izraz").ToString.Trim.Substring(1) + "'"
            Else
                pizraz = "'' ''"
            End If
        ElseIf dt.Rows(0).Item("formatizraz").ToString.Trim <> "" AndAlso dt.Rows(0).Item("izraz").ToString.Trim = "" Then
            pizraz = dt.Rows(0).Item("formatizraz").ToString.Trim
        ElseIf dt.Rows(0).Item("formatizraz").ToString.Trim = "" AndAlso dt.Rows(0).Item("izraz").ToString.Trim <> "" Then
            If dt.Rows(0).Item("izraz").ToString.Trim.IndexOf("'") = 0 Then
                pizraz = "''N" + dt.Rows(0).Item("izraz").ToString.Trim.Substring(1) + "'"
            Else
                pizraz = "'' ''"
            End If
        End If

        If poslednji = True AndAlso dt.Rows(0).Item("izraz").ToString.Trim <> "" AndAlso dt.Rows(0).Item("izraz").ToString.Trim.ToUpper.IndexOf("TEXT_") = 1 Then
            pizraz = "'' '' "
        End If

        Dim popis As String = ""
        If dt.Rows(0).Item("formatopis").ToString.Trim <> "" AndAlso dt.Rows(0).Item("opis").ToString.Trim <> "" Then
            popis = dt.Rows(0).Item("formatopis").ToString.Trim + "$" + dt.Rows(0).Item("opis").ToString.Trim + ""
        ElseIf dt.Rows(0).Item("formatopis").ToString.Trim <> "" AndAlso dt.Rows(0).Item("opis").ToString.Trim = "" Then
            popis = dt.Rows(0).Item("formatopis").ToString.Trim
        ElseIf dt.Rows(0).Item("formatopis").ToString.Trim = "" AndAlso dt.Rows(0).Item("opis").ToString.Trim <> "" Then
            popis = "'" + dt.Rows(0).Item("opis").ToString.Trim + "'"
        End If

        strIST = strIST + "insert into istpolja (sifist,tabela,polje,vod,vdo,forma,rbr,opis,izraz,vs)" + nvrd +
                 " values (N'" + sifist + "',N'" + pp0.Trim + "',N'" + ppolje + "'," +
                 "'" + Convert.ToDateTime(dt.Rows(0).Item("vod")).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'," +
                 "'" + Convert.ToDateTime(dt.Rows(0).Item("vdo")).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'," +
                 "'" + dt.Rows(0).Item("forma").ToString.Trim + "','" + CStr(rbr).Trim + "'," +
                 "N'" + popis + "',N'" + pizraz + "','" + dt.Rows(0).Item("vs").ToString.Trim + "');" + nvrd

        stringInsertRow = strIST + "~" + sqlDB + "~" + sqlDBDropTip.TrimEnd("#") + "~" + DropTip.TrimEnd("#")
    End Function

