    Private Sub ctrt_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs)
        bioPageDown = False
        Dim pTB As pomTextBox = CType(sender, pomTextBox)

        Dim grupa As String = pTB.Tag
        Dim ugrupi As Integer = 0
        If Not grupa Is Nothing Then
            Dim chP() As String = kojeugrupi(nizCHB, grupa)
            ugrupi = chP.Length
        End If

        'AktivanTekstBoks = pTB
        Dim addmissingvalue As String = ""
        Select Case e.KeyCode
            Case Keys.F2
                Dim f2 As String = "" : Dim f3 As String = ""
                If SCati = True AndAlso Not pTB.AccessibleName Is Nothing AndAlso pTB.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                    Dim pp() As String = pTB.AccessibleName.Split(";")
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                            addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                            Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                            Dim ppom() As String = f2f3.Split("$")
                            f2 = ppom(0) : f3 = ppom(1)
                            Exit For
                        End If
                    Next
                End If
                If f2 <> "" Then
                    If SCati Then
                        pTB.Text = "!"
                    Else
                        pTB.Text = f2
                    End If
                    pTB.SelectAll()
                End If
            Case Keys.F3
                Dim f2 As String = "" : Dim f3 As String = ""
                If SCati = True AndAlso Not pTB.AccessibleName Is Nothing AndAlso pTB.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                    Dim pp() As String = pTB.AccessibleName.Split(";")
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                            addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                            Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                            Dim ppom() As String = f2f3.Split("$")
                            f2 = ppom(0) : f3 = ppom(1)
                            Exit For
                        End If
                    Next
                End If
                If f3 <> "" Then
                    If SCati Then
                        pTB.Text = "?"
                    Else
                        pTB.Text = f2
                    End If
                    pTB.SelectAll()
                End If
            Case Keys.Down
                Call ctrt_Validacija(sender, Nothing)
                If okvalidacija = False Then
                    sender.Focus()
                    Exit Sub
                End If
                If okvalidacija = True Then
                    If dalijeposlednjiCATIPanel(pTB.Parent) = False AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                        Call dugmeCATIN(pTB)
                        e.SuppressKeyPress = True   'zbog multiline inace ne radi
                    ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = True AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                    ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = False AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                        SendKeys.Send("{TAB}")
                    ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = True AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                        SendKeys.Send("{TAB}")
                    End If
                End If

            Case Keys.Up
                ' nema validacije
                nepotrebnavalidacijaCATI = True
                If dalijeprviCATIPanel(pTB.Parent) = False AndAlso dalijeprviTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                    Call dugmeCATIP(pTB)
                    e.SuppressKeyPress = True   'zbog multiline inace ne radi
                ElseIf dalijeprviCATIPanel(pTB.Parent) = True AndAlso dalijeprviTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                ElseIf dalijeprviCATIPanel(pTB.Parent) = False AndAlso dalijeprviTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                    pTB.BackColor = SystemColors.ControlLightLight
                    SendKeys.Send("+{TAB}")
                ElseIf dalijeprviCATIPanel(pTB.Parent) = True AndAlso dalijeprviTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                    pTB.BackColor = SystemColors.ControlLightLight
                    SendKeys.Send("+{TAB}")
                End If
            Case Keys.End
                Me.BtnSaveNext.Focus()
            Case Keys.PageDown
                'ako nije zadnji panel
                Dim poslednji As Panel = grupePitanjaCATI(grupePitanjaCATI.GetUpperBound(0))
                If Not poslednji Is pTB.Parent Then Call dugmeCATIN(Nothing, pTB)
            Case Keys.PageUp
                'ako nije prvi panel
                Dim prvi As Panel = grupePitanjaCATI(0)
                If Not prvi Is pTB.Parent Then Call dugmeCATIP(Nothing, pTB)
        End Select

    End Sub

