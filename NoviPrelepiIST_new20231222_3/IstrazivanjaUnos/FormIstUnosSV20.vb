        End If
        If e.KeyCode = Keys.Enter AndAlso sender.rows.count > 0 Then
            Dim erowindex As Integer = sender.CurrentCell.RowIndex
            Dim eColumnIndex As Integer = sender.CurrentCell.ColumnIndex
            Call DGVGRIDCELLCONTENTCLICK(erowindex, eColumnIndex, sender)
        End If
