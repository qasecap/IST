    Sub nevidljivBlokPanelSviSem(ByVal ipanel As Integer, ByVal b As Integer)
        'mora odvojeno od sub vidljivBlok
        For ii As Integer = 0 To grupeCNTLBlokoviPanel(ipanel).GetUpperBound(0)
            If ii <> b Then
                For i As Integer = grupeCNTLBlokoviPanel(ipanel)(ii).GetUpperBound(0) To 0 Step -1
