    Sub resetPanel(ByVal panel As Panel)
        'reset za svaki slucaj
        For Each c As Control In panel.Controls
            If Not TypeOf c Is Label And c.Enabled = False Then
                If c.Name.Substring(0, 3).ToUpper = "DTP" Or c.Name.Substring(0, 3).ToUpper = "DCB" Or c.Name.Substring(0, 3).ToUpper = "DUP" Or c.Name.Substring(0, 3).ToUpper = "DRP" Then
                    c.BackColor = SystemColors.ControlLightLight
                    c.Enabled = True
                End If
            End If
        Next
    End Sub

    Sub resetG()
        'reset za svaki slucaj
        For Each c As Control In Panel1.Controls
