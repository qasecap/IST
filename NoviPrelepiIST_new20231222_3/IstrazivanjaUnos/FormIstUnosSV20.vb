    Private Sub autbleaveAL(ByVal actb As AutoCompleteTextbox)

        Try

            indmaxcount = indmaxcount + 1
            If indmaxcount >= maxcount Then
                indmaxcount = 0
                'OVO DOLE NIKAKO PRESTANU DA RADE STRELICE!!!
                'ISTMessageBox.Show("It is not desirable to press ↑ and ↓ at same time.")
                'actb.nepotrebnavalidacija = True
                'nepotrebnavalidacija = True
                'actb.Focus()
                'actb.nepotrebnavalidacija = False
                'nepotrebnavalidacija = False
                Exit Sub
            End If
            actb.HideSuggestionListBox()

            Dim f2 As String = "" : Dim f3 As String = ""
            If Not actb.AccessibleName Is Nothing AndAlso actb.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                Dim pp() As String = actb.AccessibleName.Split(";")
                Dim addmissingvalue As String = ""
                For i As Integer = 0 To pp.GetUpperBound(0)
                    If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                        addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                        Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                        Dim ppom() As String = f2f3.Split("$")
                        f2 = ppom(0) : f3 = ppom(1)
                    End If
                Next
            End If

            If actb.Text.Trim <> "" AndAlso actb.CurrentAutoCompleteList.Count = 0 AndAlso actb.autoCompleteLimitToList = True AndAlso actb.Text.Trim <> f2 AndAlso actb.Text.Trim <> f3 AndAlso actb.OnlyOneInList = False Then
                actb.Text = ""
                actb.assignvalue = ""
                If Mid(actb.Name, 1, 2).Trim.ToUpper = "TK" Then
                    'na izlasku iz kljuca svakako prazni sve
                Else
                    Call ddodelaAutoComplete(actb, Mid(actb.Name, 3), actb.Parent)
                    If actbFilter.IndexOf("=" + Mid(actb.Name, 3).Trim.ToUpper + ";") >= 0 Then
                        Call IsprazniAUTB(Mid(actb.Name, 3).Trim.ToUpper)
                    End If
                End If
                okvalidacija = False
                Exit Sub
            End If

            If actb.Text.Trim <> "" AndAlso actb.CurrentAutoCompleteList.Count = 0 AndAlso actb.autoCompleteLimitToList = False AndAlso actb.OnlyOneInList = False Then
                actb.assignvalue = ""
                If Mid(actb.Name, 1, 2).Trim.ToUpper = "TK" Then
                    'na izlasku iz kljuca svakako prazni sve
                Else
                    Call ddodelaAutoComplete(actb, Mid(actb.Name, 3), actb.Parent)
                    If actbFilter.IndexOf("=" + Mid(actb.Name, 3).Trim.ToUpper + ";") >= 0 Then
                        Call IsprazniAUTB(Mid(actb.Name, 3).Trim.ToUpper)
                    End If
                End If
                Exit Sub
            End If

            Dim dodeli As String = ""

            If actb.DB = False Then
                Try
                    If actb.autoCompleteAssignTo <> "" Then
                        Dim nizacAssignTo As String() = actb.autoCompleteAssignTo.Split("$")
                        Dim nizacAssignStart As String() = actb.autoCompleteAssignStart.Split("$")
                        Dim nizacAssignLength As String() = actb.autoCompleteAssignLength.Split("$")
                        For Each sstr As String In actb.AutoCompleteList
                            If sstr <> "" Then

                                Dim pomfil As String = ""   'za filter
                                Dim pomstr As String = ""   'za prikazivanje i izbor

                                If actb.autoCompleteLength > 0 AndAlso actb.autoCompleteLength <= sstr.Length - actb.autoCompleteStart Then
                                    pomstr = sstr.Substring(actb.autoCompleteStart, actb.autoCompleteLength)
                                Else
                                    pomstr = sstr.Substring(actb.autoCompleteStart)
                                End If

                                If Not actb.filtervalue Is Nothing AndAlso actb.autoCompleteFilterStart >= 0 Then
                                    If actb.autoCompleteFilterLength <= sstr.Length - actb.autoCompleteFilterStart Then
                                        pomfil = sstr.Substring(actb.autoCompleteFilterStart, actb.autoCompleteFilterLength).Trim
                                    Else
                                        pomfil = sstr.Substring(actb.autoCompleteFilterStart).Trim
                                    End If

                                    If (pomfil.ToLower().IndexOf(actb.filtervalue.ToLower) = 0) AndAlso pomstr.ToLower.Trim = actb.Text.ToLower.Trim Then
                                        For i As Integer = 0 To nizacAssignLength.GetUpperBound(0)
                                            Dim acl As Integer = CInt(nizacAssignLength(i))
                                            Dim acs As Integer = CInt(nizacAssignStart(i))
                                            If acl > 0 Then
                                                Dim dduz As Integer = acl
                                                If acl > sstr.Length - acs Then dduz = sstr.Length - acs
                                                dodeli = dodeli + sstr.Substring(acs, dduz) + "$"
                                            Else
                                                dodeli = dodeli + sstr.Substring(acs, actb.autoCompleteStart) + "$"
                                            End If
                                        Next
                                        Exit For
                                    End If
                                Else
                                    If pomstr.ToLower.Trim = actb.Text.ToLower.Trim Then
                                        For i As Integer = 0 To nizacAssignLength.GetUpperBound(0)
                                            Dim acl As Integer = CInt(nizacAssignLength(i))
                                            Dim acs As Integer = CInt(nizacAssignStart(i))
                                            If acl > 0 Then
                                                Dim dduz As Integer = acl
                                                If acl > sstr.Length - acs Then dduz = sstr.Length - acs
                                                dodeli = dodeli + sstr.Substring(acs, dduz) + "$"
                                            Else
                                                dodeli = dodeli + sstr.Substring(acs, actb.autoCompleteStart) + "$"
                                            End If
                                        Next
                                        Exit For
                                    End If
                                End If

                            End If
                        Next

                    End If
                Catch ex As Exception

                End Try
                'dodela
                If dodeli.Trim <> "" AndAlso dodeli.Trim.IndexOf("$") >= 0 Then
                    dodeli = dodeli.Trim + "aa"
                    dodeli = dodeli.Replace("$aa", "")
                End If

                actb.assignvalue = dodeli
            End If


            If actb.DB = True Then
                If actb.Text.Trim <> "" Then
                    For Each sstr As String In actb.AutoCompleteDataSourceDB
                        Dim pp() As String = sstr.Split("ˇ")
                        'pp(0) - value
                        'pp(1) - display
                        'Dim pomstrD As String = pp(1)
                        'If pomstrD.ToLower.Trim = actb.Text.ToLower.Trim Then
                        '    dodeli = pp(0)
                        '    Exit For
                        'End If
                        Dim pomstrD As String = pp(0)
                        If pomstrD.ToLower.Trim = actb.sselectedValue.ToLower.Trim Then
                            dodeli = pp(0)
                            Exit For
                        End If
                    Next
                    If dodeli.Trim = "" Then
                        For Each sstr As String In actb.AutoCompleteDataSourceDB
                            Dim pp() As String = sstr.Split("ˇ")
                            'If pp(0).Trim = pp(1).Trim Then
                            Dim pomstrD As String = pp(1)
                            If pomstrD.ToLower.Trim = actb.Text.ToLower.Trim Then
                                dodeli = pp(0)
                                Exit For
                            End If
                            'End If
                        Next
                    End If
                End If
                actb.sselectedValue = dodeli.Trim
                If dodeli.Trim = "" Then actb.Text = ""
                actb.sselectedText = actb.Text.Trim
            End If
        Catch ex As Exception
            Call zatvoriOLHC()
            ISTMessageBox.Show(ex.Message)
        End Try
    End Sub

    Dim cntlfocused As Boolean = False

    Sub finalySkipGrupa(ByVal cntl As Control, ByVal autb As Boolean, Optional sakljuca As Boolean = False)
        cntlfocused = False
        Try
            ''''obicno POLJE
            'u kojoj je grupi polje sa koga skacemo,   plj.Trim.ToUpper

            Dim tblok As Integer = 0
            tblok = Array.IndexOf(grupePitanjaCAPI, cntl.Parent)

            'VALIDACIJA
            nepotrebnavalidacija = False
            If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False

            If sakljuca = True Then
                Call pk_Validacija(cntl, Nothing)
                tblok = 0
            Else
                Call pp_Validacija(cntl, Nothing, False, "pp_Validating")
            End If

            IndBlokaNaKomeSmo = tblok
            'VALIDACIJA

            'da ne izaziva bezveze izlazak  i ulazak sa panela
            If okvalidacija = False Then

                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True
                nepotrebnavalidacija = True
                cntl.Focus()
                cntlfocused = True
                ''''''''''''''''''''''''''Nevenaaaaaaaa ovde zadrzi boju u kljucu
                'cntl.BackColor = Color.Bisque
                okvalidacija = False
                nepotrebnavalidacija = False
                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                Exit Sub
            End If

            If okvalidacija = True AndAlso bbiloskakanje = True Then
                If bbss Is Nothing Then Exit Sub
                Dim nblok As Integer = -1
                If Not bbss.AccessibleName Is Nothing Then
                    Dim p As Integer = bbss.AccessibleName.IndexOf("TOGROUP")
                    If p >= 0 Then
                        Dim pp As String = bbss.AccessibleName.Substring(p + 7)
                        nblok = pp.Substring(0, pp.IndexOf(";"))
                    End If
                End If
                If nblok <> tblok AndAlso nblok > -1 Then
                    nepotrebnavalidacija = True
                    grupePitanjaCAPI(tblok).Visible = False
                    Call SuspendDrawing(grupePitanjaCAPI(nblok))
                    grupePitanjaCAPI(nblok).Visible = True
                    Call ResumeDrawing(grupePitanjaCAPI(nblok))
                    nepotrebnavalidacija = False
                End If
                nepotrebnavalidacija = True
                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True
                Dim mmss As Control = bbss
                bbss.Focus()
                bbss = mmss
                bbiloskakanje = True
                nepotrebnavalidacija = False
                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                IndBlokaNaKomeSmo = nblok
                If TypeOf bbss Is DataGridView AndAlso DirectCast(bbss, DataGridView).Rows.Count > 0 Then
                    DirectCast(bbss, DataGridView).ClearSelection()
                    DirectCast(bbss, DataGridView).CurrentCell = DirectCast(bbss, DataGridView).FirstDisplayedCell
                    DirectCast(bbss, DataGridView).CurrentCell.Selected = True
                End If
                Exit Sub
            End If

            Dim ST As Boolean = False
            Dim NB As Boolean = False
            If okvalidacija = True AndAlso bbiloskakanje = False Then
                If sakljuca = False Then
                    If dalijeposlednjiCAPIPanel(cntl.Parent) = False AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = True Then
                        NB = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = True AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = True Then
                        'MORA OVAKO INACE AKO PRITISNU ISTOVREMENO KEUP AND KEYDDOWN PUSTA IH DA ODU, a cntl.focus ne radi nista
                        nepotrebnavalidacija = False
                        If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                        ST = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = False AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = False Then
                        ST = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = True AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = False Then
                        ST = True
                    End If
                Else
                    nepotrebnavalidacija = True
                    If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True     'da ne radi opet validaciju
                    If autb = True Then
                        autbSelectNextControl(cntl)
                    Else
                        'Me.SelectNextControl(ActiveControl, True, True, True, True)
                        Call pkSelectNextControl(cntl)
                        okvalidacija = True
                    End If

                    'OVO NE SME
                    'If autb = False Then Me.SelectNextControl(ActiveControl, True, True, True, True)
                    nepotrebnavalidacija = False
                    If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                    Exit Sub
                End If
            End If

            If ST = True Then
                'SendKeys.SendWait("{TAB}")
                'MORA OVAKO DOKAZ PROBNIPOPIS
                nepotrebnavalidacija = True  'da ne radi opet validaciju
                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True
                Me.SelectNextControl(ActiveControl, True, True, True, True)
                okvalidacija = True
                nepotrebnavalidacija = False
                If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                IndBlokaNaKomeSmo = tblok
                Exit Sub
            End If

            If NB = True Then
                Try
                    'vidljiv je sledeci blok po redu
                    'MORA DA SE ODVOJI NA VIDLJIV I NEVIDLJIVI KAO KAD IMA SKOK
                    'INACE GUBI PANEL FOKUS; PA PONOVO URADI PANE_ENTER
                    If tblok < grupePitanjaCAPI.GetUpperBound(0) Then
                        nepotrebnavalidacija = True
                        If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True
                        grupePitanjaCAPI(tblok).Visible = False

                        Call SuspendDrawing(grupePitanjaCAPI(tblok + 1))
                        grupePitanjaCAPI(tblok + 1).Visible = True
                        Call ResumeDrawing(grupePitanjaCAPI(tblok + 1))

                        IndBlokaNaKomeSmo = tblok + 1
                        If Not grupePitanjaCAPI(tblok + 1) Is Nothing AndAlso Not prvaCNTLCAPIPanel(grupePitanjaCAPI(tblok + 1)) Is Nothing Then
                            bbss = prvaCNTLCAPIPanel(grupePitanjaCAPI(tblok + 1))
                            If Not bbss Is Nothing Then
                                Dim z As String = ""
                                Dim ima As Boolean = False
                                If Not bbss.AccessibleName Is Nothing Then
                                    If bbss.AccessibleName <> "" AndAlso bbss.AccessibleName.Trim.Substring(bbss.AccessibleName.Trim.Length - 1, 1) <> ";" Then z = ";"
                                    Dim pom As String = "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(tblok + 1).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"
                                    If bbss.AccessibleName.Trim.ToUpper.IndexOf(pom) >= 0 Then ima = True
                                End If
                                If ima = False Then bbss.AccessibleName = bbss.AccessibleName + z + "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(tblok + 1).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"
                                bbss.Focus()
                            End If
                        End If
                    Else
                        'SendKeys.SendWait("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        nepotrebnavalidacija = True
                        If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = True
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                        IndBlokaNaKomeSmo = tblok
                    End If
                    nepotrebnavalidacija = False
                    If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
                    Exit Sub
                Catch ex As Exception
                    ISTMessageBox.Show("nextBlok iz validacije")
                    okvalidacija = False
                End Try
            End If

            nepotrebnavalidacija = False
            If autb = True Then DirectCast(cntl, AutoCompleteTextbox).nepotrebnavalidacija = False
        Catch ex As Exception
            ISTMessageBox.Show("pp_keypress")
            okvalidacija = False
        End Try
    End Sub

