        sql = strrpl(sql, "{YYY}", "'" + Me.mvt.G.ToString + "'")

        If sql.Trim.IndexOf("}") >= 0 Then sql = GGMMGoreDole(sql, Me.mvt.G, Me.mvt.M)
        sql = strrpl(sql, "VRTACKA", Me.mvt.vtwhere(""))
        If sql.Trim.ToUpper.IndexOf("{GGG") < 0 AndAlso sql.Trim.ToUpper.IndexOf("GGG") >= 0 Then sql = strrpl(sql, "GGG", Me.mvt.GWhere(""))
        If sql.Trim.ToUpper.IndexOf("{MMM") < 0 AndAlso sql.Trim.ToUpper.IndexOf("MMM") >= 0 Then sql = strrpl(sql, "MMM", Me.mvt.mWhere(""))
        If sql.Trim.ToUpper.IndexOf("{YYY") < 0 AndAlso sql.Trim.ToUpper.IndexOf("YYY") >= 0 Then sql = strrpl(sql, "YYY", Me.mvt.YWhere(""))

        sql = strrpl(sql, "{GGG", "'" + Me.mvt.G.ToString + "'")
        sql = strrpl(sql, "{YYY", "'" + Me.mvt.G.ToString + "'")
        sql = strrpl(sql, "{MMM", "'" + String.Format("{0:d2}", Me.mvt.M) + "'")

        sql = sql.Replace(ChrW(26), "")

        If sql.Trim.ToUpper.IndexOf("{CAPIUSER") >= 0 Then
            sql = zameniCAPIUSER(sql, txtmode, CAPIServer, CAPIBaza)
        End If

        If sql.Trim.ToUpper.IndexOf("{CATIUSER") >= 0 Then
            sql = zameniCATIUSER2(sql)
