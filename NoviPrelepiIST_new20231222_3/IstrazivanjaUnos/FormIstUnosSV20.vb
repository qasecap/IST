                                                    End If
                                                    Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper,,, k.Parent)
                                                    Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                                Else
                                                    If nizAUTBKontrola(ikik).Text = "" Then
                                                        k.Text = ""
                                                        Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper,,, k.Parent)
                                                        Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                                    End If
                                                End If
                                            End If
                                        End If
                                        '****
                                        '****
                                    ElseIf trenutniRBR > nizskociNAsssrbr Then
                                        If Mid(k.Name, 1, 1) <> "F" Then
                                            If Not k.AccessibleName Is Nothing AndAlso (k.AccessibleName.IndexOf("RO;") >= 0 OrElse k.AccessibleName.IndexOf("NE;") >= 0) Then
                                                k.Enabled = False 'da ostanu RRO; i RO;
                                            Else
                                                k.Enabled = True 'da ostanu fp
                                            End If
                                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("VF;") >= 0 Then
                                                'k.Visible = False
                                            Else
                                                k.Visible = True  'remark da ostanu visiblefalse
                                            End If
                                        End If

                                        If Mid(k.Name, 1, 1) = "F" Then
                                            If k.Tag.izraz = "''" Then k.Visible = False
                                            If k.Tag.izraz <> "''" AndAlso Not (Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("VF;") >= 0) Then k.Visible = True
                                        End If

                                        If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.GetUpperBound(0) >= nblok + 1 Then
                                            For p As Integer = nblok + 1 To grupePitanjaCAPI.GetUpperBound(0)
                                                Call enablujKontrole(grupePitanjaCAPI(p))
                                            Next
                                        End If
                                    End If
                                End If
                            End If
                            k = grupePitanjaCAPI(ii).GetNextControl(k, True) 'Get the next control in the tab order.
                        Loop
                    Next
                End If
                If tblok > nblok Then
                    Dim ind8 As Integer = Array.IndexOf(nizKontrolaIme, nizskociNAsss)
                    If ind8 > -1 Then
                        Dim k As Control = nizKontrola(ind8)

                        Dim z As String = ""
                        Dim ima As Boolean = False
                        If Not k.AccessibleName Is Nothing Then
                            If k.AccessibleName <> "" AndAlso k.AccessibleName.Trim.Substring(k.AccessibleName.Trim.Length - 1, 1) <> ";" Then z = ";"
                            Dim pom As String = "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(nblok).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"
                            If k.AccessibleName.Trim.ToUpper.IndexOf(pom) >= 0 Then ima = True
                        End If
                        If ima = False Then k.AccessibleName = k.AccessibleName + z + "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(nblok).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"

                        sskoci2Grupa = k
                    End If
                End If
            End If ' If nizskociNA(sss).Trim.ToUpper = "DUGMEDALJE"

            If Not nizAUTBTOKontrolaIme Is Nothing Then
                For ii As Integer = 0 To nizAUTBKontrola.GetUpperBound(0)
                    If CType(nizAUTBKontrola(ii), AutoCompleteTextbox).Text = "" Then
                        If Not nizAUTBTOKontrola(ii) Is Nothing Then
                            nizAUTBTOKontrola(ii).Text = ""
                            Me.UpisiPolje(nizAUTBTOKontrolaIme(ii),,, nizAUTBTOKontrola(ii).Parent)
                        End If
                    End If
                Next
            End If
        End If   'a=1
    End Function
    Private Sub enablujKontrole(p As Panel)
        For Each k As Control In p.Controls
            If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel Then
                If Mid(k.Name, 1, 1) <> "F" Then
                    If Not k.AccessibleName Is Nothing AndAlso (k.AccessibleName.IndexOf("RO;") >= 0 OrElse k.AccessibleName.IndexOf("NE;") >= 0) Then
                        k.Enabled = False 'da ostanu RRO; i RO;
                    Else
                        k.Enabled = True 'da ostanu fp
                    End If
                End If
            End If
        Next
    End Sub
    Function nsrbr(ByVal nizC() As Control, ByVal nizskociNAsss As String) As Integer
        nsrbr = 0
        If Not nizC Is Nothing AndAlso nizC.Length > 0 Then
            For i As Integer = 0 To nizC.GetUpperBound(0)
                If Mid(nizC(i).Name, 3).Trim.ToUpper = nizskociNAsss Then
                    Dim kk() As String = nizC(i).AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    nsrbr = krbr
                    Exit For
                End If
            Next
        End If
        Return nsrbr
    End Function
    Sub kreset(ByVal nizC() As Control, ByVal ppRBR As Integer, ByVal nizskociNAsssrbr As Integer)
        If Not nizC Is Nothing AndAlso nizC.Length > 0 Then
            For i As Integer = 0 To nizC.GetUpperBound(0)
                Dim k As Control = nizC(i)
                If Not k.AccessibleDescription Is Nothing Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    If ppRBR < krbr AndAlso krbr < nizskociNAsssrbr Then
                        If k.AccessibleName Is Nothing Then k.Enabled = True : k.Visible = True
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("VF;") < 0 Then k.Visible = True
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("VF;") >= 0 Then k.Visible = False
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("NE;") < 0 Then k.Enabled = True
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("NE;") >= 0 Then k.Enabled = False
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("SHH;") >= 0 Then k.AccessibleName = k.AccessibleName.Replace("SHH;", "")
                    End If
                End If
            Next
        End If
    End Sub
