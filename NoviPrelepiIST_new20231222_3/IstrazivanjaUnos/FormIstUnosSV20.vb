                                If k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4) Then
                                    If skippedVisibleFalse = True Then k.Visible = True
                                    If Mid(k.Name, 2, 1) <> "F" Then
                                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                            k.Enabled = False 'da ostanu RRO; i RO;
                                        Else
                                            k.Enabled = True 'da ostanu fp
                                        End If
                                    End If
                                    If Mid(k.Name, 1, 3) <> "DRP" Then k.Visible = True  'remark da ostanu visiblefalse
                                Else
                                    'zatvorena akcijom sa nekog drugog polja, ne diraj
                                End If
                            End If
                        End If
                        'End If
                    Next
                Next

            End If ' If nizskociNA(sss).Trim.ToUpper = "DUGMEDALJE"

            If Not nizAUTBTOPanelKontrolaIme Is Nothing Then
                For ii As Integer = 0 To nizAUTBPanelKontrola.GetUpperBound(0)
