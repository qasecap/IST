                        Dim krbr As Integer = kk(0)
                        nizskociNAsssrbr = krbr
                        Exit For
                    End If
                End If
            Next
        End If

        'ZA GRUPE NIKAKO NE KORISTITI NIZOVE KONTROLA JER JE TO MNOGO SPORIJE

        Dim tabela As String = GlavnaTabela
        If nizskociAKOsss = "" Then Exit Function
        Dim zzz As String = sracunajIzraz(nizskociAKOsss, plj, cntl)
        zzz = razCASTi(zzz)
        Dim a As Integer = scompute(zzz, plj, "skipif")
        'ispunjen USLOV
        If a = 1 Then
            'skippedsetemptyExceptIf
            Dim azSE As Integer = 0
            If Not nizskippedSetEmptyExcept Is Nothing AndAlso nizskippedSetEmptyExceptIF.Length > 0 Then
                For i As Integer = 0 To nizskippedSetEmptyExceptIF.GetUpperBound(0)
                    Dim zSE As String = sracunajIzraz(nizskippedSetEmptyExceptIF(i), plj, cntl)
                    zSE = razCASTi(zSE)
                    azSE = scompute(zSE, plj, "skippedsetemptyExceptIf")
                    If azSE = 1 Then
                        Dim contrSkipCheck As String() = Split(nizskippedSetEmptyExcept(i).Trim.ToUpper, ",")
                        For cc As Integer = 0 To contrSkipCheck.GetUpperBound(0)
                            'u kojoj je grupi polje sa koga skacemo,   plj.Trim.ToUpper
                            Dim tblok As Integer = -1
                            tblok = Array.IndexOf(grupePitanjaCAPI, cntl.Parent)
                            'u kojoj grupi je polje na koje skacemo nizskociNAsss.Trim.ToUpper
                            Dim nblok As Integer = -1
                            Dim ind1 As Integer = Array.IndexOf(nizKontrolaIme, nizskociNAsss)
                            If ind1 > -1 Then nblok = Array.IndexOf(grupePitanjaCAPI, nizKontrola(ind1).Parent)
                            If nblok = -1 Then nblok = grupePitanjaCAPI.GetUpperBound(0) : nizskociNAsssrbr = 1000000000

                            For ii As Integer = tblok To nblok
                                Dim k As Control = grupePitanjaCAPI(ii).GetNextControl(Me, True) 'Get the first control in the tab order.
                                Do Until k Is Nothing  'MORA PREKO LOOPA
                                    If Not TypeOf k Is Label AndAlso Not TypeOf k Is Button AndAlso Not TypeOf k Is DataGridView2 AndAlso Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                        Dim ind11 As Integer = Array.IndexOf(contrSkipCheck, Mid(k.Name, 3).Trim.ToUpper)
                                        Dim setempty As Boolean = False
                                        If ind11 < 0 Then setempty = True
                                        If setempty = True Then
                                            Dim trenutniRBR As Integer = -1
                                            If Not k.AccessibleDescription Is Nothing Then trenutniRBR = k.AccessibleDescription.Split(";")(0)
                                            If ppRBR < trenutniRBR AndAlso trenutniRBR < nizskociNAsssrbr Then
                                                k.Text = ""
                                                Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper,,, k.Parent)
                                                Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                            End If
                                        End If
                                    End If
                                    k = grupePitanjaCAPI(ii).GetNextControl(k, True) 'Get the next control in the tab order.
                                Loop
                            Next
                        Next
                        Exit For
                    End If ' If azSE = 1 Then
                Next
