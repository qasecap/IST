    Private Sub dugmeCATIP_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Me.Panel1.Height = maxVisinaPanel1CATI
        Dim btn As Button = CType(sender, Button)
        Dim panel As Panel = btn.Parent
        Dim kojiP As String = btn.Parent.Name.Replace("CATI_", "")
        Dim kk As Integer = CInt(kojiP) - 1
        Dim trenutni As Integer = CInt(kojiP)
        Dim panelPrevious As Panel = NadjiKontrolu(Me, "CATI_" + kk.ToString.Trim)
        If Not panelPrevious Is Nothing Then
            panelPrevious.Visible = True
            panel.Visible = False
        End If
        Dim panelPreviousPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + kk.ToString.Trim)
        Dim panelPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + trenutni.ToString.Trim)
        If Not panelPreviousPom Is Nothing Then
            panelPreviousPom.Visible = True
            panelPreviousPom.Height = panelPrevious.Height
            panelPreviousPom.SendToBack()
            panelPom.Visible = False
        End If
    End Sub

    Function SKIPOnClick(ByVal trtT2 As String, ByVal panel As Panel) As String
        SKIPOnClick = ""
        Dim nizProvera() As String = {}
        Dim skociNA As String = ""
        Dim nizskociNA() As String = {}
        Dim skociAKO As String = ""
        Dim nizskociAKO() As String = {}
        Dim skociAction As String = ""
        Dim nizskociAction() As String = {}

        Dim skippedEnabledFalse As String = "0"
        Dim skippedSetEmpty As String = "0"
        Dim skippedDontSave As String = "0"
        Dim skippedVisibleFalse As String = "0"

        nizProvera = Split(trtT2, ";")
        For i As Integer = 0 To nizProvera.GetUpperBound(0)
            nizProvera(i) = nizProvera(i).Trim.ToUpper
            If nizProvera(i).Trim.ToUpper.IndexOf("SKIPTO=") > -1 Then
                If nizProvera(i).IndexOf("SKIPTO=") = 0 Then
                    skociNA = nizProvera(i).Replace("SKIPTO=", "")
                    nizskociNA = Split(skociNA, "$")
                End If
            End If
            If nizProvera(i).Trim.ToUpper.IndexOf("SKIPIF=") > -1 Then
                If nizProvera(i).IndexOf("SKIPIF=") = 0 Then
                    skociAKO = nizProvera(i).Replace("SKIPIF=", "")
                    nizskociAKO = Split(skociAKO, "$")
                End If
            End If
            If nizProvera(i).IndexOf("SKIPACTION=") = 0 Then
                skociAction = nizProvera(i).Replace("SKIPACTION=", "")
                nizskociAction = Split(skociAction, "$")
            End If
            If nizProvera(i).Trim.ToUpper.IndexOf("SKOCINA=") > -1 Then
                If nizProvera(i).IndexOf("SKOCINA=") = 0 Then
                    skociNA = nizProvera(i).Replace("SKOCINA=", "")
                    nizskociNA = Split(skociNA, "$")
                End If
            End If
            If nizProvera(i).Trim.ToUpper.IndexOf("SKOCIAKO=") > -1 Then
                If nizProvera(i).IndexOf("SKOCIAKO=") = 0 Then
                    skociAKO = nizProvera(i).Replace("SKOCIAKO=", "")
                    nizskociAKO = Split(skociAKO, "$")
                End If
            End If
            If nizProvera(i).IndexOf("SKIPPEDENABLEDFALSE") = 0 Then skippedEnabledFalse = "SEF"
            If nizProvera(i).IndexOf("SKIPPEDSETEMPTY") = 0 Then skippedSetEmpty = "SEE"
            If nizProvera(i).IndexOf("SKIPPEDDONTSAVE") = 0 Then skippedDontSave = "SDS"
            If nizProvera(i).IndexOf("SKIPPEDVISIBLEFALSE") = 0 Then skippedVisibleFalse = "SVF"
        Next
        'skakanje
        If skociNA.Length > 0 AndAlso skociAKO.Length > 0 Then            'mora da ima skociako (ako uvek skace onda skociako=2=2)
            For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                Try
                    Dim tabela As String = GlavnaTabela
                    Dim pomKol1 As New DataColumn("pomKol1")
                    Dim bbb() As String = razkvantaj(nizskociAKO(sss))
                    For ll As Integer = 0 To bbb.GetUpperBound(0)
                        If CStr(bbb(ll)).Trim.ToUpper.IndexOf("GLAVA.") = 0 OrElse CStr(bbb(ll)).Trim.ToUpper.IndexOf("HEAD.") = 0 Then 'oblik je GLAVA.polje - pandan D.polje
                            Dim plj As String = bbb(ll).Replace("GLAVA.", "").Replace("HEAD.", "").Trim.ToUpper
                            'saekrana
                            bbb(ll) = SE(plj, , Me.Panel1).Trim
                        ElseIf bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                            bbb(ll) = bbb(ll).Replace("}", "")
                            bbb(ll) = "'" + SP(bbb(ll).Substring(4), panel, True).Trim + "'"
                        ElseIf SP(bbb(ll), panel).Trim = "" Then
                        Else
                            bbb(ll) = "'" + SP(bbb(ll), panel).Trim + "'"
                        End If
                    Next
                    Dim zzz As String = ustringaj(bbb).ToUpper
                    zzz = razCASTi(zzz)
                    pomKol1.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                    DGTabele(DGi(tabela)).Columns.Add(pomKol1)
                    Dim xxx As String = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol1)", ""))
                    DGTabele(DGi(tabela)).Columns.Remove(pomKol1)
                    Dim a As Integer = CInt(xxx)  '1 TRUE, 0 FALSE
                    'ispunjen USLOV

                    If a = 1 Then SKIPOnClick = nizskociNA(sss) + ";" + skippedEnabledFalse + ";" + skippedSetEmpty + ";" + skippedDontSave + ";" + skippedVisibleFalse
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                End Try
            Next
        End If

    End Function

