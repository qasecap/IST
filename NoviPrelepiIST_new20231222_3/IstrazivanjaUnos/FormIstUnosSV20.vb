    Private Sub PreracunajFPOdjednom(ByVal nk() As TextBox)

        Dim upitSpojeni As String = ""
        For i As Integer = 0 To nk.GetUpperBound(0)
            upitSpojeni = upitSpojeni + PreracunajFPPomNovo(nk(i)) + ";"
        Next
        Dim dsU As DataSet = izvrsiSQLvratiDS(upitSpojeni, Me.DBConnectionString, Me.jezik)
        For i As Integer = 0 To nk.GetUpperBound(0)
            Dim PTip As System.Type = dsU.Tables(i).Columns(0).DataType
            Dim xpom As String = ""
            If dsU.Tables(i).Rows.Count = 0 Then xpom = "" Else xpom = dsU.Tables(i).Rows(0).Item(0).ToString.Trim
            If (PTip Is GetType(System.String)) Or (PTip Is GetType(System.Char)) Then ' 'uvek je FP ovo
                If xpom = "" Then
                    nk(i).Text = "''"
                Else
                    xpom = xpom.ToString.Replace("'", "''")
                    nk(i).Text = "'" & CStr(xpom) & "'"
                End If
            Else
                If xpom = "" Then
                    nk(i).Text = "0"
                Else
                    nk(i).Text = CStr(xpom)
                End If
            End If
            If nk(i).Text.Length > 0 AndAlso nk(i).Text.Substring(0, 1) = "'" Then nk(i).Text = nk(i).Text.Substring(1)
            If nk(i).Text.Length > 0 AndAlso nk(i).Text.Substring(nk(i).Text.Length - 1, 1) = "'" Then nk(i).Text = nk(i).Text.Substring(0, nk(i).Text.Length - 1)
        Next
    End Sub
