            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("FIRSTTB;") >= 0 Then
                'treba fals da se izracuna za sva polja ne samo za ona u kojima ucestvuje plj
                PreracunajFPPanel(GlavnaTabela, panel, "FPnPK")
                PreracunajFPPanel(GlavnaTabela, panel, "FPMEM")
            End If

            If dodeliKome.Length > 0 AndAlso dodeliSta.Length > 0 Then
                If dodeliAko.Length = 0 Then
                    For i As Integer = 0 To nizdodeliKome.GetUpperBound(0)
                        ReDim Preserve nizdodeliAko(i)
                        nizdodeliAko(i) = "2=2"
                    Next
                End If
                avltekst = dodelapanelAVL(tbox, nizdodeliKome, nizdodeliSta, nizdodeliAko, GlavnaTabela)
            End If ' If dodeliKome.Length <> 0 AndAlso dodeliSta.Length <> 0 AndAlso tbox.Text.Trim.Length > 0 Then

            '***********************************************************
            'READONLY POLJA
            '***********************************************************
            If samoCita.Length > 0 Then
                If samoCitaAKO.Length > 0 Then
                    For sss As Integer = 0 To nizsamoCitaAKO.GetUpperBound(0)
                        Try
                            Dim a As Integer = rreadOnlyPanel(panel, nizsamoCita(sss), nizsamoCitaAKO(sss), plj, tbox)
                        Catch ex As Exception
                            ''msg 21
                            Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                            ISTMessageBox.Show(ex.Message, msgtxt21 + ": rreadonly dpp_enter", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Finally
                        End Try
                    Next
                End If 'samoCitaAko.Length
            End If 'samoCita.Length
            '***********************************************************

            If uradioskokPriUlaskuUPanel = False AndAlso Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName <> "" AndAlso panel.AccessibleName.IndexOf("1-1") >= 0 Then
                Dim ende As String = ""
                Dim bb As Button = NadjiKontrolu(Panel1, "DBTNPANE" + GlavnaTabela)
                Dim tboxt2 As String = bb.AccessibleDefaultActionDescription.Split("~")(0)
                If Not tboxt2 Is Nothing AndAlso tboxt2 <> "" Then
                    ende = onenterSKIPOnClick(tboxt2, panel)
                    'vraca na sta treba da se skoci ako je ispunjen uslov, inace  vraca ""
                    If ende <> "" Then
                        Dim en() As String = ende.Split(";")
                        For Each k As Control In panel.Controls
                            If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox Then
                                If Mid(k.Name, 4).Trim.ToUpper = en(0).Trim.ToUpper.Trim.ToUpper Then
                                    panel.AutoScroll = False
                                    tbox.BackColor = SystemColors.ControlLightLight
                                    k.Visible = True
                                    k.BackColor = Color.Bisque
                                    k.Focus()
                                    panel.AutoScroll = True
