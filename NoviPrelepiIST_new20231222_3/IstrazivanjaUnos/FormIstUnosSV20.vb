    Private Function ELPoljeUGresci(ByVal polje As String, ByVal greska As String, Optional ByVal Glavan As Boolean = False) As Boolean

        If greska.Trim.ToUpper.IndexOf("RELACIJA") >= 0 Then
            Dim pug As Boolean = False
            Dim greskaSpajanje() As String = greska.Split(";")(1).Split(":")(0).Split(",")   'pig=pig,rbr=rbr
            For i As Integer = 0 To greskaSpajanje.GetUpperBound(0)
                Dim pp As String = greskaSpajanje(i).Split("=")(0)
                If polje.Trim.ToUpper = pp.Trim.ToUpper Then
                    pug = True
                End If
            Next
            Return pug            ' 
        Else
            Dim gde As Integer = InStr(greska.Trim.ToUpper, polje.Trim.ToUpper)
            If gde <> 0 Then
                Dim sl1 As Char = " "c
                If gde > 1 Then sl1 = Mid(greska.Trim.ToUpper, gde - 1, 1)
                Dim sl2 As Char = " "c
                If gde + polje.Trim.Length <= greska.Trim.Length Then
                    sl2 = Mid(greska.Trim.ToUpper, gde + polje.Trim.Length, 1)
                End If
                'goran 15.05.2012
                If (Not System.Char.IsLetterOrDigit(sl1)) AndAlso (Not System.Char.IsLetterOrDigit(sl2)) AndAlso (sl1 <> "_"c) AndAlso (sl2 <> "_"c) Then
                    If Glavan Then
                        If sl1 <> "."c Then
                            Return True
                        Else
                            Return False
                        End If
                    Else
                        Return True
                    End If
                Else
                    If gde + polje.Trim.Length > greska.Trim.Length Then
                        Return False
                    Else
                        Return ELPoljeUGresci(polje, greska.Substring(gde + polje.Trim.Length), Glavan)
                    End If
                End If
            End If
            Return False
        End If

    End Function

