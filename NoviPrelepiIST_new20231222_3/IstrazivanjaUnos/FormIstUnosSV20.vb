    Private Sub hh_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs)
        bioPageDown = False
        Dim hhchb As CheckBox = CType(sender, CheckBox)
        AktivanCekBoks = hhchb
        Select Case e.KeyCode
            Case Keys.Up
                'SendKeys.Send("+{TAB}")
                If SCati = True Then
                    SendKeys.Send("+{TAB}")

                    ''''''''''''''nensiiiiii tanjaaaaa
                    '''
                ElseIf SCati = False Then

                    Dim plj As String = Mid(hhchb.Name.Trim.ToUpper, 3)

