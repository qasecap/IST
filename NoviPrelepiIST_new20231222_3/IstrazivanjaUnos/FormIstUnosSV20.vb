                Next
                If SCati = False AndAlso grupePitanjaCAPI Is Nothing Then
                    IsprazniKontrole(Me.Panel1)
                ElseIf SCati = False AndAlso Not grupePitanjaCAPI Is Nothing Then
                    For i As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                        IsprazniKontrole(grupePitanjaCAPI(i))
                    Next
                ElseIf SCati = True Then
                    IsprazniKontroleCATI()
                End If
                If IdeDalje Then
                    PopuniJosZaPolja()
                    Return Uspelo
                End If
            End If
        End If ' bezDalje, tj imadalje

        If IdeDalje Then
            PopuniJosZaPolja()
        End If

        Return Uspelo
    End Function

