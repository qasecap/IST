    Private Sub pp_MouseMove(ByVal sender As Object, ByVal e As MouseEventArgs)
        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        If previewEditMode = True Then
            Dim tbox As TextBox = CType(sender, TextBox)
            Dim actb As Boolean = False
            Dim ddod As String = "" : Dim ddodss As String = ""
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                actb = True
                ddod = "AutoComplete TextBox"
            End If
            Dim tip As String = ""
            Dim duzina As String = ""
            If Not tbox.AccessibleDefaultActionDescription Is Nothing Then
                Dim pp() As String = tbox.AccessibleDefaultActionDescription.Split(";")
                'tbox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.vod.tostring("yyyy/MM/dd").trim + ";" + tbox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim + ";" + p.tip + ";" + p.duzina
                ddodss = pp(2) + nvrd + "Type: " + CStr(pp(5)).Trim + ", MaxLength= " + CStr(pp(6)).Trim
                If ddod.Trim <> "" Then ddodss = ddod + nvrd + ddodss
                Me.ToolTip1.SetToolTip(sender, ddodss.Trim)
            Else
                ddodss = ddod + " " + tbox.Name.Substring(2)
                Me.ToolTip1.SetToolTip(sender, ddodss.Trim)
            End If
            nepotrebnavalidacija = False
        End If

        If SCati = False AndAlso previewEditMode = False Then
            Dim tbox As TextBox = CType(sender, TextBox)
            Dim grs() As String = Me.GreskeZaPolje(tbox.Name.Substring(2))
            Dim pomLK(PaneLK.Items.Count - 1) As String
            For i As Integer = 0 To PaneLK.Items.Count - 1
                Dim ppp As String = CType(PaneLK.Items(i), String)
                pomLK(i) = ppp.Substring(0, ppp.IndexOf("-") - 1)
            Next
            Dim tt As String = ""
            For i As Integer = 0 To grs.GetUpperBound(0)
                If Array.IndexOf(pomLK, grs(i)) >= 0 Then
                    If tt.Trim.Length > 0 Then tt = tt & Chr(13)
                    tt = tt & CType(PaneLK.Items(Array.IndexOf(pomLK, grs(i))), String)
                    tt = ZameniGGGMMMUnos(tt)
                End If
            Next
            Me.ToolTip1.SetToolTip(sender, tt)
            nepotrebnavalidacija = False
        End If

    End Sub

