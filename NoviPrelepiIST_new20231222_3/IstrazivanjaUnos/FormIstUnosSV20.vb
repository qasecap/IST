    Function sklopiButtonZaPodTabelu(ByVal t As String, ByVal opis As String, ByVal tabBtn As Button,
                ByVal T2 As String, ByVal dw As Integer, ByVal dh As Integer,
                ByVal odakle As Integer, ByVal xx As Integer, ByVal yy As Integer,
                ByVal imaPlus As Boolean, ByVal tabVod As String) As Integer

        Dim naslovBold As Boolean = False
        Dim naslovItalic As Boolean = False
        Dim naslovUnderline As Boolean = False
        Dim naslovVisina As Integer = 1
        Dim naslovFontSize As Integer = 0
        Dim naslovDesno As Boolean = False
        Dim naslovCentar As Boolean = False
        Dim naslovForeColor As String = ""
        Dim naslovBackColor As String = ""
        Dim naslovForeColorOpis As String = ""
        Dim naslovBackColorOpis As String = ""
        Dim nonvisible As Boolean = False
        'Dim buttoncaption As String = ""
        'default
        tabBtn.Name = "BTN" & t.Trim.ToUpper
        tabBtn.TextAlign = ContentAlignment.MiddleLeft
        'tabBtn.FlatStyle = FlatStyle.Popup
        tabBtn.FlatStyle = FlatStyle.Flat
        tabBtn.FlatAppearance.MouseOverBackColor = Color.Silver
        tabBtn.BackColor = Color.Gainsboro 'SystemColors.Control
        tabBtn.Cursor = Cursors.Hand

        If xx = 0 AndAlso yy = 0 Then
            tabBtn.Location = New Point(odakle + novoPomeriDesnoZaBivsiBorderWidth, Me.Panel1.Height + 5)  '5 je za razmak izmedju poslednjeg polja i prvog dugmeta
        ElseIf xx <> 0 AndAlso yy = 0 Then
            tabBtn.Location = New Point(xx + novoPomeriDesnoZaBivsiBorderWidth, Me.Panel1.Height + 5)
        ElseIf xx = 0 AndAlso yy <> 0 Then
            tabBtn.Location = New Point(odakle + novoPomeriDesnoZaBivsiBorderWidth, yy)
        ElseIf xx <> 0 AndAlso yy <> 0 Then
            tabBtn.Location = New Point(xx + novoPomeriDesnoZaBivsiBorderWidth, yy)
        End If
        Dim kakoL() As String = T2.Split(";")
        If kakoL.Length > 0 Then
            For iii As Integer = 0 To kakoL.Length - 1
                kakoL(iii) = kakoL(iii).Trim.ToUpper
                If kakoL(iii).IndexOf("FONTBOLD") >= 0 Then
                    naslovBold = True
                    'ElseIf kakoL(iii).IndexOf("BUTTONCAPTION") >= 0 Then
                    '    kakoL(iii) = NZ(Replace(kakoL(iii), "buttoncaption", "", 1, , CompareMethod.Text)).trim
                    '    buttoncaption = kakoL(iii).Replace("=", "").Trim
                ElseIf kakoL(iii).IndexOf("FONTSIZE") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FONTSIZE", "")
                    If IsNumeric(kakoL(iii)) = True Then naslovFontSize = CInt(kakoL(iii))
                ElseIf kakoL(iii).IndexOf("FONTITALIC") >= 0 Then
                    naslovItalic = True
                ElseIf kakoL(iii).IndexOf("FONTUNDERLINE") >= 0 Then
                    naslovUnderline = True
                ElseIf kakoL(iii).IndexOf("LDESNOP") >= 0 OrElse kakoL(iii).IndexOf("LRIGHTA") >= 0 Then
                    naslovDesno = True
                ElseIf kakoL(iii).IndexOf("LCENTARP") >= 0 OrElse kakoL(iii).IndexOf("LCENTERA") >= 0 OrElse kakoL(iii).IndexOf("LCENTREA") >= 0 Then
                    naslovCentar = True
                ElseIf kakoL(iii).IndexOf("FORECOLOR") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FORECOLOR", "")
                    naslovForeColor = kakoL(iii)
                ElseIf kakoL(iii).IndexOf("BACKCOLOR") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("BACKCOLOR", "")
                    naslovBackColor = kakoL(iii)
                ElseIf kakoL(iii).IndexOf("BUTTONWIDTH") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("BUTTONWIDTH", "").Replace("=", "").Trim
                    dw = CInt(kakoL(iii))
                ElseIf kakoL(iii).IndexOf("BUTTONHEIGHT") >= 0 Then
                    kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("BUTTONHEIGHT", "").Replace("=", "").Trim
                    dh = CInt(kakoL(iii))
                ElseIf kakoL(iii).IndexOf("BUTTONVISIBLEFALSE") >= 0 Then
                    nonvisible = True
                ElseIf kakoL(iii).Trim.ToUpper.IndexOf("STOPIF=") = 0 Then
                    tabBtn.AccessibleDefaultActionDescription = tabBtn.AccessibleDefaultActionDescription + kakoL(iii) + ";"
                ElseIf kakoL(iii).Trim.ToUpper.IndexOf("STOPMSG=") = 0 Then
                    tabBtn.AccessibleDefaultActionDescription = tabBtn.AccessibleDefaultActionDescription + kakoL(iii) + ";"
                ElseIf kakoL(iii).Trim.ToUpper.IndexOf("STOPMSGFOCUSON=") = 0 Then
                    tabBtn.AccessibleDefaultActionDescription = tabBtn.AccessibleDefaultActionDescription + kakoL(iii) + ";"
                ElseIf kakoL(iii).Trim.ToUpper.IndexOf("STOPMSGONPNL") = 0 Then
                    tabBtn.AccessibleDefaultActionDescription = tabBtn.AccessibleDefaultActionDescription + kakoL(iii) + ";"
                End If
            Next
        End If
        sklopiButtonZaPodTabelu = dw
        If Not opis Is Nothing Then
            opis = opis.TrimEnd(";", "").TrimEnd("$", "")
            kakoL = opis.Split("$")
            If kakoL.Length > 0 Then
                For iii As Integer = 0 To kakoL.Length - 1
                    kakoL(iii) = kakoL(iii).Trim.ToUpper
                    If kakoL(iii).IndexOf("FONTBOLD") >= 0 Then
                        naslovBold = True
                    ElseIf kakoL(iii).IndexOf("FONTSIZE") >= 0 Then
                        kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FONTSIZE", "")
                        If IsNumeric(kakoL(iii)) = True Then naslovFontSize = CInt(kakoL(iii))
                        naslovVisina = 2
                    ElseIf kakoL(iii).IndexOf("FONTITALIC") >= 0 Then
                        naslovItalic = True
                    ElseIf kakoL(iii).IndexOf("FONTUNDERLINE") >= 0 Then
                        naslovUnderline = True
                    ElseIf kakoL(iii).IndexOf("LDESNOP") >= 0 OrElse kakoL(iii).IndexOf("LRIGHTA") >= 0 Then
                        naslovDesno = True
                    ElseIf kakoL(iii).IndexOf("LCENTARP") >= 0 OrElse kakoL(iii).IndexOf("LCENTERA") >= 0 OrElse kakoL(iii).IndexOf("LCENTREA") >= 0 Then
                        naslovCentar = True
                    ElseIf kakoL(iii).IndexOf("LHEIGHT") >= 0 OrElse kakoL(iii).IndexOf("LVISINA") >= 0 Then
                        kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("LHEIGHT", "")
                        kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("LVISINA", "")
                        If IsNumeric(kakoL(iii)) = True Then naslovVisina = CInt(kakoL(iii))
                    ElseIf kakoL(iii).IndexOf("FORECOLOR") >= 0 Then
                        kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("FORECOLOR", "")
                        naslovForeColorOpis = kakoL(iii)
                    ElseIf kakoL(iii).IndexOf("BACKCOLOR") >= 0 Then
                        kakoL(iii) = kakoL(iii).Trim.ToUpper.Replace("BACKCOLOR", "")
                        naslovBackColorOpis = kakoL(iii)
                    End If

                Next
            End If

            opis = NZ(Replace(opis, "fontbold", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "fontitalic", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "fontunderline", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "ldesnop", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lcentarp", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lrighta", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lcentera", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lcentrea", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "forecolor", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "backcolor", "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, naslovForeColorOpis.ToLower, "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, naslovBackColorOpis.ToLower, "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "fontsize" + CStr(naslovFontSize).Trim, "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lvisina" + CStr(naslovVisina).Trim, "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "lheight" + CStr(naslovVisina).Trim, "", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "$$", "$", 1, , CompareMethod.Text)).Trim
            opis = NZ(Replace(opis, "$", "", 1, , CompareMethod.Text)).Trim
        End If

        Dim defaultSize As Integer = 10   ' 10.0!

        If naslovBackColor <> "" Then
            tabBtn.BackColor = Color.FromName(naslovBackColor)
        End If
        If naslovForeColor <> "" Then
            If naslovBackColor = "" Then tabBtn.BackColor = RGBColors.mBackColor 'SystemColors.Control
            tabBtn.ForeColor = Color.FromName(naslovForeColor)
        End If
        If naslovDesno = True Then tabBtn.TextAlign = ContentAlignment.MiddleRight
        If naslovCentar = True Then tabBtn.TextAlign = ContentAlignment.MiddleCenter
        If naslovFontSize = 0 Then naslovFontSize = 10

        Dim fftt As FontStyle = FontStyle.Regular
        Dim ffttB As FontStyle = FontStyle.Bold
        Dim ffttI As FontStyle = FontStyle.Italic
        Dim ffttU As FontStyle = FontStyle.Underline

        'B I U
        If naslovBold = True And naslovItalic = True And naslovUnderline = True Then fftt = ffttB Or ffttI Or ffttU
        If naslovBold = True And naslovItalic = True And naslovUnderline = False Then fftt = ffttB Or ffttI
        If naslovBold = True And naslovItalic = False And naslovUnderline = False Then fftt = ffttB
        If naslovBold = True And naslovItalic = False And naslovUnderline = True Then fftt = ffttB Or ffttU
        If naslovBold = False And naslovItalic = True And naslovUnderline = True Then fftt = ffttI Or ffttU
        If naslovBold = False And naslovItalic = False And naslovUnderline = True Then fftt = ffttU
        If naslovBold = False And naslovItalic = True And naslovUnderline = False Then fftt = ffttI

        tabBtn.Font = New Font("Verdana", naslovFontSize, fftt)
        tabBtn.Width = dw
        tabBtn.Height = dh

        'If buttoncaption <> "" Then
        '    tabBtn.Text = buttoncaption
        'Else
        'End If
        Dim MLopis As String = getMultilanguageLabel(mdtLabel, txtmode, t, "", "td", Me.jezik)
        If MLopis = "" Then
            If Not opis Is Nothing AndAlso opis.Length > 0 Then
                tabBtn.Text = NZ(Replace(opis, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
            Else
                tabBtn.Text = t
            End If
        Else
            tabBtn.Text = NZ(Replace(MLopis, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
        End If

        If nonvisible = True Then tabBtn.Visible = False : tabBtn.AccessibleName = tabBtn.AccessibleName + "VF;"

        Dim pom As String = ""
        If imaPlus = False Then tabBtn.AccessibleDescription = tabBtn.AccessibleDescription + "NOPLUS;"

        If previewEditMode = True Then
            tabBtn.ContextMenuStrip = mnu02
            tabBtn.AccessibleDefaultActionDescription = t + ";" + tabVod + ";" + tabBtn.Name.Substring(2) + ";" + "" + ";" + ""
        End If

    End Function

    Public maxvisinatab As Integer

    Sub sklopiDataGridViewPanel(ByVal trtT2 As String, ByVal kojatabela As Integer, ByVal paneltab As Boolean, ByVal kojitab As Integer, ByVal tablocationy As Integer,
ByVal pane As Panel, ByVal t As String)
        'datagrid sa podacima

        Dim dgPanel As New DataGridView
        dgPanel.ReadOnly = True
        dgPanel.Tag = "panel"
        dgPanel.Font = New Font("Verdana", 8.0!)
        dgPanel.BorderStyle = BorderStyle.None
        If paneltab = True Then
            If kojatabela = 1 Then Me.Panel1.Height = Me.Panel1.Height + pane.Height
            dgPanel.Location = New Point(0, tablocationy + pane.Height)
        Else
            Me.Panel1.Height = Me.Panel1.Height + pane.Height
            dgPanel.Location = New Point(0, Me.Panel1.Height)
        End If
        dgPanel.Width = Me.Panel1.Width - 25
        dgPanel.TabStop = False
        dgPanel.TabIndex = 0
        dgPanel.Name = t.Trim.ToUpper
        AddHandler dgPanel.MouseDown, AddressOf Me.DGMouseDownPanel
        AddHandler dgPanel.MouseDoubleClick, AddressOf Me.DGMouseDoubleKlikPanel
        AddHandler dgPanel.Scroll, AddressOf Me.DG_ScrollPanel

        If PravaDupeGlava(t) Then
            'default je dgPanel.Height=80
            Dim defaultH As Integer = 3 * 80
            dgPanel.Height = defaultH
            Dim pp() As String
            If trtT2.Length > 0 Then
                pp = trtT2.Trim.ToUpper.Split(";")
                For i As Integer = 0 To pp.GetUpperBound(0)
                    If pp(i).Trim = "MIN" Then dgPanel.Height = defaultH \ 3
                    If pp(i).Trim = "MAX" Then dgPanel.Height = 2 * 3 * defaultH
                    If pp(i).Trim = "GRIDHEIGHT" Then
                        Try
                            Dim a As String = trtT2.Substring(trtT2.Trim.ToUpper.IndexOf("GRIDHEIGHT"))
                            Dim aa() As String = a.Split(";")
                            Dim visina As Integer = aa(0).Split("=")(1)
                            dgPanel.Height = visina
                        Catch ex As Exception
                            'ISTMessageBox.Show("Није добра синтакса код висине грида!" + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            ''msg 26
                            Dim msgtxt As String = getMessageText(dtMessages, "26", Me.jezik)
                            ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        End Try
                    End If
                Next
            End If

        End If

        dgPanel.DataSource = DGTabele(DGi(t.Trim.ToUpper))
        dgPanel.SendToBack()
        Me.Panel1.Controls.Add(dgPanel)
        If paneltab = True Then
            If (pane.Height + dgPanel.Height) > maxvisinatab Then maxvisinatab = pane.Height + dgPanel.Height
        End If
        Call srediGridView(dgPanel, True, 30)
        If paneltab = False Then Me.Panel1.Height = Me.Panel1.Height + dgPanel.Height
        If paneltab = True AndAlso kojatabela > 1 Then dgPanel.Visible = False

        If paneltab = True AndAlso kojatabela = 1 Then
            pane.Visible = True
            Me.Panel1.Height = Me.Panel1.Height + dgPanel.Height + 25
        End If

    End Sub

