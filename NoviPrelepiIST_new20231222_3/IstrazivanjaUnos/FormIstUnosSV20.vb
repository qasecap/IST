    Private Function fAwl(ByVal ds As DatasetIstrazivanja, ByVal app As String) As DataTable
        Dim dtN As New DataTable
        'tabele koje postoje u ISTTabele
        Dim ttabele As String = ""
        For i As Integer = 0 To ds.ISTTABELE.Rows.Count - 1
            ttabele = ttabele + "N'" + DirectCast((ds.ISTTABELE.Rows(i)), DatasetIstrazivanja.ISTTABELERow).Tabela + "',"
        Next
        ttabele = ttabele.TrimEnd(CType(",", Char()))

        Dim sql As String = "select * from ISTAWLs where sifist=N'" + app.Trim + "' and tabela in (" + ttabele + ") " +
            " and vod <= Convert(DateTime, DateAdd(Month, DateDiff(Month, 0, '" + vtvt + "'), 0), 126) " +
            " and '" + vtvt + "' <= vdo  order by tabela,polje"

        Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Nothing)
        If dt.Rows.Count > 0 Then
            For i As Integer = 0 To dt.Rows.Count - 1
                dtN.ImportRow(dt.Rows(i))
            Next
        End If

        fAwl = dtN
        dt.Clear()
        dt.Dispose()
        dt = Nothing

        dtN.Clear()
        dtN.Dispose()
        dtN = Nothing
    End Function
    Private Function fQExplanation(ByVal ds As DatasetIstrazivanja, ByVal app As String) As DataTable
        Dim dtN As New DataTable
        fQExplanation = Nothing
        'tabele koje postoje u ISTTabele
        Dim ttabele As String = ""
        For i As Integer = 0 To ds.ISTTABELE.Rows.Count - 1
            ttabele = ttabele + "N'" + DirectCast((ds.ISTTABELE.Rows(i)), DatasetIstrazivanja.ISTTABELERow).Tabela + "',"
        Next
        ttabele = ttabele.TrimEnd(CType(",", Char()))

        Dim sql As String = "select * from ISTQuestionExplanation where sifist=N'" + app.Trim + "' and tabela in (" + ttabele + ") " +
            " and vod <= Convert(DateTime, DateAdd(Month, DateDiff(Month, 0, '" + vtvt + "'), 0), 126) " +
            " and '" + vtvt + "' <= vdo  order by tabela,polje"

        Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Nothing)
        If dt.Rows.Count > 0 Then
            For i As Integer = 0 To dt.Rows.Count - 1
                dtN.ImportRow(dt.Rows(i))
            Next
        End If

        fQExplanation = dtN
        dt.Clear()
        dt.Dispose()
        dt = Nothing

        dtN.Clear()
        dtN.Dispose()
        dtN = Nothing
    End Function
