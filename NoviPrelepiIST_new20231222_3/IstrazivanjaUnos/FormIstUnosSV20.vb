    Private Sub SklopiOstale(ByVal izazur As Boolean)

        poslednjiuPanelu = ""
        poslednjinaFormi = ""

        Dim opis() As String = {}
        Dim T2() As String = {}
        Dim Baza() As String = {}
        Dim tabele() As String = {GlavnaTabela}
        Dim nadTab() As String = {}
        Dim TabeleVod() As String = {GlavnaTabelaVOD}
        Dim TabeleRbr() As Integer = {}
        Dim i As Integer
        Dim ZadnjiTabIndex As Integer

        Dim Tabelice(,) As Integer = Nothing '"2.4.3" ,tj. 0-oznaka "tabele",1-redova,2-kolona,3-ucitana,4,5-X,Y od pocetka panel1,6-

        If redoviMEMForma Is Nothing OrElse redoviMEMForma.Length = 0 Then
        Else
            NapuniTabelice(Tabelice)
            NapuniTabelicaKolonaDuzina()
        End If

        Dim redoviTabele() As DataRow = Me.dIst.ISTTABELE.Select("2=2", "baza ASC")

        Dim rt As DatasetIstrazivanja.ISTTABELERow
        For nmnm As Integer = 0 To redoviTabele.GetUpperBound(0)
            rt = redoviTabele(nmnm)
            If (Not rt.IsNadTabelaNull) AndAlso rt.NadTabela.Trim.ToUpper = Me.GlavnaTabela Then
                i = 1 + tabele.GetUpperBound(0)
                ReDim Preserve tabele(i)
                ReDim Preserve opis(i)
                ReDim Preserve T2(i)
                ReDim Preserve nadTab(i)
                ReDim Preserve Baza(i)
                ReDim Preserve TabeleVod(i)
                TabeleVod(i) = rt.Vod.ToString("yyyy/MM/dd").Trim
                tabele(i) = rt.Tabela.Trim.ToUpper
                opis(i) = rt.Opis.Trim
                T2(i) = IIf(rt.Item("T2") Is System.DBNull.Value, "0", rt.Item("T2"))
                Baza(i) = IIf(rt.Item("Baza") Is System.DBNull.Value, "0", rt.Item("Baza"))
                nadTab(i) = IIf(rt.Item("nadTabela") Is System.DBNull.Value, "", rt.Item("nadTabela"))
                ReDim Preserve TabeleRbr(i)
                Dim rbrT As Integer = IIf(rt.Item("RbrUnos") Is System.DBNull.Value, 0, rt.Item("RbrUnos"))    'Val(t.Opis.Trim)
                If rbrT <> 0 AndAlso Not Tabelice Is Nothing AndAlso Tabelice.GetUpperBound(1) >= rbrT Then
                    If PravaDupeGlava(tabele(i)) Then
                        Tabelice(0, rbrT - 1) = -1 ' 1-N
                    Else
                        Tabelice(0, rbrT - 1) = -2 ' 1-1
                    End If
                    TabeleRbr(i) = rbrT
                Else
                    TabeleRbr(i) = 0
                End If
            End If
        Next

        diFP = -1
        diFPGlava = -1
        diFPPK = -1
        diFPnPK = -1
        diPKPanel = -1
        diPKSamoPanel = -1
        diPanel = -1
