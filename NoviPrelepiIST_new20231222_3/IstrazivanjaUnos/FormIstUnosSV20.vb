        'Me.Cursor = Cursors.WaitCursor
        If dgvGRID.Name Is Nothing OrElse dgvGRID.Name = "" Then
            Exit Sub
        End If

        If Not grupePitanjaCAPI Is Nothing Then Call backToFirstCAPI(True)

        Dim imeTabele As String = "###" + dgvGRID.Name.Trim.ToUpper
        imeTabele = imeTabele.Replace("###IDGV", "")

        Try
            Dim KljuceviSaEkranaSaVrednostima(,) As String
