        SklopiOstalePanel = zadnjitabindex
        'poslednjiuPanelu = poslednjiuPanelu + panel.Name + "$" + CStr(zadnjitabindex) + ";"
        poslednjiuPanelu = poslednjiuPanelu + panel.Name + "$" + poslednjeObicnoPoljeP.Trim.ToUpper + ";"
        prviuPanelu = prviuPanelu + panel.Name + "$" + prvoObicnoPoljeP.Trim.ToUpper + ";"

