                                        End If
                                    End If
                                    If pomocnoDaIskocimIzFora = 1 Then Exit For
                                Next
                            Next
                        End If
                    Catch ex As Exception
                        ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Finally
                    End Try
                Next
            End If 'samoCitaAko.Length
