            tbox.BackColor = Color.Bisque
            okvalidacija = False
            Me.Cursor = Cursors.Default
            Exit Sub
        End Try

        bbiloskakanje = False
        bbilaporuka = False

        Dim menjanKljuc As Boolean = False

        If (Not Me.BtnExit.Focused) AndAlso mrt Then 'dakle, IMA GRESAKA !!!!

            If autb = False AndAlso autbDB = False AndAlso Not tbox.Tag Is Nothing Then
                okvalidacija = False
                Dim ddd As DataTable = vratiDTIzKAR(tbox)
                If ddd Is Nothing Then
                    ''msg 283
                    Dim msgtxt283 As String = getMessageText(dtMessages, "283", Me.jezik)
                    Dim por As String = msgtxt283
                    ISTMessageBox.Show(por, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Me.Cursor = Cursors.Default
                    Me.Close()
                    Exit Sub
                End If
                If ddd.Rows.Count = 0 Then
                    MsgBox("YOU DON'HAVE ANYTHING IN " + nvrd + nvrd + "ADDRESSBOOK OR RELACIJA OR KONSULT " + nvrd + nvrd + "FOR THIS TIME POINT!", vbInformation, "")
                    Me.Cursor = Cursors.Default
                    Me.Close()
                    Exit Sub
                End If
                Dim lx As Integer = Me.Left + tbox.Parent.Left 'Parent,jer je textbox u GroupBoxu
                Dim ly As Integer = Me.Top + tbox.Parent.Top + tbox.Parent.Height + 15
                If tbox.Tag.Tip = "K" Then
                    Dim kip() As String = {tbox.Tag.Rel(2)}
                    Dim kvp() As String = {tbox.Text}
                    Dim GetIzbor As New FrmIzbor(ddd, lx, ly, jezik, kip, kvp)
