    Sub srediRelPolje(p As DatasetIstrazivanja.ISTPOLJARow)
        If Not p.IsRelPoljeNull Then
            Dim prelpolje As String = p.RelPolje.Trim.ToUpper
            If (prelpolje.IndexOf("VALUE=") > 0 OrElse prelpolje.IndexOf("DISPLAY=") > 0) Then
                If prelpolje.IndexOf(";") < 0 Then prelpolje = prelpolje + ";"
                Dim pim() As String = prelpolje.Split(";")
                Dim pimk As String = ""
                For im As Integer = 0 To pim.GetUpperBound(0)
                    If pim(im).IndexOf("VALUE=") = 0 Then
                        pimk = pim(im).Replace("VALUE=", "")
                    End If
                Next
                If pimk = "" Then pimk = p.POLJE
                p.RelPolje = pimk
            End If
        End If
    End Sub

