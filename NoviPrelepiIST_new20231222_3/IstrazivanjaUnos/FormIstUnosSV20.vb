    Sub fixPanelAfterJump(ByVal kp As Control, ByVal pp As Panel, ByVal skippedEnabledFalse As Boolean,
                        ByVal skippedVisibleFalse As Boolean, ByVal skippedDontSave As Boolean,
                        ByVal skippedSetEmpty As Boolean)
        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, pp)
        If Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
            nepotrebnavalidacijaPanel = True
            Dim b As Integer = blok(ipanel, kp)
            Call nevidljivBlokPanelSviSem(ipanel, b)
            kp.Focus()
            nepotrebnavalidacijaPanel = False
        End If

        If grupeCNTLBlokoviPanel(ipanel) Is Nothing Then


            Dim kkkp() As String = kp.AccessibleDescription.Split(";")
            Dim nizskociNAsssrbrkp As Integer = kkkp(0)
            For Each m As Control In pp.Controls
                If TypeOf m Is TextBox AndAlso Mid(m.Name, 1, 3) <> "DTK" Then
                    Dim kk() As String = m.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    If 0 < krbr AndAlso krbr < nizskociNAsssrbrkp Then
                        Dim plj As String = Mid(m.Name, 4).Trim.ToUpper
                        If skippedEnabledFalse = True AndAlso Mid(m.Name, 2, 1) <> "F" Then m.Enabled = False
                        If skippedVisibleFalse = True Then m.Visible = False

                        If skippedSetEmpty = True AndAlso Mid(m.Name, 2, 1) <> "F" Then
                            m.Text = ""
                            Me.UpisiPoljePanel(Mid(m.Name, 4).Trim.ToUpper, pp.Name.Replace("PANE_", ""), pp)
                        End If

                    ElseIf krbr > nizskociNAsssrbrkp Then
                        If Mid(m.Name, 2, 1) <> "F" Then m.Enabled = True 'da ostanu fp
                        If Mid(m.Name, 2, 1) = "F" Then
                            If m.Tag.izraz <> "''" Then
                                m.Enabled = True
                                m.Visible = True
                            Else
                                m.Visible = False
                            End If
                        End If
                    End If
                End If
            Next
        End If

    End Sub

