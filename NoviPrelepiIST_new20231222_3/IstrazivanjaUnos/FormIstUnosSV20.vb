    Private Sub pp_Validating(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)   ' LostFocus

        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        'ISTMessageBox.Show("pp_Validating")

        Dim tbox As Control = sender
        Dim panel As Panel = tbox.Parent

        mouseleavePOLJE = tbox
        mouseleavePanel = Nothing
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 3)

        If Not grupePitanjaCAPIButton Is Nothing AndAlso grupePitanjaCAPIButton.Length > 0 Then
            For i As Integer = 0 To grupePitanjaCAPIButton.GetUpperBound(0)
                If grupePitanjaCAPIButton(i).Focused Then
                    grupePitanjaCAPIButton(i).Tag = tbox
                End If
            Next
        End If

        Dim autb As Boolean = False
        If Not tbox.AccessibleName Is Nothing Then tbox.AccessibleName = tbox.AccessibleName + ";" : tbox.AccessibleName = tbox.AccessibleName.Replace(";;", ";")
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
            tbox = CType(sender, AutoCompleteTextbox)
            autb = True
            If CType(sender, AutoCompleteTextbox).cT = True Then     'panel od autb ima fokus
                Exit Sub
            End If
        Else
            tbox = CType(sender, TextBox)
        End If

        If autb = True AndAlso CType(sender, AutoCompleteTextbox).nepotrebnavalidacija = False Then
            'DA NE RADI VALIDACIJU ULEVO ZA AUTB NIKAD; TAKAV JE DOGOVOR,
            'AUTOCOMPLETETEXTBOXDODELA
            nepotrebnavalidacija = False
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                If tbox.Text.Trim <> acoldvalue Then
                    Call ddodelaAutoComplete(tbox, plj, tbox.Parent)
                End If
            End If
            'AUTOCOMPLETETEXTBOXDODELA
            tbox.BackColor = bojaPocTextbox
            ' Exit Sub
        End If
        If autb = True AndAlso CType(sender, AutoCompleteTextbox).nepotrebnavalidacija = True Then
            nepotrebnavalidacija = True
        End If

        If SCati = True AndAlso nepotrebnavalidacijaCATI = True Then
            tbox.BackColor = bojaPocTextbox
        ElseIf SCati = True AndAlso nepotrebnavalidacijaCATI = False Then
            Call pp_Validacija(sender, e, SCati, "pp_Validating")
        ElseIf SCati = False AndAlso nepotrebnavalidacija = False Then
            Dim dugmetabfokus As Boolean = False
            Dim dugmetabfokusdugme As Button
            If Not (nizdugmeTab Is Nothing) Then
                For i As Integer = 0 To nizdugmeTab.GetUpperBound(0)
                    If nizdugmeTab(i).Focused() Then
                        dugmetabfokus = True
                        dugmetabfokusdugme = nizdugmeTab(i)
                        Exit For
                    End If
                Next
            End If
            If dugmetabfokus = True Then
                Call pp_Validacija(sender, e, SCati, "pp_Validating", dugmetabfokus)
            Else
                Call pp_Validacija(sender, e, SCati, "pp_Validating")
            End If
        ElseIf SCati = False AndAlso nepotrebnavalidacija = True Then
            'iskljuceno kad je dodato   nepotrebnavalidacija = True ispred svakog fokusa
            'tbox.BackColor = bojaPocTextbox
        End If

    End Sub

    Function breakPoruke(ByVal sporuka1 As String) As String
        breakPoruke = ""
        sporuka1 = sporuka1.TrimStart("'").TrimEnd("'")
        sporuka1 = NZ(Replace(sporuka1, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
        sporuka1 = NZ(Replace(sporuka1, "< br >", vbCrLf, 1, , CompareMethod.Text)).Trim
        sporuka1 = NZ(Replace(sporuka1, "<br >", vbCrLf, 1, , CompareMethod.Text)).Trim
        sporuka1 = NZ(Replace(sporuka1, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
        breakPoruke = sporuka1
    End Function


    Function sklopiPoruka(ByVal poruka As String) As String
        poruka = poruka.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Replace("***", "")
        Dim MLopis As String = getMultilanguageMessage(mdtMessage, txtmode, poruka, Me.jezik)
        If MLopis <> "" Then poruka = MLopis
        Dim bbb() As String = razkvantaj(poruka, True)
        For ii As Integer = 0 To bbb.GetUpperBound(0)
