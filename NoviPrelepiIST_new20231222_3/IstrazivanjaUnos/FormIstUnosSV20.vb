    Private Sub IsprazniKontrolekojeNisuKljucCATI2(p As Panel)
        For Each k As Control In p.Controls
            If Not TypeOf k Is Label Then
                If TypeOf k Is TextBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse TypeOf k Is ComboBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                    k.Text = ""
                    k.BackColor = SystemColors.ControlLightLight ' za slucaj da je zaostala LK
                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("LG;") >= 0 Then k.BackColor = Color.LightGray
                End If
                If Mid(k.Name.Trim.ToUpper, 1, 7) = "POMOCNO" Then
                    k.Text = ""
                    k.BackColor = SystemColors.ControlLightLight
                End If
                'If Mid(k.Name.Trim.ToUpper, 1, 2) = "FP" Then k.Text = Nothing
                If Mid(k.Name.Trim.ToUpper, 1, 2) = "FP" AndAlso Not nizFPNisuLabele Is Nothing AndAlso Array.IndexOf(nizFPNisuLabele, k) > -1 Then   'nije labela
                    k.Text = Nothing   'samo ako nisu one koje glume labele
                End If

                If k.GetType Is GetType(DataGridView) Then
                    CType(k, DataGridView).DataSource = DGTabele(DGi(k.Name.Trim.ToUpper))
                    k.Refresh()
                End If
                If k.GetType Is GetType(CheckBox) Then
                    CType(k, CheckBox).Checked = False
                    k.Refresh()
                End If
                If Mid(k.Name.Trim.ToUpper, 1, 2) = "RG" Then 'AndAlso k.Enabled = True Then
                    ClearRadio(k)
                End If
                If k.GetType Is GetType(DateTimePicker2) Then
                    CType(k, DateTimePicker2).Format = DateTimePickerFormat.Custom
                    CType(k, DateTimePicker2).CustomFormat = " "
                    CType(k, DateTimePicker2).Refresh()
                End If
            End If
        Next
