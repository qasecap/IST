                If panel.AutoScroll = True Then ap = 1 : panel.AutoScroll = False
                If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName <> "" Then
                    If panel.AccessibleName.Trim.ToUpper.IndexOf("VERTICALSCROLLVISIBLEFALSE") >= 0 Then
