                    Dim xx As Integer = GetIzbor.Izabran
                    Dim xRed As DataRow = GetIzbor.IzabranRed
                    GetIzbor.Dispose()
                    If Not xRed Is Nothing Then tbox.Text = xRed(tbox.Tag.Rel(2)) : okvalidacija = True
                ElseIf tbox.Tag.Tip = "A" Then
