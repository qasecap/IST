    Private Function SEK(ByVal polje As String) As String

        Dim autbDB As Boolean = False
        For Each k1 As Control In Me.Controls
            If TypeOf k1 Is GroupBox AndAlso Mid(k1.Name, 1, 2).Trim.ToUpper = "GB" Then
                For Each k As Control In k1.Controls
                    autbDB = False
                    If TypeOf k Is TextBox AndAlso Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("AUTBDB") >= 0 Then autbDB = True
                    If TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) = "T" AndAlso autbDB = False Then
                        If Mid(k.Name, 3).Trim.ToUpper = polje.Trim.ToUpper Then
                            Return k.Text.Trim
                            'Exit For
                        End If
                    End If
                    If TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) = "T" AndAlso autbDB = True Then
                        If Mid(k.Name, 3).Trim.ToUpper = polje.Trim.ToUpper Then
                            If CType(k, AutoCompleteTextbox).sselectedValue = "" AndAlso CType(k, AutoCompleteTextbox).autoCompleteLimitToList = False Then
                                Return CType(k, AutoCompleteTextbox).Text
                            Else
                                Return CType(k, AutoCompleteTextbox).sselectedValue
                            End If
                            'Exit For
                        End If
                    End If
                    If TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 5) = "TKGOD" And ImaGodE Then
                        If polje.Trim.ToUpper = "ISTYEAR" Then
                            Return k.Text.Trim
                            'Exit For
                        End If
                    End If
                    If TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 5) = "TKMES" And ImaMesE Then
                        If polje.Trim.ToUpper = "ISTMONTH" Then
                            Return k.Text.Trim
                            'Exit For
                        End If
                    End If
                    If TypeOf k Is ComboBox Then
                        If Mid(k.Name, 3).Trim.ToUpper = polje.Trim.ToUpper Then
                            Return CType(k, ComboBox).SelectedValue
                            'Exit For
                        End If
                    End If
                    If TypeOf k Is DateTimePicker2 Then
                        If Mid(k.Name, 3).Trim.ToUpper = polje.Trim.ToUpper Then
                            Dim pom As String = CType(k, DateTimePicker2).Value.ToString("yyyy/MM/dd").Trim
                            pom = izbaciPT(pom)
                            Return pom
                            'Exit For
                        End If
                    End If
                Next
            End If
        Next
        Return ""
    End Function
