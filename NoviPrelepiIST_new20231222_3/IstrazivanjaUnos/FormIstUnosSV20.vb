        'bbss = k
        nname = nname.Trim.ToUpper
        optionMSGskok = Nothing
        Dim nizskociNAsssrbr As Integer
        Dim trtrbr As Integer = 0
        If Not cntl.AccessibleDescription Is Nothing Then trtrbr = cntl.AccessibleDescription.Split(";")(0)

        If grupePitanjaCAPI Is Nothing Then
            If nname = "DUGMEDALJE" OrElse nname = "BUTTONNEXT" Then
                Me.BtnSaveNext.Focus()
                nizskociNAsssrbr = 100000000
            ElseIf nname = "DUGMESACUVAJ" OrElse nname = "BUTTONSAVE" Then
                Me.BtnSave1.Focus()
                nizskociNAsssrbr = 100000000
            ElseIf nname.IndexOf("TABELA") = 0 Then
                'skace na dupe
                nname = nname.Replace("TABELA", "BTN")
                For Each kk As Control In Me.Panel1.Controls
                    If kk.Name.Trim.ToUpper = nname.Trim.ToUpper Then
                        kk.Enabled = True
                        kk.Visible = True
                        kk.Focus()
                        Exit For
                    End If
                Next
            ElseIf nname.IndexOf("PANEL") = 0 Then
                'skace na dupe koje je panel, tj skace na prvo polje u panelu
                nname = nname.Replace("PANEL", "PANE_")
                For Each kk As Control In Me.Panel1.Controls
                    If kk.Name.Trim.ToUpper = nname.Trim.ToUpper Then
                        kk.Enabled = True
                        kk.Visible = True
                        kk.Focus()
                        Exit For
                    End If
                Next
            Else
                'moze i za prazno AND ispunjen USLOV, u uslovu stavi da nije prazno
                For Each kk As Control In Me.Panel1.Controls
                    If Mid(kk.Name, 1, 1) = "T" OrElse Mid(kk.Name, 1, 1) = "C" Then
                        If Mid(kk.Name, 3).Trim.ToUpper = nname.Trim.ToUpper Then
                            kk.Enabled = True
                            kk.Visible = True
                            kk.Focus()
                            Exit For
                        End If
                    End If
                Next
            End If

            Call skippedOptionMSGskok(Panel1, nname, oMSGIF, nizskociNAsssrbr, trtrbr, oMSGskippedEnabledFalse, oMSGskippedVisibleFalse, oMSGskippedDontSave, oMSGskippedSetEmpty)

        End If

        'NIJE TESTIRANO ZA GRUPEPITANJA
        If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then

            Dim biloSkakanje As Boolean = False
            Dim maxrbr As Integer = 0

            If nname.Trim.ToUpper <> "DUGMEDALJE" AndAlso nname.Trim.ToUpper <> "BUTTONNEXT" AndAlso
                nname.IndexOf("TABELA") < 0 AndAlso nname.IndexOf("TABLE") < 0 AndAlso
                nname.Trim.ToUpper <> "DUGMESACUVAJ" AndAlso nname.Trim.ToUpper <> "BUTTONSAVE" Then
                Dim k As Control = Nothing
                Dim ind As Integer = Array.IndexOf(nizKontrolaIme, nname)
                If ind > -1 Then k = NadjiKontroluSkr(nizKontrola(ind).Parent, nname, 2)
                If Not k Is Nothing AndAlso Not k.AccessibleDescription Is Nothing AndAlso k.AccessibleDescription.Split(";")(0) > maxrbr Then
                    maxrbr = k.AccessibleDescription.Split(";")(0)
                End If
            Else
                maxrbr = 10000000   'najveci moguci
            End If

            bbss = sskoci2Grupa(GlavnaTabela, plj, cntl, nname, maxrbr, "2=2", oMSGskippedEnabledFalse, oMSGskippedSetEmpty, oMSGskippedVisibleFalse, oMSGskippedDontSave)

            If Not bbss Is Nothing Then biloSkakanje = True

            If Not bbss Is Nothing Then
                For i As Integer = 0 To nizskip.GetUpperBound(0)
                    Dim nn() As String = nizskip(i).Split("$")
                    If nn(0).Trim.ToUpper = plj.Trim.ToUpper Then
                        nizskip(i) = nn(0) + "$TRUE"
                        Exit For
                    End If
                Next
            End If

            optionMSGskok = bbss

            bbiloskakanje = False
            If biloSkakanje = True Then bbiloskakanje = True
        End If

    End Function

    Sub skippedOptionMSGskok(ByVal panel As Panel, ByVal nizskociNAsss As String, ByVal oMSGIF As String, ByVal nizskociNAsssrbr As String, ByVal trtrbr As String,
        ByVal skippedEnabledFalse As Boolean, ByVal skippedVisibleFalse As Boolean,
        ByVal skippedDontSave As Boolean, ByVal skippedSetEmpty As Boolean)
        For Each k As Control In panel.Controls
            If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox OrElse TypeOf k Is RadioButton OrElse TypeOf k Is DateTimePicker2 OrElse TypeOf k Is Panel OrElse TypeOf k Is Button Then
                If Mid(k.Name, 3).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                    k.Enabled = True
                    k.Visible = True
                    k.Focus()
                    If Mid(k.Name, 1, 2) = "RG" AndAlso k.Focused = True Then
                        'stavi focus na prvi
                        'SendKeys.Send("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                    End If
                Else
                    If k.AccessibleDescription Is Nothing Then k.AccessibleDescription = ""
                    If k.AccessibleName Is Nothing Then k.AccessibleName = ""

                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer   'NE SME =0 dugme ostane enabled
                    If IsNumeric(kk(0)) Then krbr = kk(0)

                    If trtrbr < krbr AndAlso krbr < nizskociNAsssrbr Then
                        If skippedEnabledFalse = True Then
                            If Mid(k.Name, 1, 1) <> "F" Then k.Enabled = False
                        End If

                        If skippedVisibleFalse = True Then k.Visible = False
                        If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("SkipWithDontSaveCondition") < 0 Then k.AccessibleName = k.AccessibleName + "SkipWithDontSaveCondition" + oMSGIF.Trim + ";"
                            bbioskippedDontSave = True
                        End If
                        If skippedSetEmpty = True AndAlso Mid(k.Name, 1, 1) <> "F" AndAlso Not TypeOf k Is Panel AndAlso Not TypeOf k Is Button AndAlso Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is DataGridView2 Then
                            k.Text = ""
                            Me.UpisiPolje(k.Name.Substring(2), , "PP_VALIDATING", k.Parent)
                        End If
                    ElseIf krbr > nizskociNAsssrbr Then
                        If Mid(k.Name, 1, 1) <> "F" Then
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                k.Enabled = False 'da ostanu RRO; i RO;
                            Else
                                k.Enabled = True 'da ostanu fp
                            End If
                        End If
                        If Mid(k.Name, 1, 1) = "F" Then
                            If k.Tag.izraz <> "''" Then
                                k.Visible = True
                            Else
                                k.Visible = False
                            End If
                        End If

                    End If
                End If
            Else
                If TypeOf k Is Button AndAlso k.Name.Length > 8 AndAlso Mid(k.Name, 1, 8) = "DBTNPANE" Then
                    'dugmepanetab.Name = "DBTNPANE" & t.Trim.ToUpper
                    If k.Enabled = False Then
                        k.Enabled = True
                        Call dpcpanel(nizPanela(0), 1)
                    End If
                End If
            End If
        Next
    End Sub

