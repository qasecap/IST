            'addNewRowToLICA(god,POCETNI_H990099,rbr,P990099)values(god,POCETNI_H990099,rbr,P990099);addNewRowIF=#FP{fpGODLICA}>16
            If btn.AccessibleDescription.Trim.ToUpper.IndexOf("ADDNEWROWTO") >= 0 Then
