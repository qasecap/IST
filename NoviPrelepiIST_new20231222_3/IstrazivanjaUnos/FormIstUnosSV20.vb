    Private Sub SelectRadio(ByVal vred As String, ByVal grp As Panel)
        Dim vv As Integer = -1
        If IsNumeric(vred) Then vv = CInt(vred)
        Dim rbtn As RadioButton
        Dim tt As String = ""
        'Dim rbtnName As String = "RB" + Mid(grp.Name.Trim.ToUpper, 3) + "_" + CStr(vv).Trim
        Try
            Dim cntl As Control
            For Each cntl In grp.Controls
                If TypeOf cntl Is RadioButton Then
                    rbtn = DirectCast(cntl, RadioButton)
                    Dim index As Integer = rbtn.Text.Trim.IndexOf("  ")
                    tt = rbtn.Text.Trim.Substring(0, index).Trim
                    If tt = vred Then
                        rbtn.Checked = True
                        Exit For
                    End If
                End If
            Next
        Catch ex As Exception
            Dim stackframe As New Diagnostics.StackFrame(1)
            Throw New Exception("An error occurred in routine, '" & stackframe.GetMethod.ReflectedType.Name & "." & System.Reflection.MethodInfo.GetCurrentMethod.Name & "'." & Environment.NewLine & "  Message was: '" & ex.Message & "'")
        End Try
    End Sub

    Private Function kojeuRadiu(ByVal grp As Panel) As String
        Dim pp As String = ""
        Dim rbtn As RadioButton
        Dim tt As String = ""
        Try
            For Each cntl As Control In grp.Controls
                If TypeOf cntl Is RadioButton Then
                    rbtn = DirectCast(cntl, RadioButton)
                    Dim index As Integer = rbtn.Text.Trim.IndexOf("  ")
                    tt = rbtn.Text.Trim.Substring(0, index).Trim
                    pp = pp & tt.Trim & ","
                End If
            Next
        Catch ex As Exception
            Dim stackframe As New Diagnostics.StackFrame(1)
            Throw New Exception("An error occurred in routine, '" & stackframe.GetMethod.ReflectedType.Name & "." & System.Reflection.MethodInfo.GetCurrentMethod.Name & "'." & Environment.NewLine & "  Message was: '" & ex.Message & "'")
        End Try
        pp = pp & "#"
        pp = pp.Replace(",#", "")
        kojeuRadiu = pp
    End Function

