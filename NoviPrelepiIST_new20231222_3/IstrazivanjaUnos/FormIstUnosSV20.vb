    Sub postaviFokusSkakanjeSaKljuca()
        'ZATO STO JE NA NEW NE MOŽE kk.Focus() VEĆ Me.ActiveControl = kk

        'skakanje sa kljuca POSTAVLJANJE FOKUSA USTVARI ide samo jednom
        Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and kljuc='P' and (OD like '%SKOCINA%' or OD like '%SKIPTO%') "
        Dim redovi As DataRow() = dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))
        'skakanje ide samo sa zadnjeg kljuca, nema poruka
        If redovi.Length > 0 Then
            Dim nizProvera() As String = {}
            Dim skociNA As String = ""
            Dim nizskociNA() As String = {}
            Dim skociAKO As String = ""
            Dim nizskociAKO() As String = {}
            Dim rreedd As DataRow = redovi(redovi.Length - 1)
            Dim pomOD As String = rreedd.Item("od").Trim.ToUpper
            pomOD = pomOD.Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
            Dim plj As String = rreedd.Item("polje").Trim.ToUpper
            If pomOD.Length > 0 AndAlso pomOD.Trim.IndexOf("#{") = 0 Then
                pomOD = pomOD.Replace("#{", "")
                pomOD = pomOD.Replace("}", "")
                pomOD = pomOD.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                nizProvera = Split(pomOD, ";")
                For i As Integer = 0 To nizProvera.GetUpperBound(0)
                    If nizProvera(i).IndexOf("SKOCINA=") >= 0 Then
                        skociNA = nizProvera(i).Replace("SKOCINA=", "")
                        nizskociNA = Split(skociNA, "$")
                    End If
                    If nizProvera(i).IndexOf("SKOCIAKO=") >= 0 Then
                        skociAKO = nizProvera(i).Replace("SKOCIAKO=", "")
                        nizskociAKO = Split(skociAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPTO=") >= 0 Then
                        skociNA = nizProvera(i).Replace("SKIPTO=", "")
                        nizskociNA = Split(skociNA, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPIF=") >= 0 Then
                        skociAKO = nizProvera(i).Replace("SKIPIF=", "")
                        nizskociAKO = Split(skociAKO, "$")
                    End If
                Next
            End If
            'skakanje sa kljuca
            If skociNA.Length > 0 Then
                If skociAKO.Length > 0 Then 'mora da ima skociako (ako uvek skace onda skociako=2=2)
                    'SKAKANJE
                    Dim pomocnoDaIskocimIzFora As Integer = 0
                    For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                        Try
                            Dim tabela As String = GlavnaTabela
                            Dim pomKol1 As New DataColumn("pomKol1")
                            Dim bbb() As String = razkvantaj(nizskociAKO(sss))
                            For ll As Integer = 0 To bbb.GetUpperBound(0)
                                'saekrana
                                If bbb(ll).Trim = plj Then
                                    Dim pom As String = ""
                                    Dim ind As Integer = Array.IndexOf(nizKontrolaIme, plj)
                                    If ind > -1 Then pom = SE(plj,, nizKontrola(ind).Parent).Trim
                                    'saekrana
                                    If pom = "" Then
                                        bbb(ll) = "Null"
                                    Else
                                        bbb(ll) = "'" + pom + "'"
                                    End If
                                End If
                                If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                                    Dim ind As Integer = Array.IndexOf(nizFPime, bbb(ll).Replace("#FP{", "").Replace("}", "").Trim)
                                    'saekrana pokupi fiktivno polje
                                    If ind > -1 Then bbb(ll) = "'" + SE(bbb(ll).Substring(4), True, nizFP(ind).Parent).Trim + "'"
                                End If
                            Next
                            Dim zzz As String = ustringaj(bbb).ToUpper
                            zzz = razCASTi(zzz)
                            pomKol1.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                            DGTabele(DGi(tabela)).Columns.Add(pomKol1)
                            Dim xxx As String = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol1)", ""))
                            DGTabele(DGi(tabela)).Columns.Remove(pomKol1)
                            Dim a As Integer = CInt(xxx)  '1 TRUE, 0 FALSE
                            'ispunjen USLOV
                            If a = 1 Then
                                If nizskociNA(sss) = "DUGMEDALJE" OrElse nizskociNA(sss) = "BUTTONNEXT" Then
                                    Me.ActiveControl = BtnSaveNext
                                    pomocnoDaIskocimIzFora = 1
                                ElseIf nizskociNA(sss).IndexOf("TABELA") = 0 Then
                                    'skace na dupe
                                    nizskociNA(sss) = nizskociNA(sss).Replace("TABELA", "BTN")
                                    For Each kk As Control In Me.Panel1.Controls
                                        If kk.Name.Trim.ToUpper = nizskociNA(sss).Trim.ToUpper Then
                                            Me.ActiveControl = kk
                                            pomocnoDaIskocimIzFora = 1
                                            Exit For
                                        End If
                                    Next
                                ElseIf nizskociNA(sss).IndexOf("PANEL") = 0 Then
                                    'skace na dupe koje je panel, tj skace na prvo polje u panelu
                                    nizskociNA(sss) = nizskociNA(sss).Replace("PANEL", "PANE_")
                                    For Each kk As Control In Me.Panel1.Controls
                                        If kk.Name.Trim.ToUpper = nizskociNA(sss).Trim.ToUpper Then
                                            Me.ActiveControl = kk
                                            'SendKeys.Send("{TAB}")
                                            'MORA OVAKO DOKAZ PROBNIPOPIS
                                            Me.SelectNextControl(ActiveControl, True, True, True, True)
                                            pomocnoDaIskocimIzFora = 1
