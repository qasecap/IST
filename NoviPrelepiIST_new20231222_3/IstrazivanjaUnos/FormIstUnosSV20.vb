    Sub opcDialogResult(ByVal sender As System.Object, ByVal e As System.EventArgs, ByVal scati As Boolean,
                ByVal NslKljucNothing As Boolean, ByVal msgtxt As String, ByVal msgtitle As String, ByVal odakle As String)
        Dim red As String = ""
        Dim ssek As String = ""
        For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
            If SEK(GlavniKljuc(i)) Is Nothing Then ssek = "" Else ssek = SEK(GlavniKljuc(i)).Trim.ToUpper
            red = red + GlavniKljuc(i).Trim.ToUpper + "=" + ssek + " and "
        Next
        red = red + "$$"
        red = red.Replace(" and $$", "")

        msgtxt = nvrd + nvrd + nvrd + nvrd + msgtxt + nvrd + nvrd + nvrd + nvrd

