    Private Sub NapraviDGTabele()

        ReDim Me.DGTabele(-1)
        ReDim Me.DGTabeleOriginal(-1)
        ReDim Me.DGTabelePanel(-1)

        For Each t As DatasetIstrazivanja.ISTTABELERow In dIst.ISTTABELE.Rows

            Dim tT1 As String = IIf(t.Item("T1") Is System.DBNull.Value, "", t.Item("T1"))
            If tT1.Trim.ToUpper.IndexOf("ISTVIEW") < 0 Then 'NIKAKO NE SME PREKO BAZA<>0 MORA ZBOG PODTABELA DA SE NAPUNE SVE
                Dim i As Integer = Me.DGTabele.GetUpperBound(0) + 1
                ReDim Preserve Me.DGTabele(i)
                ReDim Preserve Me.DGTabeleOriginal(i)
                ReDim Preserve Me.DGTabelePanel(i)

                Me.DGTabele(i) = New DataTable
                Me.DGTabeleOriginal(i) = New DataTable
                Me.DGTabelePanel(i) = New DataTable

                Try
                    'OVO NE MOZE JER JE definisano kao  New DataTable
                    ' Call napuniPonovoDGTabele(sql, i)
                    'OVO NE MOZE JER JE definisano kao  New DataTable
                    Dim sql As String = "select * from " & prfxt(t.Tabela.Trim.ToUpper) & " where 2=3"
                    DGTabele(i) = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Nothing)
                    DGTabeleOriginal(i) = DGTabele(i).Clone
                    DGTabelePanel(i) = DGTabele(i).Clone

                    Dim pp() As String
                    Dim prefixx As String = "dbo"
                    Dim tabbb As String = t.Tabela.Trim.ToUpper
                    If tabbb.IndexOf(".") > 0 Then
                        pp = tabbb.Split(CType(".", Char()))
                        prefixx = pp(0)
                        tabbb = pp(1)
                    End If

                    Me.DGTabele(i).Prefix = prefixx
                    Me.DGTabele(i).TableName = tabbb
                    Me.DGTabeleOriginal(i).Prefix = prefixx
                    Me.DGTabeleOriginal(i).TableName = tabbb
                    Me.DGTabelePanel(i).Prefix = prefixx
                    Me.DGTabelePanel(i).TableName = tabbb
                Catch ex As Exception
                    MsgBox("Table " + prfxt(t.Tabela.Trim.ToUpper) + " from ISTTables does not exist in SQL Server." + nvrd + nvrd + ex.Message, vbCritical, "")
                End Try
                For Each c As DataColumn In Me.DGTabele(i).Columns
                    If c.DataType.Name.ToUpper = "BOOLEAN" Then
                        c.DataType = GetType(System.Int16)
                    End If
                Next
            End If

        Next

