    Function vf(ByVal a As Integer, ByVal k As Control, ByVal bvalue As Boolean, ByVal trtnizcc As String) As Integer
        vf = 0
        If Mid(k.Name, 1, 1) = "B" Then
            If Mid(k.Name, 1).Trim.ToUpper = trtnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, Button).Visible = bvalue
                    k.AccessibleName = k.AccessibleName + "BTNV" + CStr(Not bvalue).Trim.ToUpper + ";"
                    Dim kb As Button = NadjiKontroluSkrKojaJeBUTTONPLUS(Panel1, trtnizcc.Trim.ToUpper.Replace("BTN", ""))
                    If Not kb Is Nothing Then
                        If Not CType(k, Button).AccessibleDescription Is Nothing AndAlso CType(k, Button).AccessibleDescription.Trim.ToUpper.IndexOf("NOPLUS") Then
                            kb.Visible = False
                        Else
                            kb.Visible = bvalue
                        End If
                    End If
                    vf = 1
                Else          'ako je NIJE ispunjen USLOV
                    CType(k, Button).Visible = Not bvalue
                    If Not k.AccessibleName Is Nothing Then k.AccessibleName = k.AccessibleName.Replace("BTNV" + CStr(bvalue).Trim.ToUpper + ";", "")
                    Dim kb As Button = NadjiKontroluSkrKojaJeBUTTONPLUS(Panel1, trtnizcc.Trim.ToUpper.Replace("BTN", ""))
                    If Not kb Is Nothing Then
                        If Not CType(k, Button).AccessibleDescription Is Nothing AndAlso CType(k, Button).AccessibleDescription.Trim.ToUpper.IndexOf("NOPLUS") Then
                            kb.Visible = False
                        Else
                            kb.Visible = Not bvalue
                        End If
                    End If
                End If
            End If
        End If

        If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 2) = "FP" Then
            If Mid(k.Name, 3).Trim.ToUpper = trtnizcc.Trim.ToUpper Then
                Dim tb As TextBox = CType(k, TextBox)
                If a = 1 Then 'samo ako je ispunjen USLOV
                    tb.Visible = bvalue
                    vf = 1
                Else          'ako je NIJE ispunjen USLOV
                    tb.Visible = Not bvalue
                End If
            End If
        End If



        If Mid(k.Name.Trim.ToUpper, 1, 4) = "IDGV" Then
            Dim ime As String = ""
            If Not k.AccessibleName Is Nothing Then
                Dim nev() As String = k.AccessibleName.Split(";")
                For i As Integer = 0 To nev.GetUpperBound(0)
                    If nev(i).Trim.ToUpper.IndexOf("CONTROLNAME") = 0 Then
                        ime = nev(i).Trim.ToUpper.Replace("CONTROLNAME", "")
                        Exit For
                    End If
                Next
            End If
            If ime.Trim <> "" AndAlso ime.Trim.ToUpper = trtnizcc.Trim.ToUpper Then
                Dim tb As DataGridView2 = CType(k, DataGridView2)
                If a = 1 Then 'samo ako je ispunjen USLOV
                    tb.Visible = bvalue
                    vf = 1
                Else          'ako je NIJE ispunjen USLOV
                    tb.Visible = Not bvalue
                End If
            End If
        End If
        If Mid(k.Name, 1, 2) = "CB" Then
            If Mid(k.Name, 3).Trim.ToUpper = trtnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, ComboBox).Visible = bvalue
                    vf = 1
                Else          'ako je NIJE ispunjen USLOV
                    CType(k, ComboBox).Visible = Not bvalue
                End If
            End If
        End If
        If Mid(k.Name, 1, 2) = "RG" Then
            If Mid(k.Name, 3).Trim.ToUpper = trtnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, Panel).Visible = bvalue
                    vf = 1
                Else          'ako je NIJE ispunjen USLOV
