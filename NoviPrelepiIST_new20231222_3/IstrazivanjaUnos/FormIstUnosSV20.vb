    Function dajUniqueImeIST(ByVal tabela As String, ByVal cname As String, ByVal dodpolje As String) As String
        Dim sql As String = ""
        dajUniqueImeIST = cname + "1"
        For i As Integer = 1 To 100000
            If dodpolje = "" OrElse dodpolje.IndexOf(cname + CStr(i).Trim + ";") < 0 Then
                sql = "SELECT polje FROM istpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and polje=N'" + cname + CStr(i).Trim + "'"
                Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Nothing)
                'UVEK MORA IZ BAZE, NE MOZE PREKO  redoviMEM
                If dt Is Nothing OrElse dt.Rows.Count = 0 Then
                    dajUniqueImeIST = cname + CStr(i).Trim
                    Exit For
                End If
            End If
        Next
    End Function

