    Private Sub pp_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs)

        foo = Nothing

        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        'ZA AUTB PREBACENO U OVERRIDE
        Dim tbox As TextBox = CType(sender, TextBox)
        If Not tbox.AccessibleName Is Nothing Then tbox.AccessibleName = tbox.AccessibleName + ";" : tbox.AccessibleName = tbox.AccessibleName.Replace(";;", ";")
        Dim kp As Boolean = False
        Dim kd As Boolean = False

        bioPageDown = False
        Dim RadioButton As Boolean = False
        Dim tb As Boolean = False
        Dim tbF As Boolean = False
        Dim tbA As Boolean = False
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 3)

        'AktivanTekstBoks = tbox
        Dim kkk As String = ""
        Dim duzRG As Integer = 0
        Dim pomtxt As String = ""
        Dim pommduz As String = ""
        Dim pommtip As String = ""


        If SCati = True Then
            If tbox.AccessibleDescription.Trim.ToUpper.IndexOf(";RG") > 0 Then
                RadioButton = True
                Dim pp As Panel = tbox.Parent
                Dim imeP As String = pp.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
                Dim pppom As Panel = NadjiKontrolu(Me, imeP)
            Else
                tb = True
                pomtxt = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
                pommduz = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("duzina")).Trim.ToUpper
                pommtip = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("tip")).Trim.ToUpper
                If pommtip.Trim.Length > 0 Then
                    If (pommtip = "INT" OrElse pommtip = "INTEGER" OrElse pommtip = "SMALLINT" OrElse pommtip = "TINYINT" Or
                    pommtip = "BIG" OrElse pommtip = "BIGINT" OrElse
                    pommtip = "FLOAT" OrElse pommtip = "REAL" OrElse pommtip.Trim.ToUpper.IndexOf("DECIMAL") >= 0) Then
                        tbF = True
                    End If
                    If (pommtip = "STRING" OrElse pommtip = "TEXT" OrElse pommtip.Trim.ToUpper.IndexOf("CHAR") >= 0) Then
                        tbA = True
                    End If
                    If pommduz = "" Then
                        ''msg 72
                        Dim msgtxt72 As String = getMessageText(dtMessages, "72", Me.jezik)
                        ''msg 73
                        Dim msgtxt73 As String = getMessageText(dtMessages, "73", Me.jezik)
                        ISTMessageBox.Show(msgtxt72 + plj + msgtxt73, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                End If
            End If
        End If

        Select Case e.KeyCode
            Case Keys.F2
                Dim f2 As String = "" : Dim f3 As String = ""
                If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                    Dim pp() As String = tbox.AccessibleName.Split(";")
                    Dim addmissingvalue As String = ""
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                            addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                            Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                            Dim ppom() As String = f2f3.Split("$")
