    Sub pp_Validacija(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs,
                      ByVal SCati As Boolean, ByVal odakle As String, Optional ByVal bezzskakanja As Boolean = False)

        If DGTabele(DGi(GlavnaTabela)).Rows.Count = 0 Then
            Call zatvoriOLHC()
            Me.Kljuc1Focus()
            Exit Sub
        End If

        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        Dim tbox As TextBox = CType(sender, TextBox)
        Dim autb As Boolean = False : Dim autbDB As Boolean = False : Dim multiresponse As Boolean = False
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB;") >= 0 Then autb = True
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTBDB;") >= 0 Then autbDB = True
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("MULTIRESPONSE;") >= 0 Then multiresponse = True

        okvalidacija = True

        If Not focusedDG(Me.Panel1) Is Nothing OrElse dgscroll = True Then
            mouseleavePOLJE = tbox
            dgscroll = False
            Call zatvoriOLHC()
            Exit Sub
        End If

        If tbox.Modified = False AndAlso Me.BtnExit.Focused Then Exit Sub

        If tbox.Modified = False AndAlso Not nizButtonKontrola Is Nothing AndAlso nizButtonKontrola.Length > 0 Then
            For i As Integer = 0 To nizButtonKontrola.GetUpperBound(0)
                If nizButtonKontrola(i).Focused Then
                    Call zatvoriOLHC()
                    Exit Sub
                End If
            Next
        End If

        If tbox.Modified = False AndAlso Not nizDGVGrid Is Nothing Then
            For i As Integer = 0 To nizDGVGrid.GetUpperBound(0)
                If nizDGVGrid(i).Focused Then
                    Call zatvoriOLHC()
                    Exit Sub
                End If
            Next
        End If
        tbox.Text = tbox.Text.Replace("'", "")
        If multiresponse = True AndAlso tbox.Text.Trim <> "" Then
            tbox.Text = tbox.Text.Replace(".", "-").Replace(",", "-").Replace(";", "-").Replace("/", "-")
            tbox.Text = tbox.Text.TrimEnd("-").TrimStart("-")
            tbox.Text = tbox.Text.Replace("--", "-").Replace("--", "-").Replace("--", "-")
            tbox.Text = tbox.Text.Trim
            If tbox.Text <> "" Then
                Dim tb As String = ""
                Dim pp() As String = tbox.Text.Split("-")
                pp = pp.Distinct().ToArray()
                For i As Integer = 0 To pp.GetUpperBound(0)
                    tb = tb + pp(i).Trim.ToUpper + "-"
                Next
                tbox.Text = tb.TrimEnd("-")
            End If
        End If

        Dim grupisano As Boolean = False
        Dim kojaGrupa As String = ""

        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 3)
        Dim panel As Panel = tbox.Parent
        If panel.Name.Trim.ToUpper.IndexOf("CAPI_") = 0 Then
            grupisano = True
            kojaGrupa = panel.Name.Trim.ToUpper.Replace("CAPI_", "")
        End If

        Dim addmissingvalue As String = ""
        'f2="!8refuse,f3="?9dontknow
        Dim f2 As String = "" : Dim f3 As String = ""
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
            Dim pp() As String = tbox.AccessibleName.Split(";")
            For i As Integer = 0 To pp.GetUpperBound(0)
                If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                    addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                    Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                    Dim ppom() As String = f2f3.Split("$")
                    f2 = ppom(0) : f3 = ppom(1)
                    Exit For
                End If
            Next
        End If

        Dim vTextTrim As String = ""
        If autbDB = False Then
            vTextTrim = tbox.Text.Trim
        End If
        If autbDB = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = False AndAlso DirectCast(tbox, AutoCompleteTextbox).CurrentAutoCompleteList.Count = 0 Then
            vTextTrim = tbox.Text.Trim
        End If
        If autbDB = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = True Then
            vTextTrim = DirectCast(tbox, AutoCompleteTextbox).sselectedValue.ToString.Trim
        End If
        If autbDB = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = False AndAlso DirectCast(tbox, AutoCompleteTextbox).CurrentAutoCompleteList.Count > 0 Then
