    Private Sub NapuniPTabele(Optional ByVal SamoJednu0 As String = Nothing, Optional ByVal SamoJednu1 As String = Nothing, Optional ByVal Tag As String = Nothing, Optional ByVal APlj() As String = Nothing, Optional ByVal TPlj() As String = Nothing)

        If SamoJednu0 Is Nothing Then
            For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                If IstaGlava(p.TABELA.Trim.ToUpper, GlavnaTabela) Then
                    If Not p.IsRelBazaNull AndAlso p.RelBaza.Trim <> "" Then
                        If DGi(p.RelTabela.Trim.ToUpper, PTabele) = -1 Then
                            ReDim Preserve PTabele(1 + PTabele.GetUpperBound(0))
                            Dim sql As String = "select * from " & IzrazLKTabele(p.RelBaza.Trim.ToUpper, p.RelTabela.Trim.ToUpper)
                            sql = sql & " " & p.RelTabela.Trim.ToUpper & " WHERE 2=2 "
                            sql = DodajVodVdo(sql, p.RelBaza.Trim.ToUpper, IzrazLKTabele(p.RelBaza.Trim.ToUpper, p.RelTabela.Trim.ToUpper), p.RelTabela.Trim.ToUpper)
                            sql = sql.Trim.ToUpper.Replace("CONVERT", "CAST").Replace(",'SYSTEM.INT32'", " as integer").Replace(", 'SYSTEM.INT32'", " as integer").Replace(",'SYSTEM.INT32' ", " as integer").Replace(", 'SYSTEM.INT32' ", " as integer")
                            PTabele(PTabele.GetUpperBound(0)) = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)
                            PTabele(PTabele.GetUpperBound(0)).TableName = p.RelTabela.Trim.ToUpper
                        End If
                    End If
                End If
            Next
        Else
            ReDim Preserve PTabele(1 + PTabele.GetUpperBound(0))
            Dim sql As String
            If Tag = "R" AndAlso InStr(SamoJednu1.Trim, "dbo.") = 0 Then
                sql = "select * from " & SamoJednu1.Trim.ToUpper & " P WHERE 2=2 "
            Else
                sql = "select * from " & IzrazLKTabele(SamoJednu0.Trim.ToUpper, SamoJednu1.Trim.ToUpper)
                sql = sql & " " & SamoJednu1.Trim.ToUpper & " WHERE 2=2 "
            End If
            If Not APlj Is Nothing Then
                For i As Integer = 0 To APlj.GetUpperBound(0)
                    If TPlj.Length >= i + 1 Then
                        If TPlj(i).IndexOf("'") >= 0 Then
                            sql = sql + " AND " & APlj(i) & "=" & TPlj(i).Trim & " "
                        End If
                    End If

                Next
            End If
            If Tag = "R" AndAlso InStr(SamoJednu1.Trim, "dbo.") = 0 Then
                sql = DodajVodVdo(sql, SamoJednu0.Trim.ToUpper, SamoJednu1.Trim.ToUpper, "P")
            Else
                sql = DodajVodVdo(sql, SamoJednu0.Trim.ToUpper, IzrazLKTabele(SamoJednu0.Trim.ToUpper, SamoJednu1.Trim.ToUpper), SamoJednu1.Trim.ToUpper)
            End If
            sql = sql.Trim.ToUpper.Replace("CONVERT", "CAST").Replace(",'SYSTEM.INT32'", " as integer").Replace(", 'SYSTEM.INT32'", " as integer").Replace(",'SYSTEM.INT32' ", " as integer").Replace(", 'SYSTEM.INT32' ", " as integer")
            PTabele(PTabele.GetUpperBound(0)) = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)
            PTabele(PTabele.GetUpperBound(0)).TableName = SamoJednu1.Trim.ToUpper
            Dim ii As Integer = PTabele.GetUpperBound(0)
            For i As Integer = 0 To PTabele(ii).Columns.Count - 1
                Dim mx As Integer = -1
                For j As Integer = 0 To PTabele(ii).Rows.Count - 1
                    Dim qq As String = ""
                    If Not (PTabele(ii).Rows(j).Item(i).GetType Is GetType(System.DBNull)) Then qq = PTabele(ii).Rows(j).Item(i).ToString
                    If CStr(qq).Length > mx Then mx = CStr(qq).Length
                Next
                If PTabele(ii).Columns(i).DataType.Name = "String" Then
                    PTabele(ii).Columns(i).MaxLength = mx
                End If
            Next
        End If
    End Sub

