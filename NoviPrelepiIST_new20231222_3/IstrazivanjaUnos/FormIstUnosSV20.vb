                        ReDim Preserve nizbiovred(nind)
                        If Not k Is Nothing Then nizbiovred(nind) = k.Text
                        If k Is Nothing Then nizbiovred(nind) = "ISTISTIST"
                    Next
                Next
            End If

            If ImaVODVDO Then
                OrigVOD = Format(CDate(SP("VOD", panel)), "dd.MM.yyyy")
                NaP("VODF0", panel, OrigVOD, False)
                NaE("VODF1", OrigVOD, False)
                NaP("VODF2", panel, OrigVOD, False)
                NaP("VOD", panel, OrigVOD, False)
                OrigVDO = Format(CDate(SP("VDO", panel)), "dd.MM.yyyy")
                NaP("VDOF0", panel, OrigVDO, False)
                NaP("VDOF1", panel, OrigVDO, False)
                NaP("VDOF2", panel, OrigVDO, False)
                NaP("VDO", panel, OrigVDO, False)
                ' jos da obrne tab-ove....
