    Private Sub IsprazniSkokove(p As Panel)
        For Each k As Control In p.Controls
            If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel Then
                If TypeOf k Is TextBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse TypeOf k Is ComboBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                    Dim pom As String = ""
                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim <> "" Then
                        Dim pp() As String = k.AccessibleName.Trim.Split(";")
                        For i As Integer = 0 To pp.GetUpperBound(0)
                            If pp(i).ToUpper.IndexOf("SKIPFROM") < 0 AndAlso pp(i).ToUpper.IndexOf("FROMGROUP") < 0 AndAlso pp(i).ToUpper.IndexOf("TOGROUP") < 0 Then
                                pom = pom + pp(i) + ";"
                            End If
                        Next
                        k.AccessibleName = pom
                    End If
                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("LG;") >= 0 Then k.BackColor = Color.LightGray
                End If
            End If
        Next
    End Sub

    Private Sub IsprazniKontrole(p As Panel)
        For Each k1 As Control In Me.Controls
            If Mid(k1.Name.Trim.ToUpper, 1, 1) = "G" Then
                For Each k As Control In k1.Controls
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "T" AndAlso k.Enabled = True Then
                        k.Text = Nothing
                        k.BackColor = SystemColors.ControlLightLight
                    End If
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "C" AndAlso k.Enabled = True Then
                        k.Text = Nothing
                        k.BackColor = SystemColors.ControlLightLight
                    End If
                    If Mid(k.Name.Trim.ToUpper, 1, 1) = "U" AndAlso k.Enabled = True Then
                        CType(k, DateTimePicker2).Format = DateTimePickerFormat.Custom
                        CType(k, DateTimePicker2).CustomFormat = " "
