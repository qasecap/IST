                End If

            End If
            'insert
            Me.PAMTINovoPanel(panel, tabela, sqlKljuc, DGTabelePanel(DGi(tabela)).Rows(0), True, iinsertPanel, uupdatePanel)   'nije sa zatvaranjem
            'samo taj red
            Call UradiLKPanel(tabela, panel, , "pp")
            'svi redovi iz panela
            Call UradiLKSveZaPodTabeluPanel(tabela, panel, , "pp")
            Call IsprazniKontrolePanel(panel, 1)
            Call PopuniJosZaPoljaPanel(tabela, panel)
            DGTabelePanel(DGi(tabela)).Clear()

            For Each c As Control In panel.Controls
                If c.Name.Trim.Length > 3 AndAlso (c.Name.Substring(0, 3).ToUpper = "DTP" OrElse c.Name.Substring(0, 3).ToUpper = "DCB" OrElse c.Name.Substring(0, 3).ToUpper = "DUP") Then
