    Sub dodelaSamoCita(ByVal pane As Panel, ByVal nizsamoCitaAKO() As String, ByVal nizsamoCita() As String, ByVal plj As String, ByVal k As Control, ByVal glavnatabela As String)
        Dim tabela As String = glavnatabela
        For sss As Integer = 0 To nizsamoCitaAKO.GetUpperBound(0)
            Try
                If nizsamoCita(sss).Length > 0 Then
                    Dim pomKol4 As New DataColumn("pomKol4")
                    Dim bbb() As String = razkvantaj(nizsamoCitaAKO(sss))
                    For ll As Integer = 0 To bbb.GetUpperBound(0)
                        If bbb(ll).Trim = plj Then
                            'saekrana
                            If SE(plj,, k.Parent).Trim = "" Then
                                bbb(ll) = "Null"
                            Else
                                bbb(ll) = "'" + SE(plj,, k.Parent).Trim + "'"
                            End If
                        End If
                        If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                            Dim ind As Integer = Array.IndexOf(nizFPime, bbb(ll).Replace("#FP{", "").Replace("}", "").Trim)
                            'saekrana pokupi fiktivno polje
                            If ind > -1 Then bbb(ll) = "'" + SE(bbb(ll).Substring(4), True).Trim + "'"
                        End If
                    Next
                    Dim zzz As String = ustringaj(bbb).ToUpper
                    zzz = razCASTi(zzz)
                    pomKol4.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                    DGTabele(DGi(tabela)).Columns.Add(pomKol4)
                    Dim xxx As Object = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol4)", ""))
                    DGTabele(DGi(tabela)).Columns.Remove(pomKol4)
                    Dim a As Integer = CInt(xxx)  '1 TRUE, 0 FALSE
                    If a = 1 Then ' samo ako je ispunjen USLOV
                        'READONLY
                        Dim trtniz As String() = Split(nizsamoCita(sss), ",")
                        For cc As Integer = 0 To trtniz.GetUpperBound(0)
                            Dim pomocnoDaIskocimIzFora As Integer = 0
                            For Each kk As Control In pane.Controls
                                If Mid(kk.Name, 1, 1) = "T" Then
                                    If Mid(kk.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                        CType(kk, TextBox).BackColor = RGBColors.mBackColor
                                        CType(kk, TextBox).Enabled = False
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If
                                If Mid(kk.Name, 1, 1) = "C" Then
                                    If Mid(kk.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                        CType(kk, ComboBox).Enabled = False
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If
                                If Mid(kk.Name, 1, 1) = "H" Then
                                    If Mid(kk.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                        CType(kk, CheckBox).Enabled = False
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If
                                If Mid(kk.Name, 1, 1) = "U" Then
                                    If Mid(kk.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                        CType(kk, DateTimePicker2).Enabled = False
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If
                                If Mid(kk.Name, 1, 1) = "R" Then
                                    If Mid(kk.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                        CType(kk, RadioButton).Enabled = False
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If

                                If TypeOf kk Is Button AndAlso trtniz(cc).IndexOf("BUTTON") = 0 Then
                                    Dim pom As String = trtniz(cc).Replace("BUTTON", "BTN")
                                    If kk.Name.Trim.ToUpper = pom.Trim.ToUpper Then
                                        CType(kk, Button).Visible = True
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If

                                If TypeOf kk Is DataGridView2 AndAlso trtniz(cc).IndexOf("GRID") = 0 Then
                                    Dim pom As String = trtniz(cc).Replace("GRID", "IDGV")
                                    If kk.Name.Trim.ToUpper = pom.Trim.ToUpper Then
                                        CType(kk, DataGridView2).Visible = True
                                        pomocnoDaIskocimIzFora = 1
                                    End If
                                End If

                                If pomocnoDaIskocimIzFora = 1 Then Exit For
                            Next
                        Next
                    End If ' If a = 1 Then ' samo ako je ispunjen USLOV

                End If '  If nizsamoCita(sss).Length > 0 Then
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try
        Next
    End Sub

