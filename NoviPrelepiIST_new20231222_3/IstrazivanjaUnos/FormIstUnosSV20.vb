    Private Function EscapeFilter(ByVal vstrRawFilter As String) As String
        Dim strEscapedFilter As String = vstrRawFilter
        Dim astrSpecialCharacters() As String = {"%"}
        For Each strSpecialChar As String In astrSpecialCharacters
            If strSpecialChar = "'" Then
                strEscapedFilter = strEscapedFilter.Replace(strSpecialChar, "'" & strSpecialChar)
            Else
                strEscapedFilter = strEscapedFilter.Replace(strSpecialChar, "[" & strSpecialChar & "]")
            End If
        Next
        Return strEscapedFilter

    End Function

    Function greskaizrazKon(ByVal greskaizraz As String) As String

        greskaizraz = ZameniGGGMMMUnos(greskaizraz)
        If greskaizraz.Trim.ToUpper.IndexOf("N'") > 0 Then
            greskaizraz = greskaizraz.Replace("=N'", "='")
        End If

        Dim zzz As String = ""
        Dim bbb() As String = {}
        If greskaizraz.Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse greskaizraz.Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
            'nadji nadtabela sta je
            Dim nadtabela As String = nadtabelaJe(Me.GlavnaTabela)
            zzz = greskaizraz.ToString.Trim
            Dim pp() As String = razkvantaj(zzz)
            For i As Integer = 0 To pp.Length() - 1
                pp(i) = GlavaHead(pp(i), DTbl(DGi(nadtabela)).Rows(0))
            Next
            zzz = ustringaj(pp).ToUpper
            greskaizraz = zzz
        End If

        'zameni ako postoji D.
        If greskaizraz.Trim.ToUpper.IndexOf("D.") > 0 Then
            Dim aaa() As String = razkvantaj(greskaizraz.Trim)
            For i As Integer = 0 To aaa.Length() - 1
                If aaa(i).Length() > 1 AndAlso aaa(i).Substring(0, 2).ToUpper = "D." Then
                    Dim pljF As String = aaa(i).Replace("D.", "").Trim.ToUpper
                    Dim qq As String
                    qq = SEK(pljF)
                    If qq = "" Then
                        Dim ind As Integer = Array.IndexOf(nizKontrolaIme, pljF)
                        If ind > -1 Then qq = SE(pljF,, nizKontrola(ind).Parent)
                    End If
                    aaa(i) = "N'" + qq + "'"
                End If
            Next
            greskaizraz = ustringaj(aaa).ToUpper
        End If

        ''FP
        If greskaizraz.Trim.ToUpper.IndexOf("#FP{") >= 0 Then
            greskaizraz = greskaizraz.Replace("{ ", "{").Replace(" }", "}")
            bbb = razkvantaj(greskaizraz.Trim)
            For ll As Integer = 0 To bbb.Length() - 1
                If bbb(ll).Length() > 4 AndAlso bbb(ll).Substring(0, 4).ToUpper = "#FP{" Then
                    Dim pp As String = ""
                    Dim pljF As String = bbb(ll).Replace("#FP{", "").Trim.ToUpper.Replace("}", "")
                    If SCati = False Then
                        pp = SEK(pljF)
                        If pp = "" Then
                            Dim ind As Integer = Array.IndexOf(nizFPime, pljF)
                            If ind > -1 Then pp = SE(pljF, True, nizFP(ind).Parent).Trim
                            If ll - 2 >= 0 AndAlso bbb(ll - 2).Length >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                                If ll + 2 <= bbb.GetUpperBound(0) AndAlso bbb(ll + 2).Length >= 0 AndAlso bbb(ll + 2).Trim.ToUpper = "0" Then
                                    If IsNumeric(pp) = True Then
                                        bbb(ll) = pp
                                    ElseIf pp = "''" OrElse pp = "" Then
                                        'pp = "Null" ????? mislim da ovo nije ok mira 20230423
                                        bbb(ll) = "Null"
                                    Else
                                        bbb(ll) = "'" + pp + "'"
                                    End If
                                Else
                                    bbb(ll) = "'" + pp + "'"
                                End If
                            ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                                bbb(ll) = pp
                            ElseIf pp = "0" Then  'samo nula
                                bbb(ll) = pp
                            Else
                                bbb(ll) = "'" + pp + "'"
                            End If
                        Else
                            bbb(ll) = "'" + pp + "'"
                        End If
                    Else
                        For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                            Dim pomzaizlazak As Integer = 0
                            For Each k As Control In grupePitanjaCATI(i).Controls
                                If Mid(k.Name, 1, 2) = "FP" AndAlso Mid(k.Name, 3).Trim.ToUpper = pljF.Trim.ToUpper Then
                                    pp = SE(pljF, True, k.Parent).Trim
                                    pomzaizlazak = 1
                                    Exit For
                                End If
                            Next
                            If pomzaizlazak = 1 Then Exit For
                        Next
                    End If
                End If
            Next

            bbb = josJedanKrug(bbb)
            greskaizraz = ustringaj(bbb).ToUpper
        End If

        greskaizrazKon = greskaizraz
    End Function

    Private Function UradiLK(Optional ByVal SamoNekeGreske As String() = Nothing, Optional ByVal ODS As String = "", Optional ByVal bezFP As Boolean = False) As Boolean

        If DGTabele(DGi(GlavnaTabela)) Is Nothing OrElse DGTabele(DGi(GlavnaTabela)).Rows.Count = 0 Then
            Call zatvoriOLHC()
            Exit Function
        End If
        Dim trebadontsend As Boolean = False
        If cbQC.Visible = True AndAlso cbQC.Checked = True Then
            trebadontsend = True
        End If
        Dim upit As String = "2=2 and tabela='" + Me.GlavnaTabela.Trim.ToUpper + "' and isnull(USLOV,'') not like '%ExecuteOnlyOnAddedButtonControl%' and isnull(USLOV,'') not like '%LKVELIKA%' and isnull(USLOV,'') not like '%ExecuteOnlyFromDataValidationModule%'"

        Dim greske As DataRow() = dIst.ISTLK.Select(upit)
        Dim ImaG As Boolean = False

        If greske.Length > 0 Then
            'prvo falsovi pa onda ostalo JER VRLO CESTO U GRESKAMA UCESTVUJU FALSOVI
            If ODS = "pp" OrElse ODS = "cbp" OrElse ODS = "hh" OrElse ODS = "UP" OrElse ODS = "rb" Then   'polje ili kombo koje nije kljuc radi samo one koji nemaju PK
                PreracunajFP("FPnPK")
            Else
                PreracunajFP()   'radi sva fals polja
            End If
        End If

        Dim kojaGreska As String = ""
        idarRSN = -1
        Dim kg As String = ""
        Dim GIzraz As String = ""
        Dim GI As String = ""
        Dim gdarn As String = ""
        For grBroj As Integer = 0 To greske.Length - 1
            If SamoNekeGreske Is Nothing OrElse Array.IndexOf(SamoNekeGreske, greske(grBroj).Item("RbrGreske").ToString.Trim.ToUpper) > -1 Then
                kojaGreska = greske(grBroj).Item("RbrGreske").ToString.Trim
                kg = kg + kojaGreska + ";"
                Try
                    Dim greskaIzraz As String = greske(grBroj).Item("GRESKA").Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim

                    greskaIzraz = zameniFP(greskaIzraz, True)

                    greskaIzraz = greskaizrazKon(greskaIzraz)
                    Try
                        GIzraz = PrevediF(greskaIzraz).Trim.ToUpper
                    Catch ex As System.Exception
                        Call zatvoriOLHC()
                        ISTMessageBox.Show(ex.Message & greske(grBroj).Item("RbrGreske").ToString.Trim & ":" & greske(grBroj).Item("RbrGreske").ToString.Trim, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        GIzraz = GIzraz + "2=3" + ";"

                    End Try

                    If GIzraz <> "" Then
                        If InStr(GIzraz, "SELECT") <> 0 Then 'OrElse InStr(GIzraz, "DBO.F_") <> 0 Then
                            Dim kv() As String = razkvantaj(GIzraz)
                            darRSN = ""
                            'idarRSN = -1
                            GIzraz = PrevediSNovo(kv)
                            gdarn = gdarn + darRSN
                        End If

                    End If
                    'vrati GIzraz
                    GI = GI + GIzraz + ";"
                Catch ex As System.Exception
                    Call zatvoriOLHC()
                    ISTMessageBox.Show(ex.Message & greske(grBroj).Item("RbrGreske").ToString.Trim & ":" & greske(grBroj).Item("RbrGreske").ToString.Trim, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try
            End If
        Next

        If GI.Trim <> "" AndAlso GI.Trim.Length > 0 AndAlso GI.Trim.Substring(GI.Trim.Length - 1) = ";" Then GI = GI.Trim.Substring(0, GI.Trim.Length - 1)
        If kg.Trim <> "" AndAlso kg.Trim.Length > 0 AndAlso kg.Trim.Substring(kg.Trim.Length - 1) = ";" Then kg = kg.Trim.Substring(0, kg.Trim.Length - 1)
        If gdarn.Trim <> "" AndAlso gdarn.Trim.Length > 0 AndAlso gdarn.Trim.Substring(gdarn.Trim.Length - 1) = ";" Then gdarn = gdarn.Trim.Substring(0, gdarn.Trim.Length - 1)

        Dim GIR() As String = GI.Split(";")
        Dim GKG() As String = kg.Split(";")
        Dim GDT() As String = gdarn.Split(";")
        Dim dS As DataSet = izvrsiSQLvratiDS(gdarn, Me.DBConnectionString, Nothing)
        For i As Integer = 0 To GIR.GetUpperBound(0)
            Dim samoTF As Boolean = False
            Dim vred As String = ""
            Dim gg As String = GIR(i).Trim
            Dim broj As Integer = -1
            If GIR(i).Trim <> "" Then
                If GIR(i) <> "" AndAlso GIR(i).Length > 8 AndAlso GIR(i).IndexOf("ISTIST") > 0 Then
                    Dim ff() As String = razkvantaj(GIR(i))
                    For k As Integer = 0 To ff.GetUpperBound(0)
                        If ff(k).Trim.ToUpper.IndexOf("$EISTIST") = 0 Then
                            broj = CInt(ff(k).Replace("EISTIST", "").Replace("$", ""))
                            If broj > -1 Then
                                If dS.Tables(broj).Rows.Count > 0 Then
                                    ff(k) = " 2=2 "
                                Else
                                    ff(k) = " 2=3 "
                                End If
                            End If
                        End If
                        If ff(k).Trim.ToUpper.IndexOf("$ISTIST") = 0 Then
                            broj = CInt(ff(k).Replace("ISTIST", "").Replace("$", ""))
                            If broj > -1 Then ff(k) = IzDGTzaSQL(0, dS.Tables(broj))
                        End If
                    Next
                    gg = ustringaj(ff)
                End If

                'nije ime tabele u selectu u selectu
                'NEVENA falilo je = (bilo je GIzraz.Trim.ToUpper.IndexOf(Me.GlavnaTabela.Trim.ToUpper + ".") > 0) 20211112
                If gg.Trim.ToUpper.IndexOf(Me.GlavnaTabela.Trim.ToUpper + ".") >= 0 Then
                    gg = gg.Replace(Me.GlavnaTabela.Trim.ToUpper + ".", "")
                End If

                If InStr(gg, "CAST") <> 0 Or gg.IndexOf("CHARINDEX") >= 0 Or
                        gg.IndexOf("INSTR") >= 0 Or gg.IndexOf("ISDATE") >= 0 Or
                        gg.IndexOf("ISNUMERIC") >= 0 Or gg.IndexOf("LTRIM") >= 0 Or
                        gg.IndexOf("RTRIM") >= 0 Or gg.IndexOf("LEFT") >= 0 Or
                        gg.IndexOf("RIGHT") >= 0 Or gg.IndexOf("MONTH") >= 0 Or gg.IndexOf("ROUND") >= 0 Then
                    gg = razCASTi(gg)
                End If
                If gg.Trim.ToUpper.IndexOf("CASE ") >= 0 Then gg = CASE2IIF(CStr(gg))

                Dim dt As New DataTable
                dt = DGTabele(DGi(GlavnaTabela)).Clone
                dt.ImportRow(DGTabele(DGi(GlavnaTabela)).Rows(0))

                Dim red As DataRow()
                red = dt.Select(gg.Replace("=N'", "='"))

                If red.Length > 0 Then
                    DGTabele(DGi(GlavnaTabela)).Rows(0).Item(GKG(i)) = 1
                    ImaG = True
                Else
                    DGTabele(DGi(GlavnaTabela)).Rows(0).Item(GKG(i)) = 0 'mora i da izbrise eventualo 1 koje je bilo
                End If
            End If
        Next

        Try
            If ImaG Then
                DGTabele(DGi(GlavnaTabela)).Rows(0).Item("INDGR") = 1
            Else
                DGTabele(DGi(GlavnaTabela)).Rows(0).Item("INDGR") = 0
            End If
        Catch ex As System.Exception
            Call zatvoriOLHC()
            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try

        Return ImaG
    End Function
