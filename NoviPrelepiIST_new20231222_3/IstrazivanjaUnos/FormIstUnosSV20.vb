                            Call lLRPnotVisible(tcntl, panel)
                            nepotrebnavalidacijaPanel = False
                            nepotrebanPaneEnter = False
                            Exit Sub
                        Else
                            Dim dugmeS As Button = NadjiKontrolu(panel, "DBTNSAVE" + tabela)
                            If Not dugmeS Is Nothing Then
                                dugmeS.Focus()
                                Call lLRPnotVisible(tcntl, panel)
                                nepotrebnavalidacijaPanel = False
                                nepotrebanPaneEnter = False
                                Exit Sub
                            End If
                        End If
                    Else
                        Dim dugmeS As Button = NadjiKontrolu(panel, "DBTNSAVE" + tabela)
                        If Not dugmeS Is Nothing Then
                            dugmeS.Focus()
                            Call lLRPnotVisible(tcntl, panel)
                            nepotrebnavalidacijaPanel = False
                            nepotrebanPaneEnter = False
                            Exit Sub
                        End If
                    End If
                Else

                    Me.SelectNextControl(ActiveControl, True, True, True, True)
                    Call lLRPnotVisible(tcntl, panel)

                    nepotrebnavalidacijaPanel = False
                    nepotrebanPaneEnter = False
                    Exit Sub
                End If
            End If
            nepotrebnavalidacijaPanel = False
            nepotrebanPaneEnter = False
        End If ' If grupeCNTLBlokoviPanel.Length = 0 OrElse grupeCNTLBlokoviPanel(ipanel) Is Nothing Then

        If grupeCNTLBlokoviPanel.Length > 0 AndAlso Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
            Try
                Dim b As Integer = blok(ipanel, tcntl)
                'da ne izaziva bezveze izlazak  i ulazak sa panela
                nepotrebanPaneEnter = True
                bbss = Nothing
                remarkvisible = False
                If odakle = "dppkeypress" Then
                    nepotrebnavalidacijaPanel = False
                    Call dpp_Validating(tcntl, Nothing)
                    nepotrebnavalidacijaPanel = True
                End If
                If odakle = "dpkkeypress" Then
                    nepotrebnavalidacijaPanel = False
                    Call dpk_Validating(tcntl, Nothing)
                    nepotrebnavalidacijaPanel = True
                End If

                If bbss Is Nothing Then bbiloskakanje = False

                If okvalidacija = False Then
                    tcntl.Focus()
                    tcntl.BackColor = Color.Bisque
                    If Not tcntl.AccessibleName Is Nothing AndAlso tcntl.AccessibleName.IndexOf("AUTB") >= 0 Then
                        CType(sender, AutoCompleteTextbox).SelectAll()
                    Else
                        CType(sender, TextBox).SelectAll()
                    End If
                    okvalidacija = False
                    nepotrebnavalidacijaPanel = False
                    nepotrebanPaneEnter = False
                    Exit Sub
                End If

                If bbilaporuka = True Then 'ne prikazuj poruku ako je prazna
                    Dim msgtxt As String = getMessageText(dtMessages, "34", Me.jezik)
                    'ISTMessageBox.Show(pporukaPanel, msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Dim ppp As DialogResult = ISTMessageBox.Show(pporukaPanel, msgtxt, MessageBoxButtons.OKCancel, MessageBoxIcon.Exclamation, MessageBoxDefaultButton.Button2)
                    Select Case ppp
                        Case DialogResult.OK
                        Case DialogResult.Cancel
                            okvalidacija = False
                    End Select
                    If pporukaPanel.Trim.IndexOf("***") < 0 Then tcntl.BackColor = Color.LemonChiffon
                    'NE VALJA SVE CRKNE U CATI MODU
                    'Dim t As New System.Threading.Thread(AddressOf ShowMSG)
                    't.Start(pporukaPanel)
                End If

                If okvalidacija = True AndAlso bbiloskakanje = True Then
                    Dim bblok As Integer = 0
                    If Not bbss.AccessibleName Is Nothing Then
                        Dim p As Integer = bbss.AccessibleName.IndexOf("TOGROUP")
                        If p >= 0 Then
                            Dim pp As String = bbss.AccessibleName.Substring(p + 7)
                            bblok = pp.Substring(0, pp.IndexOf(";"))
                        End If
                    End If
                    If bblok = b Then
                        bbss.Focus()
                    Else
                        If bbss.Name.Trim.ToUpper.IndexOf("DBTNSAVE") = 0 Then
                            bbss.Focus()
                        Else
                            Call vidljivBlokPanelBasOvaj(ipanel, bblok)
                            Call nevidljivBlokPanelBasOvaj(ipanel, b)
                            bbss.Focus()
                        End If
                    End If
                    nepotrebnavalidacijaPanel = False
                    nepotrebanPaneEnter = False

                    Call lLRPnotVisible(tcntl, panel)

                    'IZLAZAKbbss PONISTI SKOK,POSTAVI NOVI SKOK
                    If Not bbss.AccessibleName Is Nothing Then
                        'PONISTI SKOK
                        Dim bb As String = ""
                        Dim ps() As String = bbss.AccessibleName.Split(";")
                        For i As Integer = 0 To ps.GetUpperBound(0)
                            If ps(i).Trim.ToUpper.IndexOf("SKIPFROM") = 0 Then
                            ElseIf ps(i).Trim.ToUpper.IndexOf("FROMGROUP") = 0 Then
                            ElseIf ps(i).Trim.ToUpper.IndexOf("TOGROUP") = 0 Then
                            Else
                                bb = bb + ps(i) + ";"
                            End If
                        Next
                        bbss.AccessibleName = bb
                    End If
                    'POSTAVI NOVI SKOK
                    Dim z As String = ""
                    Dim ima As Boolean = False
                    If Not bbss.AccessibleName Is Nothing Then
                        If bbss.AccessibleName <> "" AndAlso bbss.AccessibleName.Trim.Substring(bbss.AccessibleName.Trim.Length - 1, 1) <> ";" Then z = ";"
                        Dim pom As String = "SKIPFROM" + Mid(tcntl.Name, 3) + ";TOGROUP" + Str(b + 1).Trim + ";FROMGROUP" + Str(b).Trim + ";"
                        If bbss.AccessibleName.Trim.ToUpper.IndexOf(pom) >= 0 Then ima = True
                    End If
                    If ima = False Then bbss.AccessibleName = bbss.AccessibleName + z + "SKIPFROM" + Mid(tcntl.Name, 4) + ";TOGROUP" + Str(bblok).Trim + ";FROMGROUP" + Str(b).Trim + ";"
                    'IZLAZAK
                    Exit Sub

                End If 'If okvalidacija = True AndAlso bbiloskakanje = True Then

                Dim indexPP As Integer = Array.IndexOf(grupePitanjaPoslednjePoljePanel(ipanel), tcntl.Name.ToUpper)
                Dim indexPPZK As Integer = Array.IndexOf(grupePitanjaPoslednjePoljePanelZaKontrolu(ipanel), tcntl.Name.ToUpper)
                Dim indexPPP As Integer = Array.IndexOf(grupePitanjaPretposlednjePoljePanel(ipanel), tcntl.Name.ToUpper)
                Dim lastfield As String = grupePitanjaPoslednjePoljePanel(ipanel)(b)

                'kakva su polja posle ovog?
                'ako su sva RRO onda se ide na sledeci blok
                Dim indexlastfield As Integer = Array.IndexOf(grupeObicneCNTLBlokoviPanel(ipanel)(b), tcntl)
                Dim ppro As Boolean = False

                ppro = rro(ipanel, b, indexlastfield)

                Dim ST As Boolean = False
                Dim NB As Boolean = False

                If okvalidacija = True AndAlso bbiloskakanje = False Then
                    If indexPPP >= 0 Then
                        'kakvo je poslednje
                        'ako je remark
                        If Mid(lastfield, 1, 3) = "DRP" Then
                            If remarkvisible = True Then
                                ST = True
                            Else
                                NB = True
                            End If
                        ElseIf ppro = True Then
                            NB = True
                        Else
                            ST = True
                        End If
                    ElseIf indexPPZK >= 0 AndAlso indexPP < 0 Then 'dosao misem
                        NB = True
                    Else
                        If indexPP >= 0 Then
                            NB = True
                        Else
                            If Mid(tcntl.Name, 1, 3) = "DRP" Then
                                'nista
                            Else
                                ST = True
                            End If
                        End If
                    End If
                End If

                If ST = True Then
                    'SendKeys.SendWait("{TAB}")
                    Me.SelectNextControl(ActiveControl, True, True, True, True)
                    Call lLRPnotVisible(tcntl, panel)
                    nepotrebnavalidacijaPanel = False
                    nepotrebanPaneEnter = False
                    Exit Sub
                End If

                If NB = True Then
                    Try
                        'vidljiv je sledeci blok po redu
                        'MORA DA SE ODVOJI NA VIDLJIV I NEVIDLJIVI KAO KAD IMA SKOK
                        'INACE GUBI PANEL FOKUS; PA PONOVO URADI PANE_ENTER
                        If b < grupeCNTLBlokoviPanel(ipanel).GetUpperBound(0) Then
                            nepotrebnavalidacijaPanel = True
                            fnpub(ipanel, b + 1)
                            'bbss.Focus()
                            Call vidljivBlokPanelBasOvaj(ipanel, b + 1)
                            Call nevidljivBlokPanelBasOvaj(ipanel, b)
                            If ppro = True Then
                                Dim z As String = ""
                                Dim ima As Boolean = False
                                If Not bbss.AccessibleName Is Nothing Then
                                    If bbss.AccessibleName <> "" AndAlso bbss.AccessibleName.Trim.Substring(bbss.AccessibleName.Trim.Length - 1, 1) <> ";" Then z = ";"
                                    Dim pom As String = "SKIPFROM" + Mid(tcntl.Name, 3) + ";TOGROUP" + Str(b + 1).Trim + ";FROMGROUP" + Str(b).Trim + ";"
                                    If bbss.AccessibleName.Trim.ToUpper.IndexOf(pom) >= 0 Then ima = True
                                End If
                                If ima = False Then bbss.AccessibleName = bbss.AccessibleName + z + "SKIPFROM" + Mid(tcntl.Name, 4) + ";TOGROUP" + Str(b + 1).Trim + ";FROMGROUP" + Str(b).Trim + ";"
                            End If
                            bbss.Focus()
                        Else
                            'SendKeys.SendWait("{TAB}")
                            Me.SelectNextControl(ActiveControl, True, True, True, True)
                        End If
                        Call lLRPnotVisible(tcntl, panel)
                        nepotrebnavalidacijaPanel = False
                        nepotrebanPaneEnter = False
                        Exit Sub
                    Catch ex As Exception
                        ISTMessageBox.Show("nextBlok iz validacije")
                        okvalidacija = False
                    End Try
                End If 'If NB = True Then
                'VRATI  da ne izaziva bezveze izlazak  i ulazak sa panela
                Call lLRPnotVisible(tcntl, panel)
                nepotrebnavalidacijaPanel = False
                nepotrebanPaneEnter = False
            Catch ex As Exception
                If odakle = "dppkeypress" Then ISTMessageBox.Show("dpp_keypress")
                If odakle = "dpkkeypress" Then ISTMessageBox.Show("dpk_keypress")
                okvalidacija = False
            End Try
        End If  '  If grupeCNTLBlokoviPanel.Length > 0 AndAlso Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
        '++++++++++++++
        '++++++++++++++
    End Sub

    Sub lLRPnotVisible(ByVal tcntl As Control, ByVal panel As Panel)
        If tcntl.Name.Length > 3 AndAlso Mid(tcntl.Name, 1, 3) = "DRP" Then
            tcntl.Visible = False
            Dim l As Label = NadjiKontrolu(panel, "L.R.P." + Mid(tcntl.Name, 4).Trim.ToUpper)
            If Not l Is Nothing Then l.Visible = False
        End If
    End Sub

