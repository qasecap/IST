        Dim chb As Boolean = False
        For Each k As Control In panel.Controls
            Dim mm() As String = k.AccessibleDescription.Split(";")
            If mm(0) = Str(sRBR).Trim AndAlso Not TypeOf k Is CheckBox Then k.Visible = True
            If mm(0) = Str(trenutniRBR).Trim Then k.Visible = False
