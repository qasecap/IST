                            NaE(tbox.Tag.Tpolja(i), NZ(xRed(tbox.Tag.APolja(i))), menjanKljuc)
                        Next
                        If Not tbox.Tag.Dodela Is Nothing Then
                            For i As Integer = 0 To tbox.Tag.Dodela.GetUpperBound(0)
                                Dim tp As String = tbox.Tag.dodela(i).substring(0, tbox.Tag.Dodela(i).IndexOf("=")).Trim.ToUpper
                                Dim ta As String = tbox.Tag.dodela(i).substring(tbox.Tag.Dodela(i).IndexOf("=") + 1).Trim.ToUpper
                                If ta.IndexOf("'") >= 0 Then
                                    NaE(tp, ta.Replace("'", "").Trim, menjanKljuc)
                                Else
                                    NaE(tp, NZ(xRed(ta)), menjanKljuc)
                                End If
                            Next
