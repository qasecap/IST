            Dim awltextNovo As String = "" : Dim awlNovoonKeyF1 As String = "" : Dim awlNovofFormat As String = ""
            If awlNovo.Length > 0 Then

                iKontrolaAWL = iKontrolaAWL + 1

                ReDim Preserve nizKontrolaAWL(iKontrolaAWL)
                nizKontrolaAWL(iKontrolaAWL) = tbox

                ReDim Preserve nizKontrolaAWLIme(iKontrolaAWL)
                nizKontrolaAWLIme(iKontrolaAWL) = p.POLJE.Trim.ToUpper

                ReDim Preserve nizKontrolaAWLtext(iKontrolaAWL)

                Dim awltext As String = dajTextZaAwlsIzISTAwls(awlNovo)

                nizKontrolaAWLtext(iKontrolaAWL) = awltext 'awlNovo(0).Item("ttext")

                ReDim Preserve nizKontrolaAWLF1(iKontrolaAWL)
                nizKontrolaAWLF1(iKontrolaAWL) = "0"

                'ReDim Preserve nizKontrolaAWLformat(iKontrolaAWL)
                'nizKontrolaAWLformat(iKontrolaAWL) = ""

                ReDim Preserve nizKontrolaAWLImaAssign(iKontrolaAWL)
                nizKontrolaAWLImaAssign(iKontrolaAWL) = "0"
                ReDim Preserve nizKontrolaAWLAssignTo(iKontrolaAWL)
                nizKontrolaAWLAssignTo(iKontrolaAWL) = ""

                ReDim Preserve nizKontrolaAWLAssignWhat(iKontrolaAWL)
                ReDim Preserve nizKontrolaAWLAssignIf(iKontrolaAWL)

                awltextNovo = awltext 'awlNovo(0).Item("ttext")

                If Not awlNovo(0).Item("onF1") Is System.DBNull.Value Then
                    awlNovoonKeyF1 = awlNovo(0).Item("onF1")
                    If awlNovoonKeyF1.Trim = "1" Then nizKontrolaAWLF1(iKontrolaAWL) = "1"
                End If

