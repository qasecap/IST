    Private Sub hhStopSkip(ByVal hhchb As CheckBox)

        'skip
        'stop

        okvalidacija = True

        If Me.btnNext.Visible = True Then Exit Sub 'znaci zakljucan NEMA MENJANJA, pa nema potrebe ni da ide kroz ovo

        'ISTMessageBox.Show("cbpp_Leave ", MsgBoxStyle.Information)

        Dim plj As String = Mid(hhchb.Name.Trim.ToUpper, 3)
        Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
        Dim pomIzraz As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("izraz")).Trim.ToUpper
        If pomIzraz.Trim.ToUpper.IndexOf("READONLY") >= 0 Then pomIzraz = NZ(Replace(pomIzraz, "readonly", "", 1, , CompareMethod.Text)).Trim
        If pomIzraz.Trim.ToUpper.IndexOf("VISIBLEFALSE") >= 0 Then pomIzraz = NZ(Replace(pomIzraz, "visiblefalse", "", 1, , CompareMethod.Text)).Trim
        If pomIzraz.Trim.ToUpper.IndexOf("ENABLEDFALSE") >= 0 Then pomIzraz = NZ(Replace(pomIzraz, "enabledfalse", "", 1, , CompareMethod.Text)).Trim
