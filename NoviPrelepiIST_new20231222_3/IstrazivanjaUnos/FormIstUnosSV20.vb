    Function sskoci2panel(ByVal panel As Panel, ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control,
                            ByVal nizskociNAsss As String, ByVal maxrbr As Integer, ByVal nizskociAKOsss As String, ByVal nizskociActionsss As String,
                            ByVal skippedEnabledFalse As Boolean, ByVal skippedSetEmpty As Boolean,
                            ByVal skippedVisibleFalse As Boolean, ByVal skippedDontSave As Boolean,
                            ByVal nizskippedSetEmptyExcept() As String, ByVal nizskippedSetEmptyExceptIF() As String) As Control

        Dim panelautoscroll As Boolean = False
        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.IndexOf("SCROLLBAR;") >= 0 Then panelautoscroll = True

        Dim dppRBR As Integer
        If Not cntl.AccessibleDescription Is Nothing Then dppRBR = cntl.AccessibleDescription.Split(";")(0)

        sskoci2panel = Nothing

        Dim nizskociNAsssrbr As Integer
        For Each k As Control In panel.Controls
            If (TypeOf k Is TextBox AndAlso Mid(k.Name, 2, 1) <> "F") OrElse TypeOf k Is ComboBox Then
                If Mid(k.Name, 4).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    nizskociNAsssrbr = krbr
                    Exit For
                End If
            End If
        Next

        Dim tabela As String = GlavnaTabela
        If nizskociAKOsss = "" Then Exit Function
        Dim zzz As String = sracPanel(nizskociAKOsss, plj, cntl, panel)
        zzz = razCASTi(zzz)
        Dim a As Integer = scompute(zzz, plj, "skipif")
        'ispunjen USLOV
        If a = 1 Then
            Dim azSE As Integer = 0
            'skippedsetemptyExceptIf
            If Not nizskippedSetEmptyExcept Is Nothing AndAlso nizskippedSetEmptyExceptIF.Length > 0 Then
                For i As Integer = 0 To nizskippedSetEmptyExceptIF.GetUpperBound(0)
                    Dim zSE As String = sracunajIzraz(nizskippedSetEmptyExceptIF(i), plj, cntl)
                    zSE = razCASTi(zSE)
                    azSE = scompute(zSE, plj, "skippedsetemptyExceptIf")
                    If azSE = 1 Then
                        Dim nn As String() = Split(nizskippedSetEmptyExcept(i).Trim.ToUpper, ",")
                        For cc As Integer = 0 To nn.GetUpperBound(0)
                            Dim k As Control = panel.GetNextControl(Me, True) 'Get the first control in the tab order.
                            Do Until k Is Nothing  'MORA PREKO LOOPA
                                If Not TypeOf k Is Label AndAlso Not TypeOf k Is Button AndAlso Not TypeOf k Is DataGridView2 AndAlso
                                Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 2, 1) <> "F" AndAlso
                                Mid(k.Name, 2, 1) <> "L" Then
                                    Dim ind11 As Integer = Array.IndexOf(nn, Mid(k.Name, 4).Trim.ToUpper)
                                    Dim setempty As Boolean = False
                                    If ind11 < 0 Then setempty = True
                                    If setempty = True Then
                                        Dim trenutniRBR As Integer = -1
                                        If Not k.AccessibleDescription Is Nothing Then trenutniRBR = k.AccessibleDescription.Split(";")(0)
                                        If dppRBR < trenutniRBR AndAlso trenutniRBR < nizskociNAsssrbr Then
                                            k.Text = ""
                                            Me.UpisiPoljePanel(Mid(k.Name, 4).Trim.ToUpper, GlavnaTabela, panel)
                                        End If
                                    End If
                                End If
                                k = panel.GetNextControl(k, True) 'Get the next control in the tab order.
                            Loop
                        Next
                        Exit For
                    End If
                Next
            End If
            'skippedsetemptyExceptIf

            'skipAction
            If Not nizskociActionsss Is Nothing AndAlso nizskociActionsss.Length > 0 AndAlso nizskociActionsss.Trim <> "" Then
                'skippedEnabledFalse = False : skippedVisibleFalse = False : skippedDontSave = False : skippedSetEmpty = False
                Dim nn As String() = Split(nizskociActionsss, ",")
                For cc As Integer = 0 To nn.GetUpperBound(0)
                    If nn(cc).Trim.ToUpper = "ENABLEDFALSE" Then skippedEnabledFalse = True
                    If nn(cc).Trim.ToUpper = "VISIBLEFALSE" Then skippedVisibleFalse = True
                    If nn(cc).Trim.ToUpper = "DONTSAVE" Then skippedDontSave = True
                    If nn(cc).Trim.ToUpper = "SETEMPTY" Then skippedSetEmpty = True
                Next
            End If
            'skipAction

            If nizskociNAsss.Trim.ToUpper = "DUGMEDALJE" OrElse nizskociNAsss.Trim.ToUpper = "BUTTONNEXT" Then
            ElseIf nizskociNAsss.IndexOf("TABELA") = 0 Then
            ElseIf nizskociNAsss.IndexOf("TABLE") = 0 Then
            ElseIf nizskociNAsss.Trim.ToUpper = "DUGMESACUVAJ" OrElse nizskociNAsss.Trim.ToUpper = "BUTTONSAVE" Then
                Dim dugme As Button
                If panelautoscroll = True Then
                    dugme = NadjiKontrolu(Panel1, "DBTNSAVESCROLL" + tabela)
                Else
                    dugme = NadjiKontrolu(panel, "DBTNSAVE" + tabela)
                End If
                sskoci2panel = dugme
                For Each k As Control In panel.Controls
                    If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 1, 1).Trim.ToUpper <> "F" AndAlso Not k.AccessibleDescription Is Nothing Then
                        Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                        If dppRBR < trenutniRBR Then 'sve od polja sa koga skace pa do kraja ide u ovo dole
                            If skippedEnabledFalse = True Then k.Enabled = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4)  'ovim oznacavam koja kontrola ga je bacila u enable
                            If skippedVisibleFalse = True Then k.Visible = False
                            If skippedDontSave = True AndAlso Mid(k.Name, 2, 1) <> "F" Then
                                'k.AccessibleName = k.AccessibleName + "SHH;"
                                Call addSHH(k, nizskociAKOsss)
                            End If
                            If skippedSetEmpty = True AndAlso azSE = 0 AndAlso Mid(k.Name, 2, 1) <> "F" Then
                                k.Text = ""
                                Me.UpisiPoljePanel(Mid(k.Name, 4).Trim.ToUpper, GlavnaTabela, panel)
                            End If
                        End If
                    End If
                Next
            Else
                ''''obicno POLJE
                For Each k As Control In panel.Controls
                    If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox Then
                        If Mid(k.Name, 4).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                            'enabluj polje na koje skaces
                            If Mid(k.Name, 2, 1) <> "F" Then k.Enabled = True 'da ostanu fp
                            k.Visible = True
                            sskoci2panel = k
                        Else
                            'disejbluj sve izmedju
                            Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                            If dppRBR < trenutniRBR AndAlso trenutniRBR < nizskociNAsssrbr Then
                                If skippedEnabledFalse = True Then k.Enabled = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4)  'ovim oznacavam koja kontrola ga je bacila u enable
                                If skippedVisibleFalse = True Then k.Visible = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4)  'ovim oznacavam koja kontrola ga je bacila u visiblefalse
                                If skippedDontSave = True AndAlso Mid(k.Name, 2, 1) <> "F" Then
                                    k.AccessibleName = k.AccessibleName + "SHH;"
                                    Call addSHH(k, nizskociAKOsss)
                                End If
                                If skippedSetEmpty = True AndAlso azSE = 0 AndAlso Mid(k.Name, 2, 1) <> "F" Then
                                    k.Text = ""
                                    Me.UpisiPoljePanel(Mid(k.Name, 4).Trim.ToUpper, GlavnaTabela, panel)
                                End If
                            ElseIf trenutniRBR > nizskociNAsssrbr AndAlso trenutniRBR <= maxrbr Then
                                'enabluj sva polja posle onog na koje skaces a koje je manje od potencijalno najveceg polja na koje možeš da skočiš odavde
                                'I KOJA NISU ZATVORENA NEKIM DRUGIM PRAVILOM (SKOKOM)
                                If k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4) Then
                                    If skippedVisibleFalse = True Then k.Visible = True
                                    If Mid(k.Name, 2, 1) <> "F" Then
                                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                            k.Enabled = False 'da ostanu RRO; i RO;
                                        Else
                                            k.Enabled = True 'da ostanu fp
                                        End If
                                    End If

                                    If Mid(k.Name, 1, 3) <> "DRP" Then k.Visible = True  'remark da ostanu visiblefalse
                                Else
                                    'zatvorena akcijom sa nekog drugog polja, ne diraj
                                End If
                            End If
                        End If
                    End If
                Next
            End If ' If nizskociNA(sss).Trim.ToUpper = "DUGMEDALJE"
        End If   'a=1
    End Function

