                    If c.Name.Trim.Length > 2 AndAlso c.Name.Trim.ToUpper.Substring(2) = NslKljuc(j, 0).Trim.ToUpper Then   'NslKljuc(j, 0).Trim
                        For Each cc As Control In c.Controls
                            If cc.Name.Trim.ToUpper = ime + "CK" & NslKljuc(j, 0).Trim.ToUpper Then 'NslKljuc(j, 0).Trim
                                If cbosaFilteromizazur.IndexOf(NslKljuc(j, 0).Trim.ToUpper) < 0 Then
