    Function svichUGrupi(ByVal t As String, ByVal grupa As String) As String
        Dim grupaCh As String = ""
        Dim imaNR As Boolean = False
        For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            Dim pIzraz As String = ""
            If Not p.IsIzrazNull Then pIzraz = p.Izraz.ToUpper.Trim
            If p.TABELA.ToUpper.Trim = t AndAlso InStr(pIzraz, ":F") = 0 Then
                If p.IsKLJUCNull OrElse p.KLJUC.ToUpper.Trim <> "P" Then
                    If Not ImaVODVDO OrElse (p.POLJE.Trim.ToUpper <> "VOD" And p.POLJE.Trim.ToUpper <> "VDO") Then 'nije VOD ni VDO....
                        Dim pomIzraz As String = "" : Dim pom As String = ""
                        If p.IsIzrazNull = False Then pomIzraz = p.Izraz.Trim.ToUpper
                        If pomIzraz.Length >= 8 AndAlso pomIzraz.Substring(0, 8) = "CHECKBOX" OrElse
        pomIzraz.Length >= 10 AndAlso pomIzraz.Substring(0, 10) = "\NCHECKBOX" Then
                            Dim gde As Integer = pomIzraz.Trim.LastIndexOf("_")
                            Dim gr As String = pomIzraz.Substring(gde + 1)
                            If grupa = gr Then
                                If pomIzraz.IndexOf("\N") = 0 Then
                                    grupaCh = grupaCh & "\N" & p.POLJE.Trim.ToUpper & "$"
                                Else
                                    grupaCh = grupaCh & p.POLJE.Trim.ToUpper & "$"
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        Next
        grupaCh = grupaCh & "$"
        grupaCh = grupaCh.Replace("$$", "")
        svichUGrupi = grupaCh
    End Function

    Dim iRTBKontrola As Integer = -1
    Sub postaviCHtrtCATI(ByVal panel As Panel, ByVal panelpom As Panel, ByVal chtrt As CheckBox, ByVal checkBoxL As Boolean,
