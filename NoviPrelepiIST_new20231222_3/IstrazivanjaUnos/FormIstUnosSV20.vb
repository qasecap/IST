                            End If
                            grupePitanjaPoslednjePoljePanel(ipanel)(ii) = c.Name.ToUpper
                        End If

                        If c.Enabled = True AndAlso
(TypeOf c Is TextBox AndAlso c.Name.Trim.Length > 3 AndAlso c.Name.Substring(0, 3).ToUpper <> "DFP" AndAlso DirectCast(c, TextBox).ReadOnly = False OrElse
    TypeOf c Is ComboBox OrElse TypeOf c Is AutoCompleteTextbox) Then
