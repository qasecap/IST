    Function prikaziPorukaTekst(ByVal tbox As Control, ByVal plj As String, ByVal nizPorukaAko() As String, ByVal nizporukaJe() As String) As Boolean
        Dim ind As Integer = nizporukaJe.Length
        If nizPorukaAko.Length <= ind Then ind = nizPorukaAko.Length
        For sss As Integer = 0 To ind - 1
            Try
                If grupePitanjaCAPI Is Nothing Then
                    pporukaCAPI = sporuka1(GlavnaTabela, plj, tbox, nizPorukaAko(sss), nizporukaJe(sss))
                End If
                If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then
                    pporukaCAPI = sporuka1CAPI(GlavnaTabela, plj, tbox, nizPorukaAko(sss), nizporukaJe(sss))
                End If
                pporukaCAPI = pporukaCAPI.Trim
                If pporukaCAPI <> "" Then bbilaporuka = True : Exit For
            Catch ex As Exception
                Call zatvoriOLHC()
                ''msg 57
                Dim msgtxt1 As String = getMessageText(dtMessages, "57", Me.jezik)
                ISTMessageBox.Show(ex.Message, msgtxt1, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                ''ISTMessageBox.Show(ex.Message, "Error sporuka1 pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try
        Next

        If pporukaCAPI <> "" Then
            bbilaporuka = True
            'ISTMessageBox.Show(nizporukaPreDodeleJE(0), msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            If nizporukaJe(0).Trim.IndexOf("***") < 0 Then
                tbox.BackColor = Color.LemonChiffon
            Else
                tbox.BackColor = SystemColors.Window
            End If
        End If

        If pporukaCAPI <> "" Then
            Dim msgtxt As String = getMessageText(dtMessages, "34", Me.jezik)
            pporukaCAPI = pporukaCAPI.Replace("'", "")
            If simpleMsg = True Then
                ISTMessageBox.Show(pporukaCAPI, msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry SimpleMessage ", "OK table " + GlavnaTabela, pporukaCAPI)
            Else
                Dim ppp As DialogResult = ISTMessageBox.Show(pporukaCAPI, msgtxt, MessageBoxButtons.OKCancel, MessageBoxIcon.Exclamation, MessageBoxDefaultButton.Button2)
                Select Case ppp
                    Case DialogResult.OK
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry DialogResult ", "OK table " + GlavnaTabela, pporukaCAPI)
                    Case DialogResult.Cancel
                        okvalidacija = False
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry DialogResult ", "Cancel table " + GlavnaTabela, pporukaCAPI)
                End Select
            End If
        End If

        Return okvalidacija
    End Function
    Private Sub ddodelaAutoComplete(ByVal autbox As AutoCompleteTextbox, ByVal plj As String, Optional pp As Panel = Nothing, Optional kljuc As Boolean = False)
        Dim panel As Panel = Nothing
        Dim odakle As Integer = 3
        If kljuc = False Then
            panel = autbox.Parent
        End If

        Dim tabela As String = GlavnaTabela
        Dim panelno As Boolean = False

        If Not pp Is Nothing AndAlso pp.Name.Length > 4 AndAlso pp.Name.Trim.ToUpper.Substring(0, 5) = "PANE_" Then
            'obican panel dpp
            panel = pp
            odakle = 4
            tabela = panel.Name.Trim.ToUpper.Replace("PANE_", "")
            panelno = True
        End If

        Call autbleaveAL(autbox)

        Dim pomAssignWhat As String = ""
        Dim pomAssignTo As String = ""
        Dim pomAnulateFilterFor As String = ""
        Dim pomAnulateFilterForAssignTo As String = ""
        If Not autbox.AccessibleName Is Nothing AndAlso autbox.AccessibleName.IndexOf("AUTB") >= 0 Then

            pomAssignTo = DirectCast(autbox, AutoCompleteTextbox).autoCompleteAssignTo
            Dim nizacAssignTo As String() = pomAssignTo.Split("$")

            pomAssignWhat = DirectCast(autbox, AutoCompleteTextbox).assignvalue
            If pomAssignWhat = "" Then
                For i As Integer = 0 To nizacAssignTo.GetUpperBound(0) - 1
                    pomAssignWhat = pomAssignWhat + "$"
                Next
            End If
            Dim nizacAssignWhat As String() = pomAssignWhat.Split("$")

            pomAnulateFilterFor = DirectCast(autbox, AutoCompleteTextbox).autoCompleteFilterFor
            pomAnulateFilterForAssignTo = DirectCast(autbox, AutoCompleteTextbox).autoCompleteFilterForAssignTo

            If kljuc = False AndAlso pomAnulateFilterFor Is Nothing AndAlso pomAnulateFilterForAssignTo Is Nothing Then
                'proveri da nije filter preko autoCompleteAssignTo?
                Dim pom As String = pomIsFilter(pomAssignTo, panel, panelno)
                If pom <> "" AndAlso pom.Trim.IndexOf(";") >= 0 Then
                    Dim ll() As String = pom.Split(";")
                    pomAnulateFilterFor = ll(0)
                    pomAnulateFilterForAssignTo = ll(1)
                End If
            End If

            If kljuc = False AndAlso Not pomAssignWhat Is Nothing AndAlso pomAssignTo <> "" Then
                For Each k As Control In panel.Controls
                    For i As Integer = 0 To nizacAssignWhat.GetUpperBound(0)
                        Dim acw As String = nizacAssignWhat(i)
                        Dim act As String = nizacAssignTo(i)
                        If Mid(k.Name, odakle).Trim.ToUpper = act.Trim.ToUpper Then
                            k.Text = acw
                            If panelno = True Then
                                Me.UpisiPoljePanel(act, tabela, panel)
                            Else
                                Me.UpisiPolje(act,,, panel)
                            End If
                            Exit For
                        End If
                    Next
                Next
            End If

            If kljuc = False AndAlso Not pomAnulateFilterFor Is Nothing AndAlso pomAnulateFilterFor <> "" Then
                For Each k As Control In panel.Controls
                    If Mid(k.Name, odakle).Trim.ToUpper = pomAnulateFilterFor.Trim.ToUpper Then
                        k.Text = ""
                        If panelno = True Then
                            Me.UpisiPoljePanel(pomAnulateFilterFor, tabela, panel)
                        Else
                            Me.UpisiPolje(pomAnulateFilterFor,,, panel)
                        End If
                        Exit For
                    End If
                Next
            End If


            If kljuc = False AndAlso Not pomAssignTo Is Nothing AndAlso pomAssignTo <> "" Then
                Call prazniFilterAUTB(panel, panelno, odakle, tabela, pomAssignTo)
            End If


            If kljuc = False AndAlso Not pomAnulateFilterForAssignTo Is Nothing AndAlso pomAnulateFilterForAssignTo <> "" Then
                For Each k As Control In panel.Controls
                    If Mid(k.Name, odakle).Trim.ToUpper = pomAnulateFilterForAssignTo.Trim.ToUpper Then
                        k.Text = ""
                        If panelno = True Then
                            Me.UpisiPoljePanel(pomAnulateFilterForAssignTo, tabela, panel)
                        Else
                            Me.UpisiPolje(pomAnulateFilterForAssignTo,,, panel)
                        End If
                        Exit For
                    End If
                Next
            End If
        End If

    End Sub
    Sub prazniFilterAUTB(ByVal panel As Panel, ByVal panelno As Boolean, ByVal odakle As Integer, ByVal tabela As String, ByVal pomassignto As String)

        For Each k As Control In panel.Controls
            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("AUTB") >= 0 Then
                If Not DirectCast(k, AutoCompleteTextbox).autoCompleteFilterIs Is Nothing AndAlso
                     DirectCast(k, AutoCompleteTextbox).autoCompleteFilterIs.Trim <> "" AndAlso DirectCast(k, AutoCompleteTextbox).autoCompleteFilterIs.Trim.ToUpper.Replace("D.", "") = pomassignto.Trim.ToUpper Then

                    DirectCast(k, AutoCompleteTextbox).Text = ""
                    If panelno = True Then
                        Me.UpisiPoljePanel(Mid(k.Name, odakle).Trim.ToUpper, tabela, panel)
                    Else
                        Me.UpisiPolje(Mid(k.Name, odakle).Trim.ToUpper,,, panel)
                    End If

                    Dim nizacAssignTo As String() = DirectCast(k, AutoCompleteTextbox).autoCompleteAssignTo.Split("$")
                    If Not DirectCast(k, AutoCompleteTextbox).autoCompleteAssignTo Is Nothing AndAlso DirectCast(k, AutoCompleteTextbox).autoCompleteAssignTo.Trim <> "" Then
                        For Each kk As Control In panel.Controls
                            For i As Integer = 0 To nizacAssignTo.GetUpperBound(0)
                                Dim act As String = nizacAssignTo(i)
                                If Mid(kk.Name, odakle).Trim.ToUpper = act.Trim.ToUpper Then
                                    kk.Text = ""
                                    If panelno = True Then
                                        Me.UpisiPoljePanel(Mid(kk.Name, odakle), tabela, panel)
                                    Else
                                        Me.UpisiPolje(Mid(kk.Name, odakle),,, panel)
                                    End If
                                    Exit For
                                End If
                            Next
                        Next
                    End If


                    Call prazniFilterAUTB(panel, panelno, odakle, tabela, DirectCast(k, AutoCompleteTextbox).autoCompleteAssignTo.Trim)

                    Exit For
                End If

            End If

        Next




    End Sub
    Private Function pomIsFilter(ByVal nameFilter As String, ByVal panel As Panel, ByVal panelno As Boolean) As String
        nameFilter = nameFilter.Trim.ToUpper
        Dim odakle As Integer = 3
        If panelno = True Then odakle = 4

        Dim pomAnulateFilterFor As String = ""
        Dim pomAnulateFilterForAssignTo As String = ""

        Dim k As Control = NadjiKontroluSkrKojaNijeLABELA(panel, nameFilter, odakle - 1)   'panel
        pomIsFilter = ""
        If Not k Is Nothing AndAlso Not k.AccessibleDefaultActionDescription Is Nothing AndAlso k.AccessibleDefaultActionDescription <> "" Then
            Dim pom As String = k.AccessibleDefaultActionDescription.Trim.ToUpper
            Dim ll() As String = pom.Split(";")
            For i As Integer = 0 To ll.GetUpperBound(0)
                If ll(i).IndexOf("AUTOCOMPLETEFILTERFOR=") = 0 Then
                    pomAnulateFilterFor = ll(i).Replace("AUTOCOMPLETEFILTERFOR=", "")
                End If
                If ll(i).IndexOf("AUTOCOMPLETEFILTERFORASSIGNTO=") = 0 Then
                    pomAnulateFilterForAssignTo = ll(i).Replace("AUTOCOMPLETEFILTERFORASSIGNTO=", "")
                End If
            Next
            pomIsFilter = pomAnulateFilterFor + ";" + pomAnulateFilterForAssignTo
        End If
    End Function

    Private Sub filterValue(ByVal panel As Panel, ByVal actbox As AutoCompleteTextbox, ByVal odakle As Integer)
        Dim pomfilterIs As String = actbox.autoCompleteFilterIs.Trim.ToUpper.Replace("D.", "")
