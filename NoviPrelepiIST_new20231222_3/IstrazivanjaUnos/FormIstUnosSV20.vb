    Sub autbSelectNextControl(ByVal autb As AutoCompleteTextbox)
        Dim ii As Integer = autb.TabIndex
        Dim koji As Integer = -1
        For i As Integer = 0 To nizPKKontrola.GetUpperBound(0)
            Dim tt As Integer = nizPKKontrola(i).TabIndex
            If tt = ii + 1 Then
                koji = i
                Exit For
            End If
        Next

        If koji > -1 Then
            nizPKKontrola(koji).Focus()
            'DirectCast(nizPKKontrola(koji), AutoCompleteTextbox).Focus()
        Else
            'poslednji u kljucu, ide na prvi slobodan na formi
            Dim p As Panel = Me.Panel1
            If Not grupePitanjaCAPI Is Nothing AndAlso grupePitanjaCAPI.Length > 0 Then p = grupePitanjaCAPI(0)
            p.SelectNextControl(ActiveControl, True, True, True, True)
        End If
    End Sub

