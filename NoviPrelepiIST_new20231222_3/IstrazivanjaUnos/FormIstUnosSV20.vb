                    'End If 'if Select>0, nema potrebe, vec ispitano kroz kod
                End If ' A i Zadnji ili K
            End If ' dodela  If (Not (tbox.Tag Is Nothing))

            Dim nizCBnaCb As String() = Split(CBnaCB, ";")
            If CBnaCB <> "" AndAlso nizCBnaCb.Length > 0 Then
                For i As Integer = 0 To nizCBnaCb.Length - 1
                    Dim cbvb As String() = Split(nizCBnaCb(i), ",")
                    'ovo ako ima filter preko ovog TextBoxa, a ne drugog comboboxa
                    If cbvb.Length = 2 Then
                        If cbvb(0).Trim.ToUpper = plj.Trim.ToUpper Then
                            For Each k As Control In panel.Controls
                                If Mid(k.Name, 1, 1) = "C" AndAlso Mid(k.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                    cbpp_popuni(k, True, SP(plj, panel))
                                    Dim ur As DataRow = DGTabele(DGi(GlavnaTabela)).Rows(0) 'jer bi morao biti samo jedan?
                                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                                        CType(k, ComboBox).SelectedIndex = 0
                                    Else
                                        CType(k, ComboBox).SelectedValue = ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim
                                    End If
                                    Exit For
                                End If
                            Next
                        End If
                        ''filter je neko fiktivno polje (koje se mozda dobija pri izlasku iz oivog polja, pa mora sve ovo)
                        If cbvb(0).Trim.ToUpper.IndexOf("#FP{") = 0 Then
                            Dim bbb As String = cbvb(0).Trim.ToUpper.Replace("#FP{", "").Replace("}", "")
                            'zameni fiktivno polje sa  SE(bbb, True).Trim + "'"
                            For Each k As Control In panel.Controls
                                If Mid(k.Name, 1, 1) = "C" AndAlso Mid(k.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                    cbpp_popuni(k, True, SP(bbb, panel, True))
                                    Dim ur As DataRow = DGTabele(DGi(GlavnaTabela)).Rows(0) 'jer bi morao biti samo jedan?
                                    If ur.Item(Mid(k.Name.Trim.ToUpper, 3)) Is System.DBNull.Value Then
                                        CType(k, ComboBox).SelectedIndex = 0
                                    Else
                                        CType(k, ComboBox).SelectedValue = ur.Item(Mid(k.Name.Trim.ToUpper, 3)).ToString.Trim
                                    End If
                                    Exit For
                                End If
                            Next
                        End If
                    End If
                Next
            End If

            If menjanKljuc Then
                okvalidacija = False
                Kljuc1Focus()
                Exit Sub
            End If
            For Each JzP As JosZaPolje1 In JosZaPolja
                If JzP.Polje = plj AndAlso (JzP.DG = "{P}" Or JzP.DG = "{+}" Or JzP.DG = "{+FPP}") Then
                    JzP.vrednost = tbox.Text
                End If
            Next

            'AUTOCOMPLETETEXTBOXDODELA
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                If tbox.Text.Trim <> acoldvalue OrElse DirectCast(tbox, AutoCompleteTextbox).uradidodeluSilom = True Then
                    Call ddodelaAutoComplete(tbox, plj, panel)
                End If
            End If
            'AUTOCOMPLETETEXTBOXDODELA

            '***********************************************************
            'stopIF POLJA
            '***********************************************************
            Dim stoped As Boolean = False
            If Not stopIF Is Nothing AndAlso stopIF.Length > 0 Then
                Try
                    If sstopifPanel(GlavnaTabela, plj, tbox, stopIF, stopMSG, panel) Then
                        tbox.Focus()
                        okvalidacija = False
                        Exit Sub   'ovako je brze
                    End If
                Catch ex As Exception
                    ''msg 21
                    Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                    ISTMessageBox.Show("Check field: " + nvrd + plj + nvrd + " in validatingEvent (_ISTTablesColumns)! " + nvrd + "Example: isnull(field,'')<>'' and cast(field as int)=8 " + nvrd + ex.Message, msgtxt21 + ": stopIF dpp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                End Try
            End If

            'If bezzskakanja = False Then
            '***********************************************************
            '***********************************************************
            Try
                '***********************************************************
                'VISIBLEFALSE POLJA
                '***********************************************************
                If nizvisibleFalse.Length > 0 AndAlso nizvisibleFalseAKO.Length > 0 Then
                    For sss As Integer = 0 To nizvisibleFalseAKO.GetUpperBound(0)
                        Call vvisibleFalsePanel(panel, nizvisibleFalse(sss), nizvisibleFalseAKO(sss), plj, tbox)
                    Next
                End If 'nizvisibleFalse.Length
                '***********************************************************
                'VISIBLEtrue POLJA
                '***********************************************************
                If nizvisibleTrue.Length > 0 AndAlso nizvisibleTrueAKO.Length > 0 Then
                    For sss As Integer = 0 To nizvisibleTrueAKO.GetUpperBound(0)
                        Call vvisibletruePanel(panel, nizvisibleTrue(sss), nizvisibleTrueAKO(sss), plj, tbox)
                    Next
                End If 'nizvisibleTrue.Length
            Catch ex As Exception
                ISTMessageBox.Show("Error at dpp_ValidacijaRight on visible part" + nvrd + nvrd + ex.Message)
            End Try
            '***********************************************************
            'READONLY POLJA
            '***********************************************************
            If samoCita.Length > 0 AndAlso samoCitaAKO.Length > 0 Then
                Try
                    For sss As Integer = 0 To nizsamoCitaAKO.GetUpperBound(0)
                        Dim a As Integer = rreadOnlyPanel(panel, nizsamoCita(sss), nizsamoCitaAKO(sss), plj, tbox)
                    Next
                Catch ex As Exception
                    ''msg 21
                    Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                    ISTMessageBox.Show(ex.Message + nvrd + nvrd + "Check syntax for readOnly on field      " + plj + "", msgtxt21 + ": readOnly dpp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try
            End If 'samoCita.Length
            '***********************************************************
            'BOJIU, BOJIAKO
            '***********************************************************
            If bojiU.Length > 0 AndAlso bojiSta.Length > 0 AndAlso bojiAKO.Length > 0 Then
                Try
                    For sss As Integer = 0 To nizbojiAKO.GetUpperBound(0)
                        Dim a As Integer = bbojiuPanel(panel, GlavnaTabela, plj, tbox, nizbojiAKO(sss), nizbojiSta(sss), nizBojiU(sss))
                        If a = 1 Then Exit For   'nesto uradio
                    Next
                Catch ex As Exception
                    ''msg 21
                    Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                    ISTMessageBox.Show(ex.Message + nvrd + nvrd + "Check syntax for ColorTo on field      " + plj + "", msgtxt21 + ": ColorTo dpp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try
            End If 'bojiU.Length
            'End If '  If bezzskakanja = False Then

            '***********************************************************
            'DODELA
            '***********************************************************
            Try
                If dodeliKome.Length > 0 AndAlso dodeliSta.Length > 0 Then
                    If dodeliAko.Length > 0 Then
                        For sss As Integer = 0 To nizdodeliAko.GetUpperBound(0)
                            Call ddodelaPanel(panel, GlavnaTabela, plj, tbox, nizdodeliAko(sss), nizdodeliKome(sss), nizdodeliSta(sss))
                        Next
                    Else 'dodeliAko.Length=0
                        For sss As Integer = 0 To nizdodeliKome.GetUpperBound(0)
                            If nizdodeliKome(sss).Length > 0 Then
                                Call ddodelaPanel(panel, GlavnaTabela, plj, tbox, "2=2", nizdodeliKome(sss), nizdodeliSta(sss), 1)
                            End If
                        Next
                    End If 'dodeliAko.Length > 0 Then
                End If ' If dodeliKome.Length <> 0 AndAlso dodeliSta.Length <> 0 AndAlso tbox.Text.Trim.Length > 0 Then
            Catch ex As Exception
                ''msg 21
                ISTMessageBox.Show("Error at dpp_ValidacijaRight on dodela part" + nvrd + nvrd + ex.Message)
            End Try
            '***********************************************************
            'PORUKA
            '***********************************************************
            bbilaporuka = False
            pporukaPanel = ""
            If porukaJe.Length > 0 Then
                If porukaAKO.Length > 0 Then
                    For sss As Integer = 0 To nizporukaAKO.GetUpperBound(0)
                        pporukaPanel = sporuka1Panel(panel, GlavnaTabela, plj, tbox, nizporukaAKO(sss), nizporukaJE(sss))
                        If pporukaPanel <> "" AndAlso pporukaPanel <> "''" Then
                            bbilaporuka = True
                            Exit For   'nesto uradio
                        End If
                    Next
                Else
                    pporukaPanel = nizporukaJE(0)
                    If pporukaPanel <> "" AndAlso pporukaPanel <> "''" Then bbilaporuka = True
                End If 'porukaAKO.Length
            End If 'porukaNA.Length

            '***********************************************************
            'SKAKANJE
            '***********************************************************
            Dim biloSkakanje As Boolean = False
            bbiloskakanje = False

            If bezzskakanja = False Then
                If skociNA.Length > 0 AndAlso oMSGIS.Length = 0 Then
                    Try
                        biloSkakanje = panelSKIP("R", "dppvalidacijaright", nizskociNA, nizskociAKO, nizskociAction, panel, GlavnaTabela, plj, tbox,
                            skippedEnabledFalse, skippedSetEmpty, skippedVisibleFalse, skippeddontsave,
                            grupeCNTLBlokoviPanel, ipanel, grupePitanjaBlokoviPanel, nizskipPanel, nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
                    Catch ex As Exception
                        ISTMessageBox.Show("Error at dpp_ValidacijaRight on skipto part" + nvrd + nvrd + ex.Message)
                    End Try
                End If 'skociNA.Length

            End If
            bbiloskakanje = False
            If biloSkakanje = True Then bbiloskakanje = True
            'SKAKANJE KRAJ   treba da se skoci na bbss
            '******************************************************************************
            If bezzskakanja = False AndAlso odakledppkeyDown = "" Then   'NE TREBA KADA DOLAZI IZ VALIDACIJELEFT odakledppkeyDown = "left"
                'OPTION MESSAGE
                If nizoMSGIS.Length > 0 AndAlso nizoMSGIF.Length > 0 AndAlso nizoMSGSKIPTO.Length > 0 AndAlso nizoMSGBTEXT.Length > 0 Then
                    Try
                        For i As Integer = 0 To nizoMSGIS.GetUpperBound(0)
                            Dim brojB As Integer = nizoMSGBTEXT(i).Split(",").Length
                            Dim brojS As Integer = nizoMSGSKIPTO(i).Split(",").Length
                            Dim broj As Integer
                            If brojB <= brojS Then
                                broj = brojB
                            Else
                                broj = brojS
                            End If
                            If broj > 3 Then broj = 3

                            Dim SEF As Boolean = False
                            Dim SSE As Boolean = False
                            Dim SDS As Boolean = False
                            Dim SVF As Boolean = False

                            If Not nizoMSGACTION Is Nothing AndAlso Not nizoMSGACTION(i) Is Nothing Then
                                If nizoMSGACTION(i).IndexOf("ENABLEDFALSE") = 0 Then SEF = True
                                If nizoMSGACTION(i).IndexOf("SETEMPTY") = 0 Then SSE = True
                                If nizoMSGACTION(i).IndexOf("DONTSAVE") = 0 Then SDS = True
                                If nizoMSGACTION(i).IndexOf("VISIBLEFALSE") = 0 Then SVF = True
                            End If

                            Dim pp As Boolean = optionMSGPanel(panel, GlavnaTabela, plj, tbox, nizoMSGIF(i), nizoMSGIS(i), nizoMSGSKIPTO(i).Split(","), nizoMSGBTEXT(i).Split(","), broj, SEF, SSE, SDS, SVF)
                            If pp = True Then
                                bbiloskakanje = True
                                Exit Sub
                            End If
                        Next
                    Catch ex As Exception
                        ''msg 21
                        Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                        ISTMessageBox.Show(ex.Message + nvrd + nvrd + "Check syntax for optionMSG on field      " + plj + "", msgtxt21 + ": optionMSG pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Finally
                    End Try
                End If
            End If

            'bez uslova, poruka i ostalog (naravno ako je zadovoljeno ono što važi za leave)
            If bioPageDown = True AndAlso pageDownNA.Length > 0 Then
                'SKAKANJE
                Try
                    Call sskoci4(pageDownNA)
                Catch ex As Exception
                    ''msg 21
                    Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                    ISTMessageBox.Show(ex.Message + nvrd + nvrd + "Check syntax for skipTo on PageDown on field      " + plj + "", msgtxt21 + ": sskoci4 pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                End Try
            End If 'If bioPageDown = True AndAlso pageDownNA.Length > 0 Then

        End If   'kraj od pitanja da li je zakljucan

    End Sub

    Function panelSKIP(ByVal direction As String, ByVal odakle As String, ByVal nizskociNA() As String, ByVal nizskociAKO() As String,
                        ByVal nizskociAction() As String, ByVal panel As Panel,
                        ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control,
                        ByVal skippedEnabledFalse As Boolean, ByVal skippedSetEmpty As Boolean,
                        ByVal skippedVisibleFalse As Boolean, ByVal skippeddontsave As Boolean,
                        ByVal grupeCNTLBlokoviPanel()()() As Control, ByVal ipanel As Integer,
                        ByVal grupePitanjaBlokoviPanel()() As String, ByVal nizskipPanel() As String,
                        Optional ByVal nizskippedSetEmptyExcept() As String = Nothing,
                        Optional ByVal nizskippedSetEmptyExceptIF() As String = Nothing) As Boolean
        'SKAKANJE
        Dim biloskakanje As Boolean = False
        Dim maxrbr As Integer = 0
        For sss As Integer = 0 To nizskociNA.GetUpperBound(0)
            If nizskociNA(sss).Trim.ToUpper <> "DUGMEDALJE" AndAlso nizskociNA(sss).Trim.ToUpper <> "BUTTONNEXT" AndAlso
                nizskociNA(sss).IndexOf("TABELA") < 0 AndAlso nizskociNA(sss).IndexOf("TABLE") < 0 AndAlso
                nizskociNA(sss).Trim.ToUpper <> "DUGMESACUVAJ" AndAlso nizskociNA(sss).Trim.ToUpper <> "BUTTONSAVE" Then
                Dim k As Control = NadjiKontroluSkr(panel, nizskociNA(sss), 3)
                If Not k Is Nothing AndAlso Not k.AccessibleDescription Is Nothing AndAlso k.AccessibleDescription.Split(";")(0) > maxrbr Then
                    maxrbr = k.AccessibleDescription.Split(";")(0)
                End If
            Else
                maxrbr = 10000000   'najveci moguci
                Exit For
            End If
        Next
        Dim pp As String = "FALSE"
        Dim izadji As Boolean = False

        For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
            bbss = Nothing
            Dim pomAction As String = Nothing
            If Not nizskociAction Is Nothing AndAlso nizskociAction.Length > 0 Then pomAction = nizskociAction(sss)

            If grupeCNTLBlokoviPanel.Length = 0 OrElse grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
                bbss = sskoci2panel(panel, GlavnaTabela, plj, cntl, nizskociNA(sss), maxrbr, nizskociAKO(sss), pomAction,
                                    skippedEnabledFalse, skippedSetEmpty, skippedVisibleFalse, skippeddontsave,
                                     nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
            End If

            If Not grupePitanjaBlokoviPanel(ipanel) Is Nothing Then

                'da li je prethodno bilo skakanje

                For i As Integer = 0 To nizskipPanel.GetUpperBound(0)
                    Dim nn() As String = nizskipPanel(i).Split("$")
                    If nn(0).Trim.ToUpper = panel.Name.Trim.ToUpper AndAlso nn(1).Trim.ToUpper = plj.Trim.ToUpper Then
                        If nn.Length = 3 AndAlso nn(2).Trim.ToUpper = "TRUE" Then
                            biloskakanje = True
                        End If
                        Exit For
                    End If
                Next

                Dim zzz As String = sracPanel(nizskociAKO(sss), plj, cntl, panel)
                zzz = razCASTi(zzz)
                Dim a As Integer = scompute(zzz, plj, "skipif")

                If direction = "R" Then
                    'ponisti efekte prethodnog skakanja bez obzira na uslov
                    'If biloskakanje = True Then
                    '    'Call ponistiEfekteprethodnogSkakanjaPanelGrupa(panel, GlavnaTabela, plj, cntl, nizskociNA(sss), maxrbr, pomAction,
                    '    '            skippedEnabledFalse, skippedSetEmpty, skippedVisibleFalse, skippeddontsave,
                    '    '            nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
                    '    pp = "FALSE"
                    'End If
                    If a = 1 Then
                        'oznaci gde da skoci i sta da uradi izmedju
                        bbss = sskoci2panelGrupa(panel, GlavnaTabela, plj, cntl, nizskociNA(sss), maxrbr, nizskociAKO(sss), pomAction,
                                      skippedEnabledFalse, skippedSetEmpty, skippedVisibleFalse, skippeddontsave,
                                      nizskippedSetEmptyExcept, nizskippedSetEmptyExceptIF)
                        If Not bbss Is Nothing Then pp = "TRUE"
                    End If
                End If ' If direction = "R" Then

            End If   ' If Not grupePitanjaBlokoviPanel(ipanel) Is Nothing Then

            If pp = "TRUE" Then
                biloskakanje = True
                Exit For
            End If

        Next   'uslov

        'postavljanje oznake da je bilo skakanje
        For i As Integer = 0 To nizskipPanel.GetUpperBound(0)
            Dim nn() As String = nizskipPanel(i).Split("$")
            If nn(0).Trim.ToUpper = panel.Name.Trim.ToUpper AndAlso nn(1).Trim.ToUpper = plj.Trim.ToUpper Then
                nizskipPanel(i) = nn(0) + "$" + nn(1) + "$" + pp
                Exit For
            End If
        Next

        Return biloskakanje

    End Function

    Private Sub dpp_ValidacijaRightSamoDodela(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)
        okvalidacija = True
        Dim tbox As TextBox = CType(sender, TextBox)
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 4)
        Dim panel As Panel = tbox.Parent
        Dim GlavnaTabela As String = panel.Name.Replace("PANE_", "")
        Dim addmissingvalue As String = ""
        'f2="!8refuse,f3="?9dontknow

        'AUTOCOMPLETETEXTBOXDODELA
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
            If tbox.Text.Trim <> acoldvalue Then
                Call ddodelaAutoComplete(tbox, plj, panel)
            End If
        End If
        'AUTOCOMPLETETEXTBOXDODELA

        Dim f2 As String = "" : Dim f3 As String = ""
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
            Dim pp() As String = tbox.AccessibleName.Split(";")
            For i As Integer = 0 To pp.GetUpperBound(0)
                If pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE") >= 0 Then
                    addmissingvalue = pp(i).Substring(pp(i).Trim.ToUpper.IndexOf("ADDMISSINGVALUE"))
                    Dim f2f3 As String = addmv(addmissingvalue, mdtLabel, txtmode, GlavnaTabela, jezik)
                    Dim ppom() As String = f2f3.Split("$")
                    f2 = ppom(0) : f3 = ppom(1)
                    Exit For
                End If
            Next
        End If

        If Me.btnNext.Visible = True Then   'znaci zakljucan NEMA MENJANJA, pa nema potrebe ni da ide kroz ovo
            'ne ide u ispitivanja
        Else   'NIJE ZAKLJUCAN
            If DGTabelePanel(DGi(GlavnaTabela)).Rows.Count <= 0 Then
                Me.Kljuc1FocusPanel(panel)
                Exit Sub
            End If

            If tbox.Modified Then
                Me.sacuvanoP = False
                Me.menjanoP = True
            End If

            ''POCETAK PROVERA KOD SAMOG POLJA
            Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
            Dim pomOD As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("od")).Trim.ToUpper
            pomOD = pomOD.Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
            Dim nizProvera() As String = {}

            Dim dodeliKome As String = ""
            Dim nizdodeliKome() As String = {}
            Dim dodeliSta As String = ""
            Dim nizdodeliSta() As String = {}
            Dim dodeliAko As String = ""
            Dim nizdodeliAko() As String = {}

            If pomOD.Length > 0 AndAlso pomOD.Trim.IndexOf("#{") = 0 Then
                pomOD = pomOD.Replace("#{", "")
                pomOD = pomOD.Replace("}", "")
                pomOD = pomOD.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                nizProvera = Split(pomOD, ";")
                For i As Integer = 0 To nizProvera.GetUpperBound(0)
                    nizProvera(i) = nizProvera(i).Trim.ToUpper
                    If nizProvera(i).IndexOf("DODELIKOME=") = 0 Then
                        dodeliKome = nizProvera(i).Replace("DODELIKOME=", "")
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).IndexOf("DODELISTA=") = 0 Then
                        dodeliSta = nizProvera(i).Replace("DODELISTA=", "")
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).IndexOf("DODELIAKO=") = 0 Then
                        dodeliAko = (nizProvera(i).Replace("DODELIAKO=", ""))
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If

                    If nizProvera(i).IndexOf("ASSIGNTO=") = 0 Then
                        dodeliKome = nizProvera(i).Replace("ASSIGNTO=", "")
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).IndexOf("ASSIGNWHAT=") = 0 Then
                        dodeliSta = nizProvera(i).Replace("ASSIGNWHAT=", "")
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).IndexOf("ASSIGNIF=") = 0 Then
                        dodeliAko = (nizProvera(i).Replace("ASSIGNIF=", ""))
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If
                Next
            End If

            'KRAJ AKCIJE
            'OSTALO PREBACENO NA KRAJ ZBOG FALSOVA
            Try
                Me.UpisiPoljePanel(plj, GlavnaTabela, panel, , f2, f3)
                'mora 2 puta (ako nekom treba fp u relaciji)
                PreracunajFPPanel(GlavnaTabela, panel, "FPnPK", plj)
                PreracunajFPPanel(GlavnaTabela, panel, "FPMEM")
            Catch ex As Exception
                ''msg 32
                Dim msgtxt32 As String = getMessageText(dtMessages, "32", Me.jezik)
                ''msg 33
                Dim msgtxt33 As String = getMessageText(dtMessages, "33", Me.jezik)
                ''msg 55
                Dim msgtxt55 As String = getMessageText(dtMessages, "55", Me.jezik)
                ISTMessageBox.Show(msgtxt32 + nvrd + msgtxt33, msgtxt55, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                'ISTMessageBox.Show("Greška kod upisa polja - nije dobar tip podataka " + vbCrLf + "ili uneta vrednost prelazi definisanu vrednost u bazi", "Greska kod upisa polja!", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                tbox.Focus()
                okvalidacija = False
                Exit Sub
            Finally
            End Try

            '***********************************************************
            'DODELA
            '***********************************************************
            Try
                If dodeliKome.Length > 0 AndAlso dodeliSta.Length > 0 Then
                    If dodeliAko.Length > 0 Then
                        For sss As Integer = 0 To nizdodeliAko.GetUpperBound(0)
                            Call ddodelaPanel(panel, GlavnaTabela, plj, tbox, nizdodeliAko(sss), nizdodeliKome(sss), nizdodeliSta(sss))
                        Next
                    Else 'dodeliAko.Length=0
                        For sss As Integer = 0 To nizdodeliKome.GetUpperBound(0)
                            If nizdodeliKome(sss).Length > 0 Then
                                Call ddodelaPanel(panel, GlavnaTabela, plj, tbox, "2=2", nizdodeliKome(sss), nizdodeliSta(sss), 1)
                            End If
                        Next
                    End If 'dodeliAko.Length > 0 Then
                End If ' If dodeliKome.Length <> 0 AndAlso dodeliSta.Length <> 0 AndAlso tbox.Text.Trim.Length > 0 Then
            Catch ex As Exception
                ''msg 21
                ISTMessageBox.Show("Error at dpp_ValidacijaRight on dodela part" + nvrd + nvrd + ex.Message)
            End Try

        End If   'kraj od pitanja da li je zakljucan
    End Sub

    Sub dpp_ValidacijaLeftUp(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)

        '1 ako ide levo, sve je ok, nije bila promena
        '2 ako treba da ode udesno zato sto je bila promena

        Dim tbox As TextBox = CType(sender, TextBox)
        okvalidacija = True
        If tbox.Modified = False AndAlso Me.BtnExit.Focused Then Exit Sub

        Dim promenaV As Boolean = False
        If dppVrednostEnter <> tbox.Text Then
            okvalidacija = False
            'TREBA GA IZBACITI ODAVDE I POSLATI KAO DA JE KLIKNUO ENTER
