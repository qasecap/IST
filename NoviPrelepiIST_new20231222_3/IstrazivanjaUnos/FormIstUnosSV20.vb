    Function istTipInteger(ByVal pommtip As String) As Boolean
        istTipInteger = False
        If (pommtip = "INT" Or pommtip = "INTEGER" Or pommtip = "SMALLINT" Or pommtip = "TINYINT" Or pommtip = "BIG" Or pommtip = "BIGINT") Then
            istTipInteger = True
        End If
    End Function

    Function istDuzinaOK(ByVal pommduz As String) As Boolean
        istDuzinaOK = False
        If (Not pommduz Is DBNull.Value) AndAlso CStr(pommduz).Trim <> "001" AndAlso CStr(pommduz).Trim <> "" AndAlso IsNumeric(pommduz) = True Then
            istDuzinaOK = True
        End If
    End Function
    Private Sub pp_actbox_KeyUp(ByVal sender As Object, ByVal e As KeyEventArgs)
        'ISTMessageBox.Show("pp_KeyUp")

        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub

        Dim actbox As AutoCompleteTextbox = CType(sender, AutoCompleteTextbox)
        Dim plj As String = Mid(actbox.Name.Trim.ToUpper, 3)
        actbox.AccessibleName = actbox.AccessibleName + "WSAWS;"   'zbog OnTextChanged koji je u formTemplate
        Dim autb As Boolean = True : Dim autbDB As Boolean = False
        If actbox.AccessibleName.IndexOf("AUTBDB;") >= 0 Then autbDB = True
        If autb = True AndAlso actbox.grupePitanjaCAPI = True AndAlso actbox.skociNazadGrupa = True Then
            Call finalySkipGrupaNazad(actbox, plj, autb)
            Dim tblok As Integer = Array.IndexOf(grupePitanjaCAPI, actbox.Parent)
            Call ButtonCapiColor(IndBlokaNaKomeSmo, tblok)
        End If
        If autb = True AndAlso actbox.grupePitanjaCATI = True AndAlso actbox.skociNazadGrupa = True Then
            ' nema validacije
            nepotrebnavalidacijaCATI = True
            If dalijeprviCATIPanel(actbox.Parent) = False AndAlso dalijeprviTBNaCATIPanelu(actbox.Parent, actbox) = True Then
                Call dugmeCATIP(actbox)
                e.SuppressKeyPress = True   'zbog multiline inace ne radi
            ElseIf dalijeprviCATIPanel(actbox.Parent) = True AndAlso dalijeprviTBNaCATIPanelu(actbox.Parent, actbox) = True Then
                'MORA OVAKO INACE AKO PRITISNU ISTOVREMENO KEUP AND KEYDDOWN PUSTA IH DA ODU, a actbox.focus ne radi nista
                nepotrebnavalidacijaCATI = False
            ElseIf dalijeprviCATIPanel(actbox.Parent) = False AndAlso dalijeprviTBNaCATIPanelu(actbox.Parent, actbox) = False Then
                SendKeys.SendWait("+{TAB}")
            ElseIf dalijeprviCATIPanel(actbox.Parent) = True AndAlso dalijeprviTBNaCATIPanelu(actbox.Parent, actbox) = False Then
                SendKeys.SendWait("+{TAB}")
            End If
        End If
        If actbox.listBox.Visible = False AndAlso e.KeyCode = Keys.Up And actbox.otisaogore = False Then
            nepotrebnavalidacija = True
            DirectCast(actbox, AutoCompleteTextbox).nepotrebnavalidacija = True
            If Not actbox.setFocusOn Is Nothing Then actbox.setFocusOn.Focus()
            DirectCast(actbox, AutoCompleteTextbox).nepotrebnavalidacija = False
            nepotrebnavalidacija = False
        End If

        actbox.AccessibleName = actbox.AccessibleName.Replace("WSAWS;", "")

    End Sub

