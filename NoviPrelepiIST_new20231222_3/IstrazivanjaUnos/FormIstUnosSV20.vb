    Sub dugmeCATIP(ByVal tbox As TextBox, Optional ctrt As pomTextBox = Nothing)
        Me.Panel1.Height = maxVisinaPanel1CATI
        If Not tbox Is Nothing Then
            Dim kojiP As String = tbox.Parent.Name.Replace("CATI_", "")
            Call trenutniPrethodniCATI(CInt(kojiP), CInt(kojiP) - 1)
        End If
        If Not ctrt Is Nothing Then
            Dim kojiP As String = ctrt.Parent.Name.Replace("CATI_", "")
            Call trenutniPrethodniCATI(CInt(kojiP), CInt(kojiP) - 1)
        End If
    End Sub

    Sub trenutniPrethodniCATI(ByVal trenutni As Integer, ByVal prethodni As Integer)
        For i As Integer = trenutni To 2 Step -1
            Dim panelPrevious As Panel = NadjiKontrolu(Me, "CATI_" + (i - 1).ToString.Trim)
            Dim panelCurrent As Panel = NadjiKontrolu(Me, "CATI_" + i.ToString.Trim)
            If Not panelPrevious Is Nothing Then
                panelCurrent.Visible = False
                panelPrevious.Visible = True
                If BarJednaKontrolaVidljiva(panelPrevious) Then
                    dajPPanel(panelCurrent, panelPrevious, prethodni, trenutni)
                    Dim panelPreviousPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + (i - 1).ToString.Trim)
                    Dim panelPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + i.ToString.Trim)
                    If Not panelPreviousPom Is Nothing Then
                        panelPom.Visible = False
                        panelPreviousPom.Visible = True
                        panelPreviousPom.BringToFront()
                    End If
                    Exit For
                End If
            End If
        Next
    End Sub

