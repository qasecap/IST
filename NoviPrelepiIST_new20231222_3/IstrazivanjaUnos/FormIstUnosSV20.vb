                    'pomstopifLinkMSG = m.Replace("GRIDLINKSTOPIFMSG=", "")
                End If
                If m.IndexOf("GRIDLINKSTOPSTOPMSGFOCUSON=") = 0 Then
                    pomstopifLinkMSGFocusON = NZ(Replace(pp(i), "gridlinkstopmsgfocuson=", "", 1, , CompareMethod.Text)).Trim
                End If
                If m.IndexOf("GRIDLINKSTOPMSGONPNL") = 0 Then
                    pomstopMSGOnPnl = True
                End If
            Next

            Dim imaEdit As Boolean = False
            Dim imaEditR As Boolean = False
            For ii As Integer = 0 To brlinks
                If cclinkaction(ii).Trim.ToUpper.IndexOf("EDIT") = 0 AndAlso cclinkaction(ii).Trim.ToUpper.IndexOf("EDITROWINGRID") < 0 Then imaEdit = True
                If cclinkaction(ii).Trim.ToUpper.IndexOf("EDITROWINGRID") = 0 Then
                    imaEditR = True
                End If
            Next

            Dim pcc() As String = Nothing
            Dim pccMSG() As String = Nothing
            If pomstopifLink <> "" Then pcc = pomstopifLink.Split("$")
            If pomstopifLinkMSG <> "" Then pccMSG = pomstopifLinkMSG.Split("$")

            Me.Cursor = Cursors.WaitCursor
            Dim izadji As Boolean = False

            For ii As Integer = 0 To brlinks
                If dgvgrid.Columns(eColumnIndex).DisplayIndex = ii Then
                    'If e.ColumnIndex = ii Then
                    cclinkaction(ii) = cclinkaction(ii).Trim.ToUpper
                    If cclinkaction(ii).IndexOf("EDIT") = 0 OrElse cclinkaction(ii).IndexOf("OPEN=") = 0 OrElse
                        cclinkaction(ii).IndexOf("DELETE") = 0 OrElse cclinkaction(ii).IndexOf("ADDNEWROWINGRID") = 0 OrElse
                        cclinkaction(ii).IndexOf("EDITROWINGRID") = 0 OrElse cclinkaction(ii).IndexOf("CANCELEDITROWINGRID") = 0 OrElse
                        cclinkaction(ii).IndexOf("SAVEROWINGRID") = 0 Then
                        If imaEdit = True AndAlso cclinkaction(ii).IndexOf("EDIT") >= 0 Then
                            fillFromDataGridView(dgvgrid, eRowIndex, brlinks)
                            If postojiISTLK = True Then
                                Call PrikaziLK2()
                            End If
                            If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("fillFromDataGridView", "dgv " + dgvgrid.Name)
                        End If
                        Dim pccii As String = ""
                        Dim pccmsgii As String = ""
                        If Not pcc Is Nothing AndAlso pcc.GetUpperBound(0) >= ii Then
                            pccii = pcc(ii)
                            pccmsgii = pccMSG(ii)
                        End If
                        Me.Cursor = Cursors.WaitCursor
                        Call linkAction(cclinkaction(ii), dgvgrid, eRowIndex, eColumnIndex, brlinks, imaEdit, imaEditR, columnsEditR, pccii, pccmsgii, pomstopMSGOnPnl, pomstopifLinkMSGFocusON)
                        Me.Cursor = Cursors.Default
                        izadji = True
                    End If
                    Exit For
                End If
            Next

            If izadji = False Then
                Dim imaColumnEdit As Boolean = False
                Dim imaColumnEditR As Boolean = False
                If Not cccolumnlinkaction Is Nothing AndAlso Not cccolumnlink Is Nothing Then
                    For ii As Integer = 0 To cccolumnlinkaction.GetUpperBound(0)
                        If cccolumnlinkaction(ii).Trim.ToUpper.IndexOf("EDIT") = 0 AndAlso cccolumnlinkaction(ii).Trim.ToUpper.IndexOf("EDITROWINGRID") < 0 Then imaColumnEdit = True
                        If cccolumnlinkaction(ii).Trim.ToUpper.IndexOf("EDITROWINGRID") = 0 Then
                            imaColumnEditR = True
                        End If
                    Next

                    Dim ind As Integer = Array.IndexOf(cccolumnlink, dgvgrid.Columns(eColumnIndex).Name.Trim.ToUpper)
                    If ind >= 0 Then
                        Dim akcija As String = cccolumnlinkaction(ind).Trim
                        If akcija.IndexOf("EDIT") = 0 OrElse akcija.IndexOf("OPEN=") = 0 OrElse akcija.IndexOf("DELETE") = 0 OrElse
                            akcija.IndexOf("ADDNEWROWINGRID") = 0 OrElse akcija.IndexOf("EDITROWINGRID") = 0 OrElse akcija.IndexOf("CANCELEDITROWINGRID") = 0 OrElse akcija.IndexOf("SAVEROWINGRID") = 0 Then
                            If imaColumnEdit = True AndAlso akcija.IndexOf("EDIT") >= 0 Then
                                fillFromDataGridView(dgvgrid, eRowIndex, cccolumnlinkaction.GetUpperBound(0))
                                If postojiISTLK = True Then
                                    Call PrikaziLK2()
                                End If

                                If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("fillFromDataGridView", "dgv " + dgvgrid.Name)
                            End If
                            Me.Cursor = Cursors.WaitCursor
                            Call linkAction(akcija, dgvgrid, eRowIndex, eColumnIndex, cccolumnlinkaction.GetUpperBound(0), imaColumnEdit, imaColumnEditR, columnsEditR, Nothing, Nothing, pomstopMSGOnPnl, pomstopifLinkMSGFocusON)
                            Me.Cursor = Cursors.Default
                        End If
                    End If
                End If
            End If

            Me.Cursor = Cursors.Default
        End If
        Me.Panel1.VerticalScroll.Visible = False
    End Sub
    Sub linkAction(ByVal ccii As String, ByVal dgv As DataGridView, ByVal eRowIndex As Integer, ByVal eColumnIndex As Integer, ByVal brlinks As Integer, ByVal imaEdit As Boolean, ByVal imaEditR As Boolean, ByVal columnsEditR() As String, ByVal stopif As String, ByVal stopmsg As String,
                     ByVal stopmsgOnPnl As Boolean, ByVal stopMsgFocusON As String)

        If eRowIndex < 0 Then
            Exit Sub
        End If
        Dim strexec As String = ""
        Dim strAction As String = ccii
        If ccii.IndexOf("#") >= 0 Then
            Dim pp() As String = ccii.Split("#")
            strAction = pp(0)
            strexec = pp(1)
        End If

        If strAction.IndexOf("OPEN=") = 0 Then

            If svejepraznonecuvaj() = False Then
                Me.PAMTINovo(True, False, True)   'nije sa zatvaranjem
            End If

            If TabelaPodtabela1_1(GlavnaTabela, strAction.Replace("OPEN=", "")) = True Then
                fillFromDataGridView(dgv, eRowIndex, brlinks)
                If postojiISTLK = True Then
                    Call PrikaziLK2()
                End If
            End If
            If stopif <> "" Then
                If sstopif(GlavnaTabela, dgv.Name, dgv, stopif, stopmsg, stopmsgOnPnl, stopMsgFocusON) Then
                    Exit Sub   'ovako je brze
                End If
            End If
            openFromDataGridView(dgv, strAction.Replace("OPEN=", ""), eRowIndex)
            If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("openFromDataGridView", "dgv " + dgv.Name)
        End If

        If imaEditR = True Then
            If columnsEditR Is Nothing Then
                dgv.Rows(eRowIndex).ReadOnly = False
            Else
                For i As Integer = 0 To columnsEditR.GetUpperBound(0)
                    dgv.Rows(eRowIndex).Cells(columnsEditR(i)).ReadOnly = False
                Next
            End If
            If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataGridViewEditInRow", "dgv " + dgv.Name)
        End If
        If strAction.IndexOf("CANCELEDITROWINGRID") = 0 And imaEditR = True Then
            dgv.CancelEdit()
            dgv.EndEdit()
            dgv.Rows(eRowIndex).ReadOnly = True
        End If

        If strAction.IndexOf("SAVEROWINGRID") = 0 And imaEditR = True Then
            dgv.EndEdit()
            dgv.Rows(eRowIndex).ReadOnly = True
        End If

        If strAction.IndexOf("ADDNEWROWINGRID") = 0 Then
            Dim imeTabele As String = "###" + dgv.Name.Trim.ToUpper
            imeTabele = imeTabele.Replace("###IDGV", "")
            addNewDataGridView(imeTabele)
            If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataGridViewAddNew", "dgv " + dgv.Name)
        End If

        If strAction.IndexOf("EXEC ") = 0 Then
            Call execGrid(strAction, dgv.Name)
        End If

        Dim msgtxt350 As String = getMessageText(dtMessages, "350", Me.jezik)
        Dim msgtxt351 As String = getMessageText(dtMessages, "351", Me.jezik)
        Dim msgtxt352 As String = getMessageText(dtMessages, "352", Me.jezik)
        Dim msgtxt353 As String = getMessageText(dtMessages, "353", Me.jezik)

        '350 Are you sure you want to delete?
        '351 Yes
        '352 No
        '353 Cancel

        If strAction.IndexOf("DELETE=") = 0 Then
            Dim dr1 As DialogResult = ISTMessageBox.Show(msgtxt350, "Question", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
            Select Case dr1
                Case DialogResult.Yes
                    Dim dr2 As DialogResult = ISTMessageBox.Show(msgtxt350, "Question", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Exclamation)
                    Select Case dr2
                        Case DialogResult.Yes
                            deleteFromDataGridView(dgv, strAction.Replace("DELETE=", ""), eRowIndex)
                            dgv.Refresh()
                            If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("deleteFromDataGridView DialogResult Yes", "dgv " + dgv.Name, "Are you sure you want to delete?")
                        Case DialogResult.No
                            Exit Sub
                        Case DialogResult.Cancel
                            Exit Sub
                    End Select
                Case DialogResult.No
                    Exit Sub
                Case DialogResult.Cancel
                    Exit Sub
            End Select
        End If

        If strexec.Trim <> "" Then
            Call execGrid(strexec, dgv.Name)
        End If



    End Sub

    Sub execGrid(ByVal execsql As String, ByVal dgvname As String)

        If execsql <> "" Then
            execsql = SrediPMGK(execsql)
            execsql = ZameniGGGMMMUnos(execsql)
            execsql = sracunajIzraz(execsql, Nothing, Nothing)
            Dim ok As String = izvrsiSQL(execsql, Me.DBConnectionString)
            If ok = "nok" Then
                ISTMessageBox.Show(execsql + nvrd + nvrd + "is not executed! ER81", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If
        End If
        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataGridViewExec", "dgv " + dgvname)
    End Sub
    Function dodajLL(ByVal dgvGRID As DataGridView) As Integer
        dodajLL = 0
        If dgvGRID.AccessibleDefaultActionDescription Is Nothing OrElse dgvGRID.AccessibleDefaultActionDescription = "" Then
            Exit Function
        Else
            Dim pp() As String = dgvGRID.AccessibleDefaultActionDescription.Split(";")
            Dim ccglt() As String = Nothing
            Dim ccglw() As String = Nothing
            Dim ccglc() As String = Nothing
            Dim ccgbc() As String = Nothing
            Dim ccgfc() As String = Nothing
            Dim ccgfs() As String = Nothing
            Dim ccgfst() As String = Nothing

            For i As Integer = 0 To pp.GetUpperBound(0)
                Dim m As String = pp(i).Trim.ToUpper
                If m.IndexOf("GRIDLINKTEXT=") = 0 Then
                    Dim pom As String = NZ(Replace(pp(i), "gridlinktext=", "", 1, , CompareMethod.Text)).Trim      'pp(i).Replace("GRIDLINKTEXT=", "")
                    ccglt = pom.Split("$")
                    dodajLL = ccglt.GetUpperBound(0)
                ElseIf m.IndexOf("GRIDLINKWIDTH=") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKWIDTH=", "")
                    ccglw = pom.Split("$")
                ElseIf m.IndexOf("GRIDLINKCAPTION=") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKCAPTION=", "")
                    ccglc = pom.Split("$")
                ElseIf m.IndexOf("GRIDLINKBACKCOLOR=") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKBACKCOLOR=", "")
                    ccgbc = pom.Split("$")
                ElseIf m.IndexOf("GRIDLINKFORECOLOR=") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKFORECOLOR=", "")
                    ccgfc = pom.Split("$")
                ElseIf m.IndexOf("GRIDLINKFONTSIZE") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKFONTSIZE", "").Replace("=", "")
                    ccgfs = pom.Split("$")
                ElseIf m.IndexOf("GRIDLINKFONTSTYLE=") = 0 Then
                    Dim pom As String = m.Replace("GRIDLINKFONTSTYLE=", "")
                    ccgfst = pom.Split("$")
                End If
            Next

            If Not ccglt Is Nothing AndAlso ccglt.Length > 0 Then
                For ii As Integer = 0 To ccglt.GetUpperBound(0)
                    Dim ll As DataGridViewLinkColumn = New DataGridViewLinkColumn()
                    ll.Text = ccglt(ii)
                    ll.Name = ccglt(ii)
                    ll.DataPropertyName = ccglt(ii)
                    ll.Width = 50
                    If Not ccglw Is Nothing AndAlso Not ccglw(ii) Is Nothing AndAlso IsNumeric(ccglw(ii)) = True Then ll.Width = ccglw(ii)
                    If Not ccglc Is Nothing AndAlso Not ccglc(ii) Is Nothing Then ll.HeaderText = ccglc(ii) Else ll.HeaderText = ""
                    ll.UseColumnTextForLinkValue = True
                    ll.LinkBehavior = LinkBehavior.AlwaysUnderline
                    ll.LinkColor = Color.DarkBlue
                    ll.VisitedLinkColor = Color.Gray
                    ll.TrackVisitedState = True

                    Dim fftt As FontStyle = FontStyle.Regular
                    Dim ffttB As FontStyle = FontStyle.Bold
                    Dim ffttI As FontStyle = FontStyle.Italic
                    Dim ffttU As FontStyle = FontStyle.Underline

                    Dim ttfontBold As Boolean = False
                    Dim ttfontItalic As Boolean = False
                    Dim ttfontUnderline As Boolean = False

                    If Not ccgfst Is Nothing AndAlso Not ccgfst(ii) Is Nothing Then
                        If ccgfst(ii).Trim.ToUpper.IndexOf("BOLD") >= 0 Then ttfontBold = True
                        If ccgfst(ii).Trim.ToUpper.IndexOf("ITALIC") >= 0 Then ttfontItalic = True
                        If ccgfst(ii).Trim.ToUpper.IndexOf("UNDERLINE") >= 0 Then ttfontUnderline = True
                    End If


                    If ttfontBold = True And ttfontItalic = True And ttfontUnderline = True Then fftt = ffttB Or ffttI Or ffttU
                    If ttfontBold = True And ttfontItalic = True And ttfontUnderline = False Then fftt = ffttB Or ffttI
                    If ttfontBold = True And ttfontItalic = False And ttfontUnderline = False Then fftt = ffttB
                    If ttfontBold = True And ttfontItalic = False And ttfontUnderline = True Then fftt = ffttB Or ffttU
                    If ttfontBold = False And ttfontItalic = True And ttfontUnderline = True Then fftt = ffttI Or ffttU
                    If ttfontBold = False And ttfontItalic = False And ttfontUnderline = True Then fftt = ffttU
                    If ttfontBold = False And ttfontItalic = True And ttfontUnderline = False Then fftt = ffttI

                    Dim fs As Integer = 8
                    If Not ccgfs Is Nothing AndAlso Not ccgfs(ii) Is Nothing Then
                        If IsNumeric(ccgfs(ii)) AndAlso CInt(ccgfs(ii)) > 4 Then
                            fs = CInt(ccgfs(ii))
                        End If
                    End If


                    ll.HeaderCell.Style.Font = New Font(Me.Font.Name, fs, fftt)

                    If Not ccgbc Is Nothing AndAlso Not ccgbc(ii) Is Nothing AndAlso ccgbc(ii).Trim <> "" Then ll.HeaderCell.Style.BackColor = Color.FromName(ccgbc(ii))
                    If Not ccgfc Is Nothing AndAlso Not ccgfc(ii) Is Nothing AndAlso ccgfc(ii).Trim <> "" Then ll.HeaderCell.Style.ForeColor = Color.FromName(ccgfc(ii))
                    dgvGRID.Columns.Add(ll)
                    dgvGRID.Columns(ll.Text).DisplayIndex = ii
                    dgvGRID.EnableHeadersVisualStyles = False


                    'ovo sredi kolonu bez headera
                    'dgvGRID.Columns(ll.Text).DefaultCellStyle.Font = New Font(dgvGRID.DefaultCellStyle.Font.FontFamily, 25, FontStyle.Bold)


                Next
            End If

        End If

    End Function
