                            tabLocationY = tabLocationYPrva
                            Call dodajTab(t, pane, opisD, kojatabela, tabLocationY, kakovisible, tabT2, tabBaza)
                        Else
                            pane.Location = New Point(0, Me.Panel1.Height)
                            pane.Tag = ""
