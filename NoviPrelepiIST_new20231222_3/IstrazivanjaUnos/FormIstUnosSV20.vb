    Private Sub rb_KeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs)
        'ISTMessageBox.Show("kp")
        Dim trt As RadioButton = CType(sender, RadioButton)
        AktivanRadioBaton = trt
        If SCati = False Then
            Select Case e.KeyChar
                Case ChrW(27) 'ESC
                    Me.BtnExit.Focus()
                Case ChrW(13) 'Enter
                    rbvalidacija(sender, e)
                    If trt.Focused = True Then
                        'SendKeys.Send("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                    End If
                Case ChrW(33) 'pageDown
                    bioPageDown = True
                    'SendKeys.Send("{TAB}")
                    'MORA OVAKO DOKAZ PROBNIPOPIS
                    Me.SelectNextControl(ActiveControl, True, True, True, True)
                Case Else
            End Select
        Else
            Dim rg As Panel = trt.Parent
            Dim p As Panel = rg.Parent
            Select Case e.KeyChar
                Case ChrW(13) 'Enter
                    Dim mm() As String = rg.AccessibleDescription.Split(";")
                    Dim trenutniRBR As Integer = mm(0)
                    Call sledecaLabelaVidljiva(trenutniRBR)
                    Call sledeceKontroleVidljive(trenutniRBR, p)
                    Dim trttb As TextBox = upisiRBuTP(trt)
                    If dalijeposlednjiTBNaCATIPanelu(trttb.Parent, trttb) = True Then
