        If xxGP <> -100 AndAlso yyGP <> -100 Then Me.AlwaysVisibleLabel.Location = New Point(xxGP, yyGP)

        If OUP = False Then
            dppVrednostEnter = tbox.Text
        End If

        Dim tboxind As Integer = -1
        If Not nizbio Is Nothing Then tboxind = Array.IndexOf(nizbio, tbox)
        If tboxind < 0 Then
            nind = nind + 1
            ReDim Preserve nizbio(nind)
            nizbio(nind) = tbox
            ReDim Preserve nizbiovred(nind)
            nizbiovred(nind) = tbox.Text
        End If

        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 4)
        Dim panel As Panel = tbox.Parent

        'AUTOCOMPLETETEXTBOX FILTERIS
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
            acoldvalue = tbox.Text
            Call filterValue(panel, tbox, 4)
        Else
            acoldvalue = ""
        End If
        'AUTOCOMPLETETEXTBOX FILTERIS

        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)
        Dim GlavnaTabela As String = panel.Name.Replace("PANE_", "")

        Dim avltekst As String = ""

        If tbox.Enabled Then

            nepotrebnavalidacijaPanel = False
            panel.AutoScroll = False
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("SCROLLDOWN;") >= 0 Then
                Panel1.AutoScrollPosition = New Point(0, Panel1.VerticalScroll.Maximum \ 2)
            End If

            panel.AutoScroll = True

            'AktivanTekstBoks = CType(sender, TextBox)

            'nadji nadtabela sta je
            Dim nadtabela As String = nadtabelaJe(GlavnaTabela)

            Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
            Dim pomDO As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("do"))

            Dim dodeliKome As String = ""
            Dim nizdodeliKome() As String = {}
            Dim dodeliSta As String = ""
            Dim nizdodeliSta() As String = {}
            Dim dodeliAko As String = ""
            Dim nizdodeliAko() As String = {}

            Dim nizProvera() As String = {}

            Dim skippedEnabledFalse As Boolean = False
            Dim skippedVisibleFalse As Boolean = False
            Dim skippedSetEmpty As Boolean = False
            Dim skippeddontsave As Boolean = False

            Dim skociNA As String = ""
            Dim nizskociNA() As String = {}
            Dim skociAKO As String = ""
            Dim nizskociAKO() As String = {}

            'readOnly
            Dim samoCita As String = ""
            Dim nizsamoCita() As String = {}
            Dim samoCitaAKO As String = ""
            Dim nizsamoCitaAKO() As String = {}

            If pomDO.Length > 0 AndAlso pomDO.Trim.IndexOf("#{") = 0 Then
                pomDO = pomDO.Replace("#{", "")
                pomDO = pomDO.Replace("}", "")
                pomDO = pomDO.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                nizProvera = Split(pomDO, ";")
                For i As Integer = 0 To nizProvera.GetUpperBound(0)
                    If nizProvera(i).Trim.ToUpper.IndexOf("DODELIKOME=") >= 0 Then
                        dodeliKome = NZ(Replace(nizProvera(i), "dodelikome=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("DODELISTA=") >= 0 Then
                        dodeliSta = NZ(Replace(nizProvera(i), "dodelista=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("DODELIAKO=") >= 0 Then
                        dodeliAko = NZ(Replace(nizProvera(i), "dodeliako=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If

                    If nizProvera(i).Trim.ToUpper.IndexOf("READONLY=") >= 0 Then
                        samoCita = NZ(Replace(nizProvera(i), "readonly=", "", 1, , CompareMethod.Text)).Trim
                        nizsamoCita = Split(samoCita, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("READONLYAKO=") >= 0 Then
                        samoCitaAKO = NZ(Replace(nizProvera(i), "readonlyako=", "", 1, , CompareMethod.Text)).Trim
                        nizsamoCitaAKO = Split(samoCitaAKO, "$")
                    End If
                    '****************
                    If nizProvera(i).Trim.ToUpper.IndexOf("ASSIGNTO=") >= 0 Then
                        dodeliKome = NZ(Replace(nizProvera(i), "assignto=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("ASSIGNWHAT=") >= 0 Then
                        dodeliSta = NZ(Replace(nizProvera(i), "assignwhat=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("ASSIGNIF=") >= 0 Then
                        dodeliAko = NZ(Replace(nizProvera(i), "assignif=", "", 1, , CompareMethod.Text)).Trim
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If
                    If nizProvera(i).Trim.ToUpper.IndexOf("READONLYIF=") >= 0 Then
                        samoCitaAKO = NZ(Replace(nizProvera(i), "readonlyif=", "", 1, , CompareMethod.Text)).Trim
                        nizsamoCitaAKO = Split(samoCitaAKO, "$")
