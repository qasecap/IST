    Private Function vredKljucaPanelAutoListNext(ByVal tabela As String, ByVal autoListBy As String,
                                                 ByVal autoListByto As String, ByVal vred As String) As String
        vredKljucaPanelAutoListNext = ""
        Dim dv As DataView = Me.DGTabele(DGi(tabela)).DefaultView
        Dim idid As Boolean = False
        If dv.Count > 0 Then
            dv.Sort = autoListBy + " ASC"
            If vred = "" Then
                vredKljucaPanelAutoListNext = dv(0).Item(autoListBy).ToString
            Else
                For i As Integer = 0 To dv.Count - 1
                    If idid = True Then
                        vredKljucaPanelAutoListNext = dv(i).Item(autoListBy).ToString
                        Exit For
                    End If
                    If CInt(dv(i).Item(autoListBy).ToString) = CInt(vred) AndAlso i < dv.Count - 1 Then
                        '  sledeci ako postoji ili +1 ako nije vece od autolistby
                        idid = True
                    End If
                    If idid = False AndAlso CInt(dv(i).Item(autoListBy).ToString) = CInt(vred) AndAlso i = dv.Count - 1 Then
                        ' +1 ako nije vece od autolistby
                        autoListByto = razCASTi(autoListByto).Trim
                        If IsNumeric(autoListByto) AndAlso CInt(vred) < CInt(autoListByto) Then vredKljucaPanelAutoListNext = CInt(vred) + 1
                    End If

                Next
            End If
        Else
            vredKljucaPanelAutoListNext = "1"
        End If

    End Function

    Dim autonumberpomuvecaj As Integer = 0

    Private Function vredKljucaAutoNumberNext(ByVal tabela As String, ByVal autoListBy As String, ByVal autoListByto As String, Optional ByVal autonumberStartFrom As String = "") As String

        'Dim dt As DataTable = Me.DTbl(DGi(tabela)).Copy


        Dim nsql As String = " 2=2 "

        Dim pomniz(,) As String = Nothing
        If Not Me.KljNadtabeleSavrednostima Is Nothing Then
            pomniz = KljNadtabeleSavrednostima
        ElseIf Not Me.NslKljuc Is Nothing Then
            pomniz = NslKljuc
        End If

        If Not pomniz Is Nothing Then
            For i As Integer = 0 To pomniz.GetUpperBound(0)
                nsql = nsql & " and " & pomniz(i, 0).Trim.ToUpper & "='" & pomniz(i, 1).Trim & "' "
            Next
        End If

        Dim dtpom As New DataTable
        Dim ddrd() As DataRow
        'dtpom = Me.DTbl(DGi(tabela)).Clone

        If DTbl Is Nothing Then
            dtpom = Me.DGTabele(DGi(tabela)).Clone()
            ddrd = Me.DGTabele(DGi(tabela)).Select(nsql.Replace("=N'", "='"))
        Else
            dtpom = Me.DTbl(DGi(tabela)).Clone()
            ddrd = Me.DTbl(DGi(tabela)).Select(nsql.Replace("=N'", "='"))
        End If



        For Each r As DataRow In ddrd
            dtpom.ImportRow(r)
        Next

        Dim dv As DataView = dtpom.DefaultView
        Dim vred As String = ""

        If autonumberStartFrom <> "" Then
            If dv.Count > 0 AndAlso autoNumberStartFromPom = True Then
                If IsNumeric(autoListByto) AndAlso CInt(autonumberpomuvecaj) < CInt(autoListByto) Then
                    vredKljucaAutoNumberNext = CInt(autonumberpomuvecaj) + 1
                    autonumberpomuvecaj = autonumberpomuvecaj + 1
                Else
                    vredKljucaAutoNumberNext = CInt(autonumberpomuvecaj)
                End If
            Else
                vredKljucaAutoNumberNext = autonumberStartFrom
                autoNumberStartFromPom = True
                autonumberpomuvecaj = autonumberStartFrom
            End If
        Else
            If dv.Count > 0 Then
                'dv.Sort = autoListBy + " DESC"
                'vred = dv(0).Item(autoListBy).ToString
                'autoListByto = razCASTi(autoListByto).Trim
                'If IsNumeric(autoListByto) AndAlso CInt(vred) < CInt(autoListByto) Then
                '    vredKljucaAutoNumberNext = CInt(vred) + 1
                'Else
                '    vredKljucaAutoNumberNext = CInt(vred)
                'End If
                vred = dv.Count
                autoListByto = razCASTi(autoListByto).Trim
                If IsNumeric(autoListByto) AndAlso CInt(vred) < CInt(autoListByto) Then
                    vredKljucaAutoNumberNext = rupa(dv, autoListBy)
                Else
                    vredKljucaAutoNumberNext = CInt(vred)
                End If
            Else
                vredKljucaAutoNumberNext = "1"
            End If



        End If




    End Function

    Function rupa(ByVal dv As DataView, ByVal autoListBy As String) As Integer
        dv.Sort = autoListBy + " ASC"
        Dim pv As String = "0"
        For i As Integer = 0 To dv.Count - 1
            Dim tr As String = dv(i).Item(autoListBy).ToString
            If CInt(tr) - CInt(pv) > 1 Then
                rupa = CInt(pv) + 1
                Exit For
            Else
                pv = dv(i).Item(autoListBy).ToString
                rupa = CInt(pv) + 1
            End If
        Next

    End Function

    Private Function PrazanKljucPanel(ByVal panel As Panel) As Boolean
        Dim bool As Boolean = True
        For Each c As Control In panel.Controls
            If c.Name.Trim.Length > 3 AndAlso (c.Name.Substring(0, 3).ToUpper = "DTK" OrElse c.Name.Substring(0, 3).ToUpper = "DCK") Then
                If c.Enabled = True Then bool = bool And c.Text.Trim <> Nothing
            End If
        Next
        Return (Not bool)
    End Function

