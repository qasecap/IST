        actbox.uradidodeluSilom = False

        actbox.autoCompleteFromBeginning = acFromBegining

        actbox.autoCompleteMaxDropDownItems = acMaxDropDownItems

        actbox.autoCompleteLimitToList = True
        actbox.autoCompleteLetter = acLetter
        If acLimitToList <> "" AndAlso acLimitToList.Trim.ToUpper = "FALSE" Then actbox.autoCompleteLimitToList = False
        actbox.MDoubleClick = False
        '*****

        If previewEditMode = True Then
            actbox.ContextMenuStrip = mnu02
            'AddHandler tbox.MouseDoubleClick, AddressOf Me.pp_MouseDoubleClick
            Dim pomforma As String = ""
            If p.IsFormaNull = False Then pomforma = p.Forma.Trim
            If p.IstipNull Then p.tip = ""
            If p.IsduzinaNull Then p.duzina = ""
            actbox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.Vod.ToString("yyyy/MM/dd").Trim + ";" + actbox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim + ";" + p.tip + ";" + p.duzina
        End If

        'actbox.actbnizKontrola = nizKontrola
        'actbox.actbnizKontrolaIme = nizKontrolaIme

        If mdtAWL.Rows.Count > 0 Then
            Dim awlNovo() As DataRow = mdtAWL.Select("tabela='" + GlavnaTabela.Trim.ToUpper + "' and polje='" + p.POLJE.Trim.ToUpper + "' and IDlang='" + Me.jezik + "'", "sort asc")
            Dim awltextNovo As String = "" : Dim awlNovoonKeyF1 As String = "" : Dim awlNovofFormat As String = ""
            If awlNovo.Length > 0 Then

                iKontrolaAWL = iKontrolaAWL + 1

                ReDim Preserve nizKontrolaAWL(iKontrolaAWL)
                nizKontrolaAWL(iKontrolaAWL) = actbox

                ReDim Preserve nizKontrolaAWLIme(iKontrolaAWL)
                nizKontrolaAWLIme(iKontrolaAWL) = p.POLJE.Trim.ToUpper

                ReDim Preserve nizKontrolaAWLtext(iKontrolaAWL)
                Dim awltext As String = dajTextZaAwlsIzISTAwls(awlNovo)
                nizKontrolaAWLtext(iKontrolaAWL) = awltext 'awlNovo(0).Item("ttext")

                ReDim Preserve nizKontrolaAWLF1(iKontrolaAWL)
                nizKontrolaAWLF1(iKontrolaAWL) = "0"

                'ReDim Preserve nizKontrolaAWLformat(iKontrolaAWL)
                'nizKontrolaAWLformat(iKontrolaAWL) = ""

                ReDim Preserve nizKontrolaAWLImaAssign(iKontrolaAWL)
                nizKontrolaAWLImaAssign(iKontrolaAWL) = "0"
                ReDim Preserve nizKontrolaAWLAssignTo(iKontrolaAWL)
                nizKontrolaAWLAssignTo(iKontrolaAWL) = ""

                awltextNovo = awltext 'awlNovo(0).Item("ttext")

                If Not awlNovo(0).Item("onF1") Is System.DBNull.Value Then
                    awlNovoonKeyF1 = awlNovo(0).Item("onF1")
                    If awlNovoonKeyF1.Trim = "1" Then nizKontrolaAWLF1(iKontrolaAWL) = "1"
                End If

                'awlNovofFormat = ""
                'nizKontrolaAWLformat(iKontrolaAWL) = awlNovofFormat

                If pOd.Trim.ToUpper.IndexOf("ASSIGNWHAT=") > -1 AndAlso pOd.Trim.ToUpper.IndexOf("AWLVALUE") > -1 Then
                    nizKontrolaAWLImaAssign(iKontrolaAWL) = "1"   'ima assign
                    Dim pp() As String = pOd.Split(";")
                    Dim aw As String = ""
                    Dim at As String = ""
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        If pp(i).Trim.ToUpper.Replace("{", "").Replace("}", "").IndexOf("ASSIGNWHAT=") = 0 Then
                            Dim mm() As String = pp(i).Trim.ToUpper.Replace("ASSIGNWHAT=", "").Split("$")
                            If mm.Length > 0 Then
                                For j As Integer = 0 To mm.GetUpperBound(0)
                                    If mm(j).Trim.ToUpper.Replace("{", "").Replace("}", "") = "AWLVALUE" Then aw = aw + Str(j).Trim + ","
                                Next
                            End If
                        End If
                    Next
                    aw = aw.TrimEnd(",")
                    Dim aww() As String = aw.Split(",")
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        If pp(i).Trim.ToUpper.IndexOf("ASSIGNTO=") = 0 Then
                            Dim mm22() As String = pp(i).Trim.ToUpper.Replace("{", "").Replace("}", "").Replace("ASSIGNTO=", "").Split("$")
                            Dim tzu As String = ""
                            For mm As Integer = 0 To aww.GetUpperBound(0)
                                tzu = tzu + mm22(aww(mm)) + ","
                            Next
                            nizKontrolaAWLAssignTo(iKontrolaAWL) = tzu.TrimEnd(",").Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                        End If
                    Next
                End If
            End If
        End If

        actbox.nizPrethodnihKontrola = nizKontrola

        Return actbox


    End Function

