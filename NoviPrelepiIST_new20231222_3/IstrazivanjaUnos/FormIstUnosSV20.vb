    Private Sub DGVGRID_KeyDown(sender As Object, e As KeyEventArgs)
        Dim dgvgrid As DataGridView = CType(sender, DataGridView)
        If dgvgrid.Rows.Count = 0 OrElse dgvgrid.Rows(sender.CurrentCell.RowIndex).Cells(sender.CurrentCell.ColumnIndex).value.ToString.Trim = "" Then
