#Region "PrevediF - da prevede #Funkcije{}"

    Public Function PrevediF(ByVal izraz As String) As String
        Dim ime As String
        Dim param As String
        Dim prvi, ostatak As String
        Dim prvaz, drugaz, taraba As Integer
        If Trim(izraz) = "" Then
            PrevediF = ""
        ElseIf InStr(1, izraz, "#") = 0 Then
            PrevediF = izraz
        Else
            taraba = InStr(1, izraz, "#")
            prvaz = InStr(1, izraz, "{")
            drugaz = ZavrZnak(Mid(izraz, prvaz + 1), "{", "}")
            prvi = IIf(taraba = 1, "", Mid(izraz, 1, taraba - 1))
            ostatak = IIf(prvaz + drugaz + 1 > Len(izraz), "", Mid(izraz, prvaz + drugaz + 1))
            ime = UCase$(Mid(izraz, taraba + 1, prvaz - taraba - 1))
            param = Mid(izraz, prvaz + 1, drugaz - 1)
            PrevediF = prvi & raztarabi(ime, param) & PrevediF(ostatak)
        End If ' ako je prazan
    End Function

    Public Function PrevediFPanel(ByVal tabela As String, ByVal panel As Panel, ByVal izraz As String) As String
        Dim ime As String
        Dim param As String
        Dim prvi, ostatak As String
        Dim prvaz, drugaz, taraba As Integer
        If Trim(izraz) = "" Then
            PrevediFPanel = ""
        ElseIf InStr(1, izraz, "#") = 0 Then
            PrevediFPanel = izraz
        Else
            taraba = InStr(1, izraz, "#")
            prvaz = InStr(1, izraz, "{")
            drugaz = ZavrZnak(Mid(izraz, prvaz + 1), "{", "}")
            prvi = IIf(taraba = 1, "", Mid(izraz, 1, taraba - 1))
            ostatak = IIf(prvaz + drugaz + 1 >= Len(izraz), "", Mid(izraz, prvaz + drugaz + 1))
            ime = UCase$(Mid(izraz, taraba + 1, prvaz - taraba - 1))
            param = Mid(izraz, prvaz + 1, drugaz - 1)
            PrevediFPanel = prvi & raztarabiPanel(tabela, panel, ime, param) & PrevediFPanel(tabela, panel, ostatak)
        End If ' ako je prazan
    End Function

    Public Function ZavrZnak(ByVal str As String, ByVal ZnakP As String, ByVal ZnakK As String) As Integer
        If str.IndexOf("}") < 0 Then str = str + "}"
        Dim pom As Integer = 1
        Dim i As Integer = 1
        While pom > 0
            If Mid(str, i, Len(ZnakP)) = ZnakP Then pom = pom + 1
            If Mid(str, i, Len(ZnakP)) = ZnakK Then pom = pom - 1
            i = i + 1
        End While
        ZavrZnak = i - 1
    End Function

    Public Function raztarabi(ByVal uime As String, ByVal uparam As String) As String
        raztarabi = ""
        Dim ime As String
        Dim param As String
        ime = Trim(uime)
        param = Trim(uparam)
        If Trim(ime) = "" Then
            raztarabi = PrevediF(param)
        Else
            If InStr(1, param, "#") > 0 Then
                Dim trb, pz, zz As Integer
                trb = InStr(1, param, "#")
                pz = InStr(1, param, "{")
                zz = ZavrZnak(Mid(param, pz + 1), "{", "}")
                Dim prvi As String
                Dim tarabni As String
                Dim ostatak As String
                prvi = Trim(Mid(param, 1, trb - 1))
                tarabni = Trim(Mid(param, trb, pz - trb + zz + 1))
                ostatak = Trim(Mid(param, pz + zz + 1))
                Try
                    raztarabi = raztarabi(ime, prvi & PrevediF(tarabni) & PrevediF(ostatak))
                Catch ex As Exception
                    ''msg 300
                    Dim msgtxt As String = getMessageText(dtMessages, "300", Me.jezik)
                    ISTMessageBox.Show(msgtxt + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try
            Else ' bez ugnjezdenih
                Try

                    raztarabi = prevedi_1(ime, param)
                Catch ex As Exception
                    ''msg 302
                    Dim msgtxt As String = getMessageText(dtMessages, "302", Me.jezik)
                    ISTMessageBox.Show(msgtxt + vbCrLf + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

                End Try
            End If ' bez ugnjezdenih
        End If
    End Function

