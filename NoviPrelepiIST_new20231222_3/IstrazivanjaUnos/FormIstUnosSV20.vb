    Function dalijeposlednjiTBNaCATIPanelu(p As Panel, tb As TextBox) As Boolean
        dalijeposlednjiTBNaCATIPanelu = True
        Dim mt As Integer = 0
        For Each k As Control In p.Controls
            If (TypeOf k Is TextBox OrElse TypeOf k Is pomTextBox) AndAlso k.TabStop = True AndAlso k.TabIndex > 0 AndAlso k.Visible = True AndAlso DirectCast(k, TextBox).ReadOnly = False AndAlso DirectCast(k, TextBox).Enabled = True AndAlso k.TabIndex > mt Then
                mt = k.TabIndex
            End If
        Next
        If tb.TabIndex < mt Then dalijeposlednjiTBNaCATIPanelu = False
    End Function

