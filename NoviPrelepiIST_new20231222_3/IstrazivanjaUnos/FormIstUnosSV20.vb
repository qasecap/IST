                    End If
                Next

                If ii > 0 Then
                    Dim p As Integer = 0
                    Dim raz As Integer = 0
                    For Each cntl As Control In grupeCNTLBlokoviPanel(ipanel)(ii)
                        'Dim ime As String = c.Name.Substring(3).ToUpper
                        If TypeOf cntl Is TextBox AndAlso cntl.Name.Trim.Length >= 3 AndAlso Mid(cntl.Name, 1, 3) <> "DRP" OrElse
