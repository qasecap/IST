    Private Sub dpk_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs)
        'ZA AUTB PREBACENO U OVERRIDE
        Dim tbox As TextBox = CType(sender, TextBox)
        If Not tbox.AccessibleName Is Nothing Then tbox.AccessibleName = tbox.AccessibleName + ";" : tbox.AccessibleName = tbox.AccessibleName.Replace(";;", ";").Trim
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 4)
        Dim tabela As String = tbox.Parent.Name.Replace("PANE_", "")
        Dim panel As Panel = tbox.Parent
        ''POCETAK PROVERA KOD SAMOG POLJA
        Dim pomOD As String = NZ(dIst.ISTPOLJA.Select("tabela='" & tabela.Trim & "' and polje='" & plj & "'")(0).Item("od")).Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
        Dim pageDownNA As String = ""
        Dim nizProvera() As String = {}
        If pomOD.Length > 0 AndAlso pomOD.Trim.IndexOf("#{") = 0 Then
            pomOD = pomOD.Replace("#{", "").Replace("}", "").Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
            nizProvera = Split(pomOD, ";")
            For i As Integer = 0 To nizProvera.GetUpperBound(0)
                nizProvera(i) = nizProvera(i).Trim.ToUpper
                If nizProvera(i).IndexOf("PAGEDOWNNA=") = 0 OrElse nizProvera(i).IndexOf("PAGEDOWNTO=") = 0 Then
                    pageDownNA = nizProvera(i).Replace("PAGEDOWNNA=", "").Replace("PAGEDOWNTO=", "")
                    Exit For
                End If
            Next
        End If

        bioPageDown = False
        Select Case e.KeyCode
            Case Keys.Up
                Call dpk_ValidacijaLeftUp(sender, Nothing)
                nepotrebnavalidacijaPanel = True
                If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.Trim.ToUpper.IndexOf("FIRSTTB;") >= 0 Then
                Else
                    'SendKeys.Send("+{TAB}")
                    Me.SelectNextControl(ActiveControl, False, True, True, True)
                End If
            Case Keys.PageDown  'pageDown
                nepotrebnavalidacijaPanel = True
                bioPageDown = True
                'bez uslova, poruka i ostalog
                If pageDownNA.Length > 0 Then
                    Try
                        Call sskoci4(pageDownNA)
                        Me.NslKljuc = Nothing
                        okvalidacija = True
                        tbox.BackColor = SystemColors.ControlLightLight
                        Me.Cursor = Cursors.Default
                        Exit Sub
                    Catch ex As Exception
                        ''msg 21
                        Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                        ISTMessageBox.Show(ex.Message, msgtxt21 + ": sskoci4 dpk_keydown", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End Try
                End If
                Exit Sub
        End Select
    End Sub
