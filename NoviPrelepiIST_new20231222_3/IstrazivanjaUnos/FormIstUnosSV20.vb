                        'ako nije poslednji
                        Dim dt As DataTable = CType(CType(cbox.DataSource, Object), DataTable)
                        Dim sqlText As String = "2=2 AND prikazi LIKE '" & cbox.Text.Trim.ToUpper & "%'"
                        Dim red01 As DataRow() = dt.Select(sqlText)
                        Dim poslednjiPrikazi As String = CType(CType(cbox.Items(cbox.Items.Count - 1), Object), DataRowView).Item(0).ToString.Trim.ToUpper
                        If red01.Length = 1 AndAlso red01(0).Item("prikazi").ToString.Trim.ToUpper = poslednjiPrikazi Then
                            'POSLEDNJI
                        Else
                            SendKeys.Send("{UP}")
                        End If
                    Else
                        SendKeys.Send("{DOWN}")
                    End If
                End If

                If SCati = True Then
