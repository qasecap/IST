    Sub LabelaVidljiva(ByVal trenutniRBR As Integer, ByVal chb As Boolean, ByVal grupa As String)

        For Each k As Control In panelCATIlabel.Controls
            k.Visible = False
            Dim mm() As String = k.AccessibleDescription.Split(";")
            If TypeOf k Is Label AndAlso chb = False AndAlso mm(0) = Str(trenutniRBR).Trim Then
                k.Visible = True
            End If
            If TypeOf k Is Label AndAlso chb = True AndAlso grupa = "" AndAlso mm(0) = Str(trenutniRBR).Trim Then
                k.Visible = True
            End If
        Next

        'da li je checkbox
        If chb = True AndAlso grupa <> "" Then
            For Each k As Control In panelCATIlabel.Controls
                If TypeOf k Is Label AndAlso Not k.Tag Is Nothing Then
                    If k.Tag.trim.toupper = grupa.Trim.ToUpper Then k.Visible = True
                End If
            Next
        End If

    End Sub

    Sub kontrolaVidljiva(ByVal trenutniRBR As Integer, ByVal panel As Panel, ByVal chb As Boolean, ByVal grupa As String)

        For Each k As Control In panel.Controls
            k.Visible = False
            Dim mm() As String = k.AccessibleDescription.Split(";")

            If mm(0) = Str(trenutniRBR).Trim Then
                If Not TypeOf k Is Label AndAlso chb = False Then
                    k.Visible = True
                    k.BringToFront()
                End If
                If Not TypeOf k Is Label AndAlso chb = True AndAlso grupa = "" Then
                    k.Visible = True
                    k.BringToFront()
                End If
            End If

        Next

        'da li je checkbox
        If chb = True Then
            Dim chP() As String = kojeugrupi(nizCHB, grupa)
            For i As Integer = 0 To chP.GetUpperBound(0)
                Dim ch As CheckBox = NadjiKontrolu(panel, "HH" + chP(i))
                If Not ch Is Nothing Then ch.Visible = True
            Next
        End If

    End Sub

