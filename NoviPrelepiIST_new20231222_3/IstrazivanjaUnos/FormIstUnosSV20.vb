    Private Function kSaMaxTabIndex(ByVal nadkontrola As Control, ByVal tabindeks As Integer) As Control
        'nađi prvu kontrolu u nadpanelu koja ima veći tabindex od panelindex
        Dim cntl As Control = Nothing
        Dim ti As Integer = tabindeks
        Dim kti As Integer = 0
        For Each k As Control In nadkontrola.Controls
            If k.TabIndex > tabindeks Then
                cntl = k
                kti = k.TabIndex
                Exit For
            End If
        Next
        If kti = 0 Then cntl = BtnSaveNext

        kSaMaxTabIndex = cntl
    End Function

