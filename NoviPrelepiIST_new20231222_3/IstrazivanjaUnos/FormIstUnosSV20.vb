                End If
            End If

            Dim labeltextNovo As String = ""
            '     If dv(0).Item(mm(0)).GetType() Is GetType(DBNull) Then

            If Not labelNovo Is Nothing AndAlso labelNovo.Length > 0 Then
                If labelNovo(0).Item("ttext").GetType() Is GetType(DBNull) Then
                    labeltextNovo = ""
                Else
                    labeltextNovo = labelNovo(0).Item("ttext")
                End If

                labeltextNovo = ZameniGGGMMMUnos(SrediPMGK(labeltextNovo))
                labeltextNovo = zameniSpace(labeltextNovo, True)
                labeltextNovo = zameniISTLabels(labeltextNovo)
                k.Text = labeltextNovo.TrimStart("'").TrimEnd("'")
            Else
                'po starom
                Dim sql As String = ZameniGGGMMMUnos(SrediPMGK(k.Tag.izraz))
                sql = zameniSpace(sql, True)
                sql = zameniISTLabels(sql)
                Try
                    If sql.Length > 0 AndAlso sql.Substring(0, 1) = "'" Then
                        sql = sql.Substring(1)
                        If sql.Substring(sql.Length - 1, 1) = "'" Then
                            k.Text = sql.Substring(0, sql.Length - 1)
                        Else
                            k.Text = sql
                        End If
                    Else
                        k.Text = sql
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message)
                End Try
            End If
        End If
    End Sub

