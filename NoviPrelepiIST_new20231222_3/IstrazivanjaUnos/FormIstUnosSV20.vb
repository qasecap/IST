    Sub PKSelectPreviousControl(ByVal cntl As Control)
        Dim ind As Integer = Array.IndexOf(nizPKKontrola, cntl)
        Dim koji As Integer = -1
        For i As Integer = ind - 1 To 0 Step -1
            If nizPKKontrola(i).Visible = True AndAlso nizPKKontrola(i).Enabled = True AndAlso nizPKKontrola(i).TabStop = True Then
                koji = i
                Exit For
            End If
        Next
        If koji > -1 Then
            If cntl.BackColor = Color.Bisque Then cntl.BackColor = SystemColors.ControlLightLight
            If (cntl.AccessibleName Is Nothing OrElse cntl.AccessibleName.Trim.ToUpper.IndexOf("AUTB") < 0) AndAlso cntl.Text.Trim = "" Then
                nepotrebnavalidacija = True
                nizPKKontrola(koji).Focus()
                nepotrebnavalidacija = False
            Else
                nizPKKontrola(koji).Focus()
            End If

        End If
    End Sub
