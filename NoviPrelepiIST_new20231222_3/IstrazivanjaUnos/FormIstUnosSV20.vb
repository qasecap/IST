    Function sklopiRTextBox(ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal zadnjitabindex As Integer, ByVal ro As Boolean, ByVal name As String, ByVal addmissingvalue As String) As pomTextBox
        Dim ctrt As New pomTextBox
        ctrt.Name = name
        ctrt.TabIndex = zadnjitabindex
        If addmissingvalue <> "" AndAlso ro = False Then ctrt.AccessibleName = ctrt.AccessibleName + addmissingvalue + ";"
        If ro = True Then ctrt.ReadOnly = True : ctrt.AccessibleName = ctrt.AccessibleName + "RO;"

        AddHandler ctrt.Validating, AddressOf Me.ctrt_Validating
        AddHandler ctrt.KeyPress, AddressOf Me.ctrt_KeyPress
        AddHandler ctrt.Enter, AddressOf Me.ctrt_Enter
        AddHandler ctrt.KeyDown, AddressOf Me.ctrt_KeyDown
        AddHandler ctrt.PreviewKeyDown, AddressOf Me.ctrt_PreviewKeyDown
        AddHandler ctrt.MouseDown, AddressOf Me.pp_MouseDown
        ''duzina
        Return ctrt
    End Function

    Sub ctrt_KeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs)

        Dim pTB As pomTextBox = CType(sender, pomTextBox)
        'AktivanTekstBoks = pTB
        'ISTMessageBox.Show(Asc(e.KeyChar))
        Select Case e.KeyChar
            Case ChrW(27) 'ESC
                Me.BtnExit.Focus()
            Case ChrW(13) 'Enter
                If SCati = True Then
                    nepotrebnavalidacijaCATI = True

                    Call ctrt_Validacija(sender, Nothing)   'ovde dobije ako skace bbss

                    If okvalidacija = False Then
                        pTB.Focus()
                        pTB.BackColor = Color.Bisque
                        okvalidacija = False
                        Exit Sub
                    End If

                    If okvalidacija = True Then
                        If bbiloskakanje = False Then
                            If dalijeposlednjiCATIPanel(pTB.Parent) = False AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                                If okvalidacija = True Then Call dugmeCATIN(pTB)
                            ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = True AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = True Then
                                'MORA OVAKO INACE AKO PRITISNU ISTOVREMENO KEUP AND KEYDDOWN PUSTA IH DA ODU, a trt.focus ne radi nista
                                nepotrebnavalidacijaCATI = False
                                Call krajAnketiranja1(pTB)
                            ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = False AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                                'SendKeys.Send("{TAB}")
                                Me.SelectNextControl(ActiveControl, True, True, True, True)
                            ElseIf dalijeposlednjiCATIPanel(pTB.Parent) = True AndAlso dalijeposlednjiTBNaCATIPanelu(pTB.Parent, pTB) = False Then
                                'SendKeys.Send("{TAB}")
                                Me.SelectNextControl(ActiveControl, True, True, True, True)
                            End If
                            Exit Sub
                        End If

                        If bbiloskakanje = True Then
                            nepotrebnavalidacijaCATI = True

                            'bbss
                            If bbss.Name = "ENDOFINTERVIEWING" Then
                                Call krajAnketiranja1(pTB)
                                nepotrebnavalidacijaCATI = False
                                Exit Sub
                            End If

                            If bbss.Name <> "ENDOFINTERVIEWING" Then
                                Dim p As Panel = pTB.Parent
                                For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                                    Dim isk As Integer = 0
                                    For Each k As Control In grupePitanjaCATI(i).Controls
                                        If (TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) <> "F") Then
                                            If k Is bbss Then
                                                If Not p Is k.Parent Then
                                                    ''''
                                                    p.Visible = False
                                                    Dim imeP As String = p.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
                                                    Dim pppom As Panel = NadjiKontrolu(Me, imeP)
                                                    pppom.Visible = False

                                                    k.Parent.Visible = True
                                                    Dim kimeP As String = k.Parent.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
                                                    Dim kpppom As Panel = NadjiKontrolu(Me, kimeP)
                                                    kpppom.Visible = True
                                                    kpppom.Enabled = True
                                                    kpppom.BringToFront()
                                                End If
                                                If Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is SveZaPolje1) AndAlso k.Tag <> "" Then
                                                    Dim rtb As pomTextBox = NadjiKontrolu(grupePitanjaCATI(i), "pomocno" & "_" & k.Tag)
                                                    'rtb.Visible = True
                                                    rtb.Enabled = True
                                                    If Not rtb Is Nothing Then rtb.Focus()
                                                Else
                                                    k.Enabled = True
                                                    k.Focus()
                                                End If
                                                isk = 1
                                                Exit For
                                            End If
                                        End If
                                    Next
                                    If isk = 1 Then Exit For
                                Next
                                nepotrebnavalidacijaCATI = False
                                Exit Sub
                            End If 'nije kraj intervjua

                        End If '   If  bbiloskakanje = True Then

                    End If   'If okvalidacija = True Then

                End If  'If SCati = True Then
'*****************************************

            Case ChrW(33) 'pageDown
                bioPageDown = True
                'SendKeys.Send("{TAB}")
                Me.SelectNextControl(ActiveControl, True, True, True, True)
            Case Else
        End Select
    End Sub

