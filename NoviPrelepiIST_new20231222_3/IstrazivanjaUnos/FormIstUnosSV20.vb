    Function fCalculateAge(ByVal zzz As String) As String
        fCalculateAge = ""

        If CStr(zzz).Trim.ToUpper.IndexOf("D.") >= 0 Then
            zzz = zameniD(zzz)
        End If

        Dim pom As String = CStr(zzz).Trim.ToUpper.Replace("FCALCULATEAGE", "").Replace("(", "").Replace(")", "")
        pom = pom.Trim
        Dim pp() As String
        Dim aa() As String = pom.Split(",")
        If aa.Length = 1 AndAlso aa(0).IndexOf("'") = 0 Then
            pom = pom.Replace(".", ",")
        End If
        If aa.Length = 2 AndAlso aa(0).IndexOf("'") = 0 AndAlso aa(1).IndexOf("'") = 0 Then
            pom = aa(0).Replace(".", ",") + "," + aa(1)
        End If

        pp = pom.Split(",")

        'pp(0) day
        'pp(1) month
        'pp(2) year
        'pp(3) reference period OPTIONAL format dd.mm.yyyy
        Dim refper As Date
        Dim refperNovo As Integer = 0
        If pp.Length <> 4 AndAlso pp.Length <> 3 Then
            fCalculateAge = ""
        Else
            If pp(0) = "" OrElse IsNumeric(pp(0).Replace("'", "").Trim) = False OrElse pp(0).Replace("'", "").Trim = "99" OrElse pp(0).Replace("'", "").Trim = "98" OrElse pp(0).Replace("'", "").Trim = "!" OrElse pp(0).Replace("'", "").Trim = "?" Then pp(0) = "01"
            If pp(1) = "" OrElse IsNumeric(pp(1).Replace("'", "").Trim) = False OrElse pp(1).Replace("'", "").Trim = "99" OrElse pp(1).Replace("'", "").Trim = "98" OrElse pp(1).Replace("'", "").Trim = "!" OrElse pp(1).Replace("'", "").Trim = "?" Then pp(1) = "01"
            If pp.Length = 3 Then refper = Now : refperNovo = CInt(DateTime.Now.ToString("yyyyMMdd"))
            If pp.Length = 4 Then
                Dim okrp As Boolean = jisISTDate(pp(3).Replace("'", "").Trim)
                If okrp = True AndAlso pp(3).Replace("'", "").Trim <> "" Then
                    Dim jj() As String = pp(3).Split(".")
                    Dim refD As String = ""
                    Dim refDNovo As String = ""
                    If jj.Length = 3 Then
                        'jj(0) je dan, jj(1) je mesec, jj(2) je godina
                        refD = jj(2) + "-" + jj(1) + "-" + jj(0)
                        refper = CDate(refD.Replace("'", "").Trim)
                        refDNovo = (jj(2) + jj(1) + jj(0)).Replace("'", "").Replace(" ", "")
                        refperNovo = CInt(refDNovo)
                    Else
                        refper = Now
                        refperNovo = CInt(DateTime.Now.ToString("yyyyMMdd"))
                        MsgBox("Referent date is not in right format!!!" + nvrd + nvrd +
                        "Right format is dd.mm.yyyy", vbInformation, "")
                    End If
                Else
                    refper = Now
                    refperNovo = CInt(DateTime.Now.ToString("yyyyMMdd"))
                End If
            End If
            If IsNumeric(pp(2).Replace("'", "").Trim) = False OrElse pp(2).Replace("'", "").Trim = "9998" OrElse pp(2).Replace("'", "").Trim = "9999" OrElse pp(2).Replace("'", "").Trim = "!" OrElse pp(2).Replace("'", "").Trim = "?" Then
                fCalculateAge = ""
            Else
                Dim d As String = pp(0).Replace("'", "").Trim : If d.Trim.Length = 1 Then d = "0" + d.Trim
                Dim m As String = pp(1).Replace("'", "").Trim : If m.Trim.Length = 1 Then m = "0" + m.Trim
                Dim y As String = pp(2).Replace("'", "").Trim
                If y.Trim.Length = 3 AndAlso CInt(y.Trim) >= 800 AndAlso CInt(y.Trim) <= 999 Then y = "1" + y.Trim
                If y.Trim.Length = 3 AndAlso CInt(y.Trim) < 100 Then y = "2" + y.Trim

                Dim ok As Boolean = jisISTDate(d + "." + m + "." + y)
                If ok = False Then
                    fCalculateAge = ""
                Else

                    Dim birthday As DateTime = New DateTime(Integer.Parse(y), Integer.Parse(m), Integer.Parse(d))
                    Dim birthdayNovo As Integer = CInt(birthday.ToString("yyyyMMdd"))
                    'Dim age As Integer = (refper - birthday).Days
                    'Dim years As Integer = age / 365.25
                    'Dim days As Integer = age - years * 365.25
                    'If (days < 0) Then
                    '    years = years - 1
                    '    days = age - years * 365.25
                    'End If
                    ''Show the age
                    'fCalculateAge = Convert.ToString(years)

                    Dim ageNovo As Integer = (refperNovo - birthdayNovo) \ 10000
                    fCalculateAge = Convert.ToString(ageNovo)
                End If
            End If
        End If


        'Declare @Now datetime, @Dob datetime
        'Select @Now='2021-09-30', @Dob='1951-10-01'  --results in 10
        'Select (CONVERT(int, CONVERT(Char(8),@Now, 112)) - CONVERT(Char(8),@Dob, 112)) / 10000 As AgeIntYears


    End Function

    Function powerRound(ByVal zzz As String, ByVal tabela As String) As String
        powerRound = ""

        Dim x1 As Integer
        Dim PozZarez As Integer
        Dim Fja As String
        If CStr(zzz).Trim.ToUpper.IndexOf("POWER") >= 0 Then
            x1 = CStr(zzz).ToUpper.IndexOf("POWER") + 5
            PozZarez = GdeJeZarez(zzz, "POWER")
            Fja = "POWER"
        Else
            x1 = CStr(zzz).ToUpper.IndexOf("ROUND") + 5
            PozZarez = GdeJeZarez(zzz, "ROUND")
            Fja = "ROUND"
        End If
        Dim par1 As String = CStr(zzz).Substring(x1, PozZarez - x1).Trim
        par1 = par1.Substring(1)
        Dim par2 As String = CStr(zzz).Substring(PozZarez + 1).Trim
        Dim brz As Integer = 0
        Dim KrajPar2 As Integer = Len(par2) - 1
        For ii As Integer = 1 To Len(par2)
            If par2.Substring(ii, 1) = "(" Then brz += 1
            If par2.Substring(ii, 1) = ")" Then brz -= 1
            If brz = -1 Then
                KrajPar2 = ii
                Exit For
            End If
        Next
        par2 = par2.Substring(0, KrajPar2)
        Dim pomkol1 As New DataColumn("pomKol1")
        pomkol1.Expression = CStr(par1).Trim.ToUpper.Replace("D.", "").Replace("N'", "'")
        DGTabelePanel(DGi(tabela)).Columns.Add(pomkol1)
        Dim xxx1 As Object = NZ(DGTabelePanel(DGi(tabela)).Compute("MAX(pomKol1)", ""))
        Dim pomkol2 As New DataColumn("pomKol2")
        pomkol2.Expression = CStr(par2).Trim.ToUpper.Replace("D.", "").Replace("N'", "'")
        DGTabelePanel(DGi(tabela)).Columns.Add(pomkol2)
        Dim xxx2 As Object = NZ(DGTabelePanel(DGi(tabela)).Compute("MAX(pomKol2)", ""))
        DGTabelePanel(DGi(tabela)).Columns.Remove(pomkol1)
        DGTabelePanel(DGi(tabela)).Columns.Remove(pomkol2)
        Select Case Fja
            Case "POWER"
                If xxx1 = "" Then xxx1 = 0
                If xxx2 = "" Then xxx2 = 0
                powerRound = CStr(CDbl(xxx1) ^ CDbl(xxx2)).Trim
            Case "ROUND"
                If xxx1 = "" Then xxx1 = 0
                If xxx2 = "" Then xxx2 = 0
                If xxx2 <> "" Then
                    powerRound = CStr(Math.Round(CDbl(xxx1), CInt(xxx2))).Trim
                Else
                    xxx2 = ""
                End If
            Case Else
        End Select

    End Function

    Private Function MEMMEM(ByVal zzz As String, ByVal bMEM() As String, ByVal memtabela As String,
                    Optional ByVal backfromregularSubtable As Boolean = False, Optional kname As String = "") As String
        MEMMEM = ""
        Dim sumMEM As Boolean = False
        Dim minMEM As Boolean = False
        Dim maxMEM As Boolean = False
        Dim countMEM As Boolean = False
        Dim poljeMEM As Boolean = False
        Dim coalesceMEM As Boolean = False
        Dim isnullMEM As Boolean = False
        Dim concatMEM As Boolean = False
        Dim poc As Boolean = False

        Dim pp As String = ""
        Dim odCega As String = ""
        Dim rezMEM As String = ""
        Dim uslov As String = "2=2"
        If zzz.Trim.ToUpper.IndexOf("WHERE") > 0 Then
            uslov = uslov + " AND " + zzz.Trim.Substring(zzz.Trim.ToUpper.IndexOf("WHERE") + 6)
            If CStr(uslov).Trim.ToUpper.IndexOf("D.") >= 0 Then uslov = zameniD(uslov)
            uslov = uslov.Trim.ToUpper.Replace("JA.", "")
            uslov = uslov.Trim.ToUpper.Replace("MEM.", "")
        End If

        For mm As Integer = 0 To bMEM.GetUpperBound(0)
            If bMEM(mm).Trim.ToUpper.IndexOf("FROM") = 0 Then
                Exit For
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("SUM") = 0 Then
                sumMEM = True
                odCega = bMEM(mm + 2).Trim.ToUpper
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("MAX") = 0 Then
                maxMEM = True
                odCega = bMEM(mm + 2).Trim.ToUpper
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("MIN") = 0 Then
                minMEM = True
                odCega = bMEM(mm + 2).Trim.ToUpper
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("COUNT") = 0 Then
                countMEM = True
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("COALESCE") = 0 Then
                coalesceMEM = True : poc = True
            ElseIf coalesceMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") <> 0 AndAlso bMEM(mm).Trim.ToUpper.IndexOf("(") <> 0 Then
                odCega = odCega + bMEM(mm).Trim.ToUpper
            ElseIf coalesceMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") = 0 Then
                poc = False
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("CONCAT") = 0 Then
                concatMEM = True : poc = True
            ElseIf concatMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") <> 0 AndAlso bMEM(mm).Trim.ToUpper.IndexOf("(") <> 0 Then
                odCega = odCega + bMEM(mm).Trim.ToUpper
            ElseIf concatMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") = 0 Then
                poc = False
            ElseIf bMEM(mm).Trim.ToUpper.IndexOf("ISNULL") = 0 Then
                isnullMEM = True : poc = True
            ElseIf isnullMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") <> 0 AndAlso bMEM(mm).Trim.ToUpper.IndexOf("(") <> 0 Then
                odCega = odCega + bMEM(mm).Trim.ToUpper
            ElseIf isnullMEM = True AndAlso poc = True AndAlso bMEM(mm).Trim.ToUpper.IndexOf(")") = 0 Then
                poc = False
            Else
                poljeMEM = True
            End If
        Next

        If sumMEM = False AndAlso maxMEM = False AndAlso minMEM = False AndAlso countMEM = False AndAlso coalesceMEM = False AndAlso isnullMEM = False AndAlso concatMEM = False AndAlso poljeMEM = True Then
            For mm As Integer = 0 To bMEM.GetUpperBound(0)
                If bMEM(mm).Trim.ToUpper.IndexOf("FROM") = 0 Then
                    odCega = bMEM(mm - 1).Trim.ToUpper
                    Exit For
                End If
            Next
        End If

        'NE SME OVAKO JER SE OSIM KOPIRANJA VEŽE I REFERENCIJALNO; PA KAD SE BRIŠE DGTABELE; BRIŠE SE I DTBL
        'DTbl = DGTabele

        'If DTbl Is Nothing Then DTbl = DGTabele
        'If backfromregularSubtable = True Then DTbl = DGTabele

        Dim pomDTbl() As DataTable = Nothing

        'If DTbl Is Nothing Then DTbl = DGTabele
        If DTbl Is Nothing Then
            For i As Integer = 0 To DGTabele.GetUpperBound(0)
                ReDim Preserve pomDTbl(i)
                pomDTbl(i) = DGTabele(i).Copy
            Next
        Else
            For i As Integer = 0 To DTbl.GetUpperBound(0)
                ReDim Preserve pomDTbl(i)
                pomDTbl(i) = DTbl(i).Copy
            Next
        End If

        'If backfromregularSubtable = True Then DTbl = DGTabele
        If backfromregularSubtable = True Then
            pomDTbl = Nothing
            For i As Integer = 0 To DGTabele.GetUpperBound(0)
                ReDim Preserve pomDTbl(i)
                pomDTbl(i) = DGTabele(i).Copy
            Next
        End If

        If Not pomDTbl Is Nothing AndAlso DGi(memtabela, pomDTbl) > -1 AndAlso Not pomDTbl(DGi(memtabela, pomDTbl)) Is Nothing Then
            uslov = uslov.Replace("CONVERT ", "CONVERT").Replace("CONVERT", "Convert").Replace("SYSTEM.INT32", "System.Int32")

            Dim redoviMEM() As DataRow = pomDTbl(DGi(memtabela, pomDTbl)).Select(uslov.Replace("=N'", "='"))
            Dim dtMEM As New DataTable
            dtMEM = pomDTbl(DGi(memtabela, pomDTbl)).Copy
            dtMEM.Clear()
            For Each redMEM As DataRow In redoviMEM
                dtMEM.ImportRow(redMEM)
            Next

            If countMEM = True Then
                rezMEM = redoviMEM.Length
                MEMMEM = rezMEM
            End If

            If sumMEM = True Then
                Dim suma As Integer
                suma = 0
                For Each redMEM As DataRow In dtMEM.Rows
                    Dim ppp As String = redMEM.Item(odCega).ToString.Trim
                    If ppp Is Nothing Then ppp = 0
                    If IsNumeric(ppp.Replace(".", "")) = False Then ppp = 0
                    If ppp.IndexOf(".") >= 0 Then
                        suma = suma + CDbl(ppp)
                    Else
                        suma = suma + CInt(ppp)
                    End If
                Next
                rezMEM = suma.ToString.Trim
                MEMMEM = rezMEM
            End If

            If dtMEM.Rows.Count > 0 AndAlso (minMEM = True OrElse maxMEM) = True Then
                Dim dv As DataView = dtMEM.DefaultView
                If minMEM = True Then
                    dv.Sort = odCega + " ASC"
                ElseIf maxMEM = True Then
                    dv.Sort = odCega + " DESC"
                End If
                rezMEM = dv(0).Item(odCega).ToString.Trim
                MEMMEM = rezMEM
            End If

            If sumMEM = False AndAlso maxMEM = False AndAlso minMEM = False AndAlso
            countMEM = False AndAlso coalesceMEM = False AndAlso isnullMEM = False AndAlso concatMEM = False AndAlso poljeMEM = True Then
                If dtMEM.Rows.Count > 0 Then MEMMEM = dtMEM.Rows(0).Item(odCega).ToString.Trim
            End If

            If dtMEM.Rows.Count > 0 AndAlso isnullMEM = True And odCega.IndexOf(",") >= 0 Then
                Dim mm() As String = odCega.Split(",")
                Dim dv As DataView = dtMEM.DefaultView

                If dv(0).Item(mm(0)).GetType() Is GetType(DBNull) Then
                    rezMEM = mm(1)
                Else
                    rezMEM = dv(0).Item(mm(0)).ToString.Trim()
                    If rezMEM Is Nothing Then rezMEM = mm(1) 'za svaki slucaj
                End If
                MEMMEM = rezMEM
            End If

            If dtMEM.Rows.Count > 0 AndAlso coalesceMEM = True Then
                Dim mm() As String = odCega.Split(",")
                Dim dv As DataView = dtMEM.DefaultView
                rezMEM = ""
                For i As Integer = 0 To mm.GetUpperBound(0)
                    If mm(i).Trim.IndexOf("'") = 0 Then
                        rezMEM = mm(i).Trim.Replace("'", "")
                        Exit For
                    End If
                    If (mm(i).Trim.IndexOf("'") < 0 AndAlso Not (dv(0).Item(mm(0)).GetType() Is GetType(DBNull)) AndAlso dv(0).Item(mm(i)).ToString.Trim <> "") Then
                        rezMEM = dv(0).Item(mm(i)).ToString.Trim
                        Exit For
                    End If
                Next
                MEMMEM = rezMEM
            End If
            If dtMEM.Rows.Count > 0 AndAlso concatMEM = True Then
                Dim mm() As String = odCega.Split(",")
                Dim dv As DataView = dtMEM.DefaultView
                rezMEM = ""
                For i As Integer = 0 To mm.GetUpperBound(0)
                    If mm(i).Trim.IndexOf("'") = 0 Then
                        rezMEM = rezMEM.Trim & mm(i).Trim.Replace("'", "")
                    End If
                    If (mm(i).Trim.IndexOf("'") < 0 AndAlso Not (dv(0).Item(mm(0)).GetType() Is GetType(DBNull)) AndAlso dv(0).Item(mm(i)).ToString.Trim <> "") Then
                        rezMEM = rezMEM.Trim & dv(0).Item(mm(i)).ToString.Trim
                    End If
                Next
                MEMMEM = rezMEM
            End If

        End If

        If Not pomDTbl Is Nothing AndAlso DGi(memtabela, pomDTbl) = -1 AndAlso kname <> "" Then
            ISTMessageBox.Show("Table " + memtabela + " does not exists in ISTTables" + nvrd + nvrd +
            "Syntax error in query for " + kname + " virtuel field!" + nvrd + nvrd + "Query: " +
            zzz, "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End If

    End Function

