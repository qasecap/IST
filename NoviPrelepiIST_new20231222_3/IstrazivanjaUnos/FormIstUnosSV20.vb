    Private Sub dpp_KeyUp(ByVal sender As Object, ByVal e As KeyEventArgs)
        Dim trt As TextBox = CType(sender, TextBox)
        If Not trt.AccessibleName Is Nothing Then trt.AccessibleName = trt.AccessibleName + ";" : trt.AccessibleName = trt.AccessibleName.Replace(";;", ";")
        Dim panel As Panel = trt.Parent
        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)
        Dim tabela As String = panel.Name.Replace("PANE_", "").Trim.ToUpper
        Dim panelautoscroll As Boolean = False
        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.IndexOf("SCROLLBAR;") >= 0 Then panelautoscroll = True
        If e.Control = True AndAlso e.KeyCode = Keys.S Then
            Try
                Call dpp_Validating(trt, Nothing)
                If okvalidacija = False Then
                    sender.focus()
                    Exit Sub
                End If
                If okvalidacija = True Then
                    If panelautoscroll = False Then
                        Dim dugmeS As Button = NadjiKontrolu(panel, "DBTNSAVE" + tabela)
                        Call dugmeSClick(dugmeS, e)
                    Else
                        Dim dugmeSScroll As Button = NadjiKontrolu(Panel1, "DBTNSAVESCROLL" + tabela)
                        dugmeSScroll.Focus()
                        Call dugmeSScrollClick(dugmeSScroll, e)
                    End If
                End If
            Catch ex As Exception
                ''msg 61
                Dim msgtxt As String = getMessageText(dtMessages, "61", Me.jezik)
                ISTMessageBox.Show(msgtxt + " dpp_KeyUp", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End If

    End Sub

