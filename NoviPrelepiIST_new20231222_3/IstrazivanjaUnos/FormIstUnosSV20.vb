    Private Const grab As Integer = 16
    Protected Overrides Sub OnPaint(ByVal e As PaintEventArgs)
        MyBase.OnPaint(e)
        Dim rect As Rectangle = New Rectangle(Me.ClientSize.Width - grab, Me.ClientSize.Height - grab, grab, grab)
        ControlPaint.DrawSizeGrip(e.Graphics, Me.BackColor, rect)
    End Sub
    Protected Overrides Sub OnPaintBackground(ByVal e As PaintEventArgs)
        MyBase.OnPaintBackground(e)
        If mmaksimalan = False Then
            Dim rect As New Rectangle(0, 0, Me.ClientSize.Width - 1, Me.ClientSize.Height - 1)
            e.Graphics.DrawRectangle(Pens.Black, rect)
        End If
    End Sub
    Protected Overrides Sub WndProc(ByRef m As Message)
        MyBase.WndProc(m)
        If m.Msg = WM_NCLBUTTONDBLCLK Then Return
        If Me.WindowState = FormWindowState.Maximized Then
            If m.Msg = WM_NCLBUTTONDOWN Then Return
        End If

        If m.Msg = &H84 Then
            Dim pos As Point = Me.PointToClient(New Point(m.LParam.ToInt32()))
            If pos.X >= Me.ClientSize.Width - grab AndAlso pos.Y >= Me.ClientSize.Height - grab Then m.Result = New IntPtr(17)
        End If
    End Sub

