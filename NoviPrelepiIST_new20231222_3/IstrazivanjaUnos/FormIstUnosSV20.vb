    Function sskNN(ByVal nizC() As Control, ByVal cntl As Control, ByVal nizskociNAzad As String) As Control
        sskNN = Nothing
        If Not nizC Is Nothing AndAlso nizC.Length > 0 Then
            For i As Integer = 0 To nizC.GetUpperBound(0)
                Dim k As Control = nizC(i)
                If Mid(k.Name, 3).Trim.ToUpper = nizskociNAzad.Trim.ToUpper AndAlso Mid(k.Name, 1, 1) <> "L" Then
                    cntl.AccessibleName = cntl.AccessibleName.Replace("SKIPFROM" + nizskociNAzad.Trim.ToUpper + ";", "")
                    sskNN = k
                    Exit For
                End If
            Next
        End If
    End Function

    Sub vidljivBlokPanelBasOvaj(ByVal ipanel As Integer, ByVal b As Integer)
        ''prvo sta je vidljivo
        'REMARK POLJA NE TREBA DA BUDU VIDLJIVA
        For i As Integer = grupeCNTLBlokoviPanel(ipanel)(b).GetUpperBound(0) To 0 Step -1
            'treba svaiti da mu nisu vidljive one koje u polju izraz imaju visiblefalse
            'vidi da li je to u AccessibleName
            Dim k As Control = grupeCNTLBlokoviPanel(ipanel)(b)(i)
            If Mid(k.Name, 1, 3) <> "DRP" Then
                k.Visible = True
                k.BringToFront()
            End If
