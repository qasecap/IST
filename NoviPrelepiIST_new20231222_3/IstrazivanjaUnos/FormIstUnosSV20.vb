    Function GlavaHead(trt As String, rr As DataRow) As String
        Dim plj As String = ""
        If trt.Length() > 5 AndAlso trt.Substring(0, 6).ToUpper = "GLAVA." Then plj = trt.Substring(6)
        If trt.Length() > 4 AndAlso trt.Substring(0, 5).ToUpper = "HEAD." Then plj = trt.Substring(5)

        'da bi mogla i fiktivna polja
        If plj.Trim.IndexOf("#FP{") = 0 Then

        ElseIf plj <> "" AndAlso Not rr.Item(plj) Is Nothing Then
            If trt.Trim.ToUpper.IndexOf("DBO.F") >= 0 Then
                trt = "N'" & rr.Item(plj) & "'"
            Else
                trt = "'" & rr.Item(plj) & "'"
            End If
        End If

        GlavaHead = trt
    End Function

    Private Function SracunajXpoziciju(ByVal y() As Integer, ByVal BrojKolona As Integer, Optional ByRef SSirina As Integer = -999) As Integer
        Dim trt As Integer = 100
        If normalLabels = True Then trt = 250

        Dim NisuPreskoceni(BrojKolona) As Boolean 'trebalo bi da su svi false po default-u
        Dim NadjenaSSirina As Boolean

        Dim p As DatasetIstrazivanja.ISTPOLJARow
        For nmnm As Integer = 0 To redoviMEMForma.GetUpperBound(0)
            p = redoviMEMForma(nmnm)
            Dim yy() As Integer = f2T(p.Forma.Trim)
            If yy.Length >= 3 Then
                If SSirina <> -999 Then
                    If y(0) = yy(0) AndAlso y(1) = yy(1) AndAlso yy(2) = y(2) Then
                        If Not p.IsVSNull AndAlso p.VS <> "" Then 'AndAlso Val(p.VS) > 0 Then  'bilo 10
                            SSirina = Val(p.VS)
                        Else
                            SSirina = 100
                        End If
                        NadjenaSSirina = True
                    End If
                End If
                If y(0) = yy(0) AndAlso y(1) = yy(1) AndAlso yy(2) < y(2) Then
                    If Not p.IsVSNull AndAlso p.VS <> "" Then 'AndAlso Val(p.VS) > 0 Then 'bilo 10
                        trt = trt + Val(p.VS)
                    Else
                        trt = trt + 100
                    End If
                    NisuPreskoceni(yy(2)) = True
                End If
            End If
        Next

        If SSirina <> -999 AndAlso Not NadjenaSSirina Then SSirina = 100
        Return trt
    End Function

    Private Function SracunajSirinu(ByVal y() As Integer, ByVal BrojKolona As Integer, Optional ByRef SSirina As Integer = -999) As Integer
        Dim trt As Integer = 0
        Dim NisuPreskoceni(BrojKolona) As Boolean 'trebalo bi da su svi false po default-u
        Dim NadjenaSSirina As Boolean
        For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If p.TABELA.Trim.ToUpper = GlavnaTabela Then
                If Not p.IsFormaNull AndAlso p.Forma.Trim <> "" Then
                    Dim yy() As Integer = f2T(p.Forma.Trim)
                    If yy.Length >= 3 Then
                        If SSirina <> -999 Then
                            If y(0) = yy(0) AndAlso y(1) = yy(1) AndAlso yy(2) = y(2) Then
                                If Not p.IsVSNull AndAlso p.VS <> "" Then ' AndAlso Val(p.VS) > 0 Then  'bilo 10

                                    If p.VS = "-1" Then SSirina = 0 Else SSirina = Val(p.VS)

                                Else
                                    SSirina = 100
                                End If
                                NadjenaSSirina = True
                            End If
                        End If
                        If y(0) = yy(0) AndAlso y(1) = yy(1) AndAlso yy(2) > y(2) Then
                            If Not p.IsVSNull AndAlso p.VS <> "" Then ' AndAlso Val(p.VS) > 0 Then 'bilo 10
                                If p.VS = "-1" Then trt = trt + 0 Else trt = trt + Val(p.VS)

                            Else
                                trt = trt + 100
                            End If
                            NisuPreskoceni(yy(2)) = True
                        End If
                    End If
                End If
            End If
        Next
        For i As Integer = y(2) + 1 To BrojKolona
            If Not NisuPreskoceni(i) Then trt = trt + 100
        Next
        If SSirina <> -999 AndAlso Not NadjenaSSirina Then SSirina = 100
        Return trt
    End Function

