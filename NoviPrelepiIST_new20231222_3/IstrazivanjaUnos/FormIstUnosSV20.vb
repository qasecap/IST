    Private Sub SklopiUnos(ByVal izazur As Boolean, ByVal azklj(,) As String)
        Dim nn As DatasetIstrazivanja.ISTRow = dIst.IST.Rows(0)
        Me.Tag = Me.GlavnaTabela
        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode.Trim.ToUpper = "MIXMODECAPIDESKTOP" Then
            b3.Text = nn.Naziv.Trim
            b3.Text = b3.Text + "   F4 ili FN+F4 - prikazuje ceo padajući meni (opštine,naselja), F5 - daje napomenu koju možete uneti na nivou celog upitnika" & " : " & Me.GlavnaTabela  ' naziv istrazivanja
        Else
            b3.Text = b3.Text & " " & Me.txtInst & " - " & nn.Naziv.Trim & " : " & Me.GlavnaTabela  ' naziv istrazivanja
        End If

        Call getMultiLanguage()

        If izazur Then
            Dim pp(,) As String = Me.NslKljuc
            Me.NslKljuc = azklj
            SklopiKljuc(izazur)
            Me.NslKljuc = pp
        Else
            SklopiKljuc()
        End If
        SklopiOstale(izazur)

        'da se protrci kroz ISTLK za ADRESAR i dodele u Konsult i Adresar....
        If SCati = False Then
            DopuniUnosIzLK()
        Else
            For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                DopuniUnosIzLK(grupePitanjaCATI(i))
            Next
        End If

    End Sub
