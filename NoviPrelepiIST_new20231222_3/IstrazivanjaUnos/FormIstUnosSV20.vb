    Private Sub pp_ValidacijaLeft(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)
        If PnlMsg.Visible = True Then PnlMsgB.Focus() : Exit Sub
        Dim tbox As TextBox = sender
        'ako je menjano i ako je prazno i ako posle njega nema nista
        Dim tbind As Integer = Array.IndexOf(nizbio, tbox)

        Dim poslednji As Boolean = False
        For i As Integer = nizbio.GetUpperBound(0) To tbind Step -1
            Dim pvred As String = nizbiovred(i)
            If pvred <> "ISTISTIST" Then
                If i = tbind Then poslednji = True
                Exit For
            End If
        Next

        If tbind >= 0 AndAlso poslednji = True Then  'u nizbio je i jeste poslednji
            okvalidacija = True
            If tbox.Text.Trim = "" Then
                'Call pp_ValidacijaRightSamoDodela(tb, Nothing)
            Else
                Call pp_Validacija(tbox, Nothing, False, "")
                If okvalidacija = False Then
                    Call zatvoriOLHC()
                    tbox.Focus()
                    Exit Sub
                End If
            End If
        End If
        If tbind >= 0 AndAlso poslednji = False Then  'u nizbio je i nije poslednji
            'Dim p As Control = nizbio(trtind + 1)    'sledeci
            'Dim pvred As String = nizbiovred(trtind + 1) 'sledecivrednost
            Dim valRIGHT As Boolean = False
            For i As Integer = tbind + 1 To nizbio.GetUpperBound(0)
                Dim pvred As String = nizbiovred(i)
                If pvred <> "" AndAlso pvred <> "ISTISTIST" Then
                    valRIGHT = True
                    Exit For
                End If
            Next
            okvalidacija = True
            If valRIGHT = False Then   'i nije poslednji
                'Call pp_ValidacijaRightSamoDodela(tb, Nothing)
            Else
                Call pp_Validacija(tbox, Nothing, False, "")
                If okvalidacija = False Then
                    Call zatvoriOLHC()
                    tbox.Focus()
                    Exit Sub
                End If
            End If
            If valRIGHT = True Then
                okvalidacija = True
                Call pp_Validacija(tbox, Nothing, False, "")
                If okvalidacija = False Then
                    Call zatvoriOLHC()
                    tbox.Focus()
                    Exit Sub
                End If
            End If
        End If
    End Sub

