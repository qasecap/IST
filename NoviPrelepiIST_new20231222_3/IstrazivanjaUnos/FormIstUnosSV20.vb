                'uslov za addNewRowTo
                If addnewrow <> "" AndAlso addnewrow.IndexOf("VALUES") < 0 Then
                    MsgBox("Syntax for addNewRowTo is not valid!", vbInformation, "")
                    addnewrow = ""
                Else
                    a = 1
                    If addnewrowif <> "" Then
                        addnewrowif = addnewrowif.Trim.ToUpper.Replace("ADDNEWROWIF=", "")
                        Dim zzz As String = sracPanel(addnewrowif.Replace("}", ""), Nothing, Nothing, panel)
                        zzz = razCASTi(zzz)
                        a = scompute(zzz, btn.Name, "ADDNEWROWIF")
                    End If
                    'addNewRowToTRACE2(god,POCETNI_H990099,rbr,P010100,P990099)values(god,POCETNI_H990099,rbr,ime,P990099)
                    addnewrow = addnewrow.Replace("ADDNEWROWTO", "").Replace("VALUES", "$")
                    'TRACE2(GOD, POCETNI_H990099, RBR, P010100, P990099)$(GOD,POCETNI_H990099,RBR,IME,P990099)
                    pp = addnewrow.Split("$")
