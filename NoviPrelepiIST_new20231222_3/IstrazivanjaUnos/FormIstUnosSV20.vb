                                End If
                            End If
                        Next
                    End If
                End If
            End If

        End If 'if tbox.enabled

        If tbox.Multiline = True Then tbox.Select(tbox.Text.Length, 0)
        Dim lbl As Label = NadjiKontrolu(panel, "AlwaysVisibleLabelPANEL" + panel.Name.ToUpper)
        If Not lbl Is Nothing Then
            lbl.Text = avltekst
        Else
            'lbl.Text = ""
        End If

