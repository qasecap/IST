    Private Sub mnu02_Opened(sender As Object, e As EventArgs) Handles mnu02.Opened
        If previewEditMode = True Then
            Call sveVis()
            Dim cntl As Control = mnu02.SourceControl
            If cntl Is Nothing Then Exit Sub
            tm8.Visible = True  'label
            tm9.Visible = True    'textbox
            tm91.Visible = True   'VF
            tmCB.Visible = True 'CB
            tmChB.Visible = True  'ChB
