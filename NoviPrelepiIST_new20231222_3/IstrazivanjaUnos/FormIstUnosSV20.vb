                    For i As Integer = 0 To tbox.Tag.tpolja.getupperbound(0)
                        Dim qq As String
                        If tbox.Tag.Tpolja(i).indexof("'") >= 0 Then
                            qq = tbox.Tag.Tpolja(i).Replace("'", "").Trim
                        Else
                            qq = SEK(tbox.Tag.Tpolja(i))
                            If qq = "" Then
                                Dim pime As String = tbox.Tag.Tpolja(i)
                                Dim ind As Integer = Array.IndexOf(nizKontrolaIme, pime.Trim.ToUpper)
                                If ind > -1 Then qq = SE(pime,, nizKontrola(ind).Parent)
                            End If
                        End If
                        ReDim Preserve tplj(tplj.GetUpperBound(0) + 1)
                        tplj(tplj.GetUpperBound(0)) = qq
