    Private Sub cbpp_popuni(ByRef cbo As ComboBox, Optional ByVal filter As Boolean = False, Optional ByVal SV As String = "", Optional ByVal bezFilteraIakoGaIma As Boolean = False)

        Dim plj As String = Mid(cbo.Name.Trim.ToUpper, 3)
        Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
        Dim sta As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("izraz")).Trim.ToUpper

        If sta.Trim.ToUpper.IndexOf("READONLY") >= 0 Then sta = NZ(Replace(sta, "readonly", "", 1, , CompareMethod.Text)).Trim
        If sta.Trim.ToUpper.IndexOf("VISIBLEFALSE") >= 0 Then sta = NZ(Replace(sta, "visiblefalse", "", 1, , CompareMethod.Text)).Trim
        If sta.Trim.ToUpper.IndexOf("ENABLEDFALSE") >= 0 Then sta = NZ(Replace(sta, "enabledfalse", "", 1, , CompareMethod.Text)).Trim
        If sta.Trim.ToUpper.IndexOf("$") >= 0 Then sta = NZ(Replace(sta, "$", "", 1, , CompareMethod.Text)).Trim

        Dim dt As New DataTable
        Dim izvorCBO As String = ""
        Dim prikaziCBO As String = ""
        Dim upisiCBO As String = ""
        Dim prenesiCBO As String = ""
        Dim filterCBO As String = ""
        sta = sta.Replace("CBO{", "")
        sta = sta.Replace("CBW{", "")
        sta = sta.Substring(0, sta.Length - 1)

        sta = sta.Replace("  =", "=")
        sta = sta.Replace(" =", "=")

        Dim saPraznim As Boolean = True

        Dim nizCB As String() = Split(sta, ";")
        For ii As Integer = 0 To nizCB.GetUpperBound(0)
            If nizCB(ii).Trim.ToUpper.IndexOf("IZVOR=") >= 0 Then
                izvorCBO = nizCB(ii).Replace("IZVOR=", "")
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("IZVORNE=") >= 0 Then
                izvorCBO = nizCB(ii).Replace("IZVORNE=", "")
                saPraznim = False
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("PRIKAZI=") >= 0 Then
                prikaziCBO = nizCB(ii).Replace("PRIKAZI=", "").Trim
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("UBAZU=") >= 0 Then
                upisiCBO = nizCB(ii).Replace("UBAZU=", "").Trim
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("DATASOURCE=") >= 0 Then
                izvorCBO = nizCB(ii).Replace("DATASOURCE=", "").Trim
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("DATASOURCENE=") >= 0 Then
                izvorCBO = nizCB(ii).Replace("DATASOURCENE=", "").Trim
                saPraznim = False
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("DISPLAYMEMBER=") >= 0 Then
                prikaziCBO = nizCB(ii).Replace("DISPLAYMEMBER=", "").Trim
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("VALUEMEMBER=") >= 0 Then
                upisiCBO = nizCB(ii).Replace("VALUEMEMBER=", "").Trim
            End If
            If nizCB(ii).Trim.ToUpper.IndexOf("FILTER=") >= 0 Then
                filterCBO = nizCB(ii).Replace("FILTER=", "").Trim
            End If
        Next
        Dim sqlFilter As String = "2=2"

        If filterCBO.Length > 0 Then
            Dim nizFilter As String() = Split(filterCBO, ",")
            For kk As Integer = 0 To nizFilter.Length - 1
                Dim aaa() As String = razkvantaj(nizFilter(kk))
                For i As Integer = 0 To aaa.Length() - 1
                    If aaa(i).Length() > 1 AndAlso aaa(i).Substring(0, 2).ToUpper = "D." Then
                        Dim pomkljuc As String = aaa(i).Replace("D.", "")
                        'da li je deo kljuca?
                        If Not NslKljuc Is Nothing Then
                            For j As Integer = 0 To NslKljuc.GetUpperBound(0)   'GlavniKljuc
                                If NslKljuc(j, 0).Trim.ToUpper = pomkljuc.Trim.ToUpper Then
                                    SV = SEK(pomkljuc)
                                    Exit For
                                End If
                            Next
                        End If

                        Dim pom As String = aaa(i).Substring(2).Trim & "," & cbo.Name.Substring(2).Trim
                        If CBnaCB.IndexOf(pom) < 0 Then CBnaCB = CBnaCB & pom & ";"
                        aaa(i) = "'" & SV & "'"
                    End If

                    'fiktivnoPolje
                    If aaa(i).Length() > 3 AndAlso aaa(i).Substring(0, 4).ToUpper = "#FP{" Then
                        Dim pom As String = aaa(i) & "," & cbo.Name.Substring(2).Trim
                        If CBnaCB.IndexOf(pom) < 0 Then CBnaCB = CBnaCB & pom & ";"
                        aaa(i) = "'" & SV & "'"
                    End If
                Next
                nizFilter(kk) = ustringaj(aaa).ToUpper
                sqlFilter = sqlFilter & " and " & nizFilter(kk)
            Next kk

            If sqlFilter.Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse sqlFilter.Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
                'nadji nadtabela sta je
                Dim nadtabela As String = nadtabelaJe(Me.GlavnaTabela)
                Dim zzz As String = sqlFilter
                Dim trt() As String = razkvantaj(zzz)
                For i As Integer = 0 To trt.Length() - 1
                    trt(i) = GlavaHead(trt(i), DTbl(DGi(nadtabela)).Rows(0))
                Next
                zzz = ustringaj(trt).ToUpper
                sqlFilter = zzz
            End If

        End If

        'zamena GGGMMM
        Dim sql As String
        sql = izvorCBO.Trim.ToUpper
        sql = ZameniGGGMMMUnos(sql)

        If bezFilteraIakoGaIma = False Then
            If filterCBO.Length > 0 Then
                If sql.Trim.ToUpper.IndexOf("WHERE") >= 0 Then
                    izvorCBO = sql.Replace(";", "") & " and " & sqlFilter
                Else
                    izvorCBO = sql & " where " & sqlFilter
                End If
            Else
                izvorCBO = sql
            End If
        Else
            izvorCBO = sql
        End If

        dt = izvrsiSQLvratiDT(izvorCBO, Me.DBConnectionString, Me.jezik)

        Dim ds As DataSet = New DataSet
        ds.Tables.Add("tabela")

        ds.Tables("tabela").Columns.Add("prikazi", GetType(String))
        ds.Tables("tabela").Columns.Add("upisi", GetType(String))

        'ubaci prazan

        Dim dr0 As DataRow = ds.Tables("tabela").NewRow()
        dr0("prikazi") = ""
        dr0("upisi") = ""
        ds.Tables("tabela").Rows.Add(dr0)
        'If saPraznim = True Then
        'ds.Tables("tabela").Rows.Add(dr0)
        'End If

        For i As Int16 = 0 To dt.Rows.Count - 1
            Dim dr As DataRow = ds.Tables("tabela").NewRow()
            Try
                dr("prikazi") = dt.Rows(i).Item(prikaziCBO)
                dr("upisi") = dt.Rows(i).Item(upisiCBO)
            Catch ex As Exception
                ''msg 338
                Dim msgtxt338 As String = getMessageText(dtMessages, "338", Me.jezik)
                ISTMessageBox.Show(msgtxt338 + nvrd + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Exit For
            End Try
            ds.Tables("tabela").Rows.Add(dr)
        Next

        cbo.DisplayMember = "prikazi"
        cbo.ValueMember = "upisi"
        cbo.DataSource = ds.Tables("tabela")

    End Sub

