    Dim DesignScreenWidth As Integer = 1920
    Dim DesignScreenHeight As Integer = 1080
    Dim hL As Integer
    Dim hP2 As Integer
    Dim h As Integer

    Sub positionCATI(Optional ByVal kako As Integer = 0)

        Dim pomH As Integer = Screen.PrimaryScreen.Bounds.Height
        panelCATIlabel.Height = 1
        panelCATIlabel.Location = New Point(Me.Panel1.Location.X, Me.Panel1.Location.Y + Me.Panel1.Height)

        Dim poc As Integer = Me.BtnExit.Location.Y + Me.BtnExit.Height + Me.Panel1.Height + Me.panelCATIlabel.Location.Y + Me.panelCATIlabel.Height
        pomH = pomH - poc - 2

        Dim pp As String = "112"   'default

        If proportion <> "" Then pp = proportion.Trim.ToUpper.Replace("PROPORTION", "")

        If Not IsNumeric(pp) OrElse pp.Trim.Length <> 3 Then pp = "112"
        'hl
        'hp
        'h
        Dim p1 As Integer = Mid(pp, 1, 1)
        Dim p2 As Integer = Mid(pp, 2, 1)
        Dim p3 As Integer = Mid(pp, 3, 1)

        hL = p1 * pomH / (p1 + p2 + p3)
        hP2 = p2 * pomH / (p1 + p2 + p3)
        h = p3 * pomH / (p1 + p2 + p3)

        panelCATIlabel.Height = hL

        grupePitanjaCATIPom(0).Location = New Point(Me.Panel1.Location.X, Me.panelCATIlabel.Location.Y + Me.panelCATIlabel.Height + 1)
        grupePitanjaCATIPom(0).Height = hP2
        grupePitanjaCATI(0).Height = h
        grupePitanjaCATI(0).Location = New Point(Me.Panel1.Location.X, grupePitanjaCATIPom(0).Location.Y + grupePitanjaCATIPom(0).Height + 1)

        For ii As Integer = 1 To grupePitanjaCATI.GetUpperBound(0)
            grupePitanjaCATIPom(ii).Location = grupePitanjaCATIPom(0).Location
            grupePitanjaCATI(ii).Location = grupePitanjaCATI(0).Location
            grupePitanjaCATIPom(ii).Height = hP2
            grupePitanjaCATI(ii).Height = h
        Next

        If kako = 0 Then
            Dim RatioX As Double
            Dim RatioY As Double

            Dim CurrentScreenWidth As Integer = Screen.PrimaryScreen.Bounds.Width
            Dim CurrentScreenHeight As Integer = Screen.PrimaryScreen.Bounds.Height
            If CurrentScreenWidth <> DesignScreenWidth Then
                RatioX = CurrentScreenWidth / DesignScreenWidth
                RatioY = CurrentScreenHeight / DesignScreenHeight
                Panel1.Width = panelCATIlabel.Width

                'plava labela
                For Each k As Control In Panel1.Controls
                    If TypeOf k Is Label Then
                        k.Width = CInt(k.Width * RatioX)
                        k.Height = CInt(k.Height * RatioY)
                        k.Top = CInt(k.Top * RatioX)
                        k.Left = CInt(k.Left * RatioY)
                        Dim os As Single = RatioX * k.Font.Size
                        k.Font = New Font(k.Font.FontFamily, os, k.Font.Style)
                    End If
                Next

                For Each k As Control In panelCATIlabel.Controls
                    '1.panel - labela
                    ''cica i duca
                    CType(k, Label).AutoSize = True

                Next
                For ii As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                    '2. panel
                    For Each k As Control In grupePitanjaCATIPom(ii).Controls
                        If TypeOf k Is Panel Then   'ovo je radiobutton group
                            k.Width = grupePitanjaCATIPom(ii).Width
                            k.Height = grupePitanjaCATIPom(ii).Height
                            'CType(k, Panel).AutoSize = True
                            For Each kk As Control In k.Controls
                                If TypeOf kk Is RadioButton Then
                                    CType(kk, RadioButton).AutoSize = True
                                End If
                            Next
                        ElseIf TypeOf k Is CheckBox Then
                            CType(k, CheckBox).AutoSize = True
                        End If
                    Next

                    'pitanja - 3. panel
                    For Each k As Control In grupePitanjaCATI(ii).Controls
                        If TypeOf k Is TextBox Then
                            CType(k, TextBox).AutoSize = True
                        End If
                        If TypeOf k Is Label Then
                            CType(k, Label).AutoSize = True
                        End If
                    Next
                Next
            Else
                'nista
            End If
        End If

    End Sub

    Sub position(ByVal panel As Panel)

        Dim pomH As Integer = Screen.PrimaryScreen.Bounds.Height
        Dim poc As Integer = Me.BtnExit.Location.Y + Me.BtnExit.Height + Me.Panel1.Height
        pomH = pomH - poc - 2

        Dim CurrentScreenWidth As Integer = Screen.PrimaryScreen.Bounds.Width
        If CurrentScreenWidth <> DesignScreenWidth Then
            For Each k As Control In panel.Controls
                If TypeOf k Is Panel Then
                    CType(k, Panel).AutoSize = True
                    For Each kk As Control In k.Controls
                        If TypeOf kk Is RadioButton Then
                            CType(kk, RadioButton).AutoSize = True
                        End If
                        If TypeOf kk Is CheckBox Then
                            CType(kk, CheckBox).AutoSize = True
                        End If
                        If TypeOf kk Is TextBox Then
                            CType(kk, TextBox).AutoSize = True
                        End If
                        If TypeOf kk Is Label Then
                            CType(kk, Label).AutoSize = True
                        End If
                        If TypeOf kk Is ComboBox Then
                            CType(kk, ComboBox).AutoSize = True
                        End If
                    Next
                End If
                If TypeOf k Is CheckBox Then
                    CType(k, CheckBox).AutoSize = True
                End If
                If TypeOf k Is TextBox Then
                    CType(k, TextBox).AutoSize = True
                End If
                'If TypeOf k Is Label Then
                '    CType(k, Label).AutoSize = True
                'End If
                If TypeOf k Is ComboBox Then
                    CType(k, ComboBox).AutoSize = True
                End If
                If TypeOf k Is Button Then
                    CType(k, Button).AutoSize = True
                End If
                If TypeOf k Is DataGridView Then
                    CType(k, DataGridView).AutoSize = True
                End If
                If TypeOf k Is DataGridView2 Then
                    CType(k, DataGridView2).AutoSize = True
                End If
            Next
        End If

    End Sub

