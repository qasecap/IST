    Function DONTSAVE(ByVal panelLK As ListBox, ByVal tabela As String, Optional pp As Panel = Nothing) As String

        If Not pp Is Nothing Then
            Me.UradiLKPanel(tabela, pp)
            Me.PrikaziLKPanel(tabela, pp)
        Else
            UradiLK()
            PrikaziLK()
        End If

        Dim dDONTSAVE As String = ""
        Dim rbrgreske As String = ""
        If Not panelLK Is Nothing AndAlso panelLK.Items.Count > 0 Then
            For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
                If r.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                    If r.IsUSLOVNull = False AndAlso r.USLOV.Trim.ToUpper.IndexOf("DONTSAVE") >= 0 Then
                        For Each item As String In panelLK.Items
                            If item.Trim.ToUpper.IndexOf(r.RbrGreske.Trim.ToUpper) >= 0 Then
                                dDONTSAVE = r.RbrGreske.Trim.ToUpper + nvrd + r.NazivGreske.Trim
                                Exit For
                            End If
                        Next
                        If dDONTSAVE <> "" Then Exit For
                    End If
                End If
            Next
        End If
        Return dDONTSAVE
    End Function

    Function DONTSEND(ByVal panelLK As ListBox, ByVal tabela As String, Optional pp As Panel = Nothing) As String

        If Not pp Is Nothing Then
            Me.UradiLKPanel(tabela, pp)
            Me.PrikaziLKPanel(tabela, pp)
        Else
            UradiLK()
            PrikaziLK()
        End If

        Dim dDONTSEND As String = ""
        Dim rbrgreske As String = ""
        If Not panelLK Is Nothing AndAlso panelLK.Items.Count > 0 Then
            For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
                If r.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                    If r.IsUSLOVNull = False AndAlso r.USLOV.Trim.ToUpper.IndexOf("DONTSEND") >= 0 Then
                        For Each item As String In panelLK.Items
                            If item.Trim.ToUpper.IndexOf(r.RbrGreske.Trim.ToUpper) >= 0 Then
                                If r.IsNazivGreskeNull Then
                                    dDONTSEND = dDONTSEND + r.RbrGreske.Trim.ToUpper + nvrd + nvrd
                                Else
                                    dDONTSEND = dDONTSEND + r.RbrGreske.Trim.ToUpper + " - " + r.NazivGreske + nvrd + nvrd
                                End If
                                'Exit For
                            End If
                        Next
                        'If dDONTSEND <> "" Then Exit For
                    End If
                End If
            Next
        End If
        Return dDONTSEND
    End Function

