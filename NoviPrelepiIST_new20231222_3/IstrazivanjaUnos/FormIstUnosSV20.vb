                        'Me.Close() 'jer i za "glavni" unos da se izlazi odmah; npr. kad pozvano iz Azuriranja
                        'OVDE SE MOŽE ZAUSTAVITI DA SE NE ZATVORI!!!!!!************
                        If onSaveNextCloseIF <> "" OrElse onSaveNextDontClose = True Then
                            If onSaveNextDontClose = True Then
                                onSaveNextCloseIF = ""
                            End If
                            If onSaveNextCloseIF <> "" Then
                                Dim zzz As String = sracunajIzraz(onSaveNextCloseIF, Nothing, Nothing)
                                If zzz.Trim.ToUpper.IndexOf(" BETWEEN ") > 0 Then zzz = zameniBETWEEN(zzz)
                                zzz = PrevediF(zzz).Trim.ToUpper
                                Dim a As Integer = scompute(zzz, Nothing, "onSaveNextCloseIF")       '1 TRUE, 0 FALSE
                                If a = 1 Then Me.Close() ' ispunjen USLOV
                            End If
                        Else
                            'klasicno
                            Me.Close()
                        End If
                    End If
                    IdeDalje = False
                Else
                    ''msg 69
                    Dim msgtxt69 As String = getMessageText(dtMessages, "19", Me.jezik)
                    ''msg 70
                    Dim msgtxt70 As String = getMessageText(dtMessages, "19", Me.jezik)
                    If ISTMessageBox.Show(msgtxt69, msgtxt70, MessageBoxButtons.YesNo, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1) = DialogResult.Yes Then
