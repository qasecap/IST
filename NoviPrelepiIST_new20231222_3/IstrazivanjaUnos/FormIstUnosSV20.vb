            End If 'VISIBLEFALSE.Length
            'VISIBLEtrue POLJA
            If nizvisibleTrue.Length > 0 Then
                If nizvisibleTrueAKO.Length > 0 Then
                    For sss As Integer = 0 To nizvisibleTrueAKO.GetUpperBound(0)
                        Try
                            Call vvisibleTrue(nizvisibleTrue(sss), nizvisibleTrueAKO(sss), plj, trt)
                        Catch ex As Exception
                            ''msg 21
                            Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                            ISTMessageBox.Show(ex.Message, msgtxt21 + ": vvisibletrue pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Finally
                        End Try
                    Next
                End If 'VISIBLETrueAko.Length
            End If 'VISIBLETrue.Length

            '************************************************************************
            'BOJIU, BOJIAKO
            If bojiU.Length > 0 AndAlso bojiSta.Length > 0 Then
                If bojiAKO.Length > 0 Then
                    For sss As Integer = 0 To nizbojiAKO.GetUpperBound(0)
                        Try
                            Dim tabela As String = GlavnaTabela
                            Dim pomKol4 As New DataColumn("pomKol4")
                            Dim bbb() As String = razkvantaj(nizbojiAKO(sss))
                            For ll As Integer = 0 To bbb.GetUpperBound(0)
                                If bbb(ll).Trim = plj Then
                                    Dim pom As String = SE(plj,, trt.Parent).Trim
                                    'saekrana
                                    If pom = "" Then
                                        bbb(ll) = "Null"
                                    Else
                                        bbb(ll) = "'" + pom + "'"
                                    End If
                                End If
                                If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                                    Dim ind As Integer = Array.IndexOf(nizFPime, bbb(ll).Replace("#FP{", "").Replace("}", "").Trim)
                                    'saekrana pokupi fiktivno polje
                                    If ind > -1 Then bbb(ll) = "'" + SE(bbb(ll).Substring(4), True, nizFP(ind).Parent).Trim + "'"
                                End If
                            Next
                            Dim zzz As String = ustringaj(bbb).ToUpper
                            zzz = razCASTi(zzz)
                            pomKol4.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                            DGTabele(DGi(tabela)).Columns.Add(pomKol4)
                            Dim xxx As Object = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol4)", ""))
                            DGTabele(DGi(tabela)).Columns.Remove(pomKol4)
                            Dim a As Integer = CInt(xxx)  '1 TRUE, 0 FALSE

                            If a = 1 Then 'samo ako je ispunjen USLOV
                                'bojenje
                                If nizbojiSta(sss).Length > 0 Then
                                    Dim trtnizbojiSta As String() = Split(nizbojiSta(sss), ",")
                                    For cc As Integer = 0 To trtnizbojiSta.GetUpperBound(0)
                                        Dim pomocnoDaIskocimIzFora As Integer = 0
                                        For Each k As Control In Me.Panel1.Controls
                                            If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 1) = "C" Then
                                                If Mid(k.Name, 3).Trim.ToUpper = trtnizbojiSta(cc).Trim.ToUpper Then
                                                    Select Case nizBojiU(sss)
                                                        Case "R"
                                                            k.BackColor = Color.Tomato
                                                        Case "Y"
                                                            k.BackColor = Color.LightYellow
                                                        Case "B"
                                                            k.BackColor = Color.LightSteelBlue
                                                        Case "G"
                                                            k.BackColor = Color.LightSeaGreen
                                                        Case "CLL"
                                                            k.BackColor = SystemColors.ControlLightLight
                                                    End Select
                                                End If
                                            End If
                                            If pomocnoDaIskocimIzFora = 1 Then Exit For
                                        Next
                                    Next
                                End If
                            End If
                        Catch ex As Exception
                            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Finally
                        End Try
                    Next
                End If
            End If
            '************************************************************************
            Dim biloSkakanje As Boolean = False
            If skociNA.Length > 0 Then
                If skociAKO.Length > 0 Then 'mora da ima skociako (ako uvek skace onda skociako=2=2)
                    'poruka ako postoji i SKOCI NA ELEMENT
                    If porukaJe.Length > 0 Then
                        If porukaAKO.Length > 0 Then
                            Try
                                For sss As Integer = 0 To nizporukaAKO.GetUpperBound(0)
                                    Call sporuka1(GlavnaTabela, plj, trt, nizporukaAKO(sss), nizporukaJE(sss), simpleMsg)
                                Next
                            Catch ex As Exception
                                ''msg 21
                                Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                                ISTMessageBox.Show(ex.Message, msgtxt21 + ": sporuka1 pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Finally
                            End Try
                        Else
                            ''msg 34
                            Dim msgtxt As String = getMessageText(dtMessages, "34", Me.jezik)
                            ISTMessageBox.Show(nizporukaJE(0), msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            If nizporukaJE(0).Trim.IndexOf("***") < 0 Then
                                trt.BackColor = Color.LemonChiffon
                            End If
                        End If 'porukaAKO.Length
                    End If 'porukaJe.Length

                    'SKAKANJE
                    For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                        Try
                            Dim pomAction As String = Nothing
                            If Not nizskociAction Is Nothing AndAlso nizskociAction.Length > 0 Then pomAction = nizskociAction(sss)
                            Dim bbss As Boolean = sskoci2(GlavnaTabela, plj, trt, nizskociNA(sss), nizskociAKO(sss), pomAction, skippedEnabledFalse, skippedSetEmpty,
                                                          skippedVisibleFalse, skippedDontSave)
                            If bbss = True Then
                                For i As Integer = 0 To nizskip.GetUpperBound(0)
                                    Dim nn() As String = nizskip(i).Split("$")
                                    If nn(0).Trim.ToUpper = plj.Trim.ToUpper Then
                                        nizskip(i) = nn(0) + "$TRUE"
                                        Exit For
                                    End If
                                Next
                                biloSkakanje = True 'ISPUNJEN USLOV, SKOCIO
                                Exit For
                            End If
                        Catch ex As Exception
                            ''msg 56
                            Dim msgtxt As String = getMessageText(dtMessages, "56", Me.jezik)
                            ISTMessageBox.Show(ex.Message, msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            'ISTMessageBox.Show(ex.Message, "Greška sskoci2 cbpp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Finally
                        End Try
                    Next
                    'prethodno je postojalo skakanje sa polja, sada nijedan uslov nije zadovoljen, tj nema skoka - mora reset da se poniste efekti od prethodnog skakanja
                    Dim oksk As Boolean = False
                    For i As Integer = 0 To nizskip.GetUpperBound(0)
                        Dim nn() As String = nizskip(i).Split("$")
                        If nn(0).Trim.ToUpper = plj.Trim.ToUpper AndAlso nn(1).Trim.ToUpper = "TRUE" Then
                            oksk = True
                            Exit For
                        End If
                    Next
                    If oksk = True AndAlso biloSkakanje = False Then  'NIJE ISPUNJEN NIJEDAN USLOV, MORA RESET AKO JE PRETHODNO POSTOJALO SKAKANJE
                        For sss As Integer = 0 To nizskociAKO.GetUpperBound(0)
                            Call sskoci2RESET(trt, nizskociNA(sss))
                        Next
                    End If
                    'SKAKANJE KRAJ

                End If 'skociAKO.Length
            Else 'skociNA.Length>0 NEMA SKOCI NA ELEMENT

            End If 'skociNA.Length

            promenaCBO = False

            If skociNA.Length = 0 Then
                If porukaJe.Length > 0 Then
                    If porukaAKO.Length > 0 Then
                        For sss As Integer = 0 To nizporukaAKO.GetUpperBound(0)
                            Try
                                Call sporuka1(GlavnaTabela, plj, trt, nizporukaAKO(sss), nizporukaJE(sss), simpleMsg)
                            Catch ex As Exception
                                ''msg 21
                                Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                                ISTMessageBox.Show(ex.Message, msgtxt21 + ": sskoci1 2.put cbpp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Finally
                            End Try
                        Next
                    Else 'ako nema uslova
                        ''msg 34
                        Dim msgtxt As String = getMessageText(dtMessages, "34", Me.jezik)
                        ISTMessageBox.Show(nizporukaJE(0), msgtxt, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        If nizporukaJE(0).Trim.IndexOf("***") < 0 Then
                            trt.BackColor = Color.LemonChiffon
                        End If
                    End If 'porukaAKO.Length

                End If 'porukaNA.Length
            End If  'If skociNA.Length = 0 Then

            'READONLY POLJA
            If samoCita.Length > 0 Then
                If samoCitaAKO.Length > 0 Then
                    For sss As Integer = 0 To nizsamoCitaAKO.GetUpperBound(0)
                        Try
                            Dim tabela As String = GlavnaTabela
                            Dim pomKol4 As New DataColumn("pomKol4")
                            Dim bbb() As String = razkvantaj(nizsamoCitaAKO(sss))
                            For ll As Integer = 0 To bbb.GetUpperBound(0)
                                If bbb(ll).Trim = plj Then
                                    Dim pom As String = SE(plj,, trt.Parent).Trim
                                    'saekrana
                                    If pom = "" Then
                                        bbb(ll) = "Null"
                                    Else
                                        bbb(ll) = "'" + pom + "'"
                                    End If
                                End If
                                If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
                                    Dim ind As Integer = Array.IndexOf(nizFPime, bbb(ll).Replace("#FP{", "").Replace("}", "").Trim)
                                    'saekrana pokupi fiktivno polje
                                    If ind > -1 Then bbb(ll) = "'" + SE(bbb(ll).Substring(4), True, nizFP(ind).Parent).Trim + "'"
                                End If
                            Next
                            Dim zzz As String = ustringaj(bbb).ToUpper
                            zzz = razCASTi(zzz)
                            pomKol4.Expression = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                            DGTabele(DGi(tabela)).Columns.Add(pomKol4)
                            Dim xxx As Object = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol4)", ""))
                            DGTabele(DGi(tabela)).Columns.Remove(pomKol4)
                            Dim a As Integer = CInt(xxx)  '1 TRUE, 0 FALSE

                            'READONLY
                            If nizsamoCita(sss).Length > 0 Then
                                Dim trtniz As String() = Split(nizsamoCita(sss), ",")
                                For cc As Integer = 0 To trtniz.GetUpperBound(0)
                                    If trtniz(cc).IndexOf("TABELA") = 0 Then
                                        trtniz(cc) = trtniz(cc).Replace("TABELA", "BTN")
                                    End If
                                    If trtniz(cc).IndexOf("TABLE") = 0 Then
                                        trtniz(cc) = trtniz(cc).Replace("TABLE", "BTN")
                                    End If
                                    Dim pomocnoDaIskocimIzFora As Integer = 0
                                    For Each k As Control In Me.Panel1.Controls
                                        If Mid(k.Name, 1, 1) = "B" Then
                                            If Mid(k.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                                If a = 1 Then 'samo ako je ispunjen USLOV
                                                    CType(k, Button).Enabled = False
                                                Else          'ako je NIJE ispunjen USLOV
                                                    CType(k, Button).Enabled = True
                                                End If
                                            End If
                                        End If

                                        If Mid(k.Name, 1, 1) = "T" Then
                                            If Mid(k.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                                If a = 1 Then 'samo ako je ispunjen USLOV
                                                    CType(k, TextBox).BackColor = RGBColors.mBackColor
                                                    CType(k, TextBox).Enabled = False
                                                Else          'ako je NIJE ispunjen USLOV
                                                    CType(k, TextBox).BackColor = SystemColors.ControlLightLight
                                                    CType(k, TextBox).Enabled = True
                                                End If
                                            End If
                                        End If
                                        If Mid(k.Name, 1, 1) = "C" Then
                                            If Mid(k.Name, 3).Trim.ToUpper = trtniz(cc).Trim.ToUpper Then
                                                If a = 1 Then 'samo ako je ispunjen USLOV
                                                    CType(k, ComboBox).Enabled = False
                                                Else          'ako je NIJE ispunjen USLOV
                                                    CType(k, ComboBox).Enabled = True
                                                End If
                                            End If
                                        End If
                                        If pomocnoDaIskocimIzFora = 1 Then Exit For

                                    Next
                                Next
                            End If
                        Catch ex As Exception
                            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Finally
                        End Try
                    Next
                End If 'samoCitaAko.Length
            End If 'samoCita.Length

            If SCati = False AndAlso trt.TabIndex = puf(GlavnaTabela) Then BtnSaveNext.Focus()

        End If   'kraj od pitanja da li je zakljucan
    End Sub

    Private Sub dcbpp_Validating(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)
        Dim dcbox As ComboBox = CType(sender, ComboBox)
        mouseleavePOLJE = dcbox
        mouseleavePanel = dcbox.Parent
        If nepotrebnavalidacijaPanel = False Then
            Call dcbpp_validacija(sender, e)
        Else
            dcbox.BackColor = bojaPocTextbox
        End If
    End Sub

    Private Sub dcbpp_validacija(ByVal sender As Object, ByVal e As System.ComponentModel.CancelEventArgs)

        okvalidacija = True
        Dim trt As ComboBox = CType(sender, ComboBox)
        If Me.btnNext.Visible = True Then   'znaci zakljucan NEMA MENJANJA, pa nema potrebe ni da ide kroz ovo
            'odmah izlazim
            trt.BackColor = SystemColors.ControlLightLight
        Else   'NIJE ZAKLJUCAN
            'ISTMessageBox.Show("cbpp_Leave ", MsgBoxStyle.Information)

            Dim plj As String = Mid(trt.Name.Trim.ToUpper, 4)

            If trt.SelectedIndex > -1 Then
            Else
                trt.Text = ""
                trt.SelectedItem = -1
            End If

            Dim panel As Panel = trt.Parent
            Dim GlavnaTabela As String = panel.Name.Replace("PANE_", "")
            Dim pomtxt As String = "tabela='" & GlavnaTabela.Trim & "' and polje='" & plj & "'"
            Dim pomIzraz As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("izraz")).Trim.ToUpper
            Dim pomOD As String = NZ(dIst.ISTPOLJA.Select(pomtxt.Replace("=N'", "='"))(0).Item("od")).Trim.ToUpper
            pomOD = pomOD.Trim.ToUpper.Replace("NEWQUESTIONGROUP", "")
            Dim nizProvera() As String = {}
            Dim daV As String = ""
            Dim nizdaV() As String = {}
            Dim neV As String = ""
            Dim nizneV() As String = {}

            Dim upozorenje As Boolean = False
            Dim obaveznaV As String = ""

            Dim skociNA As String = ""
            Dim nizskociNA() As String = {}
            Dim skociAKO As String = ""
            Dim nizskociAKO() As String = {}
            Dim skociAction As String = ""
            Dim nizskociAction() As String = {}

            Dim porukaJe As String = ""
            Dim nizporukaJE() As String = {}
            Dim porukaAKO As String = ""
            Dim nizporukaAKO() As String = {}

            'readOnly
            Dim samoCita As String = ""
            Dim nizsamoCita() As String = {}
            Dim samoCitaAKO As String = ""
            Dim nizsamoCitaAKO() As String = {}

            Dim dodeliKome As String = ""
            Dim nizdodeliKome() As String = {}
            Dim dodeliSta As String = ""
            Dim nizdodeliSta() As String = {}
            Dim dodeliAko As String = ""
            Dim nizdodeliAko() As String = {}

            Dim bojiU As String = ""
            Dim nizBojiU() As String = {}
            Dim bojiAKO As String = ""
            Dim nizbojiAKO() As String = {}
            Dim bojiSta As String = ""
            Dim nizbojiSta() As String = {}

            Dim skippedEnabledFalse As Boolean = False
            Dim skippedSetEmpty As Boolean = False
            Dim skippedDontSave As Boolean = False
            Dim skippedVisibleFalse As Boolean = False
            Dim skippedSetEmptyExcept As String = ""
            Dim nizskippedSetEmptyExcept() As String = {}
            Dim skippedSetEmptyExceptIF As String = ""
            Dim nizskippedSetEmptyExceptIF() As String = {}

            Dim stopIF As String = ""
            Dim stopMSG As String = ""

            If pomOD.Length > 0 AndAlso pomOD.Trim.IndexOf("#{") = 0 Then
                pomOD = pomOD.Replace("#{", "")
                pomOD = pomOD.Replace("}", "")
                pomOD = pomOD.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim

                nizProvera = Split(pomOD, ";")
                For i As Integer = 0 To nizProvera.GetUpperBound(0)

                    nizProvera(i) = nizProvera(i).Trim.ToUpper

                    If nizProvera(i).IndexOf("OBAVEZNOAKO=") = 0 Then obaveznaV = razCASTi(nizProvera(i).Replace("OBAVEZNOAKO=", "")).Trim
                    If nizProvera(i).IndexOf("UPOZORENJE") = 0 Then upozorenje = True

                    If nizProvera(i).IndexOf("DA=") >= 0 Then
                        daV = razCASTi(nizProvera(i).Replace("DA=", "")).Trim
                        nizdaV = Split(daV, ",")
                    End If
                    If nizProvera(i).IndexOf("NE=") >= 0 Then
                        neV = razCASTi(nizProvera(i).Replace("NE=", "")).Trim
                        nizneV = Split(neV, ",")
                    End If
                    If nizProvera(i).IndexOf("DODELIKOME=") >= 0 Then
                        dodeliKome = nizProvera(i).Replace("DODELIKOME=", "")
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).IndexOf("DODELISTA=") >= 0 Then
                        dodeliSta = nizProvera(i).Replace("DODELISTA=", "")
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).IndexOf("DODELIAKO=") >= 0 Then
                        dodeliAko = (nizProvera(i).Replace("DODELIAKO=", ""))
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If
                    If nizProvera(i).IndexOf("SKOCINA=") >= 0 Then
                        skociNA = nizProvera(i).Replace("SKOCINA=", "")
                        nizskociNA = Split(skociNA, "$")
                    End If
                    If nizProvera(i).IndexOf("SKOCIAKO=") >= 0 Then
                        skociAKO = nizProvera(i).Replace("SKOCIAKO=", "")
                        nizskociAKO = Split(skociAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("READONLY=") >= 0 Then
                        samoCita = nizProvera(i).Replace("READONLY=", "")
                        nizsamoCita = Split(samoCita, "$")
                    End If
                    If nizProvera(i).IndexOf("READONLYAKO=") >= 0 Then
                        samoCitaAKO = (nizProvera(i).Replace("READONLYAKO=", ""))
                        nizsamoCitaAKO = Split(samoCitaAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("PORUKAJE=") >= 0 Then
                        porukaJe = nizProvera(i).Replace("PORUKAJE=", "")
                        nizporukaJE = Split(porukaJe, "$")
                    End If
                    If nizProvera(i).IndexOf("PORUKAAKO=") >= 0 Then
                        porukaAKO = (nizProvera(i).Replace("PORUKAAKO=", ""))
                        nizporukaAKO = Split(porukaAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("BOJIU=") >= 0 Then
                        bojiU = nizProvera(i).Replace("BOJIU=", "")
                        nizBojiU = Split(bojiU, "$")
                    End If
                    If nizProvera(i).IndexOf("BOJIAKO=") >= 0 Then
                        bojiAKO = nizProvera(i).Replace("BOJIAKO=", "")
                        nizbojiAKO = Split(bojiAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("BOJISTA=") >= 0 Then
                        bojiAKO = nizProvera(i).Replace("BOJISTA=", "")
                        nizbojiSta = Split(bojiSta, "$")
                    End If
                    '*********
                    If nizProvera(i).IndexOf("REQUIREDIF=") = 0 Then obaveznaV = razCASTi(nizProvera(i).Replace("REQUIREDIF=", "")).Trim
                    If nizProvera(i).IndexOf("WARNING") = 0 Then upozorenje = True
                    If nizProvera(i).IndexOf("YES=") >= 0 Then
                        daV = razCASTi(nizProvera(i).Replace("YES=", "")).Trim
                        nizdaV = Split(daV, ",")
                    End If
                    If nizProvera(i).IndexOf("NO=") >= 0 Then
                        neV = razCASTi(nizProvera(i).Replace("NO=", "")).Trim
                        nizneV = Split(neV, ",")
                    End If
                    If nizProvera(i).IndexOf("ASSIGNTO=") >= 0 Then
                        dodeliKome = nizProvera(i).Replace("ASSIGNTO=", "")
                        nizdodeliKome = Split(dodeliKome, "$")
                    End If
                    If nizProvera(i).IndexOf("ASSIGNWHAT=") >= 0 Then
                        dodeliSta = nizProvera(i).Replace("ASSIGNWHAT=", "")
                        nizdodeliSta = Split(dodeliSta, "$")
                    End If
                    If nizProvera(i).IndexOf("ASSIGNIF=") >= 0 Then
                        dodeliAko = (nizProvera(i).Replace("DODELIAKO=", ""))
                        nizdodeliAko = Split(dodeliAko, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPTO=") >= 0 Then
                        skociNA = nizProvera(i).Replace("SKIPTO=", "")
                        nizskociNA = Split(skociNA, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPIF=") >= 0 Then
                        skociAKO = nizProvera(i).Replace("SKIPIF=", "")
                        nizskociAKO = Split(skociAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPACTION=") >= 0 Then
                        skociAction = nizProvera(i).Replace("SKIPACTION=", "")
                        nizskociAction = Split(skociAction, "$")
                    End If

                    If nizProvera(i).IndexOf("READONLYIF=") >= 0 Then
                        samoCitaAKO = (nizProvera(i).Replace("READONLYIF=", ""))
                        nizsamoCitaAKO = Split(samoCitaAKO, "$")
                    End If

                    If nizProvera(i).IndexOf("MSGIS=") >= 0 Then
                        porukaJe = nizProvera(i).Replace("MSGIS=", "")
                        nizporukaJE = Split(porukaJe, "$")
                    End If
                    If nizProvera(i).IndexOf("MSGIF=") >= 0 Then
                        porukaAKO = (nizProvera(i).Replace("MSGIF=", ""))
                        nizporukaAKO = Split(porukaAKO, "$")
                    End If

                    If nizProvera(i).IndexOf("COLORTO=") >= 0 Then
                        bojiU = nizProvera(i).Replace("COLORTO=", "")
                        nizBojiU = Split(bojiU, "$")
                    End If
                    If nizProvera(i).IndexOf("COLORWHAT=") >= 0 Then
                        bojiAKO = nizProvera(i).Replace("COLORWHAT=", "")
                        nizbojiAKO = Split(bojiAKO, "$")
                    End If
                    If nizProvera(i).IndexOf("COLORIF=") >= 0 Then
                        bojiAKO = nizProvera(i).Replace("COLORIF=", "")
                        nizbojiSta = Split(bojiSta, "$")
                    End If
                    If nizProvera(i).IndexOf("STOPIF=") = 0 Then
                        stopIF = nizProvera(i).Replace("STOPIF=", "")
                    End If
                    If nizProvera(i).IndexOf("STOPMSG=") = 0 Then
                        stopMSG = nizProvera(i).Replace("STOPMSG=", "")
                    End If

                    If nizProvera(i).IndexOf("SKIPPEDENABLEDFALSE") = 0 Then skippedEnabledFalse = True
                    If nizProvera(i).IndexOf("SKIPPEDSETEMPTY") = 0 Then skippedSetEmpty = True
                    If nizProvera(i).IndexOf("SKIPPEDDONTSAVE") = 0 Then skippedDontSave = True
                    If nizProvera(i).IndexOf("SKIPPEDVISIBLEFALSE") = 0 Then skippedVisibleFalse = True

                    If nizProvera(i).IndexOf("SKIPPEDSETEMPTYEXCEPT=") = 0 Then
                        skippedSetEmptyExcept = nizProvera(i).Replace("SKIPPEDSETEMPTYEXCEPT=", "")
                        nizskippedSetEmptyExcept = Split(skippedSetEmptyExcept, "$")
                    End If
                    If nizProvera(i).IndexOf("SKIPPEDSETEMPTYEXCEPTIF=") = 0 Then
                        skippedSetEmptyExceptIF = nizProvera(i).Replace("SKIPPEDSETEMPTYEXCEPTIF=", "")
                        nizskippedSetEmptyExceptIF = Split(skippedSetEmptyExceptIF, "$")
                    End If
                Next
            End If

