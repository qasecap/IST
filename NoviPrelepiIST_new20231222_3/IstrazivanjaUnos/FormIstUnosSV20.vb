    Function vratinaprethodni(kk As Control) As Control
        vratinaprethodni = Nothing
        Dim trenutniTabIndex As Integer = kk.TabIndex
        Dim k As Control = kk.Parent.GetNextControl(Me, True) 'Get the first control in the tab order.
        Dim zapamcenakontrola As Control = Nothing
        Do Until k Is Nothing  'MORA PREKO LOOPA
            If k.Enabled = True AndAlso k.TabStop = True AndAlso k.TabIndex < trenutniTabIndex AndAlso k.Visible = True Then
                zapamcenakontrola = k
                k = kk.Parent.GetNextControl(k, True) 'Get the next control in the tab order.
            ElseIf k.TabIndex >= trenutniTabIndex Then
                k = Nothing
            Else
                k = kk.Parent.GetNextControl(k, True)
            End If
        Loop

        vratinaprethodni = zapamcenakontrola

    End Function

