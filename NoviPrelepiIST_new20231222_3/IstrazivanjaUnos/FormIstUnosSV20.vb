    Private Function NadjiUDTbl(Optional ByVal Vodovodi As Boolean = False) As Integer ' vraca index niza u kome je kljuc sa kojim drljamo
        Dim sql As String = " 2=2 "
        Dim sqlNU As String = sql
        For i As Integer = 0 To Me.GlavniKljuc.GetUpperBound(0)
            If IsNumeric(SEK(Me.GlavniKljuc(i))) = True Then
                sql = sql + " and " & Me.GlavniKljuc(i) & " ='" & SEK(Me.GlavniKljuc(i)) & "'"
            Else
                sql = sql + " and " & Me.GlavniKljuc(i) & " =N'" & SEK(Me.GlavniKljuc(i)) & "'"
            End If
            sqlNU = sqlNU + " and " & Me.GlavniKljuc(i) & " ='" & SEK(Me.GlavniKljuc(i)) & "'"
        Next
        If Vodovodi Then
            sql = sql + " and VOD = " & OrigVOD & " and VDO = " & OrigVDO
            sqlNU = sqlNU + " and VOD = " & OrigVOD & " and VDO = " & OrigVDO
        End If

        Dim red() As DataRow = Me.DTbl(DGi(GlavnaTabela, DTbl)).Select(sqlNU.Replace("=N'", "='"))
        If red.Length > 0 Then
            For i As Integer = 0 To Me.DTbl(DGi(GlavnaTabela, DTbl)).Rows.Count - 1
                If Me.DTbl(DGi(GlavnaTabela, DTbl)).Rows(i) Is red(0) Then Return i
            Next
        End If
        Return -1
    End Function

