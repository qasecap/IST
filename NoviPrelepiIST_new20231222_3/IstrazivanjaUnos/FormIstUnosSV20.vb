            autb = True
        Else
            tbox = CType(sender, TextBox)
        End If

        mouseleavePOLJE = tbox
        mouseleavePanel = panel
        If autb = True AndAlso CType(sender, AutoCompleteTextbox).nepotrebnavalidacijaPanel = True Then
            'DA NE RADI VALIDACIJU ULEVO ZA AUTB NIKAD; TAKAV JE DOGOVOR,
            'AUTOCOMPLETETEXTBOXDODELA
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                If tbox.Text.Trim <> acoldvalue Then
                    Call ddodelaAutoComplete(tbox, plj, panel)
                End If
            End If
            'AUTOCOMPLETETEXTBOXDODELA
            tbox.BackColor = bojaPocTextbox
            Exit Sub
        End If

        If autb = True AndAlso CType(sender, AutoCompleteTextbox).nepotrebnavalidacijaPanel = False Then
            If tbox.Text.Trim <> "" AndAlso Not CType(tbox, AutoCompleteTextbox).assignvalue Is Nothing AndAlso CType(tbox, AutoCompleteTextbox).assignvalue = "" AndAlso CType(tbox, AutoCompleteTextbox).autoCompleteLimitToList = True Then
                tbox.Text = ""
                okvalidacija = False
                tbox.Focus()
                Exit Sub
            End If
        End If

        If nepotrebnavalidacijaPanel = False Then
            nepotrebnavalidacijaPanel = True
            Call dpp_ValidacijaRight(sender, e)
            nepotrebnavalidacijaPanel = False
        Else
            tbox.BackColor = bojaPocTextbox
        End If
    End Sub

