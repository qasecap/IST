    Private Sub NapuniTabelice(ByRef tabelice(,) As Integer)
        Dim r As DatasetIstrazivanja.ISTPOLJARow
        For nmnm As Integer = 0 To redoviMEMForma.GetUpperBound(0)
            r = redoviMEMForma(nmnm)
            Dim x() As String = Split(r.Forma.Trim, ".")
            If x.Length = 3 AndAlso (x(0) <> "" AndAlso x(1) <> "" AndAlso x(2) <> "") Then
                'x(0) - tabela  x(1) - red  x(2) - kolona
                Dim tab As Integer = CInt(x(0))
                If (tabelice Is Nothing) OrElse tab > tabelice.GetUpperBound(1) Then
                    ReDim Preserve tabelice(7, tab - 1)
                    tabelice(0, tab - 1) = tab
                    tabelice(3, tab - 1) = 0
                End If
                If x.Length > 0 Then
                    If CInt(x(1)) > tabelice(1, tab - 1) Then tabelice(1, tab - 1) = CInt(x(1))
                    If x.Length > 1 Then
                        If CInt(x(2)) > 0 AndAlso tabelice(6, tab - 1) = 0 Then
                            tabelice(6, tab - 1) = CInt(x(2))
                        Else
                            If CInt(x(2)) < tabelice(6, tab - 1) Then tabelice(6, tab - 1) = CInt(x(2)) 'najmanji, od koga pocinje 2 nza 11.1.2- ako je ovo prvi tj nema 11.1.1
                        End If
                        If CInt(x(2)) > tabelice(2, tab - 1) Then tabelice(2, tab - 1) = CInt(x(2))   'poslednji 11.1.6
                        tabelice(7, tab - 1) = tabelice(2, tab - 1) - tabelice(6, tab - 1) + 1 'ovo je pravi broj kolona
                    End If
                End If
            End If
        Next
    End Sub

    Private Sub NapuniTabelicePanel(ByRef tabelice(,) As Integer, ByVal tabela As String)
        For Each r As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If r.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                If Not r.IsFormaNull AndAlso r.Forma.Trim <> "" AndAlso r.Forma.Trim.ToUpper <> "1" Then
                    Dim x() As String = Split(r.Forma.Trim, ".")
                    If x.Length = 3 AndAlso (x(0) <> "" AndAlso x(1) <> "" AndAlso x(2) <> "") Then
                        'x(0) - tabela  x(1) - red  x(2) - kolona
                        Dim tab As Integer = CInt(x(0))
                        If (tabelice Is Nothing) OrElse tab > tabelice.GetUpperBound(1) Then
                            ReDim Preserve tabelice(7, tab - 1)
                            tabelice(0, tab - 1) = tab
                            tabelice(3, tab - 1) = 0
                        End If
                        If x.Length > 0 Then
                            If CInt(x(1)) > tabelice(1, tab - 1) Then tabelice(1, tab - 1) = CInt(x(1))
                            If x.Length > 1 Then
                                If CInt(x(2)) > 0 AndAlso tabelice(6, tab - 1) = 0 Then
                                    tabelice(6, tab - 1) = CInt(x(2))
                                Else
                                    If CInt(x(2)) < tabelice(6, tab - 1) Then tabelice(6, tab - 1) = CInt(x(2)) 'najmanji, od koga pocinje 2 nza 11.1.2- ako je ovo prvi tj nema 11.1.1
                                End If
                                If CInt(x(2)) > tabelice(2, tab - 1) Then tabelice(2, tab - 1) = CInt(x(2))
                                tabelice(7, tab - 1) = tabelice(2, tab - 1) - tabelice(6, tab - 1) + 1 'ovo je pravi broj kolona
                            End If
                        End If
                    Else
                        'ne treba mi ovo...
                        'Dim poruka As String = "За поље " + r.POLJE.Trim + " Forma " + r.Forma.Trim + " у табели ISTPOLJA није добра." + vbCrLf + _
                        '    "Forma je облика:        tabela.red.kolona     (1.1.1,2.1.1,...)   или 1 (не служи ничему) или празно!"
                        'ISTMessageBox.Show(poruka, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                End If
            End If
        Next
    End Sub

    Private Sub NapuniTabelicaKolonaDuzina()
        ReDim Preserve TabelicaKolonaDuzina(0)
        ReDim Preserve TabelicaKolonaDuzina(0)(0)
        Dim f1 As Integer = 0
        Dim f3 As Integer = 0

        For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If p.TABELA.Trim.ToUpper = Me.GlavnaTabela.Trim.ToUpper Then
                If Not p.IsFormaNull AndAlso p.Forma.Trim <> "" AndAlso p.Forma.Trim <> "1" Then
                    Dim x() As String = Split(p.Forma.Trim, ".")
                    If x.Length = 3 AndAlso (x(0) <> "" AndAlso x(1) <> "" AndAlso x(2) <> "") Then
                        'x(0) - tabela  x(1) - red  x(2) - kolona
                        f1 = CInt(x(0))
                        f3 = CInt(x(2))
                        Dim dd As String = ""
                        If TabelicaKolonaDuzina.Length <= f1 Then ReDim Preserve TabelicaKolonaDuzina(f1)

                        If TabelicaKolonaDuzina(f1) Is Nothing Then
                            ReDim Preserve TabelicaKolonaDuzina(f1)(f3)
                        Else
                            If TabelicaKolonaDuzina(f1).Length <= f3 Then ReDim Preserve TabelicaKolonaDuzina(f1)(f3)
                        End If

                        TabelicaKolonaDuzina(f1)(f3) = 100

                        If p.IsVSNull OrElse p.VS.Trim = "" Then p.VS = 100

                        Dim ww As Integer = 0

                        If p.VS.Trim.IndexOf(";") >= 0 Then
                            ww = Val(Split(p.VS.Trim, ";")(0))
                        Else
                            ww = p.VS.Trim
                        End If

                        TabelicaKolonaDuzina(f1)(f3) = ww
                    End If
                End If
            End If
        Next

        Dim brojKolona As Integer = 0
        For i As Integer = 0 To TabelicaKolonaDuzina.GetUpperBound(0)
            If Not TabelicaKolonaDuzina(i) Is Nothing Then
                brojKolona = TabelicaKolonaDuzina(i).GetUpperBound(0)
                For j As Integer = 1 To TabelicaKolonaDuzina(i).GetUpperBound(0)
                    If brojKolona > 9 Then TabelicaKolonaDuzina(i)(j) = 9 / (1 + brojKolona) * TabelicaKolonaDuzina(i)(j)
                Next
            End If

        Next
    End Sub

    Private Sub NapuniTabelicaKolonaDuzinaPanel(ByVal tabela As String, ByVal sbar As Boolean)
        ReDim Preserve TabelicaKolonaDuzinaPanel(0)
        ReDim Preserve TabelicaKolonaDuzinaPanel(0)(0)
