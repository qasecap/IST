    Sub cbpkSelectNextControl(ByVal pk As Control)
        Dim ii As Integer = pk.TabIndex
        Dim koji As Integer = -1
        For i As Integer = 0 To nizPKKontrola.GetUpperBound(0)
            Dim tt As Integer = nizPKKontrola(i).TabIndex
            If tt = ii + 1 Then
                koji = i
                Exit For
            End If
        Next

        If koji > -1 Then
            'nizPKKontrola(koji).Focus()   'NESTO OVO NECE, dodaje joj jedan enter
            SendKeys.Send("{TAB}")
        Else
            If Not grupePitanjaCAPI Is Nothing Then
