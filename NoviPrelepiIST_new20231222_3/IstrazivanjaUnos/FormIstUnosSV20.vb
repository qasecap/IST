    Sub bbrriissiiRowsDGTabele(ByVal sqlWHERE As String, ByVal imeTabele As String)

        If DGi(imeTabele) > 0 Then
            'za glavnu
            Dim dt As DataTable
            If nadtabelaJe(GlavnaTabela) = "" Then   'prva forma
                dt = DGTabele(DGi(imeTabele))
            Else
                dt = DTbl(DGi(imeTabele))
            End If
            sqlWHERE = SrediPMGK(sqlWHERE)
            sqlWHERE = ZameniGGGMMMUnos(sqlWHERE)
            sqlWHERE = razCASTi(sqlWHERE)

            Dim foundRows() As DataRow = dt.Select(sqlWHERE.Replace("=N'", "='"))
            dfm = True

            For i As Integer = 0 To foundRows.GetUpperBound(0)
                dt.Rows.Remove(foundRows(i))
            Next i

            Dim sqlDelete As String = "delete from " + imeTabele + " where " + sqlWHERE & ";"
            Dim ok As String = izvrsiSQL(sqlDelete, Me.DBConnectionString)
            If ok <> "ok" Then
                ISTMessageBox.Show("There is error in deleting row for immediately saving, plase call IT!")
            End If


        Else
            MsgBox("Table " + imeTabele + " do not exists in ISTTables table for app " + sifist + "." + nvrd + nvrd + "Rows from table " + imeTabele.Trim.ToUpper + " will not be deleted!", vbInformation, "ERROR IN METADATA")
        End If

    End Sub

    Sub bbrriissiiRowsDtbl(ByVal sqlWHERE As String, ByVal imeTabele As String)
