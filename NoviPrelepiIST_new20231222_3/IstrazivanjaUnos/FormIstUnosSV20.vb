    Function opcDialogResultOnClosing(ByVal sender As System.Object, ByVal e As System.EventArgs, ByVal scati As Boolean,
                ByVal NslKljucNothing As Boolean, ByVal msgtxt As String, ByVal msgtitle As String, ByVal odakle As String) As Integer

        opcDialogResultOnClosing = 0

        msgtxt = nvrd + nvrd + nvrd + nvrd + msgtxt + nvrd + nvrd + nvrd + nvrd

        Dim dr1 As DialogResult = ISTMessageBox.Show(msgtxt, msgtitle, MessageBoxButtons.YesNo, MessageBoxIcon.Question)
        Dim red As String = ""
        Dim ssek As String = ""
        For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
            If SEK(GlavniKljuc(i)) Is Nothing Then ssek = "" Else ssek = SEK(GlavniKljuc(i)).Trim.ToUpper
            red = red + GlavniKljuc(i).Trim.ToUpper + "=" + ssek + " and "
        Next
        red = red + "$$"
        red = red.Replace(" and $$", "")
        Select Case dr1
            Case DialogResult.Yes
                opcDialogResultOnClosing = 1
                Exit Function
            Case DialogResult.No
                Me.menjano = False
                Dim dr2 As DialogResult = ISTMessageBox.Show(msgtxt, msgtitle, MessageBoxButtons.YesNo, MessageBoxIcon.Exclamation)
                opcDialogResultOnClosing = 2
                Select Case dr2
                    Case DialogResult.Yes
                        opcDialogResultOnClosing = 1
                        Exit Function
                    Case DialogResult.No
                        opcDialogResultOnClosing = 2
                        Me.menjano = False
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa(odakle + " DialogResult No 1.time + DialogResult No 2.time", "opcDialogResult table " + GlavnaTabela + " " + red, msgtxt)
                End Select
        End Select
    End Function

