                End If
            Next

            PreracunajFPPanel(tabela, panel)
            'ako nije nadjen daj defaultove
            Call PopuniJosZaPoljaPanel(tabela, panel)
        End If

        If tabela = GlavnaTabela And nadjen Then Me.Izmena = True

        Return True
