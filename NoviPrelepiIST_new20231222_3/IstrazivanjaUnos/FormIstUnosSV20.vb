    Function dalijeposlednjaCNTLCAPIPanel(kk As Control) As Boolean
        dalijeposlednjaCNTLCAPIPanel = True
        Dim mt As Integer = 0
        For Each k As Control In kk.Parent.Controls

            If TypeOf k Is TextBox AndAlso k.TabIndex > 0 AndAlso k.Visible = True AndAlso k.Enabled = True AndAlso k.TabStop = True AndAlso k.TabIndex > mt Then
                If k.AccessibleName Is Nothing OrElse k.AccessibleName.IndexOf("RRO;") < 0 OrElse k.AccessibleName.IndexOf("RO;") < 0 Then mt = k.TabIndex
            End If

            If (TypeOf k Is CheckBox) AndAlso k.TabIndex > 0 AndAlso k.Visible = True AndAlso k.Enabled = True AndAlso k.TabStop = True AndAlso k.TabIndex > mt Then
                If k.AccessibleName Is Nothing OrElse k.AccessibleName.IndexOf("RRO;") < 0 OrElse k.AccessibleName.IndexOf("RO;") < 0 Then mt = k.TabIndex
            End If

            If (TypeOf k Is ComboBox OrElse TypeOf k Is DateTimePicker2) AndAlso k.TabIndex > 0 AndAlso k.Visible = True AndAlso k.Enabled = True AndAlso k.TabStop = True AndAlso k.TabIndex > mt Then
                If k.AccessibleName Is Nothing OrElse k.AccessibleName.IndexOf("RRO;") < 0 OrElse k.AccessibleName.IndexOf("RO;") < 0 Then mt = k.TabIndex
            End If
        Next
        If kk.TabIndex < mt Then dalijeposlednjaCNTLCAPIPanel = False
