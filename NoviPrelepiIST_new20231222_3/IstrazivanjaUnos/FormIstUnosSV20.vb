                If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 1) = "C" OrElse Mid(k.Name, 1, 1) = "U" OrElse Mid(k.Name, 1, 2) = "RG" OrElse Mid(k.Name, 1, 2) = "HH" Then
                    If Not k.AccessibleDescription Is Nothing Then
                        Dim kk() As String = k.AccessibleDescription.Split(";")
                        Dim krbr As Integer = kk(0)
                        If pprbr < krbr AndAlso krbr < nizskociNAsssrbr Then
                            If k.AccessibleName Is Nothing Then k.Enabled = True : k.Visible = True
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("VF;") < 0 Then k.Visible = True
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("VF;") >= 0 Then k.Visible = False
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("NE;") < 0 Then k.Enabled = True
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("NE;") >= 0 Then k.Enabled = False
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("SHH;") >= 0 Then k.AccessibleName = k.AccessibleName.Replace("SHH;", "")
                        End If
                    End If
                End If
            Next
        End If

        Dim tabela As String = GlavnaTabela
        Dim zzz As String = ""
        zzz = sracunajIzraz(nizskociAKOsss, plj, cntl)
        Dim a As Integer = scompute(zzz, plj, "skipif")       '1 TRUE, 0 FALSE

        'ispunjen USLOV
        If a = 1 Then
            'skippedsetemptyExceptIf
            Dim azSE As Integer = 0
            If Not nizskippedSetEmptyExcept Is Nothing AndAlso nizskippedSetEmptyExceptIF.Length > 0 Then
                For i As Integer = 0 To nizskippedSetEmptyExceptIF.GetUpperBound(0)
                    Dim zSE As String = sracunajIzraz(nizskippedSetEmptyExceptIF(i), plj, cntl)
                    zSE = razCASTi(zSE)
                    azSE = scompute(zSE, plj, "skippedsetemptyExceptIf")
                    Dim trtnizKome As String() = Split(nizskippedSetEmptyExcept(i).Trim.ToUpper, ",")
                    If azSE = 1 Then
                        For cc As Integer = 0 To trtnizKome.GetUpperBound(0)
                            Dim k As Control = Me.Panel1.GetNextControl(Me, True) 'Get the first control in the tab order.
                            Do Until k Is Nothing  'MORA PREKO LOOPA
                                If Not TypeOf k Is Label AndAlso Not TypeOf k Is Button AndAlso Not TypeOf k Is DataGridView2 AndAlso Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                    Dim ind11 As Integer = Array.IndexOf(trtnizKome, Mid(k.Name, 3).Trim.ToUpper)
                                    Dim setempty As Boolean = False
                                    If ind11 < 0 Then setempty = True
                                    If setempty = True Then
                                        Dim trenutniRBR As Integer = -1
                                        If Not k.AccessibleDescription Is Nothing Then trenutniRBR = k.AccessibleDescription.Split(";")(0)
                                        If pprbr < trenutniRBR AndAlso trenutniRBR < nizskociNAsssrbr Then
                                            k.Text = ""
                                            Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper,,, k.Parent)
                                            Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                        End If
                                    End If
                                End If
                                k = Me.Panel1.GetNextControl(k, True) 'Get the next control in the tab order.
                            Loop
                        Next
                        Exit For
                    End If
                Next
            End If
            'skippedsetemptyExceptIf

            'skipAction
            If Not nizskociActionsss Is Nothing AndAlso nizskociActionsss.Length > 0 AndAlso nizskociActionsss.Trim <> "" Then
                'skippedEnabledFalse = False : skippedVisibleFalse = False : skippedDontSave = False : skippedSetEmpty = False
                Dim nn As String() = Split(nizskociActionsss, ",")
                For cc As Integer = 0 To nn.GetUpperBound(0)
                    If nn(cc).Trim.ToUpper = "ENABLEDFALSE" Then skippedEnabledFalse = True
                    If nn(cc).Trim.ToUpper = "VISIBLEFALSE" Then skippedVisibleFalse = True
                    If nn(cc).Trim.ToUpper = "DONTSAVE" Then skippedDontSave = True
                    If nn(cc).Trim.ToUpper = "SETEMPTY" Then skippedSetEmpty = True
                Next
            End If
            'skipAction

            If nizskociNAsss = "KRAJINTERVJUA" OrElse nizskociNAsss = "ENDOFINTERVIEWING" Then
                'nema
            ElseIf nizskociNAsss.IndexOf("TABELA") = 0 OrElse nizskociNAsss.IndexOf("TABLE") = 0 Then
                'skace na dupe
                nizskociNAsss = nizskociNAsss.Replace("TABELA", "BTN").Replace("TABLE", "BTN")
                For Each k As Control In panel.Controls
                    If k.Name.Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                        k.Focus()
                        Exit For
                    End If
                Next
            ElseIf nizskociNAsss.IndexOf("PANEL") = 0 AndAlso nizskociNAsss.IndexOf(".") < 0 Then   'skakanje na sam panel
                'skace na dupe koje je panel, tj skace na prvo polje u panelu
                nizskociNAsss = nizskociNAsss.Replace("PANEL", "PANE_")
                For Each k As Control In panel.Controls
                    If k.Name.Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                        Dim bb As Button = NadjiKontrolu(panel, "DBTNPANE" + nizskociNAsss.Trim.ToUpper.Replace("PANE_", ""))
                        If Not bb Is Nothing Then   'ako je bb <>nothing, onda je to tab controla
                            Call dpc(bb, 1)
                            'NIKAKO SENDWAIT, PRESTANE DA RADI :(
                            If k.Tag.Trim.ToUpper.indexof("TAB") = 0 Then
                                SendKeys.Send("{TAB}")
                            End If
                            Exit For
                        End If

                        If bb Is Nothing Then   'ako je bb nothing, onda je to obican panel
                            'SendKeys.Send("{TAB}") NE TREBA!!!!
                            Exit For
                        End If

                    End If
                Next
            ElseIf nizskociNAsss.IndexOf("PANEL") = 0 AndAlso nizskociNAsss.IndexOf(".") > 0 Then
                'skace na odgovarajuce polje u panelu
                For Each k As Control In panel.Controls
                    If TypeOf k Is Button AndAlso k.Name.Trim.ToUpper = ddugme.Trim.ToUpper Then
                        k.Visible = True
                        Dim pp As Panel = dpc(k, 1)
                        Dim kp As Control = NadjiKontroluSkr(pp, ppolje, 3)
                        If Mid(kp.Name, 2, 1) <> "F" Then kp.Enabled = True 'da ostanu fp
                        If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.Trim.ToUpper.IndexOf("VF;") < 0 Then kp.Visible = True
                        kp.Focus()
                        Call fixPanelAfterJump(kp, pp, skippedEnabledFalse, skippedVisibleFalse, skippedDontSave, skippedSetEmpty)
                    Else
                        'sve izmedju na enabled=false AKO NIJE FP KOJE GLUMI LABELU
                        'ako je tab, sve tabove izmedju (dovoljno je samo dugmad disable)
                        If TypeOf k Is Button AndAlso k.Name.Length > 8 AndAlso Mid(k.Name, 1, 8) = "DBTNPANE" Then
                            'dugmepanetab.Name = "DBTNPANE" & t.Trim.ToUpper
                            If skippedEnabledFalse = True Then k.Enabled = False
                            'If Mid(k.Name, 1, 1) <> "F" Then k.Enabled = False???
                            If skippedVisibleFalse = True Then k.Visible = False
                        End If
                        If TypeOf k Is TextBox Then
                            Dim kk() As String = k.AccessibleDescription.Split(";")
                            Dim krbr As Integer = kk(0)
                            nizskociNAsssrbr = 1000   'BLJAK najveci tabindex od glavne tabele
                            If pprbr < krbr AndAlso krbr < nizskociNAsssrbr Then
                                If skippedEnabledFalse = True AndAlso Mid(k.Name, 1, 1) <> "F" Then k.Enabled = False
                                If skippedVisibleFalse = True Then k.Visible = False
                                If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                    Call addSHH(k, nizskociAKOsss)
                                    bbioskippedDontSave = True
                                End If
                                If skippedSetEmpty = True AndAlso azSE = 0 AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                    k.Text = ""
                                    Me.UpisiPolje(k.Name.Substring(2), , "PP_VALIDATING", cntl.Parent)
                                    Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                End If
                            ElseIf krbr > nizskociNAsssrbr Then
                                If Mid(k.Name, 1, 1) <> "F" Then k.Enabled = True 'da ostanu fp
                                If Mid(k.Name, 1, 1) = "F" Then
                                    If k.Tag.izraz <> "''" Then
                                        If k.Tag.izraz <> "''" AndAlso Not (Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("VF;") >= 0) Then k.Visible = True
                                    Else
                                        k.Visible = False
                                    End If
                                End If
                            End If
                        End If
                    End If
                Next
            Else
                'moze i za prazno AND ispunjen USLOV, u uslovu stavi da nije praznol
                'ponistavanje ide samo sa parametrom skippedSetEmpty
                Dim imareset As Boolean = False
                Dim pom As Integer = 0
                For Each k As Control In panel.Controls
                    '1
                    If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox OrElse TypeOf k Is RadioButton OrElse
                    TypeOf k Is DateTimePicker2 OrElse TypeOf k Is Panel Then
                        '2
                        If Mid(k.Name, 3).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                            k.Enabled = True
                            k.Visible = True
                            k.Focus()
                            If Mid(k.Name, 1, 2) = "RG" AndAlso k.Focused = True Then
                                'stavi focus na prvi
                                'SendKeys.Send("{TAB}")
                                'MORA OVAKO DOKAZ PROBNIPOPIS
                                Me.SelectNextControl(ActiveControl, True, True, True, True)
                            End If
                            'Exit For
                        Else
                            If k.AccessibleDescription Is Nothing Then k.AccessibleDescription = ""
                            If k.AccessibleName Is Nothing Then k.AccessibleName = ""

                            Dim kk() As String = k.AccessibleDescription.Split(";")
                            Dim krbr As Integer   'NE SME =0 dugme ostane enabled
                            If IsNumeric(kk(0)) Then krbr = kk(0)

                            If pprbr < krbr AndAlso krbr < nizskociNAsssrbr Then
                                If skippedEnabledFalse = True AndAlso Mid(k.Name, 1, 1) <> "F" Then k.Enabled = False
                                If skippedVisibleFalse = True Then k.Visible = False
                                If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                    Call addSHH(k, nizskociAKOsss)
                                    bbioskippedDontSave = True
                                End If
                                If skippedSetEmpty = True AndAlso azSE = 0 AndAlso Not TypeOf k Is Panel AndAlso Not TypeOf k Is Button AndAlso Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel AndAlso Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is DataGridView2 AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                    k.Text = ""
                                    Me.UpisiPolje(k.Name.Substring(2), , "PP_VALIDATING", cntl.Parent)
                                    Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                                End If
                            ElseIf krbr > nizskociNAsssrbr Then
                                If Mid(k.Name, 1, 1) <> "F" Then
                                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                        k.Enabled = False 'da ostanu RRO; i RO;
                                    Else
                                        k.Enabled = True 'da ostanu fp
                                    End If
                                End If

                                If Mid(k.Name, 1, 1) = "F" Then
                                    If k.Tag.izraz = "''" Then k.Visible = False
                                    If k.Tag.izraz <> "''" AndAlso Not (Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("VF;") >= 0) Then k.Visible = True
                                End If

                                imareset = True
                            End If
                        End If '2
                    ElseIf TypeOf k Is Button AndAlso k.Name.Length > 8 AndAlso Mid(k.Name, 1, 8) = "DBTNPANE" Then
                        'dugmepanetab.Name = "DBTNPANE" & t.Trim.ToUpper
                        If k.Enabled = False Then
                            k.Enabled = True
                            If pom = 0 Then
                                'samo jednom treba da se pozove inace radi bespotrebno koliko ima tabela
                                Call dpcpanel(nizPanela(0), 1)
                                pom = 1
                            End If
                        End If
                    Else
                        'nista
                    End If '1
                    k = panel.GetNextControl(k, True) 'Get the next control in the tab order.
                    'Loop
                Next

                If imareset = True Then
                    If Not nizdugmeTab Is Nothing Then Call defaultZaTabDugmad()
                End If

                If nizskociNAsss = "DUGMEDALJE" OrElse nizskociNAsss = "BUTTONNEXT" Then
                    Me.BtnSaveNext.Focus()
                ElseIf nizskociNAsss.Trim.ToUpper = "DUGMESACUVAJ" OrElse nizskociNAsss.Trim.ToUpper = "BUTTONSAVE" Then
                    Me.BtnSave1.Focus()
                End If
            End If 'nastaskace

            sskoci2 = True
        End If 'a=1
    End Function

    Function sskoci2CATI(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal nizskociNAsss As String, ByVal nizskociAKOsss As String,
Optional ByVal skippedEnabledFalse As Boolean = False, Optional ByVal skippedSetEmpty As Boolean = False,
Optional ByVal skippedVisibleFalse As Boolean = False, Optional ByVal skippedDontSave As Boolean = False,
Optional ByVal ctrt As Boolean = False) As Control

        Dim grupa As String = ""
        Dim pomocno As Boolean = False
        If cntl.Name.Trim.ToUpper.IndexOf("POMOCNO_") >= 0 Then
            grupa = cntl.Name.Trim.ToUpper.Replace("POMOCNO_", "")
            pomocno = True   'skacem sa pomocnog polja za grupu (pomocno_G2)
        End If

        Dim trtrbr As Integer = 0
        If Not cntl.AccessibleDescription Is Nothing Then trtrbr = cntl.AccessibleDescription.Split(";")(0)

        sskoci2CATI = Nothing

        Dim nizskociNAsssrbr As Integer = 0

        For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
            Dim isk As Integer = 0
            For Each k As Control In grupePitanjaCATI(i).Controls
                If (TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) <> "F") Then
                    If Mid(k.Name, 3).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                        Dim kk() As String = k.AccessibleDescription.Split(";")
                        Dim krbr As Integer = kk(0)
                        nizskociNAsssrbr = krbr
                        isk = 1
                        Exit For
                    End If
                End If
            Next
            If isk = 1 Then Exit For
        Next

        Dim zzz As String = ""
        If SCati = True Then
            If ctrt = False AndAlso nizskociAKOsss.Trim.ToUpper.IndexOf("POMOCNO") < 0 Then
                zzz = sracScati(nizskociAKOsss, plj, cntl)
            Else
                zzz = sracscatictrt(nizskociAKOsss, plj, cntl)
            End If
        End If
        Dim a As Integer = scompute(zzz, plj, "skipif")       '1 TRUE, 0 FALSE
        'ispunjen USLOV
        If a = 1 Then
            If nizskociNAsss = "DUGMEDALJE" OrElse nizskociNAsss = "BUTTONNEXT" Then
                BtnSaveNext.Enabled = True
                BtnSaveNext.Focus()
            ElseIf nizskociNAsss = "KRAJINTERVJUA" OrElse nizskociNAsss = "ENDOFINTERVIEWING" Then
                Dim nc As New Control
                nc.Name = "ENDOFINTERVIEWING"
                sskoci2CATI = nc
            Else
                'moze i za prazno AND ispunjen USLOV, u uslovu stavi da nije praznol
                'obicno polje
                If okvalidacija = False Then
                    sskoci2CATI = Nothing
                    cntl.Focus()
                    Exit Function
                End If
                If okvalidacija = True Then
                    For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                        For Each k As Control In grupePitanjaCATI(i).Controls
                            If (TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) <> "F") Then
                                If Mid(k.Name, 3).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                                    k.Visible = True
                                    If Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1) AndAlso k.Tag <> "" Then
                                        Dim rtb As pomTextBox = NadjiKontrolu(grupePitanjaCATI(i), "pomocno" & "_" & k.Tag)
                                        rtb.Enabled = True
                                        If Not rtb Is Nothing Then sskoci2CATI = rtb
                                    Else
                                        k.Enabled = True
                                        sskoci2CATI = k
                                    End If
                                Else
                                    'treba ponistiti sve između plj i nizskociNAsss (ako je nizskociNAsss nije dugme ili panel)
                                    Dim kk() As String = k.AccessibleDescription.Split(";")
                                    Dim krbr As Integer = kk(0)
                                    If trtrbr < krbr AndAlso krbr < nizskociNAsssrbr Then
                                        If skippedEnabledFalse = True Then k.Enabled = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 3)  'ovim oznacavam koja kontrola ga je bacila u enable
                                        If skippedVisibleFalse = True Then k.Visible = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 3)  'ovim oznacavam koja kontrola ga je bacila u visiblefalse
                                        If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                            'k.AccessibleName = k.AccessibleName + "SHH;"
                                            Call addSHH(k, nizskociAKOsss)
                                            bbioskippedDontSave = True
                                        End If

                                        If skippedSetEmpty = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                                            'ponistavanja

                                            If pomocno = True AndAlso Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1) AndAlso k.Tag.trim.toupper = grupa.Trim.ToUpper Then
                                                'ako je HH od polja sa koga skacemo
                                            Else
                                                k.Text = ""
                                            End If

                                            If k.Name.Trim.ToUpper.IndexOf("POMOCNO_") >= 0 Then
                                            Else
                                                Me.UpisiPolje(k.Name.Substring(2), , "PP_VALIDATING")
                                            End If

                                            If Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1) Then
                                                If Mid(k.Tag, 1, 1) = "G" Then
                                                    Call odcekirajGrupuCHScati(k)
                                                End If
                                            End If
                                            If kk.Length > 1 AndAlso kk(1).Trim.ToUpper.IndexOf("RG") >= 0 Then
                                                Dim pp As Panel = k.Parent
                                                Dim imeP As String = pp.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
                                                Dim pppom As Panel = NadjiKontrolu(Me, imeP)
                                                For Each c As Control In pppom.Controls
                                                    If TypeOf c Is Panel AndAlso Mid(c.Name.Trim.ToUpper, 1, 2) = "RG" AndAlso Mid(c.Name.Trim.ToUpper, 3) = Mid(k.Name.Trim.ToUpper, 3) Then
                                                        Call PonistiRadio(c)
                                                        Exit For
                                                    End If
                                                Next
                                            End If
                                        End If
                                        'k.Enabled = False
                                    ElseIf krbr > nizskociNAsssrbr Then
                                        If (k.Tag Is Nothing) AndAlso k.Tag = "" Then k.Enabled = True
                                        If Not (k.Tag Is Nothing) AndAlso TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1 Then k.Enabled = True 'polje sa relacijom
                                        If k.Tag <> "" AndAlso k.Tag.length > 0 AndAlso Mid(k.Tag, 1, 1) <> "G" Then k.Enabled = True
                                        If k.Tag <> "" AndAlso k.Tag.length > 0 AndAlso Mid(k.Tag, 1, 1) = "G" Then
                                            Dim rtb As pomTextBox = NadjiKontrolu(grupePitanjaCATI(i), "pomocno" & "_" & k.Tag)
                                            rtb.Enabled = True
                                        End If
                                        'enabluj sva polja posle onog na koje skaces a koje je manje od potencijalno najveceg polja na koje možeš da skočiš odavde
                                        'I KOJA NISU ZATVORENA NEKIM DRUGIM PRAVILOM (SKOKOM)
                                        If k.AccessibleDefaultActionDescription = Mid(cntl.Name, 3) Then
                                            If skippedVisibleFalse = True Then k.Visible = True
                                            If Mid(k.Name, 1, 1) <> "F" Then
                                                If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                                    k.Enabled = False 'da ostanu RRO; i RO;
                                                ElseIf Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1) AndAlso Mid(k.Tag, 1, 1) = "G" Then
                                                    'HH ovi, nikako disable
                                                    k.Enabled = False
                                                Else
                                                    k.Enabled = True 'da ostanu fp
                                                End If
                                            End If
                                        Else
                                            'zatvorena akcijom sa nekog drugog polja, ne diraj
                                        End If
                                    End If 'If trtrbr < krbr AndAlso krbr < nizskociNAsssrbr Then

                                End If
                            End If
                        Next
                    Next

                End If 'if okvalidacija=true
            End If 'nastaskace

        End If 'a=1
    End Function

    Function sskoci2CATIORIGINAL(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal nizskociNAsss As String, ByVal nizskociAKOsss As String,
Optional ByVal skippedEnabledFalse As Boolean = False, Optional ByVal skippedSetEmpty As Boolean = False,
Optional ByVal skippedVisibleFalse As Boolean = False, Optional ByVal skippedDontSave As Boolean = False,
Optional ByVal ctrt As Boolean = False) As Control

        sskoci2CATIORIGINAL = Nothing
        Dim zzz As String = ""
        If SCati = True Then
            If ctrt = False Then
                zzz = sracScati(nizskociAKOsss, plj, cntl)
            Else
                zzz = sracscatictrt(nizskociAKOsss, plj, cntl)
            End If
        End If
        Dim a As Integer = scompute(zzz, plj, "skipif")       '1 TRUE, 0 FALSE
        'ispunjen USLOV
        If a = 1 Then
            If nizskociNAsss = "DUGMEDALJE" OrElse nizskociNAsss = "BUTTONNEXT" Then
                BtnSaveNext.Enabled = True
                BtnSaveNext.Focus()
            ElseIf nizskociNAsss = "KRAJINTERVJUA" OrElse nizskociNAsss = "ENDOFINTERVIEWING" Then
                Dim nc As New Control
                nc.Name = "ENDOFINTERVIEWING"
                sskoci2CATIORIGINAL = nc
            Else
                If okvalidacija = False Then
                    sskoci2CATIORIGINAL = Nothing
                    cntl.Focus()
                    Exit Function
                End If
                'moze i za prazno AND ispunjen USLOV, u uslovu stavi da nije praznol
                If okvalidacija = True Then
                    Dim p As Panel = cntl.Parent
                    For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                        For Each k As Control In grupePitanjaCATI(i).Controls
                            If (TypeOf k Is TextBox AndAlso Mid(k.Name, 1, 1) <> "F") OrElse TypeOf k Is ComboBox Then
                                If Mid(k.Name, 3).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                                    If Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is IstrazivanjaUnos.SveZaPolje1) AndAlso k.Tag <> "" Then
                                        Dim rtb As pomTextBox = NadjiKontrolu(grupePitanjaCATI(i), "pomocno" & "_" & k.Tag)
                                        rtb.Enabled = True
                                        If Not rtb Is Nothing Then
                                            sskoci2CATIORIGINAL = rtb
                                        End If
                                    Else
                                        k.Enabled = True
                                        sskoci2CATIORIGINAL = k
                                    End If
                                End If
                            End If
                        Next
                    Next
                End If 'if SCAti=true
            End If 'nastaskace

        End If 'a=1
    End Function

    Function scompute(ByVal zzz As String, ByVal plj As String, ByVal fwhere As String) As Integer
        zzz = zzz.Replace("N'", "'")
        zzz = razCASTi(zzz,, plj)
        scompute = 0
        Dim xxx As Object
        Try
            Dim pom As String = "IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
            Dim tbl As DataTable = New DataTable()
            xxx = NZ(tbl.Compute(pom, Nothing))
        Catch ex As Exception
            Dim msg As String = "Syntax for " & plj & " in " & fwhere.Trim.ToUpper & " is not correct" 'getMessageText(dtMessages, "21", Me.jezik)
            ISTMessageBox.Show(msg + nvrd + ex.Message, msg + ":" + fwhere.Trim.ToUpper, MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            xxx = 0
        End Try
        scompute = CInt(xxx)

        'moze i
        'Dim xxx as Object as Object = NZ(New DataTable().Compute("IIF (" + CStr(zzz).Trim.ToUpper.Replace("D.", "") + ", 1, 0)", Nothing))
    End Function

    Sub odcekirajGrupuCHScati(ByVal k As TextBox)

        Dim p As Panel = k.Parent
        Dim imeP As String = p.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
        Dim pppom As Panel = NadjiKontrolu(Me, imeP)

        'da ponisti sve TB koji pokrivaju chechbox
        Dim grupa As String = k.Name.Trim.ToUpper.Replace("POMOCNO_", "")
        Dim chP() As String = kojeugrupi(nizCHB, grupa)
        For j As Integer = 0 To chP.GetUpperBound(0)
            Dim tb As TextBox = NadjiKontrolu(k.Parent, "TP" & chP(j))
            If k.Text = "" Then
                tb.Text = ""
                Dim pljplj As String = Mid(tb.Name.Trim.ToUpper, 3)
                Me.UpisiPolje(pljplj, "", "TP_VALIDATING",, Nothing, Nothing)
            End If
        Next

        For Each c As Control In pppom.Controls
            If TypeOf c Is CheckBox AndAlso CType(c, CheckBox).Tag = grupa Then
                CType(c, CheckBox).Checked = False
            End If
        Next
    End Sub

