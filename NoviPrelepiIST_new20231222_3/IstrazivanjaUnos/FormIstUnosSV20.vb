    Function lastInPanel(panelName As String) As String
        'poslenje u panelu, a da je normalno polje, tj textbox ili combo ili remark
        lastInPanel = ""
        Dim a() As String = poslednjiuPanelu.Split(";")
        For i As Integer = 0 To a.GetUpperBound(0)
            If a(i).Split("$")(0).ToUpper = panelName.ToUpper Then
                lastInPanel = a(i).Split("$")(1).Trim.ToUpper
                Exit For
            End If
        Next
        Return lastInPanel
    End Function

    Function firstInPanel(panelName As String) As String
        'prvo u panelu, a da je normalno polje, tj textbox ili combo
        firstInPanel = ""
        Dim a() As String = prviuPanelu.Split(";")
        For i As Integer = 0 To a.GetUpperBound(0)
            If a(i).Split("$")(0).ToUpper = panelName.ToUpper Then
                firstInPanel = a(i).Split("$")(1).Trim.ToUpper
                Exit For
            End If
        Next
        Return firstInPanel
    End Function

    Function puf(tabela As String) As Integer
        puf = -100
        Dim a() As String = poslednjinaFormi.Split(";")
        For i As Integer = 0 To a.GetUpperBound(0)
            If a(i).Split("$")(0).ToUpper = tabela.ToUpper Then
                puf = a(i).Split("$")(1).Trim
                Exit For
            End If
        Next
        Return puf
    End Function

