    Sub addROWSPanel(ByVal btn As Button, ByVal tabela As String)

        Dim KljuceviPanel() As String = {}
        KljuceviPanel = DajKljuceve(tabela)

        Dim addrows() As String = {}
        Dim addrowsif() As String = {}
        Dim pp() As String = {}
        Dim toWhat() As String = {}
        Dim a() As Integer = {}
        Dim pppom() As String = {}

        Dim prp() As String = btn.AccessibleDescription.Split(";")
        Dim ind As Integer = -1
        Dim indif As Integer = -1
        For i As Integer = 0 To prp.GetUpperBound(0)
            If prp(i).Trim.ToUpper.IndexOf("ADDROWSTO") >= 0 Then
                ind = ind + 1
                ReDim Preserve addrows(ind)
                ReDim Preserve a(ind)
                ReDim Preserve pp(ind)
                addrows(ind) = prp(i).Trim.ToUpper
            End If
            If prp(i).Trim.ToUpper.IndexOf("ADDROWSIF") >= 0 Then
                indif = indif + 1
                ReDim Preserve addrowsif(indif)
                addrowsif(indif) = prp(i).Trim.ToUpper
            End If
        Next

        If Not addrows Is Nothing AndAlso addrows.Length > 0 Then
            For i As Integer = 0 To addrows.GetUpperBound(0)
                If addrows(i).IndexOf("VALUES") < 0 Then
                    MsgBox("Syntax for addrowsTo is not valid!" +
                    nvrd + nvrd + "Rows are not added!!!!", vbInformation, "")
                    addrows(i) = ""
                    Exit Sub
                Else
                    'addRowsToTRACE2(god,POCETNI_H990099,rbr,P010100,P990099)values(god,POCETNI_H990099,rbr,ime,P990099)
                    addrows(i) = addrows(i).Replace("ADDROWSTO", "").Replace("VALUES", "$")
                    'TRACE2(GOD, POCETNI_H990099, RBR, P010100, P990099)$(GOD,POCETNI_H990099,RBR,IME,P990099)
                    pppom = addrows(i).Split("$")
                    ReDim Preserve toWhat(i)
                    toWhat(i) = Mid(pppom(0), 1, pppom(0).IndexOf("("))   'TRACE2
                    pppom(0) = pppom(0).Replace(toWhat(i), "").Replace("(", "").Replace(")", "") 'GOD, POCETNI_H990099, RBR, P010100, P990099
                    pppom(1) = pppom(1).Replace("(", "").Replace(")", "") 'GOD,POCETNI_H990099,RBR,IME,P990099
                    ReDim Preserve pp(i)
                    pp(i) = pppom(0) + "$" + pppom(1)

                    Dim arif As String = ""
                    If addrowsif(i) Is Nothing AndAlso addrowsif(i) = "" Then
                        arif = "ADDROWSIF=2=2"
                    Else
                        arif = addrowsif(i)
                    End If

                    arif = arif.Trim.ToUpper.Replace("ADDROWSIF=", "").Replace("}", "")
                    Dim sql As String = " 2=2 "
                    For m As Integer = 0 To DGTabele(DGi(tabela)).Rows.Count - 1
                        'kljuc
                        sql = " 2=2 "
                        For ik As Integer = 0 To KljuceviPanel.GetUpperBound(0)
                            sql = sql + " and " + KljuceviPanel(ik) & " ='" & DGTabele(DGi(tabela)).Rows(m).Item(KljuceviPanel(ik)).ToString & "'"
                        Next
                        'ispunjen uslov baš za ovaj red? DGTabele(DGi(tabela)).Rows(m)
                        Dim zzz As String = sracDTBL(arif, m, DGTabele(DGi(tabela)))
                        zzz = razCASTi(zzz)
                        a(i) = scompute(zzz, btn.Name, "ADDROWSIF")

                        If a(i) = 1 Then 'ispunjen uslov dodaj red ako ne postoji ili ga update ako postoji
                            'da li postoji u toWHAT KLJUC MORA DA BUDE ISTI, TJ ISTA POLJA
                            If DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='")).Length > 0 AndAlso DGTabele(DGi(toWhat(i))).Select(sql.Replace("=N'", "='")).Length = 0 Then
                                Call addNR(tabela, pppom(0), pppom(1), sql, toWhat(i))
                            Else
                                Call updateNR(tabela, pppom(0), pppom(1), sql, toWhat(i))
                            End If
                        ElseIf a(i) = 0 AndAlso DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='")).Length > 0 Then   'nije ispunjen uslov za dodavanje, ako postoji ide brisanje
                            Call deleteNR(tabela, pppom(0), pppom(1), sql, toWhat(i))
                        End If
                    Next
                End If
            Next
        End If
    End Sub

    Sub addNR(ByVal tabela As String, ByVal pp0 As String, ByVal pp1 As String, ByVal sql As String, ByVal toWhat As String)
        Dim fields() As String = pp0.Split(",")
        Dim values() As String = pp1.Split(",")

        Dim drr() As DataRow = DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))
        Dim dr As DataRow = drr(0)
        Dim dtrow As DataRow = DGTabele(DGi(toWhat, DGTabele)).NewRow()
        For i As Integer = 0 To fields.GetUpperBound(0)
            If values(i).Trim.IndexOf("'") = 0 OrElse IsNumeric(values(i)) = True Then
                dtrow(fields(i)) = values(i)
            Else
                dtrow(fields(i)) = dr(values(i))
            End If
        Next
        DGTabele(DGi(toWhat, DGTabele)).Rows.Add(dtrow)
        Dim uspelo As Boolean = InsertNOVO(True, toWhat, sql)
        If uspelo = False Then
            ISTMessageBox.Show("There is error in adding row in panel for immediately saveing, plase call IT!")
        End If
    End Sub

    Sub updateNR(ByVal tabela As String, ByVal pp0 As String, ByVal pp1 As String, ByVal sql As String, ByVal toWhat As String)
        Dim fields() As String = pp0.Split(",")
        Dim values() As String = pp1.Split(",")

        Dim drr() As DataRow = DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))
        Dim dr As DataRow = drr(0)

        Dim drrtoWhat() As DataRow = DGTabele(DGi(toWhat, DTbl)).Select(sql.Replace("=N'", "='"))
        Dim drtoWhat As DataRow = drrtoWhat(0)
        Dim upit As String = "update " + toWhat + " set "
        Dim nizklj() As String = DajKljuceve(toWhat)
        For i As Integer = 0 To fields.GetUpperBound(0)
            Dim ind As Integer = Array.IndexOf(nizklj, fields(i))
            If ind < 0 Then
                If IsNumeric(values(i)) = True OrElse values(i).ToString.Trim.IndexOf("'") = 0 Then
                    drtoWhat(fields(i)) = values(i)
                Else
                    drtoWhat(fields(i)) = dr(values(i))
                End If
                upit = upit + CStr(fields(i)).Trim + " = N'" + CStr(drtoWhat(fields(i))).Trim + "',"
            End If
        Next
        upit = upit.TrimEnd(",") + " where " + sql
        Dim ok As String = izvrsiSQL(upit, Me.DBConnectionString)
        If ok = "nok" Then
            ISTMessageBox.Show(upit + nvrd + nvrd + "is not executed! ER80", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
        End If
    End Sub

    Sub deleteNR(ByVal tabela As String, ByVal pp0 As String, ByVal pp1 As String, ByVal sql As String, ByVal toWhat As String)
        Dim fields() As String = pp0.Split(",")
        Dim values() As String = pp1.Split(",")

        Dim drrtoWhat() As DataRow = DGTabele(DGi(toWhat, DTbl)).Select(sql.Replace("=N'", "='"))

        If drrtoWhat.Length > 0 Then
            DGTabele(DGi(toWhat, DTbl)).Rows.Remove(drrtoWhat(0))
        End If

        Dim sqlDelete As String = "delete from " + toWhat + " where " + sql & ";"
        Dim ok As String = izvrsiSQL(sqlDelete, Me.DBConnectionString)
        If ok <> "ok" Then
            ISTMessageBox.Show("There is error in deleting row in panel for immediately saving, plase call IT!", "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
        End If
    End Sub

    Function panelupisiUDGTabele(ByVal tabela As String, ByVal sql As String, ByVal panel As Panel, ByVal ppKLJ As String, Optional ByVal sqlKljuc As String = "") As String

        Dim iinsertPanel As Boolean = False
        Dim uupdatePanel As Boolean = False

        panelupisiUDGTabele = ""
        existChangeSomewhereInQuest = False

        'posto se radi o kljucu ne treba pustiti nista sto ima ='', tj preskociti i za upis i za update


        If DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='")).Length = 0 Then
            iinsertPanel = True
            'nov red
            DGTabele(DGi(tabela, DTbl)).ImportRow(DGTabelePanel(DGi(tabela)).Rows(0))
            DGTabeleOriginal(DGi(tabela, DTbl)).ImportRow(DGTabelePanel(DGi(tabela)).Rows(0))
            Try
                If Not (DGTabele(DGi(tabela, DTbl)).Columns("IST_DURATION") Is Nothing) Then
                    DGTabele(DGi(tabela, DTbl)).Rows(0).Item("IST_DURATION") = (DateTime.Now() - IstStart(DGi(tabela))).TotalSeconds
                End If
                existChangeSomewhereInQuest = True
                BarJedanExistChangeSomewhereInQuest = True
            Catch
                'existChangeSomewhereInQuest = False
            End Try

            Dim dg As DataGridView = NadjiKontrolu(Panel1, tabela)
            If Not dg Is Nothing Then Call srediGridView(dg, True, 30)
            panelupisiUDGTabele = DGTabele(DGi(tabela, DTbl)).Rows.Count
        Else
            'vec postojeci
            uupdatePanel = True
            For Each r As DataColumn In DGTabelePanel(DGi(tabela)).Columns
                If (DGTabele(DGi(tabela)).Columns.Contains("ISTNOTE")) Then
                    DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item("ISTNOTE") = DGTabelePanel(DGi(tabela)).Rows(0).Item("ISTNOTE")
                End If

                For Each k As Control In panel.Controls
                    If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 1, 1).Trim.ToUpper <> "F" AndAlso Mid(k.Name, 4).Trim.ToUpper = r.ColumnName.Trim.ToUpper Then
                        If k.AccessibleName Is Nothing OrElse k.AccessibleName.IndexOf("SHH;") < 0 Then
                            Dim aa As String = IIf(Convert.IsDBNull(DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName)), "", DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName)).ToString.Trim.ToUpper
                            Dim bb As String = IIf(Convert.IsDBNull(DGTabelePanel(DGi(tabela)).Rows(0).Item(r.ColumnName)), "", DGTabelePanel(DGi(tabela)).Rows(0).Item(r.ColumnName)).ToString.Trim.ToUpper
                            If aa <> bb Then
                                DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName) = DGTabelePanel(DGi(tabela)).Rows(0).Item(r.ColumnName)
                                existChangeSomewhereInQuest = True
                                BarJedanExistChangeSomewhereInQuest = True
                            End If
                            'vrednost poslednjeg polja u kljucu
                            If Mid(k.Name, 4).Trim.ToUpper = ppKLJ Then
                                panelupisiUDGTabele = DGTabelePanel(DGi(tabela)).Rows(0).Item(r)
                            End If
                        End If

                        If Mid(k.Name, 1, 3).Trim.ToUpper <> "DTK" AndAlso Mid(k.Name, 1, 3).Trim.ToUpper <> "DCK" Then
                            If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("SHH;") >= 0 Then
                                'anuliranje
                                DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName) = CType(DBNull.Value, Object) 'System.DBNull.Value
                                existChangeSomewhereInQuest = True
                                BarJedanExistChangeSomewhereInQuest = True
                            End If
                        End If

                    End If
                Next

                If r.ColumnName.Trim.ToUpper = "IST_DURATION" Then
                    If Convert.IsDBNull(DGTabele(DGi(tabela)).Select(sql)(0).Item(r.ColumnName)) = True Then
                        DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName) = 0
                    End If
                    DGTabele(DGi(tabela)).Select(sql.Replace("=N'", "='"))(0).Item(r.ColumnName) += (DateTime.Now() - IstStart(DGi(tabela))).TotalSeconds
                End If
            Next
        End If

        Me.PAMTINovoPanel(panel, tabela, sqlKljuc, DGTabelePanel(DGi(tabela)).Rows(0), True, iinsertPanel, uupdatePanel)   'nije sa zatvaranjem

    End Function

    Function resetAndLoopPK(ByVal btn As Button, ByVal panel As Panel, ByVal tabela As String, ByVal vredppKLJ As String,
ByVal ppKLJ As String, ByVal autoList As Boolean, ByVal autoListBy As String, ByVal autoListByTO As String, ByVal panel11 As Boolean) As String

        Dim ende As String = ""
        ende = SKIPOnClick(btn.AccessibleName, panel)   'vraca na sta treba da se skoci ako je ispunjen uslov, inace  vraca ""

        If panel11 = False Then
            Call IsprazniKontrolePanel(panel, 1)
            DGTabelePanel(DGi(tabela)).Clear()
        End If

        For Each c As Control In panel.Controls
            If c.Name.Substring(0, 3).ToUpper = "DTP" Or c.Name.Substring(0, 3).ToUpper = "DCB" Or c.Name.Substring(0, 3).ToUpper = "DUP" Then
                c.BackColor = SystemColors.ControlLightLight
                c.Enabled = True
            End If
        Next

        If ende = "" Then
            If IsNumeric(vredppKLJ) = False Then vredppKLJ = ""
            If vredppKLJ = "" Then vredppKLJ = "1"

            If autoList = True Then

                If autoListByTO <> "" Then
                    'autoListTo#FP{fprbr}
                    autoListByTO = autoListByTO.Trim.ToUpper.Replace("AUTOLISTTO", "")
                    If CStr(autoListByTO).Trim.ToUpper.IndexOf("GLAVA.") = 0 OrElse CStr(autoListByTO).Trim.ToUpper.IndexOf("HEAD.") = 0 Then 'oblik je GLAVA.polje - pandan D.polje
                        Dim plj As String = autoListByTO.Replace("GLAVA.", "").Replace("HEAD.", "").Trim.ToUpper
                        'saekrana
                        autoListByTO = SE(plj, , Me.Panel1).Trim
                    ElseIf autoListByTO.Trim.IndexOf("#FP{") = 0 Then
                        autoListByTO = autoListByTO.Replace("}", "")
                        autoListByTO = "" + SP(autoListByTO.Substring(4), panel, True).Trim + ""
                    ElseIf SP(autoListByTO, panel).Trim = "" Then
                    Else
                        autoListByTO = "" + SP(autoListByTO, panel).Trim + ""
                    End If
                End If
                vredppKLJ = vredKljucaPanelAutoListNext(tabela, autoListBy, autoListByTO, vredppKLJ)
                Call PopuniJosZaPoljaPanel(tabela, panel, True, vredppKLJ, True)
            Else
                Call PopuniJosZaPoljaPanel(tabela, panel)
            End If

            If plusPK Then
                KljucNFocusPanel(panel, ppKLJ)
                Polje1FocusPanel(panel)
            Else
                Kljuc1FocusPanel(panel)
            End If

            'osvezi ako ima na glavnoj formi nesto sa MEM
            PreracunajFP("FPMEM")

            If autoList = True Then
                SendKeys.Send("{TAB}")
            End If
        End If

        resetAndLoopPK = ende

    End Function

    Private Function vredKljucaPanelAutoList(ByVal tabela As String, ByVal autoListBy As String) As String
