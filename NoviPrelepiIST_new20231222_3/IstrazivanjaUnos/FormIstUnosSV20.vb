    Sub newOstalaPodesavanja(ByVal izazur As Boolean,
        ByVal zakljucan As Boolean, ByVal zakljucanOdmahSve As Boolean, ByVal azklj(,) As String, Optional ByVal odakle As Integer = 0,
        Optional ByVal modereplacementCATI As String = "", Optional ByVal dtJson As DataTable = Nothing,
        Optional ByVal izDataGridView As Boolean = False, Optional ByVal imag As Boolean = True, Optional ByVal imam As Boolean = True)

        Dim kklljjuuccii(,) As String
        kklljjuuccii = azklj
        'MORA OVAJ DEO, INACE NE RADE PODTABELE
        If Me.postojiSlog AndAlso izazur = False And nadtabela <> "" Then
            ELGaIma(GlavnaTabela, False)
        End If
        If izazur AndAlso dosaoIzCapiAdresara = False Then
            ELGaIma(GlavnaTabela, False)
            azklj = Nothing
        End If


        'MORA OVAJ DEO, INEACE NE RADE PODTABELE
        Dim mklj As Boolean = False
        For Each JzP As JosZaPolje1 In JosZaPoljaK
            If (SEK(JzP.Polje) Is Nothing) OrElse (SEK(JzP.Polje).Trim) = "" Then
                If JzP.vrednost <> "" Then NaE(JzP.Polje, JzP.vrednost, mklj)
            End If
        Next

        If SCati = False Then
            For Each JzP As JosZaPolje1 In JosZaPolja
                If (SE(JzP.Polje) Is Nothing) OrElse (SE(JzP.Polje).Trim) = "" _
                        OrElse SE(JzP.Polje) = "False" Then 'zbog checkBox-a
                    If JzP.vrednost <> "" Then NaE(JzP.Polje, JzP.vrednost, mklj)
                End If
            Next

            If Not dtJson Is Nothing AndAlso dtJson.Rows.Count > 0 Then
                'popuni kljuc
                Call fillFromJsonPK(dtJson)
            End If
        Else
            For Each JzP As JosZaPolje1 In JosZaPolja
                For ii As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                    Dim cntl As Control = NadjiKontroluSkr(grupePitanjaCATI(ii), JzP.Polje, 2)
                    If (SE(JzP.Polje,, grupePitanjaCATI(ii)) Is Nothing) OrElse (SE(JzP.Polje,, grupePitanjaCATI(ii)).Trim) = "" OrElse SE(JzP.Polje,, grupePitanjaCATI(ii)) = "False" Then 'zbog checkBox-a
                        If JzP.vrednost <> "" Then NaE(JzP.Polje, JzP.vrednost, mklj, grupePitanjaCATI(ii))
                    End If
                Next
            Next

            If modereplacementCATI <> "" Then   'moguce zamene (domacinstva)
                Dim polje As String = modereplacementCATI.Substring(1)
                Dim vrednost As String = modereplacementCATI.Substring(0, 1)
                For ii As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
                    Dim cntl As Control = NadjiKontroluSkr(grupePitanjaCATI(ii), polje, 2)
                    If Not cntl Is Nothing Then
                        NaE(polje, vrednost, mklj, grupePitanjaCATI(ii))
                        Exit For
                    End If
                Next
            End If
        End If

        If zakljucanOdmahSve Then
            Call DisableZakljucanoSve(izazur)
        Else
            If zakljucan = True Then
                Call DisableSve(izazur)
            Else
                'ONI KOJI SU ZAKLJUCANI BICE DISEJBLOVANI
                If DGTabele(DGi(GlavnaTabela)).Rows.Count = 0 Then
                    'novo, mora na osnovu kljuca da se pogleda
                Else
                    If Not (DGTabele(DGi(GlavnaTabela)).Columns("LK") Is Nothing) AndAlso (Not (DGTabele(DGi(GlavnaTabela)).Rows(0).Item("lk").GetType Is GetType(System.DBNull))) AndAlso CBool(DGTabele(DGi(GlavnaTabela)).Rows(0).Item("lk")) = True Then
                        Call DisableSve(izazur)
                    Else
                        Dim zakljucanUnos As Integer = ProveraUnosLOCK()
                        If zakljucanUnos = 1 Then
                            Call DisableSve(izazur)
                        Else
                            Call EnableSve()
                        End If
                    End If
                End If
            End If
        End If

        dosaoIzAzur = izazur
        uradjenaLK = 0

        AddHandler AlwaysVisibleLabel.MouseDown, AddressOf Me.Control_MouseDown
        AddHandler AlwaysVisibleLabel.MouseUp, AddressOf Me.Control_MouseUp
        AddHandler QuestionExplanation.MouseDown, AddressOf Me.Control_MouseDown
        AddHandler QuestionExplanation.MouseUp, AddressOf Me.Control_MouseUp

        If pAWLnotmovable = False Then AddHandler AlwaysVisibleLabel.MouseMove, AddressOf Me.Control_MouseMove
        If pQEnotmovable = False Then AddHandler QuestionExplanation.MouseMove, AddressOf Me.Control_MouseMove

        If izscati = True AndAlso SCati = True AndAlso catipregled = False Then
            If odakle = 1 Then Call PopuniKljuc(kklljjuuccii)
            Call pkpk()
            SendKeys.Send("{Enter}")
            Me.BtnSaveNext.Visible = False
            Me.BtnSave1.Visible = False
            Me.btnDataValidation.Visible = False
            Me.gbLK.Visible = False
        End If

        If izscati = False AndAlso SCati = True AndAlso catipregled = True Then
            Me.BtnSaveNext.Visible = False
            Me.BtnSave1.Visible = False
            Me.btnDataValidation.Visible = False
            Me.gbLK.Visible = False
        End If

        If izscati = True AndAlso txtmode = "MIXMODE" Then
            'Call pkpk()
            Call PopuniKljuc(kklljjuuccii)
        End If

        If dosaoIzCapiAdresara OrElse izDataGridView = True Then
            'vec je popuinjen i zatvoren kljuc
            Call pkpk()
        End If

        For Each t As DatasetIstrazivanja.ISTTABELERow In dIst.ISTTABELE.Rows
            Dim tT1 As String = IIf(t.Item("T1") Is System.DBNull.Value, "", t.Item("T1"))
            Dim tab As String = IIf(t.Item("DG") Is System.DBNull.Value, "G", t.Item("DG"))
            If tab.Trim.ToUpper <> "S" AndAlso tT1.Trim.ToUpper.IndexOf("ISTVIEW") < 0 Then
                ReDim Preserve IstStart(DGi(t.Tabela))
                IstStart(DGi(t.Tabela)) = DateTime.Now()
            End If
        Next

        If (Me.postojiSlog AndAlso izazur = True) OrElse izscati = True Then
            IstStart(DGi(GlavnaTabela.Trim.ToUpper)) = DateTime.Now()
        End If

        If Not nizAUTBKontrola Is Nothing Then
            For i As Integer = 0 To nizAUTBKontrola.GetUpperBound(0)
                Dim actbox As AutoCompleteTextbox = DirectCast(nizAUTBKontrola(i), AutoCompleteTextbox)
                ReDim Preserve nizAUTBTOKontrola(i)
                ReDim Preserve nizAUTBTOKontrolaIme(i)
                If Not actbox.autoCompleteAssignTo Is Nothing AndAlso actbox.autoCompleteAssignTo.Trim.ToUpper <> "" Then
                    nizAUTBTOKontrolaIme(i) = actbox.autoCompleteAssignTo.Trim.ToUpper
                    'nizAUTBTOKontrola(i) = NadjiKontrolu(Panel, "TP" + actbox.autoCompleteAssignTo.Trim.ToUpper)
                    Dim ind As Integer = Array.IndexOf(nizTBKontrolaIme, "TP" + actbox.autoCompleteAssignTo.Trim.ToUpper)
                    If ind > -1 Then
                        nizAUTBTOKontrola(i) = nizTBKontrola(ind)
                    End If
                Else
                    nizAUTBTOKontrolaIme(i) = ""
                    nizAUTBTOKontrola(i) = Nothing
                End If

                actbox.nizACTBKontrola = nizAUTBKontrola
                actbox.nizACTBKontrolaIme = nizAUTBKontrolaIme
                actbox.nizACTBToKontrola = nizAUTBTOKontrola
                actbox.nizACTBToKontrolaIme = nizAUTBTOKontrolaIme

                Dim pom2 As Integer = Screen.PrimaryScreen.WorkingArea.Height - Me.Top - Me.Bounds.Y
                If i >= 1 Then
                    If nizAUTBKontrola(i).Parent.Name.Trim.ToUpper <> nizAUTBKontrola(i - 1).Parent.Name.Trim.ToUpper Then
                        Dim pom As Integer = nizAUTBKontrola(i - 1).Location.Y + nizAUTBKontrola(i - 1).Height + 13 * DirectCast(nizAUTBKontrola(i - 1), AutoCompleteTextbox).autoCompleteMaxDropDownItems
                        pom2 = pom2 - Me.Panel1.Location.Y
                        If nizAUTBKontrola(i - 1).Parent.Height < pom AndAlso pom2 > pom + 5 Then
                            nizAUTBKontrola(i - 1).Parent.Height = pom + 5
                        ElseIf nizAUTBKontrola(i - 1).Parent.Height < pom AndAlso pom2 <= pom + 5 Then
                            nizAUTBKontrola(i - 1).Parent.Height = pom2
                            DirectCast(nizAUTBKontrola(i - 1).Parent, Panel).AutoScroll = True
                            DirectCast(nizAUTBKontrola(i - 1).Parent, Panel).VerticalScroll.Visible = True
                        End If
                    End If
                End If
            Next
        End If

    End Sub
    Sub sklopiAWL(ByVal aaii As String)

        inlineAWL = False

        Dim fSize As Integer = 0
        Dim fBold As Boolean = False
        Dim fItalic As Boolean = False
        Dim fUnderline As Boolean = False

        Dim bb() As String = aaii.Split("$")
        For kk As Integer = 0 To bb.GetUpperBound(0)
            If bb(kk).Trim.ToUpper.IndexOf("ALWAYSVISIBLELABEL") >= 0 Then
                If bb(kk).Trim.ToUpper.IndexOf("INLINE") = 0 Then
                    inlineAWL = True
                Else
                    inlineAWL = False
                End If

                bb(kk) = NZ(Replace(bb(kk), "inlinealwaysvisiblelabelonfield", "", 1, , CompareMethod.Text)).Trim
                bb(kk) = NZ(Replace(bb(kk), "alwaysvisiblelabel", "", 1, , CompareMethod.Text)).Trim

                If Not bb Is Nothing AndAlso bb.Length > 0 AndAlso Not bb(kk) Is Nothing AndAlso bb(kk).IndexOf(",") > 0 Then
                    Dim cc() As String = bb(kk).Split(",")
                    '(X=60,Y=260)
                    For mm As Integer = 0 To cc.GetUpperBound(0)
                        cc(mm) = cc(mm).Replace("(", "").Replace(")", "")
                        If cc(mm).Trim.ToUpper.IndexOf("X=") = 0 Then
                            xx = cc(mm).Trim.ToUpper.Replace("X=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("Y=") = 0 Then
                            yy = cc(mm).Trim.ToUpper.Replace("Y=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("XG=") = 0 Then
                            xxG = cc(mm).Trim.ToUpper.Replace("XG=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("YG=") = 0 Then
                            yyG = cc(mm).Trim.ToUpper.Replace("YG=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("XGP=") = 0 Then
                            xxGP = cc(mm).Trim.ToUpper.Replace("XGP=", "")
                        End If
                        If cc(mm).Trim.ToUpper.IndexOf("YGP=") = 0 Then
                            yyGP = cc(mm).Trim.ToUpper.Replace("YGP=", "")
                        End If
                    Next
                End If
                Dim novoPomeriNaDoleZa As Integer = 40
                yy = yy + novoPomeriNaDoleZa
                yyG = yy + novoPomeriNaDoleZa
                yyGP = yy + novoPomeriNaDoleZa
                If xx <> -100 AndAlso yy <> -100 Then Me.AlwaysVisibleLabel.Location = New Point(xx, yy)
                If xxG <> -100 AndAlso yyG <> -100 Then Me.AlwaysVisibleLabel.Location = New Point(xxG, yyG)
            ElseIf bb(kk).Trim.ToUpper.IndexOf("D=") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "d=", "", 1, , CompareMethod.Text)).Trim
                AlwaysVisibleLabel.Text = ppom.Replace("'", "")
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FORECOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "forecolor", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" Then AlwaysVisibleLabel.ForeColor = Color.FromName(ppom)
            ElseIf bb(kk).Trim.ToUpper.IndexOf("BACKCOLOR") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "backcolor", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" Then AlwaysVisibleLabel.BackColor = Color.FromName(ppom)
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTBOLD") >= 0 Then
                fBold = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTUNDERLINE") >= 0 Then
                fUnderline = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTITALIC") >= 0 Then
                fItalic = True
            ElseIf bb(kk).Trim.ToUpper.IndexOf("FONTSIZE") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "fontsize", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" AndAlso IsNumeric(ppom) Then fSize = ppom
            ElseIf bb(kk).Trim.ToUpper.IndexOf("BORDER") >= 0 Then
                Dim ppom As String = NZ(Replace(bb(kk), "border", "", 1, , CompareMethod.Text)).Trim
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("fixedsingle") = 0 Then AlwaysVisibleLabel.BorderStyle = BorderStyle.FixedSingle
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("none") = 0 Then AlwaysVisibleLabel.BorderStyle = BorderStyle.None
                If ppom <> "" AndAlso ppom.ToLower.Trim.IndexOf("fixed3d") = 0 Then AlwaysVisibleLabel.BorderStyle = BorderStyle.Fixed3D
            ElseIf bb(kk).Trim.ToUpper.IndexOf("SIZE") >= 0 AndAlso bb(kk).Trim.ToUpper.IndexOf("FONTSIZE") < 0 Then
                Dim mm As String = bb(kk).Trim.ToUpper.Replace("SIZE", "").Replace("(", "").Replace(")", "")
                Dim mmp() As String = mm.Split(",")
                If mmp.Length = 2 Then
                    Me.AlwaysVisibleLabel.AutoSize = False
                    If IsNumeric(mmp(0)) = True Then
                        Me.AlwaysVisibleLabel.Width = mmp(0)
                    Else
                        Me.AlwaysVisibleLabel.AutoSize = True
                    End If
                    If IsNumeric(mmp(1)) = True Then
                        Me.AlwaysVisibleLabel.Height = mmp(1)
                    Else
                        Me.AlwaysVisibleLabel.AutoSize = True
                    End If
                Else
                    Me.AlwaysVisibleLabel.AutoSize = True
                End If
            End If

        Next

        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline

        'B I U
        If fBold = True And fItalic = True And fUnderline = True Then ft = ftB Or ftI Or ftU
        If fBold = True And fItalic = True And fUnderline = False Then ft = ftB Or ftI
        If fBold = True And fItalic = False And fUnderline = False Then ft = ftB
        If fBold = True And fItalic = False And fUnderline = True Then ft = ftB Or ftU
        If fBold = False And fItalic = True And fUnderline = True Then ft = ftI Or ftU
        If fBold = False And fItalic = False And fUnderline = True Then ft = ftU
        If fBold = False And fItalic = True And fUnderline = False Then ft = ftI

        If fSize = 0 Then fSize = 10
        AlwaysVisibleLabel.Font = New Font(Me.Font.Name, fSize, ft)

    End Sub

    Sub sklopiAWLPanel(ByVal panel As Panel, ByVal aat1ii As String, ByVal lblavl As Label, ByVal xxP As Integer, ByVal yyP As Integer)

        inlineAWLPanel = False

        Dim bb() As String = aat1ii.Split("$")
        For kk As Integer = 0 To bb.GetUpperBound(0)
            If bb(kk).Trim.ToUpper.IndexOf("ALWAYSVISIBLELABEL") >= 0 Then
                If bb(kk).Trim.ToUpper.IndexOf("INLINE") = 0 Then
                    inlineAWLPanel = True
                Else
                    inlineAWLPanel = False
                End If
                bb(kk) = NZ(Replace(bb(kk), "inlinealwaysvisiblelabelonfield", "", 1, , CompareMethod.Text)).Trim
                bb(kk) = NZ(Replace(bb(kk), "alwaysvisiblelabel", "", 1, , CompareMethod.Text)).Trim

                If Not bb Is Nothing AndAlso bb.Length > 0 AndAlso Not bb(kk) Is Nothing AndAlso bb(kk).IndexOf(",") > 0 Then
                    Dim cc() As String = bb(kk).Split(",")
                    '(X=60,Y=260)
                    xxP = cc(0).Trim.ToUpper.Replace("X=", "").Replace("(", "")
                    yyP = cc(1).Trim.ToUpper.Replace("Y=", "").Replace(")", "")
                End If

                lblavl.TabIndex = 100000002
                lblavl.Visible = False
                lblavl.AutoSize = True
                lblavl.Name = "AlwaysVisibleLabelPANEL" + panel.Name.ToUpper
                lblavl.Width = 86 : lblavl.Height = 14

                panel.Controls.Add(lblavl)
