        Dim bbb() As String = razkvantaj(nizbojiAKOsss)
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            If bbb(ll).Trim = plj Then
                'saekrana
                If SCati = False Then
                    If SE(plj,, cntl.Parent).Trim = "" Then
                        bbb(ll) = "Null"
                    Else
                        bbb(ll) = "'" + SE(plj,, cntl.Parent).Trim + "'"
                    End If
                End If

