            If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
                For i As Integer = 0 To dt.Rows.Count - 1
                    If dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "LBL" AndAlso dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "FP" Then
                        sqlDB = sqlDB + "ALTER TABLE " + pp(0).Trim + " DROP COLUMN " + dt.Rows(i).Item(0).ToString + ";" + nvrd
                        sqlDBDropTip = sqlDBDropTip + pp(0).Trim + ";" + dt.Rows(i).Item(0).ToString + "#"
                        DropTip = DropTip + "DROP" + "#"
                    End If
                Next
            End If

            Dim p1 As String = "nok"
            Dim p2 As String = "nok"

            If ist = True And db = False Then
                p2 = napraviBackUpizvrsiSQL(sqlI)
                If p2 = "nok" Then
                    ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Else
                    Call subREFRESH("C")
                End If
            End If
            If ist = True And db = True Then
                p1 = napraviBackUpizvrsiSQL(sqlI,, sqlDBDropTip.TrimEnd("#"), DropTip.TrimEnd("#"))
                If p1 = "nok" Then ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                p2 = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
                If p2 = "nok" Then ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                If p1 = "ok" AndAlso p2 = "ok" Then Call subREFRESH("C")
            End If
        End If
    End Sub

