    Function napraviBackUpizvrsiSQL(ByVal strI As String, Optional ByVal isttabele As String = "", Optional ByVal slqDBDropTip As String = "", Optional ByVal DBDropTip As String = "") As String
        If isttabele = "" Then isttabele = "ISTPOLJA"

        'Dim DBtxt As String = ""
        'If slqDBDropTip <> "" AndAlso DBDropTip <> "" Then
        '    slqDBDropTip = slqDBDropTip.TrimEnd("#")
        '    If DBDropTip = "DROP" Then
        '        DBtxt = dbBackUpFile(slqDBDropTip, "ADD", Me.DBConnectionString)
        '    ElseIf DBDropTip = "ADD" Then
        '        DBtxt = dbBackUpFile(slqDBDropTip, "DROP", Me.DBConnectionString)
        '    ElseIf DBDropTip = "ALTER COLUMN" Then
        '        DBtxt = dbBackUpFile(slqDBDropTip, "ALTER COLUMN", Me.DBConnectionString)
        '    ElseIf DBDropTip = "RENAME" Then
        '        DBtxt = dbBackUpFile(slqDBDropTip, "RENAME", Me.DBConnectionString)
        '    End If
        'End If
        Dim DBtxt As String = ""
        If slqDBDropTip <> "" AndAlso DBDropTip <> "" Then
            Dim pp() As String = slqDBDropTip.Split("#")
            Dim ppDrop() As String = DBDropTip.Split("#")
            If pp.Length <> ppDrop.Length Then
                ISTMessageBox.Show("napraviBackUpizvrsiSQLISTTABLES" + nvrd + nvrd + "pp<>ppdrop")
            End If
            For i As Integer = 0 To pp.GetUpperBound(0)
                pp(i) = pp(i).TrimEnd("#")
                If ppDrop(i) = "DROP" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "ADD", Me.DBConnectionString)
                ElseIf ppDrop(i) = "ADD" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "DROP", Me.DBConnectionString)
                ElseIf ppDrop(i) = "ALTER COLUMN" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "ALTER COLUMN", Me.DBConnectionString)
                ElseIf ppDrop(i) = "RENAME" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "RENAME", Me.DBConnectionString)
                ElseIf ppDrop(i) = "DROPTABLE" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "DROPTABLE", Me.DBConnectionString)
                ElseIf ppDrop(i) = "ADDPK" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "ADDPK", Me.DBConnectionString)
                ElseIf ppDrop(i) = "DROPCONSTRAINT" Then
                    DBtxt = DBtxt + dbBackUpFile(pp(i), "DROPCONSTRAINT", Me.DBConnectionString)
                End If
            Next
        End If

        Call BackUp(dIst, sifist, GlavnaTabela, param(isttabele), DBtxt, "UNOS")

        btnUndoVisible = True
        btnUndo.Visible = True
        btnRedoVisible = False
        btnRedo.Visible = False

        Dim p As String = "nok"
        strI = " begin transaction; " + nvrd + strI + nvrd + " commit;"
        p = izvrsiSQL(strI, Me.ISTConnectionString)
        'p = "ok"
        Return p
    End Function

    Sub subREFRESH(ByVal what As String, Optional ByVal odakle As String = "")
        If Me.refreshForm = True OrElse odakle = "btnRefresh" Then  'napravljen backUP na svaku promenu (funkcija napraviBackUpizvrsiSQL)
            Me.Close()
        Else
            Call puniDatasetIstrazivanja(sifist, vtvt, GlavnaTabela)
        End If
    End Sub
    Private Sub btnUndo_Click(sender As Object, e As EventArgs) Handles btnUndo.Click

        Dim pom As String = izKogFolderaFromBackUpReStack(-1, dIst, sifist, GlavnaTabela, Me.DBConnectionString)
        If pom <> "" Then
            Dim pp() As String = pom.Split(";")
            Dim imeFolderaIzKogaVracamo As String = pp(0)
            Dim undoVisible As Integer = CInt(pp(1))
            Dim redoVisible As Integer = CInt(pp(2))

            Me.btnRedo.Visible = True
            btnRedoVisible = True
            If undoVisible = "0" Then
                Me.btnUndo.Visible = False
                btnUndoVisible = False
            Else
                Me.btnUndo.Visible = True
                btnUndoVisible = True
            End If
            Call subRestore(vtvt, imeFolderaIzKogaVracamo, Me.ISTConnectionString, Me.DBConnectionString, "UNOS")
            If btnRefresh.Visible = True Then
                btnRefresh.PerformClick()
            Else
                Me.refreshForm = True
                Call subREFRESH("C")
            End If
        Else
            MsgBox("There is no Undo")
        End If

        'mora backup pre restora zbog redo ako je backUpRedo prazan
        'If broj = maxbroj Then Call BackUpRedo(dIst, sifist, GlavnaTabela)

    End Sub
    Private Sub btnRedo_Click(sender As Object, e As EventArgs) Handles btnRedo.Click

        Dim pom As String = izKogFolderaFromBackUpReStack(1)
        If pom <> "" Then
            Dim pp() As String = pom.Split(";")
            Dim imeFolderaIzKogaVracamo As String = pp(0)
            Dim undoVisible As Integer = CInt(pp(1))
            Dim redoVisible As Integer = CInt(pp(2))
            Me.btnUndo.Visible = True
            btnUndoVisible = True
            If redoVisible = "0" Then
                Me.btnRedo.Visible = False
                btnRedoVisible = False
            Else
                Me.btnRedo.Visible = True
                btnRedoVisible = True
            End If

            Call subRestore(vtvt, imeFolderaIzKogaVracamo, Me.ISTConnectionString, Me.DBConnectionString, "UNOS")
            If btnRefresh.Visible = True Then
                btnRefresh.PerformClick()
            Else
                Me.refreshForm = True
                Call subREFRESH("C")
            End If
        Else
            MsgBox("There is no Redo")
        End If
    End Sub
    Private Sub cbRAEC_CheckedChanged(sender As Object, e As EventArgs) Handles cbRAEC.CheckedChanged
        If Me.cbRAEC.Checked = True Then
            Me.btnRefresh.Visible = False
            Me.btnRefreshVisible = False
            Me.refreshForm = True
        Else
            Me.btnRefresh.Visible = True
            Me.btnRefreshVisible = True
            Me.refreshForm = False
        End If
    End Sub
