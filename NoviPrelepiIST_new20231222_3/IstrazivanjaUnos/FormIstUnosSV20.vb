                        'dodala nevena 20211102, falilo je za grupe
                        Dim cntlnizKome As String() = Split(nizdodeliKomesss.Trim.ToUpper, ",")
                        Dim pp As Panel = Me.Panel1
                        If Not grupePitanjaCAPI Is Nothing Then
                            Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cntlnizKome(cc).Trim.ToUpper)
                            If ind > -1 Then pp = nizKontrola(ind).Parent
                        End If

                        For Each k As Control In pp.Controls 'bilo Me.Panel1.Controls
                            If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 1) = "C" OrElse Mid(k.Name, 1, 1) = "F" Then
                                If Mid(k.Name, 3).Trim.ToUpper = tcntltnizKome(cc).Trim.ToUpper Then
                                    For Each kk As Control In tcntlt.Parent.Controls
                                        Dim prvi As String = nizdodeliStasss.Trim.Substring(0, 1)
                                        Dim poslednji As String = nizdodeliStasss.Substring(nizdodeliStasss.Length - 1, 1)
