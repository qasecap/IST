                                End If
                                If skippedVisibleFalse = True Then k.Visible = False : k.AccessibleDefaultActionDescription = Mid(cntl.Name, 4)  'ovim oznacavam koja kontrola ga je bacila u visiblefalse
                                If skippedDontSave = True AndAlso Mid(k.Name, 2, 1) <> "F" Then
                                    Dim autbtoPostoji As Boolean = False
