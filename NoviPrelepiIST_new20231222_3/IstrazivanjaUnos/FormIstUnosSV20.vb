                        podttt = podttt + t.Tabela.Trim.ToUpper + "#"
                        Exit For
                    End If
                End If
            Next

            Dim vju As Boolean = False
            For Each t As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
                If (Not t.IsT2Null) AndAlso t.Tabela.Trim.ToUpper = imeTabele Then
                    If t.T2.Trim.ToUpper.IndexOf("VIEW") > -1 Then
                        vju = True
                        Exit For
                    End If
                End If
            Next

            If gdeSamUGridu > -1 Then
                For i As Integer = 0 To Kljucevi.GetUpperBound(0)
                    KljuceviSaEkranaSaVrednostima(i, 0) = Kljucevi(i).Trim.ToUpper
                    KljuceviSaEkranaSaVrednostima(i, 1) = dgr.Rows(dgr.CurrentRow.Index).Cells(CType(dgr.DataSource, DataTable).Columns.IndexOf(Kljucevi(i).Trim.ToUpper)).Value.ToString
                Next
                KljuceviTabeleSavrednostima = KljuceviSaEkranaSaVrednostima
                For i As Integer = 0 To KljuceviNadtabele.GetUpperBound(0)
                    KljuceviNadtabeleSavrednostima(i, 0) = KljuceviNadtabele(i).Trim.ToUpper
