    Function dajbr(ByVal sifist As String, ByVal tabela As String, ByVal currentTab As Integer, ByVal currentred As Integer, ByVal currentkol As Integer, ByVal fforma As String, ByVal sta As String) As String()
        dajbr = Nothing
        Dim ss As String = ""
        'Dim fforma As String = ""
        If sta = "dodajred" Then
            ss = "f3"
            'fforma = cStr(currentTab).Trim + "." + cStr(currentred).Trim + ".%"
        End If
        If sta = "dodajkolonu" Then
            ss = "f2"
            'fforma = cStr(currentTab).Trim + ".%." + cStr(currentkol).Trim
        End If
        Dim sql As String = "select " + ss + " from vrepISTPolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and ltrim(rtrim(forma)) like '" + fforma + "' order by cast(" + ss + " as int)"
        Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Me.jezik)
        Dim abr As String = ""
        If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
            For i As Integer = 0 To dt.Rows.Count - 1
                abr = abr + dt.Rows(i).Item(ss).ToString.Trim + ";"
            Next
            abr = abr.TrimEnd(";")
            dajbr = abr.Split(";")
        End If
    End Function

    Function dajUniqueSufiks(ByVal sufiks As String, ByVal tabela As String, ByVal polje As String) As String
        Dim sql As String = ""
        Dim kon As Integer = 1
        For i As Integer = 1 To 100
            sql = "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME =N'" + tabela + "'   and  COLUMN_NAME=N'" + polje + "_" + CStr(i).Trim + "'"
            Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)
            If dt Is Nothing OrElse dt.Rows.Count = 0 Then
                kon = i
                Exit For
            End If
        Next
        dajUniqueSufiks = sufiks + CStr(kon).Trim
    End Function

