                        Me.Close()
                        IdeDalje = False
                    Else
                        If lokalno = False Then Call UpisiUISTLogKoriscenjaProcesa("DataEntry DialogResult ", "No table " + GlavnaTabela, msgtxt69)
                    End If
                End If
            End If
        End If



        'Ponovo unos?
        If IdeDalje Then onSaveNextDontClose = True
        If BezDalje = False AndAlso onSaveNextCloseIF = "" AndAlso onSaveNextDontClose = True Then
            If Uspelo Then
                For Each kk As Control In Me.Panel1.Controls
                    Dim plj As String = Mid(kk.Name.Trim.ToUpper, 3)
                    For Each JzP As JosZaPolje1 In JosZaPolja
                        If JzP.Polje = plj AndAlso (JzP.DG = "{P}" Or JzP.DG = "{+}" Or JzP.DG = "{+FPP}") Then JzP.vrednost = kk.Text
