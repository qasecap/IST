    Sub sskoci4(ByVal pageDownNA As String)
        If pageDownNA = "DUGMEDALJE" OrElse pageDownNA = "BUTTONNEXT" Then
            If SCati = True Then BtnSaveNext.Enabled = True
            BtnSaveNext.Focus()
        ElseIf pageDownNA.IndexOf("TABELA") = 0 Then
            'skace na dupe
            'pageDownNA = pageDownNA.Replace("TABELA", "BTN")
            pageDownNA = "BTN" + pageDownNA.Substring(6)
            If SCati = False Then
                For Each k As Control In Me.Panel1.Controls
                    If k.Name.Trim.ToUpper = pageDownNA.Trim.ToUpper Then
                        k.Focus()
                        Exit For
                    End If
                Next
            End If 'SCati = False
        ElseIf pageDownNA.IndexOf("TABLE") = 0 Then
            'skace na dupe
            'pageDownNA = pageDownNA.Replace("TABLE", "BTN")
            pageDownNA = "BTN" + pageDownNA.Substring(5)
            If SCati = False Then
                For Each k As Control In Me.Panel1.Controls
                    If k.Name.Trim.ToUpper = pageDownNA.Trim.ToUpper Then
                        k.Focus()
                        Exit For
                    End If
                Next
            End If 'SCati = False

        ElseIf pageDownNA.IndexOf("PANEL") = 0 Then
            'pageDownNA = pageDownNA.Replace("PANEL", "PANE_")
            pageDownNA = "PANE_" + pageDownNA.Substring(5)
            If SCati = False Then
                For Each k As Control In Me.Panel1.Controls
                    If k.Name.Trim.ToUpper = pageDownNA.Trim.ToUpper Then
                        k.Focus()
                        'SendKeys.Send("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                        Exit For
                    End If
                Next
            End If 'SCati = False
        Else
            'moze i za prazno AND ispunjen USLOV, u uslovu stavi da nije prazno
            If SCati = False Then
                For Each k As Control In Me.Panel1.Controls
                    If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 1) = "C" OrElse Mid(k.Name, 1, 1) = "U" OrElse Mid(k.Name, 1, 2) = "RG" Then
                        If Mid(k.Name, 3).Trim.ToUpper = pageDownNA.Trim.ToUpper Then
                            k.Focus()
                            If Mid(k.Name, 1, 2) = "RG" AndAlso k.Focused = True Then
                                'stavi focus na prvi
                                'SendKeys.Send("{TAB}")
                                'MORA OVAKO DOKAZ PROBNIPOPIS
                                Me.SelectNextControl(ActiveControl, True, True, True, True)
                            End If
                            Exit For
                        End If
                    End If
                Next
            End If 'SCati = False
        End If
    End Sub

