                                            Dim autbtoPostoji As Boolean = False
                                            If Not nizAUTBTOKontrolaIme Is Nothing Then
                                                ikik = Array.IndexOf(nizAUTBTOKontrolaIme, Mid(kk.Name, 3).Trim.ToUpper)
                                                If ikik > -1 Then autbtoPostoji = True
                                            End If
                                            If autbtoPostoji = False Then
                                                kk.Text = ""
                                                If Not nizAUTBKontrola Is Nothing Then
                                                    Dim ind2 As Integer = Array.IndexOf(nizAUTBKontrola, kk)
