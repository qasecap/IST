    Sub cbfinalySkipGrupa(ByVal cntl As Control, Optional sakljuca As Boolean = False)
        cntlfocused = False
        Try
            ''''obicno POLJE
            'u kojoj je grupi polje sa koga skacemo,   plj.Trim.ToUpper

            Dim tblok As Integer = 0
            tblok = Array.IndexOf(grupePitanjaCAPI, cntl.Parent)

            'VALIDACIJA
            nepotrebnavalidacija = False

            If sakljuca = True Then
                Call cbpk_Validacija(cntl, Nothing)
                tblok = 0
            Else
                Call cbpp_Validacija(cntl, Nothing)
            End If

            IndBlokaNaKomeSmo = tblok
            'VALIDACIJA

            'da ne izaziva bezveze izlazak  i ulazak sa panela
            If okvalidacija = False Then

                nepotrebnavalidacija = True
                cntl.Focus()
                cntlfocused = True
                ''''''''''''''''''''''''''Nevenaaaaaaaa ovde zadrzi boju u kljucu
                'cntl.BackColor = Color.Bisque
                okvalidacija = False
                nepotrebnavalidacija = False

                Exit Sub
            End If

            If okvalidacija = True AndAlso bbiloskakanje = True Then
                If bbss Is Nothing Then Exit Sub
                Dim nblok As Integer = -1
                If Not bbss.AccessibleName Is Nothing Then
                    Dim p As Integer = bbss.AccessibleName.IndexOf("TOGROUP")
                    If p >= 0 Then
                        Dim pp As String = bbss.AccessibleName.Substring(p + 7)
                        nblok = pp.Substring(0, pp.IndexOf(";"))
                    End If
                End If
                If nblok <> tblok AndAlso nblok > -1 Then
                    nepotrebnavalidacija = True
                    grupePitanjaCAPI(tblok).Visible = False
                    Call SuspendDrawing(grupePitanjaCAPI(nblok))
                    grupePitanjaCAPI(nblok).Visible = True
                    Call ResumeDrawing(grupePitanjaCAPI(nblok))
                    nepotrebnavalidacija = False
                End If
                nepotrebnavalidacija = True
                Dim mmss As Control = bbss
                bbss.Focus()
                bbss = mmss
                bbiloskakanje = True
                nepotrebnavalidacija = False
                IndBlokaNaKomeSmo = nblok
                If TypeOf bbss Is DataGridView AndAlso DirectCast(bbss, DataGridView).Rows.Count > 0 Then
                    DirectCast(bbss, DataGridView).ClearSelection()
                    DirectCast(bbss, DataGridView).CurrentCell = DirectCast(bbss, DataGridView).FirstDisplayedCell
                    DirectCast(bbss, DataGridView).CurrentCell.Selected = True
                End If
                Exit Sub
            End If

            Dim ST As Boolean = False
            Dim NB As Boolean = False
            If okvalidacija = True AndAlso bbiloskakanje = False Then
                If sakljuca = False Then
                    If dalijeposlednjiCAPIPanel(cntl.Parent) = False AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = True Then
                        NB = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = True AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = True Then
                        'MORA OVAKO INACE AKO PRITISNU ISTOVREMENO KEUP AND KEYDDOWN PUSTA IH DA ODU, a cntl.focus ne radi nista
                        nepotrebnavalidacija = False
                        ST = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = False AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = False Then
                        ST = True
                    ElseIf dalijeposlednjiCAPIPanel(cntl.Parent) = True AndAlso dalijeposlednjaCNTLCAPIPanel(cntl) = False Then
                        ST = True
                    End If
                Else
                    nepotrebnavalidacija = True
                    'Me.SelectNextControl(ActiveControl, True, True, True, True)
                    Call cbpkSelectNextControl(cntl)
                    okvalidacija = True
                    nepotrebnavalidacija = False
                    Exit Sub
                End If
            End If

            If ST = True Then
                'SendKeys.SendWait("{TAB}")
                'MORA OVAKO DOKAZ PROBNIPOPIS
                nepotrebnavalidacija = True  'da ne radi opet validaciju
                Me.SelectNextControl(ActiveControl, True, True, True, True)
                okvalidacija = True
                nepotrebnavalidacija = False
                IndBlokaNaKomeSmo = tblok
                Exit Sub
            End If

            If NB = True Then
                Try
                    'vidljiv je sledeci blok po redu
                    'MORA DA SE ODVOJI NA VIDLJIV I NEVIDLJIVI KAO KAD IMA SKOK
                    'INACE GUBI PANEL FOKUS; PA PONOVO URADI PANE_ENTER
                    If tblok < grupePitanjaCAPI.GetUpperBound(0) Then
                        nepotrebnavalidacija = True
                        grupePitanjaCAPI(tblok).Visible = False

                        Call SuspendDrawing(grupePitanjaCAPI(tblok + 1))
                        grupePitanjaCAPI(tblok + 1).Visible = True
                        Call ResumeDrawing(grupePitanjaCAPI(tblok + 1))

                        IndBlokaNaKomeSmo = tblok + 1
