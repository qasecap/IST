                                Dim msgtxt As String = getMessageText(dtMessages, "25", Me.jezik)
                                ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                'ISTMessageBox.Show("Није добра синтакса код TAB-а за табелу " + t.Trim.ToUpper + ". " + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            End Try
                        End If

                        Dim pane As New NoMouseWheelScrollPanel
