    Private Sub Polje1Focus() 'tj. stavi Focus na prvo polje koje nije kljuc
        Dim p As Panel = Nothing
        If SCati = False AndAlso grupePitanjaCAPI Is Nothing Then
            p = Me.Panel1
        ElseIf SCati = False AndAlso Not grupePitanjaCAPI Is Nothing Then
            p = grupePitanjaCAPI(0)
        ElseIf SCati = True Then
            Dim tb As TextBox = prviTBNaCATIPanelu(grupePitanjaCATI(0))
            If Not tb Is Nothing Then tb.Focus()
            Exit Sub
        End If

        Dim minRbr As Long = 100000000000000
        For Each k As Control In p.Controls
            If (Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "C") AndAlso k.TabIndex < minRbr AndAlso k.TabStop = True AndAlso k.Enabled = True Then
                minRbr = k.TabIndex
            End If
        Next

        For Each k As Control In p.Controls
            If k.TabIndex = minRbr Then
                k.Focus()
                'k.BackColor = Color.Bisque
                Exit Sub
            End If
        Next
    End Sub

