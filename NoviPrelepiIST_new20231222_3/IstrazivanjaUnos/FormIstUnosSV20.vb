    Function fnizprovera(ByVal ttbox As TextBox, ByVal ctbox As ComboBox, ByVal utbox As DateTimePicker2, ByVal obaveznaV As String,
    Optional ByVal upozorenje As Boolean = False, Optional ByVal nizdaV() As String = Nothing, Optional ByVal nizneV() As String = Nothing,
    Optional ByVal minV As String = "", Optional ByVal maxV As String = "", Optional ByVal minL As String = "", Optional ByVal maxL As String = "",
                    Optional ByVal f2 As String = "", Optional ByVal f3 As String = "") As Boolean
        obaveznaV = obaveznaV.Trim.ToUpper
        Dim tbox As Control = Nothing
        Dim autbdb As Boolean = False
        Dim multiresponse As Boolean = False

        If Not ttbox Is Nothing Then
            tbox = ttbox
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTBDB;") >= 0 Then autbdb = True
            If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("MULTIRESPONSE;") >= 0 Then multiresponse = True
        End If

        If Not ctbox Is Nothing Then tbox = ctbox
        If Not utbox Is Nothing Then tbox = utbox

        Dim b As Integer = 0
        If Not nizdaV Is Nothing AndAlso nizdaV.Length > 0 Then
            If f2 <> "" Then
                b = nizdaV.GetUpperBound(0)
                ReDim Preserve nizdaV(b + 1)
                nizdaV(b + 1) = f2
            End If

            If f3 <> "" Then
                b = nizdaV.GetUpperBound(0)
                ReDim Preserve nizdaV(b + 1)
                nizdaV(b + 1) = f3
            End If
        End If

        fnizprovera = True

        Dim vrednost As String = ""
        If autbdb = False Then
            vrednost = tbox.Text.Trim
        End If
        If autbdb = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = False AndAlso DirectCast(tbox, AutoCompleteTextbox).CurrentAutoCompleteList.Count = 0 Then
            vrednost = tbox.Text.Trim
        End If

        If autbdb = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = True Then
            vrednost = DirectCast(tbox, AutoCompleteTextbox).sselectedValue.ToString.Trim
        End If
        If autbdb = True AndAlso DirectCast(tbox, AutoCompleteTextbox).autoCompleteLimitToList = False AndAlso DirectCast(tbox, AutoCompleteTextbox).CurrentAutoCompleteList.Count > 0 Then
            vrednost = DirectCast(tbox, AutoCompleteTextbox).sselectedValue.ToString.Trim
        End If

        Dim ok As Boolean = False
        If nizdaV.Length > 0 Then
            For k As Integer = 0 To nizdaV.GetUpperBound(0)
                Select Case nizdaV(k).Trim.ToUpper
                    Case "NUMERIC"
                        'pusti i prazno
                        ok = jisNumeric(vrednost)
                    Case "INTEGER"
                        'NUMERIC SAMO INTEGER (u polju dozvoljeni samo brojevi, ne i decimalna .)
                        ok = jisInteger(vrednost)
                    Case "NATURAL"
                        '0 1 2 3 4 5 6...
                        ok = jisNatural(vrednost)
                    Case "ALPHA"
                        'mora da je sastavljeno samo od slova
                        ok = IsAlpha(vrednost)
                    Case "ALPHANUMERIC"
                        'mora da je sastavljeno od samo od brojeva i slova; prazno je ok
                        ok = isAlphaNumeric(vrednost)
                    Case "MULTIRESPONSENUMERIC"
                        'mora da je sastavljeno od samo 0-1-2-3-4 ; prazno je ok
                        ok = isMultiresponseNumeric(vrednost.Trim, minV.Trim, maxV.Trim)
                    Case "MULTIRESPONSEALPHA"
                        'mora da je sastavljeno od samo a-b-c-d; prazno je ok, program sam pretvara .;, u -
                        ok = isMultiresponseAlpha(vrednost.Trim)
                    Case "DATUM"
                        'mora da je datum ; prazno je ok
                        ok = jisDate(vrednost)
                    Case "DATE"
                        'mora da je datum ; prazno je ok
                        ok = jisDate(vrednost)
                    Case "ISTDATE"
                        'mora da je datum ; prazno je ok
                        ok = jisISTDate(vrednost)
                    Case "TIME"
                        'mora da je vreme ; prazno je ok
                        ok = jisTime(vrednost)
                    Case Else
                        'If nizdaV(k).Length > 11 AndAlso nizdaV(k).Trim.ToUpper.IndexOf("NUMERICPLUS") = 0 Then
                        '    Dim dodatni As String = NZ(Replace(nizdaV(k).Trim, "numericplus", "", 1,, CompareMethod.Text)).Trim
                        '    dodatni = dodatni.Replace("[", "").Replace("]", "").Trim
                        '    Dim dod() As String = dodatni.Split(" ")
                        '    Dim pomtbox As String = vrednost
                        '    For m As Integer = 0 To dod.GetUpperBound(0)
                        '        If dod(m).Trim.ToUpper = "BLANK" Then
                        '            pomtbox = pomtbox.Replace(" ", "")
                        '        Else
                        '            pomtbox = pomtbox.Replace(dod(m).Trim, "")
                        '        End If
                        '    Next
                        '    ok = jisNumeric(pomtbox)
                        'Else
                        '    If vrednost.ToUpper <> nizdaV(k).Trim.ToUpper Then
                        '        ok = False
                        '    Else
                        '        ok = True
                        '    End If
                        'End If
                        If vrednost.ToUpper <> nizdaV(k).Trim.ToUpper Then
                            ok = False
                        Else
                            ok = True
                        End If
                End Select
                If ok = True Then Exit For
            Next
            OUP = False
            If ok = False Then
                If SCati = False Then
                    Call zatvoriOLHC()
                    'msg 27
                    Dim msgtxt As String = getMessageText(dtMessages, "27", Me.jezik)
                    ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End If
                If upozorenje = False Then
                    Call zatvoriOLHC()
                    OUP = True
                    tbox.Focus()
                    fnizprovera = False
                    Exit Function
                Else
                    tbox.BackColor = Color.LemonChiffon
                End If
            End If
        End If

        If nizneV.Length > 0 AndAlso multiresponse = True Then
            Dim pp() As String = vrednost.Trim.Split("-")
            For m As Integer = 0 To pp.GetUpperBound(0)
                For k As Integer = 0 To nizneV.GetUpperBound(0)
                    If pp(m).Trim.ToUpper = nizneV(k).Trim.ToUpper Then
                        If SCati = False Then
                            Call zatvoriOLHC()
                            ''msg 27
                            Dim msgtxt As String = getMessageText(dtMessages, "27", Me.jezik)
                            ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        End If
                        If upozorenje = False Then
                            Call zatvoriOLHC()
                            OUP = True
                            tbox.Focus()
                            tbox.BackColor = Color.Bisque
                            okvalidacija = False
                            fnizprovera = False
                            Exit Function
                        Else
                            tbox.BackColor = Color.LemonChiffon
                        End If
                    End If
                Next
            Next
        End If


        If nizneV.Length > 0 AndAlso multiresponse = False Then
            For k As Integer = 0 To nizneV.GetUpperBound(0)
                If vrednost.ToUpper = nizneV(k).Trim.ToUpper Then
                    If SCati = False Then
                        Call zatvoriOLHC()
                        ''msg 27
                        Dim msgtxt As String = getMessageText(dtMessages, "27", Me.jezik)
                        ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End If
                    If upozorenje = False Then
                        Call zatvoriOLHC()
                        OUP = True
                        tbox.Focus()
                        tbox.BackColor = Color.Bisque
                        okvalidacija = False
                        fnizprovera = False
                        Exit Function
                    Else
                        tbox.BackColor = Color.LemonChiffon
                    End If
                End If
            Next
        End If

        If IsNumeric(vrednost) AndAlso multiresponse = False Then
            Try
                If minV <> "" AndAlso vrednost.Length > 0 AndAlso CDbl(vrednost) < CDbl(minV) Then
                    Call zatvoriOLHC()
                    ''msg 28
                    Dim msgtxt As String = getMessageText(dtMessages, "28", Me.jezik)
                    ISTMessageBox.Show(msgtxt + nvrd + minV + "", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    If upozorenje = False Then
                        OUP = True
                        tbox.Focus()
                        fnizprovera = False
                        Exit Function
                    Else
                        tbox.BackColor = Color.LemonChiffon
                    End If
                End If
            Catch ex As Exception
                Call zatvoriOLHC()
                ISTMessageBox.Show("CHECK syntax for MIN=  for field " + tbox.Name)
                fnizprovera = False
                Exit Function
            End Try

            Try
                Dim mmok As Boolean = True
                If f2 <> "" AndAlso vrednost.Length > 0 AndAlso vrednost = f2.Trim Then
                    mmok = True
                ElseIf f3 <> "" AndAlso vrednost.Length > 0 AndAlso vrednost = f3.Trim Then
                    mmok = True
                ElseIf maxV <> "" AndAlso vrednost.Length > 0 AndAlso CDbl(vrednost) > CDbl(maxV) Then
                    mmok = False
                End If

                If mmok = False Then
                    Call zatvoriOLHC()
                    ''msg 29
                    Dim msgtxt As String = getMessageText(dtMessages, "29", Me.jezik)
                    ISTMessageBox.Show(msgtxt + nvrd + maxV + "", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    If upozorenje = False Then
                        OUP = True
                        tbox.Focus()
                        fnizprovera = False
                        Exit Function
                    Else
                        tbox.BackColor = Color.LemonChiffon
                    End If
                End If
            Catch ex As Exception
                Call zatvoriOLHC()
                ISTMessageBox.Show("CHECK syntax for MAX=  for field " + tbox.Name + nvrd + nvrd + ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                fnizprovera = False
                Exit Function
            End Try
        End If

        Try
            If minL <> "" AndAlso vrednost.Length > 0 AndAlso CDbl(vrednost.Length) < CDbl(minL) Then
                Call zatvoriOLHC()
                ''msg 30
                Dim msgtxt As String = getMessageText(dtMessages, "30", Me.jezik)
                ISTMessageBox.Show(msgtxt + nvrd + minL + "!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                If upozorenje = False Then
                    OUP = True
                    tbox.Focus()
                    fnizprovera = False
                    Exit Function
                Else
                    tbox.BackColor = Color.LemonChiffon
                End If
            End If
        Catch ex As Exception
            Call zatvoriOLHC()
            ISTMessageBox.Show("CHECK syntax for MINLenght=  for field " + tbox.Name)
            fnizprovera = False
            Exit Function
        End Try

        Try
            If maxL <> "" AndAlso vrednost.Length > 0 AndAlso CDbl(vrednost.Length) > CDbl(maxL) Then
                Call zatvoriOLHC()
                ''msg 31
                Dim msgtxt As String = getMessageText(dtMessages, "31", Me.jezik)
                ISTMessageBox.Show(msgtxt + nvrd + maxL + "!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                If upozorenje = False Then
                    OUP = True
                    tbox.Focus()
                    fnizprovera = False
                    Exit Function
                Else
                    tbox.BackColor = Color.LemonChiffon
                End If
            End If
        Catch ex As Exception
            Call zatvoriOLHC()
            ISTMessageBox.Show("CHECK syntax for MAXLenght=  for field " + tbox.Name)
            fnizprovera = False
            Exit Function
        End Try
        'samo za TP, ne treba za kljuc vezati, jer je dovoljno postaviti da polje ne sme da bude prazno ili NE= ;
        If obaveznaV.Length > 0 Then
            Try
                Dim tabela As String = GlavnaTabela
                Dim pomkol As New DataColumn("pomKol")
                pomkol.Expression = "IIF (" + CStr(obaveznaV).Trim.ToUpper.Replace("D.", "").Replace("N'", "'") + ", 1,0)"
                DGTabele(DGi(tabela)).Columns.Add(pomkol)
                Dim xxx As String = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol)", ""))
                DGTabele(DGi(tabela)).Columns.Remove(pomkol)
                Dim a As Integer = CInt(xxx)
                If vrednost.Length = 0 AndAlso a = 1 Then
                    Call zatvoriOLHC()
                    Dim pom As String = CStr(obaveznaV).Trim.ToUpper.Replace("D.", "")
                    ''msg 285
                    Dim msgtxt285 As String = getMessageText(dtMessages, "285", Me.jezik)
                    ''msg 286
                    Dim msgtxt286 As String = getMessageText(dtMessages, "286", Me.jezik)
                    ''msg 287
                    Dim msgtxt287 As String = getMessageText(dtMessages, "287", Me.jezik)
                    ISTMessageBox.Show(msgtxt285 + vbCrLf + vbCrLf + msgtxt286 + pom + msgtxt287, "Error!", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    If upozorenje = False Then
                        OUP = True
                        tbox.Focus()
