                        If TypeOf k Is Button AndAlso k.Name.Length > 8 AndAlso Mid(k.Name, 1, 8) = "DBTNPANE" Then
                            'dugmepanetab.Name = "DBTNPANE" & t.Trim.ToUpper
                            If skippedEnabledFalse = True Then
