                    ElseIf i - 2 >= 0 AndAlso bbb(i - 2).Length >= 9 AndAlso bbb(i - 2).Trim.ToUpper = "SUBSTRING" Then
                        bbb(i) = "'" + qq + "'"
                    ElseIf IsNumeric(qq) = True AndAlso qq.Length >= 1 AndAlso Mid(qq, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                        bbb(i) = qq
                    Else
                        bbb(i) = "'" + qq + "'"
                    End If
                End If
            End If
        Next
        zameniGlavaPanel = ustringaj(bbb).ToUpper

    End Function
