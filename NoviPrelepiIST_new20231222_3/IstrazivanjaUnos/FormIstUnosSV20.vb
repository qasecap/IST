                Dim ende As String = resetAndLoopPK(btn, panel, tabela, vredppKLJ, ppKLJ, autoList, autoListBy, autoListByTO, panel11)

                If ende <> "" Then 'ima skok
                    Dim en() As String = ende.Split(";")
                    Me.NslKljuc = Nothing
                    Me.sacuvanoP = True
                    Me.sacuvano = False

                    If en(0).IndexOf("PANEL") = 0 AndAlso en(0).IndexOf(".") < 0 Then   'skanje na sam panel
                        Dim ttab As String = en(0).Replace("PANEL", "")
                        en(0) = en(0).Replace("PANEL", "DBTNPANE")

                        For Each k As Control In Me.Panel1.Controls
                            If k.Name.Trim.ToUpper = en(0).Trim.ToUpper Then
                                Panel1.AutoScroll = False
                                If upisujem = False OrElse upisujem = True AndAlso DGTabele(DGi(ttab)).Rows.Count > 0 Then
                                    k.Enabled = True
                                    k.Visible = True
                                    k.Focus()
                                Else
                                    ddugmepane.Enabled = True
                                    ddugmepane.Focus()
                                End If
                                Panel1.AutoScroll = True
                                Exit For
                            End If
                        Next
                    End If
                    If en(0).IndexOf("PANEL") = 0 AndAlso en(0).IndexOf(".") > 0 Then

                        Dim ddugme As String = "DBTNPANE" + en(0).Substring(0, ende.IndexOf(".")).Replace("PANEL", "")
                        Dim ppolje As String = en(0).Substring(ende.IndexOf(".") + 1)

                        'skace na odgovarajuce polje u panelu
                        For Each k As Control In Me.Panel1.Controls
                            If TypeOf k Is Button AndAlso k.Name.Trim.ToUpper = ddugme.Trim.ToUpper Then

                                Dim ppp As Panel = dpc(k, 1)
                                Dim kp As Control = NadjiKontroluSkr(ppp, ppolje, 3)
                                If Mid(kp.Name, 2, 1) <> "F" Then kp.Enabled = True 'da ostanu fp
                                kp.Visible = True
                                kp.Focus()

                                Dim skippedEnabledFalse As Boolean = False
                                Dim skippedSetEmpty As Boolean = False
                                Dim skippedDontSave As Boolean = False
                                Dim skippedVisibleFalse As Boolean = False

                                For i As Integer = 0 To en.GetUpperBound(0)
                                    If en(i) = "SEF" Then skippedEnabledFalse = True
                                    If en(i) = "SVF" Then skippedVisibleFalse = True
                                    If en(i) = "SDS" Then skippedDontSave = True
                                    If en(i) = "SSE" Then skippedSetEmpty = True
                                Next

                                Call fixPanelAfterJump(kp, ppp, skippedEnabledFalse, skippedVisibleFalse, skippedDontSave, skippedSetEmpty)

                                CType(k, Button).Location = New Point(CType(k, Button).Location.X, ppp.Location.Y + (CType(k, Button).Height + 2) * (CType(k, Button).AccessibleDescription - 1))
                                k.Enabled = True
                                k.Visible = True
                            End If
                        Next
                    End If

                    If en(0).IndexOf("BUTTONNEXT") = 0 Then Me.BtnSaveNext.Focus()
                End If 'If ende <> "" Then 'ima skok

            End If ' If dugmetabfokus = True Then

        End If

        For Each m As Control In panel.Controls
            If Not m.AccessibleName Is Nothing AndAlso m.AccessibleName <> "" AndAlso m.AccessibleName.IndexOf(";") >= 0 Then
                Dim mm() As String = m.AccessibleName.Split(";")
                Dim nan As String = ""
                For i As Integer = 0 To mm.GetUpperBound(0)
                    Dim acn As String = mm(i).Trim.ToUpper
                    If acn = "SHH" Then
                    ElseIf acn.IndexOf("SKIPFROM") = 0 Then
                    ElseIf acn.IndexOf("FROMGROUP") = 0 Then
                    ElseIf acn.IndexOf("TOGROUP") = 0 Then
                    Else
                        nan = nan + acn + ";"
                    End If
                Next
                m.AccessibleName = nan
            End If
        Next
        'da li ima skok sa dugmeta sacuvaj?
        'osvezi ako ima na glavnoj formi nesto sa MEM
        PreracunajFP("FPMEM")

        If poslednjiPanel = True Then Me.BtnSaveNext.Focus()

    End Function

