    Function sklopiButton(ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal zadnjitabindex As Integer,
                          ByVal pOd As String,
                          ByVal ro As Boolean, Optional nonvisible As Boolean = False, Optional nonenabled As Boolean = False) As Button

        Dim CBB As New Button
        CBB.Name = "BUTTON" & p.POLJE.Trim.ToUpper
        CBB.FlatStyle = FlatStyle.Flat
        'CBB.FlatAppearance.BorderSize = 0
        CBB.FlatAppearance.MouseOverBackColor = Color.Silver
        CBB.Cursor = Cursors.Hand
        CBB.BackColor = Color.Gainsboro

        CBB.TabIndex = zadnjitabindex
        CBB.TabStop = True
        CBB.Width = 100

        CBB.TextAlign = ContentAlignment.MiddleCenter

        AddHandler CBB.Click, AddressOf Me.BB_Click
        AddHandler CBB.MouseMove, AddressOf Me.BB_MouseMove
        AddHandler CBB.PreviewKeyDown, AddressOf Me.BB_PreviewKeyDown
        AddHandler CBB.KeyDown, AddressOf Me.BB_KeyDown

        If ro = True Then CBB.Enabled = False
        If nonvisible = True Then CBB.Visible = False

        CBB.TabIndex = zadnjitabindex
        If pOd.Trim.ToUpper.IndexOf("NOTABSTOP") > -1 OrElse (p.IsIzrazNull = False AndAlso p.Izraz.Trim.ToUpper.IndexOf("NOTABSTOP") > -1) Then
            CBB.TabStop = False
        Else
            CBB.TabStop = True
        End If

        If nonvisible = True Then CBB.Visible = False
        If nonenabled = True Then CBB.Enabled = False

        Dim fbold As Boolean
        Dim fitalic As Boolean
        Dim funderline As Boolean
        Dim fcdesnop As Boolean
        Dim fclevop As Boolean
        Dim fccenterp As Boolean
        Dim ffSize As Integer
        Dim fFORECOLORP As String = ""
        Dim fBACKCOLORP As String = ""
        Dim dw As Integer
        Dim dh As Integer
        Dim xx As Integer = -1
        Dim yy As Integer = -1
        Dim ccaption As String = ""
        Dim kakoL() As String = p.Izraz.TrimStart("$").TrimEnd("$").Split("$")
        If kakoL.Length > 0 Then
            For i As Integer = 0 To kakoL.Length - 1
                kakoL(i) = kakoL(i).Trim
                If kakoL(i).ToUpper.IndexOf("FONTBOLD") >= 0 Then
                    fbold = True
                ElseIf kakoL(i).ToUpper.IndexOf("FONTSIZE") >= 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "fontsize", "", 1, , CompareMethod.Text)).Trim
                    If IsNumeric(kakoL(i)) = True Then ffSize = CInt(kakoL(i))
                ElseIf kakoL(i).ToUpper.IndexOf("FONTITALIC") >= 0 Then
                    fitalic = True
                ElseIf kakoL(i).ToUpper.IndexOf("FONTUNDERLINE") >= 0 Then
                    funderline = True
                ElseIf kakoL(i).ToUpper.IndexOf("LDESNOP") >= 0 OrElse kakoL(i).ToUpper.IndexOf("LRIGHTA") >= 0 Then
                    fcdesnop = True
                ElseIf kakoL(i).ToUpper.IndexOf("LLEFTA") >= 0 OrElse kakoL(i).ToUpper.IndexOf("LLEVOP") >= 0 Then
                    fclevop = True
                ElseIf kakoL(i).ToUpper.IndexOf("LCENTARP") >= 0 OrElse kakoL(i).ToUpper.IndexOf("LCENTERA") >= 0 OrElse kakoL(i).ToUpper.IndexOf("LCENTREA") >= 0 Then
                    fccenterp = True
                ElseIf kakoL(i).ToUpper.IndexOf("FORECOLOR") >= 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "forecolor", "", 1, , CompareMethod.Text)).Trim
                    fFORECOLORP = kakoL(i)
                ElseIf kakoL(i).ToUpper.IndexOf("BACKCOLOR") >= 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "backcolor", "", 1, , CompareMethod.Text)).Trim
                    fBACKCOLORP = kakoL(i)
                ElseIf kakoL(i).ToUpper.IndexOf("BUTTONWIDTH") >= 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "buttonwidth", "", 1, , CompareMethod.Text)).Trim
                    kakoL(i) = kakoL(i).Trim.Replace("=", "").Trim
                    dw = CInt(kakoL(i))
                ElseIf kakoL(i).ToUpper.IndexOf("BUTTONHEIGHT") >= 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "buttonheight", "", 1, , CompareMethod.Text)).Trim
                    kakoL(i) = kakoL(i).Trim.Replace("=", "").Trim
                    dh = CInt(kakoL(i))
                ElseIf kakoL(i).Trim.ToUpper.ToUpper.IndexOf("BUTTONLOCATION") = 0 Then
                    kakoL(i) = NZ(Replace(kakoL(i), "buttonlocation", "", 1, , CompareMethod.Text)).Trim
                    Dim cc() As String = kakoL(i).Split(",")
                    '(X=60,Y=260)
                    If cc.Length = 2 Then
                        xx = CInt(cc(0).Trim.ToUpper.Replace("X=", "").Replace("(", ""))
                        yy = CInt(cc(1).Trim.ToUpper.Replace("Y=", "").Replace(")", ""))

                    End If
                    If cc.Length = 1 Then
                        cc(0) = cc(0).Trim.ToUpper.Replace("(", "").Replace(")", "").Replace("=", "")
                        If cc(0).Trim.ToUpper.IndexOf("X") >= 0 Then xx = CInt(cc(0).Trim.ToUpper.Replace("X", ""))
                        If cc(0).Trim.ToUpper.IndexOf("Y") >= 0 Then yy = CInt(cc(0).Trim.ToUpper.Replace("Y", ""))
                    End If
                Else
                    ccaption = kakoL(i).Trim
                End If
            Next
        End If


        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline
        'B I U
        If fbold = True And fitalic = True And funderline = True Then ft = ftB Or ftI Or ftU
        If fbold = True And fitalic = True And funderline = False Then ft = ftB Or ftI
        If fbold = True And fitalic = False And funderline = False Then ft = ftB
        If fbold = True And fitalic = False And funderline = True Then ft = ftB Or ftU
        If fbold = False And fitalic = True And funderline = True Then ft = ftI Or ftU
        If fbold = False And fitalic = False And funderline = True Then ft = ftU
        If fbold = False And fitalic = True And funderline = False Then ft = ftI

        If ffSize = 0 Then ffSize = 10
        CBB.Font = New Font(Me.Font.Name, ffSize, ft)

        If dw > 0 Then CBB.Width = dw
        If dh > 0 Then CBB.Height = dh
        xx = xx + novoPomeriDesnoZaBivsiBorderWidth
        CBB.Location = New Point(xx, yy)
        If fccenterp = False AndAlso fcdesnop = False Then fclevop = True

        If fclevop Then CBB.TextAlign = ContentAlignment.MiddleLeft
        If fcdesnop Then CBB.TextAlign = ContentAlignment.MiddleRight
        If fccenterp Then CBB.TextAlign = ContentAlignment.MiddleCenter

        If fBACKCOLORP <> "" AndAlso fBACKCOLORP <> "TRANSPARENT" AndAlso fBACKCOLORP <> "CHOCALATE" AndAlso fBACKCOLORP <> "LAVANDER" Then CBB.BackColor = Color.FromName(fBACKCOLORP)

        If fFORECOLORP <> "" Then
            If fBACKCOLORP = "" Then CBB.BackColor = Color.Gainsboro
            CBB.ForeColor = Color.FromName(fFORECOLORP)
        End If

        Dim MLopis As String = getMultilanguageLabel(mdtLabel, txtmode, GlavnaTabela, p.POLJE.Trim, "button", Me.jezik)
        If MLopis = "" Then
            CBB.Text = ccaption
        Else
            CBB.Text = NZ(Replace(MLopis, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
        End If

        If previewEditMode = True Then
            CBB.ContextMenuStrip = mnu02
            'AddHandler ctrt.MouseDoubleClick, AddressOf Me.pp_MouseDoubleClick
            Dim pomforma As String = ""
            If p.IsFormaNull = False Then pomforma = p.Forma.Trim
            CBB.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.Vod.ToString("yyyy/MM/dd").Trim + ";" + CBB.Name.Substring(6) + ";" + pomforma + ";" + CStr(p.rbr).Trim
        End If
        CBB.BringToFront()
        Return CBB
    End Function

