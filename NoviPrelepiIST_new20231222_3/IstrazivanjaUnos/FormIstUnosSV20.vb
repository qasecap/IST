    Dim CH As Integer = Me.Height - 40 ' Current Height

    Private Sub Podesi_Formu()
        Dim novoPomeriNaDoleZa As Integer = 40
        If Not Me.WindowState = FormWindowState.Minimized Then

            'CW = 1112
            Dim RW As Double = (Me.Width - CW) / CW  ' Ratio change of width
            Dim RH As Double = (Me.Height - CH) / CH  ' Ratio change of height
            Dim ww As Integer = Me.Width

            Dim hh As Integer = Me.Height - Me.gbTimePoint.Height
            Dim pomeri As Integer = 0 'bilo 15

            Me.Panel1.Location = New Point(60, novoPomeriNaDoleZa + 64)  'bilo   New Point(60, 64)
            Me.Panel1.Size = New Size(ww - 80 + novoPomeriNaDoleZa / 2, IIf(OrgPnlHght < hh - 60, Me.Panel1.Height, hh - 60) - 1)
            Panel1.Refresh()
            Me.PaneLK.Location = New Point(0, novoPomeriNaDoleZa + 64)
