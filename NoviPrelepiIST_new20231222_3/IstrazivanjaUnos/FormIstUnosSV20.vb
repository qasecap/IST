                                        If prvi = "'" AndAlso poslednji = "'" Then
                                            k.Text = nizdodeliStasss.Replace("'", "")
                                            biladodela = True
                                        ElseIf IsNumeric(nizdodeliStasss) = True Then
                                            k.Text = nizdodeliStasss.ToString.Trim
                                            biladodela = True
                                        Else
                                            ' da bi mogla i FP
                                            If Mid(kk.Name, 3).Trim.ToUpper = nizdodeliStasss.Trim.ToUpper Then
                                                k.Text = kk.Text
                                                biladodela = True
                                            End If
                                        End If
                                        Try
                                            If biladodela = True Then
                                                If Mid(k.Name, 1, 1) <> "F" Then
                                                    Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper,,, k.Parent)
                                                    k.BackColor = SystemColors.ControlLightLight
                                                End If
                                                pomocnoDaIskocimIzFora = 1
                                                Exit For
                                            End If
                                        Catch ex As Exception
                                            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                        End Try
                                    Next
                                End If
                            End If
                            If pomocnoDaIskocimIzFora = 1 Then
                                Exit For
                            End If
                        Next
                    Next
                End If
            End If
        Catch ex As Exception
            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        Finally
        End Try
    End Sub

