                Next
            End If 'samoCitaAko.Length
        End If 'samoCita.Length
        If SCati = True Then

            Dim tt() As String = tbox.AccessibleDescription.Split(";")
            Dim trenutnirbr As Integer = tt(0)
            Dim checkbox As Boolean = False
            Dim grupa As String = ""
            If tt.GetUpperBound(0) = 1 AndAlso tt(1).Trim.ToUpper = "HH" Then
                checkbox = True
                If Not (tbox.Tag Is Nothing OrElse tbox.Tag = "") Then grupa = tbox.Tag.trim.toupper
            End If

            Call LabelaVidljiva(trenutnirbr, checkbox, grupa)
            Dim pp As Panel = tbox.Parent
            Dim imeP As String = pp.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
            Dim pppom As Panel = NadjiKontrolu(Me, imeP)
            Call kontrolaVidljiva(trenutnirbr, pppom, checkbox, grupa)
        End If

    End Sub
    Sub AWLFill(ByVal tcntlt As Control, ByVal plj As String, ByVal awltext As String,
                        ByVal kojaG As Integer, ByVal ugrupama As Boolean, ByVal awlonF1 As Boolean, ByVal awltextformat As String)

        inlineAWLabel = Nothing

        Try

            If inlineAWL = False Then
                Call AWLFormatiraj(Me.AlwaysVisibleLabel, tcntlt.Name, tcntlt, awltext, awltextformat)
                If awlonF1 = False Then
                    Me.AlwaysVisibleLabel.Visible = True
                    meAlwaysVisibleLabel = True
                End If
            End If

            If inlineAWL = True Then
                Dim llppom As New Label
                llppom.Visible = False

                If ugrupama = True Then
                    llppom = awlCAPI(kojaG)
                Else
                    Dim ll As Label = NadjiKontroluKojaJeLABELA(Panel1, "inlawl")
                    If Not ll Is Nothing Then
                        llppom = NadjiKontroluKojaJeLABELA(Panel1, "inlawl")
                    End If
                End If

                Call AWLFormatiraj(llppom, tcntlt.Name, tcntlt, awltext, awltextformat)

                Dim xTRT As Integer = tcntlt.Location.X
                Dim yTRT As Integer = tcntlt.Location.Y
                Dim aLBL As Integer = llppom.Width
                Dim bLBL As Integer = llppom.Height
                Dim aTRT As Integer = tcntlt.Width
                Dim bTRT As Integer = tcntlt.Height

                Dim x As Integer = xTRT + aTRT - aLBL
                Dim y As Integer = yTRT - bLBL

                If x >= 0 AndAlso y >= 0 Then
                ElseIf x >= 0 AndAlso y < 0 Then
                    y = yTRT + bTRT
                ElseIf x < 0 AndAlso y >= 0 Then
                    x = xTRT + aTRT
                ElseIf x < 0 AndAlso y < 0 Then
                    x = xTRT + aTRT
                    y = yTRT
                End If

                llppom.Location = New Point(x, y)

                If ugrupama = True Then
                    grupePitanjaCAPI(kojaG).SendToBack()
                    If llppom.Location.Y < tcntlt.Location.Y Then  'ako awl ide iznad textpolja
                        If llppom.Location.Y + llppom.Height >= grupePitanjaCAPI(kojaG).Height Then
                            grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPI(kojaG).Height + llppom.Height
                            grupePitanjaCAPI(kojaG).BringToFront()
                        Else
                            grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPIOrigHeight(kojaG)
                        End If
                    Else  'ako awl ide ispod textpolja
                        If tcntlt.Location.Y + tcntlt.Height + llppom.Height >= grupePitanjaCAPI(kojaG).Height Then
                            grupePitanjaCAPI(kojaG).Height = tcntlt.Location.Y + tcntlt.Height + llppom.Height
                            grupePitanjaCAPI(kojaG).BringToFront()
                        Else
                            grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPIOrigHeight(kojaG)
                        End If
                    End If
                End If

                If awlonF1 = False Then
                    llppom.Visible = True
                    llppom.BringToFront()
                Else
                    inlineAWLabel = llppom
                End If
            End If
        Catch ex As Exception
            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try

    End Sub

    Function AWLFillStaro(ByVal tcntlt As Control, ByVal plj As String,
                        ByVal nizdodeliAkosss As String, ByVal nizdodeliKomesss As String, ByVal nizdodeliStasss As String,
                        ByVal kojaG As Integer, ByVal ugrupama As Boolean) As String

        AWLFillStaro = ""
        Dim zzz As String = ""
        zzz = sracunajIzraz(nizdodeliAkosss, plj, tcntlt)
        Dim a As Integer = 0
        a = scompute(zzz, plj, "skipif")       '1 TRUE, 0 FALSE
        'ispunjen USLOV
        If a = 1 Then

            Dim prvi As String = nizdodeliStasss.Trim.Substring(0, 1)
            Dim poslednji As String = nizdodeliStasss.Substring(nizdodeliStasss.Length - 1, 1)
            Me.AlwaysVisibleLabel.Text = ""
            If nizdodeliKomesss.Trim.ToUpper.IndexOf("ALWAYSVISIBLELABELONF1") >= 0 Then
                awlonF1 = True
                Me.AlwaysVisibleLabel.Visible = False
                meAlwaysVisibleLabel = False
            Else
                awlonF1 = False
                Me.AlwaysVisibleLabel.Visible = True
                meAlwaysVisibleLabel = True
            End If

            Dim imaAVLabel As Boolean = False
            Try
                Dim TTfontSize As Integer = 0
                Dim TTfontBold As Boolean = False
                Dim llppom As New Label
                llppom.Visible = False

                If nizdodeliKomesss.Trim.ToUpper.IndexOf("ALWAYSVISIBLELABEL") >= 0 Then
                    imaAVLabel = True
                    If inlineAWL = True AndAlso ugrupama = True Then
                        llppom = awlCAPI(kojaG)
                    ElseIf inlineAWL = True AndAlso ugrupama = False Then
                        Dim ll As Label = NadjiKontroluKojaJeLABELA(Panel1, "inlawl")
                        If Not ll Is Nothing Then
                            llppom = NadjiKontroluKojaJeLABELA(Panel1, "inlawl")
                        End If
                    Else
                        llppom = Me.AlwaysVisibleLabel
                    End If

                    If nizdodeliStasss <> "''" Then
                        Call AWLFormatiraj(llppom, tcntlt.Name, tcntlt, nizdodeliStasss, "")
                        If inlineAWL = True Then
                            Dim xTRT As Integer = tcntlt.Location.X
                            Dim yTRT As Integer = tcntlt.Location.Y
                            Dim aLBL As Integer = llppom.Width
                            Dim bLBL As Integer = llppom.Height
                            Dim aTRT As Integer = tcntlt.Width
                            Dim bTRT As Integer = tcntlt.Height

                            Dim x As Integer = xTRT + aTRT - aLBL
                            Dim y As Integer = yTRT - bLBL

                            If x >= 0 AndAlso y >= 0 Then
                            ElseIf x >= 0 AndAlso y < 0 Then
                                y = yTRT + bTRT
                            ElseIf x < 0 AndAlso y >= 0 Then
                                x = xTRT + aTRT
                            ElseIf x < 0 AndAlso y < 0 Then
                                x = xTRT + aTRT
                                y = yTRT
                            End If
                            llppom.Location = New Point(x, y)

                            If ugrupama = True Then
                                grupePitanjaCAPI(kojaG).SendToBack()
                                If llppom.Location.Y < tcntlt.Location.Y Then  'ako awl ide iznad textpolja
                                    If llppom.Location.Y + llppom.Height >= grupePitanjaCAPI(kojaG).Height Then
                                        grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPI(kojaG).Height + llppom.Height
                                        grupePitanjaCAPI(kojaG).BringToFront()
                                    Else
                                        grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPIOrigHeight(kojaG)
                                    End If
                                Else  'ako awl ide ispod textpolja
                                    If tcntlt.Location.Y + tcntlt.Height + llppom.Height >= grupePitanjaCAPI(kojaG).Height Then
                                        grupePitanjaCAPI(kojaG).Height = tcntlt.Location.Y + tcntlt.Height + llppom.Height
                                        grupePitanjaCAPI(kojaG).BringToFront()
                                    Else
                                        grupePitanjaCAPI(kojaG).Height = grupePitanjaCAPIOrigHeight(kojaG)
                                    End If
                                End If
                            End If
                        End If
                        llppom.Visible = True
                        llppom.BringToFront()
                        meAlwaysVisibleLabel = True
                    Else
                        llppom.Text = ""
                        llppom.Visible = False
                        meAlwaysVisibleLabel = False
                    End If
                Else
                    llppom.Text = ""
                    llppom.Visible = False
                    meAlwaysVisibleLabel = False
                End If
                AWLFillStaro = llppom.Text.Trim
            Catch ex As Exception
                ''msg 45
                Dim msgtxt45 As String = getMessageText(dtMessages, "45", Me.jezik)
                Dim msgtxt46 As String = getMessageText(dtMessages, "46", Me.jezik)
                ISTMessageBox.Show(msgtxt45 + nvrd + tcntlt.Name + nvrd + msgtxt46 + nvrd + GlavnaTabela + "", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                'ISTMessageBox.Show("Ne valja sintaksa za dodelu AlwaysVisibleLabel kod polja " + tcntlt.Name + " u panelu " + GlavnaTabela + "")
            End Try

        End If

    End Function

    Sub dodelaQEnovo(ByVal tcntlt As Control, ByVal plj As String, ByVal QEtext As String) ' ByVal QEtextformat As String

        Me.QuestionExplanation.Text = ""
        Me.QuestionExplanation.Visible = False
        meQuestionExplanation = False
        Try

            QuestionExplanation.Text = ""
            Try
                Dim pp As String = QEtext
                If pp.Trim.IndexOf("&") >= 0 Then
                    Dim ppa() As String = pp.Split("&")
                    Dim pom As String = ""
                    For ii As Integer = 0 To ppa.GetUpperBound(0)
                        Dim xx As String = ""
                        Dim cime As String = ppa(ii).TrimStart(" "c).ToUpper
                        If cime.IndexOf("'") = 0 Then
                            xx = ppa(ii)
                        Else
                            Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cime)
                            If ind > -1 Then
                                xx = "'" + SE(cime,, nizKontrola(ind).Parent).Trim + "'"
                            ElseIf cime.IndexOf("#FP{") = 0 Then
                                cime = cime.Trim
                                If cime.EndsWith("}") = True Then cime = cime.Replace("}", "")
                                cime = cime.Substring(4)
                                ind = Array.IndexOf(nizFPime, cime)
                                If ind > -1 Then xx = "'" + SE(cime, True, nizFP(ind).Parent).Trim + "'"
                            Else
                                xx = ppa(ii)
                            End If
                        End If

                        pom = pom + xx
                    Next
                    pp = pom
                End If

                pp = pp.Replace("'", "")

                Dim TTfontSize As Integer = 0
                Dim TTfontBold As Boolean = False
                Dim TTfontItalic As Boolean = False
                Dim TTfontUnderline As Boolean = False
                Dim TTforeColor As String = ""
                Dim TTbackColor As String = ""
                Dim TTX As Integer = 0 : Dim TTY As Integer = 0
                Dim TTsizeX As Integer = 0 : Dim TTsizeY As Integer = 0
                Dim TTaligmentWithControl As String = ""

                If TTfontBold = False Then TTfontBold = Me.QuestionExplanation.Font.Bold
                If TTfontItalic = False Then TTfontItalic = Me.QuestionExplanation.Font.Italic
                If TTfontUnderline = False Then TTfontUnderline = Me.QuestionExplanation.Font.Underline
                If TTfontSize = 0 Then TTfontSize = Me.QuestionExplanation.Font.Size

                If pp.Trim.ToUpper.IndexOf(" < FONTSIZE") >= 0 Then
                    Dim a As Integer = pp.Trim.ToUpper.IndexOf("<FONTSIZE")
                    If pp.Substring(a).IndexOf(">") > 0 Then
                        Dim b As Integer = pp.Substring(a).IndexOf(">")
                        TTfontSize = Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")).Replace(">", "")
                        pp = pp.Replace(Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")), "")
                        pp = NZ(Replace(pp, "<fontsize", "", 1, , CompareMethod.Text)).Trim
                    End If
                End If
                If pp.Trim.ToUpper.IndexOf("<BOLD>") >= 0 Then
                    TTfontBold = True
                    pp = NZ(Replace(pp, "<bold>", "", 1, , CompareMethod.Text)).Trim
                End If
                If pp.Trim.ToUpper.IndexOf("<ITALIC>") >= 0 Then
                    TTfontItalic = True
                    pp = NZ(Replace(pp, "<italic>", "", 1, , CompareMethod.Text)).Trim
                End If
                If pp.Trim.ToUpper.IndexOf("<UNDERLINE>") >= 0 Then
                    TTfontUnderline = True
                    pp = NZ(Replace(pp, "<underline>", "", 1, , CompareMethod.Text)).Trim
                End If

                'samo Bold
                If TTfontSize = 0 Then TTfontSize = Me.Font.Size

                Dim ft As FontStyle = FontStyle.Regular
                Dim ftB As FontStyle = FontStyle.Bold
                Dim ftI As FontStyle = FontStyle.Italic
                Dim ftU As FontStyle = FontStyle.Underline
                If TTfontBold = True AndAlso TTfontItalic = True Then ft = ftB Or ftI
                If TTfontBold = True AndAlso TTfontItalic = False Then ft = ftB
                If TTfontBold = False AndAlso TTfontItalic = True Then ft = ftI

                QuestionExplanation.Font = New Font(Me.Font.Name, TTfontSize, ft)

                pp = NZ(Replace(pp, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
                QuestionExplanation.Text = pp

                'awl.Visible = True
                QuestionExplanation.BringToFront()
            Catch ex As Exception
                ''msg 45
                Dim msgtxt45 As String = getMessageText(dtMessages, "45", Me.jezik)
                Dim msgtxt46 As String = getMessageText(dtMessages, "46", Me.jezik)
                ISTMessageBox.Show(msgtxt45 + nvrd + tcntlt.Name + nvrd + msgtxt46 + nvrd + GlavnaTabela + "", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        Catch ex As Exception
            ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try

    End Sub
    Sub obicnaPoljaDodela(ByVal tcntlt As Control, ByVal plj As String,
                        ByVal nizdodeliAkosss As String,
                        ByVal nizdodeliKomesss As String, ByVal nizdodeliStasss As String)

        nizdodeliStasss = nizdodeliStasss.Replace("#FP{", "").Replace("}", "").Trim
        Try
            Dim a As Integer = 1
            Dim tabela As String = GlavnaTabela
            If DGTabele(DGi(tabela)).Rows.Count > 0 Then
                Dim pomKol4 As New DataColumn("pomKol4")
                Dim bbb() As String = razkvantaj(nizdodeliAkosss)
                For ll As Integer = 0 To bbb.GetUpperBound(0)
                    If bbb(ll).Trim = plj Then
                        Dim pom As String = SE(plj,, tcntlt.Parent).Trim
                        'saekrana
                        If pom = "" Then
                            bbb(ll) = "Null"
                        Else
                            bbb(ll) = "'" + pom + "'"
                        End If
                    End If
                    If bbb(ll).Trim.IndexOf("#FP{") = 0 Then
