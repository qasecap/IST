    Private Function zameniBETWEEN(ByVal str As String) As String

        If str.Trim.ToUpper.IndexOf(" BETWEEN ") < 0 Then
            zameniBETWEEN = str
            Exit Function
        End If

        zameniBETWEEN = ""
        Try

            Dim levastranaodBETWEEN As String = ""
            Dim desnastranaodBETWEEN As String = ""
            Dim leviostatak As String = ""
            Dim desniostatak As String = ""

            str = str.Trim
            Dim stru As String = str.ToUpper
            stru = stru.Replace(" BETWEEN ", "~")
            Dim pp() As String = stru.Split("~")
            Dim a As String = pp(0)

            If a.IndexOf(" AND ") > 0 OrElse a.IndexOf(" OR ") > 0 Then
                Dim apom As String = a
                apom = apom.Replace(" AND ", "~").Replace(" OR ", "~")
                Dim ppo() As String = apom.Split("~")
                levastranaodBETWEEN = ppo(ppo.GetUpperBound(0))
                leviostatak = a.Replace(levastranaodBETWEEN, "")
            Else
                levastranaodBETWEEN = a
            End If

            levastranaodBETWEEN = "####" + levastranaodBETWEEN
            levastranaodBETWEEN = levastranaodBETWEEN.Replace("####(", "")

            Dim b As String = pp(1)
            Dim bbb() As String = razkvantaj(b)
            For ll As Integer = 0 To bbb.GetUpperBound(0)
                If bbb(ll).Trim.ToUpper = "AND" Then
                    'prvo and pripada betweenu
                    bbb(ll) = "ISTXXX"
                    Exit For
                End If
            Next
            b = ustringaj(bbb).ToUpper

            If b.IndexOf(" AND ") > 0 OrElse b.IndexOf(" OR ") > 0 Then
                Dim bpom As String = b
                bpom = bpom.Replace(" AND ", "~").Replace(" OR ", "~")
                Dim ppo() As String = bpom.Split("~")
                desnastranaodBETWEEN = ppo(0)
                desniostatak = b.Replace(desnastranaodBETWEEN, "")
            Else
                desnastranaodBETWEEN = b
            End If

            desnastranaodBETWEEN = desnastranaodBETWEEN.Replace(")", "").Replace("(", "")
            desnastranaodBETWEEN = desnastranaodBETWEEN.Replace("ISTXXX", "~")
            Dim ppb() As String = desnastranaodBETWEEN.Split("~")

            zameniBETWEEN = leviostatak + " (" + levastranaodBETWEEN + " > = " + ppb(0) + " and " + levastranaodBETWEEN + " < = " + ppb(1) + ") " + desniostatak
        Catch ex As Exception
            Call zatvoriOLHC()
            ISTMessageBox.Show("Check syntax for BETWEEN IN STOPIF, there is possibility that you have ( or ) more then it is ok!" + nvrd + nvrd + CStr(str).Trim.ToUpper.Replace("D.", ""))
        End Try
    End Function

    Private Function ZameniFDAYMONTHYEAR(ByVal str As String, ByVal tt As String) As String

        Dim bbb() As String = razkvantaj(str)
        Dim f As String = ""
        Dim ind As String = ""
        Dim kk As Integer = 0
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            Dim p As Boolean = False
            If bbb(ll).Trim.ToUpper = "FISDAY" Then ind = "D" : p = True
            If bbb(ll).Trim.ToUpper = "FISMONTH" Then ind = "M" : p = True
            If bbb(ll).Trim.ToUpper = "FISYEAR" Then ind = "Y" : p = True
            If p = True Then
                If ll + 3 <= bbb.GetUpperBound(0) AndAlso bbb(ll + 3).Length >= 0 AndAlso bbb(ll + 3) = ")" Then kk = 3            'slucaj FISMONTH(dan)=false
                If ll + 4 <= bbb.GetUpperBound(0) AndAlso bbb(ll + 4).Length >= 0 AndAlso bbb(ll + 4) = ")" Then kk = 4            'slucaj FISMONTH(dan,)=false
                If ll + 5 <= bbb.GetUpperBound(0) AndAlso bbb(ll + 5).Length >= 0 AndAlso bbb(ll + 5) = ")" Then kk = 5            'slucaj FISMONTH(dan,godina)=false
                For jj As Integer = ll To ll + kk
                    f = f + bbb(jj)
                    bbb(ll) = "FF"
                    If ll < jj Then bbb(jj) = ""
                Next
                ll = ll + kk
            End If
        Next

        Dim mok As Boolean = False : Dim dok As Boolean = False : Dim yok As Boolean = False
        Dim zzz As String = ustringaj(bbb).ToUpper
        Dim pp() As String
        Dim mm As String = "" : Dim dd As String = "" : Dim yy As String = ""

        If f <> "" Then
            f = f.Replace("FISMONTH", "").Replace("FISDAY", "").Replace("FISYEAR", "").Replace("(", "").Replace(")", "").Replace("NULL", "").Replace("'", "")
            If f.IndexOf(",") < 0 Then f = f + ","
            pp = f.Split(",")
            If pp.Length = 2 Then
                If ind = "D" Then
                    dd = tt
                    mm = pp(0).Trim
                    yy = pp(1).Trim
                ElseIf ind = "M" Then
                    dd = pp(0).Trim
                    mm = tt
                    yy = pp(1).Trim
                ElseIf ind = "Y" Then
                    dd = pp(0).Trim
                    mm = pp(1).Trim
                    yy = tt
                End If

                'YEAR
                If yy <> "" AndAlso IsNumeric(yy) Then
                    If yy.Trim.Length = 3 AndAlso CInt(yy.Trim) >= 800 AndAlso CInt(yy.Trim) <= 999 Then yy = "1" + yy.Trim
                    If yy.Trim.Length = 3 AndAlso CInt(yy.Trim) < 100 Then yy = "2" + yy.Trim
                    If yy.Length = 4 AndAlso CInt(yy) >= 1753 AndAlso CInt(yy) <= 9999 Then yok = True
                End If
                If yy = "" Then yok = True
                'MONTH
                If yok = True AndAlso mm <> "" AndAlso IsNumeric(mm) AndAlso mm.Length >= 1 AndAlso mm.Length <= 2 AndAlso CInt(mm) <= 12 Then mok = True
                If mm = "" Then mok = True
                'DAY
                If yok = True AndAlso mok = True AndAlso dd <> "" AndAlso IsNumeric(dd) AndAlso dd.Length >= 1 AndAlso dd.Length <= 2 AndAlso CInt(dd) <= 31 Then dok = True
                If dd = "" Then dok = True

                If dd <> "" AndAlso mm <> "" AndAlso dok And mok And yok Then
                    dok = False
                    If (mm = "1" OrElse mm = "01" OrElse mm = "3" OrElse mm = "03" OrElse mm = "5" OrElse mm = "05" OrElse mm = "7" OrElse mm = "07" OrElse mm = "8" OrElse mm = "08" OrElse mm = "10" OrElse mm = "12") AndAlso CInt(dd) <= 31 Then dok = True
                    If (mm = "4" OrElse mm = "04" OrElse mm = "6" OrElse mm = "06" OrElse mm = "9" OrElse mm = "09" OrElse mm = "11") AndAlso CInt(dd) <= 30 Then dok = True
                    Dim bLeapYear As Boolean = False
                    If yy = "" Then
                        bLeapYear = True
                    Else
                        bLeapYear = Date.IsLeapYear(yy)
                    End If
                    If (mm = "2" OrElse mm = "02") AndAlso bLeapYear = False AndAlso CInt(dd) <= 28 Then dok = True
                    If (mm = "2" OrElse mm = "02") AndAlso bLeapYear = True AndAlso CInt(dd) <= 29 Then dok = True
                End If

                If dok AndAlso mok AndAlso yok Then
                    zzz = zzz.Replace("FF", "TRUE")
                Else
                    zzz = zzz.Replace("FF", "FALSE")
                End If
            End If
        End If

        Return zzz
    End Function

