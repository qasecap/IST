    Sub vfscati(ByVal k As Control, ByVal bvalue As Boolean)
        Dim kk() As String = k.AccessibleDescription.Split(";")
        CType(k, TextBox).Visible = bvalue
        If Not (k.Tag Is Nothing) AndAlso Not (TypeOf k.Tag Is SveZaPolje1) AndAlso k.Tag <> "" AndAlso k.Tag.length > 0 Then
            If k.Tag.Trim.Length >= 1 AndAlso Mid(k.Tag, 1, 1) = "G" Then
                Dim pp As Panel = k.Parent
                Dim rtb As pomTextBox = NadjiKontrolu(pp, "pomocno" & "_" & k.Tag)
                rtb.Visible = bvalue
            Else
                k.Visible = bvalue
            End If
        End If

        If kk.Length > 1 AndAlso kk(1).Trim.Length > 1 AndAlso kk(1).Trim.ToUpper.IndexOf("RG") >= 0 Then    'radiobutton group
            Dim pp As Panel = k.Parent
            Dim imeP As String = pp.Name.Trim.ToUpper.Replace("CATI_", "CATIPOM_")
            Dim pppom As Panel = NadjiKontrolu(Me, imeP)
            For Each c As Control In pppom.Controls
                If TypeOf c Is Panel AndAlso c.Name.Trim.Length > 2 AndAlso Mid(c.Name.Trim.ToUpper, 1, 2) = "RG" AndAlso Mid(c.Name.Trim.ToUpper, 3) = Mid(k.Name.Trim.ToUpper, 3) Then
                    c.Visible = bvalue
                    'Call PonistiRadio(c)
                    Exit For
                End If
            Next
        End If

        If Not (k.Tag Is Nothing) AndAlso TypeOf k.Tag Is SveZaPolje1 Then     'polje sa relacijom
            k.Visible = bvalue
        End If

        If k.Tag Is Nothing Then k.Visible = bvalue
    End Sub

