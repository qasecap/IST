    Private Function UpdateExists(ByVal kljc As String, ByVal dt As DataTable, ByVal dtP As DataTable, ByVal poljaTabeleKojaNisuKljuc As String, ByVal dtr As DataRow) As Boolean
        UpdateExists = False
        Dim kljcBezN As String = kljc
        kljcBezN = kljcBezN.Replace("=N'", "='")
        Dim redP As DataRow() = dtP.Select("2=2 and " + kljcBezN.Replace("=N'", "='"))
        If redP.Length > 0 Then
            For k As Integer = 0 To dtP.Columns.Count - 1
                Dim polje As String = dtP.Columns(k).ColumnName.Trim.ToUpper
                If polje.Trim.ToUpper <> "IST_DURATION" Then
                    If poljaTabeleKojaNisuKljuc.IndexOf("$" + polje + "$") >= 0 Then
                        Dim originalVred As String = ""
                        Dim currentVred As String = ""
                        Dim promena As String = ""
                        'originalVred
                        If Not (redP(0).Item(polje) Is System.DBNull.Value) Then
                            originalVred = redP(0).Item(polje).ToString.Trim
                            If IsBase64String(originalVred) = True Then
                                originalVred = DeKripto(originalVred, DBConnectionString, Me.jezik)
                            End If
                            If dtP.Columns(polje).DataType.Name.ToUpper = "BOOLEAN" Then
                                If originalVred = "TRUE" Then
                                    originalVred = "1"
                                Else
                                    originalVred = "0"
                                End If
                            End If
                        End If
                        'currentVred
                        If Not (dtr.Item(polje) Is System.DBNull.Value) Then
                            currentVred = dtr.Item(polje).ToString.Trim
                            If IsBase64String(currentVred) = True Then
                                currentVred = DeKripto(currentVred, DBConnectionString, Me.jezik)
                            End If
                        End If
                        'INPUT
                        If originalVred = "" And currentVred <> "" Then
                            promena = "IST_INPUT"
                        End If
                        'EDIT
                        If originalVred <> "" And currentVred <> originalVred Then
                            promena = "IST_EDIT"
                        End If
                        If promena <> "" Then
                            UpdateExists = True
                        End If
                    End If
                End If
            Next
        End If
    End Function

    Private Function trebaPanelno(ByVal tbl As String) As Boolean
        'ako je dupe i u T2 ima panel + glava od takvog dupeta
        trebaPanelno = False
        For Each tt As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
            If (Not tt.IsT2Null) AndAlso tt.T2.Trim.ToUpper.IndexOf("PANEL") > -1 Then
                If tt.Tabela.Trim.ToUpper = tbl.Trim.ToUpper OrElse tt.NadTabela.Trim.ToUpper = tbl.Trim.ToUpper Then
                    trebaPanelno = True
                    Exit For
                End If
            End If
        Next
    End Function

    Private Function IstaGlava(ByVal tbl As String, ByVal GlTbl As String) As Boolean
        Dim pom As Boolean = False
        If tbl.Trim.ToUpper = GlTbl.Trim.ToUpper Then Return True
        For Each r As DatasetIstrazivanja.ISTTABELERow In dIst.ISTTABELE.Rows
            If r.Tabela.Trim.ToUpper = tbl.Trim.ToUpper Then
                If r.IsNadTabelaNull OrElse r.NadTabela.Trim = "" Then
                    Return False
                Else
                    If r.NadTabela.Trim.ToUpper = GlTbl.Trim.ToUpper Then
                        Return True
                    Else
                        pom = pom Or IstaGlava(r.NadTabela.Trim.ToUpper, GlTbl)
                    End If
                End If
            End If
        Next
        Return pom
    End Function

