    Private Function mod11_8(ByVal matbr As String) As Boolean
        Dim zbirm11 As Long, delm As Integer
        Dim mbgd As String = matbr
        Dim ost As Integer
        mod11_8 = True
        'mbgd  = matbr
        zbirm11 = Val(Mid(mbgd, 1, 1)) * 2 +
Val(Mid(mbgd, 2, 1)) * 7 +
Val(Mid(mbgd, 3, 1)) * 6 +
Val(Mid(mbgd, 4, 1)) * 5 +
Val(Mid(mbgd, 5, 1)) * 4 +
Val(Mid(mbgd, 6, 1)) * 3 +
Val(Mid(mbgd, 7, 1)) * 2

        delm = 11
        ost = zbirm11 Mod delm
        If ost > 1 Then
            If Val(Mid(mbgd, 8, 1)) <> 11 - ost Then
                ' mbg je pogresan po modulu 11"
                mod11_8 = False
            End If
        ElseIf ost = 1 Then
            If Val(Mid(mbgd, 8, 1)) <> 0 Then
                mod11_8 = False
            End If
        Else
            mod11_8 = False
        End If
    End Function

    Private Function mod11(ByVal mb As String) As Boolean
        mb = mb.Trim
        If mb = "" Then Return False
        Dim la As Integer = mb.Length - 1
        Dim nule As String = "0"
        For i As Integer = 0 To la - 1
            nule = nule & "0"
        Next
        If mb = nule Then Return False
        Dim kb As Integer = CInt(mb.Substring(mb.Length - 1, 1))
        Dim ss As Integer = 0
        For i As Integer = 0 To la - 1
            ss = ss + CInt(mb.Substring(i, 1)) * (((la - i - 1) Mod 6) + 2)
        Next
        Dim dkb As Integer = 11 - ss Mod 11
        If la = 7 Then
            If dkb = 10 Then dkb = 0
            If dkb = 11 Then Return False
        Else
            If dkb > 9 Then dkb = 0
        End If
        If dkb = kb Then
            Return True
        End If
        Return False
    End Function

