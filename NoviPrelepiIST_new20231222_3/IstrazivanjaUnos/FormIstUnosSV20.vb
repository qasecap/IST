                    If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                        'k.AccessibleName = k.AccessibleName + "SHH;"
                        Call addSHH(k, nizskociAKOsss)
                        bbioskippedDontSave = True
                    End If
                    If skippedSetEmpty = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                        ssskippedSetEmpty = True
                        Dim chboxpostoji As Boolean = False
                        If Not nizCHBox Is Nothing Then
                            Dim ikik2 As Integer = -1
                            ikik2 = Array.IndexOf(nizCHBoxIme, k.Name.Trim.ToUpper)
                            If ikik2 > -1 Then
                                DirectCast(k, CheckBox).Checked = False
                                Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "KONTRHH", k.Parent)
                                chboxpostoji = True
                                'ovo radi i za grupe
                            End If
                        End If
                        If chboxpostoji = False Then
                            k.Text = ""
                            Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "KONTRPP", k.Parent)
                            Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                        End If
                    End If
                End If
            End If
        Next
        'ostale grupe
        If ssskippedSetEmpty = True Then
            Dim tblok As Integer = 0
            tblok = Array.IndexOf(grupePitanjaCAPI, cntl.Parent)
            For ii As Integer = tblok + 1 To grupePitanjaCAPI.GetUpperBound(0)
                For Each k As Control In grupePitanjaCAPI(ii).Controls
                    'sve isprazniti
                    If Not TypeOf k Is Label AndAlso Mid(k.Name, 1, 1).Trim.ToUpper <> "F" AndAlso Not TypeOf k Is LinkLabel AndAlso Not TypeOf k Is Button Then
                        Dim chboxpostoji As Boolean = False
                        If Not nizCHBox Is Nothing Then
                            Dim ikik2 As Integer = -1
                            ikik2 = Array.IndexOf(nizCHBoxIme, k.Name.Trim.ToUpper)
                            If ikik2 > -1 Then
                                DirectCast(k, CheckBox).Checked = False
                                Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "KONTRHH", k.Parent)
                                chboxpostoji = True
                                'ovo radi i za grupe
                            End If
                        End If
                        If chboxpostoji = False Then
                            k.Text = ""
                            Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "KONTRPP", k.Parent)
                            Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                        End If
                    End If
                Next
            Next
        End If
    End Sub

    Sub kontrppNovo(ByVal cntl As Control, ByVal pp As Panel, ByVal dppRBR As Integer, ByVal skippedEnabledFalse As Boolean, ByVal skippedVisibleFalse As Boolean, ByVal skippedDontSave As Boolean, ByVal skippedSetEmpty As Boolean, ByVal nizskociAKOsss As String)

        Dim ssskippedSetEmpty As Boolean = False

        For Each k As Control In pp.Controls
            If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel AndAlso Not TypeOf k Is DataGridView2 AndAlso Not TypeOf k Is DataGridView AndAlso Not TypeOf k Is Button AndAlso
                Mid(k.Name, 1, 1).Trim.ToUpper <> "F" AndAlso Not k.AccessibleDescription Is Nothing Then
                If IsNumeric(k.AccessibleDescription.Split(";")(0)) Then
                    Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                    If dppRBR < trenutniRBR Then 'sve od polja sa koga skace pa do kraja ide u ovo dole
                        If skippedEnabledFalse = True Then
                            If Mid(k.Name, 1, 1) <> "F" Then k.Enabled = False
                            k.AccessibleDefaultActionDescription = Mid(cntl.Name, 3)  'ovim oznacavam koja kontrola ga je bacila u enable
                        End If
                        If skippedVisibleFalse = True Then k.Visible = False
                        If skippedDontSave = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                            'k.AccessibleName = k.AccessibleName + "SHH;"
                            Call addSHH(k, nizskociAKOsss)
                            bbioskippedDontSave = True
                        End If
                        If skippedSetEmpty = True AndAlso Mid(k.Name, 1, 1) <> "F" Then
                            ssskippedSetEmpty = True
                            k.Text = ""
                            Me.UpisiPolje(Mid(k.Name, 3).Trim.ToUpper, , "KONTRPP", k.Parent)
                            Call EmptyFPsaVrednoscuIzAWL(k.Parent, Mid(k.Name, 3).Trim.ToUpper)
                        End If
                    End If
                End If
            End If
        Next

    End Sub

    Dim pomSKIFROMTOGROUP As String = ""

    Function sskoci2Grupa(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control,
ByVal nizskociNAsss As String, ByVal maxrbr As Integer, ByVal nizskociAKOsss As String, ByVal nizskociActionsss As String,
Optional ByVal skippedEnabledFalse As Boolean = False, Optional ByVal skippedSetEmpty As Boolean = False,
Optional ByVal skippedVisibleFalse As Boolean = False, Optional ByVal skippedDontSave As Boolean = False,
Optional ByVal nizskippedSetEmptyExcept() As String = Nothing, Optional ByVal nizskippedSetEmptyExceptIF() As String = Nothing, Optional sakljuca As Boolean = False) As Control

        sskoci2Grupa = Nothing

        Dim dd As Integer = 0
        Dim ddugme As String = ""
        Dim ppolje As String = ""
        If nizskociNAsss.IndexOf("PANEL") = 0 AndAlso nizskociNAsss.IndexOf(".") > 0 Then
            dd = nizskociNAsss.IndexOf(".")
            ddugme = "DBTNPANE" + nizskociNAsss.Substring(0, dd).Replace("PANEL", "")
            ppolje = nizskociNAsss.Substring(dd + 1)
        End If

        Dim ppRBR As Integer
        If Not cntl.AccessibleDescription Is Nothing Then ppRBR = cntl.AccessibleDescription.Split(";")(0)

        Dim nizskociNAsssrbr As Integer = 0
        Dim pp As Panel = Nothing
        Dim ind As Integer = Array.IndexOf(nizKontrolaIme, nizskociNAsss)
