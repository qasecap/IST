    Private Sub dpp_GotFocus(ByVal sender As Object, ByVal e As System.EventArgs)

        Dim tbox As Control = sender
        If tbox.Enabled = True AndAlso tbox.TabStop = True Then
            tbox.BackColor = Color.Bisque
            If tbox.AccessibleName Is Nothing OrElse tbox.AccessibleName.IndexOf("AUTB") < 0 Then
                tbox = CType(sender, TextBox)
                CType(sender, TextBox).SelectAll()
            End If
        End If

    End Sub

    Private Sub dpp_LostFocus(ByVal sender As Object, ByVal e As System.EventArgs)
        Dim tbox As Control = sender
        If Not tbox.AccessibleName Is Nothing Then tbox.AccessibleName = tbox.AccessibleName + ";" : tbox.AccessibleName = tbox.AccessibleName.Replace(";;", ";")
        If Not (tbox.AccessibleName Is Nothing OrElse tbox.AccessibleName.IndexOf("AUTB") < 0) Then
            If DirectCast(tbox, AutoCompleteTextbox).izUpa = True Then
                Call dpp_ValidacijaLeftUp(sender, Nothing)
                If okvalidacija = False Then
                    sender.focus()
                    Exit Sub
                End If
                If okvalidacija = True Then
                    If tbox.BackColor = Color.Bisque Then tbox.BackColor = SystemColors.ControlLightLight
                End If
            Else
                If tbox.BackColor = Color.Bisque Then tbox.BackColor = SystemColors.ControlLightLight

            End If
            DirectCast(tbox, AutoCompleteTextbox).uradidodeluSilom = False
        Else
            If tbox.BackColor = Color.Bisque Then tbox.BackColor = SystemColors.ControlLightLight
        End If
    End Sub
