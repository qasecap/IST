    Sub bToLabel(ByVal pp() As String, ByVal p As Integer, Optional ByVal space As String = "")
        Dim sqlI As String = ""
        Dim sqlDB As String = ""
        Dim sqlDBDropTip As String = ""
        Dim DropTip As String = ""
        Dim poljaDB As String = ""

        Dim pizraz As String = "'' ''"
        If space = "space" Then pizraz = "$''''"

        If p = 0 Then   'cell/field
            sqlI = " update a set a.izraz='" + pizraz + "'" +
                              " from istpolja a inner Join vrepISTPolja b On a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                              " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and a.polje=N'" + pp(2).Trim + "'" +
                              " and cast (a.vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"


        End If
        If p > 0 Then   'red/kolona
            Dim trk() As String = pp(3).Split(".")
            If trk.Length = 3 Then
                Dim currenttab As Integer = CInt(trk(0).Trim)
                Dim currentred As Integer = CInt(trk(1).Trim)
                Dim currentkol As Integer = CInt(trk(2).Trim)
                If p = 1 Then
                    sqlI = " update a set a.izraz='" + pizraz + "'" +
                    " from istpolja a inner Join vrepISTPolja b On a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                    " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(a.forma)) like '" + CStr(currenttab).Trim + "." + CStr(currentred).Trim + ".%'" +
                    " and cast (a.vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"

                    sqlDB = "select a.polje " +
                    " from istpolja a inner Join vrepISTPolja b On a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                    " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(a.forma)) like '" + CStr(currenttab).Trim + "." + CStr(currentred).Trim + ".%'" +
                    " and cast (a.vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "' and b.pp<>'lbl' and b.pp not like 'fp%'"
                End If
                If p = 2 Then
                    sqlI = " update a set a.izraz='" + pizraz + "'" +
                    " from istpolja a inner Join vrepISTPolja b On a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                    " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(a.forma)) like '" + CStr(currenttab).Trim + ".%." + CStr(currentkol).Trim + "'" +
                    " and cast (a.vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"

                    sqlDB = "select a.polje " +
                    " from istpolja a inner Join vrepISTPolja b On a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" + nvrd +
                    " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and ltrim(rtrim(a.forma)) like '" + CStr(currenttab).Trim + ".%." + CStr(currentkol).Trim + "'" +
                    " and cast (a.vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "' and b.pp<>'lbl' and b.pp not like 'fp%'"
                End If

                Dim ppp As DialogResult = ISTMessageBox.Show("Do you want to drop columns from DB (if exists)?", "Drop columns?", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Exclamation, MessageBoxDefaultButton.Button2)
                Select Case ppp
                    Case DialogResult.Yes
                        Dim dtpom As DataTable = izvrsiSQLvratiDT(sqlDB, Me.ISTConnectionString, Nothing)
                        If dtpom.Rows.Count > 0 Then
                            poljaDB = ""
                            For i As Integer = 0 To dtpom.Rows.Count - 1
                                poljaDB = poljaDB + dtpom.Rows(i).Item(0).ToString.Trim + ","
                            Next
                            poljaDB = poljaDB.Trim + "$"
                            poljaDB = poljaDB.Replace(",$", ";")
                        End If
                    Case DialogResult.No
                        sqlDB = "" : poljaDB = ""
                    Case DialogResult.Cancel
                        Exit Sub
                End Select

            End If
        End If

        If poljaDB <> "" Then
            sqlDB = "ALTER TABLE " + pp(0).Trim + " DROP COLUMN " + poljaDB + ";" + nvrd
            sqlDBDropTip = pp(0).Trim + ";" + poljaDB
            DropTip = "DROP"
        End If

        Dim p2 As String = "nok"
        p2 = napraviBackUpizvrsiSQL(sqlI, , sqlDBDropTip, DropTip)

        Dim p2DB As String = "nok"
        If poljaDB <> "" Then
            p2DB = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
        Else
            p2DB = "ok"
        End If

        If p2 = "nok" OrElse p2DB = "nok" Then ISTMessageBox.Show("Error!") Else Call subREFRESH("C")
    End Sub

