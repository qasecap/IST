        End Try

        Dim dodeliKome As String = ""
        Dim nizdodeliKome() As String = {}
        Dim dodeliSta As String = ""
        Dim nizdodeliSta() As String = {}
        Dim dodeliAko As String = ""
        Dim nizdodeliAko() As String = {}
        Dim nizProvera() As String = {}

        Dim avltekst As String = ""

        If pomDO.Length > 0 AndAlso pomDO.Trim.IndexOf("#{") = 0 Then
            pomDO = pomDO.Replace("#{", "")
            pomDO = pomDO.Replace("}", "")
            pomDO = pomDO.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
            nizProvera = Split(pomDO, ";")
            For i As Integer = 0 To nizProvera.GetUpperBound(0)
                If nizProvera(i).Trim.ToUpper.IndexOf("DODELIKOME=") >= 0 Then
                    dodeliKome = NZ(Replace(nizProvera(i), "dodelikome=", "", 1, , CompareMethod.Text)).Trim
