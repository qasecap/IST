                    End If
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message)
                End Try
                Dim frm As New FormIstUnosSV20(Me.dIst, mdtLabel, mdtAWL, mdtQE, mdtMessage, Me.DBConnectionString, Me.mvt, imeTabele, False, Me.txtInst, Me.txtpismo, Me.txtmode, Me.jezik, Me.ISTConnectionString,
                            Me.DSBrisanjeDEPO.Trim.ToUpper, Me.DSBrisanjeServer.Trim.ToUpper, Me.DSBrisanjeBaza.Trim.ToUpper, , Me.zakljucanOdmahSve,
