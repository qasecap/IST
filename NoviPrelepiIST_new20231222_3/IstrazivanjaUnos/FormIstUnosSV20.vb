    Private Function DGi(ByVal imetabele As String, Optional ByVal DTNiz() As DataTable = Nothing) As Integer
        'AAAAAAAAAAAAAAAAAA
        Dim pp() As String
        Dim prefixx As String = "DBO"
        Dim tabbb As String = imetabele
        Dim ostavikakoje As Boolean = False
        tabbb = tabbb.Trim.ToUpper.Replace("CONVERT", "CAST").Replace(",'SYSTEM.INT32'", " as integer").Replace(", 'SYSTEM.INT32'", " as integer").Replace(",'SYSTEM.INT32' ", " as integer").Replace(", 'SYSTEM.INT32' ", " as integer")
        If tabbb.IndexOf(".") > 0 AndAlso tabbb.LastIndexOf(".") > 0 Then
            If tabbb.IndexOf(".") <> tabbb.LastIndexOf(".") Then
                'ima bar 2 tacke, ne diraj RPJ.DBO.OPSTINE
                ostavikakoje = True
            Else
                pp = tabbb.Split(CType(".", Char()))
                prefixx = pp(0).Trim.ToUpper
                tabbb = pp(1).Trim.ToUpper
                'Dim tabela As String = prefixx + "." + tabbb
            End If
        End If

        If DTNiz Is Nothing Then
            For i As Integer = 0 To DGTabele.GetUpperBound(0)
                Dim ppp As String = DGTabele(i).TableName.Trim.ToUpper
                ppp = ppp.Trim.ToUpper.Replace("CONVERT", "CAST").Replace(",'SYSTEM.INT32'", " as integer").Replace(", 'SYSTEM.INT32'", " as integer").Replace(",'SYSTEM.INT32' ", " as integer").Replace(", 'SYSTEM.INT32' ", " as integer")

                If ostavikakoje = False Then
                    If DGTabele(i).Prefix.Trim.ToUpper = "" Then DGTabele(i).Prefix = "DBO"
                    If DGTabele(i).Prefix.Trim.ToUpper = prefixx AndAlso ppp.Trim.ToUpper = tabbb.Trim.ToUpper Then Return i
                Else
                    If ppp.Trim.ToUpper = tabbb.Trim.ToUpper Then Return i
                End If

            Next
            Return -1
        Else
            For i As Integer = 0 To DTNiz.GetUpperBound(0)
                If Not DTNiz(i) Is Nothing Then
                    Dim dtnizprefixx As String = DTNiz(i).Prefix.Trim.ToUpper
                    If dtnizprefixx.Trim = "" Then dtnizprefixx = "DBO"
                    Dim dtniztabbb As String = DTNiz(i).TableName.Trim.ToUpper
                    dtniztabbb = dtniztabbb.Trim.ToUpper.Replace("CONVERT", "CAST").Replace(",'SYSTEM.INT32'", " as integer").Replace(", 'SYSTEM.INT32'", " as integer").Replace(",'SYSTEM.INT32' ", " as integer").Replace(", 'SYSTEM.INT32' ", " as integer")
                    If dtniztabbb.IndexOf(".") > 0 AndAlso dtniztabbb.LastIndexOf(".") > 0 Then
                        If dtniztabbb.IndexOf(".") <> dtniztabbb.LastIndexOf(".") Then
                            'ima bar 2 tacke, ne diraj RPJ.DBO.OPSTINE
                            ostavikakoje = True
                        Else
                            pp = dtniztabbb.Split(CType(".", Char()))
                            dtnizprefixx = pp(0).Trim.ToUpper
                            dtniztabbb = pp(1).Trim.ToUpper
                        End If
                    End If

                    If ostavikakoje = False Then
                        If dtnizprefixx = prefixx AndAlso tabbb = dtniztabbb Then Return i
                    Else
                        If tabbb = dtniztabbb Then Return i
                    End If
                End If

            Next
