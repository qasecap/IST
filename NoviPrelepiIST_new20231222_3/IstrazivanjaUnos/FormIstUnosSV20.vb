    Private Sub DGNull(ByVal DG As DataGrid)

        Dim cm As CurrencyManager = CType(Me.BindingContext(DG.DataSource), CurrencyManager)
        Dim rowCount As Integer = cm.Count

        Dim preradiGrid As Boolean = False
        Dim resizeGrid As Boolean = False
        Dim t As String = DG.Name.Trim.ToUpper
        Dim trtT2 As String = DGPOMT2(Array.IndexOf(DGPOMtabele, t)).Trim.ToUpper

        Dim i As Integer = -1
        Dim pravapolja() As String = {}
        Dim dtpolja() As String = {}
        Dim dtable As DataTable = CType(DG.DataSource, DataTable)
        For m As Integer = 0 To dtable.Columns.Count - 1
            ReDim Preserve dtpolja(m)
            dtpolja(m) = dtable.Columns(m).ColumnName.Trim.ToUpper
        Next

        If trtT2.IndexOf("GRIDPOLJAIST") > -1 OrElse trtT2.IndexOf("GRIDCOLUMNSIST") > -1 Then
            preradiGrid = True
            For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                If p.TABELA.ToUpper.Trim = t Then
                    If Array.IndexOf(dtpolja, p.POLJE.Trim.ToUpper) > -1 Then
                        i = i + 1
                        ReDim Preserve pravapolja(i)
                        pravapolja(i) = p.POLJE.Trim.ToUpper
                    End If
                End If
            Next
        End If

        Dim ts As New AutoResizeDataGridTableStyle
        Dim nime As String = DG.Name
        If DG.Name.Trim.IndexOf(".") Then
            Dim p() As String = DG.Name.Trim.Split(".")
            If p.Length > 1 Then nime = p(1).Trim
        End If

        ts.MappingName = nime

        DG.TableStyles.Clear()
        DG.TableStyles.Add(ts)

        Dim colCount As Integer = (CType(DG.DataSource, DataTable)).Columns.Count
        Dim row As Integer = 0
        Dim col As Integer = 0

        Dim g As Graphics = Graphics.FromHwnd(DG.Handle)
        If DG.TableStyles(ts.MappingName).GridColumnStyles.Count = 0 Then DG.TableStyles.Add(ts)
        If trtT2.IndexOf("GRIDCOLAUTORESIZE") > -1 Then resizeGrid = True

        If colCount > 0 Then
            For col = 0 To colCount - 1
                Try
                    DG.TableStyles(ts.MappingName).GridColumnStyles(col).NullText = ""
                    Dim h As String = DG.TableStyles(ts.MappingName).GridColumnStyles(col).HeaderText.Trim.ToUpper
                    If resizeGrid = True Then
                        'prema header tekstu
                        Dim m As Integer = DG.TableStyles(ts.MappingName).GridColumnStyles(col).HeaderText.Trim.Length
                        DG.TableStyles(ts.MappingName).GridColumnStyles(col).Width = m * 9
                        'prema sadržaju kolone
                    End If

                    If preradiGrid = True AndAlso Array.IndexOf(pravapolja, h) = -1 Then
                        DG.TableStyles(ts.MappingName).GridColumnStyles(col).Width = 0
                        'ElseIf preradiGrid = True AndAlso Array.IndexOf(pravapolja, h) > -1 Then
                        'DG.TableStyles(ts.MappingName).SetOrdinal(Array.IndexOf(pravapolja, h))
                    End If
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message)
                End Try
            Next
        End If
        ts = Nothing
        g.Dispose()
    End Sub


