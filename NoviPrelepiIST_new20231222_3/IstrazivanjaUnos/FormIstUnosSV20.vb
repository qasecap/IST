    Function sklopiDataGridView(ByVal t As String, ByVal imaMaxZaGrid As Boolean, ByVal imaMinzaGrid As Boolean, ByVal imaGridH As Boolean, ByVal tabT2 As String, ByVal imavidljivGrid As Boolean, ByVal imaPlus As Boolean, ByVal imaSpaceIzmedjuGridova As Boolean) As DataGridView
        Dim dg As New DataGridView
        dg.ReadOnly = True
        dg.Font = New Font("Verdana", 8.0!)
        dg.BorderStyle = BorderStyle.None

        dg.TabStop = False
        dg.Name = t.Trim.ToUpper
        dg.AllowUserToAddRows = False
        dg.AllowUserToDeleteRows = False
        dg.MultiSelect = False

        AddHandler dg.DoubleClick, AddressOf Me.DGDupliKlik
        AddHandler dg.MouseDown, AddressOf Me.DGMouseDown
        AddHandler dg.Scroll, AddressOf Me.DG_Scroll
        AddHandler dg.ColumnAdded, AddressOf Me.DG_ColumnAdded

        dg.Width = Me.Panel1.Width - 25
        'default dg.height je 80
        If PravaDupeGlava(t) Then   'ako nije 1-1, nego 1-n
            If imaMaxZaGrid Then
                dg.Height = 2 * 3 * dg.Height
            ElseIf imaMinzaGrid Then
            Else
                dg.Height = 3 * dg.Height
            End If
            dg.Height = 0.5 * dg.Height
            If imaGridH Then
                Try
                    Dim a As String = tabT2.Substring(tabT2.Trim.ToUpper.IndexOf("GRIDHEIGHT"))
                    Dim aa() As String = a.Split(";")
                    Dim visina As Integer = aa(0).Split("=")(1)
                    dg.Height = visina
                Catch ex As Exception
                    ''msg 24
                    Dim msgtxt As String = getMessageText(dtMessages, "24", Me.jezik)
                    ISTMessageBox.Show(msgtxt, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                End Try
            End If
        End If

        Dim dv As DataView = DGTabele(DGi(t.Trim.ToUpper)).DefaultView
        Dim Kljucevi() As String = DajKljuceve(t)
        Dim klj As String = ""
        For i As Integer = 0 To Kljucevi.GetUpperBound(0)
            klj = klj + Kljucevi(i) + ","
        Next
        klj = klj.TrimEnd(",")
        dv.Sort = klj '+ " ASC"
        'dg.DataSource = DGTabele(DGi(t.Trim.ToUpper))
        dg.DataSource = dv
        dg.SendToBack()
        Me.Panel1.Controls.Add(dg)
        dg.BringToFront()
        If imavidljivGrid Then
            dg.Visible = True
        Else
            dg.Visible = False
        End If
        dg.Location = New Point(0, Me.Panel1.Height)

        If imaPlus = False Then
            Me.Panel1.Height = Me.Panel1.Height - 4   '(-4 razmak izmedju dugmadi )
        Else
            If imaSpaceIzmedjuGridova Then
                Me.Panel1.Height = Me.Panel1.Height + dg.Height
            Else
                Me.Panel1.Height = Me.Panel1.Height - 4   '(-4 razmak izmedju dugmadi )
            End If
        End If

        Call srediGridView(dg, True, 30)

        Return dg
    End Function
