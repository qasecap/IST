    Private Sub DopuniUnosIzLK(Optional mpp As Panel = Nothing)

        Dim panel As Panel = Me.Panel1
        If SCati = True AndAlso Not mpp Is Nothing Then panel = mpp
        Dim greske As DataRow() = dIst.ISTLK.Select("2=2 and tabela='" + Me.GlavnaTabela.Trim.ToUpper + "' and isnull(USLOV,'') not like '%ExecuteOnlyOnAddedButtonControl%' and isnull(USLOV,'') not like '%LKVELIKA%' and isnull(USLOV,'') not like '%ExecuteOnlyFromDataValidationModule%'") 'and isnull(USLOV,'') not like '%DONTSEND%'

        Dim pp, pz, zz As Integer
        'For Each k As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
        For K As Integer = 0 To greske.Length - 1
            If greske(K).Item("TABELA").Trim.ToUpper = Me.GlavnaTabela.Trim.ToUpper Then
                Dim g As String = greske(K).Item("GRESKA").Trim.ToUpper
                If g.IndexOf("#KONSULT{") >= 0 Then
                    pp = g.IndexOf("#KONSULT{")
                    pz = InStr(pp + 1, g, "{")
                    zz = ZavrZnak(Mid(g, pz + 1), "{", "}")
                    g = Mid(g, pz + 1, zz - 1)
                    pp = g.IndexOf(":")
                    If pp >= 0 Then
                        Dim plj As String = Mid(g, 1, pp).Trim.ToUpper
                        Dim d() As String = Split(g.Substring(pp + 1), ",")
                        If Array.IndexOf(GlavniKljuc, plj) >= 0 Then
                            For Each c As Control In Me.Controls
                                If c.Name.Trim.Length > 2 AndAlso c.Name.Trim.ToUpper.Substring(2) = plj Then
                                    For Each cc As Control In c.Controls
                                        If cc.Name.Trim.ToUpper = "TK" & plj Then
                                            If Not (cc.Tag Is Nothing) AndAlso cc.Tag.tip = "K" Then
                                                cc.Tag.Dodela = d
                                            End If
                                        End If
                                    Next
                                End If
                            Next
                        Else 'nije u glavnom kljucu, nego u Panel1.....
                            For Each c As Control In panel.Controls
                                If c.Name.Trim.ToUpper = "TP" & plj Then
                                    If Not (c.Tag Is Nothing) AndAlso c.Tag.tip = "K" Then
                                        c.Tag.Dodela = d
                                    End If
                                End If
                            Next
                        End If
                    End If
                ElseIf g.IndexOf("#ADRESAR{") >= 0 Then
                    pp = g.IndexOf("#ADRESAR{")
                    Dim ad As New SveZaPolje1
                    ad.Tip = "A"
                    pz = InStr(pp + 1, g, "{")
                    zz = ZavrZnak(Mid(g, pz + 1), "{", "}")
                    g = Mid(g, pz + 1, zz - 1).Trim.ToUpper
                    pp = g.IndexOf(":")
                    If pp >= 0 Then
                        ad.Dodela = Split(g.Substring(pp + 1), ",")
                        g = Mid(g, 1, pp) '.Trim.ToUpper
                    End If
                    Dim ib As DatasetIstrazivanja.ISTRow = dIst.IST.Rows(0)
                    ad.Rel(0) = ib.BAZA.Trim.ToUpper
                    ad.Rel(1) = g.Substring(0, g.IndexOf(";"))
                    ad.TPolja = Split(g.Substring(g.IndexOf(";") + 1), ",")
                    For i As Integer = 0 To ad.TPolja.GetUpperBound(0)
                        If ad.TPolja(i).IndexOf("#") >= 0 Then ad.TPolja(i) = PrevediF(ad.TPolja(i))
                    Next
                    Dim aplj() As String = {}
                    For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                        If p.TABELA.Trim.ToUpper = ad.Rel(1) Then
                            If Not p.IsKLJUCNull AndAlso p.KLJUC.Trim.ToUpper = "P" Then
                                ReDim Preserve aplj(aplj.GetUpperBound(0) + 1)
                                aplj(aplj.GetUpperBound(0)) = p.POLJE.Trim.ToUpper
                            End If
                        End If
                    Next
                    ad.APolja = aplj
                    For i As Integer = 0 To ad.TPolja.GetUpperBound(0)
                        Dim plj As String = ad.TPolja(i).Trim.ToUpper
                        ad.Rel(2) = ""
                        If Array.IndexOf(GlavniKljuc, plj) >= 0 Then
                            For Each c As Control In Me.Controls
                                If c.Name.Trim.Length > 2 AndAlso c.Name.Trim.ToUpper.Substring(2) = plj Then
                                    For Each cc As Control In c.Controls
                                        If cc.Name.Trim.ToUpper = "TK" & plj Then
                                            cc.Tag = ad
                                        End If
                                    Next
                                End If
                            Next
                        Else 'nije u glavnom kljucu, nego u Panel1.....
                            For Each c As Control In panel.Controls
                                If c.Name.Trim.ToUpper = "TP" & plj Then
                                    c.Tag = ad
                                End If
                            Next
                        End If 'GlavniKljuc
                    Next
                ElseIf g.IndexOf("#RELACIJA{") >= 0 Then

                    pp = g.IndexOf("#RELACIJA{")

                    Dim ad As New SveZaPolje1
                    ad.Tip = "R"
                    ad.alwaysfromcodebook = "0"

                    pz = InStr(pp + 1, g, "{")
                    zz = ZavrZnak(Mid(g, pz + 1), "{", "}")
                    g = Mid(g, pz + 1, zz - 1).Trim.ToUpper

                    If g.Trim.ToUpper.IndexOf("ALWAYSFROMCODEBOOK") >= 0 Then
                        ad.alwaysfromcodebook = "1"
                        g = NZ(Replace(g, "alwaysfromcodebook", "", 1, , CompareMethod.Text)).Trim
                        g = g.Replace(";;", "")
                        If g.Substring(g.Length - 1) = ";" Then g = g.Substring(0, g.Length - 1)
                    End If

                    pp = g.IndexOf(":")
                    If pp >= 0 Then
                        ad.Dodela = Split(g.Substring(pp + 1), ",")
                        g = Mid(g, 1, pp) '.Trim.ToUpper
                    End If
                    ad.Rel(1) = g.Substring(0, g.IndexOf(";"))
                    ad.TPolja = Split(g.Substring(g.IndexOf(";") + 1), ",")

                    Dim ib As DatasetIstrazivanja.ISTRow = dIst.IST.Rows(0)
                    ad.Rel(0) = ib.BAZA.Trim.ToUpper

                    'zamena GGGMMM
                    If ad.Rel(1).Trim.ToUpper.IndexOf("SELECT") > 0 Then
                        Dim sql As String
                        sql = ad.Rel(1).Trim.ToUpper
                        sql = ZameniGGGMMMUnos(sql)
                        ad.Rel(1) = sql
                    End If

                    If ad.Rel(1).Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse ad.Rel(1).Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
                        'nadji nadtabela sta je
                        Dim nadtabela As String = nadtabelaJe(Me.GlavnaTabela)
                        Dim zzz As String = ad.Rel(1).ToString.Trim
                        Dim zm() As String = razkvantaj(zzz)
                        For i As Integer = 0 To zm.Length() - 1
                            zm(i) = GlavaHead(zm(i), DTbl(DGi(nadtabela)).Rows(0))
                        Next
                        zzz = ustringaj(zm).ToUpper
                        ad.Rel(1) = zzz
                    End If

                    For i As Integer = 0 To ad.TPolja.GetUpperBound(0)
                        If ad.TPolja(i).IndexOf("#") >= 0 Then ad.TPolja(i) = PrevediF(ad.TPolja(i))
                    Next

                    Dim aplj() As String = {}
                    For Each p As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
                        If p.TABELA.Trim.ToUpper = ad.Rel(1) Then
                            If Not p.IsKLJUCNull AndAlso p.KLJUC.Trim.ToUpper = "P" Then
                                ReDim Preserve aplj(aplj.GetUpperBound(0) + 1)
                                aplj(aplj.GetUpperBound(0)) = p.POLJE.Trim.ToUpper
                            End If
                        End If
                    Next
                    ad.APolja = aplj
                    For i As Integer = 0 To ad.TPolja.GetUpperBound(0)
                        Dim plj As String = ad.TPolja(i).Trim.ToUpper
                        Dim pplj() As String = Split(plj, "=")
                        For im As Integer = 0 To pplj.GetUpperBound(0)
                            pplj(im) = pplj(im).Trim
                        Next
                        ad.Rel(2) = ""
                        If Array.IndexOf(GlavniKljuc, pplj(0)) >= 0 Then
                            For Each c As Control In Me.Controls
                                If c.Name.Trim.Length > 2 AndAlso c.Name.Trim.ToUpper.Substring(2) = pplj(0) Then
                                    For Each cc As Control In c.Controls
                                        If cc.Name.Trim.ToUpper = "TK" & pplj(0) Then
                                            cc.Tag = ad
                                        End If
                                    Next
                                End If
                            Next
                        Else 'nije u glavnom kljucu, nego u Panel1.....
                            If grupePitanjaCAPI Is Nothing Then
                                For Each c As Control In panel.Controls
                                    If c.Name.Trim.ToUpper = "TP" & pplj(0) Then
                                        c.Tag = ad
                                    ElseIf c.Name.Trim.ToUpper = "FP" & pplj(0) Then
                                        c.Tag = ad
                                    End If
                                Next
                            Else
                                For ii As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                                    For Each kk As Control In grupePitanjaCAPI(ii).Controls
                                        If kk.Name.Trim.ToUpper = "TP" & pplj(0) Then
                                            kk.Tag = ad
                                        ElseIf Kk.Name.Trim.ToUpper = "FP" & pplj(0) Then
                                            kk.Tag = ad
                                        End If
                                    Next
                                Next
                            End If

                        End If 'GlavniKljuc
                    Next
                Else 'od if konsult elseif adresar elseif relacija....
                End If
            End If
        Next
    End Sub

