                'nizKontrolaAWLformat(iKontrolaAWL) = awlNovofFormat

                If pOd.Trim.ToUpper.IndexOf("ASSIGNWHAT=") > -1 AndAlso pOd.Trim.ToUpper.IndexOf("AWLVALUE") > -1 Then
                    nizKontrolaAWLImaAssign(iKontrolaAWL) = "1"   'ima assign
                    Dim pp() As String = pOd.Split(";")
                    Dim aw As String = ""
                    Dim at As String = ""
                    Dim pomassingto As Boolean = False
                    For i As Integer = 0 To pp.GetUpperBound(0)
                        pp(i) = pp(i).Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                        If pp(i).Trim.ToUpper.Replace("{", "").Replace("}", "").IndexOf("ASSIGNWHAT=") = 0 And pp(i).Trim.ToUpper.IndexOf("AWLVALUE") > -1 Then 'ASSIGN moze da nema awlvalue, a npr. u addmisingvalue ima AWL
                            nizKontrolaAWLAssignWhat(iKontrolaAWL) = pp(i).Trim.ToUpper.Replace("ASSIGNWHAT=", "")
                            Dim mm() As String = pp(i).Trim.ToUpper.Replace("ASSIGNWHAT=", "").Split("$")
                            If mm.Length > 0 Then
                                For j As Integer = 0 To mm.GetUpperBound(0)
                                    If mm(j).Trim.ToUpper.Replace("{", "").Replace("}", "").IndexOf("AWLVALUE") = 0 Then aw = aw + Str(j).Trim + ","
                                Next
                            End If
                            pomassingto = True
                        ElseIf pp(i).Trim.ToUpper.Replace("{", "").Replace("}", "").IndexOf("ASSIGNIF=") = 0 Then
                            nizKontrolaAWLAssignIf(iKontrolaAWL) = pp(i).Trim.ToUpper.Replace("ASSIGNIF=", "")
                            'Exit For
                        End If
                    Next
                    If pomassingto = True Then
                        aw = aw.TrimEnd(",")
                        Dim aww() As String = aw.Split(",")
                        For i As Integer = 0 To pp.GetUpperBound(0)
                            If pp(i).Trim.ToUpper.IndexOf("ASSIGNTO=") = 0 Then
                                Dim mm22() As String = pp(i).Trim.ToUpper.Replace("{", "").Replace("}", "").Replace("ASSIGNTO=", "").Split("$")
                                Dim tzu As String = ""
                                For mm As Integer = 0 To aww.GetUpperBound(0)
                                    tzu = tzu + mm22(aww(mm)) + ","
                                Next
                                nizKontrolaAWLAssignTo(iKontrolaAWL) = tzu.TrimEnd(",").Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                            End If
                        Next
                    End If
                End If
            End If
        End If


        Return tbox
    End Function
    Function dajTextZaAwlsIzISTAwls(ByVal awlNovo() As DataRow) As String
        Dim awltext As String = ""
        For k As Integer = 0 To awlNovo.GetUpperBound(0)
            If awlNovo(k).Item("qmt").Trim.toupper.indexof("Q") = 0 Then
                awltext = awltext + awlNovo(k).Item("Ttext") + nvrd + nvrd
            ElseIf awlNovo(k).Item("qmt").Trim.toupper.indexof("T") = 0 Then
                awltext = awltext + nvrd + awlNovo(k).Item("Ttext")
            ElseIf awlNovo(k).Item("qmt").Trim.toupper.indexof("M0") = 0 Then
                awltext = awltext + awlNovo(k).Item("qmt").trim.toupper.replace("M0", "") + ". " + awlNovo(k).Item("Ttext") + nvrd
            Else
                awltext = awltext + awlNovo(k).Item("qmt").trim.toupper.replace("M", "") + ". " + awlNovo(k).Item("Ttext") + nvrd
            End If
        Next
        dajTextZaAwlsIzISTAwls = awltext

    End Function
    Function sklopiFP(ByVal p As DatasetIstrazivanja.ISTPOLJARow,
ByVal zadnjitabindex As Integer,
ByVal multiline As Boolean,
Optional ByVal nonvisible As Boolean = False,
Optional ByVal fbold As Boolean = False,
Optional ByVal fitalic As Boolean = False,
Optional ByVal funderline As Boolean = False,
Optional ByVal fborderfixed As Boolean = False,
Optional ByVal fbordernone As Boolean = False,
Optional ByVal fpdesnop As Boolean = False, Optional ByVal fpcentarp As Boolean = False,
Optional ByVal fFORECOLORP As String = "", Optional ByVal fBACKCOLORP As String = "",
Optional ByVal fSize As Integer = 0,
Optional ByVal pomIzraz As String = "") As TextBox

        Dim fptbox As New TextBox
        fptbox.AutoSize = False
        fptbox.Height = 22

        Dim hh As Integer = 0
        Dim ww As Integer = 0
        If Not p.IsVSNull AndAlso p.VS.Trim.IndexOf(";") >= 0 Then
            hh = Val(Split(p.VS.Trim, ";")(1))
            ww = Val(Split(p.VS.Trim, ";")(0))
        End If
        fptbox.BackColor = RGBColors.mBackColor
        Try
            If fBACKCOLORP <> "" AndAlso fBACKCOLORP <> "TRANSPARENT" AndAlso fBACKCOLORP <> "CHOCALATE" AndAlso fBACKCOLORP <> "LAVANDER" Then fptbox.BackColor = Color.FromName(fBACKCOLORP)
            If fFORECOLORP <> "" Then
                If fBACKCOLORP = "" Then fptbox.BackColor = RGBColors.mBackColor ' fptbox.BackColor = SystemColors.Control
                fptbox.ForeColor = Color.FromName(fFORECOLORP)
            End If
        Catch ex As Exception
            ISTMessageBox.Show(p.POLJE + nvrd + ex.Message + nvrd + "foreColor:" + fFORECOLORP + nvrd + "backColor:" + fBACKCOLORP)
        End Try

        fptbox.Name = "FP" & p.POLJE.Trim.ToUpper
        fptbox.TabIndex = zadnjitabindex
        fptbox.ReadOnly = True
        fptbox.TabStop = False
        If multiline = True Then fptbox.Multiline = True
        fptbox.BorderStyle = BorderStyle.FixedSingle
        If fborderfixed Then fptbox.BorderStyle = BorderStyle.FixedSingle
        If fbordernone Then
            fptbox.BorderStyle = BorderStyle.None
        End If

        If fpdesnop Then fptbox.TextAlign = HorizontalAlignment.Right
        If fpcentarp Then fptbox.TextAlign = HorizontalAlignment.Center

        If nonvisible = True Then fptbox.Visible = False : fptbox.AccessibleName = fptbox.AccessibleName + "VF;"
        If fSize = 0 Then fSize = Me.Font.Size

        ft = FontStyle.Regular
        ftB = FontStyle.Bold
        ftI = FontStyle.Italic
        ftU = FontStyle.Underline

        'B I U
        If TTfontBold = True And TTfontItalic = True And TTfontUnderline = True Then ft = ftB Or ftI Or ftU
        If TTfontBold = True And TTfontItalic = True And TTfontUnderline = False Then ft = ftB Or ftI
        If TTfontBold = True And TTfontItalic = False And TTfontUnderline = False Then ft = ftB
        If TTfontBold = True And TTfontItalic = False And TTfontUnderline = True Then ft = ftB Or ftU
        If TTfontBold = False And TTfontItalic = True And TTfontUnderline = True Then ft = ftI Or ftU
        If TTfontBold = False And TTfontItalic = False And TTfontUnderline = True Then ft = ftU
        If TTfontBold = False And TTfontItalic = True And TTfontUnderline = False Then ft = ftI
        'B I U
        If fbold = True And fitalic = True And funderline = True Then ft = ftB Or ftI Or ftU
        If fbold = True And fitalic = True And funderline = False Then ft = ftB Or ftI
        If fbold = True And fitalic = False And funderline = False Then ft = ftB
        If fbold = True And fitalic = False And funderline = True Then ft = ftB Or ftU
        If fbold = False And fitalic = True And funderline = True Then ft = ftI Or ftU
        If fbold = False And fitalic = False And funderline = True Then ft = ftU
        If fbold = False And fitalic = True And funderline = False Then ft = ftI

        fptbox.Font = New Font(Me.Font.Name, fSize, ft)

        AddHandler fptbox.MouseMove, AddressOf Me.ppF_MouseMove
        AddHandler fptbox.Enter, AddressOf Me.ppF_Enter
        AddHandler fptbox.PreviewKeyDown, AddressOf Me.pf_PreviewKeyDown
        If previewEditMode = True Then
            fptbox.ContextMenuStrip = mnu02
            'AddHandler fptbox.MouseDoubleClick, AddressOf Me.pp_MouseDoubleClick
            Dim pomforma As String = ""
            If p.IsFormaNull = False Then pomforma = p.Forma.Trim
            fptbox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.Vod.ToString("yyyy/MM/dd").Trim + ";" + fptbox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim
        End If
        fptbox.Tag = New SveZaPolje1
        fptbox.Tag.Tip = "F"
        If InStr(pomIzraz, "#") > 0 Then
            fptbox.Tag.rel(0) = "#"
            Dim zzz As String = pomIzraz '.ToUpper
            If zzz.Substring(0, 2) = "#{" Then zzz = zzz.Substring(2)
            If zzz.Substring(zzz.Length - 1) = "}" Then zzz = zzz.Substring(0, zzz.Length - 1)
            ' nema potrebe vise za :S :P - izbaceno
            fptbox.Tag.rel(1) = ""
            fptbox.Tag.rel(2) = ""
            If InStr(zzz, ":") <> 0 Then
                fptbox.Tag.izraz = zzz.Substring(0, zzz.IndexOf(":"))
            Else
                fptbox.Tag.izraz = zzz
            End If

        Else
            fptbox.Tag.Izraz = pomIzraz
        End If
        If pomIzraz.Trim = "''" Then fptbox.Visible = False

        If hh > 0 Then
            fptbox.Multiline = True
            fptbox.Height = hh
        End If

        Return fptbox
    End Function

    Function sklopiTextBoxPanel(ByVal tboxp As TextBox, ByVal panel As Panel, ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal zadnjitabindex As Integer,
ByVal pOd As String, ByVal multiline As Boolean, ByVal ro As Boolean, Optional ByVal nonvisible As Boolean = False, Optional ByVal nonenabled As Boolean = False,
Optional ByVal fbold As Boolean = False, Optional ByVal fitalic As Boolean = False, Optional ByVal funderline As Boolean = False, Optional ByVal fborderfixed As Boolean = False,
Optional ByVal fbordernone As Boolean = False, Optional ByVal fpdesnop As Boolean = False, Optional ByVal addmissingvalue As String = "",
Optional ByVal catitrtGName As String = "", Optional ByVal duz As Integer = 0, Optional ByVal addagrcalc As Boolean = False, Optional ByVal prvoNaFormi As Boolean = False,
Optional ByVal ppscrolldown As Boolean = False) As TextBox

        If p.IsKLJUCNull = True OrElse p.KLJUC.ToUpper.Trim <> "P" Then
            tboxp.Name = "DTP" & p.POLJE.Trim.ToUpper
            tboxp.TabIndex = zadnjitabindex
            AddHandler tboxp.KeyPress, AddressOf Me.dpp_KeyPress
            AddHandler tboxp.KeyUp, AddressOf Me.dpp_KeyUp
            AddHandler tboxp.Enter, AddressOf Me.dpp_Enter
            AddHandler tboxp.Validating, AddressOf Me.dpp_Validating
            AddHandler tboxp.KeyDown, AddressOf Me.dpp_KeyDown
            AddHandler tboxp.PreviewKeyDown, AddressOf Me.dpp_PreviewKeyDown
            AddHandler tboxp.GotFocus, AddressOf Me.dpp_GotFocus
            AddHandler tboxp.LostFocus, AddressOf Me.dpp_LostFocus

            If pdisablemouse = True Then
                AddHandler tboxp.MouseClick, AddressOf Me.dpp_MouseClick
            End If

            If pOd.Trim.ToUpper.IndexOf("ONDOUBLECLICKOPENSFILEDIALOG") > -1 Then
                AddHandler tboxp.DoubleClick, AddressOf Me.dpp_DoubleClickOFD
            End If

            If ppscrolldown = True Then tboxp.AccessibleName = tboxp.AccessibleName + "SCROLLDOWN;"

            If addmissingvalue <> "" AndAlso ro = False Then tboxp.AccessibleName = tboxp.AccessibleName + addmissingvalue + ";"
            If addagrcalc = True AndAlso ro = False Then tboxp.AccessibleName = tboxp.AccessibleName + "ADDAGRCALC;"
        Else
            tboxp.Name = "DTK" & p.POLJE.Trim.ToUpper
            tboxp.TabIndex = zadnjitabindex

            AddHandler tboxp.KeyPress, AddressOf Me.dpk_KeyPress
            AddHandler tboxp.Enter, AddressOf Me.dpk_Enter
            AddHandler tboxp.Validating, AddressOf Me.dpk_Validating
            AddHandler tboxp.KeyDown, AddressOf Me.dpk_KeyDown
            AddHandler tboxp.PreviewKeyDown, AddressOf Me.dpk_PreviewKeyDown
            AddHandler tboxp.GotFocus, AddressOf Me.dpp_GotFocus
            AddHandler tboxp.LostFocus, AddressOf Me.dpp_LostFocus
        End If

        If pOd.Trim.ToUpper.IndexOf("NOTABSTOP") > -1 OrElse (p.IsIzrazNull = False AndAlso p.Izraz.Trim.ToUpper.IndexOf("NOTABSTOP") > -1) Then
            tboxp.TabStop = False
        Else
            tboxp.TabStop = True
        End If

        If nonvisible = True Then
            tboxp.Visible = False
        Else
            tboxp.Visible = True
        End If

        If ro = True Then tboxp.ReadOnly = True : tboxp.AccessibleName = tboxp.AccessibleName + "RO;"
        If ro = True Then tboxp.Enabled = False

        If multiline = True Then
            tboxp.Multiline = True
            ' Add vertical scroll bars to the TextBox control.
            tboxp.ScrollBars = ScrollBars.Vertical
            ' Allow the TAB key to be entered in the TextBox control.
            tboxp.AcceptsReturn = True
            ' Allow the TAB key to be entered in the TextBox control.
            tboxp.AcceptsTab = False
            ' Set WordWrap to true to allow text to wrap to the next line.
            tboxp.WordWrap = True
        End If
        '******
        'duzina
        If Not (p.IsduzinaNull OrElse p.duzina = "") Then
            If p.duzina.Trim <> "001" And Val(p.duzina.Trim) > 0 Then tboxp.MaxLength = Val(p.duzina.Trim)
        End If
        If Not p.IsRelBazaNull AndAlso p.RelBaza.Trim <> "" Then
            Dim w(2) As String : w(0) = p.RelBaza.Trim.ToUpper : w(1) = p.RelTabela.Trim.ToUpper : w(2) = p.RelPolje.Trim.ToUpper  'relpoljenovo
            tboxp.Tag = New SveZaPolje1
            tboxp.Tag.Tip = "K"
            tboxp.Tag.Rel = w
        End If

        If ro = True Then tboxp.ReadOnly = True : tboxp.AccessibleName = tboxp.AccessibleName + "RO;"
        If ro = True Then tboxp.Enabled = False

        Return tboxp

    End Function
    Dim actbFilterKljuc As String = ""
    Dim actbFilter As String = ""

    Function sklopiACTextBoxKLJUC(ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal zadnjiTabIndex As Integer, ByVal pOd As String,
                                  Optional ByVal ppautocomplete As Boolean = False,
                                  Optional ByVal ppautocompleteDB As Boolean = False,
                                  Optional ByVal pDO As String = "", Optional ByVal encrypt As Boolean = False) As Control
        sklopiACTextBoxKLJUC = Nothing
        Dim actbox As New AutoCompleteTextbox
        actbox.Name = "TK" & p.POLJE.Trim.ToUpper
        actbox.Location = New Point(2, 16)
        actbox.AccessibleName = actbox.AccessibleName + "AUTB;"
        If ppautocompleteDB = True Then actbox.AccessibleName = actbox.AccessibleName + "AUTBDB;"
        If encrypt = True Then actbox.AccessibleName = actbox.AccessibleName + "ENCRYPT;"

        actbox.TabIndex = zadnjiTabIndex
        If pOd.Trim.ToUpper.IndexOf("NOTABSTOP") > -1 OrElse (p.IsIzrazNull = False AndAlso p.Izraz.Trim.ToUpper.IndexOf("NOTABSTOP") > -1) Then
            actbox.TabStop = False
        Else
            actbox.TabStop = True
        End If

        If pOd.Trim.ToUpper.IndexOf("ONDOUBLECLICKOPENSFILEDIALOG") > -1 Then
            AddHandler actbox.DoubleClick, AddressOf Me.dpp_DoubleClickOFD
        End If

        Dim SirPolja As Integer = 100
        If Not p.IsVSNull AndAlso Val(p.VS.Trim) > 0 Then
            SirPolja = Val(p.VS.Trim) / 100 * actbox.Width
        Else
            SirPolja = actbox.Width
        End If
        actbox.Width = SirPolja

        AddHandler actbox.KeyPress, AddressOf Me.pk_KeyPress
        AddHandler actbox.Enter, AddressOf Me.pk_Enter
        AddHandler actbox.Validating, AddressOf Me.pk_Validating
        AddHandler actbox.KeyUp, AddressOf Me.pk_actbox_keyUp

        'AddHandler actbox.MouseMove, AddressOf Me.pk_MouseMove
        'If pdisablemouse = True Then AddHandler actbox.MouseClick, AddressOf Me.pk_MouseClick
        'AddHandler actbox.GotFocus, AddressOf Me.pk_GotFocus
        'AddHandler actbox.LostFocus, AddressOf Me.pk_LostFocus

        'AddHandler actbox.TextChanged, AddressOf Me.pp_TextChanged 'U OVERRIDE JE
        'AddHandler actbox.KeyDown, AddressOf Me.pp_KeyDown      'U OVERRIDE JE

        'duzina
        If Not (p.IsduzinaNull OrElse p.duzina = "") Then
            If p.duzina.Trim <> "001" AndAlso Val(p.duzina.Trim) > 0 Then actbox.MaxLength = Val(p.duzina.Trim)
        End If

        '#{autoComplete=Opstine.txt;
        'autoCompleteStart = 5;
        'autoCompleteLength = 50;
        'autoCompleteAssignTo = MBOPS;
        'autoCompleteAssignStart = 0;
        'autoCompleteAssignLength = 5}

        Dim ssourcetxt As String = ""
        Dim acStart As Integer = 0
        Dim acLength As Integer = 0
        Dim acMTLength As Integer = 2   'default
        Dim acAssignTo As String = ""
        Dim acAssignStart As Integer = 0
        Dim acAssignLength As Integer = 0
        Dim acFilter As String = ""
        Dim acFilterStart As Integer = 0
        Dim acFilterLength As Integer = 0
        Dim acLimitToList As String = ""
        Dim acLetter As String = "LAT"  'default
        Dim acHeight As Integer = 0 'default
        Dim acWidth As Integer = actbox.Width
        Dim acMaxDropDownItems As Integer = 12   'default
        actbFilterKljuc = ""
        Dim acDisplayMember As String = ""
        Dim acValueMember As String = ""
        Dim acDataSource As String = ""
        Dim acOrderBy As String = ""

        Dim pomAUTB As String = ""

        If pDO.Trim.ToUpper.IndexOf("AUTOCOMPLETE") >= 0 Then
            pomAUTB = pDO
        ElseIf Not p.IsIzrazNull AndAlso p.Izraz.Trim.ToUpper.IndexOf("AUTOCOMPLETE") >= 0 Then
            pomAUTB = p.Izraz
        End If

        pomAUTB = pomAUTB.Replace("#{", "")
        pomAUTB = pomAUTB.Replace("}", "")
        pomAUTB = pomAUTB.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim

        If pomAUTB.Length > 0 Then
            Dim bbb() As String = Split(pomAUTB, ";")
            For i As Integer = 0 To bbb.GetUpperBound(0)
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETE=") >= 0 Then
                    ssourcetxt = NZ(Replace(bbb(i), "autocomplete=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETESTART=") >= 0 Then
                    acStart = CInt(NZ(Replace(bbb(i), "autocompletestart=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELENGTH=") >= 0 Then
                    acLength = CInt(NZ(Replace(bbb(i), "autocompletelength=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEMINTYPELENGTH=") >= 0 Then
                    acMTLength = CInt(NZ(Replace(bbb(i), "autocompletemintypelength=", "", 1, , CompareMethod.Text)).Trim)
                    If IsNumeric(acMTLength) = False Then acMTLength = 2 'default
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNTO=") >= 0 Then
                    acAssignTo = NZ(Replace(bbb(i), "autocompleteassignto=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNSTART=") >= 0 Then
                    acAssignStart = CInt(NZ(Replace(bbb(i), "autocompleteassignstart=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEASSIGNLENGTH=") >= 0 Then
                    acAssignLength = CInt(NZ(Replace(bbb(i), "autocompleteassignlength=", "", 1, , CompareMethod.Text)).Trim)
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTER=") >= 0 Then
                    acFilter = NZ(Replace(bbb(i), "autocompletefilter=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTERSTART=") >= 0 Then
                    acFilterStart = NZ(Replace(bbb(i), "autocompletefilterstart=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEFILTERLENGTH=") >= 0 Then
                    acFilterLength = NZ(Replace(bbb(i), "autocompletefilterlength=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELIMITTOLIST=") >= 0 Then
                    acLimitToList = NZ(Replace(bbb(i), "autocompletelimittolist=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETELETTER=") >= 0 Then
                    acLetter = NZ(Replace(bbb(i), "autocompleteletter=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEHEIGHT=") >= 0 Then
                    acHeight = NZ(Replace(bbb(i), "autocompleteheight=", "", 1, , CompareMethod.Text)).Trim
                    If IsNumeric(acHeight) = False Then acHeight = 0
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEWIDTH=") >= 0 Then
                    acWidth = NZ(Replace(bbb(i), "autocompletewidth=", "", 1, , CompareMethod.Text)).Trim
                    If IsNumeric(acWidth) = False Then acWidth = actbox.Width
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEMAXDROPDOWNITEMS=") >= 0 Then
                    acMaxDropDownItems = NZ(Replace(bbb(i), "autocompletemaxdropdownitems=", "", 1, , CompareMethod.Text)).Trim
                    If IsNumeric(acMaxDropDownItems) = False Then acMaxDropDownItems = 12
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEDATASOURCE=") >= 0 Then
                    acDataSource = NZ(Replace(bbb(i), "autocompletedatasource=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEVALUEMEMBER=") >= 0 Then
                    acValueMember = NZ(Replace(bbb(i), "autocompletevaluemember=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEDISPLAYMEMBER=") >= 0 Then
                    acDisplayMember = NZ(Replace(bbb(i), "autocompletedisplaymember=", "", 1, , CompareMethod.Text)).Trim
                End If
                If bbb(i).Trim.ToUpper.IndexOf("AUTOCOMPLETEORDERBY=") >= 0 Then
                    acOrderBy = NZ(Replace(bbb(i), "autocompleteorderby=", "", 1, , CompareMethod.Text)).Trim
                End If
            Next
        End If

        If ppautocompleteDB = True AndAlso acDataSource <> "" Then
            actbox.DB = True
            actbox.displayMember = acDisplayMember.Trim
            actbox.valueMember = acValueMember.Trim
            actbox.DataSourceDB = acDataSource.Trim
            actbox.orderBy = acOrderBy.Trim

            If acFilter <> "" Then
                'imafilter, preko necega, videti sta je to, pa na izlasku iz toga isprazniti actbbox
                'Call dodajfilterForKLJUC(acFilter.Split("=")(1).Trim.ToUpper.Replace("D.", ""), actbox)
                actbFilterKljuc = actbFilterKljuc + p.POLJE.Trim.ToUpper + "=" + acFilter.Split("=")(1).Trim.ToUpper.Replace("D.", "") + ";"
            End If
            Call popuniAutbDB(actbox, acDataSource, actbFilterKljuc)
        End If

        If ppautocompleteDB = False Then
            actbox.DB = False
            'Dim folder As String = CType(dIst.IST.Rows(0), DataRow).Item("txtdir").trim
            Dim folder As String = ""
            If txtmode.IndexOf("Z") = 0 OrElse txtmode.IndexOf("ZCAPI") = 0 Then
                folder = GetTXTDir() + CType(dIst.IST.Rows(0), DataRow).Item("sifist").trim
            Else
                folder = CType(dIst.IST.Rows(0), DataRow).Item("txtdir").trim
            End If
            'subject
            If (System.IO.File.Exists(folder + "\" + ssourcetxt)) Then
                Dim source As Object = New List(Of String)()
                Dim strem As StreamReader = New StreamReader(folder + "\" + ssourcetxt)
                Dim line As String = strem.ReadLine()
                While line IsNot Nothing
                    source.Add(line)
                    line = strem.ReadLine()
                End While
                strem.Close()
                strem.Dispose()
                actbox.AutoCompleteList = source

                If acFilter <> "" Then Call dodajfilterFor(acFilter.Trim.ToUpper.Replace("D.", ""), actbox, acAssignTo)

            Else
                ISTMessageBox.Show("Error!" + nvrd + nvrd + " You don't have source file for autocomplete textBox in field enterEvent of table _ISTTablesColumns!")
            End If
        End If
        '*****
        actbox.MinTypedCharacters = acMTLength
        actbox.aHeight = acHeight
        actbox.aWidth = acWidth
        actbox.autoCompleteStart = acStart
        actbox.autoCompleteLength = acLength

        actbox.autoCompleteAssignTo = acAssignTo
        actbox.autoCompleteAssignStart = acAssignStart
        actbox.autoCompleteAssignLength = acAssignLength

        actbox.autoCompleteFilterIs = acFilter
        actbox.autoCompleteFilterStart = acFilterStart
        actbox.autoCompleteFilterLength = acFilterLength

        actbox.grupePitanjaCAPI = False
        actbox.skociNazadGrupa = False
        actbox.uradidodeluSilom = False

        actbox.autoCompleteMaxDropDownItems = acMaxDropDownItems

        actbox.autoCompleteLimitToList = True
        actbox.autoCompleteLetter = acLetter
        If acLimitToList <> "" AndAlso acLimitToList.Trim.ToUpper = "FALSE" Then actbox.autoCompleteLimitToList = False
        actbox.MDoubleClick = False
        '*****

        If previewEditMode = True Then
            actbox.ContextMenuStrip = mnu02
            'AddHandler tbox.MouseDoubleClick, AddressOf Me.pp_MouseDoubleClick
            Dim pomforma As String = ""
            If p.IsFormaNull = False Then pomforma = p.Forma.Trim
            If p.IstipNull Then p.tip = ""
            If p.IsduzinaNull Then p.duzina = ""
            actbox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.Vod.ToString("yyyy/MM/dd").Trim + ";" + actbox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim + ";" + p.tip + ";" + p.duzina
        End If

        actbox.nizPrethodnihPKKontrola = nizPKKontrola

        If actbox.OnlyOneInList = True AndAlso actbox.autoCompleteLimitToList = True AndAlso actbox.AutoCompleteDataSourceDB.Count = 1 Then
            'For Each sstr As String In actbox.AutoCompleteDataSourceDB
            Dim sstr As String = actbox.AutoCompleteDataSourceDB(0)
            Dim pp() As String = sstr.Split("ˇ")
            actbox.Text = pp(1)
            actbox.sselectedText = pp(1)
            actbox.sselectedValue = pp(0)

            'Next
            actbox.Enabled = False
        End If

        Return actbox

    End Function
    Sub dodajfilterForKLJUC(ByVal pfilter As String, ByVal actbox As AutoCompleteTextbox, Optional ByVal acAssignTo As String = "")

        For Each c As Control In Me.Controls
            If c.Name.Trim.ToUpper.Substring(0, 2) = "GB" Then
                For Each k As Control In c.Controls
                    If TypeOf k Is AutoCompleteTextbox Then
                        DirectCast(k, AutoCompleteTextbox).autoCompleteFilterFor = Mid(actbox.Name, 3).Trim.ToUpper
                        If acAssignTo <> "" Then DirectCast(k, AutoCompleteTextbox).autoCompleteFilterForAssignTo = acAssignTo
                    End If
                    If TypeOf k Is TextBox Then
                        DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFOR= " + Mid(actbox.Name, 3).Trim.ToUpper + ";"
                        If acAssignTo <> "" Then DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFORASSIGNTO= " + acAssignTo + ";"
                    End If
                    Exit For
                Next
            End If
        Next

    End Sub
    Sub dodajfilterFor(ByVal pfilter As String, ByVal actbox As AutoCompleteTextbox, Optional ByVal acAssignTo As String = "")
        If grupePitanjaCAPI Is Nothing Then
            For Each k As Control In Panel1.Controls
                If Mid(k.Name, 3).Trim.ToUpper = pfilter.Trim.ToUpper AndAlso Mid(k.Name, 1, 1) <> "L" Then
                    If TypeOf k Is AutoCompleteTextbox Then
                        DirectCast(k, AutoCompleteTextbox).autoCompleteFilterFor = Mid(actbox.Name, 3).Trim.ToUpper
                        If acAssignTo <> "" Then DirectCast(k, AutoCompleteTextbox).autoCompleteFilterForAssignTo = acAssignTo
                    End If
                    If TypeOf k Is TextBox Then
                        DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFOR= " + Mid(actbox.Name, 3).Trim.ToUpper + ";"
                        If acAssignTo <> "" Then DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFORASSIGNTO= " + acAssignTo + ";"
                    End If
                    Exit For
                End If
            Next
        Else
            For ii As Integer = 0 To grupePitanjaCAPI.GetUpperBound(0)
                For Each k As Control In grupePitanjaCAPI(ii).Controls
                    If Mid(k.Name, 3).Trim.ToUpper = pfilter.Trim.ToUpper AndAlso Mid(k.Name, 1, 1) <> "L" Then
                        If TypeOf k Is AutoCompleteTextbox Then
                            DirectCast(k, AutoCompleteTextbox).autoCompleteFilterFor = Mid(actbox.Name, 3).Trim.ToUpper
                            If acAssignTo <> "" Then DirectCast(k, AutoCompleteTextbox).autoCompleteFilterForAssignTo = acAssignTo
                        End If
                        If TypeOf k Is TextBox Then
                            DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFOR= " + Mid(actbox.Name, 3).Trim.ToUpper + ";"
                            If acAssignTo <> "" Then DirectCast(k, TextBox).AccessibleDefaultActionDescription = DirectCast(k, TextBox).AccessibleDefaultActionDescription + "AUTOCOMPLETEFILTERFORASSIGNTO= " + acAssignTo + ";"
                        End If
                        Exit For
                    End If
                Next
            Next
        End If
    End Sub
    Function sklopiACTextBox(ByVal panel As Panel, ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal zadnjitabindex As Integer,
                                ByVal pOd As String, ByVal multiline As Boolean, ByVal ro As Boolean,
                                Optional ByVal nonvisible As Boolean = False,
                                Optional ByVal nonenabled As Boolean = False,
                                Optional ByVal fbold As Boolean = False,
                                Optional ByVal fitalic As Boolean = False,
                                Optional ByVal funderline As Boolean = False,
                                Optional ByVal fborderfixed As Boolean = False,
                                Optional ByVal fbordernone As Boolean = False,
                                Optional ByVal fpdesnop As Boolean = False, Optional ByVal fpcentarp As Boolean = False,
                                Optional ByVal addmissingvalue As String = "",
                                Optional ByVal catiGName As String = "",
                                Optional ByVal duz As Integer = 0,
                                Optional ByVal addagrcalc As Boolean = False,
                                Optional ByVal prvoNaFormi As Boolean = False,
                                Optional ByVal ppscrolldown As Boolean = False,
                                Optional ByVal ppautocomplete As Boolean = False, Optional ByVal ppautocompleteDB As Boolean = False,
                                Optional ByVal pDO As String = "", Optional ByVal ugrupama As Boolean = False,
                                Optional ByVal encrypt As Boolean = False, Optional ByVal scati As Boolean = False) As Control
        sklopiACTextBox = Nothing
        Dim actbox As New AutoCompleteTextbox
        If catiGName = "" Then
            actbox.Name = "TP" & p.POLJE.Trim.ToUpper
        Else
            actbox.Name = catiGName
        End If

        actbox.AccessibleName = actbox.AccessibleName + "AUTB;"
