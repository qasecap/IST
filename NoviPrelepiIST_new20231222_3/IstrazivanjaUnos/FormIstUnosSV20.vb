                        'SendKeys.SendWait("+{TAB}")
                        If Me.menjanoP = True AndAlso Me.sacuvanoP = False Then
                            Dim dugmeSScroll As Button = NadjiKontrolu(Panel1, "DBTNSAVESCROLL" + tabela)
                            dugmeSScroll.Focus()
                            Exit Sub
                        Else
                            Dim tt As Control = vratinaprethodni(trt)
                            If Not tt Is Nothing Then tt.Focus()
                        End If

                    End If
                    If trt.AccessibleName Is Nothing OrElse trt.AccessibleName.Trim.ToUpper.IndexOf("FIRSTTB;") < 0 Then
                        nepotrebnavalidacijaPanel = True

                        If grupeCNTLBlokoviPanel.Length = 0 OrElse grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
                            SendKeys.SendWait("+{TAB}")
                            If Mid(trt.Name, 1, 3) = "DRP" Then trt.Visible = False 'remark polje
                        End If

                        If grupeCNTLBlokoviPanel.Length > 0 AndAlso Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
                            Try

                                If Mid(trt.Name, 1, 3) = "DRP" Then
                                    SendKeys.SendWait("+{TAB}")
                                    trt.Visible = False 'remark polje
                                Else
                                    Dim nizskociNAzad As String = ""
                                    Dim b As Integer = blok(ipanel, trt)
                                    Dim bblok As Integer = 0

                                    If Not trt.AccessibleName Is Nothing Then
                                        trt.AccessibleName = trt.AccessibleName.Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ").Trim
                                        Dim p As Integer = trt.AccessibleName.Trim.ToUpper.IndexOf("SKIPFROM")
                                        If p >= 0 Then
                                            Dim pp As String = trt.AccessibleName.Substring(p + 8)
                                            nizskociNAzad = pp.Substring(0, pp.IndexOf(";"))
                                        End If
                                        Dim m As Integer = trt.AccessibleName.Trim.ToUpper.IndexOf("FROMGROUP")
                                        If m >= 0 Then
                                            Dim pp As String = trt.AccessibleName.Substring(m + 9)
                                            bblok = pp.Substring(0, pp.IndexOf(";"))
                                        End If
                                    End If

                                    If nizskociNAzad <> "" Then
                                        Dim bbss As Control = sskoci2panelGrupaNazad(panel, tabela, plj, trt, nizskociNAzad)
                                        If Not bbss Is Nothing Then
                                            nepotrebnavalidacijaPanel = True
                                            nepotrebanPaneEnter = True
                                            'Call bbssFocus1(trt, ipanel, bblok, b)
                                            Dim mmm As String = "f"
                                            If DirectCast(trt, TextBox).Multiline = True Then
                                                DirectCast(trt, TextBox).Multiline = False
                                                mmm = "t"
                                            End If

                                            If bblok = b Then
                                                bbss.Focus()
                                            Else
                                                bbss.BackColor = Color.Bisque
                                                Call vidljivBlokPanelBasOvaj(ipanel, bblok)
                                                Call nevidljivBlokPanelBasOvaj(ipanel, b)
                                                bbss.Focus()
                                            End If
                                            If mmm = "t" Then DirectCast(trt, TextBox).Multiline = True
                                        End If
                                    End If
                                    If nizskociNAzad = "" Then
                                        Dim index1 As Integer = Array.IndexOf(grupePitanjaPrvoPoljePanel(ipanel), trt.Name)
                                        If index1 >= 0 Then
                                            'ako je trt prvo polje bloka koji nije prvi blok
                                            If b > 0 Then
                                                Call vidljivBlokPanelBasOvaj(ipanel, b - 1)
                                                Call nevidljivBlokPanelBasOvaj(ipanel, b)
                                                Dim im As Integer = grupeObicneCNTLBlokoviPanel(ipanel)(b - 1).GetUpperBound(0)
                                                bbss = grupeObicneCNTLBlokoviPanel(ipanel)(b - 1)(grupeObicneCNTLBlokoviPanel(ipanel)(b - 1).GetUpperBound(0))
                                                If Mid(bbss.Name, 1, 3).Trim.ToUpper = "DRP" AndAlso im > 0 Then 'remark
                                                    bbss = grupeObicneCNTLBlokoviPanel(ipanel)(b - 1)(im - 1)
                                                End If
                                                bbss.Focus()
                                            End If
                                        Else
                                            SendKeys.SendWait("+{TAB}")
                                            Exit Sub
                                        End If  'If index1 >= 0 Then
                                    End If  'If nizskociNAzad <> "" Then

                                End If
                            Catch ex As Exception
                                ISTMessageBox.Show("previousBlok")
                            End Try
                            'prvo polje
                        End If ' If grupeCNTLBlokoviPanel.Length > 0 AndAlso Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
                    End If ' If trt.AccessibleName Is Nothing OrElse trt.AccessibleName.trim.toUpper.IndexOf("FIRSTTB;") < 0 Then

                    If Not trt.AccessibleName Is Nothing AndAlso trt.AccessibleName.Trim.ToUpper.IndexOf("SCROLLDOWN;") >= 0 Then Panel1.AutoScrollPosition = New Point(0, 0)

                    e.SuppressKeyPress = True   'zbog multiline inace ne radi
                End If

            Case Keys.PageDown
            Case Keys.PageUp
        End Select
    End Sub

    Sub skokKraj(ByVal panel As Panel, ByVal ti As String)
        Dim panelautoscroll As Boolean = False
        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.IndexOf("SCROLLBAR;") >= 0 Then panelautoscroll = True

        If ti.Trim.ToUpper = lastInPanel(panel.Name) Then
            If panelautoscroll = True Then
                For Each k As Control In Panel1.Controls
                    If TypeOf k Is Button AndAlso k.Name = "DBTNSAVESCROLL" + panel.Name.Replace("PANE_", "").Trim.ToUpper Then
                        k.Focus()
                        bbiloskakanje = True
                        Exit For
                    End If
                Next
            Else
                For Each k As Control In panel.Controls
                    If TypeOf k Is Button Then
                        k.Focus()
                        bbiloskakanje = True
                        Exit For
                    End If
                Next
            End If
        End If
    End Sub


    Private Sub dpp_KeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs)

        Dim tbox As Control = sender
        Dim autb As Boolean = False
        If Not tbox.AccessibleName Is Nothing Then tbox.AccessibleName = tbox.AccessibleName + ";" : tbox.AccessibleName = tbox.AccessibleName.Replace(";;", ";")
        If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
            tbox = CType(sender, AutoCompleteTextbox)
        Else
            tbox = CType(sender, TextBox)
        End If

        'Dim tbox As TextBox = CType(sender, TextBox)
        Dim panel As Panel = tbox.Parent
        Dim nadpanel As Panel = panel.Parent
        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)
        Dim tabela As String = panel.Name.Replace("PANE_", "").Trim.ToUpper
        Dim plj As String = Mid(tbox.Name.Trim.ToUpper, 4)

        Select Case e.KeyChar
            Case ChrW(27) 'ESC kakvo god da je pp (prazno puno)

                tbox.Text = DGTabelePanel(DGi(tabela)).Rows(0).Item(plj).ToString
                If autb = True Then
                    CType(sender, AutoCompleteTextbox).SelectAll()
                Else
                    CType(sender, TextBox).SelectAll()
                End If

            Case ChrW(13) 'Enter
                odakledppkeyDown = ""
                If Not tbox.AccessibleName Is Nothing AndAlso tbox.AccessibleName.IndexOf("AUTB") >= 0 Then
                    e.Handled = True
                    Call autbleaveAL(tbox)
                End If
                nepotrebnavalidacijaPanel = False
                If bioPageDown = False Then
                    Call finalySkipPanel("dppkeypress", tbox, sender, panel, tabela, grupeCNTLBlokoviPanel, ipanel, grupePitanjaBlokoviPanel)
                End If

            Case Else
        End Select
    End Sub

    Sub finalySkipPanel(ByVal odakle As String, ByVal tcntl As Control, ByVal sender As Control,
ByVal panel As Panel, ByVal tabela As String,
ByVal grupeCNTLBlokoviPanel()()() As Control, ByVal ipanel As Integer,
ByVal grupePitanjaBlokoviPanel()() As String)

