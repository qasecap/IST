    Sub refreshDGVs(ByVal panel As Panel, Optional ByVal neovajGrid As String = "",
            Optional ByVal imetabele As String = "",
            Optional KljTabeleSavrednostima(,) As String = Nothing,
            Optional makeColumnsVisible As Boolean = False, Optional selektuj As Boolean = True)

        For Each dgv As Control In Me.Panel1.Controls
            If TypeOf dgv Is DataGridView2 Then
                If DirectCast(dgv, DataGridView2).Grid.AccessibleDefaultActionDescription Is Nothing OrElse DirectCast(dgv, DataGridView2).Grid.AccessibleDefaultActionDescription = "" Then
                Else
                    If DirectCast(dgv, DataGridView2).Grid.AccessibleDefaultActionDescription.IndexOf("DGS") >= 0 Then
                        If neovajGrid = "" OrElse neovajGrid <> "" AndAlso dgv.Name.Trim.ToUpper <> "IDGV" + neovajGrid.Trim.ToUpper Then
                            Call dgvRefresh(dgv)
                            'If makeColumnsVisible = True Then 
                            Call sklopiISTDataGridViewOstalo(dgv)  'ovaj red se izvrsava samo na load
                        End If
                        If imetabele <> "" AndAlso dgv.Name.Trim.ToUpper = "IDGV" + imetabele.Trim.ToUpper AndAlso DirectCast(dgv, DataGridView2).Grid.Rows.Count > 0 Then
                            If Not KljTabeleSavrednostima Is Nothing Then
                                Dim j As Integer = KljTabeleSavrednostima.GetUpperBound(0)
                                Dim ime As String = KljTabeleSavrednostima(j, 0).Trim.ToUpper
                                Dim vrednost As String = KljTabeleSavrednostima(j, 1).Trim.ToUpper

                                For i As Integer = 0 To DirectCast(dgv, DataGridView2).Grid.Rows.Count
                                    If DirectCast(dgv, DataGridView2).Grid.Rows(i).Cells(ime).Value = vrednost Then
                                        'DirectCast(dgv, DataGridView2).Grid.CurrentCell = DirectCast(dgv, DataGridView2).Grid.Rows(i).Cells(0)
                                        If selektuj = True Then
                                            DirectCast(dgv, DataGridView2).Grid.Rows(i).Selected = True
                                        End If

                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    End If
                End If
            End If
        Next
    End Sub

    Sub dgvRefresh(ByVal dgv As DataGridView2)

        Dim dgvsource As String = ""
        Dim dgvsourcewhere As String = ""
        Dim dgvorderby As String = ""
        Dim dgvaddcolumn As String = ""
        Dim dgvaddcolumnonposition As String = ""
        Dim pomaddcolumn() As String = Nothing
        Dim pomaddcolumnonposition() As String = Nothing
        Dim dscolumndisplayindex As String = ""

        Dim dgview As Boolean = False
        dgv.Grid.AutoGenerateColumns = True

        Dim pp() As String = DirectCast(dgv, DataGridView2).Grid.AccessibleDefaultActionDescription.Split(";")

        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim m As String = pp(i).Trim.ToUpper
            If m.IndexOf("DGOB=") = 0 Then
                dgvorderby = m.Replace("DGOB=", "")
                Exit For
            End If
        Next

        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim m As String = pp(i).Trim.ToUpper
            If m.Trim.ToUpper.IndexOf("DGSW=") = 0 Then
                m = NZ(Replace(m, "dgsw=", "", 1, , CompareMethod.Text))
                dgvsourcewhere = m.Replace("}", "")
                Exit For
            End If
        Next

        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim m As String = pp(i).Trim
            If m.Trim.ToUpper.IndexOf("DGS=") = 0 Then
                dgvsource = NZ(Replace(m, "dgs=", "", 1, , CompareMethod.Text))
                If DGi(dgvsource, DTbl) = -1 AndAlso DGi(dgvsource, DGTabele) = -1 Then
                    dgview = True
                Else
                    dgview = False
                End If
            End If
            Exit For
        Next

        For i As Integer = 0 To pp.GetUpperBound(0)
            Dim m As String = pp(i).Trim
            If m.Trim.ToUpper.IndexOf("DGSADDCOLUMN=") = 0 Then
                m = NZ(Replace(m, "dgsaddcolumn=", "", 1, , CompareMethod.Text))
                dgvaddcolumn = m.Replace("}", "")
                pomaddcolumn = dgvaddcolumn.Split("$")
            ElseIf m.Trim.ToUpper.IndexOf("DGSADDCOLUMNONPOSITION=") = 0 Then
                m = NZ(Replace(m, "dgsaddcolumnonposition=", "", 1, , CompareMethod.Text))
                dgvaddcolumnonposition = m.Replace("}", "")
                pomaddcolumnonposition = dgvaddcolumnonposition.Split("$")
            ElseIf m.Trim.ToUpper.IndexOf("COLUMNDISPLAYINDEX=") = 0 Then
                m = NZ(Replace(m, "columndisplayindex=", "", 1, , CompareMethod.Text))
                dscolumndisplayindex = m.Replace("}", "")
            End If
        Next

        Dim dtpom As New DataTable
        Dim ddrd() As DataRow
        Dim strsql As String = ""

        If dgvsourcewhere = "" Then
            dgvsourcewhere = " 2=2 "
            If nadtabelaJe(GlavnaTabela) = "" Then
                Dim klj() As String = Me.DajKljuceve(GlavnaTabela)
                Dim sql As String = ""
                For ii As Integer = 0 To klj.GetUpperBound(0)
                    sql = sql & " and " & klj(ii).Trim.ToUpper & "=N'" & SEK(klj(ii).Trim.ToUpper) & "' "
                Next
                dgvsourcewhere = " 2=2 " + sql
            End If
        End If

        If dgvsource = "" Then
            dgv.Grid.DataSource = Nothing
        End If

        If dgvsource <> "" AndAlso dgvsourcewhere <> "" Then
            dgvsourcewhere = prevediIF(dgvsourcewhere, dgvsource)
            If dgview = True Then
                strsql = "select * from " + dgvsource + " where " + dgvsourcewhere + ""
                dtpom = izvrsiSQLvratiDT(strsql, DBConnectionString, Nothing)
                ddrd = dtpom.Select(dgvsourcewhere.Trim.ToUpper.Replace(" = N '", "='"))
                dtpom = dtpom.Clone
            End If

            If dgview = False Then
                If nadtabelaJe(GlavnaTabela) = "" Then   'prva forma
                    dtpom = Me.DGTabele(DGi(dgvsource, DGTabele)).Clone
                    ddrd = DGTabele(DGi(dgvsource)).Select(dgvsourcewhere.Trim.ToUpper.Replace("=N'", "='"))
                Else
                    If previewEditMode = True Then
                        Try
                            dtpom = Me.DTbl(DGi(dgvsource, DTbl)).Clone
                            ddrd = DTbl(DGi(dgvsource)).Select(dgvsourcewhere.Trim.ToUpper.Replace("=N'", "='"))
                        Catch ex As Exception
                            dtpom = Me.DGTabele(DGi(dgvsource, DGTabele)).Clone
                            ddrd = DGTabele(DGi(dgvsource)).Select(dgvsourcewhere.Trim.ToUpper.Replace("=N'", "='"))
                        End Try
                    Else
                        dtpom = Me.DTbl(DGi(dgvsource, DTbl)).Clone
                        ddrd = DTbl(DGi(dgvsource)).Select(dgvsourcewhere.Trim.ToUpper.Replace("=N'", "='"))
                    End If
                End If
            End If

            For Each r As DataRow In ddrd
                dtpom.ImportRow(r)
            Next

            Dim dv As DataView = dtpom.DefaultView
            If dgvorderby <> "" Then dv.Sort = dgvorderby

            If pomaddcolumn Is Nothing OrElse pomaddcolumn.Length = 0 Then
                dgv.Grid.DataSource = dv
                dgv.Grid.AutoGenerateColumns = False
            End If

            If Not pomaddcolumn Is Nothing AndAlso pomaddcolumn.Length > 0 Then
                For im As Integer = 0 To pomaddcolumn.GetUpperBound(0)
                    Dim titlec As String = "_" + CStr(im).Trim
                    Dim columcc As String = pomaddcolumn(im)
                    Dim columccposition As String = ""
                    Dim pppom() As String = pomaddcolumn(im).Split("=")

                    columcc = pomaddcolumn(im)
                    titlec = pomaddcolumn(im)

                    If Not pomaddcolumnonposition Is Nothing AndAlso pomaddcolumnonposition.Length > im Then
                        columccposition = pomaddcolumnonposition(im)
                    End If

                    If columcc.IndexOf("=") > 0 Then
                        titlec = Mid(titlec, 1, titlec.LastIndexOf("="))
                        columcc = Mid(columcc, columcc.LastIndexOf("=") + 2)
                    End If

                    Dim tabela2 As String = "" : Dim polje2 As String = ""
                    If columcc.IndexOf(".") > 0 Then
                        If columcc.ToUpper.IndexOf("CASE ") >= 0 Then
                            Dim bbb() As String = razkvantaj(columcc)
                            For i As Integer = 0 To bbb.Length - 1
                                If bbb(i).IndexOf(".") > 0 Then
                                    tabela2 = Mid(bbb(i), 1, bbb(i).LastIndexOf("."))
                                    polje2 = Mid(bbb(i), bbb(i).LastIndexOf(".") + 2)
                                    Exit For
                                End If
                            Next
                        Else
                            tabela2 = Mid(columcc, 1, columcc.LastIndexOf("."))
                            polje2 = Mid(columcc, columcc.LastIndexOf(".") + 2)
                        End If

                        Dim dt1 As DataTable
                        dt1 = dv.Table.Copy

                        Dim dcpom As DataColumn
                        dcpom = New DataColumn(titlec, System.Type.GetType("System.String"))

                        If Not dt1.Columns.Contains(titlec) Then
                            dt1.Columns.Add(dcpom)
                            dcpom.Prefix = "GRIDADDEDCOLUMN"   'koristi se kod insert i update da bi ga preskocio
                            If columccposition <> "" AndAlso IsNumeric(columccposition) Then dcpom.Namespace = CStr(columccposition)
                        End If

                        Dim dt2 As DataTable
                        If nadtabelaJe(tabela2) = "" Then   'prva forma
                            dt2 = DGTabele(DGi(tabela2))
                        Else
                            If Not DTbl Is Nothing Then
                                dt2 = DTbl(DGi(tabela2))
                            Else
                                dt2 = DGTabele(DGi(tabela2))
                            End If
                        End If

                        Dim klj() As String = Me.DajKljuceve(dgvsource)

                        'sad treba ubaciti u dt1 sta treba
                        Dim dts As DataTable = dgv.Grid.DataSource.table.copy
                        For i As Integer = 0 To dt1.Rows.Count - 1
                            For j As Integer = 0 To dt2.Rows.Count - 1
                                Dim istikljuc As Boolean = True
                                For m As Integer = 0 To klj.GetUpperBound(0)
                                    If dt1.Rows(i).Item(klj(m)).ToString.Trim.ToUpper <> dt2.Rows(j).Item(klj(m)).ToString.Trim.ToUpper Then
                                        istikljuc = False
                                        Exit For
                                    End If
                                Next
                                If istikljuc = True Then
                                    Dim POM As String = dt2.Rows(j).Item(polje2).ToString.Trim
                                    If dt2.Columns(j).DataType.ToString.Trim.ToUpper = "STRING" Then
                                        If POM = "" Then POM = "''"
                                    Else
                                        If POM = "" Then POM = "0"
                                    End If
                                    If columcc.ToUpper.IndexOf("CASE ") >= 0 Then
                                        Dim zzz As String = CASE2IIF(Replace(columcc, tabela2.ToLower.Trim + "." + polje2.ToLower.Trim, POM, 1,, CompareMethod.Text))
                                        'Dim zzz As String = CASE2IIF(columcc.ToUpper.Replace(tabela2.ToUpper.Trim + "." + polje2.ToUpper.Trim, POM))
                                        Dim tbl As DataTable = New DataTable()
                                        POM = tbl.Compute(zzz, Nothing)
                                    End If
                                    dt1.Rows(i).Item(titlec) = POM
                                    Exit For
                                End If
                            Next
                        Next

                        Dim dvKON As DataView = dt1.DefaultView
                        If dgvorderby <> "" Then dvKON.Sort = dgvorderby
                        dgv.Grid.DataSource = dvKON

                        If Not dgv.Tag Is Nothing AndAlso dgv.Tag.ToString.Trim <> "" AndAlso dgv.Tag.ToString.Trim.IndexOf(";") >= 0 Then
                            Dim dd() As String = dgv.Tag.split(";")
                            dgv.Tag = dd(0) + "," + titlec + "=" + titlec + ";" + dd(1) + "," + CStr(50) + ";"
                        End If
                    Else
                        'ne radi nista
                        ISTMessageBox.Show("Syntax for GridAddColumn is not OK. Syntax is Table.Field")
                    End If
                Next
            End If '  If Not pomaddcolumn Is Nothing AndAlso pomaddcolumn.Length > 0 Then

            If dscolumndisplayindex.Trim <> "" Then
                'reorder colona
                Dim pommm() As String = dscolumndisplayindex.Split("#")
                Dim gub As Integer = pommm.GetUpperBound(0)
                For im As Integer = 0 To gub
                    Dim pppom() As String = pommm(im).Split("$")
                    dgv.Grid.Columns(pppom(0)).DisplayIndex = pppom(1)
                Next
            End If

            For i As Integer = 0 To DirectCast(dgv, DataGridView2).Grid.Rows.Count - 1
                DirectCast(dgv, DataGridView2).Grid.Rows(i).ReadOnly = True
            Next

        End If '    If dgvsource <> "" AndAlso dgvsourcewhere <> "" Then

    End Sub

