                                            Else
                                                If nizAUTBKontrola(ikik).Text = "" Then
                                                    Call addSHH(k, nizskociAKOsss)
                                                End If
                                            End If
                                        End If
                                        If skippedSetEmpty = True AndAlso azSE = 0 AndAlso Mid(k.Name, 1, 1) <> "F" Then
