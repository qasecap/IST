        Dim nizacAssignLength As String() = acAssignLength.Split("$")

        If acAssignTo.Trim <> "" Then
            If nizacAssignTo.Length <> nizacAssignStart.Length OrElse nizacAssignTo.Length <> nizacAssignLength.Length OrElse nizacAssignLength.Length <> nizacAssignStart.Length Then
                ISTMessageBox.Show("Error at syntax for autocomplete assign." + nvrd + nvrd + "Length of assignto, assignstart and assignlength is not the same.")
            Else
                Dim ok As Boolean = True
                For i As Integer = 0 To nizacAssignTo.GetUpperBound(0)
                    If nizacAssignTo(i).Trim = "" Then
                        ok = False
                        Exit For
                    End If
                Next

                If ok = True Then
                    For i As Integer = 0 To nizacAssignStart.GetUpperBound(0)
                        If nizacAssignStart(i).Trim = "" OrElse IsNumeric(nizacAssignStart(i).Trim) = False Then
                            ok = False
                            Exit For
                        End If
                    Next
                End If

                If ok = True Then
                    For i As Integer = 0 To nizacAssignLength.GetUpperBound(0)
                        If nizacAssignLength(i).Trim = "" OrElse IsNumeric(nizacAssignLength(i).Trim) = False Then
                            ok = False
                            Exit For
                        End If
                    Next
                End If

                If ok = False Then
                    ISTMessageBox.Show("Error at syntax for autocomplete assign." + nvrd + nvrd + "Value of assignto, assignstart and assignlength cannot be empty." + nvrd + nvrd + " Value of assignstart and assignlength must be number.")
                End If
            End If
        End If



        If ppautocompleteDB = True AndAlso acDataSource <> "" Then
