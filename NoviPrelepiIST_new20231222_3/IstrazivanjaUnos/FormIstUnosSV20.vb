    Public Function DajSledeciDBTNPANE(ByVal parent As Control, ByVal kt As String) As Control
        Dim control As Control = Nothing
        Dim p As Integer = 100
        For Each c As Control In parent.Controls
            If TypeOf c Is Button AndAlso c.Name.Trim.ToUpper.IndexOf("DBTNPANE") = 0 AndAlso c.Visible = True Then
                Dim kk As Integer = c.AccessibleDescription
                If p > kk AndAlso kk > kt Then p = kk : control = c
            End If
        Next
        Return control
    End Function

    Public Function DajPrethodniDBTNPANE(ByVal parent As Control, ByVal kt As String) As Control
        Dim control As Control = Nothing
        Dim p As Integer = 0
        For Each c As Control In parent.Controls
            If TypeOf c Is Button AndAlso c.Name.Trim.ToUpper.IndexOf("DBTNPANE") = 0 AndAlso c.Visible = True Then
                Dim kk As Integer = c.AccessibleDescription
                If p < kk AndAlso kk < kt Then p = kk : control = c
            End If
        Next
        Return control
    End Function

