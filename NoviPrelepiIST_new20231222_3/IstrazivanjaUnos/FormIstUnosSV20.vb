    Function sskoci2panelGrupaNazad(ByVal panel As Panel, ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal nizskociNAsss As String) As Control

        sskoci2panelGrupaNazad = Nothing
        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)

        Dim dppRBR As Integer
        If Not cntl.AccessibleDescription Is Nothing Then dppRBR = cntl.AccessibleDescription.Split(";")(0)

        Dim tabela As String = GlavnaTabela

        Dim nizskociNAsssrbr As Integer

        For Each k As Control In panel.Controls
            If (TypeOf k Is TextBox AndAlso Mid(k.Name, 2, 1) <> "F") OrElse TypeOf k Is ComboBox Then
                If Mid(k.Name, 4).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                    Dim kk() As String = k.AccessibleDescription.Split(";")
                    Dim krbr As Integer = kk(0)
                    nizskociNAsssrbr = krbr
                    Exit For
                End If
            End If
        Next

        ''''obicno POLJE
        'u kojoj je grupi polje sa koga skacemo,
        Dim tblok As Integer = 0
        For i As Integer = 0 To grupePitanjaBlokoviPanel(ipanel).GetUpperBound(0)
            If grupePitanjaBlokoviPanel(ipanel)(i).IndexOf(plj + ";") >= 0 Then
                tblok = i
                Exit For
            End If
        Next
        'u kojoj grupi je polje na koje skacemo
        Dim pblok As Integer = 0
        For i As Integer = 0 To grupePitanjaBlokoviPanel(ipanel).GetUpperBound(0)
            If grupePitanjaBlokoviPanel(ipanel)(i).IndexOf(nizskociNAsss + ";") >= 0 Then
                pblok = i
                Exit For
            End If
        Next

        For ii As Integer = tblok To pblok Step -1
            Dim iz As Integer = 0
            For im As Integer = grupeObicneCNTLBlokoviPanel(ipanel)(ii).GetUpperBound(0) To 0 Step -1
                Dim k As Control = grupeObicneCNTLBlokoviPanel(ipanel)(ii)(im)
                If (TypeOf k Is TextBox) OrElse TypeOf k Is ComboBox Then
                    If Mid(k.Name, 4).Trim.ToUpper = nizskociNAsss.Trim.ToUpper Then
                        cntl.AccessibleName = cntl.AccessibleName.Replace("SKIPFROM" + nizskociNAsss.Trim.ToUpper + ";", "")
                        cntl.AccessibleName = cntl.AccessibleName.Replace("FROMGROUP" + Str(ii).Trim + ";", "")
                        cntl.AccessibleName = cntl.AccessibleName.Replace("TOGROUP" + Str(tblok).Trim + ";", "")
                        If Mid(k.Name, 1, 3).Trim.ToUpper = "DRP" AndAlso im > 0 Then 'remark
                            k = grupeObicneCNTLBlokoviPanel(ipanel)(ii)(im - 1)
                        End If
                        sskoci2panelGrupaNazad = k
                        iz = 1
                        Exit For
                    Else
                        Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                        If nizskociNAsssrbr < trenutniRBR AndAlso trenutniRBR < dppRBR Then
                            If k.AccessibleDefaultActionDescription = nizskociNAsss Then
                                If Mid(k.Name, 2, 1) <> "F" Then
                                    If Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("RO;") >= 0 Then
                                        k.Enabled = False 'da ostanu RRO; i RO;
                                    Else
                                        k.Enabled = True 'da ostanu fp
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
            Next

            If iz = 1 Then Exit For
        Next

    End Function

    Sub kontrpp(ByVal cntl As Control, ByVal pp As Panel, ByVal dppRBR As Integer, ByVal skippedEnabledFalse As Boolean, ByVal skippedVisibleFalse As Boolean, ByVal skippedDontSave As Boolean, ByVal skippedSetEmpty As Boolean, ByVal nizskociAKOsss As String)

        Dim ssskippedSetEmpty As Boolean = False

        For Each k As Control In pp.Controls
            If Not TypeOf k Is Label AndAlso Not TypeOf k Is LinkLabel AndAlso Mid(k.Name, 1, 1).Trim.ToUpper <> "F" AndAlso Not TypeOf k Is Button AndAlso Not k.AccessibleDescription Is Nothing Then
                Dim trenutniRBR As Integer = k.AccessibleDescription.Split(";")(0)
                If dppRBR < trenutniRBR Then 'sve od polja sa koga skace pa do kraja ide u ovo dole
                    If skippedEnabledFalse = True Then
