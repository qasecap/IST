                                                        DirectCast(kk, AutoCompleteTextbox).sselectedValue = ""
                                                        DirectCast(kk, AutoCompleteTextbox).sselectedText = ""
                                                    End If
                                                End If
                                                Me.UpisiPolje(Mid(kk.Name, 3).Trim.ToUpper,,, kk.Parent)
                                                Call EmptyFPsaVrednoscuIzAWL(kk.Parent, Mid(kk.Name, 3).Trim.ToUpper)
                                            Else
                                                If nizAUTBKontrola(ikik).Text = "" Then
                                                    kk.Text = ""
                                                    Me.UpisiPolje(Mid(kk.Name, 3).Trim.ToUpper,,, kk.Parent)
                                                    Call EmptyFPsaVrednoscuIzAWL(kk.Parent, Mid(kk.Name, 3).Trim.ToUpper)
                                                End If

                                            End If
                                        End If
                                    End If
                                End If
                                kk = grupePitanjaCAPI(ii).GetNextControl(kk, True) 'Get the next control in the tab order.
                            Loop
                        Next
                        '****
                        Exit For
                    End If
