    Private Sub cbpp_uradiNaPromenu(ByVal cbo As ComboBox, Optional pp As Panel = Nothing)

        Dim panel As Panel = Me.Panel1
        If SCati = True AndAlso Not pp Is Nothing Then panel = pp

        Dim nizCBnaCb As String() = Split(CBnaCB, ";")
        If CBnaCB <> "" AndAlso nizCBnaCb.Length > 0 Then
            For i As Integer = 0 To nizCBnaCb.Length - 1
                Dim cbvb As String() = Split(nizCBnaCb(i), ",")
                If cbvb.Length = 2 Then
                    If cbo.Name.Trim.ToUpper = "CB" & cbvb(0).Trim.ToUpper Then
                        For Each k As Control In panel.Controls
                            If Mid(k.Name, 1, 1) = "C" Then
                                If Mid(k.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                    Try
                                        Dim vrednost As String
                                        If Not (cbo.SelectedValue) Is Nothing Then
                                            vrednost = cbo.SelectedValue.ToString.Trim
                                        Else
                                            vrednost = ""
                                        End If
                                        cbpp_popuni(k, True, vrednost)
                                    Catch ex As Exception
                                        ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                    End Try
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                    If cbo.Name.Trim.ToUpper = "CK" & cbvb(0).Trim.ToUpper Then
                        For Each kk As Control In Me.Controls
                            If Mid(kk.Name.Trim.ToUpper, 1, 1) = "G" Then
                                For Each k As Control In kk.Controls
                                    If Mid(k.Name, 1, 1) = "C" Then
                                        If Mid(k.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                            Try
                                                Dim vrednost As String
                                                If Not (cbo.SelectedValue) Is Nothing Then
                                                    vrednost = cbo.SelectedValue.ToString.Trim
                                                Else
                                                    vrednost = ""
                                                End If
                                                cbpp_popuni(k, True, vrednost)
                                            Catch ex As Exception
                                                ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                            End Try
                                            Exit For
                                        End If
                                    End If
                                Next
                            End If
                        Next
                    End If
                End If
            Next
        End If
    End Sub

    Private Sub dcbpp_uradiNaPromenu(ByVal cbo As ComboBox)
        Dim panel As Panel = cbo.Parent
        Dim nizCBnaCb As String() = Split(CBnaCB, ";")
        If CBnaCB <> "" AndAlso nizCBnaCb.Length > 0 Then
            For i As Integer = 0 To nizCBnaCb.Length - 1
                Dim cbvb As String() = Split(nizCBnaCb(i), ",")
                If cbvb.Length = 2 Then
                    If cbo.Name.Trim.ToUpper = "DCB" & cbvb(0).Trim.ToUpper Or cbo.Name.Trim.ToUpper = "DCK" & cbvb(0).Trim.ToUpper Then
                        For Each k As Control In panel.Controls
                            If Mid(k.Name, 2, 1) = "C" Then
                                If Mid(k.Name, 4).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                    Try
                                        Dim vrednost As String
                                        If Not (cbo.SelectedValue) Is Nothing Then
                                            vrednost = cbo.SelectedValue.ToString.Trim
                                        Else
                                            vrednost = ""
                                        End If
                                        dcbpp_popuni(k, panel, True, vrednost)
                                    Catch ex As Exception
                                        ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                    End Try
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                End If
            Next
        End If
    End Sub

