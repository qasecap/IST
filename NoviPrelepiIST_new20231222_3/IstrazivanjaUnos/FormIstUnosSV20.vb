        myGraphics.DrawRectangle(pen:=myPen, x:=x, y:=y, width:=x1, height:=y1)

    End Sub

    Private Sub RoundingAndTruncatingRectangles(ByVal e As PaintEventArgs)
        ' Construct a new RectangleF.
        Dim myRectangleF As New RectangleF(30.6F, 30.7F, 40.8F, 100.9F)
        ' Call the Round method.
        Dim roundedRectangle As Rectangle = Rectangle.Round(myRectangleF)
        ' Draw the rounded rectangle in red.
        Dim redPen As New Pen(Color.Red, 4)
        e.Graphics.DrawRectangle(redPen, roundedRectangle)
        ' Call the Truncate method.
        Dim truncatedRectangle As Rectangle = Rectangle.Truncate(myRectangleF)
        ' Draw the truncated rectangle in white.
        Dim whitePen As New Pen(Color.White, 4)
        e.Graphics.DrawRectangle(whitePen, truncatedRectangle)
        ' Dispose of the custom pens.
        redPen.Dispose()
        whitePen.Dispose()
    End Sub

    ' By default, KeyDown does not fire for the ARROW keys
    Private Sub dugmepanetab_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs)
        Dim btn As Button = CType(sender, Button)
        Select Case (e.KeyCode)
            Case Keys.Down, Keys.Right
                If (Not (btn.ContextMenuStrip) Is Nothing) Then
                    btn.ContextMenuStrip.Show(btn, New Point(0, btn.Height), ToolStripDropDownDirection.BelowRight)
                End If
                If IsNumeric(btn.AccessibleDescription) Then
                    Dim bb As Button = DajSledeciDBTNPANE(Panel1, btn.AccessibleDescription)
                    If Not bb Is Nothing AndAlso bb.Enabled = True Then
                        bb.Focus()
                    Else
                        'SendKeys.SendWait("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                    End If
                Else
                    'SendKeys.SendWait("{TAB}")
                    'MORA OVAKO DOKAZ PROBNIPOPIS
                    Me.SelectNextControl(ActiveControl, True, True, True, True)
                End If
            Case Keys.Up, Keys.Left
                If (Not (btn.ContextMenuStrip) Is Nothing) Then
                    btn.ContextMenuStrip.Show(btn, New Point(0, btn.Height), ToolStripDropDownDirection.BelowRight)
                End If
                If IsNumeric(btn.AccessibleDescription) Then
                    Dim bb As Button = DajPrethodniDBTNPANE(Panel1, btn.AccessibleDescription)
                    If Not bb Is Nothing AndAlso bb.Enabled = True Then
                        bb.Focus()
                    Else
                        SendKeys.SendWait("+{TAB}")
                    End If
                Else
                    SendKeys.SendWait("+{TAB}")
                End If
        End Select
    End Sub
