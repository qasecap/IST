    Function sledeciRBR(ByVal trenutniRBR As Integer, ByVal panel As Panel) As Integer
        Dim nn() As Integer = nizRBR(panel)
        Dim tpom As Integer = Array.IndexOf(nn, trenutniRBR)
        If tpom = nn.GetUpperBound(0) Then
            'nema sledeci
            sledeciRBR = -10
        Else
            tpom = tpom + 1
            sledeciRBR = nn(tpom)
        End If
    End Function

    Function prethodniRBR(ByVal trenutniRBR As Integer, ByVal panel As Panel) As Integer
        Dim nn() As Integer = nizRBR(panel)
        Dim tpom As Integer = Array.IndexOf(nn, trenutniRBR)
        If tpom = 0 Then
            'nema prethodni
            prethodniRBR = -10
        Else
            tpom = tpom - 1
            prethodniRBR = nn(tpom)
        End If
    End Function

    Function nizRBR(ByVal panel As Panel) As Integer()
        Dim nn() As Integer = {}
        Dim i As Integer = -1
        ReDim Preserve nn(i)
        For Each k As Control In panel.Controls
            If TypeOf k Is TextBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse TypeOf k Is ComboBox AndAlso Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                'If Mid(k.Name.Trim.ToUpper, 1, 1) = "T" OrElse Mid(k.Name.Trim.ToUpper, 1, 1) = "C" Then
                Dim mm() As String = k.AccessibleDescription.Split(";")
                i = i + 1
                ReDim Preserve nn(i)
                nn(i) = mm(0)
            End If
        Next
        Array.Sort(nn)
        nizRBR = nn
    End Function

    Sub prethodnaKontrolaFocus(ByVal trenutniRBR As Integer, ByVal panel As Panel)
        Dim pRBR As Integer = prethodniRBR(trenutniRBR, panel)
        For Each k As Control In panel.Controls
            Dim mm() As String = k.AccessibleDescription.Split(";")
            If mm(0) = Str(pRBR).Trim AndAlso k.Enabled = True Then k.Focus()
            Exit For
        Next
    End Sub

    Sub sledecaKontrolaFocus(ByVal trenutniRBR As Integer, ByVal panel As Panel)
        Dim sRBR As Integer = sledeciRBR(trenutniRBR, panel)

        For Each k As Control In panel.Controls
            Dim mm() As String = k.AccessibleDescription.Split(";")
            If mm(0) = Str(sRBR).Trim AndAlso TypeOf k Is CheckBox Then
                For Each kk As Control In panel.Controls
                    Dim chP() As String = kojeugrupi(nizCHB, k.Tag)
                    For i As Integer = 0 To chP.GetUpperBound(0)
                        Dim ch As CheckBox = NadjiKontrolu(panel, "HH" + chP(i))
                        If Not ch Is Nothing Then ch.Visible = True
                    Next
                Next
            End If
            Exit For
        Next
    End Sub

    Sub sledeceKontroleVidljive(ByVal trenutniRBR As Integer, ByVal panel As Panel)
