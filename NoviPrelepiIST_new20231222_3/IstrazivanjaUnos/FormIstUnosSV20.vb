    Sub bbrisiRed(ByVal pp() As String, ByVal ist As Boolean, ByVal db As Boolean)
        'mnu02.Tag = GlavnaTabela + ";" + tValidFrom + ";" + tbox.Name.Substring(2) + ";" + Str(Forma).Trim + ";" + Str(p.rbr).Trim
        Dim trk() As String = pp(3).Split(".")
        If trk.Length = 3 Then
            Dim t As Integer = CInt(trk(0).Trim)
            Dim r As Integer = CInt(trk(1).Trim)
            Dim k As Integer = CInt(trk(2).Trim)

            Dim sqlI As String = "delete from _ISTTablesColumns where appCode=N'" + sifist + "' and tableName=N'" + pp(0).Trim + "' and tableLayout like '" + CStr(t).Trim + "." + CStr(r).Trim + ".%'" +
            " and cast (validFrom as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "';" + nvrd

            sqlI = sqlI + "update a set a.forma=rtrim(ltrim(str(f1))+'.'+ltrim(str((f2-1)))+'.'+ltrim(str(f3)))" +
                        " From istpolja a inner join vrepISTPolja b on a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje And a.vod=b.vod" +
                        " Where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and f1='" + CStr(t).Trim + "' and f2>" + CStr(r).Trim

            Dim sql As String = "select polje,isnull(pp,'') as pp from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and forma like '" + CStr(t).Trim + "." + CStr(r).Trim + ".%'" +
            " and cast (vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"
            Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Me.jezik)
            Dim sqlDB As String = "" : Dim sqlDBDropTip As String = "" : Dim DropTip As String = ""
            If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
                For i As Integer = 0 To dt.Rows.Count - 1
                    If dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "LBL" AndAlso dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "FP" Then
                        sqlDB = sqlDB + "ALTER TABLE " + pp(0).Trim + " DROP COLUMN " + dt.Rows(i).Item(0).ToString + ";" + nvrd
                        sqlDBDropTip = sqlDBDropTip + pp(0).Trim + ";" + dt.Rows(i).Item(0).ToString + "#"
                        DropTip = DropTip + "DROP" + "#"
                    End If
                Next
            End If

            Dim p1 As String = "nok"
            Dim p2 As String = "nok"

            If ist = True And db = False Then
                p2 = napraviBackUpizvrsiSQL(sqlI)
                If p2 = "nok" Then ISTMessageBox.Show("Error!") Else Call subREFRESH("C")
            End If
            If ist = True And db = True Then
                p1 = napraviBackUpizvrsiSQL(sqlI, , sqlDBDropTip.TrimEnd("#"), DropTip.TrimEnd("#"))
                If p1 = "nok" Then ISTMessageBox.Show("Error!")
                p2 = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
                If p2 = "nok" Then ISTMessageBox.Show("Error!")
                If p1 = "ok" AndAlso p2 = "ok" Then Call subREFRESH("C")
            End If

        End If
    End Sub

    Sub bbrisiKolonu(ByVal pp() As String, ByVal ist As Boolean, ByVal db As Boolean)
        'mnu02.Tag = GlavnaTabela + ";" + tValidFrom + ";" + tbox.Name.Substring(2) + ";" + Str(Forma).Trim + ";" + Str(p.rbr).Trim
        Dim trk() As String = pp(3).Split(".")
        If trk.Length = 3 Then
            Dim t As Integer = CInt(trk(0).Trim)
            Dim r As Integer = CInt(trk(1).Trim)
            Dim k As Integer = CInt(trk(2).Trim)
            Dim sqlI As String = "delete from _ISTTablesColumns where appCode=N'" + sifist + "' and tableName=N'" + pp(0).Trim + "' and tableLayout like '" + CStr(t).Trim + ".%." + CStr(k).Trim + "'" +
            " and cast (validFrom as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "';" + nvrd

            sqlI = sqlI + "update a set a.forma=rtrim(ltrim(str(f1))+'.'+ltrim(str((f2)))+'.'+ltrim(str(f3-1)))" +
                        " from istpolja a inner join vrepISTPolja b on a.sifist=b.sifist and a.tabela=b.tabela And a.polje=b.polje And a.vod=b.vod" +
                        " where a.sifist=N'" + sifist + "' and a.tabela=N'" + pp(0).Trim + "' and f1='" + CStr(t).Trim + "' and f3>" + CStr(k).Trim

            Dim sql As String = "select polje,pp from vrepISTPolja where sifist=N'" + sifist + "' and tabela=N'" + pp(0).Trim + "' and forma like '" + CStr(t).Trim + ".%." + CStr(k).Trim + "'" +
            " and cast (vod as date)='" + Convert.ToDateTime(pp(1)).ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) + "'"
            Dim dt As DataTable = izvrsiSQLvratiDT(sql, Me.ISTConnectionString, Me.jezik)
            Dim sqlDB As String = "" : Dim sqlDBDropTip As String = "" : Dim DropTip As String = ""
            If Not dt Is Nothing AndAlso dt.Rows.Count > 0 Then
                For i As Integer = 0 To dt.Rows.Count - 1
                    If dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "LBL" AndAlso dt.Rows(i).Item("pp").ToString.Trim.ToUpper <> "FP" Then
                        sqlDB = sqlDB + "ALTER TABLE " + pp(0).Trim + " DROP COLUMN " + dt.Rows(i).Item(0).ToString + ";" + nvrd
                        sqlDBDropTip = sqlDBDropTip + pp(0).Trim + ";" + dt.Rows(i).Item(0).ToString + "#"
                        DropTip = DropTip + "DROP" + "#"
                    End If
                Next
            End If

            Dim p1 As String = "nok"
            Dim p2 As String = "nok"

            If ist = True And db = False Then
                p2 = napraviBackUpizvrsiSQL(sqlI)
                If p2 = "nok" Then
                    ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Else
                    Call subREFRESH("C")
                End If
            End If
            If ist = True And db = True Then
                p1 = napraviBackUpizvrsiSQL(sqlI,, sqlDBDropTip.TrimEnd("#"), DropTip.TrimEnd("#"))
                If p1 = "nok" Then ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                p2 = izvrsiSQLDB(sqlDB, Me.DBConnectionString)
                If p2 = "nok" Then ISTMessageBox.Show("Error!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                If p1 = "ok" AndAlso p2 = "ok" Then Call subREFRESH("C")
            End If
        End If
