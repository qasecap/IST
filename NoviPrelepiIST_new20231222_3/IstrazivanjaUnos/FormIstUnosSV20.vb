    Function fixTime(ByVal tt As String) As String
        If tt.Length = 4 AndAlso tt.IndexOf(":") < 0 AndAlso IsNumeric(tt) Then
            tt = tt.Substring(0, 2) + ":" + tt.Substring(2, 2)
        ElseIf tt.Length = 3 AndAlso tt.IndexOf(":") < 0 AndAlso IsNumeric(tt) Then
            tt = tt.Substring(0, 2) + ":" + tt.Substring(2, 1) + "0"
        ElseIf tt.Length = 2 AndAlso tt.IndexOf(":") < 0 AndAlso IsNumeric(tt) Then
            tt = tt + ":00"
        ElseIf tt.Length = 1 AndAlso tt.IndexOf(":") < 0 AndAlso IsNumeric(tt) Then
            tt = "0" + tt + ":00"
        ElseIf tt.Length < 5 AndAlso tt.IndexOf(":") >= 0 Then
            Dim t() As String = tt.Split(":")
            If t(0).Trim.Length = 0 Then t(0) = "00"
            If t(0).Trim.Length = 1 Then t(0) = "0" + t(0)
            If t(1).Trim.Length = 0 Then t(1) = "00"
            If t(1).Trim.Length = 1 Then t(1) = "0" + t(0)
            tt = t(0) + ":" + t(1)
        End If
        Return tt
    End Function

