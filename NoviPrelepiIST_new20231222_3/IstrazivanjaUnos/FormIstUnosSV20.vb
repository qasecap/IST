    Private Sub PreracunajFPIzTabeleuMem(ByVal k As Control)

        Dim tabela As String = GlavnaTabela
        Dim zzz As String = k.Tag.izraz

        Dim pomkol As New DataColumn("pomKol")
        Try
            Dim xxx As Object
            If zzz.ToString.Trim.IndexOf("{") = 0 Then
                'vuce polja iz memorije iz ostalih podatabela
                zzz = zzz.Replace("{", "").Replace(";}", "").Replace("; }", "").Replace("}", "")
                zzz = sracPodtabele(zzz)
                zzz = razCASTi(zzz)
                zzz = zameniSpace(zzz.Trim)
                zzz = zameniISTLabels(zzz)
                Dim tbl As DataTable = New DataTable()
                xxx = NZ(tbl.Compute(zzz, Nothing))
            Else
                If zzz.ToUpper.Trim.IndexOf("D.") >= 0 Then
                    zzz = zzz.Replace("D.", "").Replace("d.", "")
                    zzz = zameniSpace(zzz.Trim)
                    zzz = zameniISTLabels(zzz)
                    pomkol.Expression = zzz.Replace("N'", "'")
                    DGTabele(DGi(tabela)).Columns.Add(pomkol)
                    xxx = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol)", ""))
                    DGTabele(DGi(tabela)).Columns.Remove(pomkol)
                Else
                    Dim tbl As DataTable = New DataTable()
                    xxx = NZ(tbl.Compute(zzz, Nothing))
                End If
            End If
            k.Text = CStr(xxx).Trim
        Catch ex As Exception
            Call zatvoriOLHC()
            k.Text = ""
            MsgBox(ex.Message + nvrd + nvrd +
