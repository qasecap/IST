    Sub sklopiISTDataGridViewOstalo(ByVal istDGVcntl As DataGridView2)

        'sad kad je dodato dgv vidi colone pa može da se prikaže sta treba
        If Not istDGVcntl Is Nothing Then
            Dim blk As Integer = 0
            For Each c As DataGridViewColumn In istDGVcntl.Grid.Columns
                If TypeOf c Is DataGridViewLinkColumn Then
                    blk = blk + 1
                Else
                    c.Visible = False
                End If
            Next
            Dim ll As Integer = 0
            If blk > 0 Then
                ll = blk - 1
            Else
                ll = dodajLL(istDGVcntl.Grid)
            End If

            If istDGVcntl.Tag <> "" AndAlso istDGVcntl.Tag <> ";" AndAlso istDGVcntl.Tag.indexof(";") >= 0 Then
                Dim dd() As String = istDGVcntl.Tag.split(";")
                Dim wwidth() As String = Nothing : Dim imaw As Boolean = False
                If dd.Length > 1 AndAlso dd(1) <> "" Then wwidth = dd(1).Split(",") : imaw = True
                If dd.Length > 0 Then
                    Dim ccolumns() As String = dd(0).Split(",")
                    Dim dgvDi As String = ""
                    Try
                        Dim ddc As String = ""
                        Dim ddi As String = ""

                        For im As Integer = 0 To ccolumns.GetUpperBound(0)
                            Dim headerName() As String = ccolumns(im).Split("=")
                            Dim headerName0 As String = ""
                            Dim headerName1 As String = ""
                            If ccolumns(im).IndexOf("=") > 0 Then
                                headerName0 = Mid(ccolumns(im), 1, ccolumns(im).LastIndexOf("="))
                                headerName1 = Mid(ccolumns(im), ccolumns(im).LastIndexOf("=") + 2)
                            End If
                            Dim ww As String = headerName0
                            If headerName1 <> "" Then ww = headerName1

                            Dim cind As String = DirectCast(istDGVcntl.Grid.DataSource, System.Data.DataView).Table.Columns(ww).Namespace.ToString.Trim
                            If cind <> "" And IsNumeric(cind) Then
                                ddc = ddc + ww + ";"
                                ddi = ddi + cind + ";"
                            End If

                            Try
                                If headerName1 <> "" Then

                                    istDGVcntl.Grid.Columns(headerName1).Visible = True
                                    istDGVcntl.Grid.Columns(headerName1).HeaderText = headerName0
                                    If imaw = True Then istDGVcntl.Grid.Columns(headerName1).Width = wwidth(im)
                                    istDGVcntl.Grid.Columns(headerName1).DisplayIndex = ll + 1 + im
                                    dgvDi = dgvDi + headerName1 + "$" + (ll + 1 + im).ToString.Trim + "#"
                                Else
                                    istDGVcntl.Grid.Columns(headerName0).Visible = True
                                    istDGVcntl.Grid.Columns(headerName0).DisplayIndex = ll + 1 + im
                                    dgvDi = dgvDi + headerName0 + "$" + (ll + 1 + im).ToString.Trim + "#"
                                End If
                            Catch ex As Exception
                                Dim t As String = DirectCast(istDGVcntl.Grid.DataSource, System.Data.DataTable).TableName
                                If headerName1 <> "" Then
                                    ISTMessageBox.Show(headerName1 + "  does not exists in table " + t + " !!!!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                Else
                                    ISTMessageBox.Show(headerName0 + "  does not exists in table " + t + " !!!!", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                End If
                            End Try
                        Next

                        If ddc <> "" Then 'mora da se presortira
                            ddc = ddc.TrimEnd(";")
                            ddi = ddi.TrimEnd(";")
                            Dim ip() As String = ddi.Split(";") : Dim cp() As String = ddc.Split(";")
                            For i As Integer = 0 To ip.GetUpperBound(0)
                                For im As Integer = 0 To ccolumns.GetUpperBound(0) '14
                                    Dim hn As String = getHeaderName(ccolumns(im))
                                    If istDGVcntl.Grid.Columns(hn).DisplayIndex = ip(i) Then
                                        istDGVcntl.Grid.Columns(cp(i)).DisplayIndex = CInt(ip(i))
                                        For im2 As Integer = im + 1 To ccolumns.GetUpperBound(0) '14
                                            Dim hn1 As String = getHeaderName(ccolumns(im2))
                                            istDGVcntl.Grid.Columns(hn1).DisplayIndex = istDGVcntl.Grid.Columns(hn1).DisplayIndex + 1
                                        Next
                                    End If
                                Next
                            Next
                            dgvDi = ""
                            For im As Integer = 0 To ccolumns.GetUpperBound(0)
                                Dim hn As String = getHeaderName(ccolumns(im))
                                dgvDi = dgvDi + hn + "$" + istDGVcntl.Grid.Columns(hn).DisplayIndex.ToString.Trim + "#"
                            Next
                        End If
                        'istDGVcntl.Grid.Columns(ww).Visible = True
                        'istDGVcntl.Grid.Columns(ww).DisplayIndex = ll + 1 + im
                        'dgvDi = dgvDi + ww + "$" + (ll + 1 + im).ToString.Trim + "#"
                        dgvDi = (dgvDi + "#").Replace("##", "")
                        istDGVcntl.Grid.AccessibleDefaultActionDescription = istDGVcntl.Grid.AccessibleDefaultActionDescription & "COLUMNDISPLAYINDEX=" & dgvDi & ";"
                    Catch ex As Exception
                        MsgBox(ex.Message, MsgBoxStyle.Information, "sklopiDataGridViewOstalo")
                    End Try
                End If
            End If

        End If
    End Sub
    Function getHeaderName(ByVal ccolumnsim As String) As String
        Dim headerName() As String = ccolumnsim.Split("=")
        Dim headerName0 As String = "" : Dim headerName1 As String = ""
        If ccolumnsim.IndexOf("=") > 0 Then
            headerName0 = Mid(ccolumnsim, 1, ccolumnsim.LastIndexOf("="))
            headerName1 = Mid(ccolumnsim, ccolumnsim.LastIndexOf("=") + 2)
        End If
        Dim ww As String = headerName0
        If headerName1 <> "" Then ww = headerName1
        Return ww
    End Function
