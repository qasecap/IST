                cbox.BackColor = SystemColors.ActiveCaption
                mnu02.Tag = cbox.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "cb"
                tmCB.Visible = False
            ElseIf TypeOf cntl Is CheckBox Then
                Dim chbox As CheckBox = DirectCast(cntl, CheckBox)
                chbox.BackColor = SystemColors.ActiveCaption
                mnu02.Tag = chbox.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "chb"
                tmChB.Visible = False
            ElseIf TypeOf cntl Is RadioButton Then
                Dim rb As RadioButton = DirectCast(cntl, RadioButton)
                mnu02.Tag = rb.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "rb"
                tm92.Visible = False

            ElseIf TypeOf cntl Is DataGridView2 Then
                Dim dgv2 As DataGridView2 = DirectCast(cntl, DataGridView2)
                mnu02.Tag = dgv2.AccessibleDefaultActionDescription
                mnu02.AccessibleDescription = "dgv2"
                Call visCNTL("dgv2")
            ElseIf TypeOf cntl Is Button Then
                Dim btn As Button = DirectCast(cntl, Button)
                mnu02.Tag = btn.AccessibleDefaultActionDescription
                If btn.Name.IndexOf("Button") = 0 Then
                    mnu02.AccessibleDescription = "button"
                    'appereance
                    Call nestoAPP()
                Else
                    mnu02.AccessibleDescription = "btn"   'button za Podtabelu
                    'appereance
                    Call samoAPP()
                End If
                mnu02.Tag = btn.AccessibleDefaultActionDescription
            ElseIf TypeOf cntl Is Label Then
                'SAMO appereance
                Call samoAPP()
                Dim lbl As Label = DirectCast(cntl, Label)
                If Not lbl.Tag Is Nothing AndAlso lbl.Tag = "title" Then
                    lbl.BackColor = SystemColors.ActiveCaption
                    mnu02.AccessibleDescription = "title"
                    mnu02.Tag = lbl.AccessibleDefaultActionDescription
                Else
                    mnu02.AccessibleDescription = "lbl"
                    If cntl.Name.Trim.ToUpper.IndexOf("L") = 0 Then
                        Dim nnametbox As String = cntl.Name.Substring(1)
                        Dim k As Control = NadjiKontroluSkr(cntl.Parent, nnametbox, 2)
                        If Not k Is Nothing Then mnu02.Tag = k.AccessibleDefaultActionDescription
                    End If
                End If
            End If
        End If
