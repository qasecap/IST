                Try
                    frm.ShowDialog()
                Catch ex As Exception
                    ISTMessageBox.Show(ex.Message, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                    frm.Dispose()
                End Try

                If frm.menjano Then sacuvano = True

                If frm.dfm = True Then dfm = True
                If vju = False Then
                    Dim nadtabela As String = nadtabelaJe(imeTabele)
                    Dim kljucNadtabela() As String = DajKljuceve(nadtabela)
                    Dim kljucadNadtabela(,) As String
                    ReDim kljucadNadtabela(GlavniKljuc.GetUpperBound(0), 1)
                    For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
                        kljucadNadtabela(i, 0) = GlavniKljuc(i).Trim.ToUpper
                        kljucadNadtabela(i, 1) = SEK(GlavniKljuc(i)).Trim.ToUpper
                    Next
                    If Not Me.NslKljuc Is Nothing Then
                        DGTabele(DGi(imeTabele)).Clear()
                        DGTabeleOriginal(DGi(imeTabele)).Clear()
                        Dim sql As String = " 2=2 "
                        For i As Integer = 0 To kljucadNadtabela.GetUpperBound(0)
                            sql = sql & " and " & kljucadNadtabela(i, 0).Trim.ToUpper & "='" & kljucadNadtabela(i, 1).Trim & "' "
                        Next

                        Dim red As DataRow() = DTbl(DGi(imeTabele, DTbl)).Select(sql.Replace("=N'", "='"))
                        If red.Length > 0 Then
                            For Each r As DataRow In red
                                DGTabele(DGi(imeTabele)).ImportRow(r)
                                DGTabeleOriginal(DGi(imeTabele)).ImportRow(r)
                            Next
                        End If
                    End If
                End If


                sender.refresh()

                dalje = frm.ELzaPamceno
                If dalje Then
                    Dim tred As Integer = gdeSamUGridu 'dgr.CurrentRowIndex
                    dgr.ClearSelection()
                    If Not frm.ELRefresh Then
                        If tred < dgr.Rows.Count - 1 Then
                            dgr.Rows(tred + 1).Selected = True
                            dgr.CurrentCell = dgr.Rows(tred + 1).Cells(0)
                        Else
                            dgr.Rows(tred).Selected = True
                            dgr.CurrentCell = dgr.Rows(tred).Cells(0)
                        End If
                    End If
                    dgr.Refresh()
                    PreracunajFP()
                    If (Not frm.ELRefresh) And dgr.CurrentRow.Index = tred Then
                        dalje = False
                        dgr.Rows(tred).Selected = True
                        dgr.CurrentCell = dgr.Rows(tred).Cells(0)
                        dgr.Refresh()
                        'Nevena dodala
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                        Exit While
                    End If
                    If frm.neididalje = True Then
                        'Nevena dodala
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                        Exit While
                    End If
                Else
                    PreracunajFP()
                    Me.SelectNextControl(ActiveControl, True, True, True, True)
                    Exit While
                End If
            End If
        End While
    End Sub

