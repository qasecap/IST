            If bbb(i).Length > 3 AndAlso bbb(i).Substring(0, 4).ToUpper = "#FP{" Then
                pp = SE(bbb(i).Replace("}", "").Substring(4), True, panel).Trim.Replace("'", dap)
                If i - 2 >= 0 AndAlso bbb(i - 2).Length >= 5 AndAlso bbb(i - 2).Trim.ToUpper = "ISNULL" Then
                    If i + 2 <= bbb.GetUpperBound(0) AndAlso bbb(i + 2).Length >= 0 AndAlso bbb(i + 2).Trim.ToUpper = "0" Then
                        If IsNumeric(pp) = True Then
                            bbb(i) = pp
                        ElseIf pp = "''" OrElse pp = "" Then
                            'pp = "Null"
                            bbb(i) = "Null"
                        Else
                            bbb(i) = "'" + pp + "'"
                        End If
                    Else
                        bbb(i) = "'" + pp + "'"
                    End If
                ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                    bbb(i) = pp
                ElseIf pp = "0" Then  'samo nula
                    bbb(i) = pp
                Else
                    bbb(i) = "'" + pp + "'"
                End If
            End If
        Next
        pomfilterIs = ustringaj(bbb).ToUpper
        DataSourceDB = DataSourceDB + " and " + pomfilterIs


        If DataSourceDB.Trim.ToUpper.IndexOf("GLAVA.") >= 0 OrElse DataSourceDB.Trim.ToUpper.IndexOf("HEAD.") >= 0 Then
            'nadji nadtabela sta je
            Dim nadtabela As String = nadtabelaJe(Me.GlavnaTabela)
            Dim zzz As String = DataSourceDB
            Dim pompo() As String = razkvantaj(zzz)
            For i As Integer = 0 To pompo.Length() - 1
                pompo(i) = GlavaHead(pompo(i), DTbl(DGi(nadtabela)).Rows(0))
            Next
            zzz = ustringaj(pompo).ToUpper
            DataSourceDB = zzz
        End If

        'zamena GGGMMM
        Dim sql As String = DataSourceDB.Trim.ToUpper
        DataSourceDB = ZameniGGGMMMUnos(sql)

        Call popuniAutbDB(actbox, DataSourceDB, "")

    End Sub
    Private Sub filterValueKLJUC(ByVal autb As AutoCompleteTextbox, ByVal odakle As Integer)
