    Sub ddodelaKljuc(ByVal plj As String, tbox As TextBox, ByVal nizdodeliKome() As String, ByVal nizdodeliSta() As String, ByVal nizdodeliAko() As String, ByVal dodeliSta As String, ByVal dodelikome As String)
        If nizdodeliKome.Length > 0 AndAlso nizdodeliSta.Length > 0 Then

            Dim ub As Integer = nizdodeliKome.Length - 1
            If nizdodeliKome.Length <> nizdodeliSta.Length Then
                ISTMessageBox.Show("ASSIGN TO length is different from ASSIGN WHAT length" + nvrd + nvrd + Str(nizdodeliKome.Length).Trim + ":   " + dodelikome.Replace("$", " | ") + nvrd + nvrd +
                                    Str(nizdodeliSta.Length).Trim + ":   " + dodeliSta.Replace("$", " | "), "ERROR IN METADATA", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                If nizdodeliKome.Length > nizdodeliSta.Length Then ub = nizdodeliSta.Length - 1
                If nizdodeliSta.Length > nizdodeliKome.Length Then ub = nizdodeliKome.Length - 1
            End If

            If nizdodeliAko.Length < ub Then
                For i As Integer = nizdodeliAko.Length To ub
                    ReDim Preserve nizdodeliAko(i)
                    nizdodeliAko(i) = "2=2"
                Next
            End If

            Dim ooo As Boolean = okvalidacija

            For sss As Integer = 0 To ub
                Try
                    Call ddodela(GlavnaTabela, plj, tbox, nizdodeliAko(sss), nizdodeliKome(sss), nizdodeliSta(sss))
                Catch ex As Exception
                    ''msg 21
                    Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                    ISTMessageBox.Show(ex.Message, msgtxt21 + ": ddodela1 pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Finally
                End Try
            Next

            okvalidacija = ooo

        End If ' If dodeliKome.Length <> 0 AndAlso dodeliSta.Length <> 0 AndAlso tbox.Text.Trim.Length > 0 Then
    End Sub
    Sub lockgroupby(ByVal plj As String)
        Dim pljlockby As String = ""
        Dim sqlpk As String = ""
        'If lockby <> "" Then
        If lockby.IndexOf(",") > 0 Then
            Dim pp() As String = lockby.Split(",")
            For ii As Integer = 0 To pp.GetUpperBound(0)
                sqlpk = sqlpk + " and " & pp(ii) & " ='" & SEK(pp(ii)) & "'"
            Next
            pljlockby = pp(pp.GetUpperBound(0))
        Else
            sqlpk = sqlpk + " and " & lockby & " ='" & SEK(lockby) & "'"
            pljlockby = lockby
        End If

        If plj = pljlockby Then
            Dim zakljucanUnos As Integer = ProveraUnosLOCKBY(sqlpk)
            If zakljucanUnos = 1 Then
                zzakljucabBy = True
                Call DisableSve()
            Else
                zzakljucabBy = False
                Call EnableSve()
            End If
        ElseIf zzakljucabBy = True Then
            zzakljucabBy = True
            Call DisableSve()
        End If
        'End If
    End Sub

    Dim zzakljucabBy As Boolean = False

    Private Function ProveraUnosLOCKBY(ByVal sqlpk As String) As Integer ' vraca 1 ako je zakljucan unos
        ProveraUnosLOCKBY = 0

        'da li uopste postoji LK polje
        If Not (DGTabele(DGi(GlavnaTabela)).Columns("LK") Is Nothing) Then
            Dim sql As String = " select min(cast (isnull(LK,0) as integer)) as LK from " + Me.prfxt(GlavnaTabela) & " where 2=2 "

            'uslov samo sa vrtackom
            For i As Integer = 0 To Me.GlavniKljuc.GetUpperBound(0)
                If Me.GlavniKljuc(i) = "GOD" OrElse Me.GlavniKljuc(i) = "MES" OrElse Me.GlavniKljuc(i) = "ISTYEAR" OrElse Me.GlavniKljuc(i) = "ISTMONTH" Then
                    sql = sql + " and " & Me.GlavniKljuc(i) & " ='" & SEK(Me.GlavniKljuc(i)) & "'"
                End If
            Next

            If sqlpk <> "" Then sql = sql + sqlpk

            Dim dt As DataTable
            dt = izvrsiSQLvratiDT(sql, Me.DBConnectionString, Me.jezik)

            'ako je min=1 to znaci da us svi iz vrtacke imaju LK1 onda ne dozvoljavam unos novog,
            'ako ima mesano onda moze unos novog
            If Not (dt.Rows(0).Item("LK") Is Nothing) AndAlso (Not (dt.Rows(0).Item("LK").GetType Is GetType(System.DBNull))) AndAlso dt.Rows(0).Item("LK") = 1 Then
                ProveraUnosLOCKBY = 1
            End If
        End If

    End Function

    Sub filterZaCBO(ByVal tbox As TextBox, ByVal plj As String, ByVal naEkran As String, ByVal menjankljuc As Boolean, Optional pp As Panel = Nothing)
        Dim panel As Panel = Me.Panel1
        If SCati = True AndAlso Not pp Is Nothing Then panel = pp
        Dim nizCBnaCb As String() = Split(CBnaCB, ";")
        If CBnaCB <> "" AndAlso nizCBnaCb.Length > 0 Then
            For i As Integer = 0 To nizCBnaCb.Length - 1
                Dim cbvb As String() = Split(nizCBnaCb(i), ",")
                'filter je vrednost iz kljuca
                If cbvb.Length = 2 Then
                    If cbvb(0).Trim.ToUpper <> "" Then
                        If tbox.Name.Trim.ToUpper = "TK" & cbvb(0).Trim.ToUpper OrElse tbox.Name.Trim.ToUpper = "CK" & cbvb(0).Trim.ToUpper Then
                            For Each k As Control In panel.Controls
                                If Mid(k.Name, 1, 1) = "C" Then
                                    If Mid(k.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                        cbpp_popuni(k, True, SEK(plj))
                                        Exit For
                                    End If
                                End If
                            Next
                        End If
                        'filter je neko fiktivno polje
                        If cbvb(0).Trim.ToUpper.IndexOf("#FP{") = 0 Then
                            Dim bbb As String = cbvb(0).Trim.ToUpper.Replace("#FP{", "").Replace("}", "")
                            Dim ind As Integer = Array.IndexOf(nizFPime, bbb)
                            'zameni fiktivno polje sa  SE(bbb, True).Trim + "'"
                            For Each cc As Control In panel.Controls
                                If Mid(cc.Name, 1, 1) = "C" AndAlso Mid(cc.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                    If ind > -1 Then cbpp_popuni(cc, True, SE(bbb, True, nizFP(ind).Parent))
                                    If SCati = False Then
                                        If ind > -1 Then cbpp_popuni(cc, True, SE(bbb, True, nizFP(ind).Parent))
                                    Else
                                        cbpp_popuni(cc, True, SE(bbb, True, panel))
                                    End If
                                    Exit For
                                End If
                            Next
                        End If
                        'filter je neko bilo koje text polje
                        'ovo ako je radio i neku dodelu preko kljuca, prvo je isla gore dodela, a sad moze i da popuni CB
                        For Each k As Control In panel.Controls
                            If Mid(k.Name.Trim.ToUpper, 3) = cbvb(0).Trim.ToUpper Then
                                For Each cc As Control In panel.Controls
                                    If Mid(cc.Name, 1, 1) = "C" AndAlso Mid(cc.Name, 3).Trim.ToUpper = cbvb(1).Trim.ToUpper Then
                                        If SCati = False Then
                                            Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cbvb(0).Trim.ToUpper)
                                            If ind > -1 Then cbpp_popuni(cc, True, SE(cbvb(0).Trim.ToUpper,, nizKontrola(ind).Parent))
                                        Else
                                            cbpp_popuni(cc, True, SE(cbvb(0).Trim.ToUpper,, panel))
                                        End If
                                        'dodeli cc ucestvuje u dodeli
                                        Dim nizNaEkran As String() = Split(naEkran.Trim.ToUpper, ";")
                                        For m As Integer = 0 To nizNaEkran.GetUpperBound(0)
                                            If nizNaEkran(m).IndexOf(cbvb(1).Trim.ToUpper) >= 0 Then
                                                Dim ssttaa As String() = Split(nizNaEkran(m).Trim.ToUpper, "$")
                                                NaE(cbvb(1).Trim.ToUpper, ssttaa(1), menjankljuc)
                                                If SCati = False Then
                                                    NaE(cbvb(1).Trim.ToUpper, ssttaa(1), menjankljuc)
                                                Else
                                                    NaE(cbvb(1).Trim.ToUpper, ssttaa(1), menjankljuc, panel)
                                                End If
                                            End If
                                        Next
                                        Exit For
                                    End If
                                Next
                            End If
                        Next
                    End If
                End If

            Next
        End If
    End Sub

