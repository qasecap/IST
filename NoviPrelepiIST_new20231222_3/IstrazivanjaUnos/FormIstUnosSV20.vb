            For i As Integer = 0 To kkv.GetUpperBound(0)
                If InStr(kkv(i).Trim, ".") <> 0 Then
                    izrazW = izrazW & " " & Mid(kkv(i).Trim, InStr(kkv(i).Trim, ".") + 1).Trim
                Else
                    izrazW = izrazW & " " & kkv(i).Trim
                End If
            Next
            izrazW = izrazW.Replace(" ' ", "'")

            kkv = Nothing
            Dim r() As DataRow = dd.Select(izrazW)
            If SamoTF Then
                If r.Length > 0 Then
                    Return " 2=2 "
                Else
                    Return " 2=3 "
                End If
            Else

                Dim ppz As Integer = Array.IndexOf(kv, "SELECT") + 1
                If kv(ppz + 1) = "(" Then
                    Dim brz As Integer = 1 : Dim krz As Integer = 0
                    For i As Integer = ppz + 2 To kv.GetUpperBound(0)
                        If kv(i) = "(" Then brz += 1
                        If kv(i) = ")" Then brz -= 1
                        If brz = 0 Then
                            krz = i
                            Exit For
                        End If
                    Next
                    Dim izrC As String = ustringaj(kv, ppz, krz)
                    If InStr(izrC, "COUNT") <> 0 Then
                        Return r.Length
                    ElseIf InStr(izrC, "ISNULL") <> 0 Then
                        If (krz - 1) - (ppz + 2) > 1 Then
                            Dim pizrC As String = ustringaj(kv, ppz + 2, krz - 1)
                            Dim nulltrt As String() = pizrC.Split(",")
                            Dim deoL As String = nulltrt(0)
                            Dim deoR As String = nulltrt(1)
                            Return IzDGTzaSQL(deoL.Trim.ToUpper, dd, , tabela)
                        Else
                            Return NZ(dd.Compute(izrC, izrazW))
                        End If
                    Else

                        If (krz - 1) - (ppz + 2) > 1 Then
                            Dim pizrC As String = ustringaj(kv, ppz + 2, krz - 1)
                            Dim pomkol As New DataColumn("pomKol")
                            pomkol.Expression = pizrC.Replace("N'", "'")
                            dd.Columns.Add(pomkol)
                            Dim pIzrC2 As String = kv(ppz).Trim & "(pomKol)"
                            Dim xxx As Object = NZ(dd.Compute(pIzrC2, izrazW))
                            dd.Columns.Remove(pomkol)
                            Return xxx
                        Else
                            Return NZ(dd.Compute(izrC, izrazW))
                        End If
                    End If
                Else
                    Return IzDGTzaSQL(kv(ppz).Trim.ToUpper, dd, , tabela)
                End If
            End If
        Else
            'za decimal i numeric mora ovo jer sql server ne pusta cast('' as decimal), dok pusta  cast('' as float)
            izraz = izraz.Replace("CAST ( '' AS DECIMAL", "CAST ( '0' AS DECIMAL")
            izraz = izraz.Replace("CAST ( '' AS NUMERIC", "CAST ( '0' AS NUMERIC")
            Dim dt As DataTable = izvrsiSQLvratiDT(izraz, Me.DBConnectionString, Me.jezik)
            If SamoTF Then
                If dt.Rows.Count > 0 Then
                    Return " 2=2 "
                Else
                    Return " 2=3 "
                End If
            Else
                If SuCimUsao.Trim.ToUpper = "IN" Then
                    Dim r As String = ""
                    For i As Integer = 0 To dt.Rows.Count - 1
                        If r.Length > 0 Then r = r + ","
                        r = r + IzDGTzaSQL(0, dt, i, tabela)
                    Next
                    If r <> "" Then
                        Return " (" & r & ") "
                    Else
                        Return " ('-9999999') "
                    End If
                Else
                    Return IzDGTzaSQL(0, dt, , tabela)
                End If
            End If
        End If
        Return xpom
    End Function

    Private Function BasTajKljuc(ByVal izraz As String) As Boolean
        Dim xpom As Boolean = True
        izraz = izraz.Trim
        izraz = Mid(izraz, InStr(izraz.Trim.ToUpper, "WHERE") + 5).Trim.ToUpper
        izraz = izraz.Replace("'", "")
        Dim ddd As DataTable
        'nslKljuc - nasledjeni kljuc (znaci DUPE SI)
        If NslKljuc Is Nothing Then
            'glava
            ddd = DGTabele(DGi(GlavnaTabela))
        Else
            'dupe
            If DGTabelePanel(DGi(GlavnaTabela)).Rows.Count > 0 Then
                ddd = DGTabelePanel(DGi(GlavnaTabela))
            Else
                If DTbl Is Nothing Then
                    ddd = DGTabele(DGi(GlavnaTabela))
                Else
                    ddd = DTbl(DGi(GlavnaTabela, DTbl))
                End If

            End If
        End If
        Dim k() As String = razkvantaj(izraz)
        For i As Integer = 0 To k.GetUpperBound(0)
            k(i) = k(i).Replace("JA.", "")
            k(i) = k(i).Replace("MEM.", "")
        Next
        Dim klj() As String = {}
        For Each it As DatasetIstrazivanja.ISTTABELERow In dIst.ISTTABELE.Rows
            Dim tabDG As String = IIf(it.Item("DG") Is System.DBNull.Value, "G", it.Item("DG"))
            If tabDG.Trim.ToUpper = "G" AndAlso Me.IstaGlava(GlavnaTabela.Trim.ToUpper, it.Tabela.Trim.ToUpper) Then
                klj = Me.DajKljuceve(it.Tabela.Trim.ToUpper)
                Exit For
            End If
        Next
        If Not (klj Is Nothing) AndAlso klj.Length > 0 Then
            For i As Integer = 0 To klj.GetUpperBound(0)
                Dim p As Integer = Array.IndexOf(k, klj(i).Trim.ToUpper)
                If p < 0 Then Return False

                Dim rzr As String = ""
                If ddd.Rows.Count > 0 Then
                    If ddd.Rows(0).Item(klj(i)).GetType Is GetType(System.DBNull) Then
                        rzr = "''"
                    Else
                        rzr = CStr(ddd.Rows(0).Item(klj(i)))
                    End If
                End If

                If rzr.Length = 0 Then rzr = "''"

                If p + 1 < k.GetUpperBound(0) AndAlso k(p + 1) = "=" Then
                    If (ddd.Rows().Count > 0) AndAlso Replace(k(p + 2), "'", "").Trim.ToUpper <> Replace(rzr, "'", "").Trim.ToUpper Then
                        Return False
                    End If
                Else

                    If p > 1 AndAlso k(p - 1) = "=" Then
                        If (ddd.Rows().Count() > 0) AndAlso Replace(k(p - 2), "'", "").Trim.ToUpper <> Replace(rzr, "'", "").Trim.ToUpper Then Return False
                    Else
                        Return False
                    End If
                End If
            Next
        Else
            Return False
        End If
        Return (xpom)
    End Function

