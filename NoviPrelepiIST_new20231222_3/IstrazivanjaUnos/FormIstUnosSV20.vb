    Sub trenutniSledeciCATI(ByVal sledeci As Integer, ByVal pomcntl As Control, ByVal koji As String)
        For i As Integer = sledeci To 166
            Dim panelNext As Panel = NadjiKontrolu(Me, "CATI_" + i.ToString.Trim)
            Dim panelCurrent As Panel = NadjiKontrolu(Me, "CATI_" + (i - 1).ToString.Trim)
            If Not panelNext Is Nothing Then
                panelCurrent.Visible = False
                panelNext.Visible = True
                If Not prviTBNaCATIPanelu(panelNext) Is Nothing Then
                    prviTBNaCATIPanelu(panelNext).Focus()
                    Dim panelNextPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + i.ToString.Trim)
                    Dim panelPom As Panel = NadjiKontrolu(Me, "CATIPOM_" + (i - 1).ToString.Trim)
                    If Not panelNextPom Is Nothing Then
                        panelPom.Visible = False
                        panelNextPom.Visible = True
                        panelNextPom.BringToFront()
                    End If
                    Exit For
                    'Else
                    'ide dalje
                End If
            Else
                If koji = 1 Then
                    Call krajAnketiranja1(pomcntl)
                    Exit For
                End If
                If koji = 2 Then
                    Call krajAnketiranja2()
                    Exit For
                End If
            End If
        Next
    End Sub

