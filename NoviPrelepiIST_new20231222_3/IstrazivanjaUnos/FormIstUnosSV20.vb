    Private Function PoljaUGresci(ByVal tabela As String, ByVal greska As String) As String()
        Dim pompo() As String = {}
        For Each r As DatasetIstrazivanja.ISTPOLJARow In dIst.ISTPOLJA.Rows
            If r.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                If ELPoljeUGresci(r.POLJE, greska) Then
                    ReDim Preserve pompo(1 + pompo.GetUpperBound(0))
                    pompo(pompo.GetUpperBound(0)) = r.POLJE.Trim.ToUpper
                End If
            End If
        Next
        Return pompo
    End Function

    Private Function GreskeZaPolje(ByVal polje As String, Optional ByVal tabela As String = "", Optional ByVal SamoGlavne As Boolean = False) As String()
        Dim pompo() As String = {}
        If tabela = "" Then tabela = GlavnaTabela
        For Each r As DatasetIstrazivanja.ISTLKRow In dIst.ISTLK.Rows
            If r.TABELA.Trim.ToUpper = tabela.Trim.ToUpper Then
                If r.Item("uslov").GetType Is GetType(System.DBNull) OrElse (r.USLOV.Trim.ToUpper.IndexOf("LKVELIKA") < 0 AndAlso r.USLOV.Trim.ToUpper.IndexOf("EXECUTEONLYFROMDATAVALIDATIONMODULE") < 0 AndAlso r.USLOV.Trim.ToUpper.IndexOf("DONTSEND") < 0) Then
                    If ELPoljeUGresci(polje, r.GRESKA.Trim.ToUpper, SamoGlavne) Then
                        ReDim Preserve pompo(1 + pompo.GetUpperBound(0))
                        pompo(pompo.GetUpperBound(0)) = r.RbrGreske.Trim.ToUpper
                    End If
                End If
            End If
        Next
        Return pompo
    End Function
