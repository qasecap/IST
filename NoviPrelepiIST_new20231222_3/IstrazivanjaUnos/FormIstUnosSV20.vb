    Function prviLBLNaCATIPanelu(p As Panel) As Label
        Dim mt As Long = 100000000000000
        Dim lbl As Label = Nothing
        For Each k As Control In p.Controls
            If TypeOf k Is Label AndAlso k.TabIndex < mt Then
                mt = k.TabIndex
                lbl = k
            End If
        Next
        Return lbl
    End Function

    Function sklopiCheckBox(ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal grupachbox As String, ByVal polje As String, ByRef inizCHB As Integer,
    ByVal ZadnjiTabIndex As Integer,
    ByVal ro As Boolean, ByVal nonvisible As Boolean,
    ByVal Optional prvoNaFormi As Boolean = False) As CheckBox
        Dim chbBox As New CheckBox
        chbBox.Tag = grupachbox.Trim.ToUpper
        chbBox.Name = "HH" & polje.Trim.ToUpper
        If prvoNaFormi = True Then chbBox.AccessibleName = chbBox.AccessibleName + "firstCH;"

        If grupachbox <> "" Then
            Dim imaGa As Boolean = False
            For k As Integer = 0 To inizCHB
                If Not nizCHB(k) Is Nothing AndAlso nizCHB(k).Trim.ToUpper.IndexOf(grupachbox) = 0 Then   'imaga
                    nizCHB(k) = nizCHB(k).Trim.ToUpper + "$" + polje.Trim.ToUpper
                    imaGa = True
                    Exit For
                End If
            Next
            If imaGa = False Then
                nizCHB(inizCHB) = chbBox.Tag + ":" + polje.Trim.ToUpper
                inizCHB = inizCHB + 1
                ReDim Preserve nizCHB(inizCHB)
            End If
        End If

        chbBox.TabIndex = ZadnjiTabIndex
        chbBox.TabStop = True
        chbBox.Text = ""
        chbBox.Height = 20
        chbBox.Width = 20
        chbBox.FlatStyle = FlatStyle.Flat
        'CHtrt.RightToLeft = RightToLeft.Yes
        AddHandler chbBox.Enter, AddressOf Me.hh_Enter
        AddHandler chbBox.KeyPress, AddressOf Me.hh_KeyPress
        AddHandler chbBox.PreviewKeyDown, AddressOf Me.hh_PreviewKeyDown
        AddHandler chbBox.KeyDown, AddressOf Me.hh_KeyDown
        AddHandler chbBox.Click, AddressOf Me.hh_Click
        AddHandler chbBox.Validating, AddressOf Me.hh_validating
        AddHandler chbBox.GotFocus, AddressOf Me.hh_GotFocus
        AddHandler chbBox.LostFocus, AddressOf Me.hh_LostFocus
        AddHandler chbBox.MouseMove, AddressOf Me.hh_MouseMove


        If (p.IsODNull = False AndAlso p.OD.Trim.ToUpper.IndexOf("NOTABSTOP") > -1) OrElse (p.IsIzrazNull = False AndAlso p.Izraz.Trim.ToUpper.IndexOf("NOTABSTOP") > -1) Then
            chbBox.TabStop = False
        Else
            chbBox.TabStop = True
        End If

        If ro = True Then chbBox.Enabled = False
        If nonvisible = True Then chbBox.Visible = False

        sklopiCheckBox = chbBox

        If previewEditMode = True Then
            chbBox.ContextMenuStrip = mnu02
            'AddHandler tbox.MouseDoubleClick, AddressOf Me.pp_MouseDoubleClick
            Dim pomforma As String = ""
            If p.IsFormaNull = False Then pomforma = p.Forma.Trim
            chbBox.AccessibleDefaultActionDescription = GlavnaTabela + ";" + p.Vod.ToString("yyyy/MM/dd").Trim + ";" + chbBox.Name.Substring(2) + ";" + pomforma + ";" + CStr(p.rbr).Trim
        End If

    End Function

