    Private Sub pozicionirajMeGdeSamBioDGV(ByVal kljucevi As String(,), ByVal dgv As DataGridView)

        Dim kojiRed As Integer = 0
        Dim kojaKolona As Integer = 0

        Dim dt As New DataTable
        dt = DirectCast(dgv.DataSource, System.Data.DataView).ToTable.Copy
        Dim n As Integer = kljucevi.Length \ 2

        Dim ime As String = ""
        Dim vrednost As String = ""
        Dim nadjen As Integer = -1
        For r As Integer = 0 To dt.Rows.Count - 1
            For i As Integer = 0 To n - 1
                ime = kljucevi(i, 0)
                vrednost = kljucevi(i, 1)
                If dt.Rows(r).Item(ime) <> vrednost Then
                    Exit For
                End If
                If i = n - 1 Then
                    nadjen = r
                    Exit For
                End If
            Next
            If nadjen > -1 Then
                For j As Integer = 0 To dgv.Columns.Count - 1
                    If dgv.Rows(nadjen).Cells(j).Visible = True Then
                        dgv.CurrentCell = dgv.Rows(nadjen).Cells(j)
                        Exit For
                    End If
                Next
                Exit For
            End If
        Next
    End Sub

