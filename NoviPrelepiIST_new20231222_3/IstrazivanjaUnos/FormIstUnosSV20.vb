    Private Function PrevediS(ByVal kv As String(), Optional ByVal tabela As String = "") As String
        Dim odakle, dokle, pocS, krS As Integer
        Dim TF As Boolean = False
        Dim Fja As Boolean = False
        Dim zaRad() As String = {}
        Dim ostatak() As String = {}
        Dim xpom As String = ""
        Dim prthNar As String = ""
        Dim p() As String
        For i As Integer = 0 To kv.GetUpperBound(0)
            ReDim Preserve p(i)
            p(i) = kv(i).Trim.ToUpper
        Next
        If p Is Nothing OrElse p.Length = 0 Then pocS = -1 Else pocS = Array.IndexOf(p, "SELECT")
        If pocS = -1 Then
            Return ustringaj(kv)
        Else
            If pocS = 0 AndAlso Not Fja Then
                Return DajRezS(kv, TF)
            Else
                If Not Fja Then 'SELECT
                    If pocS > 0 And kv(pocS - 1) = "(" Then
                        odakle = pocS - 1
                        If pocS > 1 Then
                            prthNar = kv(pocS - 2)
                            If prthNar.Trim.ToUpper = "EXISTS" Then
                                TF = True
                                odakle = pocS - 2
                            End If
                        End If
                    End If
                End If
                Dim brz As Integer = 1 'br (otvorenih) zagrada
                For i As Integer = IIf(Fja, odakle + 1, pocS) To kv.GetUpperBound(0)
                    If kv(i) = "(" Then brz += 1
                    If kv(i) = ")" Then brz -= 1
                    If brz = 0 Then
                        krS = i - 1 : dokle = i + 1
                        Exit For
                    End If
                Next
                If brz <> 0 Then
                    Return "!ERROR!"
                Else
                    If Fja Then
                        odakle = odakle - 1
                        'krS = krS + 1
                        'dokle = dokle + 1
                        ReDim zaRad(krS - pocS + 1) : ReDim ostatak(kv.GetUpperBound(0) - dokle)
                        For i As Integer = pocS To krS + 1
                            zaRad(i - pocS) = kv(i)
                        Next
                        For i As Integer = dokle To kv.GetUpperBound(0)
                            ostatak(i - dokle) = kv(i)
                        Next
                    Else
                        ReDim zaRad(krS - pocS) : ReDim ostatak(kv.GetUpperBound(0) - dokle)
                        For i As Integer = pocS To krS
                            zaRad(i - pocS) = kv(i)
                        Next
                        For i As Integer = dokle To kv.GetUpperBound(0)
                            ostatak(i - dokle) = kv(i)
                        Next
                    End If
                    Return (ustringaj(kv, 0, odakle - 1) & " " & DajRezS(zaRad, TF, prthNar, tabela) & " " & PrevediS(ostatak)).Trim
                End If
            End If
        End If
        Return xpom.Trim
    End Function
    Private Function DajRezS(ByVal n As String(), Optional ByVal SamoTF As Boolean = False, Optional ByVal SuCimUsao As String = "", Optional ByVal tabela As String = "", Optional ByVal k As Control = Nothing) As String
        Dim GlavnaTabela As String = ""
        Dim xpom As String = ""
        Dim p() As String
        For i As Integer = 0 To n.GetUpperBound(0)
            ReDim Preserve p(i)
            p(i) = n(i).Trim.ToUpper
        Next
        Dim partbl As String = n(Array.IndexOf(p, "FROM") + 1).Trim.ToUpper
        Dim izraz As String = ustringaj(n)
        Dim kv() As String = razkvantaj(izraz, True)
        izraz = ""
        If tabela <> "" Then GlavnaTabela = tabela Else GlavnaTabela = Me.GlavnaTabela
        For i As Integer = 0 To kv.GetUpperBound(0)
            If InStr(kv(i), GlavnaTabela.Trim.ToUpper & ".") <> 0 Then
                If kv(i).Substring(kv(i).Length - 1, 1) = "," Then kv(i) = kv(i).Substring(0, kv(i).Length - 1)
                izraz = izraz & " " & IzDGTzaSQL(Mid(kv(i), InStr(kv(i), ".") + 1), , , tabela)
            Else
                izraz = izraz & " " & kv(i)
            End If
        Next

        If Otvorena(partbl) AndAlso BasTajKljuc(izraz) Then
            Dim dd As DataTable
            If Me.NslKljuc Is Nothing Then
                dd = DGTabele(DGi(partbl))
            Else
                dd = DTbl(DGi(partbl, DTbl))
            End If

            Dim izrazW As String = Mid(izraz.Trim, InStr(izraz.Trim.ToUpper, "WHERE") + 5)
            Dim kkv() As String = razkvantaj(izrazW)
            izrazW = ""
            For i As Integer = 0 To kkv.GetUpperBound(0)
                If InStr(kkv(i).Trim, ".") <> 0 Then
                    izrazW = izrazW & " " & Mid(kkv(i).Trim, InStr(kkv(i).Trim, ".") + 1).Trim
                Else
                    izrazW = izrazW & " " & kkv(i).Trim
                End If
            Next
            kkv = Nothing
            Dim r() As DataRow = dd.Select(izrazW.Trim.ToUpper)
            If SamoTF Then
                If r.Length > 0 Then
                    Return " 2=2 "
                Else
                    Return " 2=3 "
                End If
            Else
                Dim pp() As String
                For i As Integer = 0 To kv.GetUpperBound(0)
                    ReDim Preserve pp(i)
                    pp(i) = kv(i).Trim.ToUpper
                Next
                Dim ppz As Integer = -1
                If pp Is Nothing OrElse pp.Length = 0 Then ppz = -1 Else ppz = Array.IndexOf(pp, "SELECT") + 1
                If kv(ppz + 1) = "(" Then
                    Dim brz As Integer = 1 : Dim krz As Integer = 0
                    For i As Integer = ppz + 2 To kv.GetUpperBound(0)
                        If kv(i) = "(" Then brz += 1
                        If kv(i) = ")" Then brz -= 1
                        If brz = 0 Then
                            krz = i
                            Exit For
                        End If
                    Next
                    Dim izrC As String = ustringaj(kv, ppz, krz)
                    If InStr(izrC.Trim.ToUpper, "COUNT") <> 0 Then
                        Return r.Length
                    ElseIf InStr(izrC.Trim.ToUpper, "ISNULL") <> 0 Then
                        If (krz - 1) - (ppz + 2) > 1 Then
                            Dim pizrC As String = ustringaj(kv, ppz + 2, krz - 1)
                            Dim nulltrt As String() = pizrC.Split(",")
                            Dim deoL As String = nulltrt(0)
                            Dim deoR As String = nulltrt(1)
                            Return IzDGTzaSQL(deoL.Trim.ToUpper, dd, , tabela)
                        Else
                            Return NZ(dd.Compute(izrC, izrazW))
                        End If
                    Else
                        If (krz - 1) - (ppz + 2) > 1 Then
                            Dim pizrC As String = ustringaj(kv, ppz + 2, krz - 1)
                            Dim pomkol As New DataColumn("pomKol")
                            pomkol.Expression = pizrC.Replace("N'", "'")
                            dd.Columns.Add(pomkol)
                            Dim pIzrC2 As String = kv(ppz).Trim & "(pomKol)"
                            Dim xxx As Object = NZ(dd.Compute(pIzrC2.Trim.ToUpper, izrazW.Trim.ToUpper))
                            dd.Columns.Remove(pomkol)
                            Return xxx
                        Else
                            Return NZ(dd.Compute(izrC.Trim.ToUpper, izrazW.Trim.ToUpper))
                        End If
                    End If
                Else 'dakle, samo polje
                    Return IzDGTzaSQL(kv(ppz).Trim.ToUpper, dd, , tabela)
                End If
            End If
        Else 'ide pravi upit

            izraz = NZ(Replace(izraz, "cast ( '' as decimal", "cast ( '0' as decimal", 1, , CompareMethod.Text)).Trim
            izraz = NZ(Replace(izraz, "cast ( '' as numeric", "cast ( '0' as numeric", 1, , CompareMethod.Text)).Trim

            Dim dt As DataTable = izvrsiSQLvratiDT(izraz, Me.DBConnectionString, Me.jezik)
            If SamoTF Then
                '20230421 Nevena
                If dt.Rows.Count > 0 Then
                    Return " 2=2 "
                Else
                    Return " 2=3 "
                End If
            Else
                If SuCimUsao.Trim.ToUpper = "IN" Then
                    Dim r As String = ""
                    For i As Integer = 0 To dt.Rows.Count - 1
                        If r.Length > 0 Then r = r + ","
                        r = r + IzDGTzaSQL(0, dt, i, tabela)
                    Next
                    If r <> "" Then
                        Return " (" & r & ") "
                    Else
                        Return " ('-9999999') "
                    End If
                Else
                    Return IzDGTzaSQL(0, dt, , tabela)
                End If
            End If
        End If
        Return xpom
    End Function
