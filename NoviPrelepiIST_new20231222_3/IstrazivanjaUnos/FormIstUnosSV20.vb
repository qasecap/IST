        For i As Integer = grupeCNTLBlokoviPanel(ipanel)(b).GetUpperBound(0) To 0 Step -1
            Dim k As Control = grupeCNTLBlokoviPanel(ipanel)(b)(i)
            'nepotrebnavalidacijaPanel = True
            k.Visible = False
        Next
