    Sub subOnReturnAssign()
        'DODELA******************************************************************************
        'ovo je vec bilo na kraju, ne treba da prodje kroz LK jer je finta da se to sto
        'je dodeljno i potvrdi sa enterom
        'dodela
        If SCati = False Then
            If nizOnreturndodeliKome.Length > 0 AndAlso nizOnreturndodeliSta.Length > 0 Then
                Dim ub As Integer = nizOnreturndodeliKome.Length - 1
                If nizOnreturndodeliKome.Length <> nizOnreturndodeliSta.Length Then
                    ISTMessageBox.Show("ASSIGN TO length is different from ASSIGN WHAT length" + nvrd + nvrd + Str(nizOnreturndodeliKome.Length).Trim + ":   " + OnreturndodeliKome.Replace("$", " | ") + nvrd + nvrd +
                                            Str(nizOnreturndodeliSta.Length).Trim + ":   " + OnreturndodeliSta.Replace("$", " | "), "ERROR IN METADATA", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    If nizOnreturndodeliKome.Length > nizOnreturndodeliSta.Length Then ub = nizOnreturndodeliSta.Length - 1
                    If nizOnreturndodeliSta.Length > nizOnreturndodeliKome.Length Then ub = nizOnreturndodeliKome.Length - 1
                End If

                If nizOnreturndodeliAko.Length < ub Then
                    For i As Integer = nizOnreturndodeliAko.Length To ub
                        ReDim Preserve nizOnreturndodeliAko(i)
                        nizOnreturndodeliAko(i) = "2=2"
                    Next
                End If

                Dim ooo As Boolean = okvalidacija

                For sss As Integer = 0 To ub
                    Try
                        Call ddodela(GlavnaTabela, "BTNSAVENEXT", Nothing, nizOnreturndodeliAko(sss), nizOnreturndodeliKome(sss), nizOnreturndodeliSta(sss))
                    Catch ex As Exception
                        ''msg 21
                        Dim msgtxt21 As String = getMessageText(dtMessages, "21", Me.jezik)
                        ISTMessageBox.Show(ex.Message, msgtxt21 + ": ddodela1 pp_validating", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    Finally
                    End Try
                Next

                okvalidacija = ooo

            End If ' If dodeliKome.Length <> 0 AndAlso dodeliSta.Length <> 0 AndAlso tbox.Text.Trim.Length > 0 Then
        End If
    End Sub
