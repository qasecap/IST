        'ako je dgtabele null, a u tpolju ima nešto upiši u dgtabele
        'slućaj postoji samo ako je imao dodelu iz adresara a nije prošao kroz polja da potvrdi
        'DGTabele(DGi(GlavnaTabela.Trim))
        For Each kol As DataColumn In DGTabele(DGi(GlavnaTabela)).Columns
            Dim ime As String = kol.Caption.Trim.ToUpper
            If DGTabele(DGi(GlavnaTabela)).Rows.Count > 0 Then
                Dim vred As String = DGTabele(DGi(GlavnaTabela)).Rows(0).Item(ime).ToString
                If (vred Is DBNull.Value OrElse vred.Trim.Length = 0) Then
                    For i As Integer = 0 To grupePitanjaCATI.GetUpperBound(0)
