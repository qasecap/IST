    Private Sub DGDupliKlikPanel(ByVal sender As Object, ByVal e As System.EventArgs)
        bbss = Nothing
        bbiloskakanje = False
        'DGDupliKlikPanel DG KOJI JE OD PANELA
        'DGDupliKlik JE ZA NORMALNO (NEPANEL) PODTABELE
        izgridapanel = True
        pitajPanel = True
        Dim tabela As String = CType(sender, DataGridView).Name.Trim.ToUpper
        Dim imepanel As String = "PANE_" + tabela
        Dim panel As Panel = NadjiKontrolu(Panel1, imepanel)

        nepotrebnavalidacijaPanel = True
        Dim ipanel As Integer = Array.IndexOf(grupeCNTLPanel, panel)
        If grupeCNTLBlokoviPanel.Length > 0 AndAlso Not grupeCNTLBlokoviPanel(ipanel) Is Nothing Then
            Call ifBlokVisibleFirstPanel(ipanel)
        End If
        nepotrebnavalidacijaPanel = False

        'malo da vrati gore
        Panel1.AutoScrollPosition = New Point(0, Panel1.VerticalScroll.Maximum \ 25)

        Dim pane11 As Boolean = False
        If Not panel.AccessibleName Is Nothing AndAlso panel.AccessibleName.IndexOf("1-1") >= 0 Then pane11 = True

        Call resetPanel(panel)

        Dim KljuceviSaEkranaSaVrednostima(,) As String
        'ovde bi trebalo iz grida procitati koji je slog (tj. koji je kljuc) u pitanju....
        Dim Kljucevi() As String = DajKljuceve(tabela)
        Dim ppKLJ As String = Kljucevi(Kljucevi.GetUpperBound(0)).ToString.Trim.ToUpper
        Dim dgr As DataGridView = CType(sender, DataGridView)
        ReDim KljuceviSaEkranaSaVrednostima(Kljucevi.GetUpperBound(0), 1)

        Dim vju As Boolean = False
        For Each t As DatasetIstrazivanja.ISTTABELERow In Me.dIst.ISTTABELE.Rows
            If (Not t.IsT2Null) AndAlso t.Tabela.Trim.ToUpper = tabela Then
                If t.T2.Trim.ToUpper.IndexOf("VIEW") > -1 Then
                    vju = True
                    Exit For
                End If
            End If
        Next
        If dgr.CurrentRow.Index > -1 Then
            If pane11 Then
                Call IsprazniKontrolePanel(panel, 1)
            Else
                Call IsprazniKontrolePanel(panel, 0)
            End If

            For i As Integer = 0 To Kljucevi.GetUpperBound(0)
                KljuceviSaEkranaSaVrednostima(i, 0) = Kljucevi(i).Trim.ToUpper
                KljuceviSaEkranaSaVrednostima(i, 1) = dgr.Rows(dgr.CurrentRow.Index).Cells(CType(dgr.DataSource, DataTable).Columns.IndexOf(Kljucevi(i).Trim.ToUpper)).Value.ToString
            Next
            For j As Integer = 0 To KljuceviSaEkranaSaVrednostima.GetUpperBound(0)   'GlavniKljuc
                Dim c As Control = NadjiKontroluSkr(panel, KljuceviSaEkranaSaVrednostima(j, 0).Trim, 3)
                If TypeOf c Is TextBox Then CType(c, TextBox).Text = KljuceviSaEkranaSaVrednostima(j, 1).Trim
                If TypeOf c Is ComboBox Then
                    ' popuni sve comboboxeve koji su u kljucu ako su prazni
                    If CType(c, ComboBox).DataSource.rows.count = 1 AndAlso CType(c, ComboBox).DataSource.rows(0).item(0) = "" AndAlso CType(c, ComboBox).DataSource.rows(0).item(1) = "" Then
                        dcbpp_popuni(CType(c, ComboBox), panel, True)
                    End If
                    CType(c, ComboBox).SelectedValue = KljuceviSaEkranaSaVrednostima(j, 1).Trim
                End If
                If TypeOf c Is DateTimePicker2 Then CType(c, DateTimePicker2).Value = KljuceviSaEkranaSaVrednostima(j, 1).Trim
                'focus na prvi
            Next

            If pane11 = False Then KljucNFocusPanel(panel, ppKLJ)
            pitajPanel = False

            Try
                'If ELGaImaPanel(tabela, panel, pitajPanel) Then
                'End If

                If ELGaImaPanel(tabela, panel, pitajPanel) Then 'ELGaIma vraca true ako ga NEMA i ako hoce IZMENU postojeceg, a false SAMO ako nece izmenu
                    Me.sacuvanoP = True
                    Me.menjanoP = False
                Else
                    KljucNFocusPanel(panel, ppKLJ)
                    okvalidacija = False
                    Me.Cursor = Cursors.Default
                    Exit Sub
                End If
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message)
            End Try

            Polje1FocusPanel(panel)

            If bbiloskakanje = True AndAlso Not bbss Is Nothing Then
                nepotrebnavalidacijaPanel = True
                Dim b As Integer = blok(ipanel, bbss)
                Call nevidljivBlokPanelSviSem(ipanel, b)
                Call vidljivBlokPanelBasOvaj(ipanel, b)
                bbss.Focus()
                nepotrebnavalidacijaPanel = False
                'Else
                '    Polje1FocusPanel(panel)
            End If


            'BEZ OVOG DOLE NE VIDI NISTA STO JE D.
            PreracunajFPPanel(tabela, panel, "FPnPK")
            PreracunajFPPanel(tabela, panel, "FPMEM")

            Me.PrikaziLKPanel(tabela, panel)

        End If

    End Sub

