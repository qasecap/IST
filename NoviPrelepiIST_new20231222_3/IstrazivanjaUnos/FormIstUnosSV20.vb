    'ef je enabledfalse
    Function ef(ByVal a As Integer, ByVal k As Control, ByVal bvalue As Boolean, ByVal tnizcc As String) As Integer
        ef = 0
        If Mid(k.Name, 1, 1) = "B" Then
            If Mid(k.Name, 1).Trim.ToUpper = tnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, Button).Enabled = bvalue
                    k.AccessibleName = k.AccessibleName + "BTNV" + CStr(Not bvalue).Trim.ToUpper + ";"
                    Dim kb As Button = NadjiKontroluSkrKojaJeBUTTONPLUS(Panel1, tnizcc.Trim.ToUpper.Replace("BTN", ""))
                    If Not kb Is Nothing Then
                        If Not CType(k, Button).AccessibleDescription Is Nothing AndAlso CType(k, Button).AccessibleDescription.Trim.ToUpper.IndexOf("NOPLUS") Then
                            kb.Enabled = False
                        Else
                            kb.Enabled = bvalue

                        End If

                    End If
                    ef = 1
                Else          'ako je NIJE ispunjen USLOV

                    CType(k, Button).Enabled = Not bvalue
                    If Not k.AccessibleName Is Nothing Then k.AccessibleName = k.AccessibleName.Replace("BTNV" + CStr(bvalue).Trim.ToUpper + ";", "")
                    Dim kb As Button = NadjiKontroluSkrKojaJeBUTTONPLUS(Panel1, tnizcc.Trim.ToUpper.Replace("BTN", ""))
                    If Not kb Is Nothing Then
                        If Not CType(k, Button).AccessibleDescription Is Nothing AndAlso CType(k, Button).AccessibleDescription.Trim.ToUpper.IndexOf("NOPLUS") Then
                            kb.Enabled = False
                        Else
                            kb.Enabled = Not bvalue

                        End If
                    End If
                End If
            End If
        End If
        If Mid(k.Name, 1, 1) = "T" OrElse Mid(k.Name, 1, 2) = "FP" Then
            If Mid(k.Name, 3).Trim.ToUpper = tnizcc.Trim.ToUpper Then
                Dim tb As TextBox = CType(k, TextBox)
                If a = 1 Then 'samo ako je ispunjen USLOV
                    tb.Enabled = bvalue
                    ef = 1
                Else          'ako je NIJE ispunjen USLOV
                    tb.Enabled = Not bvalue
                End If

                'NE TREBA
                'If bvalue = False Then tb.AccessibleName = tb.AccessibleName + "VF;"
                'If bvalue = True AndAlso Not tb.AccessibleName Is Nothing AndAlso tb.AccessibleName <> "" Then tb.AccessibleName = tb.AccessibleName.Replace("VF;", "")
            End If
        End If
        If Mid(k.Name, 1, 1) = "C" Then
            If Mid(k.Name, 3).Trim.ToUpper = tnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, ComboBox).Enabled = bvalue
                    ef = 1
                Else          'ako je NIJE ispunjen USLOV
                    CType(k, ComboBox).Enabled = Not bvalue
                End If
            End If
        End If
        If Mid(k.Name, 1, 2) = "RG" Then
            If Mid(k.Name, 3).Trim.ToUpper = tnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, Panel).Enabled = bvalue
                    ef = 1
                Else          'ako je NIJE ispunjen USLOV
                    CType(k, Panel).Enabled = Not bvalue
                End If
            End If
        End If
        If Mid(k.Name, 1, 2) = "HH" Then
            If Mid(k.Name, 3).Trim.ToUpper = tnizcc.Trim.ToUpper Then
                If a = 1 Then 'samo ako je ispunjen USLOV
                    CType(k, CheckBox).Enabled = bvalue
                    ef = 1
                Else          'ako je NIJE ispunjen USLOV
                    CType(k, CheckBox).Enabled = Not bvalue
                End If
            End If
        End If

        If TypeOf k Is DataGridView2 AndAlso k.Name.Trim.ToUpper = tnizcc.Trim.ToUpper Then
