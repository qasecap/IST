        cinfo.NumberFormat.CurrencyDecimalSeparator = "."
        cinfo.DateTimeFormat.ShortDatePattern = "yyyy-MM-dd HH:mm:ss"
        cinfo.DateTimeFormat.LongDatePattern = "yyyy-MM-dd HH:mm:ss"
        cinfo.DateTimeFormat.LongTimePattern = "HH:mm:ss"
