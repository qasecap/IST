    Function addFNQG(ByVal tabela As String) As String
        addFNQG = "ok"
        'prvo posle kljuca mora da se doda fp sa newqg ako ne postoji
        Dim str As String = "select max(rbr) as rbr from istpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and isnull(kljuc,'')='P'"
        Dim rbr1PK As String = getrbr(str).Trim

        str = "select min(rbr) as rbr from istpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and isnull(kljuc,'')<>'P'"
        Dim rbr2PK As String = getrbr(str).Trim

        Dim strI As String = "select isnull(newquestiongroup,'') as newquestiongroup from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela +
                             "' and cast(rbr as int)=" + rbr2PK.Trim + ""

        Dim dt As DataTable = izvrsiSQLvratiDT(strI, Me.ISTConnectionString, Me.jezik)

        If dt.Rows.Count > 0 AndAlso dt.Rows(0).Item(0).ToString.Trim = "" Then   'prvi posle kljuca nije  newquestiongroup, dodaj firstQuestionGroupFP
            'nije qg dodaj
            strI = "update istpolja set rbr=rbr+10 where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and cast(rbr as int)>" + rbr1PK.Trim + ";" + nvrd
            Dim ppolje As String = dajUniqueImeIST(tabela, "fpNQG_", "")
            strI = strI + " insert into istpolja (sifist,tabela,polje,rbr,vod,vdo,od,izraz,opis,vs)" + nvrd +
                          " values ('" + sifist + "','" + tabela + "','" + ppolje + "'," + CStr(CInt(rbr1PK) + 10).Trim + ",'2010/1/1','2099/1/1','newquestiongroup','''firstQuestionGroupFP''','$','1')"
            Dim p2 As String = napraviBackUpizvrsiSQL(strI)
            If p2 = "nok" Then addFNQG = "nok" Else addFNQG = "okD"
        End If
    End Function

    Function addNQG(ByVal tabela As String, ByVal rbrMaxPreCurrent As String, ByVal rbrCurrent As String, ByVal ttab As String, ByVal currentTab As Integer, ByVal currentRed As Integer) As String

        'rbr2 rbr na kome sam ili min rbr od reda tabele na kojoj sam
        'rbr1 max rbr pre rbr2

        addNQG = "ok"
        Dim strI As String = "update istpolja set rbr=rbr+10 where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and cast(rbr as int)>" + rbrMaxPreCurrent.Trim + ";" + nvrd
        Dim ppolje As String = dajUniqueImeIST(tabela, "fpNQG_", "")

        rbrCurrent = CStr(CInt(rbrCurrent.Trim) + 10).Trim

        strI = strI + " insert into istpolja (sifist,tabela,polje,rbr,vod,vdo,od,izraz,opis,vs) values ('" +
               sifist + "','" + tabela + "','" + ppolje + "'," + CStr(CInt(rbrMaxPreCurrent) + 10).Trim + ",'2010/1/1','2099/1/1','newquestiongroup','''''','$','1');" + nvrd

        Dim strP As String = ""

        If ttab = True Then
            Dim s As String = "select min(f2) as f2 from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and  f1=" + CStr(currentTab).Trim + ""
            Dim dt0 As DataTable = izvrsiSQLvratiDT(s, Me.ISTConnectionString, Me.jezik)
            If Not dt0 Is Nothing AndAlso dt0.Rows.Count = 1 AndAlso currentRed > CInt(dt0.Rows(0).Item("f2").ToString.Trim) Then
                s = "select isnull(min(rbr),-5) as rbr from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and cast(rbr as int)>" + rbrCurrent.Trim + " and isnull(newquestiongroup,'')<>'';" + nvrd
                Dim dt As DataTable = izvrsiSQLvratiDT(s, Me.ISTConnectionString, Me.jezik)
                Dim rbrNQG As Integer = -5
                If Not dt Is Nothing AndAlso dt.Rows.Count = 1 Then rbrNQG = CInt(dt.Rows(0).Item("rbr").ToString.Trim)
                Dim m As String = -5
                If rbrNQG > -5 Then  'postoji grupa iza
                    m = maxRBRbeforeRBR(tabela, rbrNQG) + 10
                Else
                    m = maxRBRTabela(tabela, currentTab) + 10
                End If

                'sve izmedju  rbrCurrent i m : resetuje se  f2 da ide od 1
                Dim kR As Integer = currentRed - 1
                Dim pU As String = " update a set a.forma=rtrim(ltrim(cast(f1+1 as char)))+'.'+rtrim(ltrim(cast(f2-" + CStr(kR).Trim + " as char)))+'.'+rtrim(ltrim(cast(f3 as char))) " + nvrd
                Dim pJ As String = " from istpolja a inner Join vrepISTPolja b on a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje and a.vod=b.vod" + nvrd
                Dim pW As String = " where a.sifist=N'" + sifist + "' and a.tabela=N'" + tabela + "'  and f1='" + CStr(currentTab).Trim + "'  and cast(a.rbr as int)>=" + rbrCurrent.Trim +
                                   " and cast(a.rbr as int)<=" + CStr(m).Trim + ";" + nvrd

                Dim pU1 As String = " update a set a.forma=rtrim(ltrim(cast(f1+1 as char)))+'.'+rtrim(ltrim(cast(f2 as char)))+'.'+rtrim(ltrim(cast(f3 as char))) " + nvrd
                Dim pJ1 As String = " from istpolja a inner Join vrepISTPolja b on a.sifist=b.sifist and a.tabela=b.tabela and a.polje=b.polje and a.vod=b.vod" + nvrd
                Dim pW1 As String = " where a.sifist=N'" + sifist + "' and a.tabela=N'" + tabela + "'" +
                               " and cast(a.rbr as int)>" + CStr(m).Trim + ";" + nvrd
                strP = pU + pJ + pW + pU1 + pJ1 + pW1
            Else
                'red je min red u tabeli, celu tabelu i sve posle nje stavi u novu grupu
            End If

            Dim p2 As String = napraviBackUpizvrsiSQL(strI + nvrd + strP)
            If p2 = "nok" Then addNQG = "nok" Else addNQG = "ok"

        End If

    End Function

    Sub nqg(ByVal what As String)
        'mnu02.Tag = GlavnaTabela + ";" + tValidFrom + ";" + tbox.Name.Substring(2) + ";" + Str(Forma).Trim + ";" + Str(p.rbr).Trim
        Dim pp() As String = mnu02.Tag.split(";")
        Dim p2 As String = "ok"
        Dim rbrMaxPreCurrent As String = ""
        Dim rbrCurrent As String = pp(4).Trim
        Dim kk As String = addFNQG(pp(0).Trim)

        If kk = "nok" Then
            p2 = "nok"
        Else
            If kk = "okD" Then rbrCurrent = getCurrentRBR(pp(0).Trim, pp(2).Trim, pp(1).Trim)
            Dim ttab As Boolean = False
            Dim trk() As String = pp(3).Split(".")
            Dim currenttab As Integer = 0
            Dim currentred As Integer = 0
            If trk.Length = 3 Then
                ttab = True
                currenttab = CInt(trk(0).Trim)
                currentred = CInt(trk(1).Trim)
                rbrCurrent = minRBRTabelaRed(pp(0).Trim, currenttab, currentred)
            End If

            rbrMaxPreCurrent = maxRBRbeforeRBR(pp(0).Trim, rbrCurrent)

            If what = "add" AndAlso addNQG(pp(0).Trim, rbrMaxPreCurrent, rbrCurrent, ttab, currenttab, currentred) <> "nok" Then
                'sve ok
            ElseIf what = "remove" AndAlso removeNQG(pp(0).Trim, rbrMaxPreCurrent, rbrCurrent) <> "nok" Then
                'sve ok
            Else
                p2 = "nok"
            End If
        End If
        If p2 = "nok" Then ISTMessageBox.Show("Error!") Else Call subREFRESH("C")
    End Sub

    Function removeNQG(ByVal tabela As String, ByVal rbr1 As String, ByVal rbr2 As String) As String
        removeNQG = "ok"
        Dim strI As String = "select isnull(newquestiongroup,'') as newquestiongroup,isnull(izraz,'') as izraz from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela +
                             "' and cast(rbr as int)=" + rbr1.Trim + ""
        Dim dt As DataTable = izvrsiSQLvratiDT(strI, Me.ISTConnectionString, Me.jezik)

        If dt.Rows.Count > 0 AndAlso dt.Rows(0).Item("newquestiongroup").ToString.Trim <> "" AndAlso dt.Rows(0).Item("izraz").ToString.Trim <> "'firstQuestionGroupFP'" Then
            'jest qg remove
            strI = "delete from istpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and cast(rbr as int)=" + rbr1.Trim + ";" + nvrd
            strI = strI + "update istpolja set rbr=rbr-10 where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and cast(rbr as int)>=" + rbr2.Trim + ";" + nvrd

            Dim p2 As String = napraviBackUpizvrsiSQL(strI)
            If p2 = "nok" Then removeNQG = "nok"
        End If
        If removeNQG = "ok" Then
            'koliko ih je ostalo, ako je samo jedan i to na prvom skidaj ga  (prvi inace nikad ne sn+me sam da se skida)
            Dim str As String = "select count (*) from vrepistpolja where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and isnull(newquestiongroup,'')<>''"
            Dim dt2 As DataTable = izvrsiSQLvratiDT(str, Me.ISTConnectionString, Me.jezik)
            If dt2.Rows.Count > 0 AndAlso dt2.Rows.Count = 1 Then   'ostao samo jedan, skidaj ga
                strI = " delete from istpolja  where sifist=N'" + sifist + "' and tabela=N'" + tabela + "' and izraz like '%firstQuestionGroupFP%';"
                Dim p2 As String = napraviBackUpizvrsiSQL(strI)
                If p2 = "nok" Then removeNQG = "nok"
            End If
        End If

    End Function

