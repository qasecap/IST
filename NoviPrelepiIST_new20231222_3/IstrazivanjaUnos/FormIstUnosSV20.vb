    Function sstopif(ByVal GlavnaTabela As String, ByVal plj As String, ByVal cntl As Control, ByVal stopif As String, ByVal stopmsg As String,
                     ByVal stopmsgOnPnl As Boolean, ByVal stopMsgFocusON As String) As Boolean
        sstopif = False
        Dim tabela As String = GlavnaTabela
        Dim pomKol4 As New DataColumn("pomKol4")
        Dim sss() As String = stopif.Split("$")
        Dim mmm() As String = stopmsg.Split("$")

        Dim imaF As Boolean = False
        Dim nnn() As String = {}
        If stopMsgFocusON = "" And Not TypeOf cntl Is Button Then
            stopMsgFocusON = plj
            imaF = False
        Else
            nnn = stopMsgFocusON.Split("$")
            imaF = True
        End If

        For i As Integer = 0 To sss.GetUpperBound(0)
            sss(i) = ZameniGGGMMMUnos(sss(i))
            Dim zzz As String = sracunajIzraz(sss(i), plj, cntl)
            If Not cntl Is Nothing Then zzz = ZameniFDAYMONTHYEAR(zzz, cntl.Text.Trim.Replace("'", ""))
            If zzz.Trim.ToUpper.IndexOf(" BETWEEN ") > 0 Then zzz = zameniBETWEEN(zzz)
            zzz = PrevediF(zzz).Trim.ToUpper
            Try
                Dim a As Integer = scompute(zzz, plj, "stopif")       '1 TRUE, 0 FALSE
                If a = 1 Then 'samo ako je ispunjen USLOV
                    'stopiranje
                    sstopif = True
                    mmm(i) = mmm(i).Replace(vbTab, " ").Replace(vbCr, " ").Replace(vbCrLf, " ").Replace(vbLf, " ")
                    If mmm.GetUpperBound(0) >= i AndAlso mmm(i).Trim.Length > 0 Then
                        mmm(i) = sklopiPoruka(mmm(i))
                        If stopmsgOnPnl = True Then
                            Call zatvoriOLHC()
                            PnlMsg.Visible = True
                            PnlMsg.BringToFront()
                            ISTNote.BringToFront()
                            ISTNote.Visible = False
                            PnlMsgB.Focus()
                            If imaF Then PnlMsg.Tag = nnn(i) Else PnlMsg.Tag = stopMsgFocusON
                            PnlMsgT.Text = breakPoruke(mmm(i))
                        Else
                            MsgBox(breakPoruke(mmm(i)), vbCritical, "STOP MESSAGE")
                        End If
                    End If
                    Exit Function
                Else
                    PnlMsgT.Text = ""
                    PnlMsg.Visible = False
                End If
            Catch ex As Exception
                ISTMessageBox.Show(ex.Message + nvrd + nvrd + "Check syntax for STOPIF, there is possibility that you have ( or ) more then it is ok!" + nvrd + nvrd + CStr(zzz).Trim.ToUpper.Replace("D.", ""), "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                Exit For
            End Try
        Next
    End Function


