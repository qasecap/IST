                                Dim ima As Boolean = False
                                If Not bbss.AccessibleName Is Nothing Then
                                    If bbss.AccessibleName <> "" AndAlso bbss.AccessibleName.Trim.Substring(bbss.AccessibleName.Trim.Length - 1, 1) <> ";" Then z = ";"
                                    Dim pom As String = "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(tblok + 1).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"
                                    If bbss.AccessibleName.Trim.ToUpper.IndexOf(pom) >= 0 Then ima = True
                                End If
                                If ima = False Then bbss.AccessibleName = bbss.AccessibleName + z + "SKIPFROM" + Mid(cntl.Name, 3) + ";TOGROUP" + Str(tblok + 1).Trim + ";FROMGROUP" + Str(tblok).Trim + ";"
                                bbss.Focus()
                            End If
                        End If
                    Else
                        'SendKeys.SendWait("{TAB}")
                        'MORA OVAKO DOKAZ PROBNIPOPIS
                        nepotrebnavalidacija = True
                        Me.SelectNextControl(ActiveControl, True, True, True, True)
                        IndBlokaNaKomeSmo = tblok
                    End If
                    nepotrebnavalidacija = False

                    Exit Sub
                Catch ex As Exception
                    ISTMessageBox.Show("nextBlok iz cbpp validacije")
                    okvalidacija = False
                End Try
            End If

            nepotrebnavalidacija = False

        Catch ex As Exception
            ISTMessageBox.Show("cbpp_keydown")
            okvalidacija = False
        End Try
    End Sub
    Function nadjiFilterSEK(ByVal pomIzraz As String) As String

        Dim filterCBO As String = ""
        pomIzraz = pomIzraz.Trim
        pomIzraz = pomIzraz.Replace("CBO{", "")
        pomIzraz = pomIzraz.Replace("CBW{", "")
        pomIzraz = pomIzraz.Substring(0, pomIzraz.Length - 1)
        Dim nizCB As String() = Split(pomIzraz, ";")
        For ii As Integer = 0 To nizCB.GetUpperBound(0)
            If nizCB(ii).Trim.ToUpper.IndexOf("FILTER=") >= 0 Then
                filterCBO = nizCB(ii).Replace("FILTER=", "")
                Exit For
            End If
        Next
        Dim sqlFilter As String = ""
        Dim aaa() As String = razkvantaj(filterCBO)
        For i As Integer = 0 To aaa.Length() - 1
            If aaa(i).Length() > 1 AndAlso aaa(i).Substring(0, 2).ToUpper = "D." Then
                Dim pljF As String = aaa(i).Replace("D.", "").Trim.ToUpper
                Dim qq As String
                qq = SEK(pljF)
                sqlFilter = qq
                Exit For
            End If
        Next

        nadjiFilterSEK = sqlFilter
    End Function
    Private Sub cbpk_KeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs)
