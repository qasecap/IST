        ElseIf TypeOf k Is Panel AndAlso Mid(k.Name.ToString.Trim.ToUpper, 1, 1) = "RG" AndAlso Not k.AccessibleName Is Nothing AndAlso k.AccessibleName.IndexOf("NE;") < 0 Then
