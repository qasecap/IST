    Function QCSQL(ByVal qcvred As String) As String

        Dim dateupdate As String = ""
        Dim userupdate As String = ""
        Dim DATE_statusAnketar As String = ""
        Dim USER_statusAnketar As String = ""
        Dim koSam As String = ""
        Dim txtcloudcati As Boolean = False
        Dim strsql As String = ""
        If txtmode.Trim.ToUpper = "CAPI" OrElse txtmode.Trim.ToUpper = "TESTCAPI" OrElse
                    txtmode.Trim.ToUpper = "CAPITEST" OrElse txtmode.Trim.ToUpper = "MIXMODECAPIDESKTOP" Then   'može i testcapi
            koSam = GetUserNameCAPI(Me.ISTConnectionString, Me.jezik)
        ElseIf anketarCATIcloud <> "" OrElse txtmode.Trim.ToUpper = "CLOUD" Then
            koSam = anketarCATIcloud
            txtcloudcati = True
        ElseIf anketarCATI <> "" Then
            koSam = anketarCATI
        ElseIf sifist.Trim.ToUpper = "xPPOLJO" Then
            Dim koSamPom As String = ""
            Dim dt As DataTable = izvrsiSQLvratiDT("select suser_sname() as sn", DBConnectionString, Me.jezik)
            If dt.Rows.Count > 0 Then
                koSamPom = dt.Rows(0).Item("sn").ToString.Trim
            End If
            If koSamPom.Trim.ToUpper.IndexOf("STATSRB\") >= 0 Then
                koSam = kojianketar(koSamPom, Me.DBConnectionString)
            End If
        ElseIf txtmode.Trim.ToUpper = "ZCAPI" OrElse txtmode.Trim.ToUpper = "Z" Then
            koSam = GetUserNameZ()
        Else
            koSam = GetUserNameIzBaze(Me.DBConnectionString)
        End If

        If Not (DGTabele(DGi(GlavnaTabela)).Columns("DATE_UPDATE") Is Nothing) Then
            dateupdate = "[DATE_update]='" + Date.Now.ToString("yyyy-MM-dd HH:mm:ss") + "'"
            DATE_statusAnketar = "[DATE_statusAnketar]='" + Date.Now.ToString("yyyy-MM-dd HH:mm:ss") + "'"
        End If
        If Not (DGTabele(DGi(GlavnaTabela)).Columns("DATUM_UPDATE") Is Nothing) Then
            dateupdate = "[DATUM_UPDATE]='" + Date.Now.ToString("yyyy-MM-dd HH:mm:ss") + "'"
            DATE_statusAnketar = "[DATE_statusAnketar]='" + Date.Now.ToString("yyyy-MM-dd HH:mm:ss") + "'"
        End If

        If Not (DGTabele(DGi(GlavnaTabela)).Columns("USER_UPDATE") Is Nothing) Then
            If koSam = "" Then
                userupdate = "[USER_update]=suser_sname()"
                USER_statusAnketar = "[USER_statusAnketar]=suser_sname()"
            Else
                userupdate = "[USER_update]='" + koSam + "'"
                USER_statusAnketar = "[USER_statusAnketar]='" + koSam + "'"
            End If
        End If

        If Not (DGTabele(DGi(GlavnaTabela)).Columns("KO_UPDATE") Is Nothing) Then
            If koSam = "" Then
                userupdate = "[KO_update]=suser_sname()"
            Else
                userupdate = "[KO_update]='" + koSam + "'"
            End If
        End If

        strsql = " BEGIN TRANSACTION;" + vbCrLf

        Dim redoviMEMAK() As DataRow = dIst.ISTTABELE.Select("isnull(baza,'')<>'0' and isnull(T1,'') not like '%ISTview%' and isnull(DG,'')='A'", "baza ASC")
        Dim TabelaAdresar As String = ""
        If redoviMEMAK.Length > 0 Then
            TabelaAdresar = redoviMEMAK(0).Item("Tabela").ToString.Trim
            If TabelaAdresar.Trim <> "" Then
                strsql = strsql + "update " + TabelaAdresar + " set statusAnketar='" + qcvred + "'"

                If qcvred = 0 Then
                    If userupdate <> "" Then
                        strsql = strsql + "," + USER_statusAnketar
                    End If
                    If dateupdate <> "" Then
                        strsql = strsql + "," + DATE_statusAnketar
                    End If
                    strsql = strsql + " where not (isnull(statusanketar,0)=0 and (isnull(User_statusanketar,'') like 'i7%' or isnull(User_statusanketar,'') like 'i8%')) and " + whereKljuc() + ";"

                Else
                    If userupdate <> "" Then
                        strsql = strsql + "," + USER_statusAnketar
                    End If
                    If dateupdate <> "" Then
                        strsql = strsql + "," + DATE_statusAnketar
                    End If
                    strsql = strsql + " where " + whereKljuc() + ";"
                End If

            End If
        End If


        strsql = strsql + nvrd + "update " + Me.GlavnaTabela.Trim + " set QC='" + qcvred + "'"
        If userupdate <> "" Then
            strsql = strsql + "," + userupdate
        End If
        If dateupdate <> "" Then
            strsql = strsql + "," + dateupdate
        End If
        strsql = strsql + " where " + whereKljuc() + ";"

        strsql = strsql + nvrd + " COMMIT TRANSACTION;"
        Dim ok As String = izvrsiSQL(strsql, Me.DBConnectionString)
        DGTabele(DGi(Me.GlavnaTabela.Trim)).Rows(0).Item("QC") = qcvred
        If ok = "ok" Then
            If AfterUpdateQCExec <> "" Then
                AfterUpdateQCExec = AfterUpdateQCExec.TrimEnd(",")
                Dim sql As String = ""
                sql = AfterUpdateQCExec
                sql = SrediPMGK(sql)
                sql = ZameniGGGMMMUnos(sql)
                sql = sracunajIzraz(sql, Nothing, Nothing)
                sql = sql.ToUpper.Replace("ISTQC", qcvred)
                Dim kk As String = izvrsiSQL(sql, Me.DBConnectionString)
                If kk = "ok" Then
                Else
                    ISTMessageBox.Show(sql + nvrd + nvrd + "is not executed!")
                End If
            End If
        Else
            ISTMessageBox.Show("ERROR at QC")
        End If

        Return ok

    End Function
    Function whereKljuc() As String

        Dim KljuceviSaEkranaSaVrednostima(,) As String = Nothing
        ReDim KljuceviSaEkranaSaVrednostima(GlavniKljuc.GetUpperBound(0), 1)
        For i As Integer = 0 To GlavniKljuc.GetUpperBound(0)
            KljuceviSaEkranaSaVrednostima(i, 0) = GlavniKljuc(i).Trim.ToUpper
            KljuceviSaEkranaSaVrednostima(i, 1) = SEK(GlavniKljuc(i)).Trim.ToUpper
        Next

        whereKljuc = "2=2 "
        For i As Integer = 0 To KljuceviSaEkranaSaVrednostima.GetUpperBound(0)
            whereKljuc = whereKljuc + " And " + KljuceviSaEkranaSaVrednostima(i, 0).Trim.ToUpper & "='" + KljuceviSaEkranaSaVrednostima(i, 1).Trim & "' "
        Next

    End Function
