ByVal po() As String, ByVal lsx As Integer, ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal ZadnjiTabIndex As Integer, ByVal pOD As String,
ByVal multiLINE As Boolean, ByVal ro As Boolean, ByVal biomultiline As Boolean,
ByVal biolblmultiline As Boolean, ByVal addmissingvalue As String)

        Dim chP() As String = {}
        Dim imaNR As Boolean = False
        If Not chtrt.Tag Is Nothing AndAlso chtrt.Tag <> "" Then
            chP = kojeugrupi(nizCHB, chtrt.Tag)
            'nadji sve chbox u toj grupi i vidi da li neki ima \n, ako nema pusti da je chtrt.width=800, a chtrt.heght=20
            Dim kktrt As String = svichUGrupi(p.TABELA.Trim.ToUpper, chtrt.Tag)
            If kktrt.Trim.ToUpper.IndexOf("\N") >= 0 Then imaNR = True
            If chP.Length = 0 Then
                ''msg 77
                Dim msgtxt77 As String = getMessageText(dtMessages, "77", Me.jezik)
                ''msg 78
                Dim msgtxt78 As String = getMessageText(dtMessages, "78", Me.jezik)
                ISTMessageBox.Show(msgtxt77 + nvrd + p.POLJE.Trim.ToUpper + nvrd + ", " + msgtxt78, "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Error)
                'ISTMessageBox.Show("Nešto nije u redu kod sintakse za checkbox " + p.POLJE.Trim.ToUpper + ", proverite polje izraz")
                Exit Sub
            End If
            If chtrt.Tag <> pamtiGrupas Then pamtiGrupas = chtrt.Tag : blbl = 0 : nrChBox = 0 : pomDesno = 400
        End If

        If Not chP(0) Is Nothing AndAlso chtrt.Name.Trim.ToUpper = "HH" & chP(0).Trim.ToUpper Then
            'prvi i to je labela za panel3
            '*****PANEL3
            Dim poltxt() As Label = {}
            ReDim Preserve poltxt(po.GetUpperBound(0))
            Call dodajlabelucati(po, 25, poltxt, xx, yy, p.POLJE.Trim.ToUpper, p.rbr, True, chtrt.Tag)
            '*****PANEL3
        End If

        '*****PANEL2
        If checkBoxL = True Then chtrt.RightToLeft = RightToLeft.Yes

        '''''''''''''''''''''''''''''''''''
        Dim pom As String = chtrt.Text
        Dim ft As FontStyle = FontStyle.Regular
        Dim ftB As FontStyle = FontStyle.Bold
        Dim ftI As FontStyle = FontStyle.Italic
        Dim ftU As FontStyle = FontStyle.Underline

        'KAKO
        Dim kako() As String = pom.Split("$")
        If kako.Length > 0 Then
            For iii As Integer = 0 To kako.Length - 1
                kako(iii) = kako(iii).Trim.ToUpper
                If kako(iii).IndexOf("FONTBOLD") >= 0 Then
                    TTfontBold = True
                ElseIf kako(iii).IndexOf("FONTITALIC") >= 0 Then
                    TTfontItalic = True
                ElseIf kako(iii).IndexOf("FONTUNDERLINE") >= 0 Then
                    TTfontUnderline = True
                ElseIf kako(iii).IndexOf("FONTSIZE") >= 0 Then
                    kako(iii) = kako(iii).Trim.ToUpper.Replace("FONTSIZE", "")
                    If IsNumeric(kako(iii)) = True Then TTfontSize = CInt(kako(iii))
                End If
            Next
        End If

        pom = NZ(Replace(pom, "fontbold", "", 1, , CompareMethod.Text)).Trim
        pom = NZ(Replace(pom, "fontitalic", "", 1, , CompareMethod.Text)).Trim
        pom = NZ(Replace(pom, "fontunderline", "", 1, , CompareMethod.Text)).Trim
        pom = NZ(Replace(pom, "fontsize" + CStr(TTfontSize).Trim, "", 1, , CompareMethod.Text)).Trim
        pom = NZ(Replace(pom, "$", "", 1, , CompareMethod.Text)).Trim

        If TTfontSize = 0 Then TTfontSize = Me.Font.Size

        ft = FontStyle.Regular
        ftB = FontStyle.Bold
        ftI = FontStyle.Italic
        ftU = FontStyle.Underline

        'B I U
        If TTfontBold = True And TTfontItalic = True And TTfontUnderline = True Then ft = ftB Or ftI Or ftU
        If TTfontBold = True And TTfontItalic = True And TTfontUnderline = False Then ft = ftB Or ftI
        If TTfontBold = True And TTfontItalic = False And TTfontUnderline = False Then ft = ftB
        If TTfontBold = True And TTfontItalic = False And TTfontUnderline = True Then ft = ftB Or ftU
        If TTfontBold = False And TTfontItalic = True And TTfontUnderline = True Then ft = ftI Or ftU
        If TTfontBold = False And TTfontItalic = False And TTfontUnderline = True Then ft = ftU
        If TTfontBold = False And TTfontItalic = True And TTfontUnderline = False Then ft = ftI

        'trt.Font = New Font(Me.Font.Name, TTfontSize, ft)
        '''''''''''''''''''''''''''''''''''''''''''''''''''
        'chtrt.Text = chtrt.Text.Replace("$", "")
        chtrt.Text = pom
        Dim tt As Integer = chtrt.Text.LastIndexOf(";") + 1
        If tt > 1 Then chtrt.Text = chtrt.Text.Substring(tt)
        If chP.Length > 0 Then chtrt.Text = CStr(chP.Length).Trim & "  " & chtrt.Text.Trim
        panelpom.Controls.Add(chtrt)
        chtrt.AccessibleDescription = p.rbr

        If p.Izraz.Trim.ToUpper.IndexOf("\N") = 0 Then
            nrChBox = nrChBox + 1
            blbl = 1
        Else
            blbl = blbl + 1
        End If

        'chtrt.Font = New Font(Me.Font.Name, 8, FontStyle.Regular)

        chtrt.Font = New Font(Me.Font.Name, TTfontSize, ft)

        Dim pd As Integer = 400
        If imaNR = False Then
            chtrt.Width = Me.panelCATIlabel.Width - 200
            chtrt.Height = 20
            chtrt.Location = New Point(3, 3 + (blbl - 1) * chtrt.Height)
        Else
            chtrt.Width = pd - 5
            chtrt.Height = 1.5 * chtrt.Height
            chtrt.Location = New Point(3 + nrChBox * pd, 3 + (blbl - 1) * chtrt.Height)
        End If

        chtrt.BringToFront()
        'If nrChBox = 1 Then chtrt.BackColor = Color.Red
        'If nrChBox = 0 Then chtrt.BackColor = Color.GreenYellow
        chtrt.TabStop = False
        'Dim duz As Integer = dajDuzinupremaTekstu(chtrt)
        chtrt.Visible = False
        '*****PANEL2

        '*****PANEL1
        Dim catitrt As New TextBox
        catitrt = sklopiTextBox(p, ZadnjiTabIndex, pOD, multiLINE, ro)
        panel.Controls.Add(catitrt)
        catitrt.AccessibleDescription = p.rbr & ";HH"
        catitrt.Tag = chtrt.Tag
        Dim yh As String = NadjiYHPrethodneKontrole(panel, catitrt, biomultiline, biolblmultiline)
        Dim nnn() As String = yh.Split(";")
        Dim nn As Integer
        If nnn(0) = "0" Then
            nn = chtrt.Location.Y
        Else
            nn = CInt(nnn(0)) + CInt(nnn(1))
        End If

        Dim catitrtG As New pomTextBox
        catitrtG.Name = "pomocno" & "_" & chtrt.Tag
        Dim rtb As pomTextBox = NadjiKontrolu(panel, catitrtG.Name)
        If rtb Is Nothing Then
            'prvi
            catitrtG = sklopiRTextBox(p, ZadnjiTabIndex, ro, catitrtG.Name, addmissingvalue)

            iRTBKontrola = iRTBKontrola + 1
            ReDim Preserve nizRTextBox(iRTBKontrola)
            nizRTextBox(iRTBKontrola) = catitrtG

            panel.Controls.Add(catitrtG)
            catitrtG.AccessibleDescription = p.rbr & ";HH"
            catitrtG.Tag = chtrt.Tag
            catitrtG.BringToFront()
            catitrtG.Location = New Point(100, nn)
            catitrtG.Width = 100
            catitrtG.Height = 20
            If addmissingvalue <> "" Then catitrtG.AccessibleName = catitrtG.AccessibleName + addmissingvalue + ";"
        End If

        catitrt.BringToFront()
        catitrt.Width = 20
        If rtb Is Nothing Then
            'prvi
            catitrt.Location = New Point(400, catitrtG.Location.Y)
            If addmissingvalue <> "" Then catitrt.AccessibleName = catitrt.AccessibleName + addmissingvalue + ";"
        Else
            Dim tb As TextBox = NadjiKontrolu(panel, "TP" + chP(chP.GetUpperBound(0) - 1))
            If Not tb Is Nothing Then
                catitrt.Location = New Point(400 + (chP.Length - 1) * tb.Width, rtb.Location.Y)
            End If
        End If

        If Not rtb Is Nothing AndAlso addmissingvalue <> "" Then
            rtb.AccessibleName = rtb.AccessibleName + addmissingvalue & ";"
            If Not chP(0) Is Nothing Then
                Dim prvichb As TextBox = NadjiKontrolu(panel, "TP" + chP(0).Trim)
                prvichb.AccessibleName = prvichb.AccessibleName + addmissingvalue & ";"
            End If
        End If

        catitrt.TabStop = False
        catitrt.TabIndex = 0
        catitrt.ReadOnly = False
        catitrt.Enabled = False
        catitrt.BackColor = Color.LightGray
        catitrt.BorderStyle = BorderStyle.None
        catitrt.AccessibleName = catitrt.AccessibleName + "LG;"
        'catitrt.Visible = False NI SLUCAJNO, SVE PRESTANE DA RADI!!!!!!!!!!!!!!!!!!!!!!!

        If rtb Is Nothing Then
            'prvi
            Dim pomltxtx As New Label
            pomltxtx.Name = "POM" + chtrt.Name
            pomltxtx.Text = p.POLJE.Trim.ToUpper
