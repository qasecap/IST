                k.Tag.Izraz = CASE2IIF(CStr(k.Tag.izraz))
            End If
            Dim zzz As String = k.Tag.Izraz.ToString.Trim
            If CStr(zzz).Trim.ToUpper.IndexOf("#FP{") >= 0 Then zzz = zameniFP(zzz)

            If CStr(zzz).Trim.ToUpper.IndexOf("POWER") >= 0 Or CStr(zzz).Trim.ToUpper.IndexOf("ROUND") >= 0 OrElse CStr(zzz).Trim.ToUpper.IndexOf("FCALCULATEAGE") >= 0 Then

                Dim Fja As String = ""
                Dim x1 As Integer
                Dim PozZarez As Integer

                If CStr(zzz).Trim.ToUpper.IndexOf("POWER") >= 0 Then
                    x1 = CStr(zzz).ToUpper.IndexOf("POWER") + 5
                    PozZarez = GdeJeZarez(zzz.ToUpper, "POWER")
                    Fja = "POWER"
                ElseIf CStr(zzz).Trim.ToUpper.IndexOf("ROUND") >= 0 Then
                    x1 = CStr(zzz).ToUpper.IndexOf("ROUND") + 5
                    PozZarez = GdeJeZarez(zzz.ToUpper, "ROUND")
                    Fja = "ROUND"
                ElseIf CStr(zzz).Trim.ToUpper.IndexOf("FCALCULATEAGE") = 0 Then
                    Fja = "FCALCULATEAGE"
                End If

                If Fja = "POWER" OrElse Fja = "ROUND" Then
                    Dim par1 As String = CStr(zzz.ToUpper).Substring(x1, PozZarez - x1).Trim
                    par1 = par1.Substring(1)
                    Dim par2 As String = CStr(zzz.ToUpper).Substring(PozZarez + 1).Trim

                    Dim brz As Integer = 0
                    Dim KrajPar2 As Integer = Len(par2) - 1
                    For ii As Integer = 1 To Len(par2)
                        If par2.Substring(ii, 1) = "(" Then brz += 1
                        If par2.Substring(ii, 1) = ")" Then brz -= 1
                        If brz = -1 Then
                            KrajPar2 = ii
                            Exit For
                        End If
                    Next
                    par2 = par2.Substring(0, KrajPar2)
                    Dim pomkol1 As New DataColumn("pomKol1")
                    pomkol1.Expression = CStr(par1).Trim.ToUpper.Replace("D.", "").Replace("N'", "'")
                    DGTabele(DGi(tabela)).Columns.Add(pomkol1)
                    Dim xxx1 As Object = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol1)", ""))
                    Dim pomkol2 As New DataColumn("pomKol2")
                    pomkol2.Expression = CStr(par2).Trim.ToUpper.Replace("D.", "").Replace("N'", "'")
                    DGTabele(DGi(tabela)).Columns.Add(pomkol2)
                    Dim xxx2 As Object = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol2)", ""))
                    DGTabele(DGi(tabela)).Columns.Remove(pomkol1)
                    DGTabele(DGi(tabela)).Columns.Remove(pomkol2)
                    Select Case Fja
                        Case "POWER"
                            If xxx1 = "" Then xxx1 = 0
                            If xxx2 = "" Then xxx2 = 0
                            k.Text = CStr(CDbl(xxx1) ^ CDbl(xxx2)).Trim
                        Case "ROUND"
                            If xxx1 = "" Then xxx1 = 0
                            If xxx2 = "" Then xxx2 = 0
                            k.Text = CStr(Math.Round(CDbl(xxx1), CInt(xxx2))).Trim
                        Case Else
                    End Select
                End If
                If Fja = "FCALCULATEAGE" Then k.Text = fCalculateAge(zzz)
            Else
                Dim pomkol As New DataColumn("pomKol")
                Try
                    Dim xxx As Object
                    If zzz.ToString.Trim.IndexOf("{") = 0 Then
                        'vuce polja iz memorije iz ostalih podatabela
                        zzz = zzz.Replace("{", "").Replace(";}", "").Replace("; }", "").Replace("}", "")
                        zzz = sracPodtabele(zzz)
                        zzz = razCASTi(zzz)
                        zzz = zameniSpace(zzz.Trim)
                        zzz = zameniISTLabels(zzz)
                        Dim tbl As DataTable = New DataTable()
                        xxx = NZ(tbl.Compute(zzz, Nothing))
                    Else
                        If zzz.ToUpper.Trim.IndexOf("D.") >= 0 Then
                            zzz = zzz.Replace("D.", "").Replace("d.", "")
                            zzz = zameniSpace(zzz.Trim)
                            zzz = zameniISTLabels(zzz)
                            pomkol.Expression = zzz.Replace("N'", "'")
                            DGTabele(DGi(tabela)).Columns.Add(pomkol)
                            xxx = NZ(DGTabele(DGi(tabela)).Compute("MAX(pomKol)", ""))
                            DGTabele(DGi(tabela)).Columns.Remove(pomkol)
                        Else
                            Dim tbl As DataTable = New DataTable()
                            xxx = NZ(tbl.Compute(zzz, Nothing))
                        End If
                    End If
                    k.Text = CStr(xxx).Trim
                Catch ex As Exception
                    Call zatvoriOLHC()
                    k.Text = ""
                    MsgBox(ex.Message + nvrd + nvrd +
                "You must use #FP{} syntax is you are using fictional fields." + nvrd +
                "Don't use select tableOrView.field from tableofView, use select field from tableofView." + nvrd + nvrd +
                "Field:     " + k.Name + nvrd + "Wrong syntax:     " + zzz + nvrd + nvrd +
                "If you are using some value from screen, use D.field syntax.", vbInformation, "")
                Finally
                End Try
            End If 'power
        End If

    End Sub

    Private Function PreracunajFPPomNovo(ByVal k As Control) As String

        Dim tabela As String = GlavnaTabela
