    Function sklopiRadioButton(ByVal p As DatasetIstrazivanja.ISTPOLJARow, ByVal pom As String, ByVal brojKolonaRB As Integer,
        ByVal RBKolona() As String, Optional ByVal tabindex As Integer = -1, Optional accdesc As String = "") As RadioButton()
        Dim cRBtrt() As RadioButton
        Dim pomOrig As String = pom
        Dim pp() As String = pom.Split(";")
        If pp.Length > 0 Then pom = pp(0)
        pom = NZ(Replace(pom.Trim, "\n", ",", 1, , CompareMethod.Text)).Trim

        pom = pom.Trim.Replace("' ,", "',").Replace("', ", "',")
        pom = pom.Trim.Replace(", '", ",'").Replace(" ,'", ",'")
        pom = pom.Trim.Replace("',", "$")

        Dim nv As String() = Split(pom, "$")

        Dim ii As Integer = -1
        ReDim Preserve cRBtrt(ii)
        For ii = 0 To nv.GetUpperBound(0)
            ReDim Preserve cRBtrt(ii)
            cRBtrt(ii) = New RadioButton
            cRBtrt(ii).Name = "RB" & p.POLJE.Trim.ToUpper & "_" & ii.ToString.Trim

            If nv(ii).ToString.Trim.ToUpper.IndexOf("DEFAULT") >= 0 Then
                nv(ii) = NZ(Replace(nv(ii).Trim, "default", "", 1, , CompareMethod.Text)).Trim
            End If
            Dim rtl As Boolean = False
            If nv(ii).ToString.Trim.ToUpper.IndexOf("LEFT") = 0 Then
                nv(ii) = NZ(Replace(nv(ii).Trim, "left", "", 1, , CompareMethod.Text)).Trim
                rtl = True
            End If

            Dim mm As Integer = nv(ii).ToString.IndexOf("'")
            If mm < 0 Then
                nv(ii) = "'" + nv(ii).Trim
                mm = 0
            End If

            Dim tt As String = nv(ii).ToString.Substring(0, mm).Trim
            If mm = 0 OrElse IsNumeric(tt) = False Then
                cRBtrt(ii).Text = CStr(ii + 1) & "  " & nv(ii).ToString.Replace("'", "").Trim
            ElseIf IsNumeric(tt) Then
                cRBtrt(ii).Text = tt.Trim & "  " & nv(ii).ToString.Substring(mm).Replace("'", "").Trim
            End If

            cRBtrt(ii).Tag = cRBtrt(ii).Text.Length.ToString.Trim
            If brojKolonaRB > 0 Then
                For k As Integer = 0 To brojKolonaRB
                    If RBKolona(k).Trim.ToUpper.IndexOf(cRBtrt(ii).Text.Trim.ToUpper) > 0 Then
                        cRBtrt(ii).Tag = cRBtrt(ii).Tag + "_" + (k + 1).ToString.Trim
                        Exit For
                    End If
                Next
            End If
            cRBtrt(ii).AutoCheck = True
            cRBtrt(ii).AutoSize = False
            If Not accdesc Is Nothing AndAlso accdesc <> "" Then
                cRBtrt(ii).AccessibleDescription = accdesc
            End If

            If ii = 0 AndAlso tabindex > -1 Then
                'cRBtrt(ii).TabStop = True
                cRBtrt(ii).TabStop = False
                cRBtrt(ii).TabIndex = tabindex
            End If

            If rtl = True Then
                cRBtrt(ii).RightToLeft = RightToLeft.Yes
            End If
            AddHandler cRBtrt(ii).KeyPress, AddressOf Me.rb_KeyPress
            AddHandler cRBtrt(ii).MouseClick, AddressOf Me.rb_MouseClick

        Next
        Return cRBtrt
    End Function

