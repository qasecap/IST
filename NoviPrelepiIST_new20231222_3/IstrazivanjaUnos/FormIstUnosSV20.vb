            If CTTfontBold(ik) = True AndAlso CTTfontItalic(ik) = False AndAlso CTTfontUnderline(ik) = True Then ft = ftB Or ftU
            If CTTfontBold(ik) = False AndAlso CTTfontItalic(ik) = True AndAlso CTTfontUnderline(ik) = True Then ft = ftI Or ftU
            If CTTfontBold(ik) = False AndAlso CTTfontItalic(ik) = False AndAlso CTTfontUnderline(ik) = True Then ft = ftU
            If CTTfontBold(ik) = False AndAlso CTTfontItalic(ik) = True AndAlso CTTfontUnderline(ik) = False Then ft = ftI

            poltxt(ik).Font = New Font(Me.Font.Name, TTfontSize, ft)

            If CTTFORECOLOR(ik) <> "" Then
                poltxt(ik).ForeColor = Color.FromName(CTTFORECOLOR(ik))
