    Function sracDTBL(ByVal sql As String, ByVal m As Integer, ByVal dt As DataTable) As String
        'OVO SE KORISTI SAMO ZA AUTOLIST
        'OVO SE KORISTI SAMO ZA AUTOLIST
        'OVO SE KORISTI SAMO ZA AUTOLIST
        'OVO SE KORISTI SAMO ZA AUTOLIST

        sql = sql.Replace("{ ", "{").Replace(" }", "}")


        Dim bbb() As String = razkvantaj(sql)
        Dim pp As String = ""
        For ll As Integer = 0 To bbb.GetUpperBound(0)
            bbb(ll) = bbb(ll).Trim.ToUpper.Replace("D.", "")
            If IsNumeric(bbb(ll)) = False AndAlso reserveChar(bbb(ll)) = False Then
                If SDTBL(bbb(ll), m, dt) <> "" Then
                    pp = SDTBL(bbb(ll), m, dt).ToString.Trim.Replace("'", dap)
                    If ll - 2 >= 0 AndAlso bbb(ll - 2).Length >= 5 AndAlso bbb(ll - 2).Trim.ToUpper = "ISNULL" Then
                        If ll + 2 >= 0 AndAlso bbb(ll + 2).Length() >= 0 AndAlso bbb(ll + 2).Trim.ToUpper = "0" Then
                            If IsNumeric(pp) = True Then
                                bbb(ll) = pp
                            ElseIf pp = "''" OrElse pp = "" Then
                                'pp = "Null"
                                bbb(ll) = "Null"
                            Else
                                bbb(ll) = "'" + pp + "'"
                            End If
                        Else
                            bbb(ll) = "'" + pp + "'"
                        End If
                    ElseIf IsNumeric(pp) = True AndAlso pp.Length >= 1 AndAlso pp.Length < 10 AndAlso Mid(pp, 1, 1) <> "0" Then 'broj i ne pocinje vodecom nulom
                        bbb(ll) = pp
                    ElseIf pp = "0" Then  'samo nula
                        bbb(ll) = pp
                    Else
                        bbb(ll) = "'" + pp + "'"
                    End If
                Else
                    bbb(ll) = "Null"
                End If

            End If
        Next
        sracDTBL = ustringaj(bbb).ToUpper

    End Function

    Function reserveChar(ByVal str As String) As Boolean
        reserveChar = False
        If str.IndexOf("'") >= 0 Then
            reserveChar = True
            Exit Function
        End If
        Select Case str
            Case ","
                reserveChar = True
            Case "("
                reserveChar = True
            Case "="
                reserveChar = True
            Case ">="
                reserveChar = True
            Case "<="
                reserveChar = True
            Case "<>"
                reserveChar = True
            Case "<"
                reserveChar = True
            Case ">"
                reserveChar = True
            Case ")"
                reserveChar = True
            Case "IN"
                reserveChar = True
            Case "AND"
                reserveChar = True
            Case "OR"
                reserveChar = True
        End Select

    End Function

    Private Function SDTBL(ByVal polje As String, ByVal m As Integer, ByVal dt As DataTable) As String
        SDTBL = ""
        For Each r As DataColumn In dt.Columns
            If r.ColumnName.Trim.ToUpper = polje Then
                SDTBL = dt.Rows(m).Item(polje).ToString
            End If
        Next
    End Function

