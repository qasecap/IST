    Sub AWLFormatiraj(ByVal awl As Label, ByVal tboxName As String, ByVal tbox As TextBox, ByVal nizdodeliStasss As String, ByVal awltextformat As String)
        awl.Text = ""
        Dim imaAVLabel As Boolean = False
        Try

            imaAVLabel = True
            Dim pp As String = nizdodeliStasss
            If pp.Trim.IndexOf("&") >= 0 Then
                Dim ppa() As String = pp.Split("&")
                Dim pom As String = ""
                For ii As Integer = 0 To ppa.GetUpperBound(0)
                    Dim xx As String = ""
                    Dim cime As String = ppa(ii).TrimStart(" "c).ToUpper
                    If cime.IndexOf("'") = 0 Then
                        xx = ppa(ii)
                    Else
                        Dim ind As Integer = Array.IndexOf(nizKontrolaIme, cime)
                        If ind > -1 Then
                            xx = "'" + SE(cime,, nizKontrola(ind).Parent).Trim + "'"
                        ElseIf cime.IndexOf("#FP{") = 0 Then
                            cime = cime.Trim
                            If cime.EndsWith("}") = True Then cime = cime.Replace("}", "")
                            cime = cime.Substring(4)
                            ind = Array.IndexOf(nizFPime, cime)
                            If ind > -1 Then xx = "'" + SE(cime, True, nizFP(ind).Parent).Trim + "'"
                        Else
                            xx = ppa(ii)
                        End If
                    End If

                    pom = pom + xx
                Next
                pp = pom
            End If

            pp = pp.Replace("'", "")

            If TTfontBold = False Then TTfontBold = Me.AlwaysVisibleLabel.Font.Bold
            If TTfontItalic = False Then TTfontItalic = Me.AlwaysVisibleLabel.Font.Italic
            If TTfontUnderline = False Then TTfontUnderline = Me.AlwaysVisibleLabel.Font.Underline
            If TTfontSize = 0 Then TTfontSize = Me.AlwaysVisibleLabel.Font.Size

            If pp.Trim.ToUpper.IndexOf("<FONTSIZE") >= 0 Then
                Dim a As Integer = pp.Trim.ToUpper.IndexOf("<FONTSIZE")
                If pp.Substring(a).IndexOf(">") > 0 Then
                    Dim b As Integer = pp.Substring(a).IndexOf(">")
                    TTfontSize = Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")).Replace(">", "")
                    pp = pp.Replace(Mid(pp.Substring(a).Trim.ToUpper, 1 + 9, InStr(pp.Substring(a + 9), ">")), "")
                    pp = NZ(Replace(pp, "<fontsize", "", 1, , CompareMethod.Text)).Trim
                End If
            End If
            If pp.Trim.ToUpper.IndexOf("<BOLD>") >= 0 Then
                TTfontBold = True
                pp = NZ(Replace(pp, "<bold>", "", 1, , CompareMethod.Text)).Trim
            End If
            If pp.Trim.ToUpper.IndexOf("<ITALIC>") >= 0 Then
                TTfontItalic = True
                pp = NZ(Replace(pp, "<italic>", "", 1, , CompareMethod.Text)).Trim
            End If
            If pp.Trim.ToUpper.IndexOf("<UNDERLINE>") >= 0 Then
                TTfontUnderline = True
                pp = NZ(Replace(pp, "<underline>", "", 1, , CompareMethod.Text)).Trim
            End If

            'samo Bold
            If TTfontSize = 0 Then TTfontSize = Me.Font.Size

            Dim ft As FontStyle = FontStyle.Regular
            Dim ftB As FontStyle = FontStyle.Bold
            Dim ftI As FontStyle = FontStyle.Italic
            Dim ftU As FontStyle = FontStyle.Underline
            If TTfontBold = True AndAlso TTfontItalic = True Then ft = ftB Or ftI
            If TTfontBold = True AndAlso TTfontItalic = False Then ft = ftB
            If TTfontBold = False AndAlso TTfontItalic = True Then ft = ftI

            awl.Font = New Font(Me.Font.Name, TTfontSize, ft)

            pp = NZ(Replace(pp, "<br>", vbCrLf, 1, , CompareMethod.Text)).Trim
            awl.Text = pp

            'awl.Visible = True
            awl.BringToFront()
        Catch ex As Exception
            ''msg 45
            Dim msgtxt45 As String = getMessageText(dtMessages, "45", Me.jezik)
            Dim msgtxt46 As String = getMessageText(dtMessages, "46", Me.jezik)
            ISTMessageBox.Show(msgtxt45 + nvrd + tboxName + nvrd + msgtxt46 + nvrd + GlavnaTabela + "", "Error-Stop", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
        End Try
    End Sub

